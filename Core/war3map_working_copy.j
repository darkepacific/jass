    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Spells\\Other\\CrushingWave\\CrushingWaveDamage.mdl" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 3.00 )
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), 20.00 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Weapons\\RedDragonBreath\\RedDragonMissile.mdl" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 3.00 )
