function Trig_Skeletal_Army_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'AIfs' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Skeletal_Army_Actions takes nothing returns nothing
    local unit udg_Temp_Unit = GetTriggerUnit()
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 10 ]  then
    	call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'AIfs'), ABILITY_RLF_DURATION_NORMAL, 0, 30.0 )
    	call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'AIfs'), ABILITY_RLF_DURATION_HERO, 0, 30.0 )
    else
    	call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'AIfs'), ABILITY_RLF_DURATION_NORMAL, 0, 20.0 )
    	call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'AIfs'), ABILITY_RLF_DURATION_HERO, 0, 20.0 )
    endif
    set udg_Temp_Unit = null
endfunction

