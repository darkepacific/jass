//===========================================================================
// Trigger: S DWD H
//
// Create Quests for ALL players,
// Enable/Disable Quests for specific players
// Enable/Disabling quests does not cause desyncing.
//===========================================================================
function Trig_S_DWD_H_Actions takes nothing returns nothing
                       if IsHordeHero( GetTriggerUnit() ) then
    set udg_TempString = "Dealing with Dread"
    set udg_TempString_Quest = "Kill both Dreadlords in the Plaguelands."
    call TriggerExecute( gg_trg_Quest_Start_H )
    call DestroyEffectBJ( udg_QuestMarks[29] )
    // Icon 1
    call CampaignMinimapIconUnitBJ( gg_unit_Ubal_0449, bj_CAMPPINGSTYLE_BOSS )
    call SetMinimapIconOrphanDestroy( GetLastCreatedMinimapIcon(), true )
    set udg_MiniMapIcon[29] = GetLastCreatedMinimapIcon()
    call SetMinimapIconVisible( udg_MiniMapIcon[29], false )
    // Icon 2
    call CampaignMinimapIconUnitBJ( gg_unit_Utic_0561, bj_CAMPPINGSTYLE_BOSS )
    call SetMinimapIconOrphanDestroy( GetLastCreatedMinimapIcon(), true )
    call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), false )
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    call FlashQuestDialogButtonBJ(  )
    call QuestSetEnabledBJ( true, udg_Quests[29] )
    call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), true )
    call SetMinimapIconVisible( udg_MiniMapIcon[29], true )
    endif
    call QuestSetCompletedBJ( udg_Quests[29], false )
    call CreateQuestItemBJ( udg_Quests[29], "TRIGSTR_4772" )
    set udg_QuestReqs[29] = GetLastCreatedQuestItemBJ()
    call DisableTrigger( GetTriggeringTrigger() )
    call EnableTrigger( gg_trg_E_DWD_H )
                       endif
endfunction

