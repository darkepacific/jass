function Trig_Murlocs_Attacking_Func001C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetAttacker()) == 'nmsc' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'nmrv' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'n01E' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'nmtw' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'n02K' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'nmrm' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'nmmu' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'nmrr' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'n00V' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'h03T' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Murlocs_Attacking_Conditions takes nothing returns boolean
    if ( not Trig_Murlocs_Attacking_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Murlocs_Attacking_Func002C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 3) > 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Murlocs_Attacking_Actions takes nothing returns nothing
    if ( Trig_Murlocs_Attacking_Func002C() ) then
        call PlaySoundOnUnitBJ( gg_snd_MurlocAggro, 85.00, GetAttacker() )
        call CreateTextTagUnitBJ( "TRIGSTR_8460", GetAttacker(), 0.00, 9.00, 100.00, 20.00, 10.00, 0 )
        call cleanUpText( 1.2, 1.0)
        call DisableTrigger( GetTriggeringTrigger() )
        call GameTimeWait(4.0)
        call EnableTrigger( GetTriggeringTrigger() )
    else
    endif
endfunction

