//===========================================================================
// Trigger: M The Amani Catacombs
//===========================================================================
function Trig_M_The_Amani_Catacombs_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 105
    set udg_TempString = ""
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    set udg_TempString = udg_ExclamationMark
    endif
    call AddSpecialEffectTargetUnitBJ( "overhead", gg_unit_hspt_1875, udg_TempString )
    set udg_QuestMarks[105] = GetLastCreatedEffectBJ()
    set udg_TempString = "Our sources tell us that the trolls buried in the Amani Catacombs have been rising from the dead. Investigate these catacombs and torch any of remains you come across."
    // Set Quest Rewards
    set udg_QUEST_XP[udg_Temp_Int] = 550
    set udg_QUEST_GOLD[udg_Temp_Int] = 100
    set udg_QUEST_LVL_REQ[udg_Temp_Int] = udg_QUEST_ZONE_2_LVL_REQ
    call QuestRewards_TextSet(udg_Temp_Int)
    // End Set Quest Rewards
    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_1456", udg_TempString, "ReplaceableTextures\\CommandButtons\\BTNWoWTorch" )
    set udg_Quests[105] = GetLastCreatedQuestBJ()
    call QuestSetEnabledBJ( false, GetLastCreatedQuestBJ() )
    call EnableTrigger( gg_trg_S_TAC)
endfunction

//===========================================================================
function InitTrig_M_The_Amani_Catacombs takes nothing returns nothing
    set gg_trg_M_The_Amani_Catacombs = CreateTrigger(  )
    call TriggerRegisterTimerEventSingle( gg_trg_M_The_Amani_Catacombs, 3.30 )
    call TriggerAddAction( gg_trg_M_The_Amani_Catacombs, function Trig_M_The_Amani_Catacombs_Actions )
endfunction

//===========================================================================
// Trigger: S TAC
//
// Need to change this to team wide display.
//===========================================================================
function Trig_S_TAC_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
                       if IsHordeHero( GetTriggerUnit() ) then
    set udg_TempString = "The Amani Catacombs"
    set udg_TempString_Quest = "Torch 20 Amani Remains, unanimated or not..."
    call TriggerExecute( gg_trg_Quest_Start_H )
    set udg_TempString = ""
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    set udg_TempString = udg_QuestionMark
    call QuestSetEnabledBJ( true, udg_Quests[105] )
    call FlashQuestDialogButtonBJ(  )
    endif
    call DestroyEffectBJ( udg_QuestMarks[105] )
    call QuestSetCompletedBJ( udg_Quests[105], false )
    call CreateQuestItemBJ( udg_Quests[105], "TRIGSTR_1458" )
    set udg_QuestReqs[105] = GetLastCreatedQuestItemBJ()
    call AddSpecialEffectTargetUnitBJ( "overhead", gg_unit_hspt_1875, udg_TempString )
    set udg_QuestMarks[105] = GetLastCreatedEffectBJ()
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Amani_Dark_Priest_Spawn)
    call CampaignMinimapIconLocBJ( udg_Temp_Unit_Point, bj_CAMPPINGSTYLE_CONTROL_NEUTRAL )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_MiniMapIcon[105] = GetLastCreatedMinimapIcon()
    if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
    call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), false )
    endif
    call DisableTrigger( GetTriggeringTrigger() )
    call EnableTrigger( gg_trg_U_TAC)
    call EnableTrigger( gg_trg_U_TAC_20)
    call UnitAddItemByIdSwapped( 'I08K', GetTriggerUnit() )
    call TriggerSleepAction( 10.00 )
    call EnableTrigger( gg_trg_L_TAC)
                       endif
    set udg_Temp_Unit_Point = null
endfunction

