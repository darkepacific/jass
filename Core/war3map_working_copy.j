//===========================================================================
// Trigger: Enter the Dragon Queen Cinematic
//===========================================================================
function Trig_Enter_the_Dragon_Queen_Cinematic_Func001C takes nothing returns boolean
    if ( not ( IsPlayerAlly(GetTriggerPlayer(), Player(1)) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Enter_the_Dragon_Queen_Cinematic_Func005A takes nothing returns nothing
    call DestructableRestoreLife( GetEnumDestructable(), GetDestructableMaxLife(GetEnumDestructable()), true )
endfunction

function Trig_Enter_the_Dragon_Queen_Cinematic_Actions takes nothing returns nothing
    if ( Trig_Enter_the_Dragon_Queen_Cinematic_Func001C() ) then
        set udg_Faction = 0     //DONT FORGET TO REMOVE THIS
    else
        set udg_Faction = 1
    endif
    call TriggerExecute(gg_trg_C_BLD)
    return
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Strasza_Quest_Cinematic_DW)
    call EnumDestructablesInCircleBJ( 420.00, udg_Temp_Unit_Point, function Trig_Enter_the_Dragon_Queen_Cinematic_Func005A )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerExecute(gg_trg_C_EDQ)
endfunction

//===========================================================================
function InitTrig_Enter_the_Dragon_Queen_Cinematic takes nothing returns nothing
    set gg_trg_Enter_the_Dragon_Queen_Cinematic = CreateTrigger(  )
    call DisableTrigger( gg_trg_Enter_the_Dragon_Queen_Cinematic )
    call TriggerRegisterPlayerChatEvent( gg_trg_Enter_the_Dragon_Queen_Cinematic, Player(2), "-edq", true )
    call TriggerRegisterPlayerChatEvent( gg_trg_Enter_the_Dragon_Queen_Cinematic, Player(4), "-edq", true )
    call TriggerRegisterPlayerChatEvent( gg_trg_Enter_the_Dragon_Queen_Cinematic, Player(5), "-edq", true )
    call TriggerRegisterPlayerChatEvent( gg_trg_Enter_the_Dragon_Queen_Cinematic, Player(6), "-edq", true )
    call TriggerRegisterPlayerChatEvent( gg_trg_Enter_the_Dragon_Queen_Cinematic, Player(7), "-edq", true )
    call TriggerRegisterPlayerChatEvent( gg_trg_Enter_the_Dragon_Queen_Cinematic, Player(8), "-edq", true )
    call TriggerRegisterPlayerChatEvent( gg_trg_Enter_the_Dragon_Queen_Cinematic, Player(9), "-edq", true )
    call TriggerRegisterPlayerChatEvent( gg_trg_Enter_the_Dragon_Queen_Cinematic, Player(10), "-edq", true )
    call TriggerAddAction( gg_trg_Enter_the_Dragon_Queen_Cinematic, function Trig_Enter_the_Dragon_Queen_Cinematic_Actions )
endfunction

//===========================================================================
// Trigger: C EDQ
//===========================================================================
function Trig_C_EDQ_Func040A takes nothing returns nothing
    call CameraSetupApplyForPlayer( true, gg_cam_DW_and_Strasza, GetEnumPlayer(), 0.20 )
endfunction

function Trig_C_EDQ_Func089A takes nothing returns nothing
    call KillDestructable( GetEnumDestructable() )
endfunction

function Trig_C_EDQ_Func115A takes nothing returns nothing
    call CameraSetEQNoiseForPlayer( GetEnumPlayer(), 3 )
endfunction

function Trig_C_EDQ_Func134A takes nothing returns nothing
    call CameraClearNoiseForPlayer( GetEnumPlayer() )
endfunction

function Trig_C_EDQ_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    local unit DW 
    local unit ST
    local effect globe
    local effect eff
    local fogmodifier fog
    local force udg_Player_Message_Group = CreateForce()
    // set the faction
    local boolean isAlliance = false
    local boolean isHorde = false
    if udg_Faction == 0 then
    //set udg_Player_Message_Group = udg_AlliancePlayers
    call ForceAddPlayerSimple( Player(2), udg_Player_Message_Group )
    call ForceAddPlayerSimple( Player(7), udg_Player_Message_Group )
    call ForceAddPlayerSimple( Player(8), udg_Player_Message_Group )
    call ForceAddPlayerSimple( Player(9), udg_Player_Message_Group )
    set isAlliance = true
    elseif udg_Faction == 1 then
    //set udg_Player_Message_Group = udg_HordePlayers
    call ForceAddPlayerSimple( Player(4), udg_Player_Message_Group )
    call ForceAddPlayerSimple( Player(5), udg_Player_Message_Group )
    call ForceAddPlayerSimple( Player(6), udg_Player_Message_Group )
    call ForceAddPlayerSimple( Player(10), udg_Player_Message_Group )
    set isHorde = true
    endif
    // Cinematic
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEOUTIN, 0.25, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 50.00 )
    call DisplayCineFilterBJ( false )
    if isAlliance then
    if ( GetLocalPlayer() == Player(2) or GetLocalPlayer() == Player(7) or GetLocalPlayer() == Player(8) or GetLocalPlayer() == Player(9) )then
    call DisplayCineFilterBJ( true )
    call StopMusicBJ( false )
    endif
    else
    if ( GetLocalPlayer() == Player(4) or GetLocalPlayer() == Player(5) or GetLocalPlayer() == Player(6) or GetLocalPlayer() == Player(10) )then
    call DisplayCineFilterBJ( true )
    call StopMusicBJ( false )
    endif
    endif
    call ForForce( udg_Player_Message_Group, function Trig_C_EDQ_Func040A )
    // Vision
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Strasza_Quest_Cinematic)
    if isAlliance then
    call CreateFogModifierRadiusLocBJ( true, Player(1), FOG_OF_WAR_VISIBLE, udg_Temp_Unit_Point, 700.00 )
    else
    call CreateFogModifierRadiusLocBJ( true, Player(0), FOG_OF_WAR_VISIBLE, udg_Temp_Unit_Point, 700.00 )
    endif
    set fog = GetLastCreatedFogModifier()
    call RemoveLocation (udg_Temp_Unit_Point)
    // Create DW
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Strasza_Quest_Cinematic_DW)
    call CreateNUnitsAtLoc( 1, 'E034', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Temp_Unit_Point, 315.00 )
    set DW = GetLastCreatedUnit()
    call SetUnitAnimation( DW, "Stand Alternate")
    call SetHeroLevel( DW, 60, false)
    call PauseAddInvuln( DW, null)
    call RemoveLocation (udg_Temp_Unit_Point)
    // Create ST
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Enter_the_Draqon_Queen_End)
    call CreateNUnitsAtLoc( 1, 'E04G', Player(PLAYER_NEUTRAL_PASSIVE), udg_Temp_Unit_Point, 135.00 )
    set ST = GetLastCreatedUnit()
     call SetUnitScale( ST, 1.2, 1.2, 1.2)
    call SetHeroLevel( ST, 60, false)
    call SetUnitColor( ST, ConvertPlayerColor(12) )
    call PauseAddInvuln( ST, null)
    call RemoveLocation (udg_Temp_Unit_Point)
    // Create Globe
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Strasza_Quest_Cinematic)
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\PlanetR.mdx" )
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), 365.00 )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 2.40 )
    set globe = GetLastCreatedEffectBJ()
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 0.25 )
    // Start
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Enter_the_Draqon_Queen_End)
    call PlaySoundAtPointBJ( gg_snd_DW_ALEXS_full_convo_n, 100, udg_Temp_Unit_Point, 0 )
    call TransmissionFromUnitTypeWithNameBJ( udg_Player_Message_Group, Player(PLAYER_NEUTRAL_AGGRESSIVE), 'E034', "TRIGSTR_12037", udg_Temp_Unit_Point, null, "TRIGSTR_12038", bj_TIMETYPE_ADD, 6.90, false )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 6.90 )
    call TransmissionFromUnitTypeWithNameBJ( udg_Player_Message_Group, Player(PLAYER_NEUTRAL_PASSIVE), 'E04G', "TRIGSTR_12039", udg_Temp_Unit_Point, null, "TRIGSTR_12040", bj_TIMETYPE_ADD, 9.50, false )
    call TriggerSleepAction( 9.50 )
    call TransmissionFromUnitTypeWithNameBJ( udg_Player_Message_Group, Player(PLAYER_NEUTRAL_AGGRESSIVE), 'E034', "TRIGSTR_12041", udg_Temp_Unit_Point, null, "TRIGSTR_12042", bj_TIMETYPE_ADD, 4.00, false )
    call TriggerSleepAction( 4.00 )
    // 13 sec to work with the below
    call TransmissionFromUnitTypeWithNameBJ( udg_Player_Message_Group, Player(PLAYER_NEUTRAL_AGGRESSIVE), 'E034', "TRIGSTR_12043", udg_Temp_Unit_Point, null, "TRIGSTR_12044", bj_TIMETYPE_ADD, 13.00, false )
    call TriggerSleepAction( 7.00 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Strasza_Quest_Cinematic_DW)
    call EnumDestructablesInCircleBJ( 420.00, udg_Temp_Unit_Point, function Trig_C_EDQ_Func089A )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 3.00 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Strasza_Quest_Cinematic)
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Fireglobe_E_003.mdx" )
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), 225.00 )
    set eff = GetLastCreatedEffectBJ()
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 1.14 )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 1.00 )
    call BlzSetSpecialEffectScale( eff, 1.15 )
    call BlzSetSpecialEffectAlpha( globe, 80)
    call TriggerSleepAction( 1.00 )
    call BlzSetSpecialEffectScale( eff, 1.16 )
    call BlzSetSpecialEffectAlpha( globe, 60)
    call TriggerSleepAction( 1.00 )
    call BlzSetSpecialEffectScale( eff, 1.17 )
    call BlzSetSpecialEffectAlpha( globe, 40)
    call TransmissionFromUnitTypeWithNameBJ( udg_Player_Message_Group, Player(PLAYER_NEUTRAL_AGGRESSIVE), 'E034', "TRIGSTR_12045", udg_Temp_Unit_Point, null, "TRIGSTR_12046", bj_TIMETYPE_ADD, 10.00, false )
    call TriggerSleepAction( 10.00 )
    call TransmissionFromUnitTypeWithNameBJ( udg_Player_Message_Group, Player(PLAYER_NEUTRAL_PASSIVE), 'E04G', "TRIGSTR_12047", udg_Temp_Unit_Point, null, "TRIGSTR_12048", bj_TIMETYPE_ADD, 8.00, false )
    call TriggerSleepAction( 8.00 )
    call TransmissionFromUnitTypeWithNameBJ( udg_Player_Message_Group, Player(PLAYER_NEUTRAL_AGGRESSIVE), 'E034', "TRIGSTR_12049", udg_Temp_Unit_Point, null, "TRIGSTR_12050", bj_TIMETYPE_ADD, 7.50, false )
    call TriggerSleepAction( 6.60 )
    // DW Attack
    call SetUnitAnimation( DW, "Attack Spell Alternate")
    call ForForce( udg_Player_Message_Group, function Trig_C_EDQ_Func115A )
    call TriggerSleepAction( 0.70 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Strasza_Quest_Cinematic)
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Weapons\\SteamTank\\SteamTankImpact.mdl" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 1.70 )
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), 135.00 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Weapons\\DemolisherFireMissile\\DemolisherFireMissile.mdl" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 1.70 )
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), 135.00 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Enter_the_Draqon_Queen_End)
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Weapons\\RedDragonBreath\\RedDragonMissile.mdl" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 1.70 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call RemoveLocation (udg_Temp_Unit_Point)
    call KillUnit( ST)
    // Stop Shake
    call ForForce( udg_Player_Message_Group, function Trig_C_EDQ_Func134A )
    call TriggerSleepAction( 2.00 )
    call StopSoundBJ( gg_snd_DW_ALEXS_full_convo_n, false )
    if isAlliance then
    if ( GetLocalPlayer() == Player(2) or GetLocalPlayer() == Player(7) or GetLocalPlayer() == Player(8) or GetLocalPlayer() == Player(9) )then
    call ResumeMusicBJ(  )
    endif
    else
    if ( GetLocalPlayer() == Player(4) or GetLocalPlayer() == Player(5) or GetLocalPlayer() == Player(6) or GetLocalPlayer() == Player(10) )then
    call ResumeMusicBJ(  )
    endif
    endif
    // Clean Up
    call BlzSetSpecialEffectAlpha( globe, 0)
    call DestroyEffect( globe )
    call BlzSetSpecialEffectAlpha( eff, 0)
    call DestroyEffect(eff)
    call RemoveUnit( DW)
    call RemoveUnit( ST)
    call FogModifierStop( fog )
    call DestroyFogModifier( fog )
    set udg_Temp_Unit_Point = null
    set globe = null
    set eff = null
    set DW = null
    set ST = null
    set fog = null
    set udg_Player_Message_Group = null
endfunction

//===========================================================================
function InitTrig_C_EDQ takes nothing returns nothing
    set gg_trg_C_EDQ = CreateTrigger(  )
    call DisableTrigger( gg_trg_C_EDQ )
    call TriggerAddAction( gg_trg_C_EDQ, function Trig_C_EDQ_Actions )
endfunction

//===========================================================================
// Trigger: M Enter the Dragon Queen A 114
//===========================================================================
function Trig_M_Enter_the_Dragon_Queen_A_114_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 114
    set udg_TempString = ""
    if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
    set udg_TempString = udg_ExclamationMark
    endif
    call AddSpecialEffectTargetUnitBJ( "overhead", gg_unit_E04G_2092, udg_TempString )
    set udg_QuestMarks[udg_Temp_Int] = GetLastCreatedEffectBJ()
    set udg_TempString = "It saddens me greatly, but my judgment is final - Deathwing must be destroyed.|nI have prepared a site atop the Highlands, to the north of here where I will bring about his end. Meet me there."
    // Set Quest Rewards
    set udg_QUEST_XP[udg_Temp_Int] = 750
    set udg_QUEST_GOLD[udg_Temp_Int] = 200
    set udg_QUEST_LVL_REQ[udg_Temp_Int] = udg_QUEST_ZONE_3_LVL_REQ
    call QuestRewards_TextSet(udg_Temp_Int)
    // End Set Quest Rewards
    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_487", udg_TempString, "ReplaceableTextures\\CommandButtons\\BTNAlexstrasza Dragon.blp" )
    set udg_Quests[udg_Temp_Int] = GetLastCreatedQuestBJ()
    call QuestSetEnabledBJ( false, GetLastCreatedQuestBJ() )
    call EnableTrigger(gg_trg_S_EDQ_A)
endfunction

//===========================================================================
function InitTrig_M_Enter_the_Dragon_Queen_A_114 takes nothing returns nothing
    set gg_trg_M_Enter_the_Dragon_Queen_A_114 = CreateTrigger(  )
    call TriggerRegisterTimerEventSingle( gg_trg_M_Enter_the_Dragon_Queen_A_114, 3.50 )
    call TriggerAddAction( gg_trg_M_Enter_the_Dragon_Queen_A_114, function Trig_M_Enter_the_Dragon_Queen_A_114_Actions )
endfunction

//===========================================================================
// Trigger: S EDQ A
//
// Need to change this to team wide display.
//===========================================================================
function Trig_S_EDQ_A_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    local integer udg_Temp_Int = 114
                       if IsAllianceHero( GetTriggerUnit() ) then
    set udg_TempString = "Enter the Dragon Queen"
    set udg_TempString_Quest = "Travel to the clearing north of the Vermillion Redoubt."
    call TriggerExecute( gg_trg_Quest_Start_A )
    set udg_TempString = ""
    if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
    set udg_TempString = udg_QuestionMark
    call QuestSetEnabledBJ( true, udg_Quests[udg_Temp_Int] )
    call FlashQuestDialogButtonBJ(  )
    endif
    call DestroyEffectBJ( udg_QuestMarks[udg_Temp_Int] )
    call QuestSetCompletedBJ( udg_Quests[udg_Temp_Int], false )
    call CreateQuestItemBJ( udg_Quests[udg_Temp_Int], "TRIGSTR_12051" )
    set udg_QuestReqs[udg_Temp_Int] = GetLastCreatedQuestItemBJ()
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Enter_the_Draqon_Queen_End)
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, udg_TempString )
    set udg_QuestMarks[udg_Temp_Int] = GetLastCreatedEffectBJ()
    call CampaignMinimapIconLocBJ( udg_Temp_Unit_Point, bj_CAMPPINGSTYLE_TURNIN )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_MiniMapIcon[udg_Temp_Int] = GetLastCreatedMinimapIcon()
    call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), false )
    if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
    call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), true )
    endif
    call DisableTrigger( GetTriggeringTrigger() )
    call EnableTrigger(gg_trg_E_EDQ_A)
                       endif
    set udg_Temp_Unit_Point = null
endfunction

//===========================================================================
function InitTrig_S_EDQ_A takes nothing returns nothing
    set gg_trg_S_EDQ_A = CreateTrigger(  )
    call DisableTrigger( gg_trg_S_EDQ_A )
