//===========================================================================
// Trigger: Shuriken Strike
//
// Calc distance in tics
//===========================================================================
function Trig_Shuriken_Strike_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0D6' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Shuriken_Strike_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    if (udg_Temp_Unit == udg_yA_Combat_Rogue) then
    set udg_Temp_Int = 24
    else
    set udg_Temp_Int = 25
    endif
    set udg_Point_Charge_Begin[udg_Temp_Int] = GetUnitLoc(GetSpellAbilityUnit())
    set udg_Temp_Polar_Point = GetSpellTargetLoc()
    set udg_Temp_Unit_Point = PolarProjectionBJ(udg_Point_Charge_Begin[udg_Temp_Int], 20.00, AngleBetweenPoints(udg_Point_Charge_Begin[udg_Temp_Int], udg_Temp_Polar_Point))
    call RemoveLocation (udg_Point_Charge_Begin[udg_Temp_Int])
    set udg_Point_Charge_Begin[udg_Temp_Int] = udg_Temp_Unit_Point
    set udg_Charge_Distance = 450.00
    set udg_Point_Charge_End[udg_Temp_Int] = PolarProjectionBJ(udg_Point_Charge_Begin[udg_Temp_Int], udg_Charge_Distance, AngleBetweenPoints(udg_Point_Charge_Begin[udg_Temp_Int], udg_Temp_Polar_Point))
    call RemoveLocation (udg_Temp_Polar_Point)
    set udg_Charge_Loop[udg_Temp_Int] = 0.00
    set udg_SpellTicks[udg_Temp_Int] = 0
    call PlaySoundAtPointBJ( gg_snd_HuntressMissileLaunch, 100, udg_Point_Charge_Begin[udg_Temp_Int], 0 )
    if (udg_Temp_Int == 24) then
    call EnableTrigger( gg_trg_Shuriken_Strike_Tick_WR)
    else
    call EnableTrigger( gg_trg_Shuriken_Strike_Tick_UR)
    endif
endfunction

//===========================================================================
function InitTrig_Shuriken_Strike takes nothing returns nothing
    set gg_trg_Shuriken_Strike = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Shuriken_Strike, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Shuriken_Strike, Condition( function Trig_Shuriken_Strike_Conditions ) )
    call TriggerAddAction( gg_trg_Shuriken_Strike, function Trig_Shuriken_Strike_Actions )
endfunction

//===========================================================================
// Trigger: Shuriken Strike Tick WR
//===========================================================================
function Trig_Shuriken_Strike_Tick_WR_Func012C takes nothing returns boolean
    if ( not ( udg_Charge_Loop[udg_Temp_Int] < 9.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Shuriken_Strike_Tick_WR_Func038A takes nothing returns nothing
    if IsUnitTargetableEnemyHitsAll( GetEnumUnit(), udg_Temp_Unit ) then
    ////
    // ======= //
    if (udg_WREviscerate == true) then
    if ( udg_SpellTicks[udg_Temp_Int] < 1 ) and (udg_Charge_Loop[udg_Temp_Int] < 9.0) then
    set udg_SpellTicks[udg_Temp_Int] = 1
    call TriggerExecute(gg_trg_WR_ComboGen)
    endif
    if ( udg_SpellTicks[udg_Temp_Int] < 2 ) and (udg_Charge_Loop[udg_Temp_Int] > 8.0) then
    set udg_SpellTicks[udg_Temp_Int] = 2
    call TriggerExecute(gg_trg_WR_ComboGen)
    endif
    endif
    // ======= //
    ////
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL )
    call AddSpecialEffectTargetUnitBJ( "chest", GetEnumUnit(), "Abilities\\Weapons\\HydraliskImpact\\HydraliskImpact.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "chest", GetEnumUnit(), "Objects\\Spawnmodels\\NightElf\\NightElfBlood\\NightElfBloodArcher.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    if udg_Temp_Bool then
    call IssueTargetOrderBJ( gg_unit_e028_1863, "slow", GetEnumUnit() )
    endif
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_Shuriken_Strike_Tick_WR_Func039C takes nothing returns boolean
    if ( not ( udg_Charge_Loop[udg_Temp_Int] < 17.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Shuriken_Strike_Tick_WR_Actions takes nothing returns nothing
    set udg_Temp_Unit = udg_yA_Combat_Rogue
    call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
    set udg_Temp_Int = 24
    // Damage Calculation
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 2.50 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A0D6', udg_Temp_Unit) * 45 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 10 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    // point calc
    set udg_Length = 50.00
    if ( Trig_Shuriken_Strike_Tick_WR_Func012C() ) then
        set udg_Width = ( 140.00 + ( 25.00 * udg_Charge_Loop[udg_Temp_Int] ) )
        set udg_Facing_Angle = AngleBetweenPoints(udg_Point_Charge_Begin[udg_Temp_Int], udg_Point_Charge_End[udg_Temp_Int])
        set udg_Temp_Unit_Point = PolarProjectionBJ(udg_Point_Charge_Begin[udg_Temp_Int], ( udg_Length * udg_Charge_Loop[udg_Temp_Int] ), udg_Facing_Angle)
    else
        set udg_Width = ( 515.00 - ( 25.00 * udg_Charge_Loop[udg_Temp_Int] ) )
        set udg_Facing_Angle = AngleBetweenPoints(udg_Point_Charge_End[udg_Temp_Int], udg_Point_Charge_Begin[udg_Temp_Int])
        set udg_Temp_Unit_Point = PolarProjectionBJ(udg_Point_Charge_End[udg_Temp_Int], ( udg_Length * ( udg_Charge_Loop[udg_Temp_Int] - 9.00 ) ), udg_Facing_Angle)
    endif
    call TriggerExecute( gg_trg_PICK_EVERY_UNIT_IN_RECT )
    call DestroyEffectBJ( udg_CrimsonTempest[0] )
    call DestroyEffectBJ( udg_CrimsonTempest[1] )
    call DestroyEffectBJ( udg_CrimsonTempest[2] )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Weapons\\SentinelMissile\\SentinelMissile.mdl" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 1.00 )
    set udg_CrimsonTempest[0] = GetLastCreatedEffectBJ()
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, ( udg_Width / 2.80 ), ( udg_Facing_Angle + 90.00 ))
    call AddSpecialEffectLocBJ( udg_Temp_Polar_Point, "Abilities\\Weapons\\SentinelMissile\\SentinelMissile.mdl" )
    set udg_CrimsonTempest[1] = GetLastCreatedEffectBJ()
    call RemoveLocation (udg_Temp_Polar_Point)
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, ( udg_Width / 2.80 ), ( udg_Facing_Angle - 90.00 ))
    call AddSpecialEffectLocBJ( udg_Temp_Polar_Point, "Abilities\\Weapons\\SentinelMissile\\SentinelMissile.mdl" )
    set udg_CrimsonTempest[2] = GetLastCreatedEffectBJ()
    call RemoveLocation (udg_Temp_Polar_Point)
    call RemoveLocation (udg_Temp_Unit_Point)
    // Shuriken Slow
    set udg_Temp_Bool =  udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 4 ] 
    if udg_Temp_Bool then
    call SetUnitAbilityLevelSwapped( 'A03P', gg_unit_e028_1863, 4 )
    call SetUnitOwner( gg_unit_e028_1863, GetOwningPlayer(udg_Temp_Unit), true )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(gg_unit_e028_1863, 'A03P'), ABILITY_RLF_DURATION_NORMAL, 3, 0.5 )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(gg_unit_e028_1863, 'A03P'), ABILITY_RLF_DURATION_HERO, 3, 0.5 )
    endif
    // AoE
    call ForGroupBJ( udg_UnitsInRect, function Trig_Shuriken_Strike_Tick_WR_Func038A )
    if ( Trig_Shuriken_Strike_Tick_WR_Func039C() ) then
        set udg_Charge_Loop[udg_Temp_Int] = ( udg_Charge_Loop[udg_Temp_Int] + 1 )
    else
        call DestroyEffectBJ( udg_CrimsonTempest[0] )
        call DestroyEffectBJ( udg_CrimsonTempest[1] )
        call DestroyEffectBJ( udg_CrimsonTempest[2] )
        call RemoveLocation (udg_Point_Charge_Begin[udg_Temp_Int])
        call RemoveLocation (udg_Point_Charge_End[udg_Temp_Int])
        call DisableTrigger( GetTriggeringTrigger() )
    endif
endfunction

//===========================================================================
function InitTrig_Shuriken_Strike_Tick_WR takes nothing returns nothing
    set gg_trg_Shuriken_Strike_Tick_WR = CreateTrigger(  )
    call DisableTrigger( gg_trg_Shuriken_Strike_Tick_WR )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Shuriken_Strike_Tick_WR, 0.04 )
    call TriggerAddAction( gg_trg_Shuriken_Strike_Tick_WR, function Trig_Shuriken_Strike_Tick_WR_Actions )
endfunction

