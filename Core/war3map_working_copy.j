// Trigger: Command Pet Stop n CD
//
// if the Cd remaining of caster > 0
// if BlzGetUnitAbilityCooldownRemaining( udg_Temp_Unit_CD, 'A09L' )  > BlzGetUnitAbilityCooldownRemaining(GetTriggerUnit(), GetSpellAbilityId()) then
//===========================================================================
function Trig_Command_Pet_Stop_n_CD_Func008C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A0BG' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0BD' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0BE' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Command_Pet_Stop_n_CD_Conditions takes nothing returns boolean
    if ( not Trig_Command_Pet_Stop_n_CD_Func008C() ) then
        return false
    endif
    return true
endfunction

function Trig_Command_Pet_Stop_n_CD_Actions takes nothing returns nothing
    call PlayerNumbtoHeroesNumb()
    set udg_Temp_Unit_CD = udg_Heroes[udg_Player_Number]
    if BlzGetUnitAbilityCooldownRemaining( udg_Temp_Unit_CD, 'A09L' ) < 2 then
    call BlzStartUnitAbilityCooldown( udg_Temp_Unit_CD, 'A09L', ( 1.04 * BlzGetUnitAbilityCooldownRemaining(GetTriggerUnit(), GetSpellAbilityId()) ) )
    elseif BlzGetUnitAbilityCooldownRemaining( udg_Temp_Unit_CD, 'A09L' )  > BlzGetUnitAbilityCooldownRemaining(GetTriggerUnit(), GetSpellAbilityId()) then
    call BlzStartUnitAbilityCooldown( udg_Temp_Unit_CD, 'A09L', ( 1.04 * BlzGetUnitAbilityCooldownRemaining(GetTriggerUnit(), GetSpellAbilityId()) ) )
    endif
endfunction

