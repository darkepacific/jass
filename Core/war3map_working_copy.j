//===========================================================================
// Trigger: Sludge Belcher Plague
//===========================================================================
function Trig_Sludge_Belcher_Plague_Func002Func011A takes nothing returns nothing
    call SBFunc()
endfunction

function Trig_Sludge_Belcher_Plague_Func002C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_SpellUnits[udg_o]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Sludge_Belcher_Plague_Actions takes nothing returns nothing
    local effect cloud
    if ( Trig_Sludge_Belcher_Plague_Func002C() ) then
        set udg_Temp_Unit = GetTriggerUnit()
        call TriggerExecute( gg_trg_Firelords_Helper)
        // SE
        set udg_Temp_Unit_Point = GetUnitLoc( udg_SpellUnits[ udg_o ])
        call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\ElitePlagueCloud.mdx" )
        set cloud = GetLastCreatedEffectBJ()
        // AoE
        set udg_Temp_Unit = udg_Heroes[udg_Player_Number]
        set bj_wantDestroyGroup = true
        call ForGroupBJ( GetUnitsInRangeOfLocAll(220.00, udg_Temp_Unit_Point), function Trig_Sludge_Belcher_Plague_Func002Func011A )
        call RemoveLocation (udg_Temp_Unit_Point)
    else
    endif
    call TriggerSleepAction( 0.50 )
    call DestroyEffectBJ( cloud)
    set cloud = null
    // OLD
    return
    // Dummy Stats
    call SetPlagueDummyStats()
    // Move the Dummy
    set udg_Temp_Unit = gg_unit_e00H_2048
    call SetUnitOwner( udg_Temp_Unit, GetOwningPlayer(GetTriggerUnit()), true )
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    call SetUnitPositionLocFacingBJ( udg_Temp_Unit, udg_Temp_Unit_Point, GetUnitFacing(GetTriggerUnit()) )
    call RemoveLocation (udg_Temp_Unit_Point)
    // Set Abil Lvl
    call SetUnitAbilityLevelSwapped( 'A03H', udg_Temp_Unit, 1 )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A03H'), ABILITY_RLF_PRIMARY_DAMAGE, 0, udg_RealStatCalc )
endfunction

//===========================================================================
function InitTrig_Sludge_Belcher_Plague takes nothing returns nothing
    set gg_trg_Sludge_Belcher_Plague = CreateTrigger(  )
    call TriggerAddAction( gg_trg_Sludge_Belcher_Plague, function Trig_Sludge_Belcher_Plague_Actions )
endfunction

//===========================================================================
// Trigger: Sludge Belcher Walks
//===========================================================================
function Trig_Sludge_Belcher_Walks_Func029C takes nothing returns boolean
    if ( ( GetOwningPlayer(GetTriggerUnit()) == GetOwningPlayer(udg_yH_Unholy_DK) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetTriggerUnit()) == GetOwningPlayer(udg_yA_Unholy_DK) ) ) then
        return true
    endif
    return false
endfunction

function Trig_Sludge_Belcher_Walks_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A03L' ) ) then
        return false
    endif
    if ( not Trig_Sludge_Belcher_Walks_Func029C() ) then
        return false
    endif
    return true
endfunction

function Trig_Sludge_Belcher_Walks_Func004Func001C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 2) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Sludge_Belcher_Walks_Func004C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 3) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Sludge_Belcher_Walks_Func008C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'U03A' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Sludge_Belcher_Walks_Actions takes nothing returns nothing
    local integer i
    call BlzUnitDisableAbility( GetTriggerUnit(), 'A03L', false, true )
    call UnitAddAbilityBJ( 'A0FF', GetTriggerUnit() )
    if ( Trig_Sludge_Belcher_Walks_Func004C() ) then
        call PlaySoundOnUnitBJ( gg_snd_AbominationYes401, 90.00, GetSpellAbilityUnit() )
    else
        if ( Trig_Sludge_Belcher_Walks_Func004Func001C() ) then
            call PlaySoundOnUnitBJ( gg_snd_AbominationYesAttack201, 90.00, GetSpellAbilityUnit() )
        else
            call PlaySoundOnUnitBJ( gg_snd_AbominationYesAttack3, 90.00, GetSpellAbilityUnit() )
        endif
    endif
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 80.00, GetUnitFacing(GetTriggerUnit()))
    call CreateNUnitsAtLoc( 1, 'u038', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, GetUnitFacing(GetTriggerUnit()) )
    if ( Trig_Sludge_Belcher_Walks_Func008C() ) then
        set udg_o = udg_z_DK_UNHO_A
    else
        set udg_o = udg_z_DK_UNHO_H
    endif
    set udg_o = udg_o + 12
    set i = udg_o
    set udg_SpellUnits[udg_o] = GetLastCreatedUnit()
    call RemoveLocation (udg_Temp_Polar_Point)
    call RemoveLocation (udg_Temp_Unit_Point)
    // Set Explode and Order Move
    set udg_Temp_Unit_Point = GetSpellTargetLoc()
    call IssuePointOrderLocBJ( udg_SpellUnits[udg_o], "move", udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call SetUnitExplodedBJ( udg_SpellUnits[ i ], true )
    call TriggerExecute( gg_trg_Sludge_Belcher_Plague)
    call TriggerSleepAction( 0.65 )
    set udg_o = i
    call TriggerExecute( gg_trg_Sludge_Belcher_Plague)
    call TriggerSleepAction( 0.65 )
    set udg_o = i
    call TriggerExecute( gg_trg_Sludge_Belcher_Plague)
    call TriggerSleepAction( 0.65 )
    call KillUnit( udg_SpellUnits[ i ] )
endfunction

//===========================================================================
function InitTrig_Sludge_Belcher_Walks takes nothing returns nothing
    set gg_trg_Sludge_Belcher_Walks = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Sludge_Belcher_Walks, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Sludge_Belcher_Walks, Condition( function Trig_Sludge_Belcher_Walks_Conditions ) )
    call TriggerAddAction( gg_trg_Sludge_Belcher_Walks, function Trig_Sludge_Belcher_Walks_Actions )
endfunction

