//===========================================================================
// Trigger: Leap Timer Human
//===========================================================================
function Trig_Leap_Timer_Human_Func010C takes nothing returns boolean
    if ( not ( udg_Charge_Loop[1] < 20.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Leap_Timer_Human_Actions takes nothing returns nothing
    set udg_Temp_Unit = udg_yA_Arms_Warr
    set udg_Temp_Int = 1
    set udg_Charge_Distance = DistanceBetweenPoints(udg_Point_Charge_Begin[udg_Temp_Int], udg_Point_Charge_End[udg_Temp_Int])
    set udg_RealStatCalc = AngleBetweenPoints(udg_Point_Charge_Begin[udg_Temp_Int], udg_Point_Charge_End[udg_Temp_Int])
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Point_Charge_Begin[udg_Temp_Int], ( udg_Charge_Distance * ( udg_Charge_Loop[udg_Temp_Int] / 20.00 ) ), udg_RealStatCalc)
    call SetUnitPositionLocFacingLocBJ( udg_Temp_Unit, udg_Temp_Polar_Point, udg_Point_Charge_End[udg_Temp_Int] )
    call UnitAddAbility( udg_Temp_Unit, 'Amrf' )
    call UnitRemoveAbility( udg_Temp_Unit, 'Amrf' )
    if ( Trig_Leap_Timer_Human_Func010C() ) then
        set udg_Charge_Loop[1] = ( udg_Charge_Loop[1] + 1 )
        call SetUnitFlyHeightBJ( udg_Temp_Unit, ( 450.00 * SinBJ(AcosBJ(( 1 - ( udg_Charge_Loop[udg_Temp_Int] / 11.00 ) ))) ), 0.00 )
    else
        call SetUnitFlyHeight( udg_Temp_Unit, 0, 0.00 )
         if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 5 ]  then
        call Speedbonus( udg_Temp_Unit, 0.7, 2.5)
        endif
        set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A04K', udg_Temp_Unit) * 60 )
        set udg_HeroStatCalc = ( udg_HeroStatCalc + 20 )
        set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, false) ))
        set udg_RealStatCalc = ( 2.00 * udg_RealStatCalc )
        set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
        call DragonRoarSet()
        call CreateNUnitsAtLoc( 1, 'e01J', GetOwningPlayer(udg_Temp_Unit), udg_Temp_Polar_Point, bj_UNIT_FACING )
        set udg_Temp_Unit = GetLastCreatedUnit()
        call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A04T'), ABILITY_RLF_DAMAGE_WRS1, 0, udg_RealStatCalc )
        call UnitApplyTimedLifeBJ( 0.50, 'BTLF', GetLastCreatedUnit() )
        call IssueImmediateOrderBJ( GetLastCreatedUnit(), "stomp" )
        call DestroyEffectBJ( udg_Charge_SE[1] )
        call RemoveLocation (udg_Point_Charge_Begin[1])
        call RemoveLocation (udg_Point_Charge_End[1])
        call DisableTrigger( GetTriggeringTrigger() )
    endif
    call RemoveLocation (udg_Temp_Polar_Point)
endfunction

//===========================================================================
function InitTrig_Leap_Timer_Human takes nothing returns nothing
    set gg_trg_Leap_Timer_Human = CreateTrigger(  )
    call DisableTrigger( gg_trg_Leap_Timer_Human )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Leap_Timer_Human, 0.02 )
    call TriggerAddAction( gg_trg_Leap_Timer_Human, function Trig_Leap_Timer_Human_Actions )
endfunction

