//===========================================================================
// Trigger: L CWE
//===========================================================================
function Trig_L_CWE_Func006Func001C takes nothing returns boolean
    if ( not ( GetItemTypeId(udg_P_Items[( udg_Bag_Num + udg_Bag_Iterator )]) == udg_ItemTypeCheck ) ) then
        return false
    endif
    return true
endfunction

function Trig_L_CWE_Func018C takes nothing returns boolean
    if ( not ( IsTriggerEnabled(gg_trg_E_CWE) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_L_CWE_Actions takes nothing returns nothing
    local boolean hasItem
                       if IsAllianceHero( GetTriggerUnit() ) then
    set hasItem = false
    call SetBagNumber( GetOwningPlayer(GetTriggerUnit()) )
    set udg_ItemTypeCheck = 'I05J'
    set udg_Bag_Iterator = 1
    loop
        exitwhen udg_Bag_Iterator > udg_BAG_LOOP_MAX
        if ( Trig_L_CWE_Func006Func001C() ) then
            set hasItem = true
        else
        endif
        set udg_Bag_Iterator = udg_Bag_Iterator + 1
    endloop
    if hasItem == false then
    call CreateTextTagUnitBJ( "TRIGSTR_5000", gg_unit_n02L_1615, 0, 8.00, 80.00, 0.00, 0.00, 0 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
    call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
    call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 1.25 )
    call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 0.85 )
    call UnitAddItemByIdSwapped( 'I05J', GetTriggerUnit() )
    call DisableTrigger( GetTriggeringTrigger() )
    call TriggerSleepAction( 30.00 )
    if ( Trig_L_CWE_Func018C() ) then
        call EnableTrigger( GetTriggeringTrigger() )
    else
    endif
    endif
                       endif
endfunction

//===========================================================================
function InitTrig_L_CWE takes nothing returns nothing
    set gg_trg_L_CWE = CreateTrigger(  )
    call DisableTrigger( gg_trg_L_CWE )
    call TriggerRegisterEnterRectSimple( gg_trg_L_CWE, gg_rct_The_Chillwind_Effort )
    call TriggerRegisterUnitInRangeSimple( gg_trg_L_CWE, 256, gg_unit_n02L_1615 )
    call TriggerAddAction( gg_trg_L_CWE, function Trig_L_CWE_Actions )
endfunction

//===========================================================================
// Trigger: E CWE
//===========================================================================
function Trig_E_CWE_Func005Func001C takes nothing returns boolean
    if ( not ( GetItemTypeId(udg_P_Items[( udg_Bag_Num + udg_Bag_Iterator )]) == udg_ItemTypeCheck ) ) then
        return false
    endif
    return true
endfunction

function Trig_E_CWE_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 41
                       if IsAllianceHero( GetTriggerUnit() ) then
    call SetBagNumber( GetOwningPlayer(GetTriggerUnit()) )
    set udg_ItemTypeCheck = 'I05J'
    set udg_Bag_Iterator = 1
    loop
        exitwhen udg_Bag_Iterator > udg_BAG_LOOP_MAX
        if ( Trig_E_CWE_Func005Func001C() ) then
            call DisableTrigger( gg_trg_L_CWE )
            call DisableTrigger( GetTriggeringTrigger() )
            if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
            call FlashQuestDialogButtonBJ(  )
            endif
            call QuestItemSetCompletedBJ( udg_QuestReqs[41], true )
            call QuestSetCompletedBJ( udg_Quests[41], true )
            call DestroyEffectBJ( udg_QuestMarks[41] )
            call DestroyMinimapIcon( udg_MiniMapIcon[41] )
            // Clean Up Items
            call CleanUpItems( udg_ItemTypeCheck )
            // Rewards
            set udg_XP = udg_QUEST_XP[udg_Temp_Int]
            set udg_Gold = udg_QUEST_GOLD[udg_Temp_Int]
            set udg_LVL_Req = udg_QUEST_LVL_REQ[udg_Temp_Int]
            set udg_TempString = "Chillwind Effort"
            call TriggerExecute( gg_trg_Quest_Complete_A )
            return
        else
        endif
        set udg_Bag_Iterator = udg_Bag_Iterator + 1
    endloop
                       endif
endfunction

