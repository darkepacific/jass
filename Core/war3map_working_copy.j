//===========================================================================
// Trigger: Black Arrow Init Jass
//===========================================================================
function Trig_Black_Arrow_Init_Jass_Conditions takes nothing returns boolean
    if ( GetSpellAbilityId() == 'A05B'  ) then
        return true
    endif
    return false
endfunction


function Trig_Black_Arrow_Init_Jass_Actions takes nothing returns nothing
    local real dist
    local real agi = 3.5
    local unit caster = GetTriggerUnit()
    local location udg_Temp_Polar_Point


        if udg_TalentChoices[ GetPlayerId(GetOwningPlayer( caster )) * udg_NUM_OF_TC + 1 ]  then
		set agi = 6.0
	endif

    set dist = 0.25
    if( caster == udg_yA_Dark_Ranger ) then
        set udg_SpellUnits[udg_z_HU_DARK_A] = GetSpellTargetUnit()
        call EnableTrigger( gg_trg_Black_Arrow_WG_Jass )
        set udg_Temp_Unit_Point = GetUnitLoc(caster)
        set udg_Temp_Polar_Point = GetUnitLoc(GetSpellTargetUnit())
        set dist = 0.25 + DistanceBetweenPoints(udg_Temp_Unit_Point, udg_Temp_Polar_Point)/3000
        call RemoveLocation(udg_Temp_Unit_Point)
        call RemoveLocation(udg_Temp_Polar_Point)
        call TriggerSleepAction(dist)
	
        call UnitDamageTargetBJ( caster, udg_SpellUnits[udg_z_HU_DARK_A], ( agi * ( I2R(GetHeroStatBJ(bj_HEROSTAT_AGI, caster, true)) - I2R(GetHeroStatBJ(bj_HEROSTAT_AGI, caster, false)) ) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
	call GameTimeWait( 0.96 )
        call DisableTrigger( gg_trg_Black_Arrow_WG_Jass )
    endif
    if ( caster == udg_yH_Dark_Ranger ) then
        set udg_SpellUnits[udg_z_HU_DARK_H]  = GetSpellTargetUnit()
        call EnableTrigger( gg_trg_Black_Arrow_UD_Jass )
        set udg_Temp_Unit_Point = GetUnitLoc(caster)
        set udg_Temp_Polar_Point = GetUnitLoc(GetSpellTargetUnit())
        set dist = 0.25 + DistanceBetweenPoints(udg_Temp_Unit_Point, udg_Temp_Polar_Point)/3000
        call RemoveLocation(udg_Temp_Unit_Point)
        call RemoveLocation(udg_Temp_Polar_Point)
        call TriggerSleepAction(dist)

	call UnitDamageTargetBJ( caster, udg_SpellUnits[udg_z_HU_DARK_H], ( agi * ( I2R(GetHeroStatBJ(bj_HEROSTAT_AGI, caster, true)) - I2R(GetHeroStatBJ(bj_HEROSTAT_AGI, caster, false)) ) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
	call GameTimeWait( 0.96 )
        call DisableTrigger( gg_trg_Black_Arrow_UD_Jass )
    endif

    //Non Players
    if ( not ( GetPlayerController(GetOwningPlayer(GetTriggerUnit())) == MAP_CONTROL_USER ) ) then
        set udg_Temp_Unit_Point = GetUnitLoc(caster)
        set udg_Temp_Polar_Point = GetUnitLoc(GetSpellTargetUnit())
        set dist = 0.25 + DistanceBetweenPoints(udg_Temp_Unit_Point, udg_Temp_Polar_Point)/3000
        call RemoveLocation(udg_Temp_Unit_Point) 
        call TriggerSleepAction(dist)
        call CreateDarkMinion(caster, udg_Temp_Polar_Point)
        call RemoveLocation(udg_Temp_Polar_Point)
    endif

    set caster = null
    set udg_Temp_Polar_Point = null
endfunction

