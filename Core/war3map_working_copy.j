function Trig_Call_Pet_Actions takes nothing returns nothing
    if IsPlayerInForce( GetTriggerPlayer(), udg_AlliancePlayers) then
    set udg_o = udg_z_HU_BEAS_A
    else
    set udg_o = udg_z_HU_BEAS_H
    endif
    call KillUnit(udg_SpellUnits[udg_o + 4])
    set udg_SpellUnits[( udg_o + 4 )] = GetSummonedUnit()
    if ( Trig_Call_Pet_Func008C() ) then
        call SetUnitAbilityLevelSwapped( 'A0BD', GetSummonedUnit(), ( GetUnitLevel(GetSummonedUnit()) / 5 ) )
        call KillUnit(udg_SpellUnits[udg_o + 5])
    else
        if ( Trig_Call_Pet_Func008Func001C() ) then
            call SetUnitAbilityLevelSwapped( 'A0BG', GetSummonedUnit(), ( GetUnitLevel(GetSummonedUnit()) / 5 ) )
            call KillUnit(udg_SpellUnits[udg_o + 7])
        else
            call KillUnit(udg_SpellUnits[udg_o + 6])
        endif
    endif
    call PlaySoundOnUnitBJ( gg_snd_Hunter_Whistle, 75.00, GetSummoningUnit() )
    call BlzEndUnitAbilityCooldown( GetSummoningUnit(), 'A09L' )
    call ForceUICancelBJ( GetOwningPlayer(GetTriggerUnit()) )
    // Add Bonus Stats
    set udg_o = ( udg_o + 4 )
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer( GetTriggerUnit() )) * udg_NUM_OF_TC + 14 ]  then
    call BlzSetUnitMaxHP( udg_SpellUnits[ udg_o], BlzGetUnitMaxHP( udg_SpellUnits[ udg_o] ) + 500 ) 
    call MaxHealthRestore( 1.0, udg_SpellUnits[ udg_o] )
    call BlzSetUnitArmor( udg_SpellUnits[ udg_o], BlzGetUnitArmor( udg_SpellUnits[ udg_o] ) + 4 ) 
    call BlzSetUnitBaseDamage( udg_SpellUnits[ udg_o] , BlzGetUnitBaseDamage(  udg_SpellUnits[ udg_o] , 0 ) + 200, 0)
    call SetUnitMoveSpeed(  udg_SpellUnits[udg_o], GetUnitDefaultMoveSpeed(  udg_SpellUnits[udg_o] ) + 50)
    endif
endfunction

