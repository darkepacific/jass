function Trig_Totemic_Recall_Actions takes nothing returns nothing
    local unit udg_Temp_Unit 
    set udg_Temp_Unit = udg_Heroes[ HeroesNumb(GetTriggerPlayer()) ]
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 10 ]  then
    if ( Trig_Totemic_Recall_Func005C() ) then
        call SetUnitState(udg_Temp_Unit, UNIT_STATE_MANA, GetUnitState( udg_Temp_Unit,UNIT_STATE_MANA) + 40)
        call BlzStartUnitAbilityCooldown( udg_Temp_Unit, 'Aeye', ( 0.50 * BlzGetUnitAbilityCooldownRemaining(udg_Temp_Unit, 'Aeye') ) )
    else
    endif
    if ( Trig_Totemic_Recall_Func006C() ) then
        call SetUnitState(udg_Temp_Unit, UNIT_STATE_MANA, GetUnitState( udg_Temp_Unit,UNIT_STATE_MANA) + 160)
        call BlzStartUnitAbilityCooldown( udg_Temp_Unit, 'AChw', ( 0.50 * BlzGetUnitAbilityCooldownRemaining(udg_Temp_Unit, 'AChw') ) )
    else
    endif
    if ( Trig_Totemic_Recall_Func007C() ) then
        call SetUnitState(udg_Temp_Unit, UNIT_STATE_MANA, GetUnitState( udg_Temp_Unit,UNIT_STATE_MANA) + 24)
        call BlzStartUnitAbilityCooldown( udg_Temp_Unit, 'A045', ( 0.50 * BlzGetUnitAbilityCooldownRemaining(udg_Temp_Unit, 'A045') ) )
    else
    endif
     call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "Abilities\\Spells\\Items\\AIre\\AIreTarget.mdl")
     call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    if udg_Debug then
    call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_8131" )
    endif
    endif
    set udg_Temp_Unit = null
endfunction

