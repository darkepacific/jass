//===========================================================================
// Trigger: Recklessness
//
// call BlzSetUnitAttackCooldown(, BlzGetUnitAttackCooldown(udg_Talent__Unit, udg_TalentChoiceInt1[udg_Talent__Choice]) + udg_TalentChoiceReal1[udg_Talent__Choice], udg_TalentChoiceInt1[udg_Talent__Choice])
// .275 for 25% AS decrease
// .22 for 20% AS Decrease
//===========================================================================
function Trig_Recklessness_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0DL' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Recklessness_Actions takes nothing returns nothing
    local effect eff
    local unit udg_Temp_Unit = GetTriggerUnit()
    local player udg_X_Player_MUI = GetTriggerPlayer()
    call AddSpecialEffectTargetUnitBJ( "chest", udg_Temp_Unit, "war3mapImported\\Damnation Orange.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "head", udg_Temp_Unit, "war3mapImported\\DemonicAdornment.mdx" )
    set eff = GetLastCreatedEffectBJ()
    call UnitAddAbilityBJ( 'A0DM', GetTriggerUnit() )
    call SetUnitAbilityLevelSwapped( 'A0DM', GetTriggerUnit(), GetUnitAbilityLevelSwapped('A0DL', GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'A0DL', udg_X_Player_MUI )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A0DM', udg_Temp_Unit) * 20 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 20 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) / 100.00 )
    set udg_RealStatCalc = ( 2.20 / ( 1 + udg_RealStatCalc ) )
    call Debug( "Recklessness Base Attack Speed Set: " + R2S( udg_RealStatCalc ) )
    	call BlzSetUnitAttackCooldown( udg_Temp_Unit, udg_RealStatCalc , 0)
    call GameTimeWait(7.6)
    	call BlzSetUnitAttackCooldown( udg_Temp_Unit, 2.2 , 0)
    call SetPlayerAbilityAvailableBJ( true, 'A0DL', udg_X_Player_MUI )
    call UnitRemoveAbilityBJ( 'A0DM', GetTriggerUnit() )
    call DestroyEffectBJ( eff )
    set eff = null
    set udg_X_Player_MUI = null
    set udg_Temp_Unit = null
endfunction

//===========================================================================
function InitTrig_Recklessness takes nothing returns nothing
    set gg_trg_Recklessness = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Recklessness, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Recklessness, Condition( function Trig_Recklessness_Conditions ) )
    call TriggerAddAction( gg_trg_Recklessness, function Trig_Recklessness_Actions )
endfunction

//===========================================================================
// Trigger: Hamstring
//
// Neutral Safe
//===========================================================================
function Trig_Hamstring_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A05G' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hamstring_Func041A takes nothing returns nothing
    if IsUnitTargetableEnemyStab( GetEnumUnit(), udg_Temp_Unit ) then
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL )
    call AddSpecialEffectTargetUnitBJ( "overhead", GetEnumUnit(), "war3mapImported\\Ephemeral Cut Red.mdx" )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00) )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "overhead", GetEnumUnit(), "war3mapImported\\Ephemeral Cut Avocado.mdx" )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00) )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    if not udg_Temp_Bool then
    call IssueTargetOrderBJ( gg_unit_e028_1863, "slow", GetEnumUnit() )
    endif
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_Hamstring_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_Temp_Bool =  udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 13 ] 
    if not udg_Temp_Bool then
    call AddSpecialEffectTargetUnitBJ( "chest", GetTriggerUnit(), "war3mapImported\\Ephemeral Slash Avocado.mdx" )
    else
    call AddSpecialEffectTargetUnitBJ( "chest", GetTriggerUnit(), "war3mapImported\\Ephemeral Slash Red.mdx" )
    endif
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    if not udg_Temp_Bool then
    call AddSpecialEffectTargetUnitBJ( "chest", GetTriggerUnit(), "war3mapImported\\Culling Cleave.mdx" )
    else
    call AddSpecialEffectTargetUnitBJ( "chest", GetTriggerUnit(), "war3mapImported\\Culling Cleave Red.mdx" )
    endif
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 100.00, GetUnitFacing(GetTriggerUnit()))
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
    // Damage Calculation
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 4.00 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A05G', udg_Temp_Unit) * 55 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 15 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    if udg_Temp_Bool then
    set udg_RealStatCalc = ( 1.60 * udg_RealStatCalc )
    endif
    call DragonRoarSet()
    // Crit Bonus
    call TriggerExecute( gg_trg_Crit_Check)
    // AoE
    call SetUnitAbilityLevelSwapped( 'A03P', gg_unit_e028_1863, 2 )
    call SetUnitOwner( gg_unit_e028_1863, GetOwningPlayer(udg_Heroes[udg_Player_Number]), true )
    call AddSpecialEffectLocBJ( udg_Temp_Polar_Point, "war3mapImported\\Coup de Grace Green.mdx" )
    call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 1.25 )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), 0.0, Deg2Rad(GetUnitFacing(GetTriggerUnit())), 0.0 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(160.00, udg_Temp_Polar_Point), function Trig_Hamstring_Func041A )
    call SetUnitAbilityLevelSwapped( 'A03P', gg_unit_e028_1863, 1 )
    call RemoveLocation (udg_Temp_Polar_Point)
endfunction

//===========================================================================
function InitTrig_Hamstring takes nothing returns nothing
    set gg_trg_Hamstring = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Hamstring, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Hamstring, Condition( function Trig_Hamstring_Conditions ) )
    call TriggerAddAction( gg_trg_Hamstring, function Trig_Hamstring_Actions )
endfunction

//===========================================================================
// Trigger: Blood Rush
//===========================================================================
function Trig_Blood_Rush_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A05I' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Blood_Rush_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 3.00 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A05I', udg_Temp_Unit) * 55 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    call DragonRoarSet()
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A05I'), ABILITY_RLF_DAMAGE_UCS1, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_Temp_Unit) - 1 ), udg_RealStatCalc )
    call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "war3mapImported\\BloodTornado.mdx" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.50 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    if udg_Temp_Unit == udg_yA_Fury_Warr then
    set udg_Temp_Int = 26
    elseif udg_Temp_Unit == udg_yH_Fury_Warr then
    set udg_Temp_Int = 27
    else
    set udg_Temp_Int = 48
    endif
    set udg_Point_Charge_Begin[udg_Temp_Int] = GetUnitLoc(GetSpellAbilityUnit())
    set udg_Point_Charge_End[udg_Temp_Int] = GetSpellTargetLoc()
    call AddSpecialEffectTargetUnitBJ( "origin", GetSpellAbilityUnit(), "war3mapImported\\Valiant Charge.mdx" )
    set udg_Charge_SE[udg_Temp_Int] = GetLastCreatedEffectBJ()
    set udg_Charge_Loop[udg_Temp_Int] = 1.00
    set udg_DruidFacingAngle[udg_Temp_Int] = GetUnitFacing(GetTriggerUnit())
    if udg_Temp_Unit == udg_yA_Fury_Warr then
    call EnableTrigger( gg_trg_Blood_Rush_A )
    elseif udg_Temp_Unit == udg_yH_Fury_Warr then
    call EnableTrigger( gg_trg_Blood_Rush_H )
    else
    call EnableTrigger( gg_trg_Blood_Rush_N )
    endif
endfunction

//===========================================================================
function InitTrig_Blood_Rush takes nothing returns nothing
    set gg_trg_Blood_Rush = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Blood_Rush, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Blood_Rush, Condition( function Trig_Blood_Rush_Conditions ) )
    call TriggerAddAction( gg_trg_Blood_Rush, function Trig_Blood_Rush_Actions )
endfunction

//===========================================================================
// Trigger: Blood Rush A
//===========================================================================
function Trig_Blood_Rush_A_Func006Func009Func005Func005A takes nothing returns nothing
    if IsUnitTargetableEnemyStab( GetEnumUnit(), udg_Temp_Unit) then
    call AddSpecialEffectTargetUnitBJ( "chest", GetEnumUnit(), "war3mapImported\\Lascerate.mdx" )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00) )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "chest", GetEnumUnit(), "war3mapImported\\Ephemeral Cut Red.mdx" )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00) )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set udg_HeroStatCalc = 1
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_Blood_Rush_A_Func006Func009Func005Func006C takes nothing returns boolean
    if ( not ( udg_HeroStatCalc > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Blood_Rush_A_Func006Func009Func005C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Temp_Unit) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Blood_Rush_A_Func006Func009C takes nothing returns boolean
    if ( not ( udg_Charge_Loop[udg_Temp_Int] < 38.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Blood_Rush_A_Func006C takes nothing returns boolean
    if ( not ( ModuloReal(udg_Charge_Loop[udg_Temp_Int], 2.00) == 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Blood_Rush_A_Actions takes nothing returns nothing
    set udg_Temp_Unit = udg_yA_Fury_Warr
    set udg_Temp_Int = 26
    call BlzSetUnitFacingEx( udg_Temp_Unit, ( udg_DruidFacingAngle[udg_Temp_Int] + ( 19.00 * udg_Charge_Loop[udg_Temp_Int] ) ) )
    set udg_Charge_Loop[udg_Temp_Int] = ( udg_Charge_Loop[udg_Temp_Int] + 1 )
    if ( Trig_Blood_Rush_A_Func006C() ) then
        set udg_Charge_Distance = DistanceBetweenPoints(udg_Point_Charge_Begin[udg_Temp_Int], udg_Point_Charge_End[udg_Temp_Int])
        set udg_RealStatCalc = AngleBetweenPoints(udg_Point_Charge_Begin[udg_Temp_Int], udg_Point_Charge_End[udg_Temp_Int])
        set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Point_Charge_Begin[udg_Temp_Int], ( udg_Charge_Distance * ( udg_Charge_Loop[udg_Temp_Int] / 38.00 ) ), udg_RealStatCalc)
        if not IsTerrainPathable( GetLocationX(udg_Temp_Polar_Point), GetLocationY(udg_Temp_Polar_Point), PATHING_TYPE_WALKABILITY) then
        call SetUnitPositionLocFacingLocBJ( udg_Temp_Unit, udg_Temp_Polar_Point, udg_Point_Charge_End[udg_Temp_Int] )
        endif
        call RemoveLocation (udg_Temp_Polar_Point)
        if ( Trig_Blood_Rush_A_Func006Func009C() ) then
        else
            call RemoveLocation (udg_Point_Charge_Begin[udg_Temp_Int])
            call RemoveLocation (udg_Point_Charge_End[udg_Temp_Int])
            call DestroyEffectBJ( udg_Charge_SE[udg_Temp_Int] )
            call DisableTrigger( GetTriggeringTrigger() )
            if ( Trig_Blood_Rush_A_Func006Func009Func005C() ) then
                call TriggerExecute( gg_trg_Firelords_Helper)
                set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
                set udg_HeroStatCalc = 0
                set bj_wantDestroyGroup = true
                call ForGroupBJ( GetUnitsInRangeOfLocAll(210.00, udg_Temp_Unit_Point), function Trig_Blood_Rush_A_Func006Func009Func005Func005A )
                if ( Trig_Blood_Rush_A_Func006Func009Func005Func006C() ) then
                    call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "war3mapImported\\Heal Orange.mdx" )
                    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 3 ]  then
                    call MaxHPSelfHeal( 0.08)
                    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.80 )
                    else
                    call MaxHPSelfHeal( 0.05)
                    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.65 )
                    endif
                    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
                else
                endif
                call RemoveLocation (udg_Temp_Unit_Point)
            else
            endif
        endif
    else
    endif
endfunction

//===========================================================================
function InitTrig_Blood_Rush_A takes nothing returns nothing
    set gg_trg_Blood_Rush_A = CreateTrigger(  )
    call DisableTrigger( gg_trg_Blood_Rush_A )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Blood_Rush_A, 0.01 )
    call TriggerAddAction( gg_trg_Blood_Rush_A, function Trig_Blood_Rush_A_Actions )
endfunction

