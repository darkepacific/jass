    call Debug("Temp_Int: " + I2S(udg_Temp_Int) )
    set udg_X_Player_MUI = GetOwningPlayer(udg_Heroes[udg_Temp_Int])
    if ( Trig_Death_Set_Horde_Func003C() ) then
