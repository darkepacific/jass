    set gg_trg_S_MMT = CreateTrigger(  )
    call DisableTrigger( gg_trg_S_MMT )
    call TriggerRegisterEnterRectSimple( gg_trg_S_MMT, gg_rct_S_Murloc_Me_Timbers )
    call TriggerRegisterUnitInRangeSimple( gg_trg_S_MMT, 256, gg_unit_H03S_2223 )
