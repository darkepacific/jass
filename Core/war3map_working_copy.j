function Trig_Animal_Companions_Actions takes nothing returns nothing
    local real udg_Temp_Real = 25.00
    set udg_Temp_Unit = GetTriggerUnit()
    call BlzEndUnitAbilityCooldown( udg_Temp_Unit, 'A09L' )
    call PlaySoundOnUnitBJ( gg_snd_Hunter_Whistle, 75.00, GetTriggerUnit() )
    if IsPlayerInForce( GetTriggerPlayer(), udg_AlliancePlayers) then
    set udg_o = udg_z_HU_BEAS_A
    else
    set udg_o = udg_z_HU_BEAS_H
    endif
    call KillUnit(udg_SpellUnits[udg_o + 4])
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    set udg_Temp_Angle = GetUnitFacing(GetTriggerUnit())
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 90.00, ( udg_Facing_Angle + 75.00 ))
    if ( Trig_Animal_Companions_Func014C() ) then
        call CreateNUnitsAtLoc( 1, 'n04H', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, GetRandomDirectionDeg() )
    else
        if ( Trig_Animal_Companions_Func014Func001C() ) then
            call CreateNUnitsAtLoc( 1, 'n04G', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, GetRandomDirectionDeg() )
        else
            if ( Trig_Animal_Companions_Func014Func001Func002C() ) then
                call CreateNUnitsAtLoc( 1, 'n04F', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, GetRandomDirectionDeg() )
            else
                if ( Trig_Animal_Companions_Func014Func001Func002Func001C() ) then
                    call CreateNUnitsAtLoc( 1, 'n04E', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, GetRandomDirectionDeg() )
                else
                    if ( Trig_Animal_Companions_Func014Func001Func002Func001Func001C() ) then
                        call CreateNUnitsAtLoc( 1, 'n04D', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, GetRandomDirectionDeg() )
                    else
                        if ( Trig_Animal_Companions_Func014Func001Func002Func001Func001Func002C() ) then
                            call CreateNUnitsAtLoc( 1, 'n04C', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, GetRandomDirectionDeg() )
                        else
                            call CreateNUnitsAtLoc( 1, 'n04A', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, GetRandomDirectionDeg() )
                        endif
                    endif
                endif
            endif
        endif
    endif
    call RemoveLocation (udg_Temp_Polar_Point)
    call SetUnitAbilityLevelSwapped( 'A0BD', GetLastCreatedUnit(), ( GetUnitLevel(GetLastCreatedUnit()) / 5 ) )
    set udg_SpellUnits[( udg_o + 5 )] = GetLastCreatedUnit()
    call UnitApplyTimedLifeBJ( udg_Temp_Real, 'BTLF', GetLastCreatedUnit() )
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 90.00, ( udg_Facing_Angle + 0.00 ))
    if ( Trig_Animal_Companions_Func020C() ) then
        call CreateNUnitsAtLoc( 1, 'n04O', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, GetRandomDirectionDeg() )
    else
        if ( Trig_Animal_Companions_Func020Func001C() ) then
            call CreateNUnitsAtLoc( 1, 'n04N', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, GetRandomDirectionDeg() )
        else
            if ( Trig_Animal_Companions_Func020Func001Func002C() ) then
                call CreateNUnitsAtLoc( 1, 'n04M', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, GetRandomDirectionDeg() )
            else
                if ( Trig_Animal_Companions_Func020Func001Func002Func001C() ) then
                    call CreateNUnitsAtLoc( 1, 'n04L', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, GetRandomDirectionDeg() )
                else
                    if ( Trig_Animal_Companions_Func020Func001Func002Func001Func001C() ) then
                        call CreateNUnitsAtLoc( 1, 'n04K', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, GetRandomDirectionDeg() )
                    else
                        if ( Trig_Animal_Companions_Func020Func001Func002Func001Func001Func002C() ) then
                            call CreateNUnitsAtLoc( 1, 'n04J', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, GetRandomDirectionDeg() )
                        else
                            call CreateNUnitsAtLoc( 1, 'n04I', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, GetRandomDirectionDeg() )
                        endif
                    endif
                endif
            endif
        endif
    endif
    call RemoveLocation (udg_Temp_Polar_Point)
    set udg_SpellUnits[( udg_o + 6 )] = GetLastCreatedUnit()
    call UnitApplyTimedLifeBJ( udg_Temp_Real, 'BTLF', GetLastCreatedUnit() )
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 90.00, ( udg_Facing_Angle - 75.00 ))
    if ( Trig_Animal_Companions_Func025C() ) then
        call CreateNUnitsAtLoc( 1, 'n01X', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, GetRandomDirectionDeg() )
    else
        if ( Trig_Animal_Companions_Func025Func001C() ) then
            call CreateNUnitsAtLoc( 1, 'n01D', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, GetRandomDirectionDeg() )
        else
            if ( Trig_Animal_Companions_Func025Func001Func002C() ) then
                call CreateNUnitsAtLoc( 1, 'n01K', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, GetRandomDirectionDeg() )
            else
                if ( Trig_Animal_Companions_Func025Func001Func002Func001C() ) then
                    call CreateNUnitsAtLoc( 1, 'n019', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, GetRandomDirectionDeg() )
                else
                    if ( Trig_Animal_Companions_Func025Func001Func002Func001Func001C() ) then
                        call CreateNUnitsAtLoc( 1, 'n01B', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, GetRandomDirectionDeg() )
                    else
                        if ( Trig_Animal_Companions_Func025Func001Func002Func001Func001Func002C() ) then
                            call CreateNUnitsAtLoc( 1, 'n01A', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, GetRandomDirectionDeg() )
                        else
                            call CreateNUnitsAtLoc( 1, 'n018', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, GetRandomDirectionDeg() )
                        endif
                    endif
                endif
            endif
        endif
    endif
    call RemoveLocation (udg_Temp_Polar_Point)
    call SetUnitAbilityLevelSwapped( 'A0BG', GetLastCreatedUnit(), ( GetUnitLevel(GetLastCreatedUnit()) / 5 ) )
    set udg_SpellUnits[( udg_o + 7 )] = GetLastCreatedUnit()
    call UnitApplyTimedLifeBJ( udg_Temp_Real, 'BTLF', GetLastCreatedUnit() )
    call RemoveLocation (udg_Temp_Unit_Point)
    // Add Bonus Stats
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer( GetTriggerUnit() )) * udg_NUM_OF_TC + 14 ]  then
    set udg_o = ( udg_o + 5 )
    call BlzSetUnitMaxHP( udg_SpellUnits[ udg_o], BlzGetUnitMaxHP( udg_SpellUnits[ udg_o] ) + 500 ) 
    call MaxHealthRestore( 1.0, udg_SpellUnits[ udg_o] )
    call BlzSetUnitArmor( udg_SpellUnits[ udg_o], BlzGetUnitArmor( udg_SpellUnits[ udg_o] ) + 4 ) 
    call BlzSetUnitBaseDamage( udg_SpellUnits[ udg_o] , BlzGetUnitBaseDamage(  udg_SpellUnits[ udg_o] , 0 ) + 200, 0)
    call SetUnitMoveSpeed(  udg_SpellUnits[udg_o], GetUnitDefaultMoveSpeed(  udg_SpellUnits[udg_o] ) + 50)
    set udg_o = ( udg_o + 1 )
    call BlzSetUnitMaxHP( udg_SpellUnits[ udg_o], BlzGetUnitMaxHP( udg_SpellUnits[ udg_o] ) + 500 ) 
    call MaxHealthRestore( 1.0, udg_SpellUnits[ udg_o] )
    call BlzSetUnitArmor( udg_SpellUnits[ udg_o], BlzGetUnitArmor( udg_SpellUnits[ udg_o] ) + 4 ) 
    call BlzSetUnitBaseDamage( udg_SpellUnits[ udg_o] , BlzGetUnitBaseDamage(  udg_SpellUnits[ udg_o] , 0 ) + 200, 0)
    call SetUnitMoveSpeed(  udg_SpellUnits[udg_o], GetUnitDefaultMoveSpeed(  udg_SpellUnits[udg_o] ) + 50)
    set udg_o = ( udg_o + 1 )
    call BlzSetUnitMaxHP( udg_SpellUnits[ udg_o], BlzGetUnitMaxHP( udg_SpellUnits[ udg_o] ) + 500 ) 
    call MaxHealthRestore( 1.0, udg_SpellUnits[ udg_o] )
    call BlzSetUnitArmor( udg_SpellUnits[ udg_o], BlzGetUnitArmor( udg_SpellUnits[ udg_o] ) + 4 ) 
    call BlzSetUnitBaseDamage( udg_SpellUnits[ udg_o] , BlzGetUnitBaseDamage(  udg_SpellUnits[ udg_o] , 0 ) + 200, 0)
    call SetUnitMoveSpeed(  udg_SpellUnits[udg_o], GetUnitDefaultMoveSpeed(  udg_SpellUnits[udg_o] ) + 50)
    endif
endfunction

