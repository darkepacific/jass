function Trig_Predatory_Swiftness_Func014C takes nothing returns boolean
    if ( ( GetKillingUnitBJ() == udg_yA_Feral_Druid ) ) then
        return true
    endif
    if ( ( GetKillingUnitBJ() == udg_yH_Feral_Druid ) ) then
