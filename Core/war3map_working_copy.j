//===========================================================================
// Trigger: U BLD R
//
// Update when ever a black dragon is killed or red dragon is healed
//===========================================================================
function Trig_U_BLD_R_Func010C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetSpellTargetUnit()) == 'nrwm' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetSpellTargetUnit()) == 'E04L' ) ) then
        return true
    endif
    return false
endfunction

function Trig_U_BLD_R_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'nrdr' ) ) then
        return false
    endif
    if ( not Trig_U_BLD_R_Func010C() ) then
        return false
    endif
    return true
endfunction

function Trig_U_BLD_R_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 116
    set udg_QuestBLD_R_A = ( udg_QuestBLD_R_A + 1 )
    call QuestItemSetDescriptionBJ( udg_QuestReqs[udg_Temp_Int], ( "Black Dragons Slain - " + ( I2S(R2I(udg_QuestBLD_B_A)) + ( "/7" + ( "|n - Red Dragons Healed - " + ( I2S(R2I(udg_QuestBLD_R_A)) + "/4" ) ) ) ) ) )
    set udg_Temp_Int = 117
    call QuestItemSetDescriptionBJ( udg_QuestReqs[udg_Temp_Int], ( "Black Dragons Slain - " + ( I2S(R2I(udg_QuestBLD_B_A)) + ( "/7" + ( "|n - Red Dragons Healed - " + ( I2S(R2I(udg_QuestBLD_R_A)) + "/4" ) ) ) ) ) )
    call CreateTextTagUnitBJ( "TRIGSTR_10890", GetSpellTargetUnit(), 0, 10, 75.00, 100, 75.00, 0 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
    call cleanUpText( 0.8, 0.6 )
endfunction

