//===========================================================================
// Trigger: BoJ Fade
//===========================================================================
function Trig_BoJ_Fade_Func007Func002C takes nothing returns boolean
    if ( not ( udg_SpellTicks[udg_Temp_Int] > 70 ) ) then
        return false
    endif
    return true
endfunction

function Trig_BoJ_Fade_Func007C takes nothing returns boolean
    if ( not ( udg_SpellTicks[udg_Temp_Int] > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_BoJ_Fade_Func009Func002C takes nothing returns boolean
    if ( not ( udg_SpellTicks[udg_Temp_Int] > 70 ) ) then
        return false
    endif
    return true
endfunction

function Trig_BoJ_Fade_Func009C takes nothing returns boolean
    if ( not ( udg_SpellTicks[udg_Temp_Int] > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_BoJ_Fade_Func010C takes nothing returns boolean
    if ( not ( udg_SpellTicks[25] <= 0 ) ) then
        return false
    endif
    if ( not ( udg_SpellTicks[26] <= 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_BoJ_Fade_Actions takes nothing returns nothing
    set udg_RealStatCalc = ( I2R(udg_SpellTicks[25]) / 100.00 )
    call BlzSetSpecialEffectAlpha( udg_SunderingAndBoJ[2], R2I(( 255.00 * udg_RealStatCalc )) )
    set udg_RealStatCalc = ( I2R(udg_SpellTicks[26]) / 100.00 )
    call BlzSetSpecialEffectAlpha( udg_SunderingAndBoJ[3], R2I(( 255.00 * udg_RealStatCalc )) )
    set udg_Temp_Int = 25
    if ( Trig_BoJ_Fade_Func007C() ) then
        if ( Trig_BoJ_Fade_Func007Func002C() ) then
            call BlzSetSpecialEffectZ( udg_SunderingAndBoJ[2], ( BlzGetLocalSpecialEffectZ(udg_SunderingAndBoJ[2]) + 20.00 ) )
        else
            call BlzSetSpecialEffectZ( udg_SunderingAndBoJ[2], ( BlzGetLocalSpecialEffectZ(udg_SunderingAndBoJ[2]) - 20.00 ) )
        endif
        set udg_SpellTicks[udg_Temp_Int] = ( udg_SpellTicks[udg_Temp_Int] - 7 )
    else
    endif
    set udg_Temp_Int = 26
    if ( Trig_BoJ_Fade_Func009C() ) then
        if ( Trig_BoJ_Fade_Func009Func002C() ) then
            call BlzSetSpecialEffectZ( udg_SunderingAndBoJ[3], ( BlzGetLocalSpecialEffectZ(udg_SunderingAndBoJ[3]) + 20.00 ) )
        else
            call BlzSetSpecialEffectZ( udg_SunderingAndBoJ[3], ( BlzGetLocalSpecialEffectZ(udg_SunderingAndBoJ[3]) - 20.00 ) )
        endif
        set udg_SpellTicks[udg_Temp_Int] = ( udg_SpellTicks[udg_Temp_Int] - 7 )
    else
    endif
    if ( Trig_BoJ_Fade_Func010C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
    else
    endif
endfunction

//===========================================================================
function InitTrig_BoJ_Fade takes nothing returns nothing
    set gg_trg_BoJ_Fade = CreateTrigger(  )
    call DisableTrigger( gg_trg_BoJ_Fade )
    call TriggerRegisterTimerEventPeriodic( gg_trg_BoJ_Fade, 0.03 )
    call TriggerAddAction( gg_trg_BoJ_Fade, function Trig_BoJ_Fade_Actions )
endfunction

