// Trigger: Rezz Start
//===========================================================================
function Trig_Rezz_Start_Actions takes nothing returns nothing
    local unit udg_Temp_Unit = GetTriggerUnit()
    if udg_Temp_Unit == udg_yA_Holy_Priest or udg_Temp_Unit == udg_yH_Holy_Priest then
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 7 ]  then
    call DialogDisplayBJ( true, udg_RessDialog, GetOwningPlayer(GetTriggerUnit()) )
    endif
    endif
    if udg_Temp_Unit == udg_yA_Resto_Sham or udg_Temp_Unit == udg_yH_Resto_Sham then
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 8 ]  then
    call DialogDisplayBJ( true, udg_AncesDialog, GetOwningPlayer(GetTriggerUnit()) )
    endif
    endif
    set udg_Temp_Unit = null
endfunction

