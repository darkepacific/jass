//
// Update when ever a black dragon is killed or red dragon is healed
//===========================================================================
function Trig_U_BLD_B_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetTriggerUnit()) == Player(PLAYER_NEUTRAL_AGGRESSIVE) ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'nbwm' ) ) then
        return false
    endif
    return true
endfunction

function Trig_U_BLD_B_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 116
    set udg_QuestBLD_B_A = ( udg_QuestBLD_B_A + 1 )
    call QuestItemSetDescriptionBJ( udg_QuestReqs[udg_Temp_Int], ( "Black Dragons Slain - " + ( I2S(R2I(udg_QuestBLD_B_A)) + ( "/7" + ( "|n - Red Dragons Healed - " + ( I2S(R2I(udg_QuestBLD_R_A)) + "/4" ) ) ) ) ) )
    set udg_Temp_Int = 117
    call QuestItemSetDescriptionBJ( udg_QuestReqs[udg_Temp_Int], ( "Black Dragons Slain - " + ( I2S(R2I(udg_QuestBLD_B_A)) + ( "/7" + ( "|n - Red Dragons Healed - " + ( I2S(R2I(udg_QuestBLD_R_A)) + "/4" ) ) ) ) ) )
    set udg_TempString = "Black Dragons"
    call QuestUnitSlain( GetTriggerUnit())
endfunction

