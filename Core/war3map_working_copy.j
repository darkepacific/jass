        call SetUnitOwner( gg_unit_h00D_0412, Player(1), true )
        call TriggerSleepAction( 4.00 )
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Sludgeguard_Guard_1)
        call CreateNUnitsAtLoc( 1, 'h00I', Player(1), udg_Temp_Unit_Point, 45.00 )
