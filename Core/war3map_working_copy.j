    // End Set Quest Rewards
    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_5139", udg_TempString, "ReplaceableTextures\\CommandButtons\\BTNAdvancedStrengthOfTheMoon.blp" )
    set udg_Quests[48] = GetLastCreatedQuestBJ()
    call QuestSetEnabledBJ( false, GetLastCreatedQuestBJ() )
    call EnableTrigger( gg_trg_S_SoE )
endfunction

