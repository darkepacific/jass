//===========================================================================
// Trigger: Blessed Shield
//===========================================================================
function Trig_Blessed_Shield_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A04R' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Blessed_Shield_Func018Func002C takes nothing returns boolean
    if ( not ( udg_HeroStatCalc < 7 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Blessed_Shield_Func018C takes nothing returns boolean
    if ( not ( udg_HeroStatCalc < 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Blessed_Shield_Func025C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(udg_Temp_Unit, 'B01F') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Blessed_Shield_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 4 ]  then
    	call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A04R'), ABILITY_RLF_DURATION_NORMAL, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_Temp_Unit) - 1 ), 1.25 )
    	call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A04R'), ABILITY_RLF_DURATION_HERO, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_Temp_Unit) - 1 ), 1.25 )
    else
    	call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A04R'), ABILITY_RLF_DURATION_NORMAL, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_Temp_Unit) - 1 ), 0.1 )
    	call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A04R'), ABILITY_RLF_DURATION_HERO, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_Temp_Unit) - 1 ), 0.1 )
    endif
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
    // OLD DUMMY CREATION
    if false then
    call CreateNUnitsAtLoc( 1, 'e016', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, GetUnitFacing(GetTriggerUnit()) )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "attack", GetSpellTargetUnit() )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
    endif
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A04R', GetTriggerUnit()) * 1 )
    if ( Trig_Blessed_Shield_Func018C() ) then
        call CreateNUnitsAtLoc( 1, 'e018', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, GetUnitFacing(GetTriggerUnit()) )
    else
        if ( Trig_Blessed_Shield_Func018Func002C() ) then
            call CreateNUnitsAtLoc( 1, 'e015', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, GetUnitFacing(GetTriggerUnit()) )
        else
            call CreateNUnitsAtLoc( 1, 'e017', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, GetUnitFacing(GetTriggerUnit()) )
        endif
    endif
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 4.50 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A04R', udg_Temp_Unit) * 50 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 35 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    if ( Trig_Blessed_Shield_Func025C() ) then
        set udg_Temp_Real = ( ( 0.10 * I2R(( GetUnitAbilityLevelSwapped('A0AQ', udg_Temp_Unit) + 1 )) ) + 1.00 )
        set udg_RealStatCalc = ( udg_Temp_Real * udg_RealStatCalc )
    else
    endif
    call BlzSetUnitWeaponIntegerFieldBJ( GetLastCreatedUnit(), UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 0, R2I(udg_RealStatCalc) )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "attack", GetSpellTargetUnit() )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
endfunction

//===========================================================================
function InitTrig_Blessed_Shield takes nothing returns nothing
    set gg_trg_Blessed_Shield = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Blessed_Shield, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Blessed_Shield, Condition( function Trig_Blessed_Shield_Conditions ) )
    call TriggerAddAction( gg_trg_Blessed_Shield, function Trig_Blessed_Shield_Actions )
