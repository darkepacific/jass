endfunction

function Trig_Koltira_Deathweaver_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    set udg_Temp_Unit_Point = GetUnitLoc(GetDyingUnit())
    call CreateItemLoc( 'I00E', udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call DisplayTimedTextToForce( GetPlayersAll(), 3.00, "TRIGSTR_9899" )
    if ( Trig_Koltira_Deathweaver_Func006C() ) then
        call TriggerSleepAction( 3.00 )
        call FactionCapture( GetTriggerUnit(), Player(1), "Andorhal", "partly ", false)
        call SetUnitOwner( gg_unit_h004_0407, Player(1), true )
        if ( Trig_Koltira_Deathweaver_Func006Func013C() ) then
            call TriggerSleepAction( 6.00 )
            set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Araj_The_Summoner)
            call CreateNUnitsAtLoc( 1, 'U02C', Player(1), udg_Temp_Unit_Point, 208.53 )
            call RemoveLocation (udg_Temp_Unit_Point)
            set udg_DK_Thass = GetLastCreatedUnit()
            call TriggerRegisterUnitEvent( gg_trg_Thassarian, udg_DK_Thass, EVENT_UNIT_DEATH )
            call SetHeroLevelBJ( udg_DK_Thass, 18, true )
            call UnitAddItemByIdSwapped( 'I01U', udg_DK_Thass )
            call UnitAddItemByIdSwapped( 'I04A', udg_DK_Thass )
            call UnitAddItemByIdSwapped( 'I03B', udg_DK_Thass )
            call UnitAddItemByIdSwapped( 'I00E', udg_DK_Thass )
            call SelectHeroSkill( udg_DK_Thass, 'A001' )
            call SelectHeroSkill( udg_DK_Thass, 'A001' )
            call SelectHeroSkill( udg_DK_Thass, 'A001' )
            call SelectHeroSkill( udg_DK_Thass, 'A001' )
            call SelectHeroSkill( udg_DK_Thass, 'A001' )
            call SelectHeroSkill( udg_DK_Thass, 'A001' )
            call SelectHeroSkill( udg_DK_Thass, 'AUau' )
            call SelectHeroSkill( udg_DK_Thass, 'AUau' )
            call SelectHeroSkill( udg_DK_Thass, 'A06J' )
            call SelectHeroSkill( udg_DK_Thass, 'A06J' )
            call SelectHeroSkill( udg_DK_Thass, 'A06J' )
            call SelectHeroSkill( udg_DK_Thass, 'AUan' )
            call SelectHeroSkill( udg_DK_Thass, 'AUan' )
        else
            call TriggerSleepAction( 6.00 )
            set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Araj_The_Summoner)
            call ReviveHeroLoc( udg_DK_Thass, udg_Temp_Unit_Point, true )
            call RemoveLocation (udg_Temp_Unit_Point)
        endif
    else
        call TriggerSleepAction( 3.00 )
        call DisplayTimedTextToForce( GetPlayersAll(), 3.00, "TRIGSTR_9900" )
        call SetUnitOwner( gg_unit_h004_0407, Player(PLAYER_NEUTRAL_AGGRESSIVE), true )
        call TriggerSleepAction( 15.00 )
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Araj_The_Summoner)
        call ReviveHeroLoc( gg_unit_U00P_0836, udg_Temp_Unit_Point, true )
        call RemoveLocation (udg_Temp_Unit_Point)
        call SetUnitManaPercentBJ( gg_unit_U00P_0836, 100.00 )
    endif
    set udg_Temp_Unit_Point = null
endfunction

