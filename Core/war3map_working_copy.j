function InitTrig_Haunting_Wave_Neutral_Cast takes nothing returns nothing
    set gg_trg_Haunting_Wave_Neutral_Cast = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Haunting_Wave_Neutral_Cast, EVENT_PLAYER_UNIT_SPELL_CAST )
    call TriggerAddCondition( gg_trg_Haunting_Wave_Neutral_Cast, Condition( function Trig_Haunting_Wave_Neutral_Cast_Conditions ) )
    call TriggerAddAction( gg_trg_Haunting_Wave_Neutral_Cast, function Trig_Haunting_Wave_Neutral_Cast_Actions )
endfunction


//===========================================================================
// Trigger: Haunting Wave Scaling
//===========================================================================
function Trig_Haunting_Wave_Scaling_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A04V' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Haunting_Wave_Scaling_Func006C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'Usyl' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Haunting_Wave_Scaling_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 4.00 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A04V', udg_Temp_Unit) * 65 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 5 )
    if ( Trig_Haunting_Wave_Scaling_Func006C() ) then
        set udg_HeroStatCalc = 900
    else
    endif
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A04V'), ABILITY_RLF_DAMAGE_UCS1, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), udg_RealStatCalc )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A04V'), ABILITY_RLF_MAX_DAMAGE_UCS2, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), ( 7.00 * udg_RealStatCalc ) )
endfunction

//===========================================================================
function InitTrig_Haunting_Wave_Scaling takes nothing returns nothing
    set gg_trg_Haunting_Wave_Scaling = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Haunting_Wave_Scaling, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Haunting_Wave_Scaling, Condition( function Trig_Haunting_Wave_Scaling_Conditions ) )
    call TriggerAddAction( gg_trg_Haunting_Wave_Scaling, function Trig_Haunting_Wave_Scaling_Actions )
endfunction

