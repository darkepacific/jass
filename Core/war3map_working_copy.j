    set gg_trg_Water_Elementals = CreateTrigger(  )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Water_Elementals, Player(PLAYER_NEUTRAL_AGGRESSIVE), EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_Water_Elementals, Condition( function Trig_Water_Elementals_Conditions ) )
    call TriggerAddAction( gg_trg_Water_Elementals, function Trig_Water_Elementals_Actions )
