//===========================================================================
// Trigger: Leap of Faith
//===========================================================================
function Trig_Leap_of_Faith_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0FR' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Leap_of_Faith_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    call StopSoundBJ( gg_snd_LeapOfFaith, false )
    call PlaySoundOnUnitBJ( gg_snd_LeapOfFaith, 95.00, GetSpellTargetUnit() )
    call AddSpecialEffectTargetUnitBJ( "origin", GetSpellTargetUnit(), "war3mapImported\\BlueHolyWings.mdx" )
    if udg_Temp_Unit == udg_yA_Holy_Priest then
    set udg_o = udg_z_PR_HOLY_A
    set udg_Temp_Int = 37
    elseif udg_Temp_Unit == udg_yH_Holy_Priest then
    set udg_o = udg_z_PR_HOLY_H
    set udg_Temp_Int = 38
    endif
    set udg_o = ( udg_o + 8 )
    set udg_SpellUnits[udg_o] = GetSpellTargetUnit()
    set udg_Point_Charge_Begin[udg_Temp_Int] = GetUnitLoc(GetSpellTargetUnit())
    set udg_Point_Charge_End[udg_Temp_Int] = GetUnitLoc(GetTriggerUnit())
    set udg_Charge_SE[udg_Temp_Int] = GetLastCreatedEffectBJ()
    set udg_Charge_Loop[udg_Temp_Int] = 3.00
    if udg_Temp_Unit == udg_yA_Holy_Priest then
    call EnableTrigger( gg_trg_Leap_of_Faith_Timer_A)
    elseif udg_Temp_Unit == udg_yH_Holy_Priest then
    call EnableTrigger( gg_trg_Leap_of_Faith_Timer_H)
    endif
    call UnitRemoveBuffsBJ(1, udg_SpellUnits[udg_o] )
endfunction

//===========================================================================
function InitTrig_Leap_of_Faith takes nothing returns nothing
    set gg_trg_Leap_of_Faith = CreateTrigger(  )
