function Trig_MS_BFH_H_87_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 87
    local location udg_Temp_Unit_Point
    call DisableTrigger( GetTriggeringTrigger() )
    call SetUnitInvulnerable( gg_unit_U001_0290, false )
    if ( Trig_MS_BFH_H_87_Func005C() ) then
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Q_42M)
    else
        if ( Trig_MS_BFH_H_87_Func005Func001C() ) then
            set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Q_43M)
        else
            if ( Trig_MS_BFH_H_87_Func005Func001Func001C() ) then
                set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Q_44M)
            else
                if ( Trig_MS_BFH_H_87_Func005Func001Func001Func001C() ) then
                    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Q_45M)
                else
                endif
            endif
        endif
    endif
    call SetUnitPositionLoc( GetSummonedUnit(), udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_BattleForHillsbrad[0] = GetSummonedUnit()
    set udg_TempString = ""
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    set udg_TempString = udg_ExclamationMark
    endif
    call AddSpecialEffectTargetUnitBJ( "overhead", udg_BattleForHillsbrad[0], udg_TempString )
    call BlzSetSpecialEffectColor( GetLastCreatedEffectBJ(), 255, 255, 255 )
    set udg_QuestMarks[87] = GetLastCreatedEffectBJ()
    call PlaySoundOnUnitBJ( gg_snd_QuestAutoComplete, 100.00, udg_BattleForHillsbrad[0] )
    call TriggerSleepAction( 2.25 )
    set udg_TempString = "Excellent work! Our next task is to secure this entire region as our own. The humans of the Alliance control the Hillsbrad Fields. The Banshee Queen cannot allow this.  "
    // Set Quest Rewards
    set udg_QUEST_XP[udg_Temp_Int] = 900
    set udg_QUEST_GOLD[udg_Temp_Int] = 400
    set udg_QUEST_LVL_REQ[udg_Temp_Int] = udg_QUEST_ZONE_3_LVL_REQ
    call QuestRewards_TextSet(udg_Temp_Int)
    // End Set Quest Rewards
    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_671", udg_TempString, "ReplaceableTextures\\CommandButtons\\BTNHeroArchMage.blp" )
    set udg_Quests[87] = GetLastCreatedQuestBJ()
    call QuestSetEnabledBJ( false, udg_Quests[87] )
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    call QuestSetEnabledBJ( true, udg_Quests[87] )
    call FlashQuestDialogButtonBJ(  )
    endif
    set udg_TempString = "Battle for Hillsbrad"
    set udg_TempString_Quest = "Capture the Hillsbrad Fields."
    call TriggerExecute( gg_trg_Quest_Start_H )
    call DestroyEffectBJ( udg_QuestMarks[87] )
    call QuestSetCompletedBJ( udg_Quests[87], false )
    call CreateQuestItemBJ( udg_Quests[87], "TRIGSTR_675" )
    set udg_QuestReqs[87] = GetLastCreatedQuestItemBJ()
    if ( Trig_MS_BFH_H_87_Func039C() ) then
        set udg_TowerHeroes[4] = gg_unit_n026_1411
        call PauseTimerBJ( true, udg_TowerTimers[4] )
        call TriggerExecute( gg_trg_Hillsbrad_Fields_Capture )
    else
    endif
    call EnableTrigger( gg_trg_E_BFH_H )
    set udg_Temp_Unit_Point = null
endfunction

