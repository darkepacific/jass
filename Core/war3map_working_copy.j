    local unit Peasant
    local location udg_Temp_Unit_Point
    call DisableTrigger( GetTriggeringTrigger() )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Azurelode_Peasant)
    call CreateNUnitsAtLoc( 1, 'hpea', Player(1), udg_Temp_Unit_Point, 257.73 )
    call RemoveLocation (udg_Temp_Unit_Point)
      set Peasant = GetLastCreatedUnit()
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "smart", gg_unit_ncop_1306 )
    call TriggerSleepAction( 0.25 )
