function InitTrig_Muru_Darkness takes nothing returns nothing
    set gg_trg_Muru_Darkness = CreateTrigger(  )
    call TriggerRegisterUnitEvent( gg_trg_Muru_Darkness, gg_unit_H03W_2340, EVENT_UNIT_DAMAGED )
    call TriggerAddCondition( gg_trg_Muru_Darkness, Condition( function Trig_Muru_Darkness_Conditions ) )
    call TriggerAddAction( gg_trg_Muru_Darkness, function Trig_Muru_Darkness_Actions )
