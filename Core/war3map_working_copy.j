//===========================================================================
// Trigger: Mannoroth
//===========================================================================
function Trig_Mannoroth_Func015Func001C takes nothing returns boolean
    if ( not ( IsUnitEnemy(GetEnumUnit(), Player(PLAYER_NEUTRAL_AGGRESSIVE)) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( BlzIsUnitInvulnerable(GetEnumUnit()) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mannoroth_Func015A takes nothing returns nothing
    if ( Trig_Mannoroth_Func015Func001C() ) then
        call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "war3mapImported\\Pillar of Flame Fel.mdx" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "Abilities\\Weapons\\FireBallMissile\\FireBallMissile.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call UnitDamageTargetBJ( GetTriggerUnit(), GetEnumUnit(), 1000.00, ATTACK_TYPE_HERO, DAMAGE_TYPE_UNIVERSAL )
    else
    endif
endfunction

function Trig_Mannoroth_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    call CreateItemLoc( 'I06J', udg_Temp_Unit_Point )
    call CreateItemLoc( 'I03P', udg_Temp_Unit_Point )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Nether Blast III.mdx" )
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), 40.00 )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 2.60 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call PlaySoundAtPointBJ( gg_snd_InfernalBirth1, 100, udg_Temp_Unit_Point, 500.00 )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 1.20 )
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    // AoE
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(410.00, udg_Temp_Unit_Point), function Trig_Mannoroth_Func015A )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 150.00 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Mannoroth)
    call ReviveHeroLoc( gg_unit_Nman_1706, udg_Temp_Unit_Point, true )
    call RemoveLocation (udg_Temp_Unit_Point)
    call SetUnitManaPercentBJ( GetTriggerUnit(), 100.00 )
    set udg_Temp_Unit_Point = null
endfunction

//===========================================================================
function InitTrig_Mannoroth takes nothing returns nothing
    set gg_trg_Mannoroth = CreateTrigger(  )
    call TriggerRegisterUnitEvent( gg_trg_Mannoroth, gg_unit_Nman_1706, EVENT_UNIT_DEATH )
    call TriggerAddAction( gg_trg_Mannoroth, function Trig_Mannoroth_Actions )
endfunction

