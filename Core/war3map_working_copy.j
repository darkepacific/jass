function Trig_Ettin_Dies_Func002001 takes nothing returns boolean
    return ( GetRandomInt(1, 6) > 4 )
endfunction

function Trig_Ettin_Dies_Func002003001 takes nothing returns boolean
    return ( GetRandomInt(1, 4) > 2 )
endfunction

function Trig_Ettin_Dies_Actions takes nothing returns nothing
    set udg_Temp_Unit_Point = GetUnitLoc(GetDyingUnit())
    if ( Trig_Ettin_Dies_Func002001() ) then
        call CreateItemLoc( 'I03G', udg_Temp_Unit_Point )
    else
