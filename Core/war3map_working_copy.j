//===========================================================================
// Trigger: Water Elementals
//===========================================================================
function Trig_Water_Elementals_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'hwat' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Water_Elementals_Func013C takes nothing returns boolean
    if ( not ( ModuloInteger(GetTriggerExecCount(GetTriggeringTrigger()), 4) == 0 ) ) then
        return false
    endif
    if ( not ( udg_QuestPrincessMotesW < 1.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Water_Elementals_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    local integer udg_i = 0
    // ITEM TABLE
    // Set 1
    set udg_ItemDropTable[udg_i] = 'I02Z'
    set udg_ItemDropPerc[udg_i] = 40.00
    set udg_i = ( udg_i + 1 )
    set udg_ItemDropTable[udg_i] = 'I076'
    set udg_ItemDropPerc[udg_i] = 50.00
    // DROP ITEM
    set udg_Temp_Unit_Point = GetUnitLoc(GetDyingUnit())
    call CreateItemsFromDropTable( udg_Temp_Unit_Point)
    if ( Trig_Water_Elementals_Func013C() ) then
        call CreateItemLoc( 'I092', udg_Temp_Unit_Point )
    else
    endif
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 90.00 )
    set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_Water_Elementals)
    call CreateNUnitsAtLoc( 1, 'hwat', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
    call RemoveLocation (udg_Temp_Unit_Point)
    call SetUnitAcquireRangeBJ( GetLastCreatedUnit(), 200.00 )
    set udg_Temp_Unit_Point = null
endfunction

