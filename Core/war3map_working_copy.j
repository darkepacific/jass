    set gg_trg_Reliquary_of_Souls_Turn_On = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Reliquary_of_Souls_Turn_On, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Reliquary_of_Souls_Turn_On, Condition( function Trig_Reliquary_of_Souls_Turn_On_Conditions ) )
