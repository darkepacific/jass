//===========================================================================
// Trigger: Explosive Sheep Autowalk
//===========================================================================
function Trig_Explosive_Sheep_Autowalk_Conditions takes nothing returns boolean
    return GetUnitTypeId(GetSoldUnit()) == 'n053'
endfunction

function Trig_Explosive_Sheep_Autowalk_Actions takes nothing returns nothing
    local unit soldUnit = GetSoldUnit()
    local location targetLoc
    if GetRandomInt(0, 1) == 0 then
        set targetLoc = GetRectCenter(gg_rct_Sheep_Autoboom_1)
    else
        set targetLoc = GetRectCenter(gg_rct_Sheep_Autoboom_2)
    endif
    call IssuePointOrderLoc(soldUnit, "move", targetLoc)
    call UnitApplyTimedLife(soldUnit, 'BTLF', 40.0)
    //call IssuePointOrderLoc(soldUnit, "kaboom", targetLoc)
    call RemoveLocation(targetLoc)
    set soldUnit = null
    set targetLoc = null
endfunction

//===========================================================================
function InitTrig_Explosive_Sheep_Autowalk takes nothing returns nothing
    set gg_trg_Explosive_Sheep_Autowalk = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Explosive_Sheep_Autowalk, EVENT_PLAYER_UNIT_SELL)
    call TriggerAddCondition(gg_trg_Explosive_Sheep_Autowalk, Condition(function Trig_Explosive_Sheep_Autowalk_Conditions))
    call TriggerAddAction(gg_trg_Explosive_Sheep_Autowalk, function Trig_Explosive_Sheep_Autowalk_Actions)
endfunction


