//===========================================================================
// Trigger: Barrel Roll KnockBack
//===========================================================================
function Trig_Barrel_Roll_KnockBack_Func007Func002Func013Func001C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 2) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Barrel_Roll_KnockBack_Func007Func002Func013C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 3) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Barrel_Roll_KnockBack_Func007Func002Func019C takes nothing returns boolean
    if ( not ( IsUnitInGroup(GetEnumUnit(), udg_KnockBacks) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Barrel_Roll_KnockBack_Func007Func002C takes nothing returns boolean
    if ( not ( IsUnitEnemy(GetEnumUnit(), GetOwningPlayer(udg_Temp_Unit)) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_FLYING) == false ) ) then
        return false
    endif
    if ( not ( BlzIsUnitInvulnerable(GetEnumUnit()) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Barrel_Roll_KnockBack_Func007A takes nothing returns nothing
    set udg_Temp_Unit = udg_Heroes[udg_Player_Number]
    if ( Trig_Barrel_Roll_KnockBack_Func007Func002C() ) then
        // dmg
        call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL )
        call HasFirelords( GetEnumUnit() )
        // mvmnt
        set udg_Temp_Polar_Point = GetUnitLoc(GetEnumUnit())
        set udg_Charge_Distance = DistanceBetweenPoints(udg_Temp_Unit_Point, udg_Temp_Polar_Point)
        set udg_Temp_Real = AngleBetweenPoints(udg_Temp_Unit_Point, udg_Temp_Polar_Point)
        set udg_Temp_X_Point = PolarProjectionBJ(udg_Temp_Polar_Point, ( 160.00 - udg_Charge_Distance ), udg_Temp_Real)
        call RemoveLocation (udg_Temp_Polar_Point)
        if not IsTerrainPathable( GetLocationX(udg_Temp_X_Point), GetLocationY(udg_Temp_X_Point), PATHING_TYPE_WALKABILITY) then
        call SetUnitPositionLoc( GetEnumUnit(), udg_Temp_X_Point )
        endif
        if ( Trig_Barrel_Roll_KnockBack_Func007Func002Func013C() ) then
            call PlaySoundOnUnitBJ( gg_snd_WyvernCageDeath1, 70.00, GetEnumUnit() )
        else
            if ( Trig_Barrel_Roll_KnockBack_Func007Func002Func013Func001C() ) then
                call PlaySoundOnUnitBJ( gg_snd_WyvernCageDeath101, 70.00, GetEnumUnit() )
            else
                call PlaySoundOnUnitBJ( gg_snd_WyvernCageDeath102, 70.00, GetEnumUnit() )
            endif
        endif
        call RemoveLocation (udg_Temp_X_Point)
        // KnockBackLoop Turn ON
        call UnitAddAbilityBJ( 'Amrf', GetEnumUnit() )
        call UnitRemoveAbilityBJ( 'Amrf', GetEnumUnit() )
        call SetUnitFlyHeightBJ( GetEnumUnit(), 135.00, 0.00 )
        if ( Trig_Barrel_Roll_KnockBack_Func007Func002Func019C() ) then
            call GroupAddUnitSimple( GetEnumUnit(), udg_KnockBacks )
        else
            call FlushChildHashtableBJ( GetHandleIdBJ(GetEnumUnit()), udg_KnockBacksHash )
        endif
        call SaveRealBJ( udg_Temp_Real, 0, GetHandleIdBJ(GetEnumUnit()), udg_KnockBacksHash )
        call SaveRealBJ( 4.00, 1, GetHandleIdBJ(GetEnumUnit()), udg_KnockBacksHash )
        call SaveRealBJ( 172.00, 2, GetHandleIdBJ(GetEnumUnit()), udg_KnockBacksHash )
        call SaveRealBJ( 13.00, 3, GetHandleIdBJ(GetEnumUnit()), udg_KnockBacksHash )
        call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    else
    endif
endfunction

function Trig_Barrel_Roll_KnockBack_Actions takes nothing returns nothing
    set udg_HeroStatCalc = GetUnitAbilityLevelSwapped('A09G', udg_Temp_Unit)
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 2.00 * udg_RealStatCalc )
    set udg_RealStatCalc = ( ( 20.00 * I2R(udg_HeroStatCalc) ) + udg_RealStatCalc )
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(172.00, udg_Temp_Unit_Point), function Trig_Barrel_Roll_KnockBack_Func007A )
    call RemoveLocation (udg_Temp_Unit_Point)
    call EnableTrigger( gg_trg_KnockBackLoop)
endfunction

//===========================================================================
function InitTrig_Barrel_Roll_KnockBack takes nothing returns nothing
    set gg_trg_Barrel_Roll_KnockBack = CreateTrigger(  )
    call DisableTrigger( gg_trg_Barrel_Roll_KnockBack )
    call TriggerAddAction( gg_trg_Barrel_Roll_KnockBack, function Trig_Barrel_Roll_KnockBack_Actions )
endfunction

//===========================================================================
// Trigger: Breath of Fire
//===========================================================================
function Trig_Breath_of_Fire_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'ANbf' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Breath_of_Fire_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 3.50 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('ANbf', udg_Temp_Unit) * 60 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 5 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'ANbf'), ABILITY_RLF_DAMAGE_UCS1, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), udg_RealStatCalc )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'ANbf'), ABILITY_RLF_MAX_DAMAGE_UCS2, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), ( 10.00 * udg_RealStatCalc ) )
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 4 ] then 
    set udg_RealStatCalc = ( 3.00 * udg_RealStatCalc )
    endif
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('ANbf', udg_Temp_Unit) * 6 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 1 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'ANbf'), ABILITY_RLF_DAMAGE_PER_SECOND_NBF5, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), udg_RealStatCalc )
endfunction

//===========================================================================
function InitTrig_Breath_of_Fire takes nothing returns nothing
    set gg_trg_Breath_of_Fire = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Breath_of_Fire, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Breath_of_Fire, Condition( function Trig_Breath_of_Fire_Conditions ) )
    call TriggerAddAction( gg_trg_Breath_of_Fire, function Trig_Breath_of_Fire_Actions )
endfunction

//===========================================================================
// Trigger: Monk Dies
//===========================================================================
function Trig_Monk_Dies_Actions takes nothing returns nothing
    local unit udg_Temp_Unit = GetTriggerUnit()
    if udg_Temp_Unit == udg_yA_Brew_Monk or udg_Temp_Unit ==udg_yH_Brew_Monk then
    if ( udg_Temp_Unit == udg_yA_Brew_Monk) then
    call DisableTrigger( gg_trg_Barrel_Roll_KnockBack_A)
    elseif ( udg_Temp_Unit == udg_yH_Brew_Monk) then
    call DisableTrigger( gg_trg_Barrel_Roll_KnockBack_H)
    endif
    call SetPlayerAbilityAvailableBJ( true, 'ANbf', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'ANdh', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'AOw2', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A09F', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A09H', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A0E6', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A0E7', GetOwningPlayer(GetTriggerUnit()) )
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer( udg_Temp_Unit )) * udg_NUM_OF_TC + 10 ]  then
    call SetUnitMoveSpeed(udg_Temp_Unit, GetUnitDefaultMoveSpeed(udg_Temp_Unit) + 50.0)
    endif
    endif
    set udg_Temp_Unit = null
endfunction

