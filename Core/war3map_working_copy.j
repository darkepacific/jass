//===========================================================================
// Trigger: Call To Arms
//===========================================================================
function Trig_Call_To_Arms_Func007C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A00S' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A01M' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Call_To_Arms_Conditions takes nothing returns boolean
    if ( not Trig_Call_To_Arms_Func007C() ) then
        return false
    endif
    return true
endfunction

function Trig_Call_To_Arms_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 11 ]  then
    call BlzSetAbilityIntegerLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, GetSpellAbilityId()), ABILITY_ILF_NUMBER_OF_SUMMONED_UNITS_OSF2, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), 4 )
    else
    call BlzSetAbilityIntegerLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, GetSpellAbilityId()), ABILITY_ILF_NUMBER_OF_SUMMONED_UNITS_OSF2, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), 3 )
    endif
endfunction

//===========================================================================
function InitTrig_Call_To_Arms takes nothing returns nothing
    set gg_trg_Call_To_Arms = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Call_To_Arms, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Call_To_Arms, Condition( function Trig_Call_To_Arms_Conditions ) )
    call TriggerAddAction( gg_trg_Call_To_Arms, function Trig_Call_To_Arms_Actions )
endfunction

//===========================================================================
// Trigger: Light of Dawn
//
// Calculate the distance between Position of Unit
// Dont create chain units move them back and forth between island
//===========================================================================
function Trig_Light_of_Dawn_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0FX' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Light_of_Dawn_Func012C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(udg_Temp_Unit, 'B01F') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Light_of_Dawn_Func036A takes nothing returns nothing
    // apply firelords to enemies, deal 0 dmg for aggro
    if IsUnitTargetableEnemy( GetEnumUnit(), udg_Temp_Unit ) then
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), 0.00, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "Abilities\\Spells\\Human\\Slow\\SlowCaster.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call HasFirelords( GetEnumUnit() )
    // heal allies
    elseif IsUnitTargetableAlly( GetEnumUnit(), udg_Temp_Unit ) then
    call SetUnitLifeBJ( GetEnumUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetEnumUnit()) + udg_RealStatCalc ) )
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    if udg_Temp_Unit != GetEnumUnit() then
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 1 )
    endif
    endif
endfunction

function Trig_Light_of_Dawn_Actions takes nothing returns nothing
    local location  udg_Temp_Unit_Point = GetUnitLoc( GetTriggerUnit() )
    local location  udg_Temp_Polar_Point
    local unit dummy
    set udg_Temp_Unit = GetTriggerUnit()
    call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
    // ability scaling
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 3.00 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A0FX', udg_Temp_Unit) * 50 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 20 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    if ( Trig_Light_of_Dawn_Func012C() ) then
        set udg_Temp_Real = ( ( 0.10 * I2R(( GetUnitAbilityLevelSwapped('A0AQ', udg_Temp_Unit) + 1 )) ) + 1.00 )
        set udg_RealStatCalc = ( udg_Temp_Real * udg_RealStatCalc )
    else
    endif
    call ChaliceSet()
    // point math
    set udg_Temp_Polar_Point = GetSpellTargetLoc()
    set udg_Temp_Real = AngleBetweenPoints(udg_Temp_Unit_Point, udg_Temp_Polar_Point)
    call RemoveLocation (udg_Temp_Polar_Point)
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 280.00, udg_Temp_Real)
    // Dummy creation
    call CreateNUnitsAtLoc( 1, 'e01A', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, udg_Temp_Real )
    set dummy = GetLastCreatedUnit()
    set udg_Temp_Unit = dummy
    call SetUnitAbilityLevelSwapped( 'A00E', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0FX', GetTriggerUnit()) )
    call UnitApplyTimedLifeBJ( 0.50, 'BTLF', GetLastCreatedUnit() )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A00E'), ABILITY_RLF_DAMAGE_UCS1, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), udg_RealStatCalc )
    call SetUnitPositionLoc( udg_Temp_Unit, udg_Temp_Unit_Point )
    // Healing Portion
    set udg_RealStatCalc = ( udg_RealStatCalc / 2.00 )
    // Light of Dawn Talent
    set udg_Temp_Unit = GetTriggerUnit()
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 1 ]  then
    call SetUnitLifeBJ( udg_Temp_Unit, ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_Temp_Unit) + ( 0.12 * udg_RealStatCalc ) ) )
    endif
    set udg_HeroStatCalc = 0
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(390.00, udg_Temp_Polar_Point), function Trig_Light_of_Dawn_Func036A )
    // Dummy Actually Casts
    set udg_Temp_Unit = dummy
    call IssuePointOrderLocBJ( udg_Temp_Unit, "carrionswarm", udg_Temp_Polar_Point )
    call RemoveLocation (udg_Temp_Polar_Point)
    // Beacon of Light Talent
    set udg_Temp_Unit = GetTriggerUnit()
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 14 ]  then
    if udg_HeroStatCalc > 0 then
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) * udg_RealStatCalc )
    call SetUnitLifeBJ( udg_Temp_Unit, ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_Temp_Unit) + ( 0.10 * udg_RealStatCalc ) ) )
    call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "Abilities\\Spells\\Items\\ResourceItems\\ResourceEffectTarget.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    endif
    endif
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 100.00, udg_Temp_Real)
    call AddSpecialEffectLocBJ( udg_Temp_Polar_Point, "war3mapImported\\GlimpseofMaddness.mdx" )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), Deg2Rad(udg_Temp_Real), 0.00, 0.00 )
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), ( BlzGetLocalUnitZ(GetTriggerUnit()) - 0.00 ) )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 1.80 )
    call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 1.50 )
    call BlzSetSpecialEffectColor( GetLastCreatedEffectBJ(), 205, 255, 150 )
    call BlzSetSpecialEffectAlpha( GetLastCreatedEffectBJ(), 255 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call RemoveLocation (udg_Temp_Unit_Point)
    call RemoveLocation (udg_Temp_Polar_Point)
    set udg_Temp_Unit_Point = null
    set udg_Temp_Polar_Point = null
    set dummy = null
endfunction

//===========================================================================
function InitTrig_Light_of_Dawn takes nothing returns nothing
    set gg_trg_Light_of_Dawn = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Light_of_Dawn, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Light_of_Dawn, Condition( function Trig_Light_of_Dawn_Conditions ) )
    call TriggerAddAction( gg_trg_Light_of_Dawn, function Trig_Light_of_Dawn_Actions )
endfunction

//===========================================================================
// Trigger: Lights Hammer
//===========================================================================
function Trig_Lights_Hammer_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A04J' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Lights_Hammer_Func021Func001C takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetTriggerUnit()) != Player(PLAYER_NEUTRAL_AGGRESSIVE) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Lights_Hammer_Func021C takes nothing returns boolean
    if ( not ( GetTriggerUnit() == udg_yA_Holy_Pally ) ) then
        return false
    endif
    return true
endfunction

function Trig_Lights_Hammer_Actions takes nothing returns nothing
    local effect hammer
    set udg_Temp_Unit_Point = GetSpellTargetLoc()
    // drop the hammer
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Judgement NoHive.mdx" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.50 )
    call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 3.60 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    // hammer effect
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Sulfuras Hand Of Ragnaros.mdx" )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), 0.00, Deg2Rad(45.00), 0.00 )
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), ( BlzGetLocalSpecialEffectZ(GetLastCreatedEffectBJ()) + 32.00 ) )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 1.70 )
    call BlzSetSpecialEffectColor( GetLastCreatedEffectBJ(), 185, 255, 150 )
    call BlzSetSpecialEffectAlpha( GetLastCreatedEffectBJ(), 185 )
    set hammer = GetLastCreatedEffectBJ()
    // create dummy
    call CreateNUnitsAtLoc( 1, 'e01A', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, bj_UNIT_FACING )
    call SetUnitAbilityLevelSwapped( 'A0AO', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A04J', GetTriggerUnit()) )
    call RemoveLocation (udg_Temp_Unit_Point)
    if ( Trig_Lights_Hammer_Func021C() ) then
        set udg_Shaman_Eq_Ls[4] = GetLastCreatedUnit()
        call UnitApplyTimedLifeBJ( 7.00, 'BTLF', udg_Shaman_Eq_Ls[4] )
        set udg_SpellTicks[16] = 1
        call EnableTrigger( gg_trg_Lights_Hammer_Tick_Human )
    else
        if ( Trig_Lights_Hammer_Func021Func001C() ) then
            set udg_Shaman_Eq_Ls[9] = GetLastCreatedUnit()
            call UnitApplyTimedLifeBJ( 7.00, 'BTLF', udg_Shaman_Eq_Ls[9] )
            set udg_SpellTicks[17] = 1
            call EnableTrigger( gg_trg_Lights_Hammer_Tick_Blood_Elf )
        else
            set udg_Shaman_Eq_Ls[31] = GetLastCreatedUnit()
            call UnitApplyTimedLifeBJ( 7.00, 'BTLF', udg_Shaman_Eq_Ls[31] )
            set udg_SpellTicks[31] = 1
            call EnableTrigger( gg_trg_Lights_Hammer_Tick_Eyir )
        endif
    endif
    call TriggerSleepAction( 6.06 )
    call DestroyEffectBJ( hammer )
    set hammer = null
endfunction

//===========================================================================
function InitTrig_Lights_Hammer takes nothing returns nothing
    set gg_trg_Lights_Hammer = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Lights_Hammer, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Lights_Hammer, Condition( function Trig_Lights_Hammer_Conditions ) )
    call TriggerAddAction( gg_trg_Lights_Hammer, function Trig_Lights_Hammer_Actions )
endfunction

//===========================================================================
// Trigger: Lights Hammer Tick Human
//
// RealStatCalc - Ability + Scaling Damage
// HeroStatCalc - Ability Damage
// TempReal - Stores the Avenging Crusader Multiplier
//===========================================================================
function Trig_Lights_Hammer_Tick_Human_Func010C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(udg_Temp_Unit, 'B01F') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Lights_Hammer_Tick_Human_Func018C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(udg_Temp_Unit, 'B01F') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Lights_Hammer_Tick_Human_Func022A takes nothing returns nothing
    if IsUnitTargetableEnemy( GetEnumUnit(), udg_Temp_Unit ) then
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), I2R(udg_HeroStatCalc), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "Abilities\\Weapons\\GryphonRiderMissile\\GryphonRiderMissile.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "Abilities\\Spells\\Human\\StormBolt\\StormBoltMissile.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call HasFirelords( GetEnumUnit() )
    elseif IsUnitTargetableAlly( GetEnumUnit(), udg_Temp_Unit ) then
    call SetUnitLifeBJ( GetEnumUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetEnumUnit()) + ( udg_RealStatCalc / 3.00 ) ) )
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "war3mapImported\\Heal.mdx" )
    call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 1.50 )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.75 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set udg_Temp_Int2 = ( udg_Temp_Int2 + 1 )
    endif
endfunction

function Trig_Lights_Hammer_Tick_Human_Func033C takes nothing returns boolean
    if ( not ( udg_SpellTicks[16] == 6 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Lights_Hammer_Tick_Human_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 4
    set udg_Temp_Unit = udg_yA_Holy_Pally
    call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
    // real stat calc
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 1.50 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A04J', udg_Temp_Unit) * 25 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    if ( Trig_Lights_Hammer_Tick_Human_Func010C() ) then
        set udg_Temp_Real = ( ( 0.10 * I2R(( GetUnitAbilityLevelSwapped('A0AQ', udg_Temp_Unit) + 1 )) ) + 1.00 )
        set udg_RealStatCalc = ( udg_Temp_Real * udg_RealStatCalc )
        // set Dummy (Fan) damage using Temp Real
        set udg_Temp_Real = ( udg_Temp_Real * I2R(udg_HeroStatCalc) )
        call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Shaman_Eq_Ls[udg_Temp_Int], 'A0AO'), ABILITY_RLF_DAMAGE_PER_TARGET_EFK1, ( GetUnitAbilityLevelSwapped('A0AO', udg_Shaman_Eq_Ls[udg_Temp_Int]) - 1 ), udg_Temp_Real )
    else
    endif
    call ChaliceSet()
    call IssueImmediateOrderBJ( udg_Shaman_Eq_Ls[udg_Temp_Int], "fanofknives" )
    // real stat calc has real damage value, and healing bonus
    // herostat calc stores scaling damage
    set udg_HeroStatCalc = ( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) )
    set udg_HeroStatCalc = ( udg_HeroStatCalc * 3 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc / 2 )
    if ( Trig_Lights_Hammer_Tick_Human_Func018C() ) then
        set udg_Temp_Real = ( ( 0.10 * I2R(( GetUnitAbilityLevelSwapped('A0AQ', udg_Temp_Unit) + 1 )) ) + 1.00 )
        set udg_HeroStatCalc = R2I(( udg_Temp_Real * I2R(udg_HeroStatCalc) ))
    else
    endif
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Shaman_Eq_Ls[udg_Temp_Int])
    set udg_Temp_Int2 = 0
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(275.00, udg_Temp_Unit_Point), function Trig_Lights_Hammer_Tick_Human_Func022A )
    call RemoveLocation (udg_Temp_Unit_Point)
    // Beacon of Light Talent
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 14 ]  then
    if udg_Temp_Int2 > 0 then
    set udg_RealStatCalc = ( I2R(udg_Temp_Int2) * udg_RealStatCalc )
    call SetUnitLifeBJ( udg_Temp_Unit, ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_Temp_Unit) + ( 0.10 * udg_RealStatCalc ) ) )
    call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "Abilities\\Spells\\Items\\ResourceItems\\ResourceEffectTarget.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    endif
    endif
    if ( Trig_Lights_Hammer_Tick_Human_Func033C() ) then
        call KillUnit(udg_Shaman_Eq_Ls[4])
        call DisableTrigger( GetTriggeringTrigger() )
    else
        set udg_SpellTicks[16] = ( udg_SpellTicks[16] + 1 )
    endif
endfunction

//===========================================================================
function InitTrig_Lights_Hammer_Tick_Human takes nothing returns nothing
    set gg_trg_Lights_Hammer_Tick_Human = CreateTrigger(  )
    call DisableTrigger( gg_trg_Lights_Hammer_Tick_Human )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Lights_Hammer_Tick_Human, 1.00 )
    call TriggerAddAction( gg_trg_Lights_Hammer_Tick_Human, function Trig_Lights_Hammer_Tick_Human_Actions )
endfunction

