    if IsMakgoraWallUnit( GetEnumUnit() ) then
    if ( Trig_Makgora_Dies_Func007Func001Func002C() ) then
        call AddSpecialEffectTargetUnitBJ( "overhead", GetEnumUnit(), "Abilities\\Spells\\Other\\TalkToMe\\TalkToMe.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call SetUnitAnimation( GetEnumUnit(), "Stand Defend" )
    else
        call SetUnitAnimation( GetEnumUnit(), "Stand Victory" )
    endif
    endif
endfunction

