//===========================================================================
// Trigger: E Lord Perenold
//
// Change to Fel's Essence
//===========================================================================
function Trig_E_Lord_Perenold_Func005Func001C takes nothing returns boolean
    if ( not ( GetItemTypeId(udg_P_Items[( udg_Bag_Num + udg_Bag_Iterator )]) == udg_ItemTypeCheck ) ) then
        return false
    endif
    return true
endfunction

function Trig_E_Lord_Perenold_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 26
                       if IsAllianceHero( GetTriggerUnit() ) then
    call SetBagNumber( GetOwningPlayer(GetTriggerUnit()) )
    set udg_ItemTypeCheck = 'I059'
    set udg_Bag_Iterator = 1
    loop
        exitwhen udg_Bag_Iterator > udg_BAG_LOOP_MAX
        if ( Trig_E_Lord_Perenold_Func005Func001C() ) then
            if ( IsAlliancePlayer(GetLocalPlayer())) then
            call FlashQuestDialogButtonBJ(  )
            endif
            call QuestItemSetCompletedBJ( udg_QuestReqs[26], true )
            call QuestSetCompletedBJ( udg_Quests[26], true )
            call DestroyEffectBJ( udg_QuestMarks[26] )
            call DestroyMinimapIcon( udg_MiniMapIcon[26] )
            // Clean Up Items
            call CleanUpItems( udg_ItemTypeCheck )
            // Rewards
            set udg_XP = udg_QUEST_XP[udg_Temp_Int]
            set udg_Gold = udg_QUEST_GOLD[udg_Temp_Int]
            set udg_LVL_Req = udg_QUEST_LVL_REQ[udg_Temp_Int]
            set udg_TempString = "Lord Perenolde"
            call TriggerExecute( gg_trg_Quest_Complete_A )
            call DisableTrigger( GetTriggeringTrigger() )
            call DisableTrigger( gg_trg_U_LP_Head_Acquire )
            return
        else
        endif
        set udg_Bag_Iterator = udg_Bag_Iterator + 1
    endloop
                       endif
endfunction

