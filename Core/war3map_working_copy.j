    call DisableTrigger( gg_trg_H_Party_Favors)
    call DisableTrigger( gg_trg_G_Party_Favors)
    call DisableTrigger( gg_trg_U_Party_Favors)
    call DisableTrigger( GetTriggeringTrigger() )
    call TriggerSleepAction( 0.85 )
    call FireworksSpecial()
    call TriggerSleepAction( 8.00 )
    call EnableTrigger( gg_trg_Fairbreeze_Fireworks_Enter)
endfunction

