// Trigger: U PYR
//===========================================================================
function Trig_U_PYR_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0GK' ) ) then
        return false
    endif
    return true
endfunction

function Trig_U_PYR_Func004Func001Func009Func003C takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetEnumUnit()) == Player(PLAYER_NEUTRAL_AGGRESSIVE) ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_U_PYR_Func004Func001Func009A takes nothing returns nothing
    local location udg_Temp_Polar_Point
    set udg_Temp_Polar_Point = GetRectCenter(gg_rct_Forsaken_Crest)
    if ( Trig_U_PYR_Func004Func001Func009Func003C() ) then
        call AddSpecialEffectTargetUnitBJ( "overhead", GetEnumUnit(), "Abilities\\Spells\\Other\\TalkToMe\\TalkToMe.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call IssuePointOrderLoc(GetEnumUnit(), "attack", udg_Temp_Polar_Point)
    else
    endif
    call RemoveLocation (udg_Temp_Polar_Point)
    set udg_Temp_Polar_Point = null
endfunction

function Trig_U_PYR_Func004Func001Func015A takes nothing returns nothing
    local integer udg_Temp_Int = 128
    call TimerDialogDisplayForPlayerBJ( true, udg_QuestTimerWindows[udg_Temp_Int], GetEnumPlayer() )
endfunction

function Trig_U_PYR_Func004Func001C takes nothing returns boolean
    if ( not ( IsTriggerEnabled(gg_trg_F_PYR) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_U_PYR_Func004C takes nothing returns boolean
    if ( not ( RectContainsUnit(gg_rct_Forsaken_Crest, GetTriggerUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_U_PYR_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 128
    local location udg_Temp_Unit_Point
                       if IsHordeHero( GetTriggerUnit() ) then
    if ( Trig_U_PYR_Func004C() ) then
        if ( Trig_U_PYR_Func004Func001C() ) then
            set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Forsaken_Crest)
            call StopSoundBJ( gg_snd_MakGora_Orc, false )
            call PlaySoundAtPointBJ( gg_snd_MakGora_Orc, 100, udg_Temp_Unit_Point, 50.00 )
            call CreateNUnitsAtLoc( 1, 'n05U', Player(3), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
            set bj_wantDestroyGroup = true
            call ForGroupBJ( GetUnitsInRangeOfLocAll(600.00, udg_Temp_Unit_Point), function Trig_U_PYR_Func004Func001Func009A )
            call RemoveLocation (udg_Temp_Unit_Point)
            call StartTimerBJ( udg_QuestTimers[udg_Temp_Int], false, 45.00 )
            call CreateTimerDialogBJ( GetLastCreatedTimerBJ(), "TRIGSTR_11432" )
            set udg_QuestTimerWindows[udg_Temp_Int] = GetLastCreatedTimerDialogBJ()
            call TimerDialogDisplayBJ( false, udg_QuestTimerWindows[udg_Temp_Int] )
            call ForForce( udg_HordePlayers, function Trig_U_PYR_Func004Func001Func015A )
            call EnableTrigger( gg_trg_P_PYR)
            call EnableTrigger( gg_trg_F_PYR)
        else
            call ErrorMessage("Quest already in progress.", GetTriggerPlayer() )
            call IssueImmediateOrderBJ( GetTriggerUnit(), "stop" )
        endif
    else
        call ErrorMessage("Must be in Pyrewood to use this item.", GetTriggerPlayer() )
        call IssueImmediateOrderBJ( GetTriggerUnit(), "stop" )
    endif
                       endif
    set udg_Temp_Unit_Point = null
endfunction

