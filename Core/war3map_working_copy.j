//
// Safe to put on non-player units
//===========================================================================
function Trig_Rupture_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A04P' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Rupture_Func003C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 6) > 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Rupture_Func005Func005C takes nothing returns boolean
    if ( not ( GetSpellAbilityUnit() == udg_yH_Ass_Rogue ) ) then
        return false
    endif
    return true
endfunction

function Trig_Rupture_Func005C takes nothing returns boolean
    if ( not ( GetSpellAbilityUnit() == udg_yA_Ass_Rogue ) ) then
        return false
    endif
    return true
endfunction

function Trig_Rupture_Func011C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetSpellTargetUnit(), 'B01B') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Rupture_Actions takes nothing returns nothing
    local real ComboPoints = 0
    set udg_Temp_Unit = GetTriggerUnit()
    if ( Trig_Rupture_Func003C() ) then
        call PlaySoundOnUnitBJ( gg_snd_MetalLightSliceFlesh2, 100.00, GetSpellAbilityUnit() )
    else
        call PlaySoundOnUnitBJ( gg_snd_MetalLightSliceFlesh3, 100.00, GetSpellAbilityUnit() )
    endif
    // Combo Points
    if ( Trig_Rupture_Func005C() ) then
        call DestroyEffectBJ( udg_AAssComboEffects[0] )
        call DestroyEffectBJ( udg_AAssComboEffects[1] )
        call DestroyEffectBJ( udg_AAssComboEffects[2] )
        set udg_Temp_Real = udg_AAssComboPoints
        set ComboPoints = udg_AAssComboPoints
        set udg_AAssComboPoints = 0.00
        call ResetComboPoints( GetTriggerUnit() )
    else
        set udg_Temp_Real = 3.00
        if ( Trig_Rupture_Func005Func005C() ) then
            call DestroyEffectBJ( udg_HAssComboEffects[0] )
            call DestroyEffectBJ( udg_HAssComboEffects[1] )
            call DestroyEffectBJ( udg_HAssComboEffects[2] )
            set udg_Temp_Real = udg_HAssComboPoints
            set ComboPoints = udg_HAssComboPoints
            set udg_HAssComboPoints = 0.00
            call ResetComboPoints( GetTriggerUnit() )
        else
        endif
    endif
    // Base Dmg
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_AGI, GetTriggerUnit(), true) - GetHeroStatBJ(bj_HEROSTAT_AGI, GetTriggerUnit(), false) ))
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A04P', udg_Temp_Unit) * 10 )
    set udg_RealStatCalc = ( ( udg_RealStatCalc + I2R(udg_HeroStatCalc) ) * udg_Temp_Real )
    // Marked for Death Multiplier
    if ( Trig_Rupture_Func011C() ) then
        set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A04O', udg_Temp_Unit) * 10 )
        set udg_HeroStatCalc = ( udg_HeroStatCalc + 20 )
        set udg_RealStatCalc = ( udg_RealStatCalc * ( 1 + ( I2R(udg_HeroStatCalc) / 100.00 ) ) )
    else
    endif
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A04P'), ABILITY_RLF_DECAYING_DAMAGE, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), udg_RealStatCalc )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A04P'), ABILITY_RLF_DURATION_NORMAL, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), ( 2.10 + ( 2.00 * udg_Temp_Real ) ) )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A04P'), ABILITY_RLF_DURATION_HERO, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), ( 2.10 + ( 1.00 * udg_Temp_Real ) ) )
    // Ruthlessness
    call GameTimeWait(0.1)
    set udg_Temp_Unit = GetTriggerUnit()
    if GetRandomReal( 0.0, 2.99) < ComboPoints then
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 10 ] then 
    call CreateTextTagUnitBJ( "TRIGSTR_9628", udg_Temp_Unit, 12.00, 9.00, 40.00, 100.00, 40.00, 0 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64, 90.00 )
    call cleanUpText(1.0, 0.5)
    if udg_Temp_Unit == udg_yA_Ass_Rogue then
    call ShowTextTagForceBJ( true, GetLastCreatedTextTag(), udg_AlliancePlayers )
    call TriggerExecute( gg_trg_A_Ass_ComboGen )
    else
    call ShowTextTagForceBJ( true, GetLastCreatedTextTag(), udg_HordePlayers )
    call TriggerExecute( gg_trg_H_Ass_ComboGen )
    endif
    endif
    endif
    // Elaborate Planning
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 14 ] then 
    call PlayerNumbtoHeroesNumbParam(GetOwningPlayer(udg_Temp_Unit))
    call StartTimerBJ( udg_CheatDeath[( udg_Player_Number + 8 )], false, 3.00 )
    call CreateTextTagUnitBJ( "TRIGSTR_9629", udg_Temp_Unit, 12.00, 9.00, 100.00, 85.00, 10.00, 0 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64, 180.00 )
    call cleanUpText(1.0, 0.5)
    if udg_Temp_Unit == udg_yA_Ass_Rogue then
    call ShowTextTagForceBJ( true, GetLastCreatedTextTag(), udg_AlliancePlayers )
    else
    call ShowTextTagForceBJ( true, GetLastCreatedTextTag(), udg_HordePlayers )
    endif
    endif
    // Clean Up
    set udg_Temp_Unit = null
endfunction

//===========================================================================
function InitTrig_Rupture takes nothing returns nothing
    set gg_trg_Rupture = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Rupture, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Rupture, Condition( function Trig_Rupture_Conditions ) )
    call TriggerAddAction( gg_trg_Rupture, function Trig_Rupture_Actions )
endfunction

//===========================================================================
// Trigger: Envenom
//===========================================================================
function Trig_Envenom_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0F2' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Envenom_Func004Func001Func001C takes nothing returns boolean
    if ( not ( GetSpellAbilityUnit() == udg_yA_Ass_Rogue ) ) then
        return false
    endif
    if ( not ( udg_AAssComboPoints < 1.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Envenom_Func004Func001Func002C takes nothing returns boolean
    if ( not ( GetSpellAbilityUnit() == udg_yH_Ass_Rogue ) ) then
        return false
    endif
    if ( not ( udg_HAssComboPoints < 1.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Envenom_Func004Func001C takes nothing returns boolean
    if ( Trig_Envenom_Func004Func001Func001C() ) then
        return true
    endif
    if ( Trig_Envenom_Func004Func001Func002C() ) then
        return true
    endif
    return false
endfunction

function Trig_Envenom_Func004C takes nothing returns boolean
    if ( not Trig_Envenom_Func004Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Envenom_Func016C takes nothing returns boolean
    if ( not ( GetSpellAbilityUnit() == udg_yA_Ass_Rogue ) ) then
        return false
    endif
    return true
endfunction

function Trig_Envenom_Func036C takes nothing returns boolean
    if ( not ( GetTriggerUnit() == udg_yA_Ass_Rogue ) ) then
        return false
    endif
    return true
endfunction

function Trig_Envenom_Actions takes nothing returns nothing
    local real ComboPoints
    local unit udg_Temp_Unit
    local effect eff
    if ( Trig_Envenom_Func004C() ) then
        call IssueImmediateOrderBJ( GetTriggerUnit(), "stop" )
        call ErrorMessage( "Not enough combo points.", GetOwningPlayer(GetTriggerUnit()) )
        call SetUnitManaBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) + I2R(BlzGetAbilityManaCost('A0F2', ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ))) ) )
        set eff = null
        set udg_Temp_Unit = null
        return
    else
    endif
    set udg_Temp_Unit = GetTriggerUnit()
    // Effect
    call PlaySoundOnUnitBJ( gg_snd_ArtilleryCorpseExplodeDeath101, 100.00, GetSpellAbilityUnit() )
    call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "war3mapImported\\Singularity II Green.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "right,hand", udg_Temp_Unit, "war3mapImported\\GreenHeal_Short.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "left,hand", udg_Temp_Unit, "war3mapImported\\GreenHeal_Short.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    // ComboPoints
    if ( Trig_Envenom_Func016C() ) then
        call DestroyEffectBJ( udg_AAssComboEffects[0] )
        call DestroyEffectBJ( udg_AAssComboEffects[1] )
        call DestroyEffectBJ( udg_AAssComboEffects[2] )
        set ComboPoints = udg_AAssComboPoints
        set udg_AAssComboPoints = 0.00
        call ResetComboPoints( GetTriggerUnit() )
    else
        call DestroyEffectBJ( udg_HAssComboEffects[0] )
        call DestroyEffectBJ( udg_HAssComboEffects[1] )
        call DestroyEffectBJ( udg_HAssComboEffects[2] )
        set ComboPoints = udg_HAssComboPoints
        set udg_HAssComboPoints = 0.00
        call ResetComboPoints( GetTriggerUnit() )
    endif
    // StartTimer
    call PlayerNumbtoHeroesNumbParam(GetTriggerPlayer())
    if 1 <= ComboPoints then
    call StartTimerBJ( udg_CheatDeath[( udg_Player_Number + 16 )], false, 6.00 )
    endif
    if 2 <= ComboPoints then
    call StartTimerBJ( udg_CheatDeath[( udg_Player_Number + 24 )], false, 6.00 )
    endif
    if 3 == ComboPoints then
    call StartTimerBJ( udg_CheatDeath[( udg_Player_Number + 32 )], false, 6.00 )
    endif
    call GameTimeWait(0.1)
    // Ruthless
    if GetRandomReal( 0.0, 2.99) < ComboPoints then
    set udg_Temp_Unit = GetTriggerUnit()
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 10 ] then 
    call CreateTextTagUnitBJ( "TRIGSTR_9857", udg_Temp_Unit, 12.00, 9.00, 40.00, 100.00, 40.00, 0 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64, 90.00 )
    call cleanUpText(1.0, 0.5)
    if ( Trig_Envenom_Func036C() ) then
        call ShowTextTagForceBJ( true, GetLastCreatedTextTag(), udg_AlliancePlayers )
        call TriggerExecute( gg_trg_A_Ass_ComboGen )
    else
        call ShowTextTagForceBJ( true, GetLastCreatedTextTag(), udg_HordePlayers )
        call TriggerExecute( gg_trg_H_Ass_ComboGen )
    endif
    endif
    endif
    // Elaborate Planning
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 14 ] then 
    call PlayerNumbtoHeroesNumbParam(GetOwningPlayer(udg_Temp_Unit))
    call StartTimerBJ( udg_CheatDeath[( udg_Player_Number + 8 )], false, 3.00 )
    call CreateTextTagUnitBJ( "TRIGSTR_9860", udg_Temp_Unit, 12.00, 9.00, 100.00, 85.00, 10.00, 0 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64, 180.00 )
    call cleanUpText(1.0, 0.5)
    if udg_Temp_Unit == udg_yA_Ass_Rogue then
    call ShowTextTagForceBJ( true, GetLastCreatedTextTag(), udg_AlliancePlayers )
    else
    call ShowTextTagForceBJ( true, GetLastCreatedTextTag(), udg_HordePlayers )
    endif
    endif
    // Clean Up
    set eff = null
    set udg_Temp_Unit = null
endfunction

//===========================================================================
function InitTrig_Envenom takes nothing returns nothing
    set gg_trg_Envenom = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Envenom, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Envenom, Condition( function Trig_Envenom_Conditions ) )
    call TriggerAddAction( gg_trg_Envenom, function Trig_Envenom_Actions )
endfunction

//===========================================================================
// Trigger: Crimson Tempest
//
// Finishing move that slashes at the flesh of all enemies within 10 yards, dealing Physical damage and causing victims to bleed for an additional 240% of the initial damage over 3 sec:	
// 	//2150 - 770/1260/1750 over 3 sec
// 	//55+(55)+35x(CBP-1) + (35x(CBP-1))
// 	//35(lvl*CBP)+20*lvl+35*CBP+20
// 	//220/360/500 (140) + 3 x Bonus Agi
// 	//165/270/375 (105) + 2 x Bonus Agi
// 	//110/180/250 (70)  + 1 x Bonus Agi
//===========================================================================
function Trig_Crimson_Tempest_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0F3' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Crimson_Tempest_Func003Func001Func001C takes nothing returns boolean
    if ( not ( GetSpellAbilityUnit() == udg_yA_Ass_Rogue ) ) then
        return false
    endif
    if ( not ( udg_AAssComboPoints < 1.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Crimson_Tempest_Func003Func001Func002C takes nothing returns boolean
    if ( not ( GetSpellAbilityUnit() == udg_yH_Ass_Rogue ) ) then
        return false
    endif
    if ( not ( udg_HAssComboPoints < 1.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Crimson_Tempest_Func003Func001C takes nothing returns boolean
    if ( Trig_Crimson_Tempest_Func003Func001Func001C() ) then
        return true
    endif
    if ( Trig_Crimson_Tempest_Func003Func001Func002C() ) then
        return true
    endif
    return false
endfunction

function Trig_Crimson_Tempest_Func003C takes nothing returns boolean
    if ( not Trig_Crimson_Tempest_Func003Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Crimson_Tempest_Func038C takes nothing returns boolean
    if ( not ( GetTriggerUnit() == udg_yA_Ass_Rogue ) ) then
        return false
    endif
    return true
endfunction

function Trig_Crimson_Tempest_Func053A takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    // hits air, ground, magic imm,     but not mech
    if IsUnitTargetableEnemyParams( GetEnumUnit(), udg_Temp_Unit, true, true, true, false) then
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL )
    // Increased x Bonus
    call AddSpecialEffectTargetUnitBJ( "overhead", GetEnumUnit(), "war3mapImported\\Ephemeral Cut Red.mdx" )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00) )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "overhead", GetEnumUnit(), "war3mapImported\\Ephemeral Cut Pink.mdx" )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00) )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    // Bleed
    call IssueTargetOrderBJ( gg_unit_e00H_2048, "acidbomb", GetEnumUnit() )
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_Crimson_Tempest_Func075C takes nothing returns boolean
    if ( not ( GetTriggerUnit() == udg_yA_Ass_Rogue ) ) then
        return false
    endif
    return true
endfunction

function Trig_Crimson_Tempest_Actions takes nothing returns nothing
    local real ComboPoints
    local effect eff
    if ( Trig_Crimson_Tempest_Func003C() ) then
        call IssueImmediateOrderBJ( GetTriggerUnit(), "stop" )
        call ErrorMessage( "Not enough combo points.", GetOwningPlayer(GetTriggerUnit()) )
        call SetUnitManaBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) + I2R(BlzGetAbilityManaCost('A0F2', ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ))) ) )
        set eff = null
        return
    else
    endif
    call GameTimeWait(0.05)
    set udg_Temp_Unit = GetTriggerUnit()
    call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
    // Effect
    call PlaySoundOnUnitBJ( gg_snd_ArtilleryCorpseExplodeDeath101, 88.00, GetTriggerUnit() )
    call PlaySoundOnUnitBJ( gg_snd_BladeMasterWhirlwind, 88.00, GetTriggerUnit() )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Ephemeral Slash Red.mdx" )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), GetRandomReal(0, 360.00), 0.00, 0.00 )
    call BlzSetSpecialEffectHeight( GetLastCreatedEffectBJ(), ( BlzGetLocalSpecialEffectZ(GetLastCreatedEffectBJ()) + GetRandomReal(0.00, 25.00) ) )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 1.35 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Ephemeral Slash Red.mdx" )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), GetRandomReal(0, 360.00), 0.00, 0.00 )
    call BlzSetSpecialEffectHeight( GetLastCreatedEffectBJ(), ( BlzGetLocalSpecialEffectZ(GetLastCreatedEffectBJ()) + GetRandomReal(0.00, 25.00) ) )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), ( 1.10 + GetRandomReal(0, 0.25) ) )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Ephemeral Slash Red.mdx" )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), GetRandomReal(0, 360.00), 0.00, 0.00 )
    call BlzSetSpecialEffectHeight( GetLastCreatedEffectBJ(), ( BlzGetLocalSpecialEffectZ(GetLastCreatedEffectBJ()) + GetRandomReal(0.00, 25.00) ) )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), ( 1.10 + GetRandomReal(0, 0.25) ) )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Ephemeral Slash Pink.mdx" )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), GetRandomReal(0, 360.00), 0.00, 0.00 )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), ( 1.10 + GetRandomReal(0, 0.25) ) )
    call BlzSetSpecialEffectHeight( GetLastCreatedEffectBJ(), ( BlzGetLocalSpecialEffectZ(GetLastCreatedEffectBJ()) + GetRandomReal(-40.00, 40.00) ) )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Ephemeral Slash Purple.mdx" )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), GetRandomReal(0, 360.00), 0.00, 0.00 )
    call BlzSetSpecialEffectHeight( GetLastCreatedEffectBJ(), ( BlzGetLocalSpecialEffectZ(GetLastCreatedEffectBJ()) + GetRandomReal(-40.00, 40.00) ) )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), ( 1.10 + GetRandomReal(0, 0.25) ) )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    // ComboPoints
    if ( Trig_Crimson_Tempest_Func038C() ) then
        call DestroyEffectBJ( udg_AAssComboEffects[0] )
        call DestroyEffectBJ( udg_AAssComboEffects[1] )
        call DestroyEffectBJ( udg_AAssComboEffects[2] )
        set ComboPoints = udg_AAssComboPoints
        set udg_AAssComboPoints = 0.00
        call ResetComboPoints( GetTriggerUnit() )
    else
        call DestroyEffectBJ( udg_HAssComboEffects[0] )
        call DestroyEffectBJ( udg_HAssComboEffects[1] )
        call DestroyEffectBJ( udg_HAssComboEffects[2] )
        set ComboPoints = udg_HAssComboPoints
        set udg_HAssComboPoints = 0.00
        call ResetComboPoints( GetTriggerUnit() )
    endif
    // Dmg Calc
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, true) - 0 ))
    set udg_RealStatCalc = udg_RealStatCalc * ComboPoints
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A0F3', udg_Temp_Unit) + 0 )
    set udg_RealStatCalc = 60 + 60 *I2R(udg_HeroStatCalc) + udg_RealStatCalc
    call DebugCritical( "Initial Crimson Tempest Damage: " + R2S(udg_RealStatCalc) )
    // Damage
    set udg_Temp_Unit2 = gg_unit_e00H_2048
    call SetUnitOwner( udg_Temp_Unit2, GetOwningPlayer(udg_Temp_Unit), true )
    call SetUnitPositionLocFacingBJ( udg_Temp_Unit2, udg_Temp_Unit_Point, GetUnitFacing( udg_Temp_Unit) )
    call SetUnitAbilityLevelSwapped( 'A03H', udg_Temp_Unit2, 3 )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit2, 'A03H'), ABILITY_RLF_PRIMARY_DAMAGE, 2, ( 0.83 * udg_RealStatCalc ) )
    // AoE
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(310.00, udg_Temp_Unit_Point), function Trig_Crimson_Tempest_Func053A )
    call RemoveLocation (udg_Temp_Unit_Point)
    // Whirl
    call UnitAddAbility( udg_Temp_Unit, 'Amrf' )
    call UnitRemoveAbility( udg_Temp_Unit, 'Amrf' )
    if udg_Temp_Unit == udg_yA_Ass_Rogue then
    set udg_Charge_Loop[36] = 1.00
    set udg_DruidFacingAngle[3] = GetUnitFacing(GetTriggerUnit())
    call EnableTrigger(gg_trg_Crimson_Tempest_Whirl_A)
    else
    set udg_Charge_Loop[37] = 1.00
    set udg_DruidFacingAngle[4] = GetUnitFacing(GetTriggerUnit())
    call EnableTrigger(gg_trg_Crimson_Tempest_Whirl_H)
    endif
    // Ruthless
    call GameTimeWait(0.1)
    if GetRandomReal( 0.0, 2.99) < ComboPoints then
    set udg_Temp_Unit = GetTriggerUnit()
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 10 ] then 
    call CreateTextTagUnitBJ( "TRIGSTR_9867", udg_Temp_Unit, 12.00, 9.00, 40.00, 100.00, 40.00, 0 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64, 90.00 )
    call cleanUpText(1.0, 0.5)
    if ( Trig_Crimson_Tempest_Func075C() ) then
        call ShowTextTagForceBJ( true, GetLastCreatedTextTag(), udg_AlliancePlayers )
        call TriggerExecute( gg_trg_A_Ass_ComboGen )
    else
        call ShowTextTagForceBJ( true, GetLastCreatedTextTag(), udg_HordePlayers )
        call TriggerExecute( gg_trg_H_Ass_ComboGen )
    endif
    endif
    endif
    // Elaborate Planning
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 14 ] then 
    call PlayerNumbtoHeroesNumbParam(GetOwningPlayer(udg_Temp_Unit))
    call StartTimerBJ( udg_CheatDeath[( udg_Player_Number + 8 )], false, 3.00 )
    call CreateTextTagUnitBJ( "TRIGSTR_9878", udg_Temp_Unit, 12.00, 9.00, 100.00, 85.00, 10.00, 0 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64, 180.00 )
    call cleanUpText(1.0, 0.5)
    if udg_Temp_Unit == udg_yA_Ass_Rogue then
    call ShowTextTagForceBJ( true, GetLastCreatedTextTag(), udg_AlliancePlayers )
    else
    call ShowTextTagForceBJ( true, GetLastCreatedTextTag(), udg_HordePlayers )
    endif
    endif
    // Clean Up
    set eff = null
endfunction

//===========================================================================
function InitTrig_Crimson_Tempest takes nothing returns nothing
    set gg_trg_Crimson_Tempest = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Crimson_Tempest, EVENT_PLAYER_UNIT_SPELL_EFFECT )
