function Trig_S_Find_Timmy_A_Actions takes nothing returns nothing
                       if IsAllianceHero( GetTriggerUnit() ) then
    set udg_TempString = "Find Timmy"
    set udg_TempString_Quest = "Kill cages until Timmy is found."
    call TriggerExecute( gg_trg_Quest_Start_A )
    call DestroyEffectBJ( udg_QuestMarks[62] )
    // Icon
    if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
    call QuestSetEnabledBJ( true, udg_Quests[62] )
    call FlashQuestDialogButtonBJ(  )
    endif
    call QuestSetCompletedBJ( udg_Quests[62], false )
    call CreateQuestItemBJ( udg_Quests[62], "TRIGSTR_9584" )
    set udg_QuestReqs[62] = GetLastCreatedQuestItemBJ()
    // Question Mark
    set udg_TempString = ""
    if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
    set udg_TempString = udg_QuestionMark
    endif
    call AddSpecialEffectTargetUnitBJ( "overhead", gg_unit_n03J_1824, udg_TempString )
    set udg_QuestMarks[62] = GetLastCreatedEffectBJ()
    call DisableTrigger( GetTriggeringTrigger() )
    call EnableTrigger( gg_trg_E_Find_Timmy_A )
    // Destructible Reset
    call EnumDestructablesInRectAll( gg_rct_QTimmyCages1, function Trig_S_Find_Timmy_A_Func025A )
    call EnumDestructablesInRectAll( gg_rct_QTimmyCages2, function Trig_S_Find_Timmy_A_Func026A )
    call EnumDestructablesInRectAll( gg_rct_QTimmyCages3, function Trig_S_Find_Timmy_A_Func027A )
    call EnumDestructablesInRectAll( gg_rct_QTimmyCages4, function Trig_S_Find_Timmy_A_Func028A )
    call EnumDestructablesInRectAll( gg_rct_QTimmyCages5, function Trig_S_Find_Timmy_A_Func029A )
    call EnumDestructablesInRectAll( gg_rct_QTimmyCages6, function Trig_S_Find_Timmy_A_Func030A )
    call TriggerSleepAction( 2.20 )
    call PlaySoundOnUnitBJ( gg_snd_H01VillagerF27, 100.00, gg_unit_n03J_1824 )
    call CreateTextTagUnitBJ( "TRIGSTR_9782", gg_unit_n03J_1824, 0.00, 8.00, 100.00, 100.00, 0.00, 0 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
    call cleanUpText(1.6,1.2)
    call TriggerSleepAction( 1.90 )
    call StopSoundBJ( gg_snd_H01VillagerF27, false )
                       endif
endfunction

