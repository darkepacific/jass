//===========================================================================
// Trigger: Land
//===========================================================================
function Trig_Land_Func004C takes nothing returns boolean
    if ( not ( GetUnitTypeId(udg_Temp_Unit) == 'E034' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Land_Actions takes nothing returns nothing
    call IssueImmediateOrderBJ( gg_unit_E033_1368, "unravenform" )
    call TriggerSleepAction( 1.25 )
    set udg_Temp_Unit = gg_unit_E033_1368
    if ( Trig_Land_Func004C() ) then
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Deathwing)
        call IssuePointOrderLocBJ( udg_Temp_Unit, "move", udg_Temp_Unit_Point )
        call RemoveLocation (udg_Temp_Unit_Point)
    else
        call DisableTrigger( GetTriggeringTrigger() )
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Deathwing)
        call CreateNUnitsAtLoc( 1, 'e030', Player(PLAYER_NEUTRAL_PASSIVE), udg_Temp_Unit_Point, 270.00 )
        call RemoveLocation (udg_Temp_Unit_Point)
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "innerfire", gg_unit_E033_1368 )
        call UnitApplyTimedLifeBJ( 1.50, 'BTLF', GetLastCreatedUnit() )
        call PlaySoundOnUnitBJ( gg_snd_DefendCaster, 100.00, udg_Temp_Unit )
        set udg_SHIELD[0] = 2000.00
        call TriggerSleepAction( 0.25 )
        call EnableTrigger( gg_trg_DW_SHIELD)
    endif
endfunction

