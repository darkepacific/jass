    if ( ( GetSpellAbilityId() == 'A001' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0DG' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Virulent_Plague_Func004C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'U036' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'U03A' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Virulent_Plague_Conditions takes nothing returns boolean
    if ( not Trig_Virulent_Plague_Func002C() ) then
        return false
    endif
    if ( not Trig_Virulent_Plague_Func004C() ) then
        return false
    endif
    return true
endfunction

