    if ( not ( IsUnitInGroup(GetTriggerUnit(), udg_SoG_Peasants) == false ) ) then
        return false
    endif
    if ( not Trig_Hillsbrad_Miners_Attacked_Func002C() ) then
        return false
    endif
    return true
endfunction

