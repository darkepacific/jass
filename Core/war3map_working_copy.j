function InitTrig_Animated_Dead_Dies_n_Explodes takes nothing returns nothing
    set gg_trg_Animated_Dead_Dies_n_Explodes = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Animated_Dead_Dies_n_Explodes, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_Animated_Dead_Dies_n_Explodes, Condition( function Trig_Animated_Dead_Dies_n_Explodes_Conditions ) )
