    local player udg_X_Player_MUI
                       if IsAllianceHero( GetTriggerUnit() ) then
    if ( Trig_H_BBW_Func008C() ) then
        set udg_X_Player_MUI = GetOwningPlayer(GetTriggerUnit())
        call ForceAddPlayerSimple( udg_X_Player_MUI, udg_Player_Message_Group )
        call QuestMessageBJ( udg_Player_Message_Group, bj_QUESTMESSAGE_REQUIREMENT, "TRIGSTR_10913" )
        call ForceRemovePlayerSimple( udg_X_Player_MUI, udg_Player_Message_Group )
        call CreateTextTagUnitBJ( "TRIGSTR_10914", GetTriggerUnit(), 0.00, 11.00, 100.00, 90.00, 0.00, 0 )
        call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
        call cleanUpText(0.6, 0.4)
    else
    endif
                       endif
    set udg_X_Player_MUI = null
endfunction

