function InitTrig_E_ASK_H takes nothing returns nothing
    set gg_trg_E_ASK_H = CreateTrigger(  )
    call DisableTrigger( gg_trg_E_ASK_H )
    call TriggerRegisterEnterRectSimple( gg_trg_E_ASK_H, gg_rct_Q_Big_Cage_Agent_Skully )
    call TriggerAddAction( gg_trg_E_ASK_H, function Trig_E_ASK_H_Actions )
endfunction

//===========================================================================
// Trigger: SAC Crates
//===========================================================================
function Trig_SAC_Crates_Conditions takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetDyingDestructable()) == 'LTcr' ) ) then
        return false
    endif
    return true
endfunction

function Trig_SAC_Crates_Actions takes nothing returns nothing
    local destructable cage = GetDyingDestructable()
    local location udg_Temp_Unit_Point
    set udg_Temp_Unit_Point = GetDestructableLoc(GetDyingDestructable())
    call CreateItemLoc( 'I0AK', udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 60.00 )
    call DestructableRestoreLife( cage, 50.00, false )
    set cage = null
    set udg_Temp_Unit_Point = null
endfunction

//===========================================================================
function InitTrig_SAC_Crates takes nothing returns nothing
    set gg_trg_SAC_Crates = CreateTrigger(  )
    call TriggerRegisterDestDeathInRegionEvent( gg_trg_SAC_Crates, gg_rct_Scarlet_Sac_E )
    call TriggerRegisterDestDeathInRegionEvent( gg_trg_SAC_Crates, gg_rct_Scarlet_Sac_N_and_Base_Return )
    call TriggerRegisterDestDeathInRegionEvent( gg_trg_SAC_Crates, gg_rct_Scarlet_Sac_W )
    call TriggerAddCondition( gg_trg_SAC_Crates, Condition( function Trig_SAC_Crates_Conditions ) )
    call TriggerAddAction( gg_trg_SAC_Crates, function Trig_SAC_Crates_Actions )
endfunction

