function InitTrig_Piercing_Taunt takes nothing returns nothing
    set gg_trg_Piercing_Taunt = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Piercing_Taunt, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Piercing_Taunt, Condition( function Trig_Piercing_Taunt_Conditions ) )
    call TriggerAddAction( gg_trg_Piercing_Taunt, function Trig_Piercing_Taunt_Actions )
endfunction

