    call QuestSetCompletedBJ( udg_Quests[udg_Temp_Int], false )
    call CreateQuestItemBJ( udg_Quests[udg_Temp_Int], "TRIGSTR_6713" )
    call CreateQuestItemBJ( udg_Quests[udg_Temp_Int], "TRIGSTR_6715" )
