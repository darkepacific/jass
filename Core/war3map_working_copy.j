    local integer udg_Temp_Int = 110
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    call FlashQuestDialogButtonBJ(  )
    endif
    call DestroyEffectBJ( udg_QuestMarks[110] )
    call QuestItemSetCompletedBJ( udg_QuestReqs[110], true )
    call QuestSetCompletedBJ( udg_Quests[110], true )
    call DestroyMinimapIcon( udg_MiniMapIcon[110] )
    // Clean Up Items
    call CleanUpItems( udg_ItemTypeCheck )
    // Rewards
    set udg_XP = udg_QUEST_XP[udg_Temp_Int]
    set udg_Gold = udg_QUEST_GOLD[udg_Temp_Int]
