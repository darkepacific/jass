    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_QuestMarks[udg_Temp_Int] = GetLastCreatedEffectBJ()
    call BlzSetSpecialEffectZ(udg_QuestMarks[udg_Temp_Int], BlzGetLocalSpecialEffectZ(udg_QuestMarks[udg_Temp_Int]) + 140)
    set udg_QuestMarks[udg_Temp_Int] = GetLastCreatedEffectBJ()
    call QuestSetCompletedBJ( udg_Quests[udg_Temp_Int], false )
    call CreateQuestItemBJ( udg_Quests[udg_Temp_Int], "TRIGSTR_10905" )
    set udg_QuestReqs[udg_Temp_Int] = GetLastCreatedQuestItemBJ()
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_E_The_Fallen_Courier)
    call CampaignMinimapIconLocBJ( udg_Temp_Unit_Point, bj_CAMPPINGSTYLE_TURNIN )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_MiniMapIcon[udg_Temp_Int] = GetLastCreatedMinimapIcon()
    call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), false )
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), true )
    endif
    call UnitAddItemByIdSwapped( 'I094', GetTriggerUnit() )
    call DisableTrigger( GetTriggeringTrigger() )
    call EnableTrigger( gg_trg_E_TFC)
    call TriggerSleepAction( 10.00 )
    if ( IsQuestCompleted(udg_Quests[udg_Temp_Int]) == false ) then
    call EnableTrigger( gg_trg_L_TFC)
    endif
                       endif
    set udg_Temp_Unit_Point = null
endfunction

