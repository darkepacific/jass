endfunction

//===========================================================================
// Trigger: Valkyr Gilneas Dies
//
// Change to SPECIFIC Valkyr
//===========================================================================
function Trig_Valkyr_Gilneas_Dies_Func002C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'u02P' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'e02G' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Valkyr_Gilneas_Dies_Conditions takes nothing returns boolean
    if ( not Trig_Valkyr_Gilneas_Dies_Func002C() ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetTriggerUnit()) == Player(3) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Valkyr_Gilneas_Dies_Func005Func007C takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_Quests[142]) == false ) ) then
        return false
    endif
    if ( not ( IsTriggerEnabled(gg_trg_S_GD) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Valkyr_Gilneas_Dies_Func005C takes nothing returns boolean
    if ( not ( GetOwningPlayer(gg_unit_ncop_1664) == Player(3) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Valkyr_Gilneas_Dies_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    if ( GetTriggerUnit() == udg_ValkyrGilneas) then
    call TriggerSleepAction( 90.00 )
    if ( Trig_Valkyr_Gilneas_Dies_Func005C() ) then
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Tobias_Mismantle)
        call CreateNUnitsAtLoc( 1, 'u02P', Player(3), udg_Temp_Unit_Point, 90.00 )
        call RemoveLocation (udg_Temp_Unit_Point)
        set udg_ValkyrGilneas = GetLastCreatedUnit()
        if ( Trig_Valkyr_Gilneas_Dies_Func005Func007C() ) then
            call DestroyEffectBJ( udg_QuestMarks[142] )
            set udg_TempString = ""
            if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
            set udg_TempString = udg_ExclamationMark
            endif
            call AddSpecialEffectTargetUnitBJ( "overhead", GetLastCreatedUnit(), udg_TempString )
            set udg_QuestMarks[142] = GetLastCreatedEffectBJ()
        else
        endif
    else
        set udg_ValkyrGilneas = null
    endif
    endif
    set udg_Temp_Unit_Point = null
endfunction

