//===========================================================================
function Trig_ChromieSelected_Actions takes nothing returns nothing
    if ( GetRandomInt(1, 4) > 3  ) then
        call PlaySoundOnUnitBJ( gg_snd_ChromieHello, 100.00, GetTriggerUnit() )
    else
        if ( GetRandomInt(1, 3) > 2 ) then
            call PlaySoundOnUnitBJ( gg_snd_ChromieDarke, 100.00, GetTriggerUnit() )
        else
            if ( GetRandomInt(1, 2) > 1 ) then
                call PlaySoundOnUnitBJ( gg_snd_ChromieNice, 100.00, GetTriggerUnit() )
            else
                call PlaySoundOnUnitBJ( gg_snd_ChromieTurnUp, 100.00, GetTriggerUnit() )
            endif
        endif
    endif
    call DisableTrigger( GetTriggeringTrigger() )
    call TriggerSleepAction( 2.20 )
    call EnableTrigger( GetTriggeringTrigger() )
endfunction

