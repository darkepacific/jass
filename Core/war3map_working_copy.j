    local player udg_X_Player_MUI
                       if IsAllianceHero( GetTriggerUnit() ) then
    set udg_X_Player_MUI = GetOwningPlayer(GetTriggerUnit())
    call ForceAddPlayerSimple( udg_X_Player_MUI, udg_Player_Message_Group )
    call QuestMessageBJ( udg_Player_Message_Group, bj_QUESTMESSAGE_REQUIREMENT, "TRIGSTR_10935" )
    call ForceRemovePlayerSimple( udg_X_Player_MUI, udg_Player_Message_Group )
    set udg_Player_Number = GetPlayerHeroNumber( udg_X_Player_MUI )
    if ( Trig_H_MMT_Func008C() ) then
        if GetLocalPlayer() == udg_X_Player_MUI then
        call ClearMapMusicBJ(  )
        call StopMusicBJ( false )
        call EndThematicMusicBJ(  )
        call PlayThematicMusicBJ( "war3mapImported\\ArgentTournament_Joust_145_Joint_Stereo.mp3" )
        call PlayMusicBJ( gg_snd_ArgentTournament_Joust_145_Joint_Stereo )
        endif
        set udg_Player_Music[udg_Player_Number] = "CannonMusic"
    else
    endif
    set udg_X_Player_MUI = null
                       endif
endfunction

