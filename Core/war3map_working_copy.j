//===========================================================================
// Trigger: Deathknell
//===========================================================================
function Trig_Deathknell_Func004C takes nothing returns boolean
    if ( ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'u01A' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'u013' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'u005' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Deathknell_Conditions takes nothing returns boolean
    if ( not Trig_Deathknell_Func004C() ) then
        return false
    endif
    return true
endfunction

function Trig_Deathknell_Func002Func001Func001C takes nothing returns boolean
    if ( ( GetTriggerUnit() == udg_Heroes[GetForLoopIndexA()] ) ) then
        return true
    endif
    if ( ( GetTriggerUnit() == udg_FP_Bats_n_Gryphons[GetForLoopIndexA()] ) ) then
        return true
    endif
    return false
endfunction

function Trig_Deathknell_Func002Func001C takes nothing returns boolean
    if ( not Trig_Deathknell_Func002Func001Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Deathknell_Func003C takes nothing returns boolean
    if ( not ( udg_Player_Music[udg_Player_Number] != "Deathknell" ) ) then
        return false
    endif
    if ( not ( udg_Player_Number != 11 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Deathknell_Actions takes nothing returns nothing
    set udg_Player_Number = 11
    set bj_forLoopAIndex = 0
    set bj_forLoopAIndexEnd = 7
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_Deathknell_Func002Func001C() ) then
            set udg_Player_Number = GetForLoopIndexA()
            exitwhen true
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    if ( Trig_Deathknell_Func003C() ) then
        if GetLocalPlayer() == GetOwningPlayer(GetTriggerUnit()) then
        call ClearMapMusicBJ(  )
        call StopMusicBJ( false )
        call EndThematicMusicBJ(  )
        call PlayMusicBJ( gg_snd_Haunted_1 )
        endif
        set udg_Player_Music[udg_Player_Number] = "Deathknell"
    else
    endif
endfunction

