    set gg_trg_Sweeping_Strike_Timer_NE = CreateTrigger(  )
    call DisableTrigger( gg_trg_Sweeping_Strike_Timer_NE )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Sweeping_Strike_Timer_NE, 0.02 )
