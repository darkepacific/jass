function Trig_ZulJin_Form_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    call CreateTextTagUnitBJ( "TRIGSTR_905", GetTriggerUnit(), 0, 8.00, 10.00, 100.00, 0.00, 0 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
    call cleanUpText( 1.6, 1.25)
    if ( Trig_ZulJin_Form_Func005C() ) then
        call UnitRemoveBuffsBJ( bj_REMOVEBUFFS_NEGATIVE, GetTriggerUnit() )
        call IssueImmediateOrderBJ( GetTriggerUnit(), "bearform" )
    else
    endif
    call GameTimeWait( 1.5)
    call IssueImmediateOrderBJ( GetTriggerUnit(), "stomp" )
    call GameTimeWait( 3.0)
    call UnitResetCooldown( GetTriggerUnit() )
    call IssueImmediateOrderBJ( GetTriggerUnit(), "fanofknives" )
    call GameTimeWait( 1.5)
    if ( Trig_ZulJin_Form_Func012C() ) then
        call UnitRemoveBuffsBJ( bj_REMOVEBUFFS_NEGATIVE, GetTriggerUnit() )
        call IssueImmediateOrderBJ( GetTriggerUnit(), "unbearform" )
    else
    endif
    call GameTimeWait( 3.0)
    if ( Trig_ZulJin_Form_Func014C() ) then
        call CreateTextTagUnitBJ( "TRIGSTR_10901", GetTriggerUnit(), 0, 8.00, 10.00, 100.00, 0.00, 0 )
        call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
        call cleanUpText( 1.6, 1.25)
        call UnitRemoveBuffsBJ( bj_REMOVEBUFFS_NEGATIVE, GetTriggerUnit() )
        call IssueImmediateOrderBJ( GetTriggerUnit(), "ravenform" )
    else
    endif
    call GameTimeWait( 1.5)
    call IssueImmediateOrderBJ( GetTriggerUnit(), "fanofknives" )
    call GameTimeWait( 3.0)
    if ( Trig_ZulJin_Form_Func018C() ) then
        call UnitRemoveBuffsBJ( bj_REMOVEBUFFS_NEGATIVE, GetTriggerUnit() )
        call IssueImmediateOrderBJ( GetTriggerUnit(), "unravenform" )
    else
    endif
    call GameTimeWait( 1.5)
    call EnableTrigger( GetTriggeringTrigger() )
endfunction

