//===========================================================================
// Trigger: DUEL
//===========================================================================
function Trig_DUEL_Func007Func001C takes nothing returns boolean
    if ( not ( ModuloInteger(GetTriggerExecCount(GetTriggeringTrigger()), 2) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_DUEL_Func007C takes nothing returns boolean
    if ( not ( udg_TempString == "k" ) ) then
        return false
    endif
    return true
endfunction

function Trig_DUEL_Actions takes nothing returns nothing
    call ForceAddPlayerSimple( GetTriggerPlayer(), udg_Player_Message_Group )
    call DisplayTextToForce( udg_Player_Message_Group, "TRIGSTR_698" )
    call ForceRemovePlayerSimple( GetTriggerPlayer(), udg_Player_Message_Group )
    return
    set udg_TempString = SubStringBJ(GetEventPlayerChatString(), 6, 6)
    call PlayerNumbtoHeroesNumb()
    if ( Trig_DUEL_Func007C() ) then
        set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_Moonlight_Kara)
    else
        if ( Trig_DUEL_Func007Func001C() ) then
            set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Zandala_Duel_N)
        else
            set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Zandala_Duel_S)
        endif
    endif
    call SetUnitPositionLoc( udg_Heroes[udg_Player_Number], udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
endfunction

