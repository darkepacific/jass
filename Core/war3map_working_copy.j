//===========================================================================
// Trigger: Imprison
//===========================================================================
function Trig_Imprison_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A08K' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Imprison_Actions takes nothing returns nothing
    local integer i
    set udg_Temp_Unit = GetTriggerUnit()
    if udg_Temp_Unit == udg_yA_Demon_Hunt then
    set i = 0
    set udg_o = udg_z_DH_VENG_A
    else
    set i = 1
    set udg_o = udg_z_DH_VENG_H
    endif
    set udg_SpellUnits[udg_o] = GetSpellTargetUnit()
    //  
    call TriggerSleepAction( 0.10 )
    //  
    set udg_Temp_Int = i
    if i == 0 then
    set udg_o = udg_z_DH_VENG_A
    else
    set udg_o = udg_z_DH_VENG_A
    endif
    set udg_Temp_Polar_Point = GetUnitLoc(udg_SpellUnits[udg_o])
    call AddSpecialEffectLocBJ( udg_Temp_Polar_Point, "war3mapImported\\Protoss Pylon.MDX" )
    set udg_ImprisonSE[( 2 * udg_Temp_Int )] = GetLastCreatedEffectBJ()
    call BlzSetSpecialEffectColor( GetLastCreatedEffectBJ(), 15, 210, 75 )
    call BlzSetSpecialEffectAlpha( GetLastCreatedEffectBJ(), 200 )
    set udg_RealStatCalc = BlzGetUnitRealField(udg_SpellUnits[udg_o], UNIT_RF_SCALING_VALUE)
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), ( BlzGetLocalUnitZ(udg_SpellUnits[udg_o]) - ( 110.00 * udg_RealStatCalc ) ) )
    set udg_RealStatCalc = ( udg_RealStatCalc / 1.88 )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), udg_RealStatCalc )
    call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 5.00 )
    //  
    call AddSpecialEffectLocBJ( udg_Temp_Polar_Point, "Abilities\\Spells\\Undead\\FreezingBreath\\FreezingBreathTargetArt.mdl" )
    call RemoveLocation (udg_Temp_Polar_Point)
    set udg_ImprisonSE[( ( 2 * udg_Temp_Int ) + 1 )] = GetLastCreatedEffectBJ()
    call BlzSetSpecialEffectColor( GetLastCreatedEffectBJ(), 15, 210, 75 )
    call BlzSetSpecialEffectAlpha( GetLastCreatedEffectBJ(), 200 )
    set udg_RealStatCalc = BlzGetUnitRealField(udg_SpellUnits[udg_o], UNIT_RF_SCALING_VALUE)
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), ( BlzGetLocalUnitZ(udg_SpellUnits[udg_o]) - ( 10.00 * udg_RealStatCalc ) ) )
    set udg_RealStatCalc = ( udg_RealStatCalc / 1.20 )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), udg_RealStatCalc )
    call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 1.25 )
    // Turn On
    if i == 0 then
    call EnableTrigger( gg_trg_Imprison_Tick_NE )
    else
    call EnableTrigger( gg_trg_Imprison_Tick_BE )
    endif
endfunction

//===========================================================================
function InitTrig_Imprison takes nothing returns nothing
    set gg_trg_Imprison = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Imprison, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Imprison, Condition( function Trig_Imprison_Conditions ) )
    call TriggerAddAction( gg_trg_Imprison, function Trig_Imprison_Actions )
endfunction

//===========================================================================
// Trigger: Imprison Tick NE
//===========================================================================
function Trig_Imprison_Tick_NE_Conditions takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(udg_SpellUnits[udg_z_DH_VENG_A], 'B00N') == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Imprison_Tick_NE_Func018A takes nothing returns nothing
    if IsUnitTargetableEnemyHitsAll( GetEnumUnit(), udg_Temp_Unit) then
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call AddSpecialEffectTargetUnitBJ( "overhead", GetEnumUnit(), "Abilities\\Weapons\\ChimaeraAcidMissile\\ChimaeraAcidMissile.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_Imprison_Tick_NE_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    set udg_Temp_Unit = udg_yA_Demon_Hunt
    set udg_o = udg_z_DH_VENG_A
    call TriggerExecute( gg_trg_Firelords_Helper)
    set udg_Temp_Unit_Point = GetUnitLoc(udg_SpellUnits[udg_o])
    call PlaySoundOnUnitBJ( gg_snd_RevenantDeath1, 85.00, udg_SpellUnits[udg_o] )
    call SetSoundOffsetBJ( 1.25, gg_snd_RevenantDeath1 )
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, false) ))
    set udg_HeroStatCalc = GetUnitAbilityLevelSwapped('A08K', udg_Temp_Unit)
    set udg_HeroStatCalc = ( 50 + ( 150 * udg_HeroStatCalc ) )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + ( 5.00 * udg_RealStatCalc ) )
    call UnitDamageTargetBJ( udg_Temp_Unit, udg_SpellUnits[udg_o], udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call AddSpecialEffectTargetUnitBJ( "chest", udg_SpellUnits[udg_o], "war3mapImported\\Valiant Charge Fel.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(310.00, udg_Temp_Unit_Point), function Trig_Imprison_Tick_NE_Func018A )
    call RemoveLocation (udg_Temp_Unit_Point)
    call DestroyEffectBJ( udg_ImprisonSE[0] )
    call DestroyEffectBJ( udg_ImprisonSE[1] )
endfunction

//===========================================================================
function InitTrig_Imprison_Tick_NE takes nothing returns nothing
    set gg_trg_Imprison_Tick_NE = CreateTrigger(  )
    call DisableTrigger( gg_trg_Imprison_Tick_NE )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Imprison_Tick_NE, 0.15 )
    call TriggerAddCondition( gg_trg_Imprison_Tick_NE, Condition( function Trig_Imprison_Tick_NE_Conditions ) )
    call TriggerAddAction( gg_trg_Imprison_Tick_NE, function Trig_Imprison_Tick_NE_Actions )
endfunction

