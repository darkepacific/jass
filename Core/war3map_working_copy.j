//===========================================================================
// Trigger: Blizzard Tick A
//===========================================================================
function Trig_Blizzard_Tick_A_Func011A takes nothing returns nothing
    if IsUnitTargetableEnemy( GetEnumUnit(), udg_Temp_Unit ) then
    if udg_Temp_Bool and IsSlowed( GetEnumUnit() ) then
    call UnitDamageTargetBJ( udg_yA_Frost_Mage, GetEnumUnit(), ( 1.20 * ( udg_RealStatCalc + I2R(udg_HeroStatCalc) ) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "war3mapImported\\ShivasWrath.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    else
    call UnitDamageTargetBJ( udg_yA_Frost_Mage, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    endif
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "Abilities\\Spells\\Other\\FrostDamage\\FrostDamage.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_Blizzard_Tick_A_Actions takes nothing returns nothing
    set udg_Temp_Unit = udg_yA_Frost_Mage
    set udg_Temp_Bool = udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 10 ] 
    if udg_Temp_Bool then
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A01Z', udg_Temp_Unit) * 55 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 20 )
    endif
    call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 2.50 * udg_RealStatCalc )
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(( 195.00 + ( 15.00 * I2R(GetUnitAbilityLevelSwapped('A01Z', udg_yA_Frost_Mage)) ) ), udg_Blizzard[0]), function Trig_Blizzard_Tick_A_Func011A )
endfunction

