//===========================================================================
// Trigger: M Test Subjects 68
//===========================================================================
function Trig_M_Test_Subjects_68_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 68
    set udg_TempString = ""
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    set udg_TempString = udg_ExclamationMark
    endif
    call AddSpecialEffectTargetUnitBJ( "overhead", udg_ApothecaryGilneas, udg_TempString )
    set udg_QuestMarks[68] = GetLastCreatedEffectBJ()
    set udg_TempString = "The new plague is almost ready. We just need a few subjects to complete our final titrations. The local residents here of Gilneas should do fine. Take this flask of it and do some medical distribution... then return to me when you're done."
    // Set Quest Rewards
    set udg_QUEST_XP[udg_Temp_Int] = 850
    set udg_QUEST_GOLD[udg_Temp_Int] = 150
    set udg_QUEST_LVL_REQ[udg_Temp_Int] = udg_QUEST_ZONE_3_LVL_REQ
    call QuestRewards_TextSet(udg_Temp_Int)
    // End Set Quest Rewards
    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_9843", "TRIGSTR_9844", "ReplaceableTextures\\CommandButtons\\BTNAcidBomb.blp" )
    set udg_Quests[68] = GetLastCreatedQuestBJ()
    call QuestSetEnabledBJ( false, GetLastCreatedQuestBJ() )
    call TriggerRegisterUnitInRangeSimple( gg_trg_S_Test_Subjects, 256, udg_ApothecaryGilneas )
    call TriggerRegisterUnitInRangeSimple( gg_trg_L_Test_Subjects, 256, udg_ApothecaryGilneas )
    call TriggerRegisterUnitInRangeSimple( gg_trg_E_Test_Subjects, 256, udg_ApothecaryGilneas )
    call EnableTrigger( gg_trg_S_Test_Subjects )
endfunction

