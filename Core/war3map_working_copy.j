//===========================================================================
// Trigger: Power Word Shield
//
// call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A090'), ABILITY_RLF_DAMAGE_INCREASE_PERCENT_INF1, ( GetUnitAbilityLevel(udg_Temp_Unit, GetSpellAbilityId()) - 1 ), udg_RealStatCalc )
// call BlzSetAbilityIntegerLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A090'), ABILITY_ILF_DEFENSE_INCREASE_INF2, ( GetUnitAbilityLevel(udg_Temp_Unit, GetSpellAbilityId()) - 1 ), 0 )
//===========================================================================
function Trig_Power_Word_Shield_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A090' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Power_Word_Shield_Actions takes nothing returns nothing
    local unit target = GetSpellTargetUnit()
    call StopSoundBJ( gg_snd_Powerword_Shield_Impact_01, false )
    call PlaySoundOnUnitBJ( gg_snd_Powerword_Shield_Impact_01, 95.00, GetSpellTargetUnit() )
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 3.50 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A090', udg_Temp_Unit) * 105 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 20 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    call NewShield( target, udg_RealStatCalc, 99 )
    // Set to 0
    	call BlzSetAbilityIntegerLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A090'), ABILITY_ILF_DEFENSE_INCREASE_INF2, ( GetUnitAbilityLevel(udg_Temp_Unit, 'A090') - 1 ), 0 )
    // InnerFire Talent
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 11 ]  then
     call SetUnitAbilityLevel( gg_unit_e03G_2001, 'A0BF', 41 )
     call IssueTargetOrder( gg_unit_e03G_2001, "innerfire", target  )
    endif
    // Atonement
    call Atonement( udg_Temp_Unit, target)
    // Speed Bonus
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A090', udg_Temp_Unit) * 3 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 2 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) / 100.00 )
    call Speedbonus( target, 0.2, 2.5)
    set target = null
endfunction

