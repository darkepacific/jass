//===========================================================================
function Trig_S_SoE_Actions takes nothing returns nothing
                       if IsAllianceHero( GetTriggerUnit() ) then
    set udg_TempString = "The Staff of Elune"
    set udg_TempString_Quest = "Gather and return 2 Obsidian, 2 Mammoth Horns, & 1 Magnataur's Javeline."
    call TriggerExecute( gg_trg_Quest_Start_A )
    set udg_TempString = ""
    if IsAlliancePlayer( GetLocalPlayer() ) then
    call QuestSetEnabledBJ( true, udg_Quests[48] )
    call FlashQuestDialogButtonBJ(  )
    set udg_TempString = udg_QuestionMark
    endif
    call DestroyEffectBJ( udg_QuestMarks[48] )
    call AddSpecialEffectTargetUnitBJ( "overhead", gg_unit_Emoo_1239, udg_TempString )
    set udg_QuestMarks[48] = GetLastCreatedEffectBJ()
    call QuestSetCompletedBJ( udg_Quests[48], false )
    call CreateQuestItemBJ( udg_Quests[48], "TRIGSTR_5144" )
    set udg_QuestReqs[48] = GetLastCreatedQuestItemBJ()
    call DisableTrigger( GetTriggeringTrigger() )
