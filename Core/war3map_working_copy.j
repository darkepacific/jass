function InitTrig_Shadowbolt_Volley_Tick takes nothing returns nothing
    set gg_trg_Shadowbolt_Volley_Tick = CreateTrigger(  )
    call DisableTrigger( gg_trg_Shadowbolt_Volley_Tick )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Shadowbolt_Volley_Tick, 0.02 )
    call TriggerAddAction( gg_trg_Shadowbolt_Volley_Tick, function Trig_Shadowbolt_Volley_Tick_Actions )
