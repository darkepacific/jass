//===========================================================================
// Trigger: Wild Growth
//
// REALLY HAS 4.9 x scaling but says 5 in ability description
// (25+25*.9+25*.8+25*.7+25*.6+25*.5+25*.4)*6
//===========================================================================
function Trig_Wild_Growth_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A033' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Wild_Growth_Func024C takes nothing returns boolean
    if ( not ( GetTriggerUnit() == udg_yA_Bal_Druid ) ) then
        return false
    endif
    return true
endfunction

function Trig_Wild_Growth_Actions takes nothing returns nothing
    local effect vine
    local effect f1
    local effect f2
    local effect f3
    local effect f4
    local effect f5
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_Temp_Unit_Point = GetSpellTargetLoc()
    // spawn
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Objects\\Spawnmodels\\NightElf\\EntBirthTarget\\EntBirthTarget.mdl" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 1.00 )
    call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 1.00 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    // vine effect
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\InvasionVine_squished.mdx" )
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), ( BlzGetLocalSpecialEffectZ(GetLastCreatedEffectBJ()) + 12.00 ) )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.93 )
    call BlzSetSpecialEffectColor( GetLastCreatedEffectBJ(), 255, 255, 255 )
    call BlzSetSpecialEffectAlpha( GetLastCreatedEffectBJ(), 255 )
    set vine = GetLastCreatedEffectBJ()
    // create dummy
    call CreateNUnitsAtLoc( 1, 'e01A', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, bj_UNIT_FACING )
    if ( Trig_Wild_Growth_Func024C() ) then
        set udg_Shaman_Eq_Ls[7] = GetLastCreatedUnit()
        if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 13 ]  then
        call UnitApplyTimedLifeBJ( 9.07, 'BTLF', udg_Shaman_Eq_Ls[7] )
        else
        call UnitApplyTimedLifeBJ( 7.07, 'BTLF', udg_Shaman_Eq_Ls[7] )
        endif
        set udg_SpellTicks[22] = 1
        call EnableTrigger( gg_trg_Wild_Growth_Tick_NE )
    else
        set udg_Shaman_Eq_Ls[8] = GetLastCreatedUnit()
        if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 13 ]  then
        call UnitApplyTimedLifeBJ( 9.07, 'BTLF', udg_Shaman_Eq_Ls[8] )
        else
        call UnitApplyTimedLifeBJ( 7.07, 'BTLF', udg_Shaman_Eq_Ls[8] )
        endif
        set udg_SpellTicks[23] = 1
        call EnableTrigger( gg_trg_Wild_Growth_Tick_TA )
    endif
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 13 ]  then
    // flourish
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, GetRandomReal(180.00, 220.00), GetRandomDirectionDeg())
    call AddSpecialEffectLocBJ( udg_Temp_Polar_Point, "war3mapImported\\AnimatedFlowerAv343.mdx" )
    set f1 = GetLastCreatedEffectBJ()
    call RemoveLocation (udg_Temp_Polar_Point)
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, GetRandomReal(180.00, 220.00), GetRandomDirectionDeg())
    call AddSpecialEffectLocBJ( udg_Temp_Polar_Point, "war3mapImported\\AnimatedFlowerEv017.mdx" )
    set f2 = GetLastCreatedEffectBJ()
    call RemoveLocation (udg_Temp_Polar_Point)
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, GetRandomReal(180.00, 220.00), GetRandomDirectionDeg())
    call AddSpecialEffectLocBJ( udg_Temp_Polar_Point, "war3mapImported\\AnimatedFlowerAv343.mdx" )
    set f3 = GetLastCreatedEffectBJ()
    call RemoveLocation (udg_Temp_Polar_Point)
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, GetRandomReal(180.00, 220.00), GetRandomDirectionDeg())
    call AddSpecialEffectLocBJ( udg_Temp_Polar_Point, "war3mapImported\\AnimatedFlowerEv017.mdx" )
    set f4 = GetLastCreatedEffectBJ()
    call RemoveLocation (udg_Temp_Polar_Point)
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, GetRandomReal(140.00, 180.00), GetRandomDirectionDeg())
    call AddSpecialEffectLocBJ( udg_Temp_Polar_Point, "Doodads\\Underground\\Plants\\ShroomsBlue\\ShroomsBlue" )
    set f5 = GetLastCreatedEffectBJ()
    call BlzSetSpecialEffectScale( f5, 0.5 )
    call RemoveLocation (udg_Temp_Polar_Point)
    call RemoveLocation (udg_Temp_Unit_Point)
    call GameTimeWait(8.2)
    call DestroyEffectBJ( f1 )
    call DestroyEffectBJ( f2 )
    call DestroyEffectBJ( f3 )
    call DestroyEffectBJ( f4 )
    call BlzSetSpecialEffectAlpha( f5, 0 )
    call DestroyEffectBJ( f5 )
    else
    call GameTimeWait(6.2)
    call RemoveLocation (udg_Temp_Unit_Point)
    endif
    call DestroyEffectBJ( vine )
    set vine = null
    set f1 = null
    set f2 = null
    set f3 = null
    set f4 = null
    set f5 = null
endfunction

