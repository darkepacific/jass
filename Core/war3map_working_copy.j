//===========================================================================
// Trigger: M Mangleclaw
//===========================================================================
function Trig_M_Mangleclaw_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 101
    local location udg_Temp_Unit_Point
    local unit Mangleclaw
    set udg_TempString = "Enact revenge for Mountaineer Khazos and kill Mangleclaw."
    // Set Quest Rewards
    set udg_QUEST_XP[udg_Temp_Int] = 225
    set udg_QUEST_GOLD[udg_Temp_Int] = 0
    call QuestRewards_TextSet(udg_Temp_Int)
    // End Set Quest Rewards
    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_7536", udg_TempString, "ReplaceableTextures\\CommandButtons\\BTNFrostBear.blp" )
    set udg_Quests[udg_Temp_Int] = GetLastCreatedQuestBJ()
    call QuestSetEnabledBJ( false, GetLastCreatedQuestBJ() )
    set udg_TempString = ""
    if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
    set udg_TempString = udg_ExclamationMark
    endif
    call AddSpecialEffectTargetUnitBJ( "overhead", udg_MountaineerKhazos, udg_TempString )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Mangleclaw)
    call PlaySoundAtPointBJ( gg_snd_GrizzlyBearReady1, 100, udg_Temp_Unit_Point, 0 )
    call CreateNUnitsAtLoc( 1, 'n04R', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Temp_Unit_Point, bj_UNIT_FACING )
    call RemoveLocation (udg_Temp_Unit_Point)
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "attack", udg_MountaineerKhazos )
    set Mangleclaw = GetLastCreatedUnit()
    call CampaignMinimapIconUnitBJ( GetLastCreatedUnit(), bj_CAMPPINGSTYLE_BOSS )
    call SetMinimapIconOrphanDestroy( GetLastCreatedMinimapIcon(), true )
    set udg_MiniMapIcon[udg_Temp_Int] = GetLastCreatedMinimapIcon()
    // Start the Quest Immediately
    set udg_TempString = "Mangleclaw"
    set udg_TempString_Quest = "Kill Mangleclaw."
    call TriggerExecute( gg_trg_Quest_Start_A )
    set udg_TempString = ""
    if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
    call QuestSetEnabledBJ( true, udg_Quests[udg_Temp_Int] )
    call FlashQuestDialogButtonBJ(  )
    endif
    call QuestSetCompletedBJ( udg_Quests[udg_Temp_Int], false )
    call CreateQuestItemBJ( udg_Quests[udg_Temp_Int], "TRIGSTR_7555" )
    set udg_QuestReqs[udg_Temp_Int] = GetLastCreatedQuestItemBJ()
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), false )
    endif
    call EnableTrigger( gg_trg_E_Mangleclaw)
    call EnableTrigger( gg_trg_Mangleclaw_Leave)
    call IssueImmediateOrderBJ( Mangleclaw, "roar")
    call TriggerSleepAction( 0.35 )
    call IssueTargetOrderBJ( Mangleclaw, "attack", udg_MountaineerKhazos )
    call TriggerSleepAction( 0.75 )
    call IssueTargetOrderBJ( Mangleclaw, "thunderbolt", udg_MountaineerKhazos )
    call TriggerSleepAction( 0.50 )
    call IssueImmediateOrderBJ(Mangleclaw, "fanofknives")
    call TriggerSleepAction( 0.18 )
    call KillUnit( udg_MountaineerKhazos )
    call TriggerSleepAction( 8.50 )
    call IssueImmediateOrderBJ(Mangleclaw, "fanofknives")
    call RemoveUnit( udg_MountaineerKhazos )
    set Mangleclaw = null
    set udg_Temp_Unit_Point = null
endfunction

