//===========================================================================
// Trigger: Channel Start
//
// 	call Debug("Unit: " + GetUnitName(udg_SpellUnits[udg_o]))
// 	call Debug("Destructable: " + GetDestructableName(GetSpellTargetDestructable()))
// 	call Debug("Destructable X: " + DeGetDestructableX() + "Y: " + GetDestructableY())
// 	call Debug("SpellTarget X: " + GetSpellTargetX() + "Y: " + GetSpellTargetY())
//===========================================================================
function Trig_Channel_Start_Func003C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A02D' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0DK' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0FW' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0G4' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0H2' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Channel_Start_Conditions takes nothing returns boolean
    if ( not Trig_Channel_Start_Func003C() ) then
        return false
    endif
    return true
endfunction

function Trig_Channel_Start_Func015C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A02D' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Channel_Start_Func017C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0H2' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Channel_Start_Func019C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0DK' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Channel_Start_Func021Func001C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetSpellTargetDestructable()) != 'B02K' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Channel_Start_Func021C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0FW' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Channel_Start_Func023Func001C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetSpellTargetDestructable()) != 'B02K' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Channel_Start_Func023C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0G4' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Channel_Start_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point 
    local location udg_Temp_Polar_Point 
    call PlayerNumbtoHeroesNumb()
    // c
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Progressbar.mdx" )
    set udg_SpellChannels[udg_Player_Number] = GetLastCreatedEffectBJ()
    // c
    call BlzSetSpecialEffectZ( udg_SpellChannels[udg_Player_Number], ( 180.00 + BlzGetLocalUnitZ(GetTriggerUnit()) ) )
    // c
    call BlzSetSpecialEffectColorByPlayer( udg_SpellChannels[udg_Player_Number], GetOwningPlayer(GetTriggerUnit()) )
    set udg_Temp_Unit = GetTriggerUnit()
    // Heartstone
    if ( Trig_Channel_Start_Func015C() ) then
        set udg_IsHearthing[udg_Player_Number] = true
        call BlzSetSpecialEffectTimeScale( udg_SpellChannels[udg_Player_Number], 0.55 )
        call SetUnitTimeScalePercent( udg_Temp_Unit, 67.00 )
        if GetLocalPlayer() == GetOwningPlayer(GetTriggerUnit()) then
        call PlaySoundBJ( gg_snd_Hearthstone )
        endif
    else
    endif
    // Pyroblast
    if ( Trig_Channel_Start_Func017C() ) then
        call BlzSetSpecialEffectTimeScale( udg_SpellChannels[udg_Player_Number], 1.00 )
        call SetUnitTimeScalePercent( udg_Temp_Unit, 90.00 )
        call PlaySoundAtPointBJ( gg_snd_PreCastFireHigh, 100, udg_Temp_Unit_Point, 100.00 )
        // Giant Fireball SE
        set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 96.00, GetUnitFacing(GetTriggerUnit()))
        call AddSpecialEffectLocBJ( udg_Temp_Polar_Point, "war3mapImported\\Pyroblast.mdx" )
        set udg_SpellChannels[( udg_Player_Number + 24 )] = GetLastCreatedEffectBJ()
        call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.50 )
        call BlzSetSpecialEffectHeight( GetLastCreatedEffectBJ(), ( BlzGetLocalSpecialEffectZ(GetLastCreatedEffectBJ()) + 96.00 ) )
        call RemoveLocation (udg_Temp_Polar_Point)
        // Set o
        if udg_Temp_Unit == udg_yA_Fire_Mage then
        set udg_o = udg_z_MA_FIRE_A
        elseif udg_Temp_Unit == udg_yH_Fire_Mage then
        set udg_o = udg_z_MA_FIRE_H
        endif
        // Set it to o + 1 because otherwise it will cause retargeting of current ball before finishing cast if current hasnt hit yet
        set udg_SpellUnits[( udg_o + 1 )] = GetSpellTargetUnit()
    else
    endif
    // Lay On Hands
    if ( Trig_Channel_Start_Func019C() ) then
        call BlzSetSpecialEffectTimeScale( udg_SpellChannels[udg_Player_Number], 0.75 )
        call PlaySoundAtPointBJ( gg_snd_LayOnHands, 100, udg_Temp_Unit_Point, 100.00 )
        call AddSpecialEffectTargetUnitBJ( "right hand", GetTriggerUnit(), "LootEFFECT.mdx" )
        set udg_SpellChannels[( udg_Player_Number + 24 )] = GetLastCreatedEffectBJ()
        call AddSpecialEffectTargetUnitBJ( "left hand", GetTriggerUnit(), "LootEFFECT.mdx" )
        set udg_SpellChannels[( udg_Player_Number + 48 )] = GetLastCreatedEffectBJ()
        call AddSpecialEffectTargetUnitBJ( "overhead", GetTriggerUnit(), "LootEFFECT.mdx" )
        set udg_SpellChannels[( udg_Player_Number + 72 )] = GetLastCreatedEffectBJ()
        if udg_Temp_Unit == udg_yA_Holy_Pally then
        set udg_o = udg_z_PA_HOLY_A
        elseif udg_Temp_Unit == udg_yH_Holy_Pally then
        set udg_o = udg_z_PA_HOLY_H
        elseif udg_Temp_Unit == udg_yA_Prot_Pally then
        set udg_o = udg_z_PA_PROT_A
        elseif udg_Temp_Unit == udg_yH_Prot_Pally then
        set udg_o = udg_z_PA_PROT_H
        elseif udg_Temp_Unit == udg_yA_Ret_Pally then
        set udg_o = udg_z_PA_RETR_A
        elseif udg_Temp_Unit == udg_yH_Ret_Pally then
        set udg_o = udg_z_PA_RETR_H
        endif
        set udg_SpellUnits[udg_o] = GetSpellTargetUnit()
    else
    endif
    // Ressurection
    if ( Trig_Channel_Start_Func021C() ) then
        if ( Trig_Channel_Start_Func021Func001C() ) then
            call IssueImmediateOrderBJ( GetTriggerUnit(), "stop" )
            call ErrorMessage( "Must target a player grave.", GetOwningPlayer(GetTriggerUnit()) )
            set udg_CooldownRemaining = 0.50
            call BlzStartUnitAbilityCooldown( udg_Temp_Unit, 'A0FW', udg_CooldownRemaining )
            set udg_IsValidRezzTarget = false
        else
            call BlzSetSpecialEffectTimeScale( udg_SpellChannels[udg_Player_Number], 0.45 )
            call SetUnitTimeScalePercent( udg_Temp_Unit, 70.00 )
            call PlaySoundAtPointBJ( gg_snd_LayOnHands, 100, udg_Temp_Unit_Point, 100.00 )
            call AddSpecialEffectTargetUnitBJ( "right hand", GetTriggerUnit(), "LootEFFECT.mdx" )
            set udg_SpellChannels[( udg_Player_Number + 24 )] = GetLastCreatedEffectBJ()
            call AddSpecialEffectTargetUnitBJ( "left hand", GetTriggerUnit(), "LootEFFECT.mdx" )
            set udg_SpellChannels[( udg_Player_Number + 48 )] = GetLastCreatedEffectBJ()
            call AddSpecialEffectTargetUnitBJ( "overhead", GetTriggerUnit(), "LootEFFECT.mdx" )
            set udg_SpellChannels[( udg_Player_Number + 72 )] = GetLastCreatedEffectBJ()
            call DebugRess( GetSpellTargetDestructable() )
            set udg_Graves[udg_Player_Number + 24] = GetSpellTargetDestructable() 
            set udg_IsValidRezzTarget = true
        endif
    else
    endif
    // Ancestral Spirit
    if ( Trig_Channel_Start_Func023C() ) then
        if ( Trig_Channel_Start_Func023Func001C() ) then
            call IssueImmediateOrderBJ( GetTriggerUnit(), "stop" )
            call ErrorMessage( "Must target a player grave.", GetOwningPlayer(GetTriggerUnit()) )
            set udg_CooldownRemaining = 0.50
            call BlzStartUnitAbilityCooldown( udg_Temp_Unit, 'A0G4', udg_CooldownRemaining )
            set udg_IsValidRezzTarget = false
        else
            call BlzSetSpecialEffectTimeScale( udg_SpellChannels[udg_Player_Number], 0.55 )
            call SetUnitTimeScalePercent( udg_Temp_Unit, 70.00 )
            call PlaySoundAtPointBJ( gg_snd_NatureCast, 100, udg_Temp_Unit_Point, 100.00 )
            call AddSpecialEffectTargetUnitBJ( "right hand", GetTriggerUnit(), "LootEFFECT_blue.mdx" )
            set udg_SpellChannels[( udg_Player_Number + 24 )] = GetLastCreatedEffectBJ()
            call AddSpecialEffectTargetUnitBJ( "left hand", GetTriggerUnit(), "LootEFFECT_blue.mdx" )
            set udg_SpellChannels[( udg_Player_Number + 48 )] = GetLastCreatedEffectBJ()
            call AddSpecialEffectTargetUnitBJ( "overhead", GetTriggerUnit(), "LootEFFECT_blue.mdx" )
            set udg_SpellChannels[( udg_Player_Number + 72 )] = GetLastCreatedEffectBJ()
            call DebugRess( GetSpellTargetDestructable() )
            set udg_Graves[udg_Player_Number + 24] = GetSpellTargetDestructable() 
            set udg_IsValidRezzTarget = true
        endif
    else
    endif
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = null
    set udg_Temp_Polar_Point = null
endfunction

