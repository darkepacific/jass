function Trig_The_Siege_of_Gilneas_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    call DestroyEffectBJ( udg_QuestMarks[66] )
    call DisableTrigger( gg_trg_Gilneas_City_Classical )
    call EnableTrigger( gg_trg_Gilneas_City_Battle_Music )
    call EnableTrigger( gg_trg_SoG_Skelly_Spawn)
    call EnableTrigger( gg_trg_Ladder_Construction_E)
    call EnableTrigger( gg_trg_Ladder_Construction_W)
    call QuestMessageBJ( GetPlayersAll(), bj_QUESTMESSAGE_ALWAYSHINT, "TRIGSTR_7507" )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_SoG_Spawn_MW1)
    call CreateNUnitsAtLoc( 1, 'umtw', Player(3), udg_Temp_Unit_Point, 245.96 )
    call GroupAddUnitSimple( GetLastCreatedUnit(), udg_SoG_MeatWagons )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_SoG_Spawn_MW2)
    call CreateNUnitsAtLoc( 1, 'umtw', Player(3), udg_Temp_Unit_Point, 245.96 )
    call GroupAddUnitSimple( GetLastCreatedUnit(), udg_SoG_MeatWagons )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_SoG_Spawn_MW3)
    call CreateNUnitsAtLoc( 1, 'umtw', Player(3), udg_Temp_Unit_Point, 245.96 )
    call GroupAddUnitSimple( GetLastCreatedUnit(), udg_SoG_MeatWagons )
    call RemoveLocation (udg_Temp_Unit_Point)
    // Attack trees 1 & Create Peasants
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_SoG_Attack_Point_1)
    call GroupPointOrderLocBJ( udg_SoG_MeatWagons, "attackground", udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    // Attack Forces
    set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_SoG_Spawn_Warriors)
    call CreateNUnitsAtLoc( 1, 'uabo', Player(3), udg_Temp_Unit_Point, 245.96 )
    call GroupAddUnitSimple( GetLastCreatedUnit(), udg_SoG_Warriors )
    call CreateNUnitsAtLoc( 1, 'uabo', Player(3), udg_Temp_Unit_Point, 245.96 )
    call GroupAddUnitSimple( GetLastCreatedUnit(), udg_SoG_Warriors )
    call CreateNUnitsAtLoc( 1, 'u00G', Player(3), udg_Temp_Unit_Point, 245.96 )
    call GroupAddUnitSimple( GetLastCreatedUnit(), udg_SoG_Warriors )
    call CreateNUnitsAtLoc( 1, 'u00G', Player(3), udg_Temp_Unit_Point, 245.96 )
    call GroupAddUnitSimple( GetLastCreatedUnit(), udg_SoG_Warriors )
    call CreateNUnitsAtLoc( 1, 'uban', Player(3), udg_Temp_Unit_Point, 245.96 )
    call GroupAddUnitSimple( GetLastCreatedUnit(), udg_SoG_Warriors )
    call CreateNUnitsAtLoc( 1, 'uban', Player(3), udg_Temp_Unit_Point, 245.96 )
    call GroupAddUnitSimple( GetLastCreatedUnit(), udg_SoG_Warriors )
    call CreateNUnitsAtLoc( 1, 'e02G', Player(3), udg_Temp_Unit_Point, 245.96 )
    call GroupAddUnitSimple( GetLastCreatedUnit(), udg_SoG_Warriors )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_SoG_Spawn_Dark_Ranger)
    call ReviveHeroLoc( gg_unit_H027_1820, udg_Temp_Unit_Point, true )
    call SetUnitPositionLocFacingBJ( gg_unit_H027_1820, udg_Temp_Unit_Point, 260.00 )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_The_SiegeOfGilneas)
    call ReviveHeroLoc( gg_unit_H021_1835, udg_Temp_Unit_Point, true )
    call SetUnitPositionLocFacingBJ( gg_unit_H021_1835, udg_Temp_Unit_Point, 260.00 )
    call RemoveLocation (udg_Temp_Unit_Point)
    call GroupAddUnitSimple( GetLastCreatedUnit(), udg_SoG_Warriors )
    call GroupAddUnitSimple( gg_unit_H027_1820, udg_SoG_Warriors )
    call GroupAddUnitSimple( gg_unit_H021_1835, udg_SoG_Warriors )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_SoG_Attack_Point_3_MW)
    call GroupPointOrderLocBJ( udg_SoG_Warriors, "attack", udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    // Revive Genn
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Genn_Greymane)
    call ReviveHeroLoc( gg_unit_U00J_1218, udg_Temp_Unit_Point, true )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 4.00 )
    call ShowDestructableBJ( false, gg_dest_B023_30866 )
    call ShowDestructableBJ( false, gg_dest_B023_30945 )
    // CLOSE THE GATE!!
    call TriggerExecute( gg_trg_MAKE_WORGEN )
    call EnableTrigger( gg_trg_Greymane_Gate_Dies)
    call PlaySoundBJ( gg_snd_BattlenetBirth1 )
    call DisableTrigger( gg_trg_Gilneas_Gate )
    // Attack trees 2
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_SoG_Attack_Point_3)
    call GroupPointOrderLocBJ( udg_SoG_MeatWagons, "attackground", udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 1.50 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_SoG_Attack_Point_2)
    call GroupPointOrderLocBJ( udg_SoG_MeatWagons, "attackground", udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    // Create Peasants
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_SoG_Attack_Point_1)
    call CreateNUnitsAtLoc( 1, 'h02S', Player(3), udg_Temp_Unit_Point, 245.96 )
    call GroupAddUnitSimple( GetLastCreatedUnit(), udg_SoG_Peasants )
    set udg_Temp_Polar_Point = GetRectCenter(gg_rct_Ladder_E)
    call IssuePointOrderLocBJ( GetLastCreatedUnit(), "move", udg_Temp_Polar_Point )
    call RemoveLocation (udg_Temp_Polar_Point)
    call CreateNUnitsAtLoc( 1, 'h02S', Player(3), udg_Temp_Unit_Point, 245.96 )
    call GroupAddUnitSimple( GetLastCreatedUnit(), udg_SoG_Peasants )
    set udg_Temp_Polar_Point = GetRectCenter(gg_rct_Ladder_W)
    call IssuePointOrderLocBJ( GetLastCreatedUnit(), "move", udg_Temp_Polar_Point )
    call RemoveLocation (udg_Temp_Polar_Point)
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 11.00 )
    // Attack trees 3
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_SoG_Attack_Point_3)
    call GroupPointOrderLocBJ( udg_SoG_MeatWagons, "attackground", udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    // Attack Gate
    call GroupTargetDestructableOrder( udg_SoG_Warriors, "attack", gg_dest_DTg8_0488 )
    call TriggerSleepAction( 8.00 )
    call GroupTargetDestructableOrder( udg_SoG_Warriors, "attack", gg_dest_DTg8_0488 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_SoG_Attack_Point_3_MW)
    call GroupPointOrderLocBJ( udg_SoG_MeatWagons, "attackground", udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 5.00 )
    call GroupTargetDestructableOrder( udg_SoG_Warriors, "attack", gg_dest_DTg8_0488 )
    call GroupTargetDestructableOrder( udg_SoG_MeatWagons, "attack", gg_dest_DTg8_0488 )
    call TriggerSleepAction( 3.00 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_SoG_Attack_Point_3_MW)
    call GroupPointOrderLocBJ( udg_SoG_Warriors, "attack", udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 3.00 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_SoG_Attack_Point_3_MW)
    call GroupPointOrderLocBJ( udg_SoG_Warriors, "attack", udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 4.00 )
    if ( Trig_The_Siege_of_Gilneas_Func113C() ) then
        call GroupTargetDestructableOrder( udg_SoG_Warriors, "attack", gg_dest_DTg8_0488 )
        call GroupTargetDestructableOrder( udg_SoG_MeatWagons, "attack", gg_dest_DTg8_0488 )
        call TriggerSleepAction( 4.00 )
        if ( Trig_The_Siege_of_Gilneas_Func113Func004C() ) then
            call GroupTargetDestructableOrder( udg_SoG_Warriors, "attack", gg_dest_DTg8_0488 )
            call GroupTargetDestructableOrder( udg_SoG_MeatWagons, "attack", gg_dest_DTg8_0488 )
            call TriggerSleepAction( 4.00 )
        else
        endif
    else
    endif
    // Attack Interior
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_SoG_Attack_Point_4)
    call GroupPointOrderLocBJ( udg_SoG_MeatWagons, "attack", udg_Temp_Unit_Point )
    call GroupPointOrderLocBJ( udg_SoG_Warriors, "attack", udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 15.00 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_SoG_Attack_Point_4)
    call GroupPointOrderLocBJ( udg_SoG_MeatWagons, "attack", udg_Temp_Unit_Point )
    call GroupPointOrderLocBJ( udg_SoG_Warriors, "attack", udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 10.00 )
    call ForGroupBJ( udg_SoG_Warriors, function Trig_The_Siege_of_Gilneas_Func125A )
    call GroupRemoveUnitSimple( gg_unit_H021_1835, udg_SoG_Warriors )
    call GroupAddUnitSimple( gg_unit_H021_1835, udg_SoG_MeatWagons )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_The_Slave_Master)
    call GroupPointOrderLocBJ( udg_SoG_MeatWagons, "attack", udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_SoG_Attack_Point_5)
    call GroupPointOrderLocBJ( udg_SoG_Warriors, "attack", udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 11.00 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_The_Slave_Master)
    call GroupPointOrderLocBJ( udg_SoG_MeatWagons, "attack", udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_SoG_Attack_Point_5)
    call GroupPointOrderLocBJ( udg_SoG_Warriors, "attack", udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 11.00 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_SoG_Attack_Point_5)
    call GroupPointOrderLocBJ( udg_SoG_Warriors, "attack", udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 11.00 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_SoG_Attack_Point_5)
    call GroupPointOrderLocBJ( udg_SoG_Warriors, "attack", udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call DisableTrigger( gg_trg_Gilneas_City_Battle_Music )
    call EnableTrigger( gg_trg_Gilneas_City_Classical )
    call TriggerSleepAction( 45.00 )
    call GroupRemoveUnitSimple( gg_unit_H021_1835, udg_SoG_MeatWagons )
    call GroupRemoveUnitSimple( gg_unit_H027_1820, udg_SoG_Warriors )
    call ForGroupBJ( udg_SoG_Warriors, function Trig_The_Siege_of_Gilneas_Func154A )
    call ForGroupBJ( udg_SoG_MeatWagons, function Trig_The_Siege_of_Gilneas_Func155A )
    call ForGroupBJ( udg_SoG_Peasants, function Trig_The_Siege_of_Gilneas_Func156A )
    call DisableTrigger( gg_trg_Gilneas_City_Battle_Music )
    call EnableTrigger( gg_trg_Gilneas_City_Classical )
    call DisableTrigger( gg_trg_SoG_Skelly_Spawn)
    call DisableTrigger( gg_trg_Ladder_Construction_E)
    call DisableTrigger( gg_trg_Ladder_Construction_W)
    if ( Trig_The_Siege_of_Gilneas_Func162C() ) then
        // OPEN THE GATE!!
        call EnableTrigger( gg_trg_Gilneas_Gate )
    else
    endif
    call TriggerSleepAction( 60.00 )
    if ( Trig_The_Siege_of_Gilneas_Func164C() ) then
        call DestroyGroup (udg_SoG_Warriors)
        call DestroyGroup (udg_SoG_MeatWagons)
        call DestroyGroup (udg_SoG_Peasants)
    else
        call QuestMessageBJ( udg_HordePlayers, bj_QUESTMESSAGE_WARNING, "TRIGSTR_4978" )
        if ( Trig_The_Siege_of_Gilneas_Func164Func002C() ) then
            call GroupClear( udg_SoG_MeatWagons )
            call GroupClear( udg_SoG_Warriors )
            call GroupClear( udg_SoG_Peasants )
            set udg_Temp_Unit_Point = GetRectCenter(gg_rct_The_SiegeOfGilneas)
            call ReviveHeroLoc( gg_unit_H027_1820, udg_Temp_Unit_Point, true )
            call SetUnitPositionLocFacingBJ( gg_unit_H027_1820, udg_Temp_Unit_Point, 260.00 )
            call RemoveLocation (udg_Temp_Unit_Point)
            set udg_TempString = ""
            if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
            set udg_TempString = udg_ExclamationMark
            endif
            call AddSpecialEffectTargetUnitBJ( "overhead", gg_unit_H027_1820, udg_TempString )
            set udg_QuestMarks[66] = GetLastCreatedEffectBJ()
            call EnableTrigger( gg_trg_S_SoG )
        else
        endif
    endif
    set udg_Temp_Unit_Point = null
endfunction

