    function GetHeroProperNameFromSlot takes integer slot returns string
        // Death Knight (base 110)
        if slot == 110 then
            return "Blood"
        elseif slot == 111 then
            return "Frost"
        elseif slot == 112 then
            return "Unholy"

            // Demon Hunter (base 120)
        elseif slot == 120 then
            return "Havoc"
        elseif slot == 121 then
            return "Vengeance"

