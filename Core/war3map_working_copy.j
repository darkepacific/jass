//===========================================================================
function Trig_Frost_Missiles_Start_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0H5' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Frost_Missiles_Start_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    local unit udg_Temp_Unit
    local integer udg_Temp_Int = 10
    local effect e
    call PlaySoundOnUnit("war3mapImported\\MageChannel.mp3", GetTriggerUnit())
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\FrostAuraBuff.mdx" )
    set e = GetLastCreatedEffectBJ()
       call BlzSetSpecialEffectPositionLoc( e, udg_Temp_Unit_Point )
       call BlzSetSpecialEffectZ( e, ( BlzGetLocalSpecialEffectZ(e) + 60.00 ) )
    call CreateNUnitsAtLoc( 1, 'e04V', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, GetUnitFacing(GetTriggerUnit()) )
    call SetUnitPositionLoc( GetLastCreatedUnit(), udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit = GetTriggerUnit()
    call UnitApplyTimedLifeBJ( 1.80, 'BTLF', GetLastCreatedUnit() )
    set udg_ArcaneMissiles[udg_Temp_Int] = GetLastCreatedUnit()
    set udg_ArcaneMissiles[( udg_Temp_Int + 1 )] = GetSpellTargetUnit()
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    call SetUnitPositionLoc( udg_ArcaneMissiles[udg_Temp_Int], udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call IssueTargetOrderBJ( udg_ArcaneMissiles[udg_Temp_Int], "attack", udg_ArcaneMissiles[( udg_Temp_Int + 1 )] )
    call TriggerSleepAction( 0.50 )
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
       call BlzSetSpecialEffectPositionLoc( e, udg_Temp_Unit_Point )
       call BlzSetSpecialEffectZ( e, ( BlzGetLocalSpecialEffectZ(e) + 60.00 ) )
    call SetUnitPositionLoc( udg_ArcaneMissiles[udg_Temp_Int], udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call IssueTargetOrderBJ( udg_ArcaneMissiles[udg_Temp_Int], "attack", udg_ArcaneMissiles[( udg_Temp_Int + 1 )] )
    call BlzSetSpecialEffectAlpha( e, 0 )
    call DestroyEffect(e)
    set udg_Temp_Unit_Point = null
    set udg_Temp_Unit = null
    set e = null
endfunction

