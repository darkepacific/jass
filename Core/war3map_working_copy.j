            return "Brewmaster"
        elseif slot == 161 then
            return "Mistweaver"
        elseif slot == 162 then
            return "Windwalker"

            // Paladin (base 170)
        elseif slot == 170 then
            return "Holy"
        elseif slot == 171 then
            return "Protection"
        elseif slot == 172 then
            return "Retribution"
            // elseif slot == 173 then
            //     return "Vindication" //Shock Paladin

            // Priest (base 180)
