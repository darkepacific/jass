//===========================================================================
// Trigger: U TBWW
//===========================================================================
function Trig_U_TBWW_Func007Func001C takes nothing returns boolean
    if ( not ( GetItemTypeId(udg_P_Items[( udg_Bag_Num + udg_Bag_Iterator )]) == udg_ItemTypeCheck ) ) then
        return false
    endif
    return true
endfunction

function Trig_U_TBWW_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 151
    local effect e
    local location udg_Temp_Unit_Point
                       if IsHordeHero( GetTriggerUnit() ) then
    call SetBagNumber( GetOwningPlayer(GetTriggerUnit()) )
    set udg_ItemTypeCheck = 'I04V'
    set udg_Bag_Iterator = 1
    loop
        exitwhen udg_Bag_Iterator > udg_BAG_LOOP_MAX
        if ( Trig_U_TBWW_Func007Func001C() ) then
            if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
            call FlashQuestDialogButtonBJ(  )
            endif
            // Update Reqs
            call QuestItemSetCompletedBJ( udg_QuestReqs[udg_Temp_Int], true )
            call DestroyEffectBJ( udg_QuestMarks[udg_Temp_Int] )
            call DestroyMinimapIcon( udg_MiniMapIcon[udg_Temp_Int] )
            call CreateQuestItemBJ( udg_Quests[udg_Temp_Int], "TRIGSTR_102" )
            set udg_QuestReqs[udg_Temp_Int] = GetLastCreatedQuestItemBJ()
            // Clean Up Items
            call CleanUpItems( udg_ItemTypeCheck )
            // Disable
            call DisableTrigger( gg_trg_S_TBWW)
            call DisableTrigger( gg_trg_Ashes_Replenish_TBWW)
            call EnableTrigger( gg_trg_E_TBWW)
            call DisableTrigger( GetTriggeringTrigger() )
            // Special Effect
            set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Q_The_Bride_Who_Waits_Boss_Spawn)
            call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Spells\\Items\\TomeOfRetraining\\TomeOfRetrainingCaster.mdl" )
            call RemoveLocation (udg_Temp_Unit_Point)
            set e = GetLastCreatedEffectBJ()
            call TriggerSleepAction( 1.25 )
            call DestroyEffectBJ( e )
            call TBWW_Cinematic()
            // Create Boss
            set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Q_The_Bride_Who_Waits_Boss_Spawn)
            call CreateNUnitsAtLoc( 1, 'n05Y', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Temp_Unit_Point, bj_UNIT_FACING )
            call PlaySoundAtPointBJ( gg_snd_BansheePissed1, 100, udg_Temp_Unit_Point, 150.00 )
            call CreateTextTagUnitBJ( "TRIGSTR_1889", GetLastCreatedUnit(), 0, 8.00, 70.00, 100.00, 80.00, 0 )
            call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
            call cleanUpText(1.5, 1.25) 
            call RemoveLocation (udg_Temp_Unit_Point)
            // Quest Demarkation
            call CampaignMinimapIconUnitBJ( GetLastCreatedUnit(), bj_CAMPPINGSTYLE_BOSS )
            call SetMinimapIconOrphanDestroy( GetLastCreatedMinimapIcon(), true )
            set udg_MiniMapIcon[udg_Temp_Int] = GetLastCreatedMinimapIcon()
            if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
            call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), false )
            return
            endif
        else
        endif
        set udg_Bag_Iterator = udg_Bag_Iterator + 1
    endloop
                       endif
    set e = null
    set udg_Temp_Unit_Point = null
endfunction

