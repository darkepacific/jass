// Trigger: E ALS
//===========================================================================
function Trig_E_ALS_Func006Func001C takes nothing returns boolean
    if ( not ( GetItemTypeId(udg_P_Items[( udg_Bag_Num + udg_Bag_Iterator )]) == udg_ItemTypeCheck ) ) then
        return false
    endif
    return true
endfunction

function Trig_E_ALS_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 44
    local effect sfx
                       if IsAllianceHero( GetTriggerUnit() ) then
    call SetBagNumber( GetOwningPlayer(GetTriggerUnit()) )
    set udg_ItemTypeCheck = 'I05M'
    set udg_Bag_Iterator = 1
    loop
        exitwhen udg_Bag_Iterator > udg_BAG_LOOP_MAX
        if ( Trig_E_ALS_Func006Func001C() ) then
            call DisableTrigger( gg_trg_L_ALS )
            call DisableTrigger( GetTriggeringTrigger() )
            if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
            call FlashQuestDialogButtonBJ(  )
            endif
            call QuestSetCompletedBJ( udg_Quests[44], true )
            call DestroyEffectBJ( udg_QuestMarks[44] )
            call DestroyMinimapIcon( udg_MiniMapIcon[44] )
            // Clean Up Items
            call CleanUpItems( udg_ItemTypeCheck )
            // Rewards
            set udg_Gold = udg_QUEST_GOLD[udg_Temp_Int]
            set udg_XP = udg_QUEST_XP[udg_Temp_Int]
            set udg_LVL_Req = udg_QUEST_LVL_REQ[udg_Temp_Int]
            set udg_TempString = "A Love Story"
            call TriggerExecute( gg_trg_Quest_Complete_A )
            call CreateTextTagUnitBJ( "TRIGSTR_9504", gg_unit_n02P_1618, 0, 9.00, 90.00, 90.00, 20.00, 0 )
            call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
                    call cleanUpText( 1.5, 1.2 ) 
            call AddSpecialEffectTargetUnitBJ( "overhead", gg_unit_n02P_1618, "war3mapImported\\Fallinlove.mdx" )
            set sfx = GetLastCreatedEffectBJ()
            call GameTimeWait(1.0)
            call DestroyEffectBJ(sfx)
            return
        else
        endif
        set udg_Bag_Iterator = udg_Bag_Iterator + 1
    endloop
                       endif
    set sfx = null
endfunction

