    set gg_trg_S_Sindra_A = CreateTrigger(  )
    call DisableTrigger( gg_trg_S_Sindra_A )
    call TriggerRegisterEnterRectSimple( gg_trg_S_Sindra_A, gg_rct_Heart_of_Sindragosa )
    call TriggerRegisterUnitInRangeSimple( gg_trg_S_Sindra_A, 256, gg_unit_ntkc_0641 )
    call TriggerAddAction( gg_trg_S_Sindra_A, function Trig_S_Sindra_A_Actions )
endfunction

