    if ( GetTriggerUnit() == udg_SpellUnits[udg_z_WL_DEST_A]  ) then
        return true
    elseif ( GetTriggerUnit() == udg_SpellUnits[udg_z_WL_DEST_H]  ) then
        return true
    endif
    return false    
endfunction

function Trig_Sacrfice_Dies_Actions takes nothing returns nothing
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    call PlaySoundAtPointBJ( gg_snd_SuccubusDeath1, 66, udg_Temp_Unit_Point, 0 )
    call RemoveLocation (udg_Temp_Unit_Point)
    if ( GetTriggerUnit() == udg_SpellUnits[udg_z_WL_DEST_A]  ) then
	call UnitRemoveAbilityBJ( 'A09B', udg_yA_Destro_Warlock )
    	call BlzUnitDisableAbility( udg_yA_Destro_Warlock, 'A09C', false, false )
    else
    	call UnitRemoveAbilityBJ( 'A09B', udg_yH_Destro_Warlock )
    	call BlzUnitDisableAbility( udg_yH_Destro_Warlock, 'A09C', false, false )
    endif    
endfunction

