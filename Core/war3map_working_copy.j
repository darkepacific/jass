    set udg_TempString = udg_ExclamationMark
    endif
    call AddSpecialEffectTargetUnitBJ( "overhead", gg_unit_H00L_0712, udg_TempString )
    set udg_QuestMarks[11] = GetLastCreatedEffectBJ()
    set udg_TempString = "A group of sea giants to the east of here threaten our mining operation. Clear them out before they get too close."
    // Set Quest Rewards
    set udg_QUEST_XP[udg_Temp_Int] = 600
    set udg_QUEST_GOLD[udg_Temp_Int] = 100
    set udg_QUEST_LVL_REQ[udg_Temp_Int] = udg_QUEST_ZONE_2_LVL_REQ
    call QuestRewards_TextSet(udg_Temp_Int)
    // End Set Quest Rewards
    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_4632", udg_TempString, "ReplaceableTextures\\CommandButtons\\BTNSeaGiant.blp" )
    set udg_Quests[11] = GetLastCreatedQuestBJ()
    call QuestSetEnabledBJ( false, GetLastCreatedQuestBJ() )
    call EnableTrigger( gg_trg_S_Taming_the_Sea )
endfunction

