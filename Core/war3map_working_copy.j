function Trig_M_SAC_A_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 172
    set udg_TempString = ""
    if IsAlliancePlayer(GetLocalPlayer() ) then
    set udg_TempString = udg_ExclamationMark
    endif
    call AddSpecialEffectTargetUnitBJ( "overhead", udg_AgentSkully, udg_TempString )
