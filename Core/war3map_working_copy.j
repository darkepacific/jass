//===========================================================================
// Trigger: Rain of Fire Tick OR
//===========================================================================
function Trig_Rain_of_Fire_Tick_OR_Func020Func006C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetEnumUnit(), 'B00U') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Rain_of_Fire_Tick_OR_Func020A takes nothing returns nothing
    if IsUnitTargetableEnemy( GetEnumUnit(), udg_Temp_Unit ) then
    if udg_Temp_Bool then
    call IssueTargetOrderBJ( gg_unit_e028_1863, "slow", GetEnumUnit() )
    endif
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    if ( Trig_Rain_of_Fire_Tick_OR_Func020Func006C() ) then
        set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A099', udg_Temp_Unit) * 25 )
        call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "Abilities\\Weapons\\DemolisherFireMissile\\DemolisherFireMissile.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), ( ( I2R(udg_HeroStatCalc) + udg_Temp_Real ) / 2.00 ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    else
    endif
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_Rain_of_Fire_Tick_OR_Actions takes nothing returns nothing
    set udg_Temp_Unit = udg_yH_Destro_Warlock
    call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 1.50 * udg_RealStatCalc )
    // Used for Immolate
    set udg_Temp_Real = udg_RealStatCalc
    // Double Dmg
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 13 ]  then
    set udg_RealStatCalc = ( 2.00 * udg_RealStatCalc )
    endif
    // Slow
    set udg_Temp_Bool =  udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 9 ] 
    if udg_Temp_Bool then
    call SetUnitAbilityLevelSwapped( 'A03P', gg_unit_e028_1863, 4 )
    call SetUnitOwner( gg_unit_e028_1863, GetOwningPlayer(udg_Temp_Unit), true )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(gg_unit_e028_1863, 'A03P'), ABILITY_RLF_DURATION_NORMAL, 3, 1.5 )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(gg_unit_e028_1863, 'A03P'), ABILITY_RLF_DURATION_HERO, 3, 1.5 )
    endif
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(( 235.00 + ( 10.00 * I2R(GetUnitAbilityLevelSwapped('A09A', udg_Temp_Unit)) ) ), udg_Blizzard[3]), function Trig_Rain_of_Fire_Tick_OR_Func020A )
endfunction

//===========================================================================
function InitTrig_Rain_of_Fire_Tick_OR takes nothing returns nothing
    set gg_trg_Rain_of_Fire_Tick_OR = CreateTrigger(  )
    call DisableTrigger( gg_trg_Rain_of_Fire_Tick_OR )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Rain_of_Fire_Tick_OR, 1.00 )
    call TriggerAddAction( gg_trg_Rain_of_Fire_Tick_OR, function Trig_Rain_of_Fire_Tick_OR_Actions )
endfunction

