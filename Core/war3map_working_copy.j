//===========================================================================
// Trigger: Death All
//
// 
//  set udg_playergroup = bj_FORCE_PLAYER[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))]
//===========================================================================
function Trig_Death_All_Conditions takes nothing returns boolean
    if ( not ( GetPlayerController(GetOwningPlayer(GetTriggerUnit())) == MAP_CONTROL_USER ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Death_All_Func025Func017C takes nothing returns boolean
    if ( not ( RectContainsUnit(gg_rct_Z_Duel_Island, GetTriggerUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Death_All_Func025C takes nothing returns boolean
    if ( not ( udg_Quick_Deaths == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Death_All_Func028C takes nothing returns boolean
    if ( not ( RectContainsUnit(gg_rct_Z_Duel_Island, GetTriggerUnit()) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Death_All_Actions takes nothing returns nothing
    local real udg_RealStatCalc
    local integer udg_HeroStatCalc
    local real deathTime =5
    local integer udg_Gold = 0
    local integer udg_Player_Number = HeroesNumb( GetTriggerPlayer() )
    local player udg_X_Player_MUI
    set udg_X_Player_MUI = GetOwningPlayer(udg_Heroes[udg_Player_Number])
    // Kill Bounty
    set udg_Gold = ( GetPlayerState(GetOwningPlayer(GetTriggerUnit()), PLAYER_STATE_RESOURCE_GOLD) / 6 )
    if udg_Gold > udg_GOLD_LOSS_MAX then
    set udg_Gold = udg_GOLD_LOSS_MAX
    endif
    if IsAlliancePlayer(GetOwningPlayer(GetKillingUnit())  ) then
    call DisplayTextToForce( udg_AlliancePlayers, ( ( ( GetPlayerName(GetOwningPlayer(GetKillingUnitBJ())) + ( " has slain " + ( GetPlayerName(GetTriggerPlayer()) + " for " ) ) ) + I2S(udg_Gold) ) + " Gold" ) )
    endif
    if IsHordePlayer(GetOwningPlayer(GetKillingUnit())  ) then
    call DisplayTextToForce( udg_HordePlayers, ( ( ( GetPlayerName(GetOwningPlayer(GetKillingUnitBJ())) + ( " has slain " + ( GetPlayerName(GetTriggerPlayer()) + " for " ) ) ) + I2S(udg_Gold) ) + " Gold" ) )
    endif
    call AdjustPlayerStateBJ( udg_Gold, GetOwningPlayer(GetKillingUnitBJ()), PLAYER_STATE_RESOURCE_GOLD )
    call AdjustPlayerStateBJ( ( udg_Gold * -1 ), GetOwningPlayer(GetTriggerUnit()), PLAYER_STATE_RESOURCE_GOLD )
    // Death Time
    if ( Trig_Death_All_Func025C() ) then
        if udg_GameMode == "Normal" then
        set udg_HeroStatCalc = ( GetUnitLevel(GetTriggerUnit()) / 3 )
        set udg_HeroStatCalc = ( udg_HeroStatCalc + 9 )
        else
        set udg_HeroStatCalc = ( GetUnitLevel(GetTriggerUnit()) * 4 )
        set udg_HeroStatCalc = ( udg_HeroStatCalc / 5 )
        endif
        set udg_RealStatCalc = I2R(udg_HeroStatCalc)
        // check if DK talent
         if GetTriggerUnit() == udg_yA_Blood_DK or GetTriggerUnit() == udg_yH_Blood_DK or GetTriggerUnit() == udg_yA_Unholy_DK or GetTriggerUnit() == udg_yH_Unholy_DK then
        if udg_TalentChoices[ GetPlayerId(GetOwningPlayer( GetTriggerUnit() )) * udg_NUM_OF_TC + 4 ]  then
        set udg_RealStatCalc = udg_RealStatCalc - 5
        endif
        endif
        if ( Trig_Death_All_Func025Func017C() ) then
            set udg_RealStatCalc = 10
        else
        endif
        set deathTime = udg_RealStatCalc
    else
        set udg_RealStatCalc = deathTime
    endif
    // Grave Creation and Respawn Timer
    call CreateGraveStone( GetTriggerUnit(), deathTime)
    if ( Trig_Death_All_Func028C() ) then
        call TriggerExecute(gg_trg_Rezz_Start)
    else
    endif
    call ForceAddPlayerSimple( udg_X_Player_MUI, udg_Player_Message_Group )
    call DisplayTextToForce( udg_Player_Message_Group, ( ( "You died -" + I2S(udg_Gold) ) + " Gold" ) )
    call ForceRemovePlayerSimple( udg_X_Player_MUI, udg_Player_Message_Group )
    call StartTimerBJ( udg_RespawnTimer[udg_Player_Number], false, udg_RealStatCalc )
    set udg_RespawnTimer[udg_Player_Number] = GetLastCreatedTimerBJ()
    call CreateTimerDialogBJ( udg_RespawnTimer[udg_Player_Number], "TRIGSTR_10625" )
    set udg_DeathTimerWindows[udg_Player_Number] = GetLastCreatedTimerDialogBJ()
    call TimerDialogDisplayBJ( false, udg_DeathTimerWindows[udg_Player_Number] )
    call TimerDialogDisplayForPlayerBJ( true, udg_DeathTimerWindows[udg_Player_Number], udg_X_Player_MUI )
    set udg_X_Player_MUI = null
endfunction

//===========================================================================
function InitTrig_Death_All takes nothing returns nothing
    set gg_trg_Death_All = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Death_All, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_Death_All, Condition( function Trig_Death_All_Conditions ) )
    call TriggerAddAction( gg_trg_Death_All, function Trig_Death_All_Actions )
endfunction

//===========================================================================
// Trigger: Respawn Timer Expires
//===========================================================================
function Trig_Respawn_Timer_Expires_Func003Func004C takes nothing returns boolean
    if ( not ( IsUnitPausedBJ(udg_Heroes[udg_Player_Number]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Respawn_Timer_Expires_Func003Func008C takes nothing returns boolean
    if ( not ( udg_Player_Number < 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Respawn_Timer_Expires_Actions takes nothing returns nothing
    local unit udg_Temp_Unit
    call Debug( "Respawn Timer Expired" )
    set bj_forLoopBIndex = 0
    set bj_forLoopBIndexEnd = 7
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        if GetExpiredTimer() == udg_RespawnTimer[ bj_forLoopBIndex ] then
        set udg_Player_Number = GetForLoopIndexB()
        set udg_X_Player_MUI = GetOwningPlayer( udg_Heroes[udg_Player_Number])
        if ( Trig_Respawn_Timer_Expires_Func003Func004C() ) then
            exitwhen true
        else
        endif
        set udg_Temp_Int = GetForLoopIndexB()
        set udg_DoRevive = true
        set udg_IsARezz = false
        if ( Trig_Respawn_Timer_Expires_Func003Func008C() ) then
            call TriggerExecute(gg_trg_Death_Set_Horde)
        else
            call TriggerExecute(gg_trg_Death_Set_Alliance)
        endif
        exitwhen true
        endif
        set bj_forLoopBIndex = bj_forLoopBIndex + 1
    endloop
    set udg_Temp_Unit = null
    return
endfunction

//===========================================================================
function InitTrig_Respawn_Timer_Expires takes nothing returns nothing
    set gg_trg_Respawn_Timer_Expires = CreateTrigger(  )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_Respawn_Timer_Expires, udg_RespawnTimer[0] )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_Respawn_Timer_Expires, udg_RespawnTimer[1] )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_Respawn_Timer_Expires, udg_RespawnTimer[2] )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_Respawn_Timer_Expires, udg_RespawnTimer[3] )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_Respawn_Timer_Expires, udg_RespawnTimer[4] )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_Respawn_Timer_Expires, udg_RespawnTimer[5] )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_Respawn_Timer_Expires, udg_RespawnTimer[6] )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_Respawn_Timer_Expires, udg_RespawnTimer[7] )
    call TriggerAddAction( gg_trg_Respawn_Timer_Expires, function Trig_Respawn_Timer_Expires_Actions )
endfunction

