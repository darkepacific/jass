    else
        call RemoveLocation (udg_Point_Charge_Begin[16])
        call RemoveLocation (udg_Point_Charge_End[16])
        call DestroyEffectBJ( udg_Charge_SE[16] )
        set udg_Temp_Unit = udg_yH_Combat_Rogue
        set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A0DS', udg_Temp_Unit) * 75 )
        set udg_HeroStatCalc = ( udg_HeroStatCalc + 50 )
        set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, false) ))
        set udg_RealStatCalc = ( 4.00 * udg_RealStatCalc )
        set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
        call UnitDamageTargetBJ( udg_Temp_Unit, udg_Chain_Target[4], udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        call DisableTrigger( GetTriggeringTrigger() )
    endif
