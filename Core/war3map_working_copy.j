//===========================================================================
function Trig_Travel_Form_Feral_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0E1' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Travel_Form_Feral_Func005C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'E04B' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Travel_Form_Feral_Actions takes nothing returns nothing
    if GetTriggerUnit() == udg_yA_Feral_Druid or GetTriggerUnit() == udg_yH_Feral_Druid then
    call RefreshTalentUINoSound( GetTriggerPlayer() )
    call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "Abilities\\Spells\\Human\\Polymorph\\PolyMorphTarget.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    if ( Trig_Travel_Form_Feral_Func005C() ) then
        call SetPlayerAbilityAvailableBJ( true, 'A035', GetOwningPlayer(GetTriggerUnit()) )
        call SetPlayerAbilityAvailableBJ( true, 'A031', GetOwningPlayer(GetTriggerUnit()) )
        call SetPlayerAbilityAvailableBJ( true, 'A08P', GetOwningPlayer(GetTriggerUnit()) )
        call SetPlayerAbilityAvailableBJ( true, 'A00N', GetOwningPlayer(GetTriggerUnit()) )
        call SetPlayerAbilityAvailableBJ( true, 'A030', GetOwningPlayer(GetTriggerUnit()) )
        call SetPlayerAbilityAvailableBJ( true, 'A02Z', GetOwningPlayer(GetTriggerUnit()) )
        call SetPlayerAbilityAvailableBJ( true, 'A02Y', GetOwningPlayer(GetTriggerUnit()) )
    else
        call SetPlayerAbilityAvailableBJ( false, 'A035', GetOwningPlayer(GetTriggerUnit()) )
        call SetPlayerAbilityAvailableBJ( false, 'A031', GetOwningPlayer(GetTriggerUnit()) )
        call SetPlayerAbilityAvailableBJ( false, 'A08P', GetOwningPlayer(GetTriggerUnit()) )
        call SetPlayerAbilityAvailableBJ( false, 'A00N', GetOwningPlayer(GetTriggerUnit()) )
        call SetPlayerAbilityAvailableBJ( false, 'A030', GetOwningPlayer(GetTriggerUnit()) )
        call SetPlayerAbilityAvailableBJ( false, 'A02Z', GetOwningPlayer(GetTriggerUnit()) )
        call SetPlayerAbilityAvailableBJ( false, 'A02Y', GetOwningPlayer(GetTriggerUnit()) )
    endif
    call GameTimeWait(0.25)
    call HasBanshees( GetTriggerUnit() )
    endif
endfunction

