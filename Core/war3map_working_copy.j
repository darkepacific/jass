//===========================================================================
// Trigger: Egg Sack Respawn
//===========================================================================
function Trig_Egg_Sack_Respawn_Actions takes nothing returns nothing
    local destructable d = GetDyingDestructable()

    // If some other destructable died in the region, ignore it.
    if GetDestructableTypeId(d) != 'B01H' then
        set d = null
        return
    endif

    call TriggerSleepAction(60.00)

    // Use the snapshotted handle, not the event response.
    call DestructableRestoreLife(d, 50.00, true)

    set d = null
endfunction

function InitTrig_Egg_Sack_Respawn takes nothing returns nothing
    set gg_trg_Egg_Sack_Respawn = CreateTrigger()
    call TriggerRegisterDestDeathInRegionEvent(gg_trg_Egg_Sack_Respawn, gg_rct_Z_Azurelode_Mine)
    call TriggerAddAction(gg_trg_Egg_Sack_Respawn, function Trig_Egg_Sack_Respawn_Actions)
endfunction

