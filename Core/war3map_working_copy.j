//===========================================================================
// Trigger: U SoE
//===========================================================================
function Trig_U_SoE_Func004C takes nothing returns boolean
    if ( not ( udg_QSoE0 < 2.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_U_SoE_Func005C takes nothing returns boolean
    if ( not ( udg_QSoE1 < 2.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_U_SoE_Func006C takes nothing returns boolean
    if ( not ( udg_QSoE2 < 1.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_U_SoE_Actions takes nothing returns nothing
                       if IsAllianceHero( GetTriggerUnit() ) then
    if ( Trig_U_SoE_Func004C() ) then
        set udg_ItemTypeCheck = 'I027'
        set udg_ItemQuestNumber = 48.10
        call TriggerExecute( gg_trg_ABag_Check )
    else
    endif
    if ( Trig_U_SoE_Func005C() ) then
        set udg_ItemTypeCheck = 'I03S'
        set udg_ItemQuestNumber = 48.20
        call TriggerExecute( gg_trg_ABag_Check )
    else
    endif
    if ( Trig_U_SoE_Func006C() ) then
        set udg_ItemTypeCheck = 'I03Z'
        set udg_ItemQuestNumber = 48.30
        call TriggerExecute( gg_trg_ABag_Check )
    else
    endif
    call QuestItemSetDescriptionBJ( udg_QuestReqs[48], ( "Obsidian Gems, Mammoth Horns, & a Magnituar's Javeline |n- " + ( R2SW(udg_QSoE0, 2, 0) + ( "/2.0                            " + ( R2SW(udg_QSoE1, 2, 0) + ( "/2.0                            " + ( R2SW(udg_QSoE2, 2, 0) + "/1.0" ) ) ) ) ) ) )
                       endif
endfunction

