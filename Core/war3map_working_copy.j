    set gg_trg_Arcane_Burst_5 = CreateTrigger(  )
    call DisableTrigger( gg_trg_Arcane_Burst_5 )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Arcane_Burst_5, EVENT_PLAYER_UNIT_ATTACKED )
    call TriggerAddCondition( gg_trg_Arcane_Burst_5, Condition( function Trig_Arcane_Burst_5_Conditions ) )
