function InitTrig_Death_and_Decay takes nothing returns nothing
    set gg_trg_Death_and_Decay = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Death_and_Decay, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Death_and_Decay, Condition( function Trig_Death_and_Decay_Conditions ) )
