//===========================================================================
// Trigger: Rejuvination
//===========================================================================
function Trig_Rejuvination_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A02Y' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Rejuvination_Func050Func003C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetSpellTargetUnit()) == 'e01D' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetSpellTargetUnit()) == 'e01F' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetSpellTargetUnit()) == 'e01G' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetSpellTargetUnit()) == 'e01H' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetSpellTargetUnit()) == 'e01K' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetSpellTargetUnit()) == 'e01L' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Rejuvination_Func050C takes nothing returns boolean
    if ( not Trig_Rejuvination_Func050Func003C() ) then
        return false
    endif
    return true
endfunction

function Trig_Rejuvination_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A02Y', udg_Temp_Unit) * 150 )
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 8.00 * udg_RealStatCalc )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    call ChaliceSet()
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 4 ]  then
    set udg_RealStatCalc = ( 1.20 * udg_RealStatCalc )
    endif
    // Flourish
    if udg_Temp_Unit == udg_yA_Bal_Druid or udg_Temp_Unit == udg_yH_Bal_Druid then
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 13 ]  then
    set udg_RealStatCalc = ( 1.25 * udg_RealStatCalc )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A02Y'), ABILITY_RLF_DURATION_HERO, ( GetUnitAbilityLevel(udg_Temp_Unit, GetSpellAbilityId()) - 1 ), 15.00 )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A02Y'), ABILITY_RLF_DURATION_HERO, ( GetUnitAbilityLevel(udg_Temp_Unit, GetSpellAbilityId()) - 1 ), 15.00 )
    call AddSpecialEffectTargetUnitBJ( "origin", GetSpellTargetUnit(), "war3mapImported\\AnimatedFlowerAv343.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "origin", GetSpellTargetUnit(), "war3mapImported\\AnimatedFlowerEv017.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    endif
    endif
    // Set Abil Stats
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A02Y'), ABILITY_RLF_HIT_POINTS_GAINED_REJ1, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), udg_RealStatCalc )
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 2 ]  then
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A02Y'), ABILITY_RLF_MANA_POINTS_GAINED_REJ2, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), ( 0.25 * udg_RealStatCalc ) )
    call AddSpecialEffectTargetUnitBJ( "overhead", GetSpellTargetUnit(), "Abilities\\Spells\\Items\\AIma\\AImaTarget.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    else
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A02Y'), ABILITY_RLF_MANA_POINTS_GAINED_REJ2, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), 0.00 )
    endif
    // Swiftmend
    if udg_Temp_Unit == udg_yA_Bal_Druid or udg_Temp_Unit == udg_yH_Bal_Druid then
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 10 ]  then
    if UnitHasBuffBJ( GetSpellTargetUnit(), 'B00D' ) then
    call CreateTextTagUnitBJ( "Swiftmend", GetSpellTargetUnit(), 10.00, 9.00, 20.00, 100.00, 0.00, 0 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64, 90.00 )
    call cleanUpText( 1.2, 0.8)
    call ShowTextTagForceBJ( true, GetLastCreatedTextTag(), GetPlayersAll() )
    call AddSpecialEffectTargetUnitBJ( "origin", GetSpellTargetUnit(), "war3mapImported\\Healing Touch.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "origin", GetSpellTargetUnit(), "Abilities\\Spells\\Undead\\Possession\\PossessionMissile.mdl" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 1.10 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "overhead", GetSpellTargetUnit(), "Abilities\\Weapons\\ProcMissile\\ProcMissile.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    	call SetUnitLifeBJ( GetSpellTargetUnit(), ( GetUnitState(GetSpellTargetUnit(), UNIT_STATE_LIFE) + udg_RealStatCalc * 0.2 ) )
    endif
    endif
    endif
    if ( Trig_Rejuvination_Func050C() ) then
        call BlzSetUnitWeaponRealFieldBJ( GetSpellTargetUnit(), UNIT_WEAPON_RF_ATTACK_BASE_COOLDOWN, 0, 0.90 )
        call BlzSetUnitRealFieldBJ( GetSpellTargetUnit(), UNIT_RF_SPEED, 330.00 )
    else
    endif
endfunction

//===========================================================================
function InitTrig_Rejuvination takes nothing returns nothing
    set gg_trg_Rejuvination = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Rejuvination, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Rejuvination, Condition( function Trig_Rejuvination_Conditions ) )
    call TriggerAddAction( gg_trg_Rejuvination, function Trig_Rejuvination_Actions )
endfunction

//===========================================================================
// Trigger: Entangling Roots
//===========================================================================
function Trig_Entangling_Roots_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A030' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Entangling_Roots_Func021A takes nothing returns nothing
    call Debug("Unit: " + I2S(udg_Temp_Int) + " " + GetUnitName(GetEnumUnit()) + " in EntRoots range" )
    if udg_Temp_Int < 3 then
    if IsUnitTargetableEnemyGround( GetEnumUnit(), udg_Temp_Unit2 ) then
    if UnitHasBuffBJ( GetEnumUnit(), 'BEer') == false then
    call IssueTargetOrderBJ( gg_unit_e028_1863, "entanglingroots", GetEnumUnit() )
    call HasFirelords( GetEnumUnit() )
    set udg_Temp_Int = udg_Temp_Int + 1
    endif
    endif
    endif
endfunction

function Trig_Entangling_Roots_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    call TriggerExecute( gg_trg_Firelords_Helper)
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A030', udg_Temp_Unit) * 10 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 5 )
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 1 ] == false then
    set udg_RealStatCalc = ( 0.50 * udg_RealStatCalc )
    endif
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A030'), ABILITY_RLF_DAMAGE_PER_SECOND_EER1, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), udg_RealStatCalc )
    // MassEntanglement
    if udg_Temp_Unit == udg_yA_Bal_Druid or udg_Temp_Unit == udg_yH_Bal_Druid then
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 11 ]  then
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(gg_unit_e028_1863, 'Aenr'), ABILITY_RLF_DAMAGE_PER_SECOND_EER1, 0, udg_RealStatCalc )
    call SetEntanglingRoots(udg_Temp_Unit)
    call SetUnitOwner( gg_unit_e028_1863, GetOwningPlayer(GetTriggerUnit()), true )
    set udg_Temp_Unit_Point = GetUnitLoc(GetSpellTargetUnit())
    set udg_Temp_Int = 0
    set udg_Temp_Unit2 = udg_Temp_Unit
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(300.00, udg_Temp_Unit_Point), function Trig_Entangling_Roots_Func021A )
    call RemoveLocation (udg_Temp_Unit_Point)
    endif
    endif
endfunction

//===========================================================================
function InitTrig_Entangling_Roots takes nothing returns nothing
    set gg_trg_Entangling_Roots = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Entangling_Roots, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Entangling_Roots, Condition( function Trig_Entangling_Roots_Conditions ) )
    call TriggerAddAction( gg_trg_Entangling_Roots, function Trig_Entangling_Roots_Actions )
endfunction

