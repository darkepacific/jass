    call TriggerAddCondition( gg_trg_Concussive_Shot, Condition( function Trig_Concussive_Shot_Conditions ) )
    call TriggerAddAction( gg_trg_Concussive_Shot, function Trig_Concussive_Shot_Actions )
endfunction

