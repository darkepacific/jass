    set gg_trg_Mind_Blast = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Mind_Blast, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Mind_Blast, Condition( function Trig_Mind_Blast_Conditions ) )
    call TriggerAddAction( gg_trg_Mind_Blast, function Trig_Mind_Blast_Actions )
endfunction

//===========================================================================
// Trigger: Shadowfiiend
//===========================================================================
function Trig_Shadowfiiend_Func005C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'n05F' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'n05G' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'n05H' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Shadowfiiend_Conditions takes nothing returns boolean
    if ( not Trig_Shadowfiiend_Func005C() ) then
        return false
    endif
    return true
endfunction

function Trig_Shadowfiiend_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetSummoningUnit()
    set udg_HeroStatCalc = ( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) * 2 )
    call BlzSetUnitWeaponIntegerFieldBJ( GetSummonedUnit(), UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 0, ( BlzGetUnitBaseDamage(GetSummonedUnit(), 0) + udg_HeroStatCalc ) )
    call SetUnitVertexColorBJ( GetSummonedUnit(), 100.00, 100.00, 100, 55.00 )
endfunction

//===========================================================================
function InitTrig_Shadowfiiend takes nothing returns nothing
    set gg_trg_Shadowfiiend = CreateTrigger(  )
