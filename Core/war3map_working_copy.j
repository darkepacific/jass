        else
        endif
        if ( Trig_Set_Hearths_Func004Func018C() ) then
            set udg_Hearthstones[udg_Player_Number] = 16
            set udg_TempString = "Tranquillien"
        else
        endif
        if ( Trig_Set_Hearths_Func004Func019C() ) then
            set udg_Hearthstones[udg_Player_Number] = 17
            set udg_TempString = "The Forsaken Front"
        else
        endif
        // 18 Open for Horde
        if ( Trig_Set_Hearths_Func004Func021C() ) then
            set udg_Hearthstones[udg_Player_Number] = 19
            set udg_TempString = "Dragonmaw Port"
        else
        endif
        if ( Trig_Set_Hearths_Func004Func022C() ) then
            set udg_Hearthstones[udg_Player_Number] = 20
