    if ( not ( udg_QDeedB_H < 1.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_U_BFF_H_Func006C takes nothing returns boolean
    if ( not ( udg_QDeedCD_H < 1.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_U_BFF_H_Func007C takes nothing returns boolean
    if ( not ( udg_QDeedSS_H < 1.00 ) ) then
