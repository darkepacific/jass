//===========================================================================
// Trigger: S Drunken Banshees H
//
// Create Quests for ALL players,
// Enable/Disable Quests for specific players
// Enable/Disabling quests does not cause desyncing.
//===========================================================================
function Trig_S_Drunken_Banshees_H_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
                       if IsHordeHero( GetTriggerUnit() ) then
    set udg_TempString = "Drunken Banshees"
    set udg_TempString_Quest = "Return 20 Aerie Ales to the dwarf."
    call TriggerExecute( gg_trg_Quest_Start_H )
    call DestroyEffectBJ( udg_QuestMarks[9] )
    // Icon
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Drunken_Banshees_1)
    call CampaignMinimapIconLocBJ( udg_Temp_Unit_Point, bj_CAMPPINGSTYLE_CONTROL_NEUTRAL )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_MiniMapIcon[9] = GetLastCreatedMinimapIcon()
    call SetMinimapIconVisible( udg_MiniMapIcon[9], false )
    set udg_TempString = ""
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    call QuestSetEnabledBJ( true, udg_Quests[9] )
    call FlashQuestDialogButtonBJ(  )
    call SetMinimapIconVisible( udg_MiniMapIcon[9], true )
    set udg_TempString = udg_QuestionMark
    endif
    call AddSpecialEffectTargetUnitBJ( "overhead", gg_unit_H00K_0269, udg_TempString )
    call QuestSetCompletedBJ( udg_Quests[9], false )
    call CreateQuestItemBJ( udg_Quests[9], "TRIGSTR_4623" )
    set udg_QuestReqs[9] = GetLastCreatedQuestItemBJ()
    set udg_QuestMarks[9] = GetLastCreatedEffectBJ()
    call DisableTrigger( GetTriggeringTrigger() )
    call EnableTrigger( gg_trg_U_Drunken_Banshees_H )
    call EnableTrigger( gg_trg_E_Drunken_Banshees_H )
                       endif
    set udg_Temp_Unit_Point = null
endfunction

