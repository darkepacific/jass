    set gg_trg_U_SNS = CreateTrigger(  )
    call DisableTrigger( gg_trg_U_SNS )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_U_SNS, EVENT_PLAYER_UNIT_SPELL_CAST )
