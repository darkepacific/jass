    call SetUnitInvulnerable( gg_unit_H00M_0977, true )
    call SetUnitColor( gg_unit_H00K_0269, PLAYER_COLOR_YELLOW )
    call SetUnitInvulnerable( gg_unit_Hpal_0558, true )
    call SetUnitColor( gg_unit_h002_0184, PLAYER_COLOR_PURPLE )
    call SetUnitColor( gg_unit_h01E_1432, PLAYER_COLOR_BLUE )
    call SetUnitColor( gg_unit_Ekgg_0715, PLAYER_COLOR_ORANGE )
    call SetUnitColor( gg_unit_Otch_1369, PLAYER_COLOR_COAL )
    call SetUnitInvulnerable( gg_unit_Otch_1369, true )
