//===========================================================================
// Trigger: E TOBB H
//
// Change to Fel's Essence
//===========================================================================
function Trig_E_TOBB_H_Func005Func001C takes nothing returns boolean
    if ( not ( GetItemTypeId(udg_P_Items[( udg_Bag_Num + udg_Bag_Iterator )]) == udg_ItemTypeCheck ) ) then
        return false
    endif
    return true
endfunction

function Trig_E_TOBB_H_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 71
                       if IsHordeHero( GetTriggerUnit() ) then
    call SetBagNumber( GetOwningPlayer(GetTriggerUnit()) )
    set udg_ItemTypeCheck = 'I07M'
    set udg_Bag_Iterator = 1
    loop
        exitwhen udg_Bag_Iterator > udg_BAG_LOOP_MAX
        if ( Trig_E_TOBB_H_Func005Func001C() ) then
            if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
            call FlashQuestDialogButtonBJ(  )
            endif
            call RemoveItem( GetLastRemovedItem() )
            call DestroyEffectBJ( udg_QuestMarks[71] )
            call QuestSetCompletedBJ( udg_Quests[71], true )
            call QuestItemSetCompletedBJ( udg_QuestReqs[71], true )
            call DestroyMinimapIcon( udg_MiniMapIcon[71] )
            // Clean Up Items
            call CleanUpItems( udg_ItemTypeCheck )
            // Rewards
            set udg_XP = udg_QUEST_XP[udg_Temp_Int]
            set udg_Gold = udg_QUEST_GOLD[udg_Temp_Int]
            set udg_LVL_Req = udg_QUEST_LVL_REQ[udg_Temp_Int]
            set udg_TempString = "The Other Barov Brother"
            call TriggerExecute( gg_trg_Quest_Complete_H )
            call DisableTrigger( GetTriggeringTrigger() )
            call DisableTrigger( gg_trg_U_TOBB_H )
            call DisableTrigger( gg_trg_U_TOBB_Acq_H )
        else
        endif
        set udg_Bag_Iterator = udg_Bag_Iterator + 1
    endloop
                       endif
endfunction

