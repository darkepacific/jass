    call TriggerAddAction( gg_trg_AoE_Fear, function Trig_AoE_Fear_Actions )
endfunction

//===========================================================================
// Trigger: FearWander
//===========================================================================
function IsUnitFearable takes unit u returns boolean
    return not IsUnitType(u, UNIT_TYPE_MAGIC_IMMUNE) and UnitHasBuffBJ(u, 'B00Q')
endfunction

function Trig_FearWander_Safe takes nothing returns nothing
    local group g = CreateGroup()
    local unit u
    local location loc

    // Copy units to a temp group to avoid modifying while iterating
    call GroupAddGroup(udg_FearedUnits, g)

    loop
        set u = FirstOfGroup(g)
        exitwhen u == null
        call GroupRemoveUnit(g, u)

        if IsUnitFearable(u) and IsUnitAliveBJ(u) then
            // Wander to random point
            call IssueImmediateOrder(u, "stop")
            set loc = GetRandomLocInRect(GetPlayableMapRect())
            call IssuePointOrderLoc(u, "move", loc)
            call RemoveLocation(loc)
        else
            // Stop unit and remove from main group
            call IssueImmediateOrder(u, "stop")
            call GroupRemoveUnitSimple(u, udg_FearedUnits)
        endif
    endloop

    call DestroyGroup(g)

    // Disable if no feared units remain
    if CountUnitsInGroup(udg_FearedUnits) == 0 then
        call DisableTrigger(gg_trg_FearWander)
    endif
endfunction

//===========================================================================

function InitTrig_FearWander takes nothing returns nothing
    set gg_trg_FearWander = CreateTrigger()
    call DisableTrigger(gg_trg_FearWander)
    call TriggerRegisterTimerEventPeriodic(gg_trg_FearWander, 0.15)
    call TriggerAddAction(gg_trg_FearWander, function Trig_FearWander_Safe)
endfunction
//===========================================================================
// Trigger: PICK EVERY UNIT IN RECT
//
// TAKES
// Length, Width, Temp_Unit_Point, and Facing_Angle
// RETURNS A UNIT GROUP THAT CONTAINS ALL UNITS
//===========================================================================
function Trig_PICK_EVERY_UNIT_IN_RECT_Func005Func004Func001Func001Func001C takes nothing returns boolean
    if ( not ( udg_Temp_Angle <= 180.00 ) ) then
        return false
    endif
    if ( not ( udg_Temp_Angle > ( 180.00 - udg_Tau ) ) ) then
        return false
    endif
    if ( not ( DistanceBetweenPoints(udg_Temp_Unit_Point, udg_Temp_X_Point) <= ( ( udg_Width / 2.00 ) / CosBJ(( 180.00 - udg_Temp_Angle )) ) ) ) then
        return false
    endif
    return true
endfunction

function Trig_PICK_EVERY_UNIT_IN_RECT_Func005Func004Func001Func001C takes nothing returns boolean
    if ( not ( udg_Temp_Angle <= ( 180.00 - udg_Tau ) ) ) then
        return false
    endif
    if ( not ( udg_Temp_Angle > 90.00 ) ) then
        return false
    endif
    if ( not ( DistanceBetweenPoints(udg_Temp_Unit_Point, udg_Temp_X_Point) <= ( udg_Length / CosBJ(( udg_Temp_Angle - 90.00 )) ) ) ) then
        return false
    endif
    return true
endfunction

function Trig_PICK_EVERY_UNIT_IN_RECT_Func005Func004Func001C takes nothing returns boolean
    if ( not ( udg_Temp_Angle <= 90.00 ) ) then
        return false
    endif
    if ( not ( udg_Temp_Angle > udg_Tau ) ) then
        return false
    endif
    if ( not ( DistanceBetweenPoints(udg_Temp_Unit_Point, udg_Temp_X_Point) <= ( udg_Length / CosBJ(( 90.00 - udg_Temp_Angle )) ) ) ) then
        return false
    endif
    return true
endfunction

function Trig_PICK_EVERY_UNIT_IN_RECT_Func005Func004C takes nothing returns boolean
    if ( not ( udg_Temp_Angle <= udg_Tau ) ) then
        return false
    endif
    if ( not ( udg_Temp_Angle >= 0.00 ) ) then
        return false
    endif
    if ( not ( DistanceBetweenPoints(udg_Temp_Unit_Point, udg_Temp_X_Point) <= ( ( udg_Width / 2.00 ) / CosBJ(udg_Temp_Angle) ) ) ) then
        return false
    endif
    return true
endfunction

function Trig_PICK_EVERY_UNIT_IN_RECT_Func005A takes nothing returns nothing
    set udg_Temp_X_Point = GetUnitLoc(GetEnumUnit())
    set udg_Temp_Angle = AngleBetweenPoints(udg_Temp_Unit_Point, udg_Temp_X_Point)
    set udg_Temp_Angle = ModuloReal(( udg_Temp_Angle - ( udg_Facing_Angle - 90.00 ) ), 360.00)
    if ( Trig_PICK_EVERY_UNIT_IN_RECT_Func005Func004C() ) then
        call GroupAddUnitSimple( GetEnumUnit(), udg_UnitsInRect )
    else
        if ( Trig_PICK_EVERY_UNIT_IN_RECT_Func005Func004Func001C() ) then
            call GroupAddUnitSimple( GetEnumUnit(), udg_UnitsInRect )
        else
            if ( Trig_PICK_EVERY_UNIT_IN_RECT_Func005Func004Func001Func001C() ) then
                call GroupAddUnitSimple( GetEnumUnit(), udg_UnitsInRect )
            else
                if ( Trig_PICK_EVERY_UNIT_IN_RECT_Func005Func004Func001Func001Func001C() ) then
                    call GroupAddUnitSimple( GetEnumUnit(), udg_UnitsInRect )
                else
                endif
            endif
        endif
    endif
    call RemoveLocation (udg_Temp_X_Point)
endfunction

function Trig_PICK_EVERY_UNIT_IN_RECT_Actions takes nothing returns nothing
    call GroupClear( udg_UnitsInRect )
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, ( udg_Length / 2.00 ), udg_Facing_Angle)
    set udg_Tau = Atan2BJ(udg_Length, ( udg_Width / 2.00 ))
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(( SquareRoot(( Pow(udg_Length, 2.00) + Pow(udg_Width, 2.00) )) / 2.00 ), udg_Temp_Polar_Point), function Trig_PICK_EVERY_UNIT_IN_RECT_Func005A )
    call RemoveLocation (udg_Temp_Polar_Point)
endfunction

