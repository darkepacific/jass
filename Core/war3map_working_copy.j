//===========================================================================
// Trigger: S GMV
//
// Need to change this to team wide display.
//===========================================================================
function Trig_S_GMV_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
                       if IsHordeHero( GetTriggerUnit() ) then
    set udg_TempString = "Goldenmist Village"
    set udg_TempString_Quest = "Kill 4 Quel'dorei Wraiths and 4 Crypt Fiends in Goldenmist Village"
    call TriggerExecute( gg_trg_Quest_Start_H )
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    call QuestSetEnabledBJ( true, udg_Quests[107] )
    call FlashQuestDialogButtonBJ(  )
    endif
    call DestroyEffectBJ( udg_QuestMarks[107] )
    call QuestSetCompletedBJ( udg_Quests[107], false )
    call CreateQuestItemBJ( udg_Quests[107], "TRIGSTR_1640" )
    set udg_QuestReqs[107] = GetLastCreatedQuestItemBJ()
    call QuestItemSetDescriptionBJ( udg_QuestReqs[107], ( "Quel'dorei Wraiths Slain - " + ( I2S(R2I(udg_QuestGMVWraiths)) + ( "/4" + ( "|n- Crypt Fiends Slain - " + ( I2S(R2I(udg_QuestGMVCryptfiend)) + "/4" ) ) ) ) ) )
    // Icon
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Goldenmist_Village)
    call CampaignMinimapIconLocBJ( udg_Temp_Unit_Point, bj_CAMPPINGSTYLE_CONTROL_NEUTRAL )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_MiniMapIcon[107] = GetLastCreatedMinimapIcon()
    if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
    call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), false )
    endif
    call DisableTrigger( GetTriggeringTrigger() )
    call EnableTrigger( gg_trg_U_GMV)
    call EnableTrigger( gg_trg_E_GMV)
                       endif
    set udg_Temp_Unit_Point = null
endfunction

