function Trig_U_SNS_Func009C takes nothing returns boolean
    if ( not ( udg_RealStatCalc >= 1.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_U_SNS_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    local location udg_Temp_Polar_Point
                       if IsHordeHero( GetTriggerUnit() ) then
    set udg_RealStatCalc = 0.00
    if ( Trig_U_SNS_Func005C() ) then
        set udg_RealStatCalc = 1000.00
        set udg_QuestSentinelsRevealed_Total =  udg_QuestSentinelsRevealed_Total + 1
    else
    endif
    if ( Trig_U_SNS_Func006C() ) then
        set udg_RealStatCalc = 100.00
        set udg_QuestSentinelsRevealed_Total =  udg_QuestSentinelsRevealed_Total + 1
    else
    endif
    if ( Trig_U_SNS_Func007C() ) then
        set udg_RealStatCalc = 10.00
        set udg_QuestSentinelsRevealed_Total =  udg_QuestSentinelsRevealed_Total + 1
    else
    endif
    if ( Trig_U_SNS_Func008C() ) then
        set udg_RealStatCalc = 1.00
        set udg_QuestSentinelsRevealed_Total =  udg_QuestSentinelsRevealed_Total + 1
    else
    endif
    if ( Trig_U_SNS_Func009C() ) then
        set udg_QuestSentinelsRevealed = ( udg_QuestSentinelsRevealed + udg_RealStatCalc )
        call QuestItemSetDescriptionBJ( udg_QuestReqs[126], ( "Sentinels Found - " + ( I2S(udg_QuestSentinelsRevealed_Total) + "/4" ) ) )
        call CreateTextTagUnitBJ( "TRIGSTR_10937", GetTriggerUnit(), 0.00, 9.00, 80.00, 20.00, 100.00, 0 )
        call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
        call cleanUpText(1.2, 0.85)
        set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
        set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, GetRandomReal(120.00, 160.00), GetRandomDirectionDeg())
        call CreateNUnitsAtLoc( 1, 'esen', Player(1), udg_Temp_Polar_Point, GetRandomDirectionDeg() )
        call RemoveLocation (udg_Temp_Unit_Point)
        call RemoveLocation (udg_Temp_Polar_Point)
    else
        // If they are not in any of the key regions, check if they are in the ghostlands
        // if not in ghostlands throw and error
        set udg_Player_Number = HeroesNumb(GetTriggerPlayer())
        if ( Trig_U_SNS_Func009Func005C() ) then
            call ErrorMessage("Must be in Ghostlands to use this item.", GetTriggerPlayer() )
            call IssueImmediateOrderBJ( GetTriggerUnit(), "stop" )
        else
            if ( Trig_U_SNS_Func009Func005Func001C() ) then
                call QuestPingRectCenterForPlayer(GetOwningPlayer(GetTriggerUnit()), gg_rct_Sentinel_Spies_4)
            else
            endif
            if ( Trig_U_SNS_Func009Func005Func002C() ) then
                call QuestPingRectCenterForPlayer(GetOwningPlayer(GetTriggerUnit()), gg_rct_Sentinel_Spies_3)
            else
            endif
            if ( Trig_U_SNS_Func009Func005Func003C() ) then
                call QuestPingRectCenterForPlayer(GetOwningPlayer(GetTriggerUnit()), gg_rct_Sentinel_Spies_2)
            else
            endif
            if ( Trig_U_SNS_Func009Func005Func004C() ) then
                call QuestPingRectCenterForPlayer(GetOwningPlayer(GetTriggerUnit()), gg_rct_Sentinel_Spies_1)
            else
            endif
        endif
    endif
                       else
    call ErrorMessage("This is a Horde quest item.", GetTriggerPlayer() )
                       endif
    set udg_Temp_Polar_Point = null
    set udg_Temp_Unit_Point = null
endfunction

