    call TriggerRegisterTimerEventPeriodic( gg_trg_Blizzard_Tick_A, 0.75 )
    call TriggerAddAction( gg_trg_Blizzard_Tick_A, function Trig_Blizzard_Tick_A_Actions )
endfunction

