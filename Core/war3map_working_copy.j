        return false
    endif
    return true
endfunction

function Trig_Soul_Drain_Func002C takes nothing returns boolean
    if ( not ( GetTriggerUnit() == udg_yA_Demon_Warlock ) ) then
        return false
    endif
    return true
endfunction

function Trig_Soul_Drain_Func003C takes nothing returns boolean
    if ( not ( GetTriggerUnit() == udg_yH_Demon_Warlock ) ) then
        return false
    endif
    return true
endfunction

function Trig_Soul_Drain_Actions takes nothing returns nothing
    call PlaySoundOnUnitBJ( gg_snd_LifeDrain, 75.00, GetSpellAbilityUnit() )
    if ( Trig_Soul_Drain_Func002C() ) then
        set udg_o = ( udg_z_WL_DEMO_A + 4 )
        set udg_SpellUnits[udg_o] = GetSpellTargetUnit()
        call EnableTrigger( gg_trg_Soul_Drain_Tick_WG )
        call EnableTrigger( gg_trg_Soul_Drain_Dies )
    else
    endif
    if ( Trig_Soul_Drain_Func003C() ) then
        set udg_o = ( udg_z_WL_DEMO_H + 4 )
        set udg_SpellUnits[udg_o] = GetSpellTargetUnit()
        call EnableTrigger( gg_trg_Soul_Drain_Tick_UD )
        call EnableTrigger( gg_trg_Soul_Drain_Dies )
    else
    endif
endfunction

