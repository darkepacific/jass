function InitTrig_Monk_Dies takes nothing returns nothing
    set gg_trg_Monk_Dies = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Monk_Dies, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddAction( gg_trg_Monk_Dies, function Trig_Monk_Dies_Actions )
endfunction

//===========================================================================
// Trigger: Meditate
//===========================================================================
function Trig_Meditate_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A09F' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Meditate_Func014Func001C takes nothing returns boolean
    if ( not ( IsUnitEnemy(GetEnumUnit(), GetOwningPlayer(GetTriggerUnit())) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Meditate_Func014A takes nothing returns nothing
    if ( Trig_Meditate_Func014Func001C() ) then
        call IssueTargetOrderBJ( GetEnumUnit(), "attack", udg_Temp_Unit )
        call AddSpecialEffectTargetUnitBJ( "overhead", GetEnumUnit(), "Abilities\\Spells\\Other\\TalkToMe\\TalkToMe.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    else
    endif
endfunction

function Trig_Meditate_Actions takes nothing returns nothing
    call PlaySoundOnUnitBJ( gg_snd_SPELL_MK_DRINKBUFF_01, 88.00, GetTriggerUnit() )
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A09F', udg_Temp_Unit) * 90 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 60 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + 0.00 )
    call ChaliceSet()
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A09F'), ABILITY_RLF_LIFE_HEALED, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), udg_RealStatCalc )
    // Provoke
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer( GetTriggerUnit() )) * udg_NUM_OF_TC + 5 ] then 
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
    call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "Abilities\\Spells\\NightElf\\Taunt\\TauntCaster.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(500.00, udg_Temp_Unit_Point), function Trig_Meditate_Func014A )
    call RemoveLocation (udg_Temp_Unit_Point)
    endif
    // Breathe in Breath Out
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer( GetTriggerUnit() )) * udg_NUM_OF_TC + 12 ] then 
    if (GetTriggerUnit() == udg_yA_Brew_Monk) then
    call EnableTrigger( gg_trg_Breathe_in_Breathe_Out_A)
    elseif (GetTriggerUnit() == udg_yH_Brew_Monk) then
    call EnableTrigger( gg_trg_Breathe_in_Breathe_Out_H)
    endif
    call GameTimeWait(3.3)
    if (GetTriggerUnit() == udg_yA_Brew_Monk) then
    call DisableTrigger( gg_trg_Breathe_in_Breathe_Out_A)
    elseif (GetTriggerUnit() == udg_yH_Brew_Monk) then
    call DisableTrigger( gg_trg_Breathe_in_Breathe_Out_H)
    endif
    endif
endfunction

//===========================================================================
function InitTrig_Meditate takes nothing returns nothing
    set gg_trg_Meditate = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Meditate, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Meditate, Condition( function Trig_Meditate_Conditions ) )
    call TriggerAddAction( gg_trg_Meditate, function Trig_Meditate_Actions )
endfunction

