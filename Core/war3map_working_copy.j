    set udg_Temp_Unit = GetTriggerUnit()
    if udg_Temp_Unit == udg_yA_Frost_Mage then
    set udg_Blizzard[0] = GetSpellTargetLoc()
    call EnableTrigger( gg_trg_Blizzard_Tick_A )
    elseif udg_Temp_Unit == udg_yH_Frost_Mage then
    set udg_Blizzard[1] = GetSpellTargetLoc()
    call EnableTrigger( gg_trg_Blizzard_Tick_H )
    endif
endfunction

