//===========================================================================
// Trigger: Dragon Roar
//===========================================================================
function Trig_Dragon_Roar_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A07U' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dragon_Roar_Actions takes nothing returns nothing
    local effect eff
    local player udg_X_Player_MUI = GetTriggerPlayer()
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Dragon Fire.mdx" )
    call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 2.25 )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), Deg2Rad(GetUnitFacing(GetTriggerUnit())), 0.00, 0.00 )
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), ( 150.00 + BlzGetLocalUnitZ(GetTriggerUnit()) ) )
    call BlzPlaySpecialEffect( GetLastCreatedEffectBJ(), ANIM_TYPE_STAND )
    call RemoveLocation (udg_Temp_Unit_Point)
    set eff = GetLastCreatedEffectBJ()
    call UnitAddAbilityBJ( 'A0DD', GetTriggerUnit() )
    call SetUnitAbilityLevelSwapped( 'A0DD', GetTriggerUnit(), GetUnitAbilityLevelSwapped('A07U', GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'A07U', udg_X_Player_MUI )
    call GameTimeWait(0.5)
    call DestroyEffectBJ( eff )
    call GameTimeWait(4.2)
    call SetPlayerAbilityAvailableBJ( true, 'A07U', udg_X_Player_MUI )
    call UnitRemoveAbilityBJ( 'A0DD', GetTriggerUnit() )
    set udg_X_Player_MUI = null
    set eff = null
endfunction

