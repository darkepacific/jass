//===========================================================================
// Trigger: Firey Brand
//===========================================================================
function Trig_Firey_Brand_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0G0' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Firey_Brand_Actions takes nothing returns nothing
    local unit udg_Temp_Unit = GetTriggerUnit()
    if udg_Temp_Unit == udg_yA_Demon_Hunt then
    set udg_o = udg_z_DH_VENG_A
    set udg_FieryBrandA = 10.00
    else
    set udg_o = udg_z_DH_VENG_H
    set udg_FieryBrandH = 10.00
    endif
    set udg_o = ( udg_o + 4 )
    set udg_SpellUnits[udg_o] = GetSpellTargetUnit()
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 2.00 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A0G0', udg_Temp_Unit) * 55 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 55 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A0G0'), ABILITY_RLF_PRIMARY_DAMAGE, ( GetUnitAbilityLevel( udg_Temp_Unit,'A0G0') - 1 ), udg_RealStatCalc )
    call GameTimeWait(0.15)
    if udg_Temp_Unit == udg_yA_Demon_Hunt then
    call EnableTrigger( gg_trg_Fiery_Brand_A )
    else
    call EnableTrigger( gg_trg_Fiery_Brand_H )
    endif
    set udg_Temp_Unit = null
    // ___
    return
    call AddSpecialEffectTargetUnitBJ( "origin", GetSpellTargetUnit(), "war3mapImported\\FireyBrand.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
endfunction

//===========================================================================
function InitTrig_Firey_Brand takes nothing returns nothing
    set gg_trg_Firey_Brand = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Firey_Brand, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Firey_Brand, Condition( function Trig_Firey_Brand_Conditions ) )
    call TriggerAddAction( gg_trg_Firey_Brand, function Trig_Firey_Brand_Actions )
endfunction

//===========================================================================
// Trigger: Fiery Brand A
//===========================================================================
function Trig_Fiery_Brand_A_Func001C takes nothing returns boolean
    if ( ( UnitHasBuffBJ(udg_SpellUnits[( udg_z_DH_VENG_A + 4 )], 'B03C') == false ) ) then
        return true
    endif
    if ( ( IsUnitDeadBJ(udg_SpellUnits[( udg_z_DH_VENG_A + 4 )]) == true ) ) then
        return true
    endif
    return false
endfunction

function Trig_Fiery_Brand_A_Conditions takes nothing returns boolean
    if ( not Trig_Fiery_Brand_A_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Fiery_Brand_A_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    set udg_Temp_Unit = udg_yA_Demon_Hunt
    set udg_o = udg_z_DH_VENG_A
    set udg_o = ( udg_o + 4 )
    call SetUnitAbilityLevel( gg_unit_e03G_2001, 'A0BF', 43 )
    				call IssueTargetOrder( gg_unit_e03G_2001, "innerfire", udg_Temp_Unit )
    call NewShield( udg_Temp_Unit, udg_FieryBrandA, 99 )
endfunction

