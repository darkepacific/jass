//===========================================================================
// Trigger: AnitMagic Shell No Target
//
// Calc distance in tics
//===========================================================================
function Trig_AnitMagic_Shell_No_Target_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0F9' ) ) then
        return false
    endif
    return true
endfunction

function Trig_AnitMagic_Shell_No_Target_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 6.00 * udg_RealStatCalc )
    set udg_HeroStatCalc = 400
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    call CreateNUnitsAtLoc( 1, 'e00W', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, GetUnitFacing(GetTriggerUnit()) )
    call RemoveLocation (udg_Temp_Unit_Point)
     call UnitApplyTimedLife( GetLastCreatedUnit(),'BTLF', 1.0)
    set udg_Temp_Unit = GetLastCreatedUnit()
    call BlzSetAbilityIntegerLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A03O'), ABILITY_ILF_SHIELD_LIFE, 0, R2I(udg_RealStatCalc) )
    call IssueTargetOrderBJ( udg_Temp_Unit, "antimagicshell", GetTriggerUnit() )
endfunction

//===========================================================================
function InitTrig_AnitMagic_Shell_No_Target takes nothing returns nothing
    set gg_trg_AnitMagic_Shell_No_Target = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_AnitMagic_Shell_No_Target, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_AnitMagic_Shell_No_Target, Condition( function Trig_AnitMagic_Shell_No_Target_Conditions ) )
