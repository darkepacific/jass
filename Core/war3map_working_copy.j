function InitTrig_Death_Set_Horde takes nothing returns nothing
    set gg_trg_Death_Set_Horde = CreateTrigger(  )
    call TriggerAddAction( gg_trg_Death_Set_Horde, function Trig_Death_Set_Horde_Actions )
endfunction

//===========================================================================
// Trigger: Zone XP Trigger
//
// HeroStatCalc = sets the loop iteration
// RealStatCalc = used as a boolean
//===========================================================================
function Trig_Zone_XP_Trigger_Func004Func001C takes nothing returns boolean
    if ( not ( GetHeroLevel(GetTriggerUnit()) == udg_Temp_Int ) ) then
        return false
    endif
    return true
endfunction

function Trig_Zone_XP_Trigger_Func005C takes nothing returns boolean
    if ( not ( GetHeroLevel(GetTriggerUnit()) < udg_Temp_Int ) ) then
        return false
    endif
    return true
endfunction

function Trig_Zone_XP_Trigger_Actions takes nothing returns nothing
    call ForceAddPlayerSimple( udg_X_Player_MUI, udg_Player_Message_Group )
    call ForceRemovePlayerSimple( udg_X_Player_MUI, udg_Player_Message_Group )
    set udg_HeroStatCalc = 0
    set bj_forLoopAIndex = udg_HeroStatCalc
    set bj_forLoopAIndexEnd = ( udg_HeroStatCalc + 3 )
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_Zone_XP_Trigger_Func004Func001C() ) then
            set udg_RealStatCalc = 1.00
            exitwhen true
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    if ( Trig_Zone_XP_Trigger_Func005C() ) then
        call QuestMessageBJ( udg_Player_Message_Group, bj_QUESTMESSAGE_WARNING, "TRIGSTR_3561" )
        call SuspendHeroXPBJ( false, udg_Heroes[udg_Player_Number] )
    else
        call QuestMessageBJ( udg_Player_Message_Group, bj_QUESTMESSAGE_WARNING, "TRIGSTR_3563" )
        call SuspendHeroXPBJ( true, udg_Heroes[udg_Player_Number] )
    endif
endfunction

//===========================================================================
function InitTrig_Zone_XP_Trigger takes nothing returns nothing
    set gg_trg_Zone_XP_Trigger = CreateTrigger(  )
    call TriggerAddAction( gg_trg_Zone_XP_Trigger, function Trig_Zone_XP_Trigger_Actions )
endfunction

//===========================================================================
// Trigger: Dalaran Enter
//===========================================================================
function Trig_Dalaran_Enter_Func001C takes nothing returns boolean
    if ( ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'u01A' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'u013' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'u005' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Dalaran_Enter_Conditions takes nothing returns boolean
    if ( not Trig_Dalaran_Enter_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Dalaran_Enter_Func003Func001Func001C takes nothing returns boolean
    if ( ( GetTriggerUnit() == udg_Heroes[GetForLoopIndexA()] ) ) then
        return true
    endif
    if ( ( GetTriggerUnit() == udg_FP_Bats_n_Gryphons[GetForLoopIndexA()] ) ) then
        return true
    endif
    return false
endfunction

function Trig_Dalaran_Enter_Func003Func001C takes nothing returns boolean
    if ( not Trig_Dalaran_Enter_Func003Func001Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Dalaran_Enter_Func004C takes nothing returns boolean
    if ( not ( udg_Player_Music[udg_Player_Number] != "Dalaran" ) ) then
        return false
    endif
    if ( not ( udg_Player_Number != 11 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dalaran_Enter_Actions takes nothing returns nothing
    set udg_Player_Number = 11
    set bj_forLoopAIndex = 0
    set bj_forLoopAIndexEnd = 7
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_Dalaran_Enter_Func003Func001C() ) then
            set udg_Player_Number = GetForLoopIndexA()
            exitwhen true
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    if ( Trig_Dalaran_Enter_Func004C() ) then
        if GetLocalPlayer() == GetOwningPlayer(GetTriggerUnit()) then
        call ClearMapMusicBJ(  )
        call StopMusicBJ( false )
        call EndThematicMusicBJ(  )
        call PlayMusicBJ( gg_snd_Dalaran_3 )
        endif
        set udg_Player_Music[udg_Player_Number] = "Dalaran"
        call PlayerEntersLocation( GetOwningPlayer(GetTriggerUnit()), "Dalaran", 2)
    else
    endif
endfunction

//===========================================================================
function InitTrig_Dalaran_Enter takes nothing returns nothing
    set gg_trg_Dalaran_Enter = CreateTrigger(  )
    call TriggerRegisterEnterRectSimple( gg_trg_Dalaran_Enter, gg_rct_Z_Dalaran_City )
    call TriggerAddCondition( gg_trg_Dalaran_Enter, Condition( function Trig_Dalaran_Enter_Conditions ) )
    call TriggerAddAction( gg_trg_Dalaran_Enter, function Trig_Dalaran_Enter_Actions )
endfunction

