    if ( not Trig_E_BFF_A_Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_E_BFF_A_Func023C takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_Quests[74]) == true ) ) then
        return false
    endif
    if ( not ( IsQuestCompleted(udg_Quests[73]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_E_BFF_A_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 74
    if IsAlliancePlayer( GetLocalPlayer() ) then
    call FlashQuestDialogButtonBJ(  )
    endif
    call DestroyEffectBJ( udg_QuestMarks[udg_Temp_Int] )
    call QuestSetCompletedBJ( udg_Quests[udg_Temp_Int], true )
    call QuestItemSetCompletedBJ( udg_QuestReqs[udg_Temp_Int], true )
    call DestroyMinimapIcon( udg_MiniMapIcon[udg_Temp_Int] )
    // Rewards
    set udg_XP = udg_QUEST_XP[udg_Temp_Int]
    set udg_Gold = udg_QUEST_GOLD[udg_Temp_Int]
    set udg_LVL_Req = udg_QUEST_LVL_REQ[udg_Temp_Int]
    set udg_TempString = "Barov Family Fortune"
    call TriggerExecute( gg_trg_Quest_Complete_A )
    // Triggers
    call DisableTrigger(gg_trg_U_BFF_A)
    call DisableTrigger(gg_trg_H_BFF_A)
    call DisableTrigger( GetTriggeringTrigger() )
    if ( Trig_E_BFF_A_Func023C() ) then
        set udg_ItemTypeCheck = 'I07K'
        call CleanUpItems( udg_ItemTypeCheck )
        set udg_ItemTypeCheck = 'I07J'
        call CleanUpItems( udg_ItemTypeCheck )
        set udg_ItemTypeCheck = 'I07L'
        call CleanUpItems( udg_ItemTypeCheck )
        call DisableTrigger(gg_trg_D_BFF)
    else
    endif
    call GameTimeWait(0.8)
    call TriggerExecute(gg_trg_M_TOBB_A)
endfunction

//===========================================================================
function InitTrig_E_BFF_A takes nothing returns nothing
    set gg_trg_E_BFF_A = CreateTrigger(  )
    call DisableTrigger( gg_trg_E_BFF_A )
    call TriggerRegisterVariableEvent( gg_trg_E_BFF_A, "udg_QDeedB_A", GREATER_THAN_OR_EQUAL, 1.00 )
    call TriggerRegisterVariableEvent( gg_trg_E_BFF_A, "udg_QDeedCD_A", GREATER_THAN_OR_EQUAL, 1.00 )
    call TriggerRegisterVariableEvent( gg_trg_E_BFF_A, "udg_QDeedSS_A", GREATER_THAN_OR_EQUAL, 1.00 )
    call TriggerAddCondition( gg_trg_E_BFF_A, Condition( function Trig_E_BFF_A_Conditions ) )
    call TriggerAddAction( gg_trg_E_BFF_A, function Trig_E_BFF_A_Actions )
endfunction

