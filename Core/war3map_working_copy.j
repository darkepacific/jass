    set gg_trg_KilJaeden_Oblivion = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_KilJaeden_Oblivion, EVENT_PLAYER_UNIT_DAMAGED )
    call TriggerAddCondition( gg_trg_KilJaeden_Oblivion, Condition( function Trig_KilJaeden_Oblivion_Conditions ) )
    call TriggerAddAction( gg_trg_KilJaeden_Oblivion, function Trig_KilJaeden_Oblivion_Actions )
endfunction

//===========================================================================
// Trigger: Shadowbolt Volley KJ
//===========================================================================
function Trig_Shadowbolt_Volley_KJ_Conditions takes nothing returns boolean
    if ( not ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) < 8500.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Shadowbolt_Volley_KJ_Actions takes nothing returns nothing
    local unit u = gg_unit_Nkjx_2318
    call DisableTrigger( GetTriggeringTrigger() )
    if RectContainsUnit( gg_rct_Sunwell_Plateau,  GetEventDamageSource() ) then
    call DisableTrigger( gg_trg_KilJaeden_Oblivion)
    call SetUnitFacingToDamageSource(u)
    set udg_WitheringShots_K = 111
    call EnableTrigger( gg_trg_Shadowbolt_Volley_KJ_Tick)
    call PlaySoundOnUnitBJ( gg_snd_KilJaeden_Chaos, 100.00, GetTriggerUnit() )
    call BlzSetUnitAttackCooldown( u, 6.00, 0) 
    call BlzSetUnitAttackCooldown( u, 6.00, 1) 
    call GameTimeWait(2.7)
    call BlzSetUnitAttackCooldown( u, 1.60, 0) 
    call BlzSetUnitAttackCooldown( u, 2.13, 1) 
    call IssueImmediateOrder( u, "stop")
    call IssueImmediateOrder( u, "holdposition")

    call IssuePointOrder(u, "attack", GetUnitX(u), GetUnitY(u))

    call TriggerSleepAction( 5.00 )
    call EnableTrigger( gg_trg_KilJaeden_Oblivion)
    endif
    set u = null
endfunction

//===========================================================================
function InitTrig_Shadowbolt_Volley_KJ takes nothing returns nothing
    set gg_trg_Shadowbolt_Volley_KJ = CreateTrigger(  )
    call TriggerRegisterUnitEvent( gg_trg_Shadowbolt_Volley_KJ, gg_unit_Nkjx_2318, EVENT_UNIT_DAMAGED )
    call TriggerAddCondition( gg_trg_Shadowbolt_Volley_KJ, Condition( function Trig_Shadowbolt_Volley_KJ_Conditions ) )
    call TriggerAddAction( gg_trg_Shadowbolt_Volley_KJ, function Trig_Shadowbolt_Volley_KJ_Actions )
endfunction

//===========================================================================
// Trigger: Shadowbolt Volley KJ Tick
//===========================================================================
function Trig_Shadowbolt_Volley_KJ_Tick_Func008Func031A takes nothing returns nothing
    set udg_Temp_Unit = gg_unit_Nkjx_2318
    set udg_RealStatCalc = 350.00
    call TriggerExecute( gg_trg_Crit_Check)
    if IsUnitTargetableEnemyHitsAll( GetEnumUnit(), udg_Temp_Unit ) then
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "war3mapImported\\Void Disc.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_HERO, DAMAGE_TYPE_MAGIC )
    ////
    //nulling prevents collide multiple times
    call DestroyEffectBJ( udg_WitheringFire[GetForLoopIndexA()] )
    call BlzSetSpecialEffectAlpha( udg_WitheringFire[GetForLoopIndexA()], 0 )
    set udg_WitheringFire[  bj_forLoopAIndex ] = null
    endif
endfunction

function Trig_Shadowbolt_Volley_KJ_Tick_Func010Func006Func003C takes nothing returns boolean
    if ( not ( udg_WitheringShots_K >= ( ( udg_TOTAL * 2 ) + ( 111 + 1 ) ) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Shadowbolt_Volley_KJ_Tick_Func010Func006C takes nothing returns boolean
    if ( not ( udg_WitheringShots_K >= ( 111 + udg_TOTAL ) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Shadowbolt_Volley_KJ_Tick_Func010C takes nothing returns boolean
    if ( not ( udg_WitheringShots_K >= ( 111 + udg_DIST ) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Shadowbolt_Volley_KJ_Tick_Actions takes nothing returns nothing
    local integer modulo
    local integer exec =  GetTriggerExecCount(GetTriggeringTrigger())
    set udg_Temp_Unit = gg_unit_Nkjx_2318
    set udg_TOTAL = 36
    set modulo = 4
    set udg_DIST = 20
    set bj_forLoopAIndex = 111
    set bj_forLoopAIndexEnd = ( 111 + udg_TOTAL )
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        //CREATE NEW
        if bj_forLoopAIndex == udg_WitheringShots_K and ModuloInteger( exec, modulo ) == 0 then
        if IsUnitAliveBJ(udg_Temp_Unit) and not IsStunned(udg_Temp_Unit) then
        if ModuloInteger( exec, 40 ) == 0 then
        call SetUnitAnimation( udg_Temp_Unit, "attack" )
        endif
        set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
        set udg_Facing_Angle = GetUnitFacing( udg_Temp_Unit) + GetRandomReal(-75,75)
        set udg_WitheringFireAngle[  bj_forLoopAIndex ] = udg_Facing_Angle
        set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 24.00, udg_Facing_Angle)
        call RemoveLocation (udg_Temp_Unit_Point)
        call AddSpecialEffectLocBJ( udg_Temp_Polar_Point, "war3mapImported\\Shadow Bolt Void4.mdx" )
        set udg_WitheringFire[GetForLoopIndexA()] = GetLastCreatedEffectBJ()
        call BlzSetSpecialEffectYaw( udg_WitheringFire[GetForLoopIndexA()], Deg2Rad(udg_Facing_Angle) )
        call BlzSetSpecialEffectZ( udg_WitheringFire[GetForLoopIndexA()], ( 32.00 + BlzGetLocalSpecialEffectZ(udg_WitheringFire[GetForLoopIndexA()]) ) )
        call RemoveLocation (udg_Temp_Polar_Point)
        endif
        set bj_forLoopAIndex = 150
        set udg_WitheringShots_K = ( udg_WitheringShots_K + 1 )
        call Debug( "Withering Shots: " + I2S(udg_WitheringShots_K) ) 
        else
        //MOVE EXISTING
        if udg_WitheringFire[  bj_forLoopAIndex ] != null then
        set udg_Temp_Unit_Point = GetSpecialEffectLoc( udg_WitheringFire[ bj_forLoopAIndex ] )
        set udg_Facing_Angle =  udg_WitheringFireAngle[  bj_forLoopAIndex ]
        set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 16.00, udg_Facing_Angle)
        call RemoveLocation (udg_Temp_Unit_Point)
        call BlzSetSpecialEffectPositionLoc( udg_WitheringFire[  bj_forLoopAIndex ], udg_Temp_Polar_Point)
        call BlzSetSpecialEffectZ( udg_WitheringFire[bj_forLoopAIndex], ( 32.00 + GetLocationZ( udg_Temp_Polar_Point) ) )
        set bj_wantDestroyGroup = true
        call ForGroupBJ( GetUnitsInRangeOfLocAll(64.00, udg_Temp_Polar_Point), function Trig_Shadowbolt_Volley_KJ_Tick_Func008Func031A )
        call RemoveLocation (udg_Temp_Polar_Point)
        endif
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    if ModuloInteger( exec , modulo ) == 0 then
    if ( Trig_Shadowbolt_Volley_KJ_Tick_Func010C() ) then
        if udg_WitheringFire[udg_WitheringShots_K - udg_DIST] != null then 
        call DestroyEffectBJ( udg_WitheringFire[( udg_WitheringShots_K - udg_DIST )] )
        call BlzSetSpecialEffectAlpha( udg_WitheringFire[( udg_WitheringShots_K - udg_DIST )], 0 )
        set udg_WitheringFire[ udg_WitheringShots_K - udg_DIST ] = null
        endif
        if ( Trig_Shadowbolt_Volley_KJ_Tick_Func010Func006C() ) then
            set udg_WitheringShots_K = ( udg_WitheringShots_K + 1 )
            call Debug( "Withering Shots: " + I2S(udg_WitheringShots_K) ) 
            if ( Trig_Shadowbolt_Volley_KJ_Tick_Func010Func006Func003C() ) then
                set bj_forLoopAIndex = 111
                set bj_forLoopAIndexEnd = ( 111 + udg_TOTAL )
                loop
                    exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
                    call DestroyEffectBJ( udg_WitheringFire[( udg_WitheringShots_K - udg_DIST )] )
                    call BlzSetSpecialEffectAlpha( udg_WitheringFire[( udg_WitheringShots_K - udg_DIST )], 0 )
                    set udg_WitheringFire[  bj_forLoopAIndex ] = null
                    set bj_forLoopAIndex = bj_forLoopAIndex + 1
                endloop
                call DisableTrigger( GetTriggeringTrigger() )
            else
            endif
        else
        endif
    else
    endif
    endif
endfunction

//===========================================================================
function InitTrig_Shadowbolt_Volley_KJ_Tick takes nothing returns nothing
    set gg_trg_Shadowbolt_Volley_KJ_Tick = CreateTrigger(  )
    call DisableTrigger( gg_trg_Shadowbolt_Volley_KJ_Tick )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Shadowbolt_Volley_KJ_Tick, 0.02 )
    call TriggerAddAction( gg_trg_Shadowbolt_Volley_KJ_Tick, function Trig_Shadowbolt_Volley_KJ_Tick_Actions )
endfunction

//===========================================================================
// Trigger: KilJaeden Meteor
//
// 
//===========================================================================
function Trig_KilJaeden_Meteor_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'Nkjx' ) ) then
        return false
    endif
    if ( not ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) < 10000.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_KilJaeden_Meteor_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 53
    local effect indicator
    local unit udg_Temp_Unit = GetEventDamageSource()
    if RectContainsUnit( gg_rct_Sunwell_Plateau, udg_Temp_Unit ) then
    call PlaySoundOnUnitBJ( gg_snd_KilJaeden_Destruction, 100.00, GetTriggerUnit() )
    set udg_Point_Charge_End[udg_Temp_Int] = GetUnitLoc(GetEventDamageSource())
    set udg_Point_Charge_Begin[udg_Temp_Int] = PolarProjectionBJ(udg_Point_Charge_End[udg_Temp_Int], 150.00, GetRandomDirectionDeg())
    set indicator = AddSpecialEffectLoc("war3mapImported\\FelMeteorIndicator.mdx", udg_Point_Charge_End[udg_Temp_Int])
        call BlzPlaySpecialEffect( indicator, ANIM_TYPE_STAND )
        call BlzSpecialEffectAddSubAnimation( indicator, SUBANIM_TYPE_LARGE )
        call BlzSetSpecialEffectScale( indicator, 2.2 )
    call DisableTrigger( GetTriggeringTrigger() )
    call AddSpecialEffectLocBJ( udg_Point_Charge_Begin[udg_Temp_Int], "war3mapImported\\FelMeteor.mdx" )
    set udg_Charge_SE[udg_Temp_Int] = GetLastCreatedEffectBJ()
    call BlzSetSpecialEffectZ( udg_Charge_SE[udg_Temp_Int], 1000.00 )
    set udg_Charge_Loop[udg_Temp_Int] = 1.00
    call EnableTrigger(gg_trg_KilJaeden_Meteor_Fall_Tick)
    call TriggerSleepAction( 3.00 )
    call DestroyEffect( indicator)
    call TriggerSleepAction( 3.50 )
    call EnableTrigger( GetTriggeringTrigger() )
    endif
    set udg_Temp_Unit = null
    set indicator = null
endfunction

//===========================================================================
function InitTrig_KilJaeden_Meteor takes nothing returns nothing
    set gg_trg_KilJaeden_Meteor = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_KilJaeden_Meteor, EVENT_PLAYER_UNIT_DAMAGED )
    call TriggerAddCondition( gg_trg_KilJaeden_Meteor, Condition( function Trig_KilJaeden_Meteor_Conditions ) )
    call TriggerAddAction( gg_trg_KilJaeden_Meteor, function Trig_KilJaeden_Meteor_Actions )
endfunction

//===========================================================================
// Trigger: KilJaeden Meteor Fall Tick
//===========================================================================
function Trig_KilJaeden_Meteor_Fall_Tick_Func012A takes nothing returns nothing
    local unit udg_Temp_Unit = gg_unit_Nkjx_2318
    if IsUnitTargetableEnemyHitsAll( GetEnumUnit(), udg_Temp_Unit ) then
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "war3mapImported\\FelFirePillarMediumNew.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), 2500.00, ATTACK_TYPE_HERO, DAMAGE_TYPE_MAGIC )
    endif
    set udg_Temp_Unit = null
endfunction

function Trig_KilJaeden_Meteor_Fall_Tick_Actions takes nothing returns nothing
    set udg_Temp_Int = 53
    set udg_Temp_Angle = AngleBetweenPoints(udg_Point_Charge_End[udg_Temp_Int], udg_Point_Charge_Begin[udg_Temp_Int])
    call RemoveLocation (udg_Point_Charge_Begin[udg_Temp_Int])
    set udg_Point_Charge_Begin[udg_Temp_Int] = PolarProjectionBJ(udg_Point_Charge_End[udg_Temp_Int], ( 150.00 - udg_Charge_Loop[udg_Temp_Int] ), udg_Temp_Angle)
    call BlzSetSpecialEffectPositionLoc( udg_Charge_SE[udg_Temp_Int], udg_Point_Charge_Begin[udg_Temp_Int] )
    call BlzSetSpecialEffectZ( udg_Charge_SE[udg_Temp_Int], ( 1000.00 - ( 5.00 * udg_Charge_Loop[udg_Temp_Int] ) ) )
    if (udg_Charge_Loop[udg_Temp_Int] < 150) then
    set udg_Charge_Loop[udg_Temp_Int] = ( udg_Charge_Loop[udg_Temp_Int] + 1 )
    else
    call DestroyEffectBJ( udg_Charge_SE[udg_Temp_Int] )
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(250.00, udg_Point_Charge_End[udg_Temp_Int]), function Trig_KilJaeden_Meteor_Fall_Tick_Func012A )
    call RemoveLocation (udg_Point_Charge_Begin[udg_Temp_Int])
    call RemoveLocation (udg_Point_Charge_End[udg_Temp_Int])
    call DisableTrigger( GetTriggeringTrigger() )
    endif
endfunction

//===========================================================================
function InitTrig_KilJaeden_Meteor_Fall_Tick takes nothing returns nothing
    set gg_trg_KilJaeden_Meteor_Fall_Tick = CreateTrigger(  )
    call DisableTrigger( gg_trg_KilJaeden_Meteor_Fall_Tick )
    call TriggerRegisterTimerEventPeriodic( gg_trg_KilJaeden_Meteor_Fall_Tick, 0.02 )
    call TriggerAddAction( gg_trg_KilJaeden_Meteor_Fall_Tick, function Trig_KilJaeden_Meteor_Fall_Tick_Actions )
endfunction

