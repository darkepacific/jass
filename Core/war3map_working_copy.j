//===========================================================================
// Trigger: Hakkar
//
// Was 120
//===========================================================================
function Trig_Hakkar_Conditions takes nothing returns boolean
    return (GetUnitTypeId(GetTriggerUnit()) == 'E04O')
endfunction

function Trig_Hakkar_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    local unit u = GetTriggerUnit()

    call PlaySoundOnUnitBJ( gg_snd_HydraDeath1, 100, u )
    set udg_Temp_Unit_Point = GetUnitLoc(u)
    call CreateItemLoc( 'I07T', udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)

    call TriggerSleepAction( 120.00 )

    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Altar_of_Hakkar3)
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Weapons\\FireBallMissile\\FireBallMissile.mdl" )
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), 20.00 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Altar_of_Hakkar2)
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Weapons\\FireBallMissile\\FireBallMissile.mdl" )
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), 15.00 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Altar_of_Hakkar1)
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Weapons\\FireBallMissile\\FireBallMissile.mdl" )
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), 15.00 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Hakkar)
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call PlaySoundAtPointBJ( gg_snd_LightningBolt1, 100.00, udg_Temp_Unit_Point, 0 )
    call RemoveLocation (udg_Temp_Unit_Point)

    call TriggerSleepAction( 0.65 )

    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Hakkar)
    call ReviveHeroLoc( u, udg_Temp_Unit_Point, true )
    call RemoveLocation (udg_Temp_Unit_Point)
    call SetUnitColor( u, PLAYER_COLOR_RED )
    call SetUnitManaPercentBJ( u, 75.00 )

    set udg_Temp_Unit_Point = null
    set u = null
endfunction

//===========================================================================
function InitTrig_Hakkar takes nothing returns nothing
    set gg_trg_Hakkar = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Hakkar, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_Hakkar, Condition( function Trig_Hakkar_Conditions ) )
    call TriggerAddAction( gg_trg_Hakkar, function Trig_Hakkar_Actions )
endfunction


