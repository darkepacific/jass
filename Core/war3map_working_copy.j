    call GameTimeWait(6.0)
    call TransmissionFromUnitTypeWithNameBJ( udg_Scholomance_Message_Group, Player(PLAYER_NEUTRAL_PASSIVE), 'E01E', "TRIGSTR_10443", udg_Temp_Unit_Point, gg_snd_5_VOSS_I_WILL_NOT_LET_YOU_CURSE, "TRIGSTR_11518", bj_TIMETYPE_ADD, 0.00, false )
