function Trig_AoE_Fear_Func009C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A07Q' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A079' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A08Z' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0FA' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A07U' ) ) then
        return true
    endif
    return false
endfunction

function Trig_AoE_Fear_Conditions takes nothing returns boolean
    if ( not Trig_AoE_Fear_Func009C() ) then
        return false
    endif
    return true
endfunction

function Trig_AoE_Fear_Func008Func001Func001C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'n05L' ) ) then
