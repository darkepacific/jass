function Trig_Tranq_BA_Func011Func001Func002C takes nothing returns boolean
    if ( not Trig_Tranq_BA_Func011Func001Func002Func003C() ) then
        return false
    endif
    return true
endfunction

function Trig_Tranq_BA_Func011Func001C takes nothing returns boolean
    if ( not ( IsUnitEnemy(GetEnumUnit(), GetOwningPlayer(udg_Temp_Unit)) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( BlzIsUnitInvulnerable(GetEnumUnit()) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_MECHANICAL) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Tranq_BA_Func011A takes nothing returns nothing
    if ( Trig_Tranq_BA_Func011Func001C() ) then
        call SetUnitLifeBJ( GetEnumUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetEnumUnit()) + udg_RealStatCalc ) )
        if ( Trig_Tranq_BA_Func011Func001Func002C() ) then
            call BlzSetUnitWeaponRealFieldBJ( GetEnumUnit(), UNIT_WEAPON_RF_ATTACK_BASE_COOLDOWN, 0, 0.90 )
            call BlzSetUnitRealFieldBJ( GetEnumUnit(), UNIT_RF_SPEED, 330.00 )
        else
        endif
    else
    endif
endfunction

function Trig_Tranq_BA_Actions takes nothing returns nothing
    set udg_Temp_Unit = udg_yA_Bal_Druid
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    if ChaliceCheck() then
    // 0.2 x total amount
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A03B', udg_Temp_Unit) * 60 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 65 )
    set udg_RealStatCalc = ( ( udg_CHALICE_HEAL * I2R(udg_HeroStatCalc) ) + udg_RealStatCalc )
    endif
    set udg_RealStatCalc = ( 0.50 * udg_RealStatCalc )
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(900.00, udg_Blizzard[4]), function Trig_Tranq_BA_Func011A )
endfunction

