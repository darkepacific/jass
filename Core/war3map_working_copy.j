                call UnitAddItemByIdSwapped( 'I037', udg_Heroes[GetForLoopIndexA()] )
                call UnitAddItemByIdSwapped( 'I02N', udg_Heroes[GetForLoopIndexA()] )
                call UnitAddItemByIdSwapped( 'I02I', udg_Heroes[GetForLoopIndexA()] )
                call UnitAddItemByIdSwapped( 'pres', udg_Heroes[GetForLoopIndexA()] )
                call UnitAddItemByIdSwapped( 'pgma', udg_Heroes[GetForLoopIndexA()] )
                set bj_forLoopBIndex = bj_forLoopBIndex + 1
            endloop
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
endfunction

