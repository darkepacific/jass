//===========================================================================
// Trigger: Hillsbrad Miners
//
// Ok you NEED to split this into TWO arrays
// AzurelodeAlliance 0 = 4 Miners, 1 = Foremanbonds
// AzurelodeHorde  0 = Skeletons, 1 = Val'kyr
//===========================================================================
function Trig_Hillsbrad_Miners_Func007C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'h008' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'h02S' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Hillsbrad_Miners_Conditions takes nothing returns boolean
    if ( not ( IsUnitInGroup(GetTriggerUnit(), udg_SoG_Peasants) == false ) ) then
        return false
    endif
    if ( not Trig_Hillsbrad_Miners_Func007C() ) then
        return false
    endif
    return true
endfunction

function Trig_Hillsbrad_Miners_Func003001 takes nothing returns boolean
    return ( GetRandomInt(1, 10) > 5 )
endfunction

function Trig_Hillsbrad_Miners_Func005C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'h008' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hillsbrad_Miners_Func008Func001C takes nothing returns boolean
    if ( not ( udg_AzurelodeHorde[0] <= 0.00 ) ) then
        return false
    endif
    if ( not ( udg_AzurelodeHorde[1] <= 0.00 ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(gg_unit_h015_0631) == Player(3) ) ) then
        return false
    endif
    if ( not ( IsTriggerEnabled(gg_trg_Azurelode_Capture) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hillsbrad_Miners_Func008C takes nothing returns boolean
    if ( not ( udg_AzurelodeAlliance[0] <= 0.00 ) ) then
        return false
    endif
    if ( not ( udg_AzurelodeAlliance[1] <= 0.00 ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(gg_unit_h015_0631) == Player(1) ) ) then
        return false
    endif
    if ( not ( IsTriggerEnabled(gg_trg_Azurelode_Capture) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hillsbrad_Miners_Func010Func001C takes nothing returns boolean
    if ( not ( GetOwningPlayer(gg_unit_h015_0631) == Player(3) ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'h02S' ) ) then
        return false
    endif
    if ( not ( udg_AzurelodeHorde[0] < 4.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hillsbrad_Miners_Func010C takes nothing returns boolean
    if ( not ( GetOwningPlayer(gg_unit_h015_0631) == Player(1) ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'h008' ) ) then
        return false
    endif
    if ( not ( udg_AzurelodeAlliance[0] < 4.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hillsbrad_Miners_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    set udg_Temp_Unit_Point = GetUnitLoc(GetDyingUnit())
    if ( Trig_Hillsbrad_Miners_Func003001() ) then
        call CreateItemLoc( 'I00I', udg_Temp_Unit_Point )
    else
        call CreateItemLoc( 'I039', udg_Temp_Unit_Point )
    endif
    call RemoveLocation (udg_Temp_Unit_Point)
    if ( Trig_Hillsbrad_Miners_Func005C() ) then
        set udg_AzurelodeAlliance[0] = ( udg_AzurelodeAlliance[0] - 1 )
    else
        set udg_AzurelodeHorde[0] = ( udg_AzurelodeHorde[0] - 1 )
    endif
    if ( Trig_Hillsbrad_Miners_Func008C() ) then
        call TriggerExecute( gg_trg_Azurelode_Capture )
    else
        if ( Trig_Hillsbrad_Miners_Func008Func001C() ) then
            call TriggerExecute( gg_trg_Azurelode_Capture )
        else
        endif
    endif
    call TriggerSleepAction( 90.00 )
    if ( Trig_Hillsbrad_Miners_Func010C() ) then
        set udg_AzurelodeAlliance[0] = ( udg_AzurelodeAlliance[0] + 1 )
        set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_Hillsbrad_Miners)
        call CreateNUnitsAtLoc( 1, 'h008', Player(1), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "harvest", gg_unit_n00I_0325 )
        call RemoveLocation (udg_Temp_Unit_Point)
        call SetUnitAcquireRangeBJ( GetLastCreatedUnit(), 200.00 )
    else
        if ( Trig_Hillsbrad_Miners_Func010Func001C() ) then
            set udg_AzurelodeHorde[0] = ( udg_AzurelodeHorde[0] + 1 )
            set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_Hillsbrad_Miners)
            call CreateNUnitsAtLoc( 1, 'h02S', Player(3), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
            call IssueTargetOrderBJ( GetLastCreatedUnit(), "harvest", gg_unit_n00I_0325 )
            call RemoveLocation (udg_Temp_Unit_Point)
            call SetUnitAcquireRangeBJ( GetLastCreatedUnit(), 200.00 )
        else
        endif
    endif
    set udg_Temp_Unit_Point = null
endfunction

//===========================================================================
function InitTrig_Hillsbrad_Miners takes nothing returns nothing
    set gg_trg_Hillsbrad_Miners = CreateTrigger(  )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Hillsbrad_Miners, Player(1), EVENT_PLAYER_UNIT_DEATH )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Hillsbrad_Miners, Player(3), EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_Hillsbrad_Miners, Condition( function Trig_Hillsbrad_Miners_Conditions ) )
    call TriggerAddAction( gg_trg_Hillsbrad_Miners, function Trig_Hillsbrad_Miners_Actions )
endfunction

