//===========================================================================
// Trigger: E ALTJ
//===========================================================================
function Trig_E_ALTJ_Func005Func001C takes nothing returns boolean
    if ( not ( GetItemTypeId(udg_P_Items[( udg_Bag_Num + udg_Bag_Iterator )]) == udg_ItemTypeCheck ) ) then
        return false
    endif
    return true
endfunction

function Trig_E_ALTJ_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 51
                       if IsAllianceHero( GetTriggerUnit() ) then
    call SetBagNumber( GetOwningPlayer(GetTriggerUnit()) )
    set udg_ItemTypeCheck = 'I05T'
    set udg_Bag_Iterator = 1
    loop
        exitwhen udg_Bag_Iterator > udg_BAG_LOOP_MAX
        if ( Trig_E_ALTJ_Func005Func001C() ) then
            call DisableTrigger( gg_trg_L_ALTJ )
            call DisableTrigger( GetTriggeringTrigger() )
            if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
            call FlashQuestDialogButtonBJ(  )
            endif
            call DestroyMinimapIcon( udg_MiniMapIcon[51] )
            call QuestSetCompletedBJ( udg_Quests[51], true )
            call QuestItemSetCompletedBJ( udg_QuestReqs[51], true )
            call DestroyEffectBJ( udg_QuestMarks[51] )
            // Clean Up Items
            call CleanUpItems( udg_ItemTypeCheck )
            // Rewards
            set udg_XP = udg_QUEST_XP[udg_Temp_Int]
            set udg_Gold = udg_QUEST_GOLD[udg_Temp_Int]
            set udg_TempString = "A Letter to Jaina"
            call TriggerExecute( gg_trg_Quest_Complete_A )
            call CreateTextTagUnitBJ( "TRIGSTR_9816", gg_unit_Hjai_1261, 0, 8.00, 60.00, 60.00, 100.00, 0 )
            call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 10.00, 90.00 )
            call cleanUpText( 1.5, 1.25 )
            call IssueImmediateOrderBJ( gg_unit_Hjai_1261, "waterelemental" )
            return
        else
        endif
        set udg_Bag_Iterator = udg_Bag_Iterator + 1
    endloop
                       endif
endfunction

