//===========================================================================
function Trig_E_Griknir_Func005Func001C takes nothing returns boolean
    if ( not ( GetItemTypeId(udg_P_Items[( udg_Bag_Num + udg_Bag_Iterator )]) == udg_ItemTypeCheck ) ) then
        return false
    endif
    return true
endfunction

function Trig_E_Griknir_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 99
                       if IsAllianceHero( GetTriggerUnit() ) then
    call SetBagNumber( GetOwningPlayer(GetTriggerUnit()) )
    set udg_ItemTypeCheck = 'I08A'
    set udg_Bag_Iterator = 1
    loop
        exitwhen udg_Bag_Iterator > udg_BAG_LOOP_MAX
        if ( Trig_E_Griknir_Func005Func001C() ) then
            if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
            call FlashQuestDialogButtonBJ(  )
            endif
            call QuestSetCompletedBJ( udg_Quests[udg_Temp_Int], true )
            call QuestItemSetCompletedBJ( udg_QuestReqs[udg_Temp_Int], true )
            call DestroyMinimapIcon( udg_MiniMapIcon[udg_Temp_Int] )
            call DestroyEffectBJ( udg_QuestMarks[udg_Temp_Int] )
            // Clean Up Items
            call CleanUpItems( udg_ItemTypeCheck )
            // Rewards
            set udg_Gold = udg_QUEST_GOLD[udg_Temp_Int]
            set udg_XP = udg_QUEST_XP[udg_Temp_Int]
            set udg_LVL_Req = udg_QUEST_LVL_REQ[udg_Temp_Int]
            set udg_TempString = "Grik'nir the Cold"
            call TriggerExecute( gg_trg_Quest_Complete_A )
            call DisableTrigger( gg_trg_U_Griknir_Head_Acquire)
            call DisableTrigger( gg_trg_U_Griknir_Death)
            call DisableTrigger( GetTriggeringTrigger() )
            set udg_TempString = ""
            if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
            set udg_TempString = udg_ExclamationMark
            endif
            call AddSpecialEffectTargetUnitBJ( "overhead", gg_unit_hrif_0501, udg_TempString )
            set udg_QuestMarks[58] = GetLastCreatedEffectBJ()
            call EnableTrigger( gg_trg_S_OTK )
            return
        else
        endif
        set udg_Bag_Iterator = udg_Bag_Iterator + 1
    endloop
                       endif
endfunction

