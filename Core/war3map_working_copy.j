//===========================================================================
// Trigger: Nathanos
//===========================================================================
function Trig_Nathanos_Func002Func025Func001C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetEnumUnit()) == 'n02F' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Nathanos_Func002Func025A takes nothing returns nothing
    if ( Trig_Nathanos_Func002Func025Func001C() ) then
        call SetUnitOwner( GetEnumUnit(), Player(11), true )
        call ReplaceUnitBJ( GetEnumUnit(), 'n00E', bj_UNIT_STATE_METHOD_RELATIVE )
    else
    endif
endfunction

function Trig_Nathanos_Func002C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(gg_unit_U00J_1218) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Nathanos_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    if ( Trig_Nathanos_Func002C() ) then
        call DisableTrigger( gg_trg_Operating_Table )
        call DisableTrigger( gg_trg_Gilneas_City_Battle_Music )
        call EnableTrigger( gg_trg_Gilneas_City_Classical )
        set udg_Temp_Unit_Point = GetUnitLoc(GetDyingUnit())
        call CreateItemLoc( 'ckng', udg_Temp_Unit_Point )
        call RemoveLocation (udg_Temp_Unit_Point)
        call TriggerSleepAction( 1.50 )
        call DisplayTimedTextToForce( GetPlayersAll(), 3.00, "TRIGSTR_9791" )
        call TriggerSleepAction( 3.00 )
        call FactionCapture( GetTriggerUnit(), Player(1), "Gilneas City", "", false)
        call SetUnitOwner( gg_unit_ncop_1664, Player(11), true )
        call SetUnitOwner( gg_unit_ncop_1665, Player(11), true )
        call SetUnitOwner( gg_unit_n026_1833, Player(11), true )
        call ExplodeUnitBJ( udg_ApothecaryGilneas )
        call KillDestructable( udg_AbomTableGilneas )
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Gilneas_Guard_1)
        call CreateNUnitsAtLoc( 1, 'n033', Player(11), udg_Temp_Unit_Point, 21.00 )
        call RemoveLocation (udg_Temp_Unit_Point)
        set bj_wantDestroyGroup = true
        call ForGroupBJ( GetUnitsInRectOfPlayer(gg_rct_Z_Gilneas_City, Player(3)), function Trig_Nathanos_Func002Func025A )
        call TriggerSleepAction( 6.00 )
        // Revive Genn
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Genn_Greymane)
        call ReviveHeroLoc( gg_unit_U00J_1218, udg_Temp_Unit_Point, true )
        call RemoveLocation (udg_Temp_Unit_Point)
        // Revive Tess
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Tess_Greymane)
        call ReviveHeroLoc( gg_unit_H02B_1845, udg_Temp_Unit_Point, true )
        call RemoveLocation (udg_Temp_Unit_Point)
        call BlzSetUnitFacingEx( gg_unit_H02B_1845, 3.83 )
        // Revive Tobias
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Tobias_Mismantle)
        call ReviveHeroLoc( gg_unit_U027_1413, udg_Temp_Unit_Point, true )
        call RemoveLocation (udg_Temp_Unit_Point)
        call BlzSetUnitFacingEx( gg_unit_U027_1413, 82.38 )
        // Remove Table
        call RemoveDestructable( udg_AbomTableGilneas )
    else
        call TriggerSleepAction( 120.00 )
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_The_SiegeOfGilneas)
        call ReviveHeroLoc( gg_unit_H027_1820, udg_Temp_Unit_Point, true )
        call RemoveLocation (udg_Temp_Unit_Point)
    endif
    set udg_Temp_Unit_Point = null
endfunction

