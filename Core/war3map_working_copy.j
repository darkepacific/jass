    endif
    return true
endfunction

function Trig_AoE_Fear_Func008C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A07U' ) ) then
        return false
    endif
    return true
endfunction

function Trig_AoE_Fear_Func012Func017C takes nothing returns boolean
    if ( not ( udg_i_Fear == 200 ) ) then
        return false
    endif
    return true
endfunction

function Trig_AoE_Fear_Func012A takes nothing returns nothing
    if IsUnitTargetableEnemy( GetEnumUnit(), udg_Temp_Unit2 ) then
    if udg_RealStatCalc > 0 then
    call UnitDamageTargetBJ( udg_Temp_Unit2, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call HasFirelords( GetEnumUnit() )
    endif
    call IssueTargetOrderBJ( gg_unit_e028_1863, "innerfire", GetEnumUnit() )
    call GroupAddUnitSimple( GetEnumUnit(), udg_FearedUnits )
    call AddSpecialEffectTargetUnitBJ( "overhead", GetEnumUnit(), "FearEffect2.mdx" )
    set udg_X_FearEffects[udg_i_Fear] = GetLastCreatedEffectBJ()
    call BlzSetSpecialEffectTimeScale( udg_X_FearEffects[udg_i_Fear], 3.25 )
    set udg_Temp_Polar_Point = GetRandomLocInRect(GetPlayableMapRect())
    call IssueImmediateOrderBJ( GetEnumUnit(), "stop" )
    call IssuePointOrderLocBJ( GetEnumUnit(), "move", udg_Temp_Polar_Point )
    call RemoveLocation (udg_Temp_Polar_Point)
    set udg_Temp_Bool = true
    set udg_i_Fear = ( udg_i_Fear + 1 )
    if ( Trig_AoE_Fear_Func012Func017C() ) then
        set udg_i_Fear = 0
    else
    endif
    endif
endfunction

function Trig_AoE_Fear_Func013C takes nothing returns boolean
    if ( not ( udg_Temp_Bool == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AoE_Fear_Func017Func001C takes nothing returns boolean
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_AoE_Fear_Func017A takes nothing returns nothing
    if ( Trig_AoE_Fear_Func017Func001C() ) then
        call IssueImmediateOrderBJ( GetEnumUnit(), "stop" )
    else
    endif
endfunction

function Trig_AoE_Fear_Actions takes nothing returns nothing
    local real fearTime = 0.0
    local real udg_Temp_Real = 0.0
    set udg_RealStatCalc = 0.0
    set udg_Temp_Bool = false
    set udg_Temp_Unit = GetTriggerUnit()
    //need to use Temp_Unit2 because this was canceling other unit's casts and having CD tirgger called thereby changing the value of Temp_Unit
    set udg_Temp_Unit2 = udg_Temp_Unit
    if ( Trig_AoE_Fear_Func008C() ) then
        set fearTime = 1.3
        set udg_Temp_Real = 300.00
        set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A07U', udg_Temp_Unit) * 1 )
        set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_STR, GetTriggerUnit(), true) - 0 ))
        set udg_RealStatCalc = ( ( 1.00 + ( I2R(udg_HeroStatCalc) * 1.00 ) ) * udg_RealStatCalc )
        set udg_HeroStatCalc = ( udg_HeroStatCalc * 100 )
        set udg_HeroStatCalc = ( udg_HeroStatCalc + 100 )
        set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
        // Crit Bonus
        call TriggerExecute( gg_trg_Crit_Check)
        call TriggerExecute( gg_trg_Firelords_Helper)
    else
        if ( Trig_AoE_Fear_Func008Func001C() ) then
            if ( Trig_AoE_Fear_Func008Func001Func001C() ) then
                set udg_Temp_Real = 600.00
                set fearTime = 1.66
            else
                set udg_Temp_Real = 425.00
                set fearTime = 1.66
            endif
        else
            set fearTime = 1.66
            set udg_Temp_Real = 325.00
        endif
    endif
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(udg_Temp_Real, udg_Temp_Unit_Point), function Trig_AoE_Fear_Func012A )
    if ( Trig_AoE_Fear_Func013C() ) then
        call StopSoundBJ( gg_snd_Fear, false )
        call PlaySoundOnUnitBJ( gg_snd_Fear, 100, GetTriggerUnit() )
    else
    endif
    call RemoveLocation (udg_Temp_Unit_Point)
    call EnableTrigger( gg_trg_FearWander )
    call GameTimeWait( fearTime )
    call ForGroupBJ( udg_FearedUnits, function Trig_AoE_Fear_Func017A )
    call GroupRemoveGroup( udg_FearedUnits, udg_FearedUnits )
    set bj_forLoopAIndex = 0
    set bj_forLoopAIndexEnd = 199
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call DestroyEffectBJ( udg_X_FearEffects[GetForLoopIndexA()] )
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
endfunction

