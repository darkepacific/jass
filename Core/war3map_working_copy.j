//===========================================================================
// Trigger: E HHK
//===========================================================================
function Trig_E_HHK_Func005Func001C takes nothing returns boolean
    if ( not ( GetItemTypeId(udg_P_Items[( udg_Bag_Num + udg_Bag_Iterator )]) == udg_ItemTypeCheck ) ) then
        return false
    endif
    return true
endfunction

function Trig_E_HHK_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 31
                       if IsAllianceHero( GetTriggerUnit() ) then
    call SetBagNumber( GetOwningPlayer(GetTriggerUnit()) )
    set udg_ItemTypeCheck = 'I098'
    set udg_Bag_Iterator = 1
    loop
        exitwhen udg_Bag_Iterator > udg_BAG_LOOP_MAX
        if ( Trig_E_HHK_Func005Func001C() ) then
            if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
            call FlashQuestDialogButtonBJ(  )
            endif
            call QuestSetCompletedBJ( udg_Quests[31], true )
            call QuestItemSetCompletedBJ( udg_QuestReqs[31], true )
            call DestroyMinimapIcon( udg_MiniMapIcon[31] )
            call DestroyEffectBJ( udg_QuestMarks[31] )
            call DisableTrigger( gg_trg_U_HHK_Hakkar )
            set udg_Temp_Unit_Point = GetRectCenter(gg_rct_The_Heart_of_Hakkar_End)
            call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Spells\\NightElf\\Starfall\\StarfallCaster.mdl" )
            call RemoveLocation (udg_Temp_Unit_Point)
            set udg_QuestMarks[31] = GetLastCreatedEffectBJ()
            call DisableTrigger( GetTriggeringTrigger() )
            call CreateTextTagUnitBJ( "TRIGSTR_11167", gg_unit_Ewar_0890, 0.00, 8.00, 80.00, 40.00, 100.00, 0 )
            call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
            call CleanUpText(1.65,1.3)
            call TriggerSleepAction( 0.70 )
            set udg_Temp_Unit_Point = GetRectCenter(gg_rct_The_Heart_of_Hakkar_End)
            call CreateItemLoc( 'I026', udg_Temp_Unit_Point )
            call RemoveLocation (udg_Temp_Unit_Point)
            // Clean Up Items
            call CleanUpItems( udg_ItemTypeCheck )
            // Rewards
            set udg_XP = udg_QUEST_XP[udg_Temp_Int]
            set udg_Gold = udg_QUEST_GOLD[udg_Temp_Int]
            set udg_LVL_Req = udg_QUEST_LVL_REQ[udg_Temp_Int]
            set udg_TempString = "The Heart of Hakkar"
            call TriggerExecute( gg_trg_Quest_Complete_A )
            call TriggerSleepAction( 2.20 )
            call DestroyEffectBJ( udg_QuestMarks[31] )
            return
        else
        endif
        set udg_Bag_Iterator = udg_Bag_Iterator + 1
    endloop
                       endif
endfunction

