    call DisableTrigger( GetTriggeringTrigger() )
    set udg_Temp_Unit_Point = GetUnitLoc(GetEventDamageSource())
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Frosty Crystal Drop.mdl" )
    call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 1.26 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call TriggerSleepAction( 1.25 )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\IceSlam.mdx" )
    call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 2.00 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\IceNova.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set udg_Temp_Unit = gg_unit_Uktl_0568
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(290.00, udg_Temp_Unit_Point), function Trig_Icy_Rift_67k_Func019A )
    call TriggerSleepAction( 2.00 )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\IceSlam.mdx" )
    call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 2.00 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\IceNova.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set udg_Temp_Unit = gg_unit_Uktl_0568
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(290.00, udg_Temp_Unit_Point), function Trig_Icy_Rift_67k_Func028A )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 6.00 )
    call EnableTrigger( GetTriggeringTrigger() )
    endif
    set udg_Temp_Unit_Point = null
endfunction

