function Trig_U_APT_Actions takes nothing returns nothing
    local boolean hasMote
    local integer udg_Temp_Int = 113
                       if IsAllianceHero( GetTriggerUnit() ) then
    call SetBagNumber( GetOwningPlayer(GetTriggerUnit()) )
    set bj_forLoopBIndex = 1
    set bj_forLoopBIndexEnd = udg_BAG_LOOP_MAX
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        set udg_ItemTypeCheck = 'I090'
        if ( Trig_U_APT_Func005Func002C() ) then
            set udg_QuestPrincessMotesA = ( udg_QuestPrincessMotesA + 1.00 )
            set hasMote = true
            // Clean Up Items
            call CleanUpItems( udg_ItemTypeCheck )
            // End Clean Up Items
            // FT Gen
            set udg_TempString = "|c00fEBA0EMote of Air|r"
            set udg_Temp_Unit = GetTriggerUnit()
            call TriggerExecute( gg_trg_ItemTurnIn )
        else
        endif
        set udg_ItemTypeCheck = 'I08Z'
        if ( Trig_U_APT_Func005Func004C() ) then
            set udg_QuestPrincessMotesE = ( udg_QuestPrincessMotesE + 1.00 )
            set hasMote = true
            // Clean Up Items
            call CleanUpItems( udg_ItemTypeCheck )
            // End Clean Up Items
            // FT Gen
            set udg_TempString = "|c00fEBA0EMote of Earth|r"
            set udg_Temp_Unit = GetTriggerUnit()
            call TriggerExecute( gg_trg_ItemTurnIn )
        else
        endif
        set udg_ItemTypeCheck = 'I091'
        if ( Trig_U_APT_Func005Func006C() ) then
            set udg_QuestPrincessMotesF = ( udg_QuestPrincessMotesF + 1.00 )
            set hasMote = true
            // Clean Up Items
            call CleanUpItems( udg_ItemTypeCheck )
            // End Clean Up Items
            // FT Gen
            set udg_TempString = "|c00fEBA0EMote of Fire|r"
            set udg_Temp_Unit = GetTriggerUnit()
            call TriggerExecute( gg_trg_ItemTurnIn )
        else
        endif
        set udg_ItemTypeCheck = 'I092'
        if ( Trig_U_APT_Func005Func008C() ) then
            set udg_QuestPrincessMotesW = ( udg_QuestPrincessMotesW + 1.00 )
            set hasMote = true
            // Clean Up Items
            call CleanUpItems( udg_ItemTypeCheck )
            // End Clean Up Items
            // FT Gen
            set udg_TempString = "|c00fEBA0EMote of Water|r"
            set udg_Temp_Unit = GetTriggerUnit()
            call TriggerExecute( gg_trg_ItemTurnIn )
        else
        endif
        set bj_forLoopBIndex = bj_forLoopBIndex + 1
    endloop
    if hasMote then
    call QuestItemSetDescriptionBJ( udg_QuestReqs[udg_Temp_Int], ( "Mote of Air - " + ( I2S(R2I(udg_QuestPrincessMotesA)) + ( "/1" + ( "  - Mote of Earth - " + ( I2S(R2I(udg_QuestPrincessMotesE)) + ( "/1" + ( "|n - Mote of Fire - " + ( I2S(R2I(udg_QuestPrincessMotesF)) + ( "/1" + ( "   - Mote of Water -" + ( I2S(R2I(udg_QuestPrincessMotesW)) + "/1" ) ) ) ) ) ) ) ) ) ) ) )
    endif
                       endif
endfunction

