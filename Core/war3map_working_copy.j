            return "Holy"
        elseif slot == 182 then
            return "Shadow"

            // Rogue (base 190)
        elseif slot == 190 then
            return "Assassination"
        elseif slot == 191 then
            return "Combat"
            //Subtle Rogue
        elseif slot == 192 then
            return "Subtlety"

            // Shaman (base 200)
