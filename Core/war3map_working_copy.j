function InitTrig_E_TLN takes nothing returns nothing
    set gg_trg_E_TLN = CreateTrigger(  )
    call DisableTrigger( gg_trg_E_TLN )
    call TriggerRegisterEnterRectSimple( gg_trg_E_TLN, gg_rct_Kill_Anduin )
    call TriggerRegisterUnitInRangeSimple( gg_trg_E_TLN, 256, gg_unit_Usyl_0179 )
