function Trig_Death_Set_Alliance_Actions takes nothing returns nothing
    call Debug( "Temp_Int: " + I2S(udg_Temp_Int) )
    set udg_X_Player_MUI = GetOwningPlayer(udg_Heroes[udg_Temp_Int])
    if ( Trig_Death_Set_Alliance_Func003C() ) then
        set udg_Temp_Bool = udg_DoRevive
        if ( Trig_Death_Set_Alliance_Func003Func004C() ) then
            if udg_Temp_Bool then
            call CameraSetupApplyForPlayer( true, gg_cam_GY_Kharanos, udg_X_Player_MUI, 0.00 )
            endif
            set udg_Temp_Z_Rev = GetRectCenter(gg_rct_GY_Kharanos)
        else
        endif
        if ( Trig_Death_Set_Alliance_Func003Func005C() ) then
            if udg_Temp_Bool then
            call CameraSetupApplyForPlayer( true, gg_cam_GY_Arathi, udg_X_Player_MUI, 0.00 )
            endif
            set udg_Temp_Z_Rev = GetRectCenter(gg_rct_GY_Arathi)
        else
        endif
        if ( Trig_Death_Set_Alliance_Func003Func006C() ) then
            if udg_Temp_Bool then
            call CameraSetupApplyForPlayer( true, gg_cam_GY_Hinterland, udg_X_Player_MUI, 0.00 )
            endif
            set udg_Temp_Z_Rev = GetRectCenter(gg_rct_GY_Hinterland)
        else
        endif
        if ( Trig_Death_Set_Alliance_Func003Func007C() ) then
            if udg_Temp_Bool then
            call CameraSetupApplyForPlayer( true, gg_cam_GY_Southshore, udg_X_Player_MUI, 0.00 )
            endif
            set udg_Temp_Z_Rev = GetRectCenter(gg_rct_GY_South_Shore)
        else
        endif
        if ( Trig_Death_Set_Alliance_Func003Func008C() ) then
            if udg_Temp_Bool then
            call CameraSetupApplyForPlayer( true, gg_cam_GY_Alterac, udg_X_Player_MUI, 0.00 )
            endif
            set udg_Temp_Z_Rev = GetRectCenter(gg_rct_GY_Alterac)
        else
        endif
        if ( Trig_Death_Set_Alliance_Func003Func009C() ) then
            if udg_Temp_Bool then
            call CameraSetupApplyForPlayer( true, gg_cam_GY_EP, udg_X_Player_MUI, 0.00 )
            endif
            set udg_Temp_Z_Rev = GetRectCenter(gg_rct_GY_EP)
        else
        endif
        if ( Trig_Death_Set_Alliance_Func003Func010C() ) then
            if udg_Temp_Bool then
            call CameraSetupApplyForPlayer( true, gg_cam_GY_KulTiras, udg_X_Player_MUI, 0.00 )
            endif
            set udg_Temp_Z_Rev = GetRectCenter(gg_rct_GY_KulTiras)
        else
        endif
        if ( Trig_Death_Set_Alliance_Func003Func011C() ) then
            if udg_Temp_Bool then
            call CameraSetupApplyForPlayer( true, gg_cam_GY_Westguard, udg_X_Player_MUI, 0.00 )
            endif
            set udg_Temp_Z_Rev = GetRectCenter(gg_rct_GY_Westguard)
        else
        endif
        // 8 Unused for Alliance (Horde is Revantusk)
        if ( Trig_Death_Set_Alliance_Func003Func013C() ) then
            if udg_Temp_Bool then
            call CameraSetupApplyForPlayer( true, gg_cam_GY_WP, udg_X_Player_MUI, 0.00 )
            endif
            set udg_Temp_Z_Rev = GetRectCenter(gg_rct_GY_WP)
        else
        endif
        if ( Trig_Death_Set_Alliance_Func003Func014C() ) then
            if ( Trig_Death_Set_Alliance_Func003Func014Func002C() ) then
                if udg_Temp_Bool then
                call CameraSetupApplyForPlayer( true, gg_cam_GY_Headlands, udg_X_Player_MUI, 0.00 )
                endif
                set udg_Temp_Z_Rev = GetRectCenter(gg_rct_GY_Headlands)
            else
                if udg_Temp_Bool then
                call CameraSetupApplyForPlayer( true, gg_cam_GY_Gilneas_City, udg_X_Player_MUI, 0.00 )
                endif
                set udg_Temp_Z_Rev = GetRectCenter(gg_rct_GY_Gilneas_City_Controlled)
            endif
        else
        endif
        if ( Trig_Death_Set_Alliance_Func003Func015C() ) then
            if udg_Temp_Bool then
            call CameraSetupApplyForPlayer( true, gg_cam_GY_Valsharah, udg_X_Player_MUI, 0.00 )
            endif
            set udg_Temp_Z_Rev = GetRectCenter(gg_rct_GY_Valsharah)
        else
        endif
        // 12 Unused for Alliance (Horde is Bulwark)
        if ( Trig_Death_Set_Alliance_Func003Func017C() ) then
            if udg_Temp_Bool then
            call CameraSetupApplyForPlayer( true, gg_cam_GY_Wetlands, udg_X_Player_MUI, 0.00 )
            endif
            set udg_Temp_Z_Rev = GetRectCenter(gg_rct_GY_Wetlands)
        else
        endif
        if ( Trig_Death_Set_Alliance_Func003Func018C() ) then
            if udg_Temp_Bool then
            call CameraSetupApplyForPlayer( true, gg_cam_GY_GrimBatol, udg_X_Player_MUI, 0.00 )
            endif
            set udg_Temp_Z_Rev = GetRectCenter(gg_rct_GY_GrimBatol)
        else
        endif
        if ( Trig_Death_Set_Alliance_Func003Func019C() ) then
            if udg_Temp_Bool then
            call CameraSetupApplyForPlayer( true, gg_cam_GY_Ghostlands_Alliance, udg_X_Player_MUI, 0.00 )
            endif
            set udg_Temp_Z_Rev = GetRectCenter(gg_rct_Z_GY_Ghostlands_Alliance)
        else
        endif
        // 16 TWH
        if ( Trig_Death_Set_Alliance_Func003Func021C() ) then
            if udg_Temp_Bool then
            call CameraSetupApplyForPlayer( true, gg_cam_GY_TolBarad, udg_X_Player_MUI, 0.00 )
            endif
            set udg_Temp_Z_Rev = GetRectCenter(gg_rct_GY_TolBarad)
        else
        endif
        if ( Trig_Death_Set_Alliance_Func003Func022C() ) then
            if udg_Temp_Bool then
            call CameraSetupApplyForPlayer( true, gg_cam_Hearth_Dalaran, udg_X_Player_MUI, 0.00 )
            endif
            set udg_Temp_Z_Rev = GetRectCenter(gg_rct_Hearth_Dalaran_14)
        else
        endif
        if ( Trig_Death_Set_Alliance_Func003Func023C() ) then
            if udg_Temp_Bool then
            call CameraSetupApplyForPlayer( true, gg_cam_GY_Stormheim, udg_X_Player_MUI, 0.00 )
            endif
            set udg_Temp_Z_Rev = GetRectCenter(gg_rct_GY_Stormheim)
        else
        endif
        if ( Trig_Death_Set_Alliance_Func003Func024C() ) then
            if udg_Temp_Bool then
            call CameraSetupApplyForPlayer( true, gg_cam_Dragonblight_Scarlet_Graveyard, udg_X_Player_MUI, 0.00 )
            endif
            set udg_Temp_Z_Rev = GetRectCenter(gg_rct_GY_Dragonblight)
        else
        endif
        if ( Trig_Death_Set_Alliance_Func003Func025C() ) then
            if udg_Temp_Bool then
            call CameraSetupApplyForPlayer( true, gg_cam_Argent_Tournament_Rev, udg_X_Player_MUI, 0.00 )
            endif
            set udg_Temp_Z_Rev = GetRectCenter(gg_rct_Hearth_Argent_Tourney_22)
        else
        endif
        if ( Trig_Death_Set_Alliance_Func003Func026C() ) then
            if udg_Temp_Bool then
            call CameraSetupApplyForPlayer( true, gg_cam_Wintergarde_Rev, udg_X_Player_MUI, 0.00 )
            endif
            set udg_Temp_Z_Rev = GetRectCenter(gg_rct_Hearth_Wintergarde_Keep_21)
        else
        endif
    else
        call Debug( "IsARezz == true")
        set udg_Temp_Z_Rev = GetDestructableLoc(udg_Graves[udg_Temp_Int])
    endif
    if ( Trig_Death_Set_Alliance_Func004C() ) then
        call Debug( "DoRevive == true")
        if udg_Z_Camera[udg_Temp_Int] != 1650 then
        call SetCameraFieldForPlayer( udg_X_Player_MUI, CAMERA_FIELD_TARGET_DISTANCE, udg_Z_Camera[udg_Player_Number], 0 )
        endif
        	call KillDestructable(udg_Graves[udg_Temp_Int])
        	call ShowDestructable(udg_Graves[udg_Temp_Int], false)
        call DestroyTextTag(udg_FT[udg_Temp_Int] )
        call StartTimerBJ( udg_RespawnTimer[udg_Temp_Int], false, 0.25 )
        call PauseTimerBJ( true, udg_RespawnTimer[udg_Temp_Int] )
        call DestroyTimerDialogBJ( udg_DeathTimerWindows[udg_Temp_Int] )
        call ReviveHeroLoc( udg_Heroes[udg_Temp_Int], udg_Temp_Z_Rev, true )
        call RemoveLocation (udg_Temp_Z_Rev)
        call SetUnitManaPercentBJ( udg_Heroes[udg_Temp_Int], 100.00 )
        if udg_Heroes[udg_Temp_Int] == udg_yA_Holy_Priest or  udg_Heroes[udg_Temp_Int] == udg_yH_Holy_Priest then
        call DialogDisplayBJ( false, udg_RessDialog, udg_X_Player_MUI )
        endif
        if udg_Heroes[udg_Temp_Int] == udg_yA_Resto_Sham or udg_Heroes[udg_Temp_Int] == udg_yH_Resto_Sham then
        call DialogDisplayBJ( false, udg_AncesDialog, udg_X_Player_MUI )
        endif
        if udg_WasBansheeA == true then
        if udg_TalentChoices[ GetPlayerId(GetOwningPlayer( udg_Heroes[udg_Temp_Int] )) * udg_NUM_OF_TC + 4 ]  then
        call BlzSetUnitBaseDamage(  udg_Heroes[udg_Temp_Int], BlzGetUnitBaseDamage(udg_Heroes[udg_Temp_Int],0)+25, 0)
        set udg_WasBansheeA = false
        endif
        endif
        if udg_IsARezz == false then
        call SetUnitInvulnerable( GetTriggerUnit(), true )
        call TriggerSleepAction( 3.50 )
        call SetUnitInvulnerable( GetTriggerUnit(), false )
        endif
        set udg_DoRevive = false
        set udg_IsARezz = false
    else
    endif
endfunction

