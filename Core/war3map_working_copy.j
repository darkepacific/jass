//===========================================================================
// Trigger: Lava Pit
//===========================================================================
function Trig_Lava_Pit_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0DX' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) != 'e00X' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Lava_Pit_Actions takes nothing returns nothing
    set udg_Temp_Unit_Point = GetSpellTargetLoc()
    call IssueImmediateOrderBJ( GetTriggerUnit(), "stop" )
    call BlzStartUnitAbilityCooldown( GetTriggerUnit(), GetSpellAbilityId(), 11.00 )
    call CreateNUnitsAtLoc( 1, 'e00X', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 9.09, 'BTLF', GetLastCreatedUnit() )
    call SetUnitAbilityLevelSwapped( 'A0DX', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0DX', GetTriggerUnit()) )
    call SetTempUnitToOwningHero()
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - 0 ))
    set udg_RealStatCalc = ( 2.00 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A0DO', udg_Temp_Unit) * 110 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 110 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
        call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(GetLastCreatedUnit(), 'A0DX'), ABILITY_RLF_FULL_DAMAGE_AMOUNT_NVC5, ( GetUnitAbilityLevel(GetLastCreatedUnit(), 'A0DX') - 1 ), udg_RealStatCalc )
    call IssuePointOrderLocBJ( GetLastCreatedUnit(), "volcano", udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
endfunction

//===========================================================================
function InitTrig_Lava_Pit takes nothing returns nothing
    set gg_trg_Lava_Pit = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Lava_Pit, EVENT_PLAYER_UNIT_SPELL_CHANNEL )
    call TriggerAddCondition( gg_trg_Lava_Pit, Condition( function Trig_Lava_Pit_Conditions ) )
    call TriggerAddAction( gg_trg_Lava_Pit, function Trig_Lava_Pit_Actions )
endfunction

//===========================================================================
// Trigger: Earth Shock
//
// Make this ability check if MS is less than 270, if it is deal crit damage
//===========================================================================
function Trig_Earth_Shock_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A09S' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Earth_Shock_Func008Func001C takes nothing returns boolean
    if ( ( GetUnitMoveSpeed(GetSpellTargetUnit()) < GetUnitDefaultMoveSpeed(GetSpellTargetUnit()) ) ) then
        return true
    endif
    if ( ( udg_Temp_Bool == true ) ) then
        return true
    endif
    return false
endfunction

function Trig_Earth_Shock_Func008C takes nothing returns boolean
    if ( not Trig_Earth_Shock_Func008Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Earth_Shock_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 3.00 * udg_RealStatCalc )
    call UnitDamageTargetBJ( GetTriggerUnit(), GetSpellTargetUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    // Echo
    call EchoOfTheElements()
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 0 ] or udg_Temp_Bool  then
    if ( Trig_Earth_Shock_Func008C() ) then
        set udg_RealStatCalc = ( 3.00 * I2R(GetHeroStatBJ(bj_HEROSTAT_INT, GetSpellAbilityUnit(), true)) )
        call UnitDamageTargetBJ( GetTriggerUnit(), GetSpellTargetUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_LIGHTNING )
        call CreateTextTagUnitBJ( ( I2S(R2I(udg_RealStatCalc)) + " Crit!" ), GetSpellTargetUnit(), 10.00, 9.00, 100, 0.00, 0.00, 0 )
        call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64, 0.00 )
        call cleanUpText( 1.2, 0.8)
        call ShowTextTagForceBJ( true, GetLastCreatedTextTag(), GetPlayersAll() )
    else
    endif
    endif
endfunction

//===========================================================================
function InitTrig_Earth_Shock takes nothing returns nothing
    set gg_trg_Earth_Shock = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Earth_Shock, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Earth_Shock, Condition( function Trig_Earth_Shock_Conditions ) )
    call TriggerAddAction( gg_trg_Earth_Shock, function Trig_Earth_Shock_Actions )
endfunction

//===========================================================================
// Trigger: Healing Wave
//
//  call BlzSetAbilityIntegerLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A03C'), ABILITY_ILF_NUMBER_OF_TARGETS_HIT, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), 6 )
// call BlzGetAbilityIntegerLevelField(BlzGetUnitAbility(udg_Temp_Unit, 'A03C'), ABILITY_ILF_NUMBER_OF_TARGETS_HIT, (  GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ))
// 	set udg_Temp_Int = BlzGetAbilityIntegerLevelField(BlzGetUnitAbility(udg_Temp_Unit, 'A03C'), ABILITY_ILF_NUMBER_OF_TARGETS_HIT, (  GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ))
// 	set udg_Temp_Int = R2I ( I2R( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ) /2 + 3 )
//===========================================================================
function Trig_Healing_Wave_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A03C' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Healing_Wave_Func021Func001C takes nothing returns boolean
    if ( ( UnitHasBuffBJ(GetSpellTargetUnit(), 'B019') == true ) ) then
        return true
    endif
    if ( ( udg_Temp_Bool == true ) ) then
        return true
    endif
    return false
endfunction

function Trig_Healing_Wave_Func021C takes nothing returns boolean
    if ( not Trig_Healing_Wave_Func021Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Healing_Wave_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A03C', udg_Temp_Unit) * 80 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 80 )
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 3.00 * udg_RealStatCalc )
    set udg_RealStatCalc = ( ( 1.00 * I2R(udg_HeroStatCalc) ) + udg_RealStatCalc )
    call ChaliceSet()
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A03C'), ABILITY_RLF_DAMAGE_PER_TARGET_OCL1, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), udg_RealStatCalc )
    // Talent Set
    	set udg_Temp_Int = R2I ( I2R( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ) /2 + 3 )
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 12 ]  then
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A03C'), ABILITY_RLF_DAMAGE_REDUCTION_PER_TARGET, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), 0.15 )
    set udg_Temp_Int = ( udg_Temp_Int + 1 )
     call BlzSetAbilityIntegerLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A03C'), ABILITY_ILF_NUMBER_OF_TARGETS_HIT, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), udg_Temp_Int )
    else
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A03C'), ABILITY_RLF_DAMAGE_REDUCTION_PER_TARGET, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), 0.30 )
     call BlzSetAbilityIntegerLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A03C'), ABILITY_ILF_NUMBER_OF_TARGETS_HIT, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), udg_Temp_Int )
    endif
    // Echo
    call EchoOfTheElements()
    if ( Trig_Healing_Wave_Func021C() ) then
        set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
        call CreateNUnitsAtLoc( 1, 'e01R', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, GetUnitFacing(GetTriggerUnit()) )
        call RemoveLocation (udg_Temp_Unit_Point)
        call SetUnitAbilityLevelSwapped( 'A0A6', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A03C', GetTriggerUnit()) )
        set udg_Temp_Unit = GetLastCreatedUnit()
        set udg_RealStatCalc = ( 0.50 * udg_RealStatCalc )
        call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A0A6'), ABILITY_RLF_DAMAGE_PER_TARGET_OCL1, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), udg_RealStatCalc )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "healingwave", GetSpellTargetUnit() )
        call UnitApplyTimedLifeBJ( 0.80, 'BTLF', GetLastCreatedUnit() )
    else
    endif
endfunction

//===========================================================================
function InitTrig_Healing_Wave takes nothing returns nothing
    set gg_trg_Healing_Wave = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Healing_Wave, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Healing_Wave, Condition( function Trig_Healing_Wave_Conditions ) )
    call TriggerAddAction( gg_trg_Healing_Wave, function Trig_Healing_Wave_Actions )
endfunction

//===========================================================================
// Trigger: Riptide
//===========================================================================
function Trig_Riptide_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0AD' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Riptide_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    // Instant
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 2.00 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A0AD', udg_Temp_Unit) * 40 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    call ChaliceSet()
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 13 ]  then
    set udg_RealStatCalc = ( 1.30 * udg_RealStatCalc )
    endif
    call SetUnitLifeBJ( GetSpellTargetUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetSpellTargetUnit()) + udg_RealStatCalc ) )
    // DoT
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 2.00 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A0AD', udg_Temp_Unit) * 50 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    call ChaliceSet()
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 13 ]  then
    set udg_RealStatCalc = ( 1.30 * udg_RealStatCalc )
    endif
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A0AD'), ABILITY_RLF_HIT_POINTS_GAINED_REJ1, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), udg_RealStatCalc )
    // Effect
    call AddSpecialEffectTargetUnitBJ( "origin", GetSpellTargetUnit(), "war3mapImported\\AquaSpike_72_Short_Tail_80_SuperShort.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    return
    call AddSpecialEffectTargetUnitBJ( "origin", GetSpellTargetUnit(), "war3mapImported\\WaterEnchant.mdx" )
endfunction

//===========================================================================
function InitTrig_Riptide takes nothing returns nothing
    set gg_trg_Riptide = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Riptide, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Riptide, Condition( function Trig_Riptide_Conditions ) )
    call TriggerAddAction( gg_trg_Riptide, function Trig_Riptide_Actions )
endfunction

