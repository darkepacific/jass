                call DisableTrigger( gg_trg_U_Find_Dolly )
            else
            endif
            call DisableTrigger( gg_trg_S_or_U_Find_Dolly_H_by_Acquire )
            call DisableTrigger( GetTriggeringTrigger() )
            call TriggerSleepAction( 1.75 )
            call PlaySoundOnUnitBJ( gg_snd_H01VillagerC37, 100.00, gg_unit_n03L_1843 )
            call CreateTextTagUnitBJ( "TRIGSTR_3037", gg_unit_n03L_1843, 0.00, 8.00, 100.00, 100.00, 0.00, 0 )
            call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
            call cleanUpText(1.2, 0.8)
            return
        else
        endif
        set udg_Bag_Iterator = udg_Bag_Iterator + 1
    endloop
                       endif
endfunction

