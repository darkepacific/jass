//===========================================================================
// Trigger: E TLN
//
// Change to Fel's Essence
//===========================================================================
function Trig_E_TLN_Func007Func001C takes nothing returns boolean
    if ( not ( GetItemTypeId(udg_P_Items[( udg_Bag_Num + udg_Bag_Iterator )]) == udg_ItemTypeCheck ) ) then
        return false
    endif
    return true
endfunction

function Trig_E_TLN_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 109
                       if IsHordeHero( GetTriggerUnit() ) then
    call SetBagNumber( GetOwningPlayer(GetTriggerUnit()) )
    set udg_ItemTypeCheck = 'I08O'
    set udg_Bag_Iterator = 1
    loop
        exitwhen udg_Bag_Iterator > udg_BAG_LOOP_MAX
        if ( Trig_E_TLN_Func007Func001C() ) then
            if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
            call FlashQuestDialogButtonBJ(  )
            endif
            call QuestItemSetCompletedBJ( udg_QuestReqs[109], true )
            call QuestSetCompletedBJ( udg_Quests[109], true )
            call DestroyEffectBJ( udg_QuestMarks[109] )
            call DestroyMinimapIcon( udg_MiniMapIcon[109] )
            // Clean Up Items
            call CleanUpItems( udg_ItemTypeCheck )
            // Rewards
            set udg_XP = udg_QUEST_XP[udg_Temp_Int]
            set udg_Gold = udg_QUEST_GOLD[udg_Temp_Int]
            set udg_LVL_Req = udg_QUEST_LVL_REQ[udg_Temp_Int]
            set udg_TempString = "The Lady's Necklace"
            call TriggerExecute( gg_trg_Quest_Complete_H )
            // Lament of the Highborne
            call DisableTrigger( gg_trg_U_TLN)
            call DisableTrigger( GetTriggeringTrigger() )
            call TriggerSleepAction( 1.60 )
            if IsPlayerInForce( GetLocalPlayer(), udg_HordePlayers) then
            call ClearMapMusicBJ(  )
            call StopMusicBJ( false )
            call EndThematicMusicBJ(  )
            call PlayThematicMusicBJ( "war3mapImported\\Lament_of_the_Highborne.mp3" )
            endif
            call Lament_of_the_Highborne()
            return
        else
        endif
        set udg_Bag_Iterator = udg_Bag_Iterator + 1
    endloop
                       endif
endfunction

