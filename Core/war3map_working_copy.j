function Trig_Advanced_Blink_Func009C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A08B', GetTriggerUnit()) >= 6 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Advanced_Blink_Func010Func012C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'H02Q' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Advanced_Blink_Func010Func014C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'H02Q' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Advanced_Blink_Func010C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A08B', GetTriggerUnit()) >= 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Advanced_Blink_Func011C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A08B', GetTriggerUnit()) >= 5 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Advanced_Blink_Actions takes nothing returns nothing
    local location Target
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
    set Target = udg_Temp_Unit_Point
    call CreateNUnitsAtLoc( 1, 'e02A', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, GetUnitFacing(GetTriggerUnit()) )
    call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
    call IssueTargetOrderById(bj_lastCreatedUnit, 852274, GetTriggerUnit())
    if ( Trig_Advanced_Blink_Func009C() ) then
        call BlzEndUnitAbilityCooldown( GetTriggerUnit(), 'A00G' )
        call BlzEndUnitAbilityCooldown( GetTriggerUnit(), 'A00H' )
        call BlzEndUnitAbilityCooldown( GetTriggerUnit(), 'A08A' )
        call BlzEndUnitAbilityCooldown( GetTriggerUnit(), 'A04I' )
        call BlzEndUnitAbilityCooldown( GetTriggerUnit(), 'Aslo' )
    else
    endif
    if ( Trig_Advanced_Blink_Func010C() ) then
        set udg_Temp_Unit_Point = Target
        call CreateNUnitsAtLoc( 1, 'e02A', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, GetUnitFacing(GetTriggerUnit()) )
        if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 10 ]  then
        call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(GetLastCreatedUnit(), 'Aivs'), ABILITY_RLF_DURATION_HERO, 0, 5.5 )
        else
        call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(GetLastCreatedUnit(), 'Aivs'), ABILITY_RLF_DURATION_HERO, 0, 2.5 )
        endif
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "invisibility", GetTriggerUnit() )
        call UnitApplyTimedLifeBJ( 1.50, 'BTLF', GetLastCreatedUnit() )
        call SetUnitMoveSpeed( GetTriggerUnit(), ( GetUnitMoveSpeed(GetTriggerUnit()) * 1.25 ) )
        call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "Abilities\\Spells\\Items\\AIsp\\SpeedTarget.mdl" )
        if ( Trig_Advanced_Blink_Func010Func012C() ) then
            set udg_Charge_SE[9] = GetLastCreatedEffectBJ()
        else
            set udg_Charge_SE[14] = GetLastCreatedEffectBJ()
        endif
        call TriggerSleepAction( 2.50 )
        if ( Trig_Advanced_Blink_Func010Func014C() ) then
            call DestroyEffectBJ( udg_Charge_SE[9] )
        else
            call DestroyEffectBJ( udg_Charge_SE[14] )
        endif
        call SetUnitMoveSpeed( GetTriggerUnit(), GetUnitDefaultMoveSpeed(GetTriggerUnit()) )
    else
    endif
    if ( Trig_Advanced_Blink_Func011C() ) then
        call TriggerSleepAction( 0.10 )
        set udg_Temp_Unit_Point = Target
        call CreateNUnitsAtLoc( 1, 'e02A', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, GetUnitFacing(GetTriggerUnit()) )
        call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
        call IssueTargetOrderById(bj_lastCreatedUnit, 852274, GetTriggerUnit())
        call RemoveLocation (udg_Temp_Unit_Point)
    else
        set udg_Temp_Unit_Point = Target
        call RemoveLocation (udg_Temp_Unit_Point)
    endif
    set Target = null
endfunction

