    set gg_trg_Nathanos = CreateTrigger(  )
    call TriggerRegisterUnitEvent( gg_trg_Nathanos, gg_unit_H027_1820, EVENT_UNIT_DEATH )
    call TriggerAddAction( gg_trg_Nathanos, function Trig_Nathanos_Actions )
endfunction

