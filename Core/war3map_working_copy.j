function Trig_U_BBW_Func011Func005Func008C takes nothing returns boolean
    if ( not ( udg_Player_Music[udg_Player_Number] != "Wetlands" ) ) then
        return false
    endif
    if ( not ( udg_Player_Music[udg_Player_Number] != "Greenwardens" ) ) then
        return false
    endif
    if ( not ( udg_Player_Music[udg_Player_Number] != "Sludge Cave Wetlands" ) ) then
