function Trig_Magistrate_Maleb_Dies_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'n02L' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Magistrate_Maleb_Dies_Func006Func003C takes nothing returns boolean
    if ( not ( IsTriggerEnabled(gg_trg_E_CWE) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Magistrate_Maleb_Dies_Func006C takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_Quests[41]) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Magistrate_Maleb_Dies_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    call TriggerSleepAction( 150.00 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_The_Chillwind_Effort)
    call CreateNUnitsAtLoc( 1, 'n02L', Player(1), udg_Temp_Unit_Point, 19.00 )
    call RemoveLocation (udg_Temp_Unit_Point)
    if ( Trig_Magistrate_Maleb_Dies_Func006C() ) then
        call DestroyEffectBJ( udg_QuestMarks[41] )
        set udg_TempString = ""
        if ( Trig_Magistrate_Maleb_Dies_Func006Func003C() ) then
            if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
            set udg_TempString = udg_ExclamationMark
            endif
            call AddSpecialEffectTargetUnitBJ( "overhead", GetLastCreatedUnit(), udg_TempString )
        else
            if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
            set udg_TempString = udg_QuestionMark
            endif
            call AddSpecialEffectTargetUnitBJ( "overhead", gg_unit_n00N_0382, udg_TempString )
        endif
        set udg_QuestMarks[41] = GetLastCreatedEffectBJ()
    else
    endif
    set udg_Temp_Unit_Point = null
endfunction

