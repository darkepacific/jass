    call TriggerAddCondition( gg_trg_Durnholde_Keep, Condition( function Trig_Durnholde_Keep_Conditions ) )
    call TriggerAddAction( gg_trg_Durnholde_Keep, function Trig_Durnholde_Keep_Actions )
endfunction

