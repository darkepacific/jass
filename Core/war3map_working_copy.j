//===========================================================================
function Trig_QuelThalas_Gate_Func017Func001C takes nothing returns boolean
    if ( not ( GetItemTypeId(udg_P_Items[( udg_Bag_Num + udg_Bag_Iterator )]) == udg_ItemTypeCheck ) ) then
        return false
    endif
    return true
endfunction

function Trig_QuelThalas_Gate_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    // Are they a friend?
                       if IsHordeHero( GetTriggerUnit() ) then
    call ModifyGateBJ( bj_GATEOPERATION_OPEN, gg_dest_LTe1_1974 )
    call PlaySoundOnUnitBJ( gg_snd_BattleNetDoorsStereo2, 100.00, GetEnteringUnit() )
    call TriggerSleepAction( 10.00 )
    call ModifyGateBJ( bj_GATEOPERATION_CLOSE, gg_dest_LTe1_1974 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_BE_Gate)
    call PlaySoundAtPointBJ( gg_snd_BattlenetBirth1, 100, udg_Temp_Unit_Point, 0 )
    call RemoveLocation (udg_Temp_Unit_Point)
    return
                       endif
    // Do they have the Desired Item
                       if IsAllianceHero( GetTriggerUnit() ) then
    call SetBagNumber( GetOwningPlayer(GetTriggerUnit()) )
    set udg_ItemTypeCheck = 'kysn'
    set udg_Bag_Iterator = 1
    loop
        exitwhen udg_Bag_Iterator > udg_BAG_LOOP_MAX
        if ( Trig_QuelThalas_Gate_Func017Func001C() ) then
            call CleanUpItems(udg_ItemTypeCheck)
            call ModifyGateBJ( bj_GATEOPERATION_OPEN, gg_dest_LTe1_1974 )
            call PlaySoundOnUnitBJ( gg_snd_BattleNetDoorsStereo2, 100.00, GetEnteringUnit() )
            call DisableTrigger( GetTriggeringTrigger() )
        else
        endif
        set udg_Bag_Iterator = udg_Bag_Iterator + 1
    endloop
                       endif
    set udg_Temp_Unit_Point = null
endfunction

