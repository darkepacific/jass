        set udg_Temp_Unit = attacker
        call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "Abilities\\Weapons\\RedDragonBreath\\RedDragonMissile.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call AddSpecialEffectTargetUnitBJ( "overhead", udg_Temp_Unit, "Abilities\\Weapons\\RedDragonBreath\\RedDragonMissile.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
