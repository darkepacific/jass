function InitTrig_Wild_Growth takes nothing returns nothing
    set gg_trg_Wild_Growth = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Wild_Growth, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Wild_Growth, Condition( function Trig_Wild_Growth_Conditions ) )
    call TriggerAddAction( gg_trg_Wild_Growth, function Trig_Wild_Growth_Actions )
endfunction

//===========================================================================
// Trigger: Wild Growth Tick NE
//
// RealStatCalc - Stores the Actual Damage Done
// HeroStatCalc - Stores the Scaling Damage
// TempReal - Stores the Avenging Crusader Multiplier
//===========================================================================
function Trig_Wild_Growth_Tick_NE_Func015Func007Func003C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetEnumUnit()) == 'e01D' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEnumUnit()) == 'e01F' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEnumUnit()) == 'e01G' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEnumUnit()) == 'e01H' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEnumUnit()) == 'e01K' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEnumUnit()) == 'e01L' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Wild_Growth_Tick_NE_Func015Func007C takes nothing returns boolean
    if ( not Trig_Wild_Growth_Tick_NE_Func015Func007Func003C() ) then
        return false
    endif
    return true
endfunction

function Trig_Wild_Growth_Tick_NE_Func015A takes nothing returns nothing
    if IsUnitTargetableAlly( GetEnumUnit(), udg_Temp_Unit ) then
    call SetUnitLifeBJ( GetEnumUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetEnumUnit()) + udg_RealStatCalc ) )
    call AddSpecialEffectTargetUnitBJ( "chest", GetEnumUnit(), "war3mapImported\\Heal Green.mdx" )
    call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 1.50 )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.70 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    if ( Trig_Wild_Growth_Tick_NE_Func015Func007C() ) then
        call BlzSetUnitWeaponRealFieldBJ( GetEnumUnit(), UNIT_WEAPON_RF_ATTACK_BASE_COOLDOWN, 0, 0.90 )
        call BlzSetUnitRealFieldBJ( GetEnumUnit(), UNIT_RF_SPEED, 330.00 )
    else
    endif
    endif
endfunction

function Trig_Wild_Growth_Tick_NE_Func022C takes nothing returns boolean
    if ( not ( udg_SpellTicks[udg_Temp_Int] == udg_Temp_Int2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Wild_Growth_Tick_NE_Actions takes nothing returns nothing
    set udg_Temp_Unit = udg_yA_Bal_Druid
    set udg_Temp_Int = 22
    // real stat calc
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 1.00 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A033', udg_Temp_Unit) * 25 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    call ChaliceSet()
    // scale for 10% dc per subsequent tick
    set udg_RealStatCalc = ( ( 0.10 * ( 11.00 - I2R(udg_SpellTicks[udg_Temp_Int]) ) ) * udg_RealStatCalc )
    // real stat calc has real damage value, and healing bonus
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Shaman_Eq_Ls[7])
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(240.00, udg_Temp_Unit_Point), function Trig_Wild_Growth_Tick_NE_Func015A )
    call RemoveLocation (udg_Temp_Unit_Point)
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 13 ]  then
    set udg_Temp_Int2 = 9
    else
    set udg_Temp_Int2 = 7
    endif
    if ( Trig_Wild_Growth_Tick_NE_Func022C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
    else
        set udg_SpellTicks[udg_Temp_Int] = ( udg_SpellTicks[udg_Temp_Int] + 1 )
    endif
endfunction

//===========================================================================
function InitTrig_Wild_Growth_Tick_NE takes nothing returns nothing
    set gg_trg_Wild_Growth_Tick_NE = CreateTrigger(  )
    call DisableTrigger( gg_trg_Wild_Growth_Tick_NE )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Wild_Growth_Tick_NE, 1.00 )
    call TriggerAddAction( gg_trg_Wild_Growth_Tick_NE, function Trig_Wild_Growth_Tick_NE_Actions )
endfunction

