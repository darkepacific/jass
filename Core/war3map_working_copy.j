    call RemoveLocation (udg_Temp_Polar_Point)
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, GetRandomReal(256.00, 300.00), GetRandomReal(135.00, 405.00))
    call CreateNUnitsAtLoc( 1, 'n05W', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Temp_Polar_Point, bj_UNIT_FACING )
    call UnitApplyTimedLife(GetLastCreatedUnit(), 'BTLF', 120.0)
    call AddSpecialEffectLocBJ( udg_Temp_Polar_Point, "war3mapImported\\Void Teleport Target.mdx" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 2.00 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call RemoveLocation (udg_Temp_Polar_Point)
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 15.00 )
    call EnableTrigger( GetTriggeringTrigger() )
    set udg_Temp_Unit_Point = null
    set udg_Temp_Polar_Point = null
