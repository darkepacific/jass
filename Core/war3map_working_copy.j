//===========================================================================
// Trigger: VMR to OBS
//===========================================================================
function Trig_VMR_to_OBS_Func051C takes nothing returns boolean
    if ( not ( GetItemTypeId(GetSoldItem()) == 'I08V' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetSellingUnit()) == 'u03T' ) ) then
        return false
    endif
    return true
endfunction

function Trig_VMR_to_OBS_Conditions takes nothing returns boolean
    if ( not Trig_VMR_to_OBS_Func051C() ) then
        return false
    endif
    return true
endfunction

function Trig_VMR_to_OBS_Func002Func001C takes nothing returns boolean
    if ( not ( GetBuyingUnit() == udg_Heroes[GetForLoopIndexA()] ) ) then
        return false
    endif
    return true
endfunction

function Trig_VMR_to_OBS_Actions takes nothing returns nothing
    local integer p = 0
    set bj_forLoopAIndex = 0
    set bj_forLoopAIndexEnd = 7
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_VMR_to_OBS_Func002Func001C() ) then
            set udg_Player_Number = GetForLoopIndexA()
            exitwhen true
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    set udg_X_Player_MUI = GetOwningPlayer(udg_Heroes[udg_Player_Number])
    set p = udg_Player_Number
    //  
    call RemoveItem( GetSoldItem() )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Alliance_Heroes_During_Flight)
    call SetUnitPositionLoc( GetBuyingUnit(), udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_FP_Vermillion_Redoubt)
    call CreateNUnitsAtLoc( 1, 'u03U', GetOwningPlayer(GetBuyingUnit()), udg_Temp_Unit_Point, bj_UNIT_FACING )
    call RemoveLocation (udg_Temp_Unit_Point)
    //  
    // Disable Player Control
    call PauseAddInvuln( udg_Heroes[ udg_Player_Number ], null)
    set udg_FP_Bats_n_Gryphons[udg_Player_Number] = GetLastCreatedUnit()
    call CameraSetupApplyForPlayer( true, gg_cam_FP_VMR_to_OBS, udg_X_Player_MUI, 0.25 )
    call TriggerSleepAction( 0.25 )
    //  
    set udg_Player_Number = p
    set udg_X_Player_MUI = GetOwningPlayer(udg_Heroes[udg_Player_Number])
    //  
    //  
    // CHANGE HERE: Assign Temp Unit & Order it to Fly
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_FP_Obsidian_Forest)
    call SetCameraTargetControllerNoZForPlayer( udg_X_Player_MUI, udg_FP_Bats_n_Gryphons[udg_Player_Number], 0, 0, true )
    call IssuePointOrderLocBJ( udg_FP_Bats_n_Gryphons[udg_Player_Number], "move", udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 14.50 )
    //  
    set udg_Player_Number = p
    set udg_X_Player_MUI = GetOwningPlayer(udg_Heroes[udg_Player_Number])
    //  
    call CameraSetupApplyForPlayer( true, gg_cam_FP_Obsidian_Forest_Landing, udg_X_Player_MUI, 0.25 )
    call TriggerSleepAction( 0.25 )
    //  
    //  
    set udg_Player_Number = p
    set udg_X_Player_MUI = GetOwningPlayer(udg_Heroes[udg_Player_Number])
    //  
    // Kill Temp Unit & Enable
    call UnPauseAddInvuln( udg_Heroes[ udg_Player_Number ], null)
    call KillUnit( udg_FP_Bats_n_Gryphons[udg_Player_Number] )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_FP_Obsidian_Forest)
    call SetUnitPositionLoc( udg_Heroes[udg_Player_Number], udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call PlaySoundBJ( gg_snd_Hint )
    call ForceAddPlayerSimple( udg_X_Player_MUI, udg_Player_Message_Group )
    call DisplayTextToForce( udg_Player_Message_Group, "TRIGSTR_10147" )
    call ForceRemovePlayerSimple( udg_X_Player_MUI, udg_Player_Message_Group )
endfunction

//===========================================================================
function InitTrig_VMR_to_OBS takes nothing returns nothing
    set gg_trg_VMR_to_OBS = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_VMR_to_OBS, EVENT_PLAYER_UNIT_SELL_ITEM )
    call TriggerAddCondition( gg_trg_VMR_to_OBS, Condition( function Trig_VMR_to_OBS_Conditions ) )
    call TriggerAddAction( gg_trg_VMR_to_OBS, function Trig_VMR_to_OBS_Actions )
endfunction

//===========================================================================
// Trigger: IF to SFO
//===========================================================================
function Trig_IF_to_SFO_Func051C takes nothing returns boolean
    if ( not ( GetItemTypeId(GetSoldItem()) == 'I065' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetSellingUnit()) == 'u01E' ) ) then
        return false
    endif
    return true
endfunction

function Trig_IF_to_SFO_Conditions takes nothing returns boolean
    if ( not Trig_IF_to_SFO_Func051C() ) then
        return false
    endif
    return true
endfunction

function Trig_IF_to_SFO_Func003Func001C takes nothing returns boolean
    if ( not ( GetBuyingUnit() == udg_Heroes[GetForLoopIndexA()] ) ) then
        return false
    endif
    return true
endfunction

function Trig_IF_to_SFO_Actions takes nothing returns nothing
    local integer p
    set p = 0
    set bj_forLoopAIndex = 0
    set bj_forLoopAIndexEnd = 7
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_IF_to_SFO_Func003Func001C() ) then
            set udg_Player_Number = GetForLoopIndexA()
            exitwhen true
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    set udg_X_Player_MUI = GetOwningPlayer(udg_Heroes[udg_Player_Number])
    set p = udg_Player_Number
    //  
    call RemoveItem( GetSoldItem() )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Alliance_Heroes_During_Flight)
    call SetUnitPositionLoc( GetBuyingUnit(), udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_FP_IF)
    call CreateNUnitsAtLoc( 1, 'u01A', udg_X_Player_MUI, udg_Temp_Unit_Point, bj_UNIT_FACING )
    call RemoveLocation (udg_Temp_Unit_Point)
    //  
    // Disable Player Control
    call PauseAddInvuln( udg_Heroes[ udg_Player_Number ], null)
    set udg_FP_Bats_n_Gryphons[udg_Player_Number] = GetLastCreatedUnit()
    call CameraSetupApplyForPlayer( true, gg_cam_FP_IF_to_SFO, udg_X_Player_MUI, 0.25 )
    call TriggerSleepAction( 0.25 )
    //  
    set udg_Player_Number = p
    set udg_X_Player_MUI = GetOwningPlayer(udg_Heroes[udg_Player_Number])
    //  
    // CHANGE HERE: Assign Temp Unit & Order it to Fly
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Hearth_Stormfeather_Outpost_5)
    call SetCameraTargetControllerNoZForPlayer( udg_X_Player_MUI, udg_FP_Bats_n_Gryphons[udg_Player_Number], 0, 0, true )
    call IssuePointOrderLocBJ( udg_FP_Bats_n_Gryphons[udg_Player_Number], "move", udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 16.00 )
    //  
    set udg_Player_Number = p
    set udg_X_Player_MUI = GetOwningPlayer(udg_Heroes[udg_Player_Number])
    //  
    call CameraSetupApplyForPlayer( true, gg_cam_Hearth_Stormfeather_Outpost, udg_X_Player_MUI, 0.25 )
    call TriggerSleepAction( 0.25 )
    //  
    set udg_Player_Number = p
    set udg_X_Player_MUI = GetOwningPlayer(udg_Heroes[udg_Player_Number])
    //  
    // Kill Temp Unit & Enable
    call UnPauseAddInvuln( udg_Heroes[ udg_Player_Number ], null)
    call KillUnit( udg_FP_Bats_n_Gryphons[udg_Player_Number] )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Hearth_Stormfeather_Outpost_5)
    call SetUnitPositionLoc( udg_Heroes[udg_Player_Number], udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call PlaySoundBJ( gg_snd_Hint )
    call ForceAddPlayerSimple( udg_X_Player_MUI, udg_Player_Message_Group )
    call DisplayTextToForce( udg_Player_Message_Group, "TRIGSTR_9996" )
    call ForceRemovePlayerSimple( udg_X_Player_MUI, udg_Player_Message_Group )
    set udg_FP_Bats_n_Gryphons[udg_Player_Number] = null
endfunction

