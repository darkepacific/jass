//===========================================================================
// Trigger: Keepers of the Nightmare
//===========================================================================
function Trig_Keepers_of_the_Nightmare_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'E02Y' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Keepers_of_the_Nightmare_Func003Func001C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 2) > 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Keepers_of_the_Nightmare_Func003C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 2) > 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Keepers_of_the_Nightmare_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    call TriggerSleepAction( 180.00 )
    if ( Trig_Keepers_of_the_Nightmare_Func003C() ) then
        if ( Trig_Keepers_of_the_Nightmare_Func003Func001C() ) then
            set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_Z_Suramar_North)
            call ReviveHeroLoc( GetTriggerUnit(), udg_Temp_Unit_Point, true )
            call RemoveLocation (udg_Temp_Unit_Point)
            call SetUnitManaPercentBJ( GetTriggerUnit(), 100.00 )
        else
            set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_Z_Suramar)
            call ReviveHeroLoc( GetTriggerUnit(), udg_Temp_Unit_Point, true )
            call RemoveLocation (udg_Temp_Unit_Point)
            call SetUnitManaPercentBJ( GetTriggerUnit(), 100.00 )
        endif
    else
    endif
    set udg_Temp_Unit_Point = null
endfunction

//===========================================================================
function InitTrig_Keepers_of_the_Nightmare takes nothing returns nothing
    set gg_trg_Keepers_of_the_Nightmare = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Keepers_of_the_Nightmare, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_Keepers_of_the_Nightmare, Condition( function Trig_Keepers_of_the_Nightmare_Conditions ) )
    call TriggerAddAction( gg_trg_Keepers_of_the_Nightmare, function Trig_Keepers_of_the_Nightmare_Actions )
endfunction

//===========================================================================
// Trigger: Fel Reavers
//===========================================================================
function Trig_Fel_Reavers_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'E02X' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fel_Reavers_Func004C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 2) > 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fel_Reavers_Func007Func001C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 2) > 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fel_Reavers_Func007C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 3) > 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fel_Reavers_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    set udg_Temp_Unit_Point = GetUnitLoc(GetDyingUnit())
    if ( Trig_Fel_Reavers_Func004C() ) then
        call CreateItemLoc( 'I02T', udg_Temp_Unit_Point )
    else
        call CreateItemLoc( 'I08F', udg_Temp_Unit_Point )
    endif
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 180.00 )
    if ( Trig_Fel_Reavers_Func007C() ) then
        if ( Trig_Fel_Reavers_Func007Func001C() ) then
            set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_Z_Suramar_North)
            call ReviveHeroLoc( GetTriggerUnit(), udg_Temp_Unit_Point, true )
            call RemoveLocation (udg_Temp_Unit_Point)
            set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_Z_Suramar)
            call IssuePointOrderLocBJ( GetTriggerUnit(), "move", udg_Temp_Unit_Point )
        else
            set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_Z_Suramar)
            call ReviveHeroLoc( GetTriggerUnit(), udg_Temp_Unit_Point, true )
            call RemoveLocation (udg_Temp_Unit_Point)
            set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_Z_Suramar_North)
            call IssuePointOrderLocBJ( GetTriggerUnit(), "move", udg_Temp_Unit_Point )
        endif
    else
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Sargeras)
        call ReviveHeroLoc( GetTriggerUnit(), udg_Temp_Unit_Point, true )
        call RemoveLocation (udg_Temp_Unit_Point)
        set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_Z_Broken_Isles_Dark_Portal)
        call IssuePointOrderLocBJ( GetTriggerUnit(), "move", udg_Temp_Unit_Point )
    endif
    call RemoveLocation (udg_Temp_Unit_Point)
    call SetUnitManaPercentBJ( GetTriggerUnit(), 100.00 )
    set udg_Temp_Unit_Point = null
endfunction

//===========================================================================
function InitTrig_Fel_Reavers takes nothing returns nothing
    set gg_trg_Fel_Reavers = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Fel_Reavers, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_Fel_Reavers, Condition( function Trig_Fel_Reavers_Conditions ) )
    call TriggerAddAction( gg_trg_Fel_Reavers, function Trig_Fel_Reavers_Actions )
endfunction

