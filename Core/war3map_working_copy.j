//===========================================================================
// Trigger: Sacrifice Summon
//
// call UnitAddAbilityBJ( 'A09B', GetSummoningUnit() )
// call SetUnitAbilityLevelSwapped( 'A09B',  GetSummoningUnit() , GetUnitAbilityLevelSwapped('A01E', GetSummoningUnit()) )
//===========================================================================
function Trig_Sacrifice_Summon_Func003C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetSummoningUnit()) == 'E02Z' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetSummoningUnit()) == 'E04A' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Sacrifice_Summon_Func004C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'n03V' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'n03W' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'n03X' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'n03Y' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'n03Z' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'n040' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Sacrifice_Summon_Conditions takes nothing returns boolean
    if ( not Trig_Sacrifice_Summon_Func003C() ) then
        return false
    endif
    if ( not Trig_Sacrifice_Summon_Func004C() ) then
        return false
    endif
    return true
endfunction

function Trig_Sacrifice_Summon_Func002C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetSummoningUnit()) == 'E04A' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Sacrifice_Summon_Func024C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(GetTriggerUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Sacrifice_Summon_Actions takes nothing returns nothing
    local integer udg_o
    if ( Trig_Sacrifice_Summon_Func002C() ) then
        set udg_o = udg_z_WL_DEST_A
    else
        set udg_o = udg_z_WL_DEST_H
    endif
    set udg_SpellUnits[udg_o] = GetSummonedUnit()
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer( GetTriggerUnit() )) * udg_NUM_OF_TC + 12 ]  then
    call BlzSetUnitMaxHP( udg_SpellUnits[ udg_o], BlzGetUnitMaxHP( udg_SpellUnits[ udg_o] ) + 506 ) 
    call MaxHealthRestore( 1.0, udg_SpellUnits[ udg_o] )
    call BlzSetUnitMaxMana( udg_SpellUnits[ udg_o], BlzGetUnitMaxMana( udg_SpellUnits[ udg_o] ) + 425 ) 
    call MaxManaRestore( 1.0, udg_SpellUnits[ udg_o] )
    call BlzSetUnitArmor( udg_SpellUnits[ udg_o], BlzGetUnitArmor( udg_SpellUnits[ udg_o] ) + 6 ) 
    call BlzSetUnitBaseDamage( udg_SpellUnits[ udg_o] , BlzGetUnitBaseDamage(  udg_SpellUnits[ udg_o] , 0 ) + 420, 0)
    call UnitAddAbility( udg_SpellUnits[ udg_o] , 'ACrk' )
    call SetUnitVertexColorBJ( udg_SpellUnits[udg_o], 100, 66.00, 66.00, 0 )
    set udg_Temp_Unit_Point = GetUnitLoc(udg_SpellUnits[ udg_o ] )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\DemonicAdornment.mdx" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 1.66 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call RemoveLocation (udg_Temp_Unit_Point)
    endif
    call GameTimeWait(0.5)
    if ( Trig_Sacrifice_Summon_Func024C() ) then
        if udg_o == udg_z_WL_DEST_A then
        set udg_Temp_Unit = udg_yA_Destro_Warlock
        else
        set udg_Temp_Unit = udg_yH_Destro_Warlock
        endif
        call UnitAddAbilityBJ( 'A09B', udg_Temp_Unit )
        call SetUnitAbilityLevelSwapped( 'A09B', udg_Temp_Unit, GetUnitAbilityLevelSwapped('A09C', udg_Temp_Unit) )
        call BlzUnitDisableAbility( udg_Temp_Unit, 'A09C', true, true )
    else
    endif
endfunction

