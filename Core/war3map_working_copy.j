    if ( not ( GetSpellAbilityUnit() == udg_yH_Blood_DK ) ) then
        return false
    endif
    return true
endfunction

function Trig_Frostwyrms_Fury_Func005Func001C takes nothing returns boolean
    if ( not ( GetSpellAbilityUnit() == udg_yA_Frost_DK ) ) then
        return false
    endif
    return true
endfunction

function Trig_Frostwyrms_Fury_Func005C takes nothing returns boolean
    if ( not ( GetSpellAbilityUnit() == udg_yH_Frost_DK ) ) then
        return false
    endif
    return true
endfunction

function Trig_Frostwyrms_Fury_Actions takes nothing returns nothing
    local integer udg_Temp_Int
    local unit udg_Temp_Unit = GetTriggerUnit()
    local integer udg_HeroStatCalc
    local real udg_RealStatCalc
    if ( Trig_Frostwyrms_Fury_Func005C() ) then
        set udg_Temp_Int = 0
    else
        if ( Trig_Frostwyrms_Fury_Func005Func001C() ) then
            set udg_Temp_Int = 3
        else
            if ( Trig_Frostwyrms_Fury_Func005Func001Func002C() ) then
                set udg_Temp_Int = 9
            else
                if ( Trig_Frostwyrms_Fury_Func005Func001Func002Func001C() ) then
                    set udg_Temp_Int = 12
                else
                endif
            endif
        endif
    endif
    set udg_PathofFrost[udg_Temp_Int] = GetUnitLoc(GetTriggerUnit())
    set udg_PathofFrost[( udg_Temp_Int + 1 )] = GetSpellTargetLoc()
    set udg_PathofFrost[( udg_Temp_Int + 2 )] = PolarProjectionBJ(udg_PathofFrost[( udg_Temp_Int + 1 )], 450.00, AngleBetweenPoints(udg_PathofFrost[( udg_Temp_Int + 1 )], udg_PathofFrost[udg_Temp_Int]))
    call CreateNUnitsAtLoc( 1, 'u026', GetOwningPlayer(GetTriggerUnit()), udg_PathofFrost[( udg_Temp_Int + 2 )], bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 1.50, 'BTLF', GetLastCreatedUnit() )
    call RemoveLocation (udg_PathofFrost[(udg_Temp_Int + 2)])
    set udg_PathofFrost[( udg_Temp_Int + 2 )] = PolarProjectionBJ(udg_PathofFrost[( udg_Temp_Int + 1 )], -900.00, AngleBetweenPoints(udg_PathofFrost[( udg_Temp_Int + 1 )], udg_PathofFrost[udg_Temp_Int]))
    call IssuePointOrderLocBJ( GetLastCreatedUnit(), "move", udg_PathofFrost[( udg_Temp_Int + 2 )] )
    call RemoveLocation (udg_PathofFrost[(udg_Temp_Int + 2)])
    call TriggerSleepAction( 0.25 )
    // set stats
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_HeroStatCalc = ( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) )
    set udg_RealStatCalc = ( ( 5.00 * I2R(udg_HeroStatCalc) ) + ( ( I2R(GetUnitAbilityLevelSwapped('A073', udg_Temp_Unit)) * 100.00 ) + 100.00 ) )
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 3 ]  and ( udg_Temp_Unit == udg_yA_Frost_DK or udg_Temp_Unit == udg_yH_Frost_DK)  then
    set udg_RealStatCalc = ( udg_RealStatCalc * 1.08 )
    endif
    // end set stats
    set udg_PathofFrost[( udg_Temp_Int + 2 )] = PolarProjectionBJ(udg_PathofFrost[( udg_Temp_Int + 1 )], 200.00, AngleBetweenPoints(udg_PathofFrost[( udg_Temp_Int + 1 )], udg_PathofFrost[udg_Temp_Int]))
    call CreateNUnitsAtLoc( 1, 'e025', GetOwningPlayer(udg_Temp_Unit), udg_PathofFrost[( udg_Temp_Int + 2 )], bj_UNIT_FACING )
    set udg_Temp_Unit = GetLastCreatedUnit()
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A01F'), ABILITY_RLF_AREA_OF_EFFECT_DAMAGE, 0, udg_RealStatCalc )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "frostnova", GetLastCreatedUnit() )
    call UnitApplyTimedLifeBJ( 0.85, 'BTLF', GetLastCreatedUnit() )
    call RemoveLocation (udg_PathofFrost[(udg_Temp_Int + 2)])
    call TriggerSleepAction( 0.25 )
    // set stats
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_HeroStatCalc = ( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) )
    set udg_RealStatCalc = ( ( 5.00 * I2R(udg_HeroStatCalc) ) + ( ( I2R(GetUnitAbilityLevelSwapped('A073', udg_Temp_Unit)) * 100.00 ) + 100.00 ) )
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 3 ]  and ( udg_Temp_Unit == udg_yA_Frost_DK or udg_Temp_Unit == udg_yH_Frost_DK)  then
    set udg_RealStatCalc = ( udg_RealStatCalc * 1.08 )
    endif
    // end set stats
    call CreateNUnitsAtLoc( 1, 'e026', GetOwningPlayer(GetTriggerUnit()), udg_PathofFrost[( udg_Temp_Int + 1 )], bj_UNIT_FACING )
    call SetUnitAbilityLevelSwapped( 'A072', GetLastCreatedUnit(), R2I(udg_RealStatCalc) )
    set udg_Temp_Unit = GetLastCreatedUnit()
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A072'), ABILITY_RLF_AREA_OF_EFFECT_DAMAGE, 0, ( udg_RealStatCalc * 2.00 ) )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "frostnova", GetLastCreatedUnit() )
    call UnitApplyTimedLifeBJ( 0.85, 'BTLF', GetLastCreatedUnit() )
    call TriggerSleepAction( 0.25 )
    // set stats
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_HeroStatCalc = ( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) )
    set udg_RealStatCalc = ( ( 5.00 * I2R(udg_HeroStatCalc) ) + ( ( I2R(GetUnitAbilityLevelSwapped('A073', udg_Temp_Unit)) * 100.00 ) + 100.00 ) )
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 3 ]  and ( udg_Temp_Unit == udg_yA_Frost_DK or udg_Temp_Unit == udg_yH_Frost_DK)  then
    set udg_RealStatCalc = ( udg_RealStatCalc * 1.08 )
    endif
    // end set stats
    set udg_PathofFrost[( udg_Temp_Int + 2 )] = PolarProjectionBJ(udg_PathofFrost[( udg_Temp_Int + 1 )], -200.00, AngleBetweenPoints(udg_PathofFrost[( udg_Temp_Int + 1 )], udg_PathofFrost[udg_Temp_Int]))
    call CreateNUnitsAtLoc( 1, 'e025', GetOwningPlayer(udg_Temp_Unit), udg_PathofFrost[( udg_Temp_Int + 2 )], bj_UNIT_FACING )
    set udg_Temp_Unit = GetLastCreatedUnit()
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A01F'), ABILITY_RLF_AREA_OF_EFFECT_DAMAGE, 0, udg_RealStatCalc )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "frostnova", GetLastCreatedUnit() )
    call UnitApplyTimedLifeBJ( 0.85, 'BTLF', GetLastCreatedUnit() )
    call RemoveLocation (udg_PathofFrost[(udg_Temp_Int)])
    call RemoveLocation (udg_PathofFrost[(udg_Temp_Int + 1)])
    call RemoveLocation (udg_PathofFrost[(udg_Temp_Int + 2)])
    set udg_Temp_Unit = null
endfunction

