    set gg_trg_M_LVK_H = CreateTrigger(  )
    call TriggerRegisterTimerEventSingle( gg_trg_M_LVK_H, 10.15 )
    call TriggerAddAction( gg_trg_M_LVK_H, function Trig_M_LVK_H_Actions )
endfunction

//===========================================================================
// Trigger: S LVK H
//
// Create Quests for ALL players,
// Enable/Disable Quests for specific players
// Enable/Disabling quests does not cause desyncing.
//===========================================================================
function Trig_S_LVK_H_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 155
                       if IsHordeHero( GetTriggerUnit() ) then
    set udg_TempString = "Legendary Vry'kul"
    set udg_TempString_Quest = "Slay God-King Skovald and Hyrja"
    call TriggerExecute( gg_trg_Quest_Start_H )
    call DestroyEffectBJ( udg_QuestMarks[udg_Temp_Int] )
    // Icon 1
    call CampaignMinimapIconUnitBJ( gg_unit_H03R_2211, bj_CAMPPINGSTYLE_BOSS )
    call SetMinimapIconOrphanDestroy( GetLastCreatedMinimapIcon(), true )
    set udg_MiniMapIcon[udg_Temp_Int] = GetLastCreatedMinimapIcon()
    call SetMinimapIconVisible( udg_MiniMapIcon[udg_Temp_Int], false )
    // Icon 2
    // NEED TO CREATE ICON 2 for HYJRA
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    call FlashQuestDialogButtonBJ(  )
    call QuestSetEnabledBJ( true, udg_Quests[udg_Temp_Int] )
    call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), true )
    call SetMinimapIconVisible( udg_MiniMapIcon[udg_Temp_Int], true )
    endif
    call QuestSetCompletedBJ( udg_Quests[udg_Temp_Int], false )
    call CreateQuestItemBJ( udg_Quests[udg_Temp_Int], "TRIGSTR_10040" )
    set udg_QuestReqs[udg_Temp_Int] = GetLastCreatedQuestItemBJ()
    call DisableTrigger( GetTriggeringTrigger() )
    call EnableTrigger(gg_trg_U_LVK_H)
    call EnableTrigger(gg_trg_E_LVK_H)
                       endif
endfunction

