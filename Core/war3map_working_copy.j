function Trig_Corrupted_Dragon_Egg_Actions takes nothing returns nothing
    local unit Whelp
    local destructable Egg = GetDyingDestructable()
    if ( Trig_Corrupted_Dragon_Egg_Func003C() ) then
        set udg_Temp_Unit_Point = GetDestructableLoc(GetDyingDestructable())
        call CreateNUnitsAtLoc( 1, 'nbdr', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
        call RemoveLocation (udg_Temp_Unit_Point)
    else
    endif
    call TriggerSleepAction( 30.00 )
    call DestructableRestoreLife( Egg, 20.00, false )
    set Whelp = null
    set Egg = null
endfunction

