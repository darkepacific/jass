    if ( Trig_Bridge_Death_Func014Func001C() ) then
        call DestructableRestoreLife( GetEnumDestructable(), 100.00, true )
    else
    endif
endfunction

function Trig_Bridge_Death_Func016A takes nothing returns nothing
    call DestructableRestoreLife( GetEnumDestructable(), 100.00, true )
endfunction

function Trig_Bridge_Death_Func018A takes nothing returns nothing
    call GroupRemoveUnitSimple( GetEnumUnit(), udg_MagmaBuddies )
endfunction

function Trig_Bridge_Death_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Lava_Bride)
    call IssuePointOrderLoc( gg_unit_Nfir_1988, "move", udg_Temp_Unit_Point )
    call PlaySoundAtPointBJ( gg_snd_UI_RaidBossWarning, 70.00, udg_Temp_Unit_Point, 50.00 )
    call RemoveLocation (udg_Temp_Unit_Point)
    call EnumDestructablesInRectAll( gg_rct_Lava_Bride, function Trig_Bridge_Death_Func006A )
    call TriggerSleepAction( 0.85 )
    call EnumDestructablesInRectAll( gg_rct_Lava_Bride, function Trig_Bridge_Death_Func008A )
    call EnableTrigger( gg_trg_Magma_Bridge_Enter)
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRectAll(gg_rct_Lava_Bride), function Trig_Bridge_Death_Func011A )
    call EnableTrigger( gg_trg_Magma_Damage )
    call TriggerSleepAction( 12.00 )
    call EnumDestructablesInRectAll( gg_rct_Lava_Bride, function Trig_Bridge_Death_Func014A )
    call TriggerSleepAction( 0.75 )
    call EnumDestructablesInRectAll( gg_rct_Lava_Bride, function Trig_Bridge_Death_Func016A )
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRectAll(gg_rct_Lava_Bride), function Trig_Bridge_Death_Func018A )
    call DisableTrigger( gg_trg_Magma_Bridge_Enter)
    set udg_Temp_Unit_Point = null
endfunction

