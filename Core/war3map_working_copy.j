function Trig_MultiShot_Inc_Death_Copy_Actions takes nothing returns nothing
    if ( GetTriggerUnit() == udg_yA_Marksman_Hunter ) then
    call TriggerExecute( gg_trg_Orb_Added)
    elseif ( GetTriggerUnit() == udg_yH_Marksman_Hunter ) then
    call TriggerExecute( gg_trg_Orb_Added)
    endif
endfunction

