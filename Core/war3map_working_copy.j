//===========================================================================
// Trigger: Blink Molten Armor
//===========================================================================
function Trig_Blink_Molten_Armor_Func009C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'AEbl' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0DB' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Blink_Molten_Armor_Conditions takes nothing returns boolean
    if ( not Trig_Blink_Molten_Armor_Func009C() ) then
        return false
    endif
    return true
endfunction

function Trig_Blink_Molten_Armor_Actions takes nothing returns nothing
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(GetTriggerUnit())) * udg_NUM_OF_TC + 4 ]  then
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - 0 ))
    set udg_RealStatCalc = ( ( 0.08 * GetUnitStateSwap(UNIT_STATE_MAX_LIFE, GetTriggerUnit()) ) + udg_RealStatCalc )
    call SetUnitAbilityLevel( gg_unit_e03G_2001, 'A0BF', 15 )
    				call IssueTargetOrder( gg_unit_e03G_2001, "innerfire", udg_Temp_Unit )
    call NewShield( udg_Temp_Unit, udg_RealStatCalc, 99 )
    endif
endfunction

