function Trig_Mighty_Ox_Kick_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0E6' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mighty_Ox_Kick_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_STR, GetTriggerUnit(), true) - GetHeroStatBJ(bj_HEROSTAT_STR, GetTriggerUnit(), false) ))
    set udg_RealStatCalc = ( ( 2.50 + ( 2.50 * I2R(GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit())) ) ) * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A0E6', udg_Temp_Unit) * 100 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 100 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    call UnitDamageTargetBJ( GetTriggerUnit(), GetSpellTargetUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL )
    call AddSpecialEffectTargetUnitBJ( "chest", GetTriggerUnit(), "war3mapImported\\Ephemeral Slash Yellow.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "war3mapImported\\Ephemeral Slash Orange.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    // KnockUp & DMG
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
    set udg_Temp_Polar_Point = GetUnitLoc( GetSpellTargetUnit() )
    set udg_Temp_Real = AngleBetweenPoints(udg_Temp_Polar_Point, udg_Temp_Unit_Point)
    set udg_Temp_X_Point = PolarProjectionBJ(udg_Temp_Polar_Point, 300.00, udg_Temp_Real)
    call RemoveLocation (udg_Temp_Polar_Point)
    if not IsTerrainPathable( GetLocationX(udg_Temp_X_Point), GetLocationY(udg_Temp_X_Point), PATHING_TYPE_WALKABILITY) then
    call SetUnitPositionLoc( GetEnumUnit(), udg_Temp_X_Point )
    endif
    call RemoveLocation (udg_Temp_X_Point)
    // KnockBackLoop Turn ON
    call UnitAddAbilityBJ( 'Amrf', GetSpellTargetUnit() )
    call UnitRemoveAbilityBJ( 'Amrf', GetSpellTargetUnit() )
    call SetUnitFlyHeightBJ( GetSpellTargetUnit(), 135.00, 0.00 )
    // Add to Knockbacks Hash
    if ( IsUnitInGroup(GetSpellTargetUnit(), udg_KnockBacks) == false ) then
        call GroupAddUnitSimple( GetSpellTargetUnit(), udg_KnockBacks )
    else
    call FlushChildHashtableBJ( GetHandleIdBJ(GetEnumUnit()), udg_KnockBacksHash )
    endif
    call SaveRealBJ( udg_Temp_Real, 0, GetHandleIdBJ(GetSpellTargetUnit()), udg_KnockBacksHash )
    	call SaveRealBJ( 4.00, 1, GetHandleIdBJ(GetSpellTargetUnit()), udg_KnockBacksHash )
    						call SaveRealBJ( 172.00, 2, GetHandleIdBJ(GetSpellTargetUnit()), udg_KnockBacksHash )
    						call SaveRealBJ( 15.00, 3, GetHandleIdBJ(GetSpellTargetUnit()), udg_KnockBacksHash )
    // Special Effect
    						call AddSpecialEffectTargetUnitBJ( "origin", GetSpellTargetUnit(), "Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call RemoveLocation (udg_Temp_Unit_Point)
    // Dummy Goes Last Because It Will Change the Value of SpellTargetUnit()
    call SetUnitAbilityLevelSwapped( 'A03P', gg_unit_e028_1863, 2 )
    call SetUnitOwner( gg_unit_e028_1863, GetOwningPlayer(GetTriggerUnit()), true )
    call IssueTargetOrderBJ( gg_unit_e028_1863, "slow", GetSpellTargetUnit() )
    // Enable
    call EnableTrigger( gg_trg_KnockBackLoop)
endfunction

//===========================================================================
function InitTrig_Mighty_Ox_Kick takes nothing returns nothing
    set gg_trg_Mighty_Ox_Kick = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Mighty_Ox_Kick, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Mighty_Ox_Kick, Condition( function Trig_Mighty_Ox_Kick_Conditions ) )
    call TriggerAddAction( gg_trg_Mighty_Ox_Kick, function Trig_Mighty_Ox_Kick_Actions )
endfunction

//===========================================================================
// Trigger: Niazou Black Ox
//===========================================================================
function Trig_Niazou_Black_Ox_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A09H' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Niazou_Black_Ox_Actions takes nothing returns nothing
    local location Target
    local real Angle
    local integer udg_o
    set udg_Temp_Unit = GetTriggerUnit()
    if (udg_Temp_Unit == udg_yA_Brew_Monk) then
    set udg_o = udg_z_MK_BREW_A
    elseif (udg_Temp_Unit == udg_yH_Brew_Monk) then
    set udg_o = udg_z_MK_BREW_H
    endif
    set udg_o = udg_o + 8
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    set udg_Temp_Polar_Point = GetSpellTargetLoc()
    set udg_RealStatCalc = AngleBetweenPoints(udg_Temp_Unit_Point, udg_Temp_Polar_Point)
    call RemoveLocation (udg_Temp_Polar_Point)
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 1000.00, udg_RealStatCalc)
    set Angle = udg_RealStatCalc
    set Target = udg_Temp_Unit_Point
    // Create Ox
    call CreateNUnitsAtLoc( 1, 'n042', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, udg_RealStatCalc )
    call IssuePointOrderLocBJ( GetLastCreatedUnit(), "move", udg_Temp_Polar_Point )
    call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
    set udg_SpellUnits[( udg_o + 0 )] = GetLastCreatedUnit()
    call CreateNUnitsAtLoc( 1, 'n043', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, udg_RealStatCalc )
    call IssuePointOrderLocBJ( GetLastCreatedUnit(), "move", udg_Temp_Polar_Point )
    call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
    set udg_SpellUnits[( udg_o + 2 )] = GetLastCreatedUnit()
    call SetUnitVertexColorBJ( GetLastCreatedUnit(), 100.00, 100.00, 100, 66.00 )
    call RemoveLocation (udg_Temp_Polar_Point)
    call TriggerSleepAction( 0.10 )
    set udg_RealStatCalc = Angle
    set udg_Temp_Unit_Point = Target
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 800.00, udg_RealStatCalc)
    call CreateNUnitsAtLoc( 1, 'n043', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, udg_RealStatCalc )
    call IssuePointOrderLocBJ( GetLastCreatedUnit(), "move", udg_Temp_Polar_Point )
    call UnitApplyTimedLifeBJ( 2.05, 'BTLF', GetLastCreatedUnit() )
    set udg_SpellUnits[( udg_o + 1 )] = GetLastCreatedUnit()
    call SetUnitVertexColorBJ( GetLastCreatedUnit(), 100.00, 100.00, 100, 66.00 )
    call RemoveLocation (udg_Temp_Unit_Point)
    call RemoveLocation (udg_Temp_Polar_Point)
    set Target = null
    set udg_Temp_Int = udg_o
    call TriggerExecute( gg_trg_Niazou_Black_Ox_Dmg)
    call TriggerSleepAction( 0.40 )
    call SetUnitVertexColorBJ( udg_SpellUnits[( udg_o + 2 )], 100.00, 100.00, 100, 33.00 )
    call SetUnitVertexColorBJ( udg_SpellUnits[( udg_o + 1 )], 100.00, 100.00, 100, 33.00 )
    set udg_Temp_Int = udg_o
    call TriggerExecute( gg_trg_Niazou_Black_Ox_Dmg)
    call TriggerSleepAction( 0.40 )
    call SetUnitVertexColorBJ( udg_SpellUnits[( udg_o + 2 )], 100.00, 100.00, 100, 66.00 )
    call SetUnitVertexColorBJ( udg_SpellUnits[( udg_o + 1 )], 100.00, 100.00, 100, 66.00 )
    set udg_Temp_Int = udg_o
    call TriggerExecute( gg_trg_Niazou_Black_Ox_Dmg)
    call TriggerSleepAction( 0.40 )
    call SetUnitVertexColorBJ( udg_SpellUnits[( udg_o + 2 )], 100.00, 100.00, 100, 33.00 )
    call SetUnitVertexColorBJ( udg_SpellUnits[( udg_o + 1 )], 100.00, 100.00, 100, 33.00 )
    set udg_Temp_Int = udg_o
    call TriggerExecute( gg_trg_Niazou_Black_Ox_Dmg)
    call TriggerSleepAction( 0.10 )
    call RemoveUnit( udg_SpellUnits[udg_o + 1])
    call RemoveUnit( udg_SpellUnits[udg_o + 2])
    call TriggerSleepAction( 0.10 )
    call RemoveUnit( udg_SpellUnits[udg_o + 0])
endfunction

//===========================================================================
function InitTrig_Niazou_Black_Ox takes nothing returns nothing
    set gg_trg_Niazou_Black_Ox = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Niazou_Black_Ox, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Niazou_Black_Ox, Condition( function Trig_Niazou_Black_Ox_Conditions ) )
    call TriggerAddAction( gg_trg_Niazou_Black_Ox, function Trig_Niazou_Black_Ox_Actions )
endfunction

//===========================================================================
// Trigger: Niazou Black Ox Dmg
//===========================================================================
function Trig_Niazou_Black_Ox_Dmg_Func021A takes nothing returns nothing
    if IsUnitTargetableEnemyGround( GetEnumUnit(), udg_Temp_Unit ) then
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_Niazou_Black_Ox_Dmg_Actions takes nothing returns nothing
    set udg_o = udg_Temp_Int
    if ( udg_o ==  udg_z_MK_BREW_A + 8 ) then
    set udg_Temp_Unit = udg_yA_Brew_Monk
    else
    set udg_Temp_Unit = udg_yH_Brew_Monk
    endif
    set udg_Temp_Unit_Point = GetUnitLoc( udg_SpellUnits[ udg_o ] )
    // stun
    call CreateNUnitsAtLoc( 1, 'e01J', GetOwningPlayer(udg_Temp_Unit), udg_Temp_Unit_Point, bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 0.50, 'BTLF', GetLastCreatedUnit() )
    call IssueImmediateOrderBJ( GetLastCreatedUnit(), "stomp" )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    // dmg
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 6.50 * udg_RealStatCalc )
    call TriggerExecute( gg_trg_Firelords_Helper)
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(195.00, udg_Temp_Unit_Point), function Trig_Niazou_Black_Ox_Dmg_Func021A )
    call RemoveLocation (udg_Temp_Unit_Point)
endfunction

//===========================================================================
function InitTrig_Niazou_Black_Ox_Dmg takes nothing returns nothing
    set gg_trg_Niazou_Black_Ox_Dmg = CreateTrigger(  )
    call TriggerAddAction( gg_trg_Niazou_Black_Ox_Dmg, function Trig_Niazou_Black_Ox_Dmg_Actions )
endfunction

//===========================================================================
// Trigger: Retribution Start
//===========================================================================
function Trig_Retribution_Start_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A00U' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Retribution_Start_Actions takes nothing returns nothing
    local unit target = GetSpellTargetUnit()
    local unit udg_Temp_Unit = GetTriggerUnit()
    // Freedom
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 9 ]  then
    call Speedbonus( target, 0.35, 2.5)
    call UnitRemoveBuffsBJ( bj_REMOVEBUFFS_NEGATIVE, target )
    //	call UnitAddType( target, UNIT_TYPE_MAGIC_IMMUNE )   
    //call UnitRemoveType( target, UNIT_TYPE_MAGIC_IMMUNE )   
    endif
    // Sacred Shield
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 13 ]  then
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) + GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, true) ))
    set udg_RealStatCalc = ( 100.00 + udg_RealStatCalc )
    if not IsUnitEnemy( udg_Temp_Unit, GetOwningPlayer( target ) ) then
    if udg_Debug then
    call DisplayTextToForce( GetPlayersAll(), "|cccFFaa00HandleId: |r" + I2S(GetHandleId( target )) )
    endif
    call NewShield( target , udg_RealStatCalc, 99 )
    call SetUnitAbilityLevel( gg_unit_e03G_2001, 'A0BF', 16 )
    				call IssueTargetOrder( gg_unit_e03G_2001, "innerfire", target )
    endif
    endif
    // Mana
    call GameTimeWait( 0.25)
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 12 ]  then
                call MaxManaRestore( 0.35, target )
                call AddSpecialEffectTargetUnitBJ( "origin", target, "Abilities\\Spells\\Items\\AIre\\AIreTarget.mdl")
                call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    endif
    set target = null
    set udg_Temp_Unit = null
endfunction

//===========================================================================
function InitTrig_Retribution_Start takes nothing returns nothing
    set gg_trg_Retribution_Start = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Retribution_Start, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Retribution_Start, Condition( function Trig_Retribution_Start_Conditions ) )
    call TriggerAddAction( gg_trg_Retribution_Start, function Trig_Retribution_Start_Actions )
endfunction

//===========================================================================
// Trigger: Avenging Crusader
//===========================================================================
function Trig_Avenging_Crusader_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0AP' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Avenging_Crusader_Actions takes nothing returns nothing
    local player udg_X_Player_MUI = GetTriggerPlayer()
    call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call UnitAddAbilityBJ( 'A0AQ', GetTriggerUnit() )
    call SetUnitAbilityLevelSwapped( 'A0AQ', GetTriggerUnit(), GetUnitAbilityLevelSwapped('A0AP', GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'A0AP', udg_X_Player_MUI )
    call GameTimeWait(11.0)
    call SetPlayerAbilityAvailableBJ( true, 'A0AP', udg_X_Player_MUI )
    call UnitRemoveAbilityBJ( 'A0AQ', GetTriggerUnit() )
    set udg_X_Player_MUI = null
endfunction

//===========================================================================
function InitTrig_Avenging_Crusader takes nothing returns nothing
    set gg_trg_Avenging_Crusader = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Avenging_Crusader, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Avenging_Crusader, Condition( function Trig_Avenging_Crusader_Conditions ) )
    call TriggerAddAction( gg_trg_Avenging_Crusader, function Trig_Avenging_Crusader_Actions )
endfunction

//===========================================================================
// Trigger: Lay on Hands Finish
//===========================================================================
function Trig_Lay_on_Hands_Finish_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0DK' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Lay_on_Hands_Finish_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    if udg_Temp_Unit == udg_yA_Holy_Pally then
    set udg_o = udg_z_PA_HOLY_A
    elseif udg_Temp_Unit == udg_yH_Holy_Pally then
    set udg_o = udg_z_PA_HOLY_H
    elseif udg_Temp_Unit == udg_yA_Prot_Pally then
    set udg_o = udg_z_PA_PROT_A
    elseif udg_Temp_Unit == udg_yH_Prot_Pally then
    set udg_o = udg_z_PA_PROT_H
    elseif udg_Temp_Unit == udg_yA_Ret_Pally then
    set udg_o = udg_z_PA_RETR_A
    elseif udg_Temp_Unit == udg_yH_Ret_Pally then
    set udg_o = udg_z_PA_RETR_H
    endif
    set udg_Temp_Unit = udg_SpellUnits[udg_o]
    call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "war3mapImported\\Heal.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call MaxHPSelfHeal( 1.0)
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_RealStatCalc = ( I2R(GetUnitAbilityLevelSwapped('A0DK', udg_Temp_Unit)) * -10.00 )
    set udg_RealStatCalc = ( udg_RealStatCalc + 70.00 )
    call TriggerExecute( gg_trg_Cooldown_Maths)
    set udg_CooldownRemaining = ( udg_CooldownRemaining * udg_RealStatCalc )
    call BlzStartUnitAbilityCooldown( udg_Temp_Unit, GetSpellAbilityId(), udg_CooldownRemaining )
    // Beacon Heal
    set udg_Temp_Unit = GetTriggerUnit()
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 14 ]  then
    set udg_RealStatCalc = GetUnitStateSwap(UNIT_STATE_LIFE, udg_SpellUnits[udg_o])
    call SetUnitLifeBJ( udg_Temp_Unit, ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_Temp_Unit) + ( 0.10 * udg_RealStatCalc ) ) )
    call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "Abilities\\Spells\\Items\\ResourceItems\\ResourceEffectTarget.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    endif
endfunction

//===========================================================================
function InitTrig_Lay_on_Hands_Finish takes nothing returns nothing
    set gg_trg_Lay_on_Hands_Finish = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Lay_on_Hands_Finish, EVENT_PLAYER_UNIT_SPELL_FINISH )
    call TriggerAddCondition( gg_trg_Lay_on_Hands_Finish, Condition( function Trig_Lay_on_Hands_Finish_Conditions ) )
    call TriggerAddAction( gg_trg_Lay_on_Hands_Finish, function Trig_Lay_on_Hands_Finish_Actions )
endfunction

//===========================================================================
// Trigger: Judgement
//
// Make Judgement slow via dummy, then effect can be stored using a local
//===========================================================================
function Trig_Judgement_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0AR' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Judgement_Func029C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(udg_Temp_Unit, 'B01F') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Judgement_Actions takes nothing returns nothing
    local integer udg_o = 0
    set udg_Temp_Unit = GetTriggerUnit()
    if udg_Temp_Unit == udg_yA_Holy_Pally then
    set udg_o = udg_z_PA_HOLY_A
    elseif udg_Temp_Unit == udg_yH_Holy_Pally then
    set udg_o = udg_z_PA_HOLY_H
    elseif udg_Temp_Unit == udg_yA_Ret_Pally then
    set udg_o = udg_z_PA_RETR_A
    elseif udg_Temp_Unit == udg_yH_Ret_Pally then
    set udg_o = udg_z_PA_RETR_H
    //Non-player
    else
    call Speedbonus( udg_Temp_Unit, 0.25, 2.5)
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A0AR', udg_Temp_Unit) * 70 )
    call UnitDamageTargetBJ( udg_Temp_Unit, GetSpellTargetUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    return
    endif
    set udg_SpellUnits[udg_o + 5] = udg_SpellUnits[udg_o + 4] 
    set udg_SpellUnits[udg_o + 4] = GetSpellTargetUnit()
    call GameTimeWait(0.18)
    set udg_Temp_Unit = GetTriggerUnit()
    call Speedbonus( udg_Temp_Unit, 0.25, 2.5)
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, GetTriggerUnit(), true) - GetHeroStatBJ(bj_HEROSTAT_INT, GetTriggerUnit(), false) ))
    set udg_RealStatCalc = ( 3.00 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A0AR', udg_Temp_Unit) * 55 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 10 )
    set udg_RealStatCalc = ( ( 1.00 * I2R(udg_HeroStatCalc) ) + udg_RealStatCalc )
    if ( Trig_Judgement_Func029C() ) then
        set udg_Temp_Real = ( ( 0.10 * I2R(( GetUnitAbilityLevelSwapped('A0AQ', udg_Temp_Unit) + 1 )) ) + 1.00 )
        set udg_RealStatCalc = ( udg_Temp_Real * udg_RealStatCalc )
    else
    endif
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 3 ]  then
    if udg_SpellUnits[udg_o + 5] == udg_SpellUnits[udg_o + 4] then
    call AddSpecialEffectTargetUnitBJ( "origin", udg_SpellUnits[( udg_o + 5 )], "Abilities\\Weapons\\DragonHawkMissile\\DragonHawkMissile.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set udg_Temp_Unit_Point = GetUnitLoc(udg_SpellUnits[( udg_o + 4 )])
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Weapons\\DragonHawkMissile\\DragonHawkMissile.mdl" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 2.00 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call RemoveLocation (udg_Temp_Unit_Point)
    if udg_Temp_Unit == udg_yA_Ret_Pally or  udg_Temp_Unit == udg_yH_Ret_Pally then
    set udg_RealStatCalc = ( 1.25 * udg_RealStatCalc )
    else
    set udg_RealStatCalc = ( 1.25 * udg_RealStatCalc )
    endif
    endif
    endif
    call UnitDamageTargetBJ( udg_Temp_Unit, udg_SpellUnits[( udg_o + 4 )], udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
endfunction

//===========================================================================
function InitTrig_Judgement takes nothing returns nothing
    set gg_trg_Judgement = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Judgement, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Judgement, Condition( function Trig_Judgement_Conditions ) )
    call TriggerAddAction( gg_trg_Judgement, function Trig_Judgement_Actions )
endfunction

