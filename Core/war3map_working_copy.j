//===========================================================================
function Trig_Dark_Ranger_Wave_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'H01I' ) ) then
        return false
    endif
    if ( not ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) < 1000.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dark_Ranger_Wave_Func010C takes nothing returns boolean
    if ( not ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) > GetUnitStateSwap(UNIT_STATE_LIFE, GetAttacker()) ) ) then
        return false
    endif
    if ( not ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) > 900.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dark_Ranger_Wave_Actions takes nothing returns nothing
    local real udg_RealStatCalc
    call UnitResetCooldown( GetTriggerUnit() )
    call SetUnitManaBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) + 200.00 ) )
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    set udg_Temp_Polar_Point = GetUnitLoc(GetAttacker())
    set udg_RealStatCalc = AngleBetweenPoints(udg_Temp_Unit_Point, udg_Temp_Polar_Point)
    call RemoveLocation(udg_Temp_Unit_Point)
    if ( Trig_Dark_Ranger_Wave_Func010C() ) then
        set udg_Temp_Unit_Point = PolarProjectionBJ(udg_Temp_Polar_Point, 80.00, udg_RealStatCalc)
    else
        set udg_Temp_Unit_Point = PolarProjectionBJ(udg_Temp_Polar_Point, -300.00, udg_RealStatCalc)
    endif
    call RemoveLocation(udg_Temp_Polar_Point)
    call IssuePointOrderLocBJ( GetTriggerUnit(), "carrionswarm", udg_Temp_Unit_Point )
    call RemoveLocation(udg_Temp_Unit_Point)
    call DisableTrigger( GetTriggeringTrigger() )
    call TriggerSleepAction( 12.00 )
    call EnableTrigger( GetTriggeringTrigger() )
endfunction

