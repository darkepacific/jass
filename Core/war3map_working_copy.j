function InitTrig_Orb_Gen takes nothing returns nothing
    set gg_trg_Orb_Gen = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Orb_Gen, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Orb_Gen, Condition( function Trig_Orb_Gen_Conditions ) )
    call TriggerAddAction( gg_trg_Orb_Gen, function Trig_Orb_Gen_Actions )
endfunction

//===========================================================================
// Trigger: Mind Flay
//===========================================================================
function Trig_Mind_Flay_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A05F' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mind_Flay_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A05F'), ABILITY_RLF_HIT_POINTS_DRAINED, ( GetUnitAbilityLevel(GetTriggerUnit(),GetSpellAbilityId()) - 1 ), 1 )
    // Inc Healing Talent
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 10 ] then
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A05F', udg_Temp_Unit) * 15 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 10 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    // Chalice is technically buffing the base damage here as well, but oh well we'll look the other way for this one
    if ChaliceCheck() then
    set udg_RealStatCalc = udg_RealStatCalc + udg_CHALICE_HEAL * I2R(udg_HeroStatCalc) 
    endif
    set udg_RealStatCalc = ( 0.25 * udg_RealStatCalc )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A05F'), ABILITY_RLF_HIT_POINTS_DRAINED, ( GetUnitAbilityLevel(GetTriggerUnit(),GetSpellAbilityId()) - 1 ), udg_RealStatCalc )
    endif
    // A
    if udg_Temp_Unit == udg_yA_Shadow_Priest then
    set udg_o = ( udg_z_PR_SHAD_A + 4 )
    call PlaySoundOnUnitBJ( gg_snd_Mind_Flay1, 100.00, udg_Temp_Unit )
    set udg_SpellUnits[udg_o] = GetSpellTargetUnit()
    call EnableTrigger( gg_trg_Mind_Flay_Tick_A)
    call EnableTrigger( gg_trg_Mind_Flay_Dies)
    endif
    // H
    if udg_Temp_Unit == udg_yH_Shadow_Priest then
    call PlaySoundOnUnitBJ( gg_snd_Mind_Flay101, 100.00, udg_Temp_Unit )
    set udg_o = ( udg_z_PR_SHAD_H + 4 )
    set udg_SpellUnits[udg_o] = GetSpellTargetUnit()
    call EnableTrigger( gg_trg_Mind_Flay_Tick_H)
    call EnableTrigger( gg_trg_Mind_Flay_Dies)
    endif
endfunction

//===========================================================================
function InitTrig_Mind_Flay takes nothing returns nothing
    set gg_trg_Mind_Flay = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Mind_Flay, EVENT_PLAYER_UNIT_SPELL_CHANNEL )
    call TriggerAddCondition( gg_trg_Mind_Flay, Condition( function Trig_Mind_Flay_Conditions ) )
    call TriggerAddAction( gg_trg_Mind_Flay, function Trig_Mind_Flay_Actions )
endfunction

//===========================================================================
// Trigger: Mind Flay Tick A
//
//     call GroupAddUnitSimple( GetEnumUnit(), udg_PX_Firelords[udg_Player_Number] )
//===========================================================================
function Trig_Mind_Flay_Tick_A_Actions takes nothing returns nothing
    set udg_Temp_Unit = udg_yA_Shadow_Priest
    set udg_o = ( udg_z_PR_SHAD_A + 4 )
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A05F', udg_Temp_Unit) * 15 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 10 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    call UnitDamageTargetBJ( udg_Temp_Unit, udg_SpellUnits[udg_o], ( udg_RealStatCalc + 0.00 ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    // Mana Drain
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 4 ] then
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 10 ] then
    set udg_RealStatCalc = ( 1.25 * udg_RealStatCalc )
    endif
    call SetUnitManaBJ( udg_Temp_Unit, ( GetUnitState(udg_Temp_Unit, UNIT_STATE_MANA) + ( udg_RealStatCalc / 2.00 ) ) )
    call SetUnitManaBJ( udg_SpellUnits[udg_o], ( GetUnitState( udg_SpellUnits[udg_o], UNIT_STATE_MANA) - ( udg_RealStatCalc / 2.00 ) ) )
    call AddSpecialEffectTargetUnitBJ( "overhead", udg_SpellUnits[udg_o], "war3mapImported\\Radiance Royal.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    endif
    // Firelords
    call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
    call HasFirelords(  udg_SpellUnits[udg_o] )
    // Slow
    call SetUnitAbilityLevelSwapped( 'A03P', gg_unit_e028_1863, 7 )
    call SetUnitOwner( gg_unit_e028_1863, GetOwningPlayer(udg_Temp_Unit), true )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(gg_unit_e028_1863, 'A03P'), ABILITY_RLF_DURATION_NORMAL, 3, 0.7 )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(gg_unit_e028_1863, 'A03P'), ABILITY_RLF_DURATION_HERO, 3, 0.7 )
    call IssueTargetOrder( gg_unit_e028_1863, "slow", udg_SpellUnits[udg_o] )
endfunction

//===========================================================================
function InitTrig_Mind_Flay_Tick_A takes nothing returns nothing
    set gg_trg_Mind_Flay_Tick_A = CreateTrigger(  )
    call DisableTrigger( gg_trg_Mind_Flay_Tick_A )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Mind_Flay_Tick_A, 0.50 )
    call TriggerAddAction( gg_trg_Mind_Flay_Tick_A, function Trig_Mind_Flay_Tick_A_Actions )
endfunction

//===========================================================================
// Trigger: Mind Flay Tick H
//
//     call GroupAddUnitSimple( GetEnumUnit(), udg_PX_Firelords[udg_Player_Number] )
//===========================================================================
function Trig_Mind_Flay_Tick_H_Actions takes nothing returns nothing
    set udg_Temp_Unit = udg_yH_Shadow_Priest
    set udg_o = ( udg_z_PR_SHAD_H + 4 )
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A05F', udg_Temp_Unit) * 15 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 10 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    call UnitDamageTargetBJ( udg_Temp_Unit, udg_SpellUnits[udg_o], ( udg_RealStatCalc + 0.00 ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    // Mana Drain
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 4 ] then
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 10 ] then
    set udg_RealStatCalc = ( 1.25 * udg_RealStatCalc )
    endif
    call SetUnitManaBJ( udg_Temp_Unit, ( GetUnitState(udg_Temp_Unit, UNIT_STATE_MANA) + ( udg_RealStatCalc / 2.00 ) ) )
    call SetUnitManaBJ( udg_SpellUnits[udg_o], ( GetUnitState( udg_SpellUnits[udg_o], UNIT_STATE_MANA) - ( udg_RealStatCalc / 2.00 ) ) )
    call AddSpecialEffectTargetUnitBJ( "overhead", udg_SpellUnits[udg_o], "war3mapImported\\Radiance Royal.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    endif
    // Firelords
    call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
    call HasFirelords(  udg_SpellUnits[udg_o] )
    // Slow
    call SetUnitAbilityLevelSwapped( 'A03P', gg_unit_e028_1863, 7 )
    call SetUnitOwner( gg_unit_e028_1863, GetOwningPlayer(udg_Temp_Unit), true )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(gg_unit_e028_1863, 'A03P'), ABILITY_RLF_DURATION_NORMAL, 3, 0.7 )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(gg_unit_e028_1863, 'A03P'), ABILITY_RLF_DURATION_HERO, 3, 0.7 )
    call IssueTargetOrder( gg_unit_e028_1863, "slow", udg_SpellUnits[udg_o] )
    return
endfunction

//===========================================================================
function InitTrig_Mind_Flay_Tick_H takes nothing returns nothing
    set gg_trg_Mind_Flay_Tick_H = CreateTrigger(  )
    call DisableTrigger( gg_trg_Mind_Flay_Tick_H )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Mind_Flay_Tick_H, 0.50 )
    call TriggerAddAction( gg_trg_Mind_Flay_Tick_H, function Trig_Mind_Flay_Tick_H_Actions )
