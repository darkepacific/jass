//===========================================================================
// Trigger: Seprent Trap
//
// Cant use Var unit dies b/c it requires existing units
//===========================================================================
function Trig_Seprent_Trap_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetDyingUnit()) == 'o002' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Seprent_Trap_Func012Func002C takes nothing returns boolean
    if ( not ( udg_HeroStatCalc == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Seprent_Trap_Func012C takes nothing returns boolean
    if ( not ( udg_HeroStatCalc == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Seprent_Trap_Func017Func002C takes nothing returns boolean
    if ( not ( udg_HeroStatCalc == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Seprent_Trap_Func017C takes nothing returns boolean
    if ( not ( udg_HeroStatCalc == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Seprent_Trap_Func022Func002C takes nothing returns boolean
    if ( not ( udg_HeroStatCalc == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Seprent_Trap_Func022C takes nothing returns boolean
    if ( not ( udg_HeroStatCalc == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Seprent_Trap_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    local location udg_Temp_Polar_Point
    local integer udg_Temp_Int
    local unit udg_Temp_Unit = udg_Heroes[ GetPlayerNumber( GetOwningPlayer( GetTriggerUnit() ) )]
    //Check to make sure hero still exists
    if udg_Temp_Unit != null then
    set udg_Temp_Int = ( GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, true) * 2 )
    set udg_HeroStatCalc = GetUnitAbilityLevelSwapped('A02G', udg_Temp_Unit)
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 200.00, 60.00)
    if ( Trig_Seprent_Trap_Func012C() ) then
        call CreateNUnitsAtLoc( 1, 'o00H', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, 240.00 )
    else
        if ( Trig_Seprent_Trap_Func012Func002C() ) then
            call CreateNUnitsAtLoc( 1, 'o003', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, 240.00 )
        else
            call CreateNUnitsAtLoc( 1, 'o00I', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, 240.00 )
        endif
    endif
    call BlzSetUnitWeaponIntegerFieldBJ( GetLastCreatedUnit(), UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 0, ( BlzGetUnitBaseDamage(GetLastCreatedUnit(), 0) + udg_Temp_Int ) )
    call UnitApplyTimedLifeBJ( 6.00, 'Bhwd', GetLastCreatedUnit() )
    call RemoveLocation (udg_Temp_Polar_Point)
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 200.00, 180.00)
    if ( Trig_Seprent_Trap_Func017C() ) then
        call CreateNUnitsAtLoc( 1, 'o00H', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, 0.00 )
    else
        if ( Trig_Seprent_Trap_Func017Func002C() ) then
            call CreateNUnitsAtLoc( 1, 'o003', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, 0.00 )
        else
            call CreateNUnitsAtLoc( 1, 'o00I', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, 0.00 )
        endif
    endif
    call BlzSetUnitWeaponIntegerFieldBJ( GetLastCreatedUnit(), UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 0, ( BlzGetUnitBaseDamage(GetLastCreatedUnit(), 0) + udg_Temp_Int ) )
    call UnitApplyTimedLifeBJ( 6.00, 'Bhwd', GetLastCreatedUnit() )
    call RemoveLocation (udg_Temp_Polar_Point)
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 200.00, 300.00)
    if ( Trig_Seprent_Trap_Func022C() ) then
        call CreateNUnitsAtLoc( 1, 'o00H', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, 120.00 )
    else
        if ( Trig_Seprent_Trap_Func022Func002C() ) then
            call CreateNUnitsAtLoc( 1, 'o003', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, 120.00 )
        else
            call CreateNUnitsAtLoc( 1, 'o00I', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, 120.00 )
        endif
    endif
    call BlzSetUnitWeaponIntegerFieldBJ( GetLastCreatedUnit(), UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 0, ( BlzGetUnitBaseDamage(GetLastCreatedUnit(), 0) + udg_Temp_Int ) )
    call UnitApplyTimedLifeBJ( 6.00, 'Bhwd', GetLastCreatedUnit() )
    call RemoveLocation (udg_Temp_Polar_Point)
    call RemoveLocation (udg_Temp_Unit_Point)
    endif
    set udg_Temp_Unit_Point = null
    set udg_Temp_Polar_Point = null
    set udg_Temp_Unit = null
endfunction

//===========================================================================
function InitTrig_Seprent_Trap takes nothing returns nothing
    set gg_trg_Seprent_Trap = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Seprent_Trap, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_Seprent_Trap, Condition( function Trig_Seprent_Trap_Conditions ) )
    call TriggerAddAction( gg_trg_Seprent_Trap, function Trig_Seprent_Trap_Actions )
endfunction

//===========================================================================
// Trigger: Freezing Trap
//
// create local Group then destroy
//===========================================================================
function Trig_Freezing_Trap_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetDyingUnit()) == 'o00T' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Freezing_Trap_Func007A takes nothing returns nothing
    if IsUnitTargetableEnemyHitsAll( GetEnumUnit(), GetTriggerUnit() ) then
    call IssueTargetOrderBJ( gg_unit_e028_1863, "slow", GetEnumUnit() )
    call IssueTargetOrderBJ( gg_unit_e028_1863, "sleep", GetEnumUnit() )
    endif
endfunction

function Trig_Freezing_Trap_Func014A takes nothing returns nothing
    if IsUnitTargetableEnemyHitsAll( GetEnumUnit(), GetTriggerUnit() ) then
    call IssueTargetOrderBJ( gg_unit_e028_1863, "slow", GetEnumUnit() )
    endif
endfunction

function Trig_Freezing_Trap_Actions takes nothing returns nothing
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    call SetUnitOwner( gg_unit_e028_1863, GetOwningPlayer(GetTriggerUnit()), true )
    call SetUnitAbilityLevelSwapped( 'ACsl', gg_unit_e028_1863, 2 )
    call SetUnitAbilityLevelSwapped( 'A03P', gg_unit_e028_1863, 5 )
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(245.00, udg_Temp_Unit_Point), function Trig_Freezing_Trap_Func007A )
    call RemoveLocation (udg_Temp_Unit_Point)
    return
    call GameTimeWait(0.3)
    call SetUnitAbilityLevelSwapped( 'A03P', gg_unit_e028_1863, 1 )
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(230.00, udg_Temp_Unit_Point), function Trig_Freezing_Trap_Func014A )
    call RemoveLocation (udg_Temp_Unit_Point)
endfunction

//===========================================================================
function InitTrig_Freezing_Trap takes nothing returns nothing
    set gg_trg_Freezing_Trap = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Freezing_Trap, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_Freezing_Trap, Condition( function Trig_Freezing_Trap_Conditions ) )
    call TriggerAddAction( gg_trg_Freezing_Trap, function Trig_Freezing_Trap_Actions )
endfunction

//===========================================================================
// Trigger: Pounce
//===========================================================================
function Trig_Pounce_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0A3' ) ) then
        return false
    endif
    if ( not ( GetPlayerController(GetOwningPlayer(GetTriggerUnit())) == MAP_CONTROL_USER ) ) then
        return false
    endif
    return true
endfunction

function Trig_Pounce_Func028A takes nothing returns nothing
    if IsUnitTargetableEnemyHitsAll( GetEnumUnit(), udg_Temp_Unit ) then
    call Speedbonus( udg_Temp_Unit, 0.15, 2.5)
    call Debug("Run Kitty Run")
    endif
endfunction

function Trig_Pounce_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    call PlaySoundOnUnitBJ( gg_snd_HeroMoonPriestessYesAttack1, 85.00, GetSpellAbilityUnit() )
    call AddSpecialEffectTargetUnitBJ( "origin", GetSpellAbilityUnit(), "war3mapImported\\Valiant Charge Royal.mdx" )
    if udg_Temp_Unit == udg_yA_Marksman_Hunter then
    set udg_Temp_Int = 17
    elseif udg_Temp_Unit == udg_yH_Marksman_Hunter then
    set udg_Temp_Int = 13
    endif
    set udg_Point_Charge_Begin[udg_Temp_Int] = GetUnitLoc(GetSpellAbilityUnit())
    set udg_Temp_Angle = GetUnitFacing(GetTriggerUnit())
    set udg_Temp_Real = 330.00
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer( udg_Temp_Unit )) * udg_NUM_OF_TC + 4 ]  then
    set udg_Temp_Angle = ( udg_Temp_Angle + 180.00 )
    set udg_Temp_Real = ( udg_Temp_Real + 60.00 )
    endif
    set udg_Point_Charge_End[udg_Temp_Int] = PolarProjectionBJ(udg_Point_Charge_Begin[udg_Temp_Int], udg_Temp_Real, udg_Temp_Angle)
    set udg_Charge_SE[udg_Temp_Int] = GetLastCreatedEffectBJ()
    set udg_Charge_Loop[udg_Temp_Int] = 2.00
    // Run Kitty Run
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer( udg_Temp_Unit )) * udg_NUM_OF_TC + 3 ]  then
    set udg_Temp_Angle = ( udg_Temp_Angle + 180.00 )
    call Debug("Run Kitty Run Angle: "  + R2S(udg_Temp_Angle) )
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Point_Charge_Begin[udg_Temp_Int], 150.00, udg_Temp_Angle)
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(320.00, udg_Temp_Polar_Point), function Trig_Pounce_Func028A )
    endif
    // Posthaste
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer( udg_Temp_Unit )) * udg_NUM_OF_TC + 9 ]  then
    //call AddAndHideSpell(udg_Temp_Unit, 'ACm2')
    call UnitRemoveBuffsBJ( bj_REMOVEBUFFS_NEGATIVE, GetTriggerUnit() )
    endif
    if udg_Temp_Unit == udg_yA_Marksman_Hunter then
    call EnableTrigger( gg_trg_Leap_Timer_Night_Elf )
    elseif udg_Temp_Unit == udg_yH_Marksman_Hunter then
    call EnableTrigger( gg_trg_Leap_Timer_Blood_Elf )
    endif
endfunction

//===========================================================================
function InitTrig_Pounce takes nothing returns nothing
    set gg_trg_Pounce = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Pounce, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Pounce, Condition( function Trig_Pounce_Conditions ) )
    call TriggerAddAction( gg_trg_Pounce, function Trig_Pounce_Actions )
endfunction

//===========================================================================
// Trigger: Leap Timer Night Elf
//===========================================================================
//Old Disable User Control Function
function Trig_Leap_Timer_Night_Elf_Func009Func008001001 takes nothing returns boolean
    return ( GetOwningPlayer(udg_Temp_Unit) == GetFilterPlayer() )
endfunction

function Trig_Leap_Timer_Night_Elf_Actions takes nothing returns nothing
    set udg_Temp_Int = 17
    set udg_Temp_Unit = udg_yA_Marksman_Hunter
    set udg_Charge_Distance = DistanceBetweenPoints(udg_Point_Charge_Begin[udg_Temp_Int], udg_Point_Charge_End[udg_Temp_Int])
    set udg_RealStatCalc = AngleBetweenPoints(udg_Point_Charge_Begin[udg_Temp_Int], udg_Point_Charge_End[udg_Temp_Int])
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Point_Charge_Begin[udg_Temp_Int], ( udg_Charge_Distance * ( udg_Charge_Loop[udg_Temp_Int] / 16.00 ) ), udg_RealStatCalc)
    if not IsTerrainPathable( GetLocationX(udg_Temp_Polar_Point), GetLocationY(udg_Temp_Polar_Point), PATHING_TYPE_WALKABILITY) then
    	call SetUnitPositionLoc( udg_Temp_Unit, udg_Temp_Polar_Point) //, udg_Point_Charge_End[udg_Temp_Int] )
    endif
    call UnitAddAbilityBJ( 'Amrf', udg_Temp_Unit )
    call UnitRemoveAbilityBJ( 'Amrf', udg_Temp_Unit )
    if ( udg_Charge_Loop[udg_Temp_Int] < 16.00 ) then
        set udg_Charge_Loop[udg_Temp_Int] = ( udg_Charge_Loop[udg_Temp_Int] + 1 )
        call SetUnitFlyHeightBJ( udg_Temp_Unit, ( 225.00 * SinBJ(AcosBJ(( 1 - ( udg_Charge_Loop[udg_Temp_Int] / 8.00 ) ))) ), 0.00 )
    else
        call SetUnitFlyHeightBJ( udg_Temp_Unit, 0.00, 0.00 )
        call DestroyEffectBJ( udg_Charge_SE[udg_Temp_Int] )
        call RemoveLocation (udg_Point_Charge_Begin[udg_Temp_Int])
        call RemoveLocation (udg_Point_Charge_End[udg_Temp_Int])
        call DisableTrigger( GetTriggeringTrigger() )
        //call UnitRemoveType( udg_Temp_Unit, UNIT_TYPE_MAGIC_IMMUNE )
	//call RemoveAndUnHideSpell(udg_Temp_Unit, 'ACm2')    
    endif
    call RemoveLocation (udg_Temp_Polar_Point)
endfunction

//===========================================================================
function InitTrig_Leap_Timer_Night_Elf takes nothing returns nothing
    set gg_trg_Leap_Timer_Night_Elf = CreateTrigger(  )
    call DisableTrigger( gg_trg_Leap_Timer_Night_Elf )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Leap_Timer_Night_Elf, 0.02 )
    call TriggerAddAction( gg_trg_Leap_Timer_Night_Elf, function Trig_Leap_Timer_Night_Elf_Actions )
endfunction


