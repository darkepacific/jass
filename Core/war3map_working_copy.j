//===========================================================================
// Trigger: HeroSelection
//===========================================================================
library HeroSelection requires HeroSelectionConfig, HeroDeclaration, SaveHelperLib, Ascii, optional NeatMessages

	globals
		private effect array selectedHeroGlow
