function Trig_D_BFF_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    set udg_Temp_Unit_Point = GetUnitLoc(GetDyingUnit())
    if ( Trig_D_BFF_Func003C() ) then
        call CreateItemLoc( 'I07K', udg_Temp_Unit_Point )
    else
    endif
    if ( Trig_D_BFF_Func005C() ) then
        call CreateItemLoc( 'I07J', udg_Temp_Unit_Point )
    else
    endif
    if ( Trig_D_BFF_Func006C() ) then
        call CreateItemLoc( 'I07L', udg_Temp_Unit_Point )
    else
    endif
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = null
endfunction

