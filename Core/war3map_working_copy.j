//===========================================================================
// Trigger: Owl Cast NE
//
// Was a .15s delay in between on and off
//===========================================================================
function Trig_Owl_Cast_NE_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0CS' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Owl_Cast_NE_Actions takes nothing returns nothing
    local integer alvl 
    set udg_Temp_Unit = GetTriggerUnit()
    set alvl = GetUnitAbilityLevel(udg_Temp_Unit, 'A0CS')
    call SetPlayerAbilityAvailableBJ( false, 'A0CR', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'A030', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'A02Y', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A0CZ', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'A091', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'A0E1', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'A0E4', GetOwningPlayer(GetTriggerUnit()) )
    call DisableTrigger( GetTriggeringTrigger() )
    call SetUnitAbilityLevelSwapped( 'A0CX', GetTriggerUnit(), GetUnitAbilityLevelSwapped('A0CS', GetTriggerUnit()) )
    call SetUnitAbilityLevelSwapped( 'A0CY', GetTriggerUnit(), GetUnitAbilityLevelSwapped('A0CS', GetTriggerUnit()) )
    call SetUnitAbilityLevelSwapped( 'A0CU', GetTriggerUnit(), GetUnitAbilityLevelSwapped('A0CS', GetTriggerUnit()) )
    call SetUnitAbilityLevelSwapped( 'A0CW', GetTriggerUnit(), GetUnitAbilityLevelSwapped('A0CS', GetTriggerUnit()) )
    call ImproveEclipse( GetTriggerUnit(), GetUnitAbilityLevel( GetTriggerUnit(), 'A0CS') )
    call HasBanshees( GetTriggerUnit() )
    call GameTimeWait(0.1)
    call EnableTrigger( gg_trg_Owl_Unmorph_NE )
endfunction

