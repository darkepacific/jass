    set gg_trg_PICK_EVERY_UNIT_IN_RECT = CreateTrigger(  )
    call TriggerAddAction( gg_trg_PICK_EVERY_UNIT_IN_RECT, function Trig_PICK_EVERY_UNIT_IN_RECT_Actions )
endfunction

