    set gg_trg_Blink_Molten_Armor = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Blink_Molten_Armor, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Blink_Molten_Armor, Condition( function Trig_Blink_Molten_Armor_Conditions ) )
