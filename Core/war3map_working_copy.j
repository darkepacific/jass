//===========================================================================
function Trig_High_Executor_Haldrec_Dies_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'u029' ) ) then
        return false
    endif
    return true
endfunction

function Trig_High_Executor_Haldrec_Dies_Func006Func003C takes nothing returns boolean
    if ( not ( IsQuestEnabled(udg_Quests[10]) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_High_Executor_Haldrec_Dies_Func006C takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_Quests[10]) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_High_Executor_Haldrec_Dies_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    call TriggerSleepAction( 120.00 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Q_High_Executor_Hadrec)
    call CreateNUnitsAtLoc( 1, 'u029', Player(3), udg_Temp_Unit_Point, 329.65 )
    call RemoveLocation (udg_Temp_Unit_Point)
    if ( Trig_High_Executor_Haldrec_Dies_Func006C() ) then
        call DestroyEffectBJ( udg_QuestMarks[10] )
        set udg_TempString = ""
        if ( Trig_High_Executor_Haldrec_Dies_Func006Func003C() ) then
            if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
            set udg_TempString = udg_ExclamationMark
            endif
            call AddSpecialEffectTargetUnitBJ( "overhead", GetLastCreatedUnit(), udg_TempString )
            set udg_QuestMarks[10] = GetLastCreatedEffectBJ()
        else
            if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
            set udg_TempString = udg_QuestionMark
            endif
            call AddSpecialEffectTargetUnitBJ( "overhead", GetLastCreatedUnit(), udg_TempString )
            set udg_QuestMarks[10] = GetLastCreatedEffectBJ()
        endif
    else
    endif
    set udg_Temp_Unit_Point = null
endfunction

