    set gg_trg_Scarlet_Gate = CreateTrigger(  )
    call TriggerRegisterEnterRectSimple( gg_trg_Scarlet_Gate, gg_rct_Scarlet_Gate )
    call TriggerAddAction( gg_trg_Scarlet_Gate, function Trig_Scarlet_Gate_Actions )
