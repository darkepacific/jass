//===========================================================================
// Trigger: Death Sentence Patchwerk
//===========================================================================
function Trig_Death_Sentence_Patchwerk_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0GF' ) ) then
        return false
    endif
    if ( not ( GetSpellAbilityUnit() == gg_unit_U043_1599 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Death_Sentence_Patchwerk_Actions takes nothing returns nothing
    set udg_Temp_Int = 41
    set udg_Point_Charge_Begin[udg_Temp_Int] = GetUnitLoc(GetSpellAbilityUnit())
    set udg_Point_Charge_End[udg_Temp_Int] = GetUnitLoc(GetSpellTargetUnit())
    set udg_Chain_Target[7] = GetSpellTargetUnit()
    set udg_Charge_Distance = DistanceBetweenPoints(udg_Point_Charge_Begin[udg_Temp_Int], udg_Point_Charge_End[udg_Temp_Int])
    set udg_RealStatCalc = AngleBetweenPoints(udg_Point_Charge_Begin[udg_Temp_Int], udg_Point_Charge_End[udg_Temp_Int])
    set udg_Chain_Terminator_Patchwerk = ( R2I(( udg_Charge_Distance / 50.00 )) - 1 )
    set udg_Temp_Unit = gg_unit_U043_1599
    call PlaySoundOnUnitBJ( gg_snd_100_thresh_base_shackle_oml_0201, 100, udg_Temp_Unit )
    // Create Distance / 50 chains (1 ~ 10)
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = udg_Chain_Terminator_Patchwerk
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Point_Charge_Begin[udg_Temp_Int], ( 50.00 * I2R(GetForLoopIndexA()) ), udg_RealStatCalc)
        call CreateNUnitsAtLocFacingLocBJ( 1, 'e021', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, udg_Point_Charge_End[udg_Temp_Int] )
        call RemoveLocation (udg_Temp_Polar_Point)
        set udg_Chain_Units_Patchwerk[GetForLoopIndexA()] = GetLastCreatedUnit()
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    // make wolf face angle
    set udg_Temp_Unit = gg_unit_U043_1599
    call BlzSetUnitFacingEx( udg_Temp_Unit, udg_RealStatCalc )
    call BlzSetUnitFacingEx( GetSpellTargetUnit(), ( 180.00 + udg_RealStatCalc ) )
    // Turn on Every .05 sec
    call AddSpecialEffectTargetUnitBJ( "origin", GetSpellTargetUnit(), "war3mapImported\\Valiant Charge.mdx" )
    set udg_Charge_SE[udg_Temp_Int] = GetLastCreatedEffectBJ()
    call AddSpecialEffectTargetUnitBJ( "origin", GetSpellTargetUnit(), "war3mapImported\\Hook4.mdx" )
    set udg_Charge_SE[( udg_Temp_Int + 3 )] = GetLastCreatedEffectBJ()
    set udg_i_Chain_Patchwerk = 0
    call TriggerSleepAction( 0.28 )
    // playsound
    set udg_Temp_Unit = gg_unit_U043_1599
    call PlaySoundOnUnitBJ( gg_snd_086_thresh_base_shackle_oba_drag_01, 100, udg_Temp_Unit )
    call EnableTrigger( gg_trg_Charge_Death_Sentence_Patchwerk)
endfunction

//===========================================================================
function InitTrig_Death_Sentence_Patchwerk takes nothing returns nothing
    set gg_trg_Death_Sentence_Patchwerk = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Death_Sentence_Patchwerk, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Death_Sentence_Patchwerk, Condition( function Trig_Death_Sentence_Patchwerk_Conditions ) )
    call TriggerAddAction( gg_trg_Death_Sentence_Patchwerk, function Trig_Death_Sentence_Patchwerk_Actions )
endfunction

//===========================================================================
// Trigger: Charge Death Sentence Patchwerk
//===========================================================================
function Trig_Charge_Death_Sentence_Patchwerk_Func001C takes nothing returns boolean
    if ( 0 < udg_Chain_Terminator_Patchwerk ) then
        return true
    endif
    return false
endfunction

function Trig_Charge_Death_Sentence_Patchwerk_Actions takes nothing returns nothing
    local integer i = 41
    if ( Trig_Charge_Death_Sentence_Patchwerk_Func001C() ) then
        set udg_Temp_Unit_Point = GetUnitLoc(udg_Chain_Units_Patchwerk[udg_Chain_Terminator_Patchwerk])
        call RemoveUnit( udg_Chain_Units_Patchwerk[udg_Chain_Terminator_Patchwerk] )
        if not IsTerrainPathable( GetLocationX(udg_Temp_Unit_Point), GetLocationY(udg_Temp_Unit_Point), PATHING_TYPE_WALKABILITY) then
        call SetUnitPositionLoc( udg_Chain_Target[7], udg_Temp_Unit_Point )
        endif
        call RemoveLocation (udg_Temp_Unit_Point)
        set udg_Chain_Terminator_Patchwerk = ( udg_Chain_Terminator_Patchwerk - 1 )
    else
        call RemoveLocation (udg_Point_Charge_Begin[i])
        call RemoveLocation (udg_Point_Charge_End[i])
        call DestroyEffectBJ( udg_Charge_SE[i] )
	call DestroyEffectBJ( udg_Charge_SE[i+3] )
        set udg_Temp_Unit = gg_unit_U043_1599
        call UnitDamageTargetBJ( udg_Temp_Unit, udg_Chain_Target[7], 600.00, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        call DisableTrigger( GetTriggeringTrigger() )
    endif
endfunction

//===========================================================================
function InitTrig_Charge_Death_Sentence_Patchwerk takes nothing returns nothing
    set gg_trg_Charge_Death_Sentence_Patchwerk = CreateTrigger(  )
    call DisableTrigger( gg_trg_Charge_Death_Sentence_Patchwerk )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Charge_Death_Sentence_Patchwerk, 0.04 )
    call TriggerAddAction( gg_trg_Charge_Death_Sentence_Patchwerk, function Trig_Charge_Death_Sentence_Patchwerk_Actions )
endfunction


//===========================================================================
// Trigger: Plague Explosions 8k
//
// Set local temp unit
// Make new firelords func that returns unit but doesnt set temp unit
// Need to use something other than temp unit in AoE
//===========================================================================
function Trig_Plague_Explosions_8k_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'U043' ) ) then
        return false
    endif
    if ( not ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) < 8000.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Plague_Explosions_8k_Func018Func008A takes nothing returns nothing
    local unit udg_Temp_Unit = GetTriggerUnit()
    if IsUnitTargetableEnemy( GetEnumUnit(), udg_Temp_Unit) then
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), 800.00, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call IssueTargetOrderBJ( gg_unit_e00H_2048, "acidbomb", GetEnumUnit() )
    call AddSpecialEffectTargetUnitBJ( "overhead", GetEnumUnit(), "war3mapImported\\plaguebomb_bigger.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    endif
    set udg_Temp_Unit = null
endfunction

function Trig_Plague_Explosions_8k_Actions takes nothing returns nothing
    local real udg_Temp_Angle = 90
    local integer udg_Temp_Int = 0
    local unit udg_Temp_Unit
    local location udg_Temp_Unit_Point
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Naxx_Minion_Spawn)
    call DisableTrigger( GetTriggeringTrigger() )
    // Move the Dummy
    set udg_Temp_Unit = gg_unit_e00H_2048
    call SetUnitOwner( udg_Temp_Unit, GetOwningPlayer(GetTriggerUnit()), true )
    call SetUnitPositionLocFacingBJ( udg_Temp_Unit, udg_Temp_Unit_Point, GetUnitFacing(GetTriggerUnit()) )
    // Dummy Stats
    set udg_Temp_Unit = gg_unit_e00H_2048
    call SetUnitAbilityLevelSwapped( 'A03H', udg_Temp_Unit, 9 )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A03H'), ABILITY_RLF_PRIMARY_DAMAGE, 8, 60.00 )
    set udg_Temp_Int = 1
    loop
        exitwhen udg_Temp_Int > 12
        call SetUnitOwner( udg_Temp_Unit, GetOwningPlayer(GetTriggerUnit()), true )
        set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 820.00, udg_Temp_Angle)
        // SE
        call AddSpecialEffectLocBJ( udg_Temp_Polar_Point, "war3mapImported\\Nether Blast III.mdx" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        // AoE
        set bj_wantDestroyGroup = true
        call ForGroupBJ( GetUnitsInRangeOfLocAll(360.00, udg_Temp_Polar_Point), function Trig_Plague_Explosions_8k_Func018Func008A )
        call RemoveLocation (udg_Temp_Polar_Point)
        set udg_Temp_Angle = udg_Temp_Angle - 30
        call SetUnitOwner( udg_Temp_Unit, Player(PLAYER_NEUTRAL_PASSIVE), true )
        call GameTimeWait(0.4)
        set udg_Temp_Int = udg_Temp_Int + 1
    endloop
    // CleanUp
    set udg_Temp_Unit = null
    set udg_Temp_Unit_Point = null
    set udg_Temp_Polar_Point = null
    call TriggerSleepAction( 14.00 )
    call EnableTrigger( GetTriggeringTrigger() )
endfunction

//===========================================================================
function InitTrig_Plague_Explosions_8k takes nothing returns nothing
    set gg_trg_Plague_Explosions_8k = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Plague_Explosions_8k, EVENT_PLAYER_UNIT_DAMAGED )
    call TriggerAddCondition( gg_trg_Plague_Explosions_8k, Condition( function Trig_Plague_Explosions_8k_Conditions ) )
    call TriggerAddAction( gg_trg_Plague_Explosions_8k, function Trig_Plague_Explosions_8k_Actions )
endfunction

