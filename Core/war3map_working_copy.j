//===========================================================================
// Trigger: Scarlet Cannon
//===========================================================================
function Trig_Scarlet_Cannon_Conditions takes nothing returns boolean
    return GetUnitTypeId(GetDyingUnit()) == 'o013'
endfunction

function Trig_Scarlet_Cannon_Actions takes nothing returns nothing
    local integer exec = GetTriggerExecCount(gg_trg_Scarlet_Cannon) // snapshot BEFORE wait
    local integer k = ModuloInteger(exec, 4)

    local location p

    call TriggerSleepAction(120.00)

    if (k == 0) then
        set p = GetRectCenter(gg_rct_Scarlet_Cannon_1)
        call CreateNUnitsAtLoc(1, 'o013', Player(PLAYER_NEUTRAL_AGGRESSIVE), p, 151.67)
    elseif (k == 1) then
        set p = GetRectCenter(gg_rct_Scarlet_Cannon_2)
        call CreateNUnitsAtLoc(1, 'o013', Player(PLAYER_NEUTRAL_AGGRESSIVE), p, 237.83)
    elseif (k == 2) then
        set p = GetRectCenter(gg_rct_Scarlet_Cannon_3)
        call CreateNUnitsAtLoc(1, 'o013', Player(PLAYER_NEUTRAL_AGGRESSIVE), p, 310.52)
    else
        set p = GetRectCenter(gg_rct_Scarlet_Cannon_4)
        call CreateNUnitsAtLoc(1, 'o013', Player(PLAYER_NEUTRAL_AGGRESSIVE), p, 224.88)
    endif

    call RemoveLocation(p)
    set p = null

    call SetUnitAcquireRangeBJ(GetLastCreatedUnit(), 200.00)
endfunction

function InitTrig_Scarlet_Cannon takes nothing returns nothing
    set gg_trg_Scarlet_Cannon = CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_Scarlet_Cannon, Player(PLAYER_NEUTRAL_AGGRESSIVE), EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_Scarlet_Cannon, Condition(function Trig_Scarlet_Cannon_Conditions))
    call TriggerAddAction(gg_trg_Scarlet_Cannon, function Trig_Scarlet_Cannon_Actions)
endfunction

