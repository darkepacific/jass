    set udg_PathofFrost[8] = PolarProjectionBJ(udg_PathofFrost[7], 200.00, AngleBetweenPoints(udg_PathofFrost[7], udg_PathofFrost[6]))
    call CreateNUnitsAtLoc( 1, 'e025', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_PathofFrost[8], bj_UNIT_FACING )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(GetLastCreatedUnit(), 'A01F'), ABILITY_RLF_AREA_OF_EFFECT_DAMAGE, 0, 850.00 )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "frostnova", GetLastCreatedUnit() )
    call UnitApplyTimedLifeBJ( 0.85, 'BTLF', GetLastCreatedUnit() )
    call RemoveLocation (udg_PathofFrost[8])
    call TriggerSleepAction( 0.25 )
    call CreateNUnitsAtLoc( 1, 'e026', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_PathofFrost[7], bj_UNIT_FACING )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(GetLastCreatedUnit(), 'A072'), ABILITY_RLF_AREA_OF_EFFECT_DAMAGE, 0, 1700.00 )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "frostnova", GetLastCreatedUnit() )
    call UnitApplyTimedLifeBJ( 0.85, 'BTLF', GetLastCreatedUnit() )
    call TriggerSleepAction( 0.25 )
    set udg_PathofFrost[8] = PolarProjectionBJ(udg_PathofFrost[7], -200.00, AngleBetweenPoints(udg_PathofFrost[7], udg_PathofFrost[6]))
    call CreateNUnitsAtLoc( 1, 'e025', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_PathofFrost[8], bj_UNIT_FACING )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(GetLastCreatedUnit(), 'A01F'), ABILITY_RLF_AREA_OF_EFFECT_DAMAGE, 0, 850.00 )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "frostnova", GetLastCreatedUnit() )
    call UnitApplyTimedLifeBJ( 0.85, 'BTLF', GetLastCreatedUnit() )
    call RemoveLocation (udg_PathofFrost[6])
    call RemoveLocation (udg_PathofFrost[7])
    call RemoveLocation (udg_PathofFrost[8])
endfunction

