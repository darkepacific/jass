//===========================================================================
// Trigger: S RV
//
// Need to change this to team wide display.
//===========================================================================
function Trig_S_RV_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    call DisableTrigger( GetTriggeringTrigger() )
    call DisableTrigger( gg_trg_C_RV)
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Start_Voss)
    call CreateNUnitsAtLoc( 1, 'E01E', Player(3), udg_Temp_Unit_Point, 300.00 )
    call UnitShareVisionBJ( false, udg_LillianVoss, Player(4) )
    call UnitShareVisionBJ( false, udg_LillianVoss, Player(5) )
    call UnitShareVisionBJ( false, udg_LillianVoss, Player(6) )
    call UnitShareVisionBJ( false, udg_LillianVoss, Player(10) )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_LillianVoss = GetLastCreatedUnit()
    call SetUnitColor( GetLastCreatedUnit(), PLAYER_COLOR_PURPLE )
    call SetUnitInvulnerable( GetLastCreatedUnit(), true )
    call DestroyEffectBJ( udg_QuestMarks[104] )
    call SetHeroLevelBJ( udg_LillianVoss, 6, false )
    call IncUnitAbilityLevelSwapped( 'A00V', udg_LillianVoss )
    call UnitAddItemByIdSwapped( 'I032', udg_LillianVoss )
    call UnitAddItemByIdSwapped( 'I045', udg_LillianVoss )
    call MaxManaRestore( 1.0, udg_LillianVoss)
    call TriggerExecute( gg_trg_Quest_Rescue_Sound_H )
    call TriggerSleepAction( 1.15 )
    // Run Away
    call CreateTextTagUnitBJ( "TRIGSTR_9208", udg_LillianVoss, 0, 8.00, 85.00, 40.00, 100.00, 0 )
    call cleanUpText(1.3, 1.0)
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_VossRunE)
    call IssuePointOrderLocBJ( udg_LillianVoss, "move", udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    // Start Quest
    set udg_TempString = "A Deadly New Ally"
    set udg_TempString_Quest = "Find Lillian and convince her she's undead."
    call TriggerExecute( gg_trg_Quest_Start_H )
    set udg_TempString = ""
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    set udg_TempString = udg_QuestionMark
    call QuestSetEnabledBJ( true, udg_Quests[104] )
    call FlashQuestDialogButtonBJ(  )
    endif
    call AddSpecialEffectTargetUnitBJ( "overhead", udg_LillianVoss, udg_TempString )
    set udg_QuestMarks[104] = GetLastCreatedEffectBJ()
    call QuestSetCompletedBJ( udg_Quests[104], false )
    call CreateQuestItemBJ( udg_Quests[104], "TRIGSTR_9206" )
    call CampaignMinimapIconUnitBJ( udg_LillianVoss, bj_CAMPPINGSTYLE_TURNIN )
    set udg_MiniMapIcon[104] = GetLastCreatedMinimapIcon()
    call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), false )
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), true )
    endif
    call EnableTrigger( gg_trg_U_RV)
    call TriggerSleepAction( 3.00 )
    // Run Away
    call IssueImmediateOrderBJ( udg_LillianVoss, "windwalk" )
    call TriggerSleepAction( 0.35 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_VossRunW)
    call IssuePointOrderLocBJ( udg_LillianVoss, "move", udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 6.00 )
    	call TriggerRegisterUnitInRangeSimple( gg_trg_E_RV, 160.00, udg_LillianVoss)
    call EnableTrigger( gg_trg_E_RV)
    set udg_Temp_Unit_Point = null
endfunction

