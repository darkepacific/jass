        call SetPlayerAbilityAvailableBJ( true, 'A0CV', GetOwningPlayer(udg_yH_Feral_Druid) )
        call SetPlayerAbilityAvailableBJ( true, 'A0E1', GetOwningPlayer(udg_yH_Feral_Druid) )
        call SetPlayerAbilityAvailableBJ( true, 'A0E3', GetOwningPlayer(udg_yH_Feral_Druid) )
    else
