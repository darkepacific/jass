//===========================================================================
// Trigger: M Godfreys Downfall 142
//
// He gives you a rod of necromancy,
// Kill godfrey then use the rod to turn him into a forsaken.
// End! He revives but then says "I'll never obey! Never!!!"
//===========================================================================
function Trig_M_Godfreys_Downfall_142_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 142
    set udg_TempString = ""
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    set udg_TempString = udg_ExclamationMark
    endif
    call AddSpecialEffectTargetUnitBJ( "overhead", udg_ValkyrGilneas, udg_TempString )
    set udg_QuestMarks[udg_Temp_Int] = GetLastCreatedEffectBJ()
    set udg_TempString = "A rebellious Gilnean noble, Lord Godfrey, refuses to fall in line with his brethren. His disobedience will play well into our hands. Kill him, and I will raise him as a Forsaken. He was last seen at his manor to the east, Tempest’s Reach."
    // Set Quest Rewards
    set udg_QUEST_XP[udg_Temp_Int] = 800
    set udg_QUEST_GOLD[udg_Temp_Int] = 100
    set udg_QUEST_LVL_REQ[udg_Temp_Int] = udg_QUEST_ZONE_3_LVL_REQ
    call QuestRewards_TextSet(udg_Temp_Int)
    // End Set Quest Rewards
    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_9319", udg_TempString, "ReplaceableTextures\\CommandButtons\\BTNLordGodfrey.blp" )
    set udg_Quests[udg_Temp_Int] = GetLastCreatedQuestBJ()
    call QuestSetEnabledBJ( false, udg_Quests[udg_Temp_Int] )
    call EnableTrigger(gg_trg_S_GD)
endfunction

