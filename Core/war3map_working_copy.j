//===========================================================================
// Trigger: E FBP
//===========================================================================
function Trig_E_FBP_Func004C takes nothing returns boolean
    if ( not ( udg_QFB0 >= 3.00 ) ) then
        return false
    endif
    if ( not ( udg_QFB1 >= 1.00 ) ) then
        return false
    endif
    if ( not ( udg_QFB2 >= 1.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_E_FBP_Conditions takes nothing returns boolean
    if ( not Trig_E_FBP_Func004C() ) then
        return false
    endif
    return true
endfunction

function Trig_E_FBP_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 47
    local location udg_Temp_Unit_Point
    call DisableTrigger( GetTriggeringTrigger() )
    call DestroyEffectBJ( udg_QuestMarks[47] )
    if IsHordePlayer( GetLocalPlayer() ) then
    call FlashQuestDialogButtonBJ(  )
    endif
    call QuestSetCompletedBJ( udg_Quests[47], true )
    // Rewards
    set udg_XP = udg_QUEST_XP[udg_Temp_Int]
    set udg_Gold = udg_QUEST_GOLD[udg_Temp_Int]
    set udg_LVL_Req = udg_QUEST_LVL_REQ[udg_Temp_Int]
    set udg_TempString = "Frozen Body Parts"
    call TriggerExecute( gg_trg_Quest_Complete_H )
    call SetUnitAnimation( gg_unit_usep_1231, "stand work" )
    call CreateTextTagUnitBJ( "TRIGSTR_5131", gg_unit_U001_1233, 0, 8.00, 70.00, 50.00, 90.00, 0 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 15.00, 90.00 )
    call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
    call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 1.25 )
    call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 0.85 )
    call StopSoundBJ( gg_snd_undeadfemalelaugh, false )
    call PlaySoundOnUnitBJ( gg_snd_undeadfemalelaugh, 100.00, gg_unit_U001_1233 )
    call TriggerSleepAction( 0.20 )
    call SetUnitFacingTimed( gg_unit_U001_1233, 315.00, 0.30 )
    call TriggerSleepAction( 0.60 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_FBPLightning)
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl" )
    call PlaySoundAtPointBJ( gg_snd_LightningBolt1, 100.00, udg_Temp_Unit_Point, 0 )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_QuestMarks[47] = GetLastCreatedEffectBJ()
    call TriggerSleepAction( 0.40 )
    call DestroyEffectBJ( udg_QuestMarks[47] )
    call SetUnitFacingTimed( gg_unit_U001_1233, 135.84, 0.55 )
    call TriggerSleepAction( 0.40 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_FBPAbom)
    call CreateNUnitsAtLoc( 1, 'uabo', Player(3), udg_Temp_Unit_Point, 73.50 )
    call PlaySoundAtPointBJ( gg_snd_AbominationReady1, 100.00, udg_Temp_Unit_Point, 0 )
    call RemoveLocation (udg_Temp_Unit_Point)
    call SetUnitAnimation( gg_unit_usep_1231, "stand" )
    set udg_Temp_Unit_Point = null
endfunction

