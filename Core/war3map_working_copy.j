// Trigger: M Kill Thaurissan
//===========================================================================
function Trig_M_Kill_Thaurissan_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 111
    set udg_TempString = ""
    if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
