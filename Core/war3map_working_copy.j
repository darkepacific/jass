function InitTrig_Shield_Wall takes nothing returns nothing
    set gg_trg_Shield_Wall = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Shield_Wall, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Shield_Wall, Condition( function Trig_Shield_Wall_Conditions ) )
    call TriggerAddAction( gg_trg_Shield_Wall, function Trig_Shield_Wall_Actions )
endfunction

//===========================================================================
// Trigger: Charge
//===========================================================================
function Trig_Charge_Func010C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A018' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0D7' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Charge_Conditions takes nothing returns boolean
    if ( not Trig_Charge_Func010C() ) then
        return false
    endif
    return true
endfunction

function Trig_Charge_Func006C takes nothing returns boolean
    if ( not ( udg_Temp_Unit == gg_unit_Opgh_1163 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Charge_Func013Func001Func001Func002C takes nothing returns boolean
    if ( not ( IsTriggerEnabled(gg_trg_Charge_Timer_Extra) == false ) ) then
        return false
    endif
    if ( not ( IsTriggerEnabled(gg_trg_Leap_Timer_Extra) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Charge_Func013Func001Func001C takes nothing returns boolean
    if ( not ( udg_Temp_Unit == gg_unit_Opgh_1163 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Charge_Func013Func001C takes nothing returns boolean
    if ( not ( udg_Temp_Unit == udg_yH_Prot_Warr ) ) then
        return false
    endif
    return true
endfunction

function Trig_Charge_Func013C takes nothing returns boolean
    if ( not ( udg_Temp_Unit == udg_yA_Prot_Warr ) ) then
        return false
    endif
    return true
endfunction

function Trig_Charge_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 2.00 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A018', udg_Temp_Unit) * 40 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 20 )
    if ( Trig_Charge_Func006C() ) then
        set udg_HeroStatCalc = 550
    else
    endif
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    call DragonRoarSet()
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A018'), ABILITY_RLF_DAMAGE_HTB1, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), udg_RealStatCalc )
    call PlaySoundOnUnitBJ( gg_snd_WarriorHeroricLeap, 85.00, GetTriggerUnit() )
    call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "war3mapImported\\Valiant Charge.mdx" )
    if ( Trig_Charge_Func013C() ) then
        set udg_Temp_Int = 0
        set udg_o = ( udg_z_WR_PROT_A + 4 )
        set udg_SpellUnits[udg_o+1] = udg_SpellUnits[udg_o] 
        set udg_SpellUnits[udg_o] = GetSpellTargetUnit()
        set udg_Point_Charge_Begin[udg_Temp_Int] = GetUnitLoc(GetSpellAbilityUnit())
        set udg_Point_Charge_End[udg_Temp_Int] = GetUnitLoc(GetSpellTargetUnit())
        set udg_Charge_SE[udg_Temp_Int] = GetLastCreatedEffectBJ()
        set udg_Charge_Loop[udg_Temp_Int] = 1.00
        call EnableTrigger( gg_trg_Charge_Timer_Dwarf )
    else
        if ( Trig_Charge_Func013Func001C() ) then
            set udg_Temp_Int = 2
            set udg_o = ( udg_z_WR_PROT_H + 4 )
            set udg_SpellUnits[udg_o+1] = udg_SpellUnits[udg_o] 
            set udg_SpellUnits[udg_o] = GetSpellTargetUnit()
            set udg_Point_Charge_Begin[udg_Temp_Int] = GetUnitLoc(GetSpellAbilityUnit())
            set udg_Point_Charge_End[udg_Temp_Int] = GetUnitLoc(GetSpellTargetUnit())
            set udg_Charge_SE[udg_Temp_Int] = GetLastCreatedEffectBJ()
            set udg_Charge_Loop[udg_Temp_Int] = 1.00
            call EnableTrigger( gg_trg_Charge_Timer_Tauren )
        else
            if ( Trig_Charge_Func013Func001Func001C() ) then
                set udg_Temp_Int = 3
                set udg_Point_Charge_Begin[udg_Temp_Int] = GetUnitLoc(GetSpellAbilityUnit())
                set udg_Point_Charge_End[udg_Temp_Int] = GetUnitLoc(GetSpellTargetUnit())
                set udg_Charge_SE[udg_Temp_Int] = GetLastCreatedEffectBJ()
                set udg_Charge_Loop[udg_Temp_Int] = 1.00
                call EnableTrigger( gg_trg_Charge_Timer_Yimmiron )
            else
                if ( Trig_Charge_Func013Func001Func001Func002C() ) then
                    set udg_Temp_Int = 8
                    set udg_Point_Charge_Begin[udg_Temp_Int] = GetUnitLoc(GetSpellAbilityUnit())
                    set udg_Point_Charge_End[udg_Temp_Int] = GetUnitLoc(GetSpellTargetUnit())
                    set udg_Charge_SE[udg_Temp_Int] = GetLastCreatedEffectBJ()
                    set udg_Charge_Loop[udg_Temp_Int] = 1.00
                    set udg_Charge_Extra = GetTriggerUnit()
                    call EnableTrigger( gg_trg_Charge_Timer_Extra )
                else
                endif
            endif
        endif
    endif
endfunction

