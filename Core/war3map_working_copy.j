function Trig_Imprison_Tick_BE_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    set udg_Temp_Unit = udg_yH_Demon_Hunt
    set udg_o = udg_z_DH_VENG_H
    call TriggerExecute( gg_trg_Firelords_Helper)
    set udg_Temp_Unit_Point = GetUnitLoc(udg_SpellUnits[udg_o])
    call PlaySoundOnUnitBJ( gg_snd_RevenantDeath1, 85.00, udg_SpellUnits[udg_o] )
    call SetSoundOffsetBJ( 1.25, gg_snd_RevenantDeath1 )
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, false) ))
    set udg_HeroStatCalc = GetUnitAbilityLevelSwapped('A08K', udg_Temp_Unit)
    set udg_HeroStatCalc = ( 50 + ( 150 * udg_HeroStatCalc ) )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + ( 5.00 * udg_RealStatCalc ) )
    call UnitDamageTargetBJ( udg_Temp_Unit, udg_SpellUnits[udg_o], udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call AddSpecialEffectTargetUnitBJ( "chest", udg_SpellUnits[udg_o], "war3mapImported\\Valiant Charge Fel.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(310.00, udg_Temp_Unit_Point), function Trig_Imprison_Tick_BE_Func018A )
    call RemoveLocation (udg_Temp_Unit_Point)
    call DestroyEffectBJ( udg_ImprisonSE[2] )
    call DestroyEffectBJ( udg_ImprisonSE[3] )
endfunction

//===========================================================================
function InitTrig_Imprison_Tick_BE takes nothing returns nothing
    set gg_trg_Imprison_Tick_BE = CreateTrigger(  )
    call DisableTrigger( gg_trg_Imprison_Tick_BE )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Imprison_Tick_BE, 0.15 )
    call TriggerAddCondition( gg_trg_Imprison_Tick_BE, Condition( function Trig_Imprison_Tick_BE_Conditions ) )
    call TriggerAddAction( gg_trg_Imprison_Tick_BE, function Trig_Imprison_Tick_BE_Actions )
endfunction

//===========================================================================
// Trigger: Furious Gaze
//===========================================================================
function Trig_Furious_Gaze_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A08L' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Furious_Gaze_Func023C takes nothing returns boolean
    if ( not ( GetUnitStateSwap(UNIT_STATE_MANA, GetSpellTargetUnit()) >= 5.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Furious_Gaze_Actions takes nothing returns nothing
    local effect gate
    local unit target = GetSpellTargetUnit()
    local integer udg_Temp_Int
    set udg_Temp_Unit = GetTriggerUnit()
    if udg_Temp_Unit == udg_yA_Demon_Hunt then
    endif
    // Damage
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, false) ))
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 0 ]  then
    set udg_RealStatCalc = ( udg_RealStatCalc * 5.00 )
    else
    set udg_RealStatCalc = ( udg_RealStatCalc * 2.50 )
    endif
    call UnitDamageTargetBJ( udg_Temp_Unit, GetSpellTargetUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    // Point Calc
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    set udg_Temp_Polar_Point = GetSpellTargetLoc()
    set udg_Charge_Distance = DistanceBetweenPoints(udg_Temp_Unit_Point, udg_Temp_Polar_Point)
    set udg_Facing_Angle = AngleBetweenPoints(udg_Temp_Unit_Point, udg_Temp_Polar_Point)
    call RemoveLocation (udg_Temp_Polar_Point)
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, ( udg_Charge_Distance / 2.00 ), udg_Facing_Angle)
    // Mana Burn
    if ( Trig_Furious_Gaze_Func023C() ) then
        call CreateNUnitsAtLoc( 1, 'e02D', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, GetUnitFacing(GetTriggerUnit()) )
        call SetUnitPositionLoc( GetLastCreatedUnit(), udg_Temp_Unit_Point )
        if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 4 ]  then
        call SetUnitAbilityLevelSwapped( 'A08M', GetLastCreatedUnit(), ( GetUnitAbilityLevelSwapped('A08L', GetTriggerUnit()) + 3 ) )
        else
        call SetUnitAbilityLevelSwapped( 'A08M', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A08L', GetTriggerUnit()) )
        endif
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "manaburn", GetSpellTargetUnit() )
        call UnitApplyTimedLifeBJ( 0.75, 'BTLF', GetLastCreatedUnit() )
    else
    endif
    // Special Effect
    call AddSpecialEffectLocBJ( udg_Temp_Polar_Point, "war3mapImported\\Accelerator Gate Green.mdx" )
    call RemoveLocation (udg_Temp_Unit_Point)
    call RemoveLocation (udg_Temp_Polar_Point)
    set gate = GetLastCreatedEffectBJ()
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), Deg2Rad(( udg_Facing_Angle + 90.00 )), 0.0, 0.0 )
    set udg_RealStatCalc = ( udg_Charge_Distance / 350.00 )
    if udg_RealStatCalc < 0.56 then
    set udg_RealStatCalc = 0.56
    endif
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), udg_RealStatCalc )
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), ( BlzGetLocalUnitZ(GetTriggerUnit()) + ( 17.00 - udg_RealStatCalc ) ) )
    call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 2.00 )
    // Purge Talent
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 9 ]  then
    call DummyPurge( udg_Temp_Unit, target)
    endif
    call TriggerSleepAction( 0.40 )
    call DestroyEffect( gate )
    set gate = null
    set target = null
endfunction

//===========================================================================
function InitTrig_Furious_Gaze takes nothing returns nothing
    set gg_trg_Furious_Gaze = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Furious_Gaze, EVENT_PLAYER_UNIT_SPELL_CHANNEL )
    call TriggerAddCondition( gg_trg_Furious_Gaze, Condition( function Trig_Furious_Gaze_Conditions ) )
    call TriggerAddAction( gg_trg_Furious_Gaze, function Trig_Furious_Gaze_Actions )
endfunction

//===========================================================================
// Trigger: Sweeping Strike
//===========================================================================
function Trig_Sweeping_Strike_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A01Y' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Sweeping_Strike_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    call AddSpecialEffectTargetUnitBJ( "origin", GetSpellAbilityUnit(), "war3mapImported\\Valiant Charge Fel.mdx" )
    if udg_Temp_Unit == udg_yA_Demon_Hunt then
    set udg_Temp_Int = 10
    else
    set udg_Temp_Int = 11
    endif
    set udg_Point_Charge_Begin[udg_Temp_Int] = GetUnitLoc(GetSpellAbilityUnit())
    set udg_Point_Charge_End[udg_Temp_Int] = GetSpellTargetLoc()
    set udg_Charge_SE[udg_Temp_Int] = GetLastCreatedEffectBJ()
    set udg_Charge_Loop[udg_Temp_Int] = 1.00
    if udg_Temp_Unit == udg_yA_Demon_Hunt then
    call EnableTrigger( gg_trg_Sweeping_Strike_Timer_NE )
    else
    call EnableTrigger( gg_trg_Sweeping_Strike_Timer_BE )
    endif
endfunction

//===========================================================================
function InitTrig_Sweeping_Strike takes nothing returns nothing
    set gg_trg_Sweeping_Strike = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Sweeping_Strike, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Sweeping_Strike, Condition( function Trig_Sweeping_Strike_Conditions ) )
    call TriggerAddAction( gg_trg_Sweeping_Strike, function Trig_Sweeping_Strike_Actions )
endfunction

//===========================================================================
// Trigger: Sweeping Strike Timer NE
//===========================================================================
function Trig_Sweeping_Strike_Timer_NE_Func014Func006Func007A takes nothing returns nothing
    if IsUnitTargetableEnemyHitsAll( GetEnumUnit(), udg_Temp_Unit) then
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL )
    call AddSpecialEffectTargetUnitBJ( "overhead", GetEnumUnit(), "Abilities\\Spells\\Items\\AIda\\AIdaTarget.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set udg_NumbUnitsHit = ( udg_NumbUnitsHit + 1 )
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_Sweeping_Strike_Timer_NE_Func014Func006Func008Func007C takes nothing returns boolean
    if ( not ( udg_NumbUnitsHit >= 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Sweeping_Strike_Timer_NE_Func014Func006Func008C takes nothing returns boolean
    if ( not ( udg_NumbUnitsHit >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Sweeping_Strike_Timer_NE_Func014Func006C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Temp_Unit) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Sweeping_Strike_Timer_NE_Func014C takes nothing returns boolean
    if ( not ( udg_Charge_Loop[udg_Temp_Int] < 15.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Sweeping_Strike_Timer_NE_Actions takes nothing returns nothing
    local integer bonusMana
    set udg_Temp_Unit = udg_yA_Demon_Hunt
    set bonusMana = BlzGetAbilityManaCost('A01Y', GetUnitAbilityLevel( udg_Temp_Unit,'A01Y') -1 ) / 2
    //call Debug("Bonus Mana: " + I2S(bonusMana))
    set udg_Temp_Int = 10
    set udg_Charge_Distance = DistanceBetweenPoints(udg_Point_Charge_Begin[udg_Temp_Int], udg_Point_Charge_End[udg_Temp_Int])
    set udg_RealStatCalc = AngleBetweenPoints(udg_Point_Charge_Begin[udg_Temp_Int], udg_Point_Charge_End[udg_Temp_Int])
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Point_Charge_Begin[udg_Temp_Int], ( udg_Charge_Distance * ( udg_Charge_Loop[udg_Temp_Int] / 15.00 ) ), udg_RealStatCalc)
    if not IsTerrainPathable( GetLocationX(udg_Temp_Polar_Point), GetLocationY(udg_Temp_Polar_Point), PATHING_TYPE_WALKABILITY) then
    call SetUnitPositionLocFacingLocBJ( udg_Temp_Unit, udg_Temp_Polar_Point, udg_Point_Charge_End[udg_Temp_Int] )
    endif
    call RemoveLocation (udg_Temp_Polar_Point)
    if ( Trig_Sweeping_Strike_Timer_NE_Func014C() ) then
        set udg_Charge_Loop[udg_Temp_Int] = ( udg_Charge_Loop[udg_Temp_Int] + 1 )
    else
        call RemoveLocation (udg_Point_Charge_Begin[udg_Temp_Int])
        call RemoveLocation (udg_Point_Charge_End[udg_Temp_Int])
        call DestroyEffectBJ( udg_Charge_SE[udg_Temp_Int] )
        call DisableTrigger( GetTriggeringTrigger() )
        if ( Trig_Sweeping_Strike_Timer_NE_Func014Func006C() ) then
            call TriggerExecute( gg_trg_Firelords_Helper)
            set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
            set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, false) ))
            set udg_RealStatCalc = ( 1.50 * udg_RealStatCalc )
            set udg_NumbUnitsHit = 0
            set bj_wantDestroyGroup = true
            call ForGroupBJ( GetUnitsInRangeOfLocAll(210.00, udg_Temp_Unit_Point), function Trig_Sweeping_Strike_Timer_NE_Func014Func006Func007A )
            if ( Trig_Sweeping_Strike_Timer_NE_Func014Func006Func008C() ) then
                call BlzEndUnitAbilityCooldown( udg_Temp_Unit, 'A01Y' )
                call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Culling Slash II.mdx" )
                call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), ( BlzGetLocalUnitZ(udg_Temp_Unit) + 32.00 ) )
                call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), Deg2Rad(GetUnitFacing(GetTriggerUnit())), 0.0, 0.00 )
                call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.69 )
                call DestroyEffectBJ( GetLastCreatedEffectBJ() )
                if ( Trig_Sweeping_Strike_Timer_NE_Func014Func006Func008Func007C() ) then
                    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 3 ]  then
                    call SetUnitState(udg_Temp_Unit, UNIT_STATE_MANA, GetUnitState( udg_Temp_Unit,UNIT_STATE_MANA) + bonusMana)
                     call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "Abilities\\Spells\\Items\\AIre\\AIreTarget.mdl")
                     call DestroyEffectBJ( GetLastCreatedEffectBJ() )
                    call CreateTextTagUnitBJ( ( "+" + ( I2S( bonusMana ) + " Mana!" ) ), udg_Temp_Unit, 0.00, 8.00, 50.00, 50.00, 100.00, 0 )
                    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64.00, 0.00 )
                    call cleanUpText( 0.8, 0.55) 
                    endif
                else
                endif
            else
            endif
            call RemoveLocation (udg_Temp_Unit_Point)
        else
        endif
    endif
endfunction

