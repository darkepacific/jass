    else
    endif
    return
    if GetTriggerUnit() == udg_yH_Combat_Rogue then
    call UnitAddAbilityBJ( 'A09U', GetTriggerUnit() )
    else
    call UnitAddAbilityBJ( 'A06I', GetTriggerUnit() )
    endif
    call UnitMakeAbilityPermanent( GetTriggerUnit(), true, 'A09U')
    call UnitMakeAbilityPermanent( GetTriggerUnit(), true, 'A06I')
endfunction

