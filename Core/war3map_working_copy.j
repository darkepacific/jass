    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_7784", udg_TempString, "ReplaceableTextures\\CommandButtons\\BTNZuljin" )
    set udg_Quests[udg_Temp_Int] = GetLastCreatedQuestBJ()
    call QuestSetEnabledBJ( false, udg_Quests[udg_Temp_Int] )
    call EnableTrigger( gg_trg_S_Kill_ZulJin)
