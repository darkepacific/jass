    set gg_trg_Murlocs_Attacking = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Murlocs_Attacking, EVENT_PLAYER_UNIT_ATTACKED )
    call TriggerAddCondition( gg_trg_Murlocs_Attacking, Condition( function Trig_Murlocs_Attacking_Conditions ) )
    call TriggerAddAction( gg_trg_Murlocs_Attacking, function Trig_Murlocs_Attacking_Actions )
endfunction

