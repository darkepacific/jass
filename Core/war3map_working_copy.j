//===========================================================================
// Trigger: Slice N Dice
//
// Slice N Dice is SAFE to use with other heroes but will only last for 3s
//===========================================================================
function Trig_Slice_N_Dice_Func002C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A0SD' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A09V' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Slice_N_Dice_Func016C takes nothing returns boolean
    if ( ( GetSpellAbilityUnit() == udg_yA_Combat_Rogue ) ) then
        return true
    endif
    if ( ( GetSpellAbilityUnit() == udg_yH_Combat_Rogue ) ) then
        return true
    endif
    return false
endfunction

function Trig_Slice_N_Dice_Conditions takes nothing returns boolean
    if ( not Trig_Slice_N_Dice_Func002C() ) then
        return false
    endif
    if ( not Trig_Slice_N_Dice_Func016C() ) then
        return false
    endif
    return true
endfunction

function Trig_Slice_N_Dice_Func004C takes nothing returns boolean
    if ( not ( GetSpellAbilityUnit() == udg_yA_Combat_Rogue ) ) then
        return false
    endif
    return true
endfunction

function Trig_Slice_N_Dice_Func013Func001C takes nothing returns boolean
    if ( not ( GetSpellAbilityUnit() == udg_yH_Combat_Rogue ) ) then
        return false
    endif
    return true
endfunction

function Trig_Slice_N_Dice_Func013C takes nothing returns boolean
    if ( not ( GetSpellAbilityUnit() == udg_yA_Combat_Rogue ) ) then
        return false
    endif
    return true
endfunction

function Trig_Slice_N_Dice_Actions takes nothing returns nothing
    local real ComboPoints
    set udg_Temp_Unit = GetTriggerUnit()
    if ( Trig_Slice_N_Dice_Func004C() ) then
        call DestroyEffectBJ( udg_WRComboEffects[0] )
        call DestroyEffectBJ( udg_WRComboEffects[1] )
        call DestroyEffectBJ( udg_WRComboEffects[2] )
        set udg_RealStatCalc = ( 3.00 + ( 3.00 * udg_WRComboPoints ) )
        call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A0SD'), ABILITY_RLF_DURATION_HERO, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), udg_RealStatCalc )
        set ComboPoints = udg_WRComboPoints
        call ComboPointFrameSetPoints( udg_yA_Combat_Rogue, udg_WRComboPoints)
        set udg_WRComboPoints = 0.00
        call ResetComboPoints( GetTriggerUnit() )
    else
        call DestroyEffectBJ( udg_URComboEffects[0] )
        call DestroyEffectBJ( udg_URComboEffects[1] )
        call DestroyEffectBJ( udg_URComboEffects[2] )
        set udg_RealStatCalc = ( 3.00 + ( 3.00 * udg_URComboPoints ) )
        call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A09V'), ABILITY_RLF_DURATION_HERO, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), udg_RealStatCalc )
        set ComboPoints = udg_URComboPoints
        call ComboPointFrameSetPoints( udg_yH_Combat_Rogue, udg_URComboPoints)
        set udg_URComboPoints = 0.00
        call ResetComboPoints( GetTriggerUnit() )
    endif
    // Ruthless
    call GameTimeWait(0.1)
    if GetRandomReal( 0.0, 2.99) < ComboPoints then
    set udg_Temp_Unit = GetTriggerUnit()
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 10 ] then 
    call CreateTextTagUnitBJ( "TRIGSTR_775", udg_Temp_Unit, 12.00, 9.00, 40.00, 100.00, 40.00, 0 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64, 90.00 )
    call cleanUpText(1.0, 0.5)
    if ( Trig_Slice_N_Dice_Func013C() ) then
        call ShowTextTagForceBJ( true, GetLastCreatedTextTag(), udg_AlliancePlayers )
        call TriggerExecute( gg_trg_WR_ComboGen )
    else
        if ( Trig_Slice_N_Dice_Func013Func001C() ) then
            call ShowTextTagForceBJ( true, GetLastCreatedTextTag(), udg_HordePlayers )
            call TriggerExecute( gg_trg_UR_ComboGen )
        else
        endif
    endif
    endif
    endif
endfunction

//===========================================================================
function InitTrig_Slice_N_Dice takes nothing returns nothing
    set gg_trg_Slice_N_Dice = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Slice_N_Dice, EVENT_PLAYER_UNIT_SPELL_CAST )
    call TriggerAddCondition( gg_trg_Slice_N_Dice, Condition( function Trig_Slice_N_Dice_Conditions ) )
    call TriggerAddAction( gg_trg_Slice_N_Dice, function Trig_Slice_N_Dice_Actions )
endfunction

//===========================================================================
// Trigger: Plunder
//
// Temp Unit = Killing Unit
//===========================================================================
function Trig_Plunder_Func002C takes nothing returns boolean
    if ( ( GetKillingUnitBJ() == udg_yA_Combat_Rogue ) ) then
        return true
    endif
    if ( ( GetKillingUnitBJ() == udg_yH_Combat_Rogue ) ) then
        return true
    endif
    return false
endfunction

function Trig_Plunder_Conditions takes nothing returns boolean
    if ( not ( GetPlayerController(GetOwningPlayer(GetKillingUnitBJ())) == MAP_CONTROL_USER ) ) then
        return false
    endif
    if ( not Trig_Plunder_Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_Plunder_Actions takes nothing returns nothing
    local integer udg_Gold = 0
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer( GetKillingUnit() )) * udg_NUM_OF_TC + 3 ]  then
    if GetKillingUnit() == udg_yA_Combat_Rogue or GetKillingUnit() == udg_yH_Combat_Rogue then
    set udg_Gold = BlzGetUnitIntegerField(GetTriggerUnit(),UNIT_IF_GOLD_BOUNTY_AWARDED_BASE ) * 3 / 10
    if udg_Gold == 0 then
    set udg_Gold = 1
    endif
    call AdjustPlayerStateBJ( udg_Gold, GetOwningPlayer(GetKillingUnitBJ()), PLAYER_STATE_RESOURCE_GOLD )
    call CreateTextTagUnitBJ( ( "+" + ( I2S(udg_Gold) + " Bonus Gold!" ) ), GetTriggerUnit(), -12.00, 10.00, 100.00, 85.00, 0.00, 0 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64, 90.00 )
    call cleanUpText(1.6, 1.25)
    call AddSpecialEffectTargetUnitBJ( "overhead", GetTriggerUnit(), "Abilities\\Spells\\Other\\Transmute\\PileofGold.mdl" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.80 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    endif
    endif
endfunction

//===========================================================================
function InitTrig_Plunder takes nothing returns nothing
    set gg_trg_Plunder = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Plunder, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_Plunder, Condition( function Trig_Plunder_Conditions ) )
    call TriggerAddAction( gg_trg_Plunder, function Trig_Plunder_Actions )
endfunction

//===========================================================================
// Trigger: Garrote
//===========================================================================
function Trig_Garrote_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A09J' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Garrote_Func002C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 6) > 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Garrote_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    if ( Trig_Garrote_Func002C() ) then
        call PlaySoundOnUnitBJ( gg_snd_MetalLightSliceFlesh2, 100.00, GetSpellAbilityUnit() )
    else
        call PlaySoundOnUnitBJ( gg_snd_MetalLightSliceFlesh3, 100.00, GetSpellAbilityUnit() )
    endif
    call SetUnitOwner( gg_unit_e028_1863, GetOwningPlayer(udg_Temp_Unit), true )
    call SetUnitAbilityLevelSwapped( 'A096', gg_unit_e028_1863, 1 )
    call IssueTargetOrderBJ( gg_unit_e028_1863, "soulburn", GetSpellTargetUnit() )
    // Dmg
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_AGI, GetTriggerUnit(), true) - GetHeroStatBJ(bj_HEROSTAT_AGI, GetTriggerUnit(), false) ))
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 2 ] then 
    set udg_RealStatCalc = ( 4.00 * udg_RealStatCalc )
    else
    set udg_RealStatCalc = ( 2.50 * udg_RealStatCalc )
    endif
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A09J', udg_Temp_Unit) * 20 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A09J'), ABILITY_RLF_INITIAL_DAMAGE_ESH5, ( GetUnitAbilityLevelSwapped('A09J', GetTriggerUnit()) - 1 ), udg_RealStatCalc )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A09J'), ABILITY_RLF_DECAYING_DAMAGE, ( GetUnitAbilityLevelSwapped('A09J', GetTriggerUnit()) - 1 ), udg_RealStatCalc )
endfunction

//===========================================================================
function InitTrig_Garrote takes nothing returns nothing
    set gg_trg_Garrote = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Garrote, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Garrote, Condition( function Trig_Garrote_Conditions ) )
    call TriggerAddAction( gg_trg_Garrote, function Trig_Garrote_Actions )
endfunction

//===========================================================================
// Trigger: Fire the Cannons
//===========================================================================
function Trig_Fire_the_Cannons_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0F0' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fire_the_Cannons_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_Temp_Unit_Point = GetSpellTargetLoc()
    call CreateNUnitsAtLoc( 1, 'e00P', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, bj_UNIT_FACING )
    call SetUnitAbilityLevelSwapped( 'A0EY', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0F0', GetTriggerUnit()) )
    call IssuePointOrderLocBJ( GetLastCreatedUnit(), "blizzard", udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call UnitApplyTimedLifeBJ( 8.50, 'BTLF', GetLastCreatedUnit() )
    if ( udg_Temp_Unit == udg_yA_Combat_Rogue ) then
    set udg_Temp_Int = 32
    set udg_Blizzard[32] = GetSpellTargetLoc()
    set udg_SpellTicks[udg_Temp_Int] = 1
    call EnableTrigger ( gg_trg_Fire_the_Cannons_Tick_WR)
    elseif ( udg_Temp_Unit == udg_yH_Combat_Rogue ) then
    set udg_Temp_Int = 33
    set udg_Blizzard[33] = GetSpellTargetLoc()
    set udg_SpellTicks[udg_Temp_Int] = 1
    call EnableTrigger ( gg_trg_Fire_the_Cannons_Tick_UR)
    endif
endfunction

//===========================================================================
function InitTrig_Fire_the_Cannons takes nothing returns nothing
    set gg_trg_Fire_the_Cannons = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Fire_the_Cannons, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Fire_the_Cannons, Condition( function Trig_Fire_the_Cannons_Conditions ) )
    call TriggerAddAction( gg_trg_Fire_the_Cannons, function Trig_Fire_the_Cannons_Actions )
endfunction

//===========================================================================
// Trigger: Fire the Cannons Tick WR
//===========================================================================
function Trig_Fire_the_Cannons_Tick_WR_Func011A takes nothing returns nothing
    if IsUnitTargetableEnemy( GetEnumUnit(), udg_Temp_Unit ) then
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    set udg_Temp_Int = 32
    if SpellUnits_Contains( GetEnumUnit(), udg_z_RO_COMB_A, 40, 63) then
    call IssueTargetOrderBJ( gg_unit_e028_1863, "slow", GetEnumUnit() )
    set udg_Temp_Real = ( udg_Temp_Real + 0.20 )
    endif
    call SpellUnits_Add( GetEnumUnit(), udg_z_RO_COMB_A, 40, 63) 
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_Fire_the_Cannons_Tick_WR_Func016C takes nothing returns boolean
    if ( not ( udg_SpellTicks[udg_Temp_Int] == 8 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fire_the_Cannons_Tick_WR_Actions takes nothing returns nothing
    set udg_Temp_Unit = udg_yA_Combat_Rogue
    call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, true) - 0 ))
    set udg_RealStatCalc = ( 1.50 * udg_RealStatCalc )
    call SetUnitAbilityLevelSwapped( 'A03P', gg_unit_e028_1863, 4 )
    call SetUnitOwner( gg_unit_e028_1863, GetOwningPlayer(udg_Temp_Unit), true )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(gg_unit_e028_1863, 'A03P'), ABILITY_RLF_DURATION_NORMAL, 3, 0.5 )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(gg_unit_e028_1863, 'A03P'), ABILITY_RLF_DURATION_HERO, 3, 0.5 )
    set udg_Temp_Real = 0.00
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(( 270.00 + ( 50.00 * I2R(GetUnitAbilityLevelSwapped('A0F0', udg_Temp_Unit)) ) ), udg_Blizzard[32]), function Trig_Fire_the_Cannons_Tick_WR_Func011A )
    if udg_Temp_Real > GetRandomReal( 0, 1.0) and (udg_WREviscerate == true) then
    call TriggerExecute(gg_trg_WR_ComboGen)
    endif
    set udg_Temp_Int = 32
    if ( Trig_Fire_the_Cannons_Tick_WR_Func016C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        call SpellUnits_Clear( udg_z_RO_COMB_H, 40, 63) 
    else
        set udg_SpellTicks[udg_Temp_Int] = ( udg_SpellTicks[udg_Temp_Int] + 1 )
    endif
endfunction

//===========================================================================
function InitTrig_Fire_the_Cannons_Tick_WR takes nothing returns nothing
    set gg_trg_Fire_the_Cannons_Tick_WR = CreateTrigger(  )
    call DisableTrigger( gg_trg_Fire_the_Cannons_Tick_WR )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Fire_the_Cannons_Tick_WR, 1.00 )
    call TriggerAddAction( gg_trg_Fire_the_Cannons_Tick_WR, function Trig_Fire_the_Cannons_Tick_WR_Actions )
endfunction

