function Trig_S_or_U_AWT_Acquire_Func004C takes nothing returns boolean
    if ( not ( IsTriggerEnabled(gg_trg_S_AWT_by_Entry) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_S_or_U_AWT_Acquire_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
                       if IsHordeHero( GetTriggerUnit() ) then
    if ( Trig_S_or_U_AWT_Acquire_Func004C() ) then
        set udg_TempString = "A Wretched Task"
        set udg_TempString_Quest = "Return Meledor's Spellbook."
        call TriggerExecute( gg_trg_Quest_Start_H )
        call DisableTrigger( gg_trg_S_AWT_by_Entry )
        set udg_TempString = ""
        if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
        set udg_TempString = udg_QuestionMark
        call QuestSetEnabledBJ( true, udg_Quests[60] )
        call FlashQuestDialogButtonBJ(  )
        endif
        call DestroyEffectBJ( udg_QuestMarks[60] )
        call AddSpecialEffectTargetUnitBJ( "overhead", gg_unit_h01U_0238, udg_TempString )
        set udg_QuestMarks[60] = GetLastCreatedEffectBJ()
        call QuestSetCompletedBJ( udg_Quests[60], false )
        call CreateQuestItemBJ( udg_Quests[60], "TRIGSTR_319" )
        // Icon
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Wretched_Port)
        call CampaignMinimapIconLocBJ( udg_Temp_Unit_Point, bj_CAMPPINGSTYLE_CONTROL_NEUTRAL )
        call RemoveLocation (udg_Temp_Unit_Point)
        set udg_MiniMapIcon[60] = GetLastCreatedMinimapIcon()
        call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), false )
        if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
        call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), true )
        endif
    else
        call DisableTrigger( GetTriggeringTrigger() )
        // Icon
        call DestroyMinimapIcon( udg_MiniMapIcon[60] )
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_A_Wretched_Task)
        call CampaignMinimapIconLocBJ( udg_Temp_Unit_Point, bj_CAMPPINGSTYLE_TURNIN )
        call RemoveLocation (udg_Temp_Unit_Point)
        set udg_MiniMapIcon[60] = GetLastCreatedMinimapIcon()
        call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), false )
        if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
        call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), true )
        endif
    endif
    call EnableTrigger( gg_trg_E_AWT )
                       endif
    set udg_Temp_Unit_Point = null
endfunction

