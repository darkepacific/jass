//===========================================================================
// Trigger: Death Sentence WR
//===========================================================================
function Trig_Death_Sentence_WR_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0DS' ) ) then
        return false
    endif
    if ( not ( GetSpellAbilityUnit() == udg_yA_Combat_Rogue ) ) then
        return false
    endif
    return true
endfunction

function Trig_Death_Sentence_WR_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 5
    set udg_Point_Charge_Begin[udg_Temp_Int] = GetUnitLoc(GetSpellAbilityUnit())
    set udg_Point_Charge_End[udg_Temp_Int] = GetUnitLoc(GetSpellTargetUnit())
    set udg_Chain_Target[0] = GetSpellTargetUnit()
    set udg_Charge_Distance = DistanceBetweenPoints(udg_Point_Charge_Begin[udg_Temp_Int], udg_Point_Charge_End[udg_Temp_Int])
    set udg_RealStatCalc = AngleBetweenPoints(udg_Point_Charge_Begin[udg_Temp_Int], udg_Point_Charge_End[udg_Temp_Int])
    set udg_Chain_Terminator_Worgen = ( R2I(( udg_Charge_Distance / 50.00 )) - 1 )
    set udg_Temp_Unit = udg_yA_Combat_Rogue
    call PlaySoundOnUnitBJ( gg_snd_100_thresh_base_shackle_oml_0201, 100, udg_Temp_Unit )
    // Create Distance / 50 chains (1 ~ 10)
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = udg_Chain_Terminator_Worgen
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Point_Charge_Begin[udg_Temp_Int], ( 50.00 * I2R(GetForLoopIndexA()) ), udg_RealStatCalc)
        call CreateNUnitsAtLocFacingLocBJ( 1, 'e021', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, udg_Point_Charge_End[udg_Temp_Int] )
        call RemoveLocation (udg_Temp_Polar_Point)
        set udg_Chain_Units_Worgen[GetForLoopIndexA()] = GetLastCreatedUnit()
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    // make wolf face angle
    set udg_Temp_Unit = udg_yA_Combat_Rogue
    call BlzSetUnitFacingEx( udg_Temp_Unit, udg_RealStatCalc )
    // Turn on Every .05 sec
    call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "war3mapImported\\Valiant Charge Fel.mdx" )
    set udg_Charge_SE[udg_Temp_Int] = GetLastCreatedEffectBJ()
    set udg_i_Chain_Worgen = 0
    call TriggerSleepAction( 0.28 )
    // playsound
    set udg_Temp_Unit = udg_yA_Combat_Rogue
    call PlaySoundOnUnitBJ( gg_snd_086_thresh_base_shackle_oba_drag_01, 100, udg_Temp_Unit )
    call EnableTrigger( gg_trg_Charge_Death_Sentence_WR)
endfunction

//===========================================================================
function InitTrig_Death_Sentence_WR takes nothing returns nothing
    set gg_trg_Death_Sentence_WR = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Death_Sentence_WR, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Death_Sentence_WR, Condition( function Trig_Death_Sentence_WR_Conditions ) )
    call TriggerAddAction( gg_trg_Death_Sentence_WR, function Trig_Death_Sentence_WR_Actions )
endfunction

//===========================================================================
// Trigger: Death Sentence UR
//===========================================================================
function Trig_Death_Sentence_UR_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0DS' ) ) then
        return false
    endif
    if ( not ( GetSpellAbilityUnit() == udg_yH_Combat_Rogue ) ) then
        return false
    endif
    return true
endfunction

function Trig_Death_Sentence_UR_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 16
    set udg_Point_Charge_Begin[udg_Temp_Int] = GetUnitLoc(GetSpellAbilityUnit())
    set udg_Point_Charge_End[udg_Temp_Int] = GetUnitLoc(GetSpellTargetUnit())
    set udg_Chain_Target[4] = GetSpellTargetUnit()
    set udg_Charge_Distance = DistanceBetweenPoints(udg_Point_Charge_Begin[udg_Temp_Int], udg_Point_Charge_End[udg_Temp_Int])
    set udg_RealStatCalc = AngleBetweenPoints(udg_Point_Charge_Begin[udg_Temp_Int], udg_Point_Charge_End[udg_Temp_Int])
    set udg_Chain_Terminator_Undead = ( R2I(( udg_Charge_Distance / 50.00 )) - 1 )
    set udg_Temp_Unit = udg_yH_Combat_Rogue
    call PlaySoundOnUnitBJ( gg_snd_100_thresh_base_shackle_oml_0201, 100, udg_Temp_Unit )
    // Create Distance / 50 chains (1 ~ 10)
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = udg_Chain_Terminator_Undead
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Point_Charge_Begin[udg_Temp_Int], ( 50.00 * I2R(GetForLoopIndexA()) ), udg_RealStatCalc)
        call CreateNUnitsAtLocFacingLocBJ( 1, 'e021', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, udg_Point_Charge_End[udg_Temp_Int] )
        call RemoveLocation (udg_Temp_Polar_Point)
        set udg_Chain_Units_Undead[GetForLoopIndexA()] = GetLastCreatedUnit()
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    // make wolf face angle
    set udg_Temp_Unit = udg_yH_Combat_Rogue
    call BlzSetUnitFacingEx( udg_Temp_Unit, udg_RealStatCalc )
    // Turn on Every .05 sec
    call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "war3mapImported\\Valiant Charge Fel.mdx" )
    set udg_Charge_SE[udg_Temp_Int] = GetLastCreatedEffectBJ()
    set udg_i_Chain_Undead = 0
    call TriggerSleepAction( 0.28 )
    // playsound
    set udg_Temp_Unit = udg_yH_Combat_Rogue
    call PlaySoundOnUnitBJ( gg_snd_086_thresh_base_shackle_oba_drag_01, 100, udg_Temp_Unit )
    call EnableTrigger( gg_trg_Charge_Death_Sentence_UR)
endfunction

//===========================================================================
function InitTrig_Death_Sentence_UR takes nothing returns nothing
    set gg_trg_Death_Sentence_UR = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Death_Sentence_UR, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Death_Sentence_UR, Condition( function Trig_Death_Sentence_UR_Conditions ) )
    call TriggerAddAction( gg_trg_Death_Sentence_UR, function Trig_Death_Sentence_UR_Actions )
endfunction

//===========================================================================
// Trigger: Charge Death Sentence WR
//===========================================================================
function Trig_Charge_Death_Sentence_WR_Func001C takes nothing returns boolean
    if ( not ( udg_i_Chain_Worgen <= udg_Chain_Terminator_Worgen ) ) then
        return false
    endif
    return true
endfunction

function Trig_Charge_Death_Sentence_WR_Actions takes nothing returns nothing
    if ( Trig_Charge_Death_Sentence_WR_Func001C() ) then
        set udg_Temp_Unit_Point = GetUnitLoc(udg_Chain_Units_Worgen[udg_i_Chain_Worgen])
        call RemoveUnit( udg_Chain_Units_Worgen[udg_i_Chain_Worgen] )
        if not IsTerrainPathable( GetLocationX(udg_Temp_Unit_Point), GetLocationY(udg_Temp_Unit_Point), PATHING_TYPE_WALKABILITY) then
        call SetUnitPositionLoc( udg_yA_Combat_Rogue, udg_Temp_Unit_Point )
        endif
        call RemoveLocation (udg_Temp_Unit_Point)
        set udg_i_Chain_Worgen = ( udg_i_Chain_Worgen + 1 )
    else
        call RemoveLocation (udg_Point_Charge_Begin[5])
        call RemoveLocation (udg_Point_Charge_End[5])
        call DestroyEffectBJ( udg_Charge_SE[5] )
        set udg_Temp_Unit = udg_yA_Combat_Rogue
        set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A0DS', udg_Temp_Unit) * 75 )
        set udg_HeroStatCalc = ( udg_HeroStatCalc + 50 )
        set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, false) ))
        set udg_RealStatCalc = ( 4.00 * udg_RealStatCalc )
        set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
        call UnitDamageTargetBJ( udg_Temp_Unit, udg_Chain_Target[0], udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        call DisableTrigger( GetTriggeringTrigger() )
    endif
endfunction

//===========================================================================
function InitTrig_Charge_Death_Sentence_WR takes nothing returns nothing
    set gg_trg_Charge_Death_Sentence_WR = CreateTrigger(  )
    call DisableTrigger( gg_trg_Charge_Death_Sentence_WR )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Charge_Death_Sentence_WR, 0.04 )
    call TriggerAddAction( gg_trg_Charge_Death_Sentence_WR, function Trig_Charge_Death_Sentence_WR_Actions )
endfunction

