// Trigger: Chaos Bolt
//===========================================================================
function Trig_Chaos_Bolt_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A094' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Chaos_Bolt_Func011C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'E04A' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Chaos_Bolt_Func024C takes nothing returns boolean
    if ( not ( GetRandomReal(0, 100.00) <= ( ( ( 10.00 + udg_Temp_Real ) + ( 3.00 * I2R(GetUnitAbilityLevelSwapped('A094', GetTriggerUnit())) ) ) + ( 0.50 * udg_RealStatCalc ) ) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Chaos_Bolt_Func040A takes nothing returns nothing
    if IsUnitTargetableEnemy( GetEnumUnit(), udg_Temp_Unit ) then
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_Chaos_Bolt_Actions takes nothing returns nothing
    local real dist = 0.25
    local unit target = GetSpellTargetUnit()
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
    set udg_Temp_Polar_Point = GetUnitLoc(GetSpellTargetUnit())
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A094', udg_Temp_Unit) * 60 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 20 )
    // Grimore of Sac (Human Players Only)
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 3 ]  then
    if ( Trig_Chaos_Bolt_Func011C() ) then
        set udg_o = udg_z_WL_DEST_A
    else
        set udg_o = udg_z_WL_DEST_H
    endif
    if udg_Eclipse[ udg_o] == 1 then
    set udg_Eclipse[udg_o] = 0
    set udg_HeroStatCalc = ( ( 6 * udg_HeroStatCalc ) / 5 )
    endif
    endif
    // End Grimore of Sac
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A094'), ABILITY_RLF_PRIMARY_DAMAGE, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_Temp_Unit) - 1 ), I2R(udg_HeroStatCalc) )
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 4 ]  then
    set udg_Temp_Real = 8.00
    else
    set udg_Temp_Real = 0.00
    endif
    if ( Trig_Chaos_Bolt_Func024C() ) then
        call CreateNUnitsAtLoc( 1, 'e030', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, GetUnitFacing(GetTriggerUnit()) )
        call SetUnitAbilityLevelSwapped( 'A095', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A094', GetTriggerUnit()) )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "acidbomb", GetSpellTargetUnit() )
        call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
    else
    endif
    set dist = 0.22 + DistanceBetweenPoints(udg_Temp_Unit_Point, udg_Temp_Polar_Point)/3000
    call RemoveLocation(udg_Temp_Unit_Point)
    call RemoveLocation(udg_Temp_Polar_Point)
    call TriggerSleepAction(dist)
    // Check if has immolate
    if ( UnitHasBuffBJ( target , 'B00U') ) then
    set udg_Temp_Unit = GetTriggerUnit()
    call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 1.50 * udg_RealStatCalc )
    set udg_RealStatCalc = ( ( 25.00 * I2R(GetUnitAbilityLevelSwapped('A099', GetTriggerUnit())) ) + udg_RealStatCalc )
    set udg_Temp_Unit_Point = GetUnitLoc( target )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Weapons\\DemolisherFireMissile\\DemolisherFireMissile.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(310.00, udg_Temp_Unit_Point), function Trig_Chaos_Bolt_Func040A )
    call RemoveLocation(udg_Temp_Unit_Point)
    endif
    set target = null
endfunction

//===========================================================================
function InitTrig_Chaos_Bolt takes nothing returns nothing
    set gg_trg_Chaos_Bolt = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Chaos_Bolt, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Chaos_Bolt, Condition( function Trig_Chaos_Bolt_Conditions ) )
    call TriggerAddAction( gg_trg_Chaos_Bolt, function Trig_Chaos_Bolt_Actions )
endfunction

//===========================================================================
// Trigger: Immolate
//===========================================================================
function Trig_Immolate_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A099' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Immolate_Func005C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'E04A' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Immolate_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 1.50 * udg_RealStatCalc )
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 3 ]  then
    if ( Trig_Immolate_Func005C() ) then
        set udg_o = udg_z_WL_DEST_A
    else
        set udg_o = udg_z_WL_DEST_H
    endif
    if udg_Eclipse[ udg_o] == 1 then
    set udg_RealStatCalc = ( 1.20 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A099', udg_Temp_Unit) * 5 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    set udg_Eclipse[udg_o] = 0
    endif
    endif
    call AddSpecialEffectTargetUnitBJ( "origin", GetSpellTargetUnit(), "Abilities\\Weapons\\DemolisherFireMissile\\DemolisherFireMissile.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call UnitDamageTargetBJ( udg_Temp_Unit, GetSpellTargetUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    call CreateNUnitsAtLoc( 1, 'e03E', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, GetUnitFacing(GetTriggerUnit()) )
    call RemoveLocation (udg_Temp_Unit_Point)
    call SetUnitAbilityLevelSwapped( 'A098', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A099', GetTriggerUnit()) )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "acidbomb", GetSpellTargetUnit() )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
endfunction

//===========================================================================
function InitTrig_Immolate takes nothing returns nothing
    set gg_trg_Immolate = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Immolate, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Immolate, Condition( function Trig_Immolate_Conditions ) )
    call TriggerAddAction( gg_trg_Immolate, function Trig_Immolate_Actions )
endfunction

