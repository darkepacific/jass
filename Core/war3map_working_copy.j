    if ( not ( GetDestructableTypeId(GetDyingDestructable()) == 'B02G' ) ) then
        return false
    endif
    return true
endfunction

function Trig_G_Party_Favors_Func004C takes nothing returns boolean
    if ( not ( IsQuestDiscovered(udg_Quests[110]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_G_Party_Favors_Actions takes nothing returns nothing
    local destructable d = GetDyingDestructable()
    local location udg_Temp_Unit_Point
    if ( Trig_G_Party_Favors_Func004C() ) then
        set udg_Temp_Unit_Point = GetDestructableLoc(GetDyingDestructable())
        call CreateItemLoc( 'I08P', udg_Temp_Unit_Point )
        call RemoveLocation (udg_Temp_Unit_Point)
    else
    endif
    call TriggerSleepAction( 60.00 )
    call DestructableRestoreLife( d, 20.00, false )
    set udg_Temp_Unit_Point = null
    set d = null
endfunction

