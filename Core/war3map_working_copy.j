function Trig_Kael_Leave_Func006Func006Func006C takes nothing returns boolean
    if ( not ( RectContainsUnit(gg_rct_Kael, GetTriggerUnit()) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Kael_Leave_Func006Func006C takes nothing returns boolean
    if ( not ( RectContainsUnit(gg_rct_Kael, GetTriggerUnit()) == false ) ) then
        return false
    endif
    return true
endfunction

