//===========================================================================
// Trigger: M Siege of Gilneas
//===========================================================================
function Trig_M_Siege_of_Gilneas_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 66
    local location udg_Temp_Unit_Point
    call DisableTrigger( GetTriggeringTrigger() )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_The_SiegeOfGilneas)
    call ReviveHeroLoc( gg_unit_H027_1820, udg_Temp_Unit_Point, true )
    call SetUnitPositionLocFacingBJ( gg_unit_H027_1820, udg_Temp_Unit_Point, 260.00 )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_TempString = ""
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    set udg_TempString = udg_ExclamationMark
    endif
    call AddSpecialEffectTargetUnitBJ( "overhead", gg_unit_H027_1820, udg_TempString )
    set udg_QuestMarks[66] = GetLastCreatedEffectBJ()
    set udg_TempString = "The Gilneans have resisted us for far too long. I trust you know what this means, head south and we will begin the Battle for Gilneas. When we have killed their leader we will take their city for our own. For the Forsaken! For our Banshee Queen!"
    // Set Quest Rewards
    set udg_QUEST_XP[udg_Temp_Int] = 800
    set udg_QUEST_GOLD[udg_Temp_Int] = 0
    set udg_QUEST_LVL_REQ[udg_Temp_Int] = udg_QUEST_ZONE_2_LVL_REQ
    call QuestRewards_TextSet(udg_Temp_Int)
    // End Set Quest Rewards
    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_9788", udg_TempString, "ReplaceableTextures\\CommandButtons\\BTNWorgen2.blp" )
    set udg_Quests[66] = GetLastCreatedQuestBJ()
    call QuestSetEnabledBJ( false, GetLastCreatedQuestBJ() )
    call EnableTrigger( gg_trg_S_SoG )
    set udg_Temp_Unit_Point = null
endfunction

//===========================================================================
function InitTrig_M_Siege_of_Gilneas takes nothing returns nothing
    set gg_trg_M_Siege_of_Gilneas = CreateTrigger(  )
    call TriggerAddAction( gg_trg_M_Siege_of_Gilneas, function Trig_M_Siege_of_Gilneas_Actions )
endfunction

//===========================================================================
// Trigger: Greymane Gate Dies
//===========================================================================
function Trig_Greymane_Gate_Dies_Func003Func005Func028C takes nothing returns boolean
    if ( not ( IsUnitInGroup(GetEnumUnit(), udg_KnockBacks) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Greymane_Gate_Dies_Func003Func005C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetEnumUnit()) == 'h00U' ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Greymane_Gate_Dies_Func003A takes nothing returns nothing
    local location udg_Temp_Unit_Point
    local location udg_Temp_Polar_Point
    local real udg_Temp_Real
    local real udg_RealStatCalc
    if ( Trig_Greymane_Gate_Dies_Func003Func005C() ) then
        // mvmnt
        set udg_Temp_Unit_Point = GetUnitLoc(GetEnumUnit())
        set udg_Temp_Polar_Point = GetRandomLocInRect(gg_rct_Gilneas_Wall_KnockBack)
        set udg_Temp_Real = AngleBetweenPoints(udg_Temp_Unit_Point, udg_Temp_Polar_Point)
        call RemoveLocation (udg_Temp_Polar_Point)
        set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 300.00, udg_Temp_Real)
        if not IsTerrainPathable( GetLocationX(udg_Temp_Polar_Point), GetLocationY(udg_Temp_Polar_Point), PATHING_TYPE_WALKABILITY) then
        call SetUnitPositionLoc( GetEnumUnit(), udg_Temp_Polar_Point )
        endif
        call RemoveLocation (udg_Temp_Unit_Point)
        call RemoveLocation (udg_Temp_Polar_Point)
        // KnockBackLoop Turn ON
        call UnitAddAbilityBJ( 'Amrf', GetEnumUnit() )
        call UnitRemoveAbilityBJ( 'Amrf', GetEnumUnit() )
        set udg_RealStatCalc = BlzGetLocalUnitZ(GetEnumUnit())
        if ( udg_RealStatCalc > 200.00 ) then
        set udg_RealStatCalc = BlzGetLocalUnitZ(GetEnumUnit())
        set udg_RealStatCalc = 232.00
        call SaveRealBJ( 2.00, 1, GetHandleIdBJ(GetEnumUnit()), udg_KnockBacksHash )
        call SaveRealBJ( 480.00, 2, GetHandleIdBJ(GetEnumUnit()), udg_KnockBacksHash )
        else
        set udg_RealStatCalc = 195.00
        call SaveRealBJ( 4.00, 1, GetHandleIdBJ(GetEnumUnit()), udg_KnockBacksHash )
        call SaveRealBJ( 280.00, 2, GetHandleIdBJ(GetEnumUnit()), udg_KnockBacksHash )
        endif
        call SetUnitFlyHeightBJ( GetEnumUnit(), udg_RealStatCalc, 0.00 )
        if ( Trig_Greymane_Gate_Dies_Func003Func005Func028C() ) then
            call GroupAddUnitSimple( GetEnumUnit(), udg_KnockBacks )
        else
            call FlushChildHashtableBJ( GetHandleIdBJ(GetEnumUnit()), GetLastCreatedHashtableBJ() )
        endif
        call SaveRealBJ( udg_Temp_Real, 0, GetHandleIdBJ(GetEnumUnit()), udg_KnockBacksHash )
        call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 1.00 )
    else
    endif
    set udg_Temp_Unit_Point = null
    set udg_Temp_Polar_Point = null
endfunction

function Trig_Greymane_Gate_Dies_Actions takes nothing returns nothing
    set udg_Temp_X_Point = GetRectCenter(gg_rct_Gilneas_Gate)
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(900.00, udg_Temp_X_Point), function Trig_Greymane_Gate_Dies_Func003A )
    call EnableTrigger( gg_trg_KnockBackLoop)
    call RemoveLocation (udg_Temp_X_Point)
    call DisableTrigger( gg_trg_Greymane_Gate_Dies)
endfunction

