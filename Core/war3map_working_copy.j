    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_4801", udg_TempString, "ReplaceableTextures\\CommandButtons\\BTNManaRecharge.blp" )
    set udg_Quests[35] = GetLastCreatedQuestBJ()
    call QuestSetEnabledBJ( false, GetLastCreatedQuestBJ() )
    call EnableTrigger( gg_trg_S_TWW )
endfunction

