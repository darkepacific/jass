//===========================================================================
// Trigger: Roll the Bones
//===========================================================================
function Trig_Roll_the_Bones_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0EZ' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Roll_the_Bones_Func006Func001Func001C takes nothing returns boolean
    if ( not ( GetSpellAbilityUnit() == udg_yA_Combat_Rogue ) ) then
        return false
    endif
    if ( not ( udg_WRComboPoints < 1.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Roll_the_Bones_Func006Func001Func002C takes nothing returns boolean
    if ( not ( GetSpellAbilityUnit() == udg_yH_Combat_Rogue ) ) then
        return false
    endif
    if ( not ( udg_URComboPoints < 1.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Roll_the_Bones_Func006Func001C takes nothing returns boolean
    if ( Trig_Roll_the_Bones_Func006Func001Func001C() ) then
        return true
    endif
    if ( Trig_Roll_the_Bones_Func006Func001Func002C() ) then
        return true
    endif
    return false
endfunction

function Trig_Roll_the_Bones_Func006C takes nothing returns boolean
    if ( not Trig_Roll_the_Bones_Func006Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Roll_the_Bones_Func023C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 6) > 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Roll_the_Bones_Func024C takes nothing returns boolean
    if ( not ( GetTriggerUnit() == udg_yA_Combat_Rogue ) ) then
        return false
    endif
    return true
endfunction

function Trig_Roll_the_Bones_Func066Func001C takes nothing returns boolean
    if ( not ( GetTriggerUnit() == udg_yH_Combat_Rogue ) ) then
        return false
    endif
    return true
endfunction

function Trig_Roll_the_Bones_Func066C takes nothing returns boolean
    if ( not ( GetTriggerUnit() == udg_yA_Combat_Rogue ) ) then
        return false
    endif
    return true
endfunction

function Trig_Roll_the_Bones_Actions takes nothing returns nothing
    local real ComboPoints
    local real udg_RealStatCalc //can remove this with a clean-up
    local integer Roll =  GetRandomInt( 1, 3)
    local unit udg_Temp_Unit
    local effect eff
    if ( Trig_Roll_the_Bones_Func006C() ) then
        call IssueImmediateOrderBJ( GetTriggerUnit(), "stop" )
        call ErrorMessage( "Not enough combo points.", GetOwningPlayer(GetTriggerUnit()) )
        call SetUnitManaBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) + I2R(BlzGetAbilityManaCost('A0EZ', ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ))) ) )
        set eff = null
        set udg_Temp_Unit = null
        return
    else
    endif
    set udg_Temp_Unit = GetTriggerUnit()
    if ( udg_Temp_Unit == udg_yA_Combat_Rogue ) then
    set udg_Temp_Int = 34
    elseif ( udg_Temp_Unit == udg_yH_Combat_Rogue ) then
    set udg_Temp_Int = 35
    endif
    // BOUNCE
    set udg_Point_Charge_Begin[udg_Temp_Int] = GetUnitLoc(udg_Temp_Unit)
    set udg_Point_Charge_End[udg_Temp_Int] = PolarProjectionBJ(udg_Point_Charge_Begin[udg_Temp_Int], 180.00, GetRandomDirectionDeg())
    call AddSpecialEffectLocBJ( udg_Point_Charge_Begin[udg_Temp_Int], "war3mapImported\\Dice Spheres10 (overhead).mdx" )
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), ( 180.00 + BlzGetLocalUnitZ(GetTriggerUnit()) ) )
    set udg_Charge_SE[udg_Temp_Int] = GetLastCreatedEffectBJ()
    set udg_SpellTicks[udg_Temp_Int] = 400
    call EnableTrigger( gg_trg_Roll_the_Bones_Fade)
    // ComboPoints
    if ( Trig_Roll_the_Bones_Func023C() ) then
        call PlaySoundOnUnitBJ( gg_snd_RollTheBones1, 81.00, GetSpellAbilityUnit() )
    else
        call PlaySoundOnUnitBJ( gg_snd_RollTheBones3, 81.00, GetSpellAbilityUnit() )
    endif
    if ( Trig_Roll_the_Bones_Func024C() ) then
        call DestroyEffectBJ( udg_WRComboEffects[0] )
        call DestroyEffectBJ( udg_WRComboEffects[1] )
        call DestroyEffectBJ( udg_WRComboEffects[2] )
        set udg_RealStatCalc = ( 0.00 + ( 10.00 * udg_WRComboPoints ) )
        set ComboPoints = udg_WRComboPoints
        set udg_WRComboPoints = 0.00
        call ResetComboPoints( GetTriggerUnit() )
    else
        call DestroyEffectBJ( udg_URComboEffects[0] )
        call DestroyEffectBJ( udg_URComboEffects[1] )
        call DestroyEffectBJ( udg_URComboEffects[2] )
        set udg_RealStatCalc = ( 0.00 + ( 10.00 * udg_URComboPoints ) )
        set ComboPoints = udg_URComboPoints
        set udg_URComboPoints = 0.00
        call ResetComboPoints( GetTriggerUnit() )
    endif
    call GameTimeWait(0.85)
    // Heal
    if Roll == 1 then
    call PlaySoundOnUnitBJ( gg_snd_Drinking_Potion, 100.00, udg_Temp_Unit )
    call AddSpecialEffectTargetUnitBJ( "chest", udg_Temp_Unit, "war3mapImported\\VampiricAuraTarget.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "war3mapImported\\Heal Orange.mdx" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.80 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "war3mapImported\\Singularity I Red.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set udg_RealStatCalc = ( ( udg_RealStatCalc * 15.00 ) / 1000.00 )
    //MANA
    call MaxManaRestore( udg_RealStatCalc, udg_Temp_Unit)
    //HP
    call ChaliceSet()
    call MaxHealthRestore( udg_RealStatCalc, udg_Temp_Unit)
    // CD
    elseif Roll == 2 then
    set udg_RealStatCalc = ( udg_RealStatCalc * 0.20 )
    call BlzStartUnitAbilityCooldown( udg_Temp_Unit, 'A0SD', RMaxBJ(( BlzGetUnitAbilityCooldownRemaining(udg_Temp_Unit, 'A0SD') - udg_RealStatCalc ), 0.01) )
    call BlzStartUnitAbilityCooldown( udg_Temp_Unit, 'A09V', RMaxBJ(( BlzGetUnitAbilityCooldownRemaining(udg_Temp_Unit, 'A09V') - udg_RealStatCalc ), 0.01) )
    call BlzStartUnitAbilityCooldown( udg_Temp_Unit, 'A0D6', RMaxBJ(( BlzGetUnitAbilityCooldownRemaining(udg_Temp_Unit, 'A0D6') - udg_RealStatCalc ), 0.01) )
    call BlzStartUnitAbilityCooldown( udg_Temp_Unit, 'A09J', RMaxBJ(( BlzGetUnitAbilityCooldownRemaining(udg_Temp_Unit, 'A09J') - udg_RealStatCalc ), 0.01) )
    call BlzStartUnitAbilityCooldown( udg_Temp_Unit, 'A017', RMaxBJ(( BlzGetUnitAbilityCooldownRemaining(udg_Temp_Unit, 'A017') - udg_RealStatCalc ), 0.01) )
    call BlzStartUnitAbilityCooldown( udg_Temp_Unit, 'A0DS', RMaxBJ(( BlzGetUnitAbilityCooldownRemaining(udg_Temp_Unit, 'A0DS') - udg_RealStatCalc ), 0.01) )
    call BlzStartUnitAbilityCooldown( udg_Temp_Unit, 'A02D', RMaxBJ(( BlzGetUnitAbilityCooldownRemaining(udg_Temp_Unit, 'A02D') - udg_RealStatCalc ), 0.01) )
    call BlzStartUnitAbilityCooldown( udg_Temp_Unit, 'A0EZ', RMaxBJ(( BlzGetUnitAbilityCooldownRemaining(udg_Temp_Unit, 'A0EZ') - udg_RealStatCalc ), 0.01) )
    call Speedbonus( udg_Temp_Unit, udg_RealStatCalc, udg_RealStatCalc )
    call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "Abilities\\Spells\\NightElf\\Blink\\BlinkTarget.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "war3mapImported\\Singularity I Green.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    endif
    // Ruthless
    if GetRandomReal( 0.0, 2.99) < ComboPoints then
    set udg_Temp_Unit = GetTriggerUnit()
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 10 ] then 
    call CreateTextTagUnitBJ( "TRIGSTR_9752", udg_Temp_Unit, 12.00, 9.00, 40.00, 100.00, 40.00, 0 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64, 90.00 )
    call cleanUpText(1.0, 0.5)
    if ( Trig_Roll_the_Bones_Func066C() ) then
        call ShowTextTagForceBJ( true, GetLastCreatedTextTag(), udg_AlliancePlayers )
        call TriggerExecute( gg_trg_WR_ComboGen )
    else
        if ( Trig_Roll_the_Bones_Func066Func001C() ) then
            call ShowTextTagForceBJ( true, GetLastCreatedTextTag(), udg_HordePlayers )
            call TriggerExecute( gg_trg_UR_ComboGen )
        else
        endif
    endif
    endif
    endif
    // Crit
    // is here because of wait
    if Roll == 3 then
    call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "war3mapImported\\DieByTheSword.mdx" )
    set eff = GetLastCreatedEffectBJ()
    call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "war3mapImported\\Singularity I Orange.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddAndHideSpell(udg_Temp_Unit, 'A0E8')
    call SetUnitAbilityLevel( udg_Temp_Unit, 'A0E8', R2I(ComboPoints + 1) )
    call UnitMakeAbilityPermanent(udg_Temp_Unit, true, 'A0E8')
    call GameTimeWait(3.6)
    call RemoveAndUnHideSpell(udg_Temp_Unit, 'A0E8')
    call DestroyEffectBJ( eff )
    endif
    set eff = null
    set udg_Temp_Unit = null
    // Skip
    return
    return
    call UnitAddAbilityBJ( 'A0E8', GetTriggerUnit() )
    call UnitRemoveAbilityBJ( 'A0E8', GetTriggerUnit() )
    call AddAndHideSpell(udg_Temp_Unit, 'A0E8')
    call RemoveAndUnHideSpell(udg_Temp_Unit, 'A0E8')
endfunction

//===========================================================================
function InitTrig_Roll_the_Bones takes nothing returns nothing
    set gg_trg_Roll_the_Bones = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Roll_the_Bones, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Roll_the_Bones, Condition( function Trig_Roll_the_Bones_Conditions ) )
    call TriggerAddAction( gg_trg_Roll_the_Bones, function Trig_Roll_the_Bones_Actions )
endfunction

//===========================================================================
// Trigger: Roll the Bones Fade
//
// Set Parabola = (((3.00 x Height) / MaxDistance) x ((MaxDistance - Distance) x (Distance / MaxDistance)))
// y =( Pow(bj_E, (-1* x) ) )*RAbsBJ(   * Cos(  3 * x))
//===========================================================================
function Trig_Roll_the_Bones_Fade_Func004Func016C takes nothing returns boolean
    if ( not ( udg_SpellTicks[34] <= 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Roll_the_Bones_Fade_Func004C takes nothing returns boolean
    if ( not ( udg_SpellTicks[udg_Temp_Int] > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Roll_the_Bones_Fade_Func006Func016C takes nothing returns boolean
    if ( not ( udg_SpellTicks[35] <= 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Roll_the_Bones_Fade_Func006C takes nothing returns boolean
    if ( not ( udg_SpellTicks[udg_Temp_Int] > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Roll_the_Bones_Fade_Func008C takes nothing returns boolean
    if ( not ( udg_SpellTicks[34] <= 0 ) ) then
        return false
    endif
    if ( not ( udg_SpellTicks[35] <= 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Roll_the_Bones_Fade_Actions takes nothing returns nothing
    // BOUNCE
    set udg_Temp_Int = 34
    if ( Trig_Roll_the_Bones_Fade_Func004C() ) then
        if udg_SpellTicks[udg_Temp_Int] > 384 then
        set udg_Temp_Angle = GetUnitFacing(udg_yA_Combat_Rogue)
        set udg_Temp_Angle = udg_Temp_Angle //+ GetRandomInt(0,360)
        else
        set udg_Temp_Angle = AngleBetweenPoints(udg_Point_Charge_Begin[udg_Temp_Int], udg_Point_Charge_End[udg_Temp_Int])
        set udg_Temp_Angle = udg_Temp_Angle + 1
        endif
        call RemoveLocation (udg_Point_Charge_End[udg_Temp_Int])
        set udg_Point_Charge_End[udg_Temp_Int] = PolarProjectionBJ(udg_Point_Charge_Begin[udg_Temp_Int], ( 400.00 - I2R(udg_SpellTicks[udg_Temp_Int]) ), udg_Temp_Angle)
        call BlzSetSpecialEffectPositionLoc( udg_Charge_SE[udg_Temp_Int], udg_Point_Charge_End[udg_Temp_Int] )
        set udg_Tau = I2R( 400 - udg_SpellTicks[udg_Temp_Int] )
        set udg_Temp_Real =  ( Pow(bj_E,( udg_Tau /-200) ) ) *RAbsBJ( 250  * Cos( udg_Tau / 51 ))
        call BlzSetSpecialEffectZ( udg_Charge_SE[udg_Temp_Int], ( udg_Temp_Real + BlzGetLocalUnitZ(udg_yA_Combat_Rogue) ) )
        call BlzSetSpecialEffectAlpha( udg_Charge_SE[udg_Temp_Int], R2I(( 255.00 * RMaxBJ(50.00, ( udg_Temp_Real / 250.00 )) )) )
        set udg_SpellTicks[udg_Temp_Int] = ( udg_SpellTicks[udg_Temp_Int] - 8 )
        if ( Trig_Roll_the_Bones_Fade_Func004Func016C() ) then
            call BlzSetSpecialEffectAlpha( udg_Charge_SE[udg_Temp_Int], 0 )
            call DestroyEffectBJ( udg_Charge_SE[udg_Temp_Int] )
            call RemoveLocation (udg_Point_Charge_Begin[udg_Temp_Int])
            call RemoveLocation (udg_Point_Charge_End[udg_Temp_Int])
        else
        endif
    else
    endif
    set udg_Temp_Int = 35
    if ( Trig_Roll_the_Bones_Fade_Func006C() ) then
        if udg_SpellTicks[udg_Temp_Int] > 384 then
        set udg_Temp_Angle = GetUnitFacing(udg_yH_Combat_Rogue)
        set udg_Temp_Angle = udg_Temp_Angle //+ GetRandomInt(0,360)
        else
        set udg_Temp_Angle = AngleBetweenPoints(udg_Point_Charge_Begin[udg_Temp_Int], udg_Point_Charge_End[udg_Temp_Int])
        set udg_Temp_Angle = udg_Temp_Angle + 1
        endif
        call RemoveLocation (udg_Point_Charge_End[udg_Temp_Int])
        set udg_Point_Charge_End[udg_Temp_Int] = PolarProjectionBJ(udg_Point_Charge_Begin[udg_Temp_Int], ( 400.00 - I2R(udg_SpellTicks[udg_Temp_Int]) ), udg_Temp_Angle)
        call BlzSetSpecialEffectPositionLoc( udg_Charge_SE[udg_Temp_Int], udg_Point_Charge_End[udg_Temp_Int] )
        set udg_Tau = I2R( 400 - udg_SpellTicks[udg_Temp_Int] )
        set udg_Temp_Real =  ( Pow(bj_E,( udg_Tau /-200) ) ) *RAbsBJ( 250  * Cos( udg_Tau / 51 ))
        call BlzSetSpecialEffectZ( udg_Charge_SE[udg_Temp_Int], ( udg_Temp_Real + BlzGetLocalUnitZ(udg_yH_Combat_Rogue) ) )
        call BlzSetSpecialEffectAlpha( udg_Charge_SE[udg_Temp_Int], R2I(( 255.00 * RMaxBJ(50.00, ( udg_Temp_Real / 250.00 )) )) )
        set udg_SpellTicks[udg_Temp_Int] = ( udg_SpellTicks[udg_Temp_Int] - 8 )
        if ( Trig_Roll_the_Bones_Fade_Func006Func016C() ) then
            call BlzSetSpecialEffectAlpha( udg_Charge_SE[udg_Temp_Int], 0 )
            call DestroyEffectBJ( udg_Charge_SE[udg_Temp_Int] )
            call RemoveLocation (udg_Point_Charge_Begin[udg_Temp_Int])
            call RemoveLocation (udg_Point_Charge_End[udg_Temp_Int])
        else
        endif
    else
    endif
    // Finish
    if ( Trig_Roll_the_Bones_Fade_Func008C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
    else
    endif
endfunction

