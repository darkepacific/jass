//===========================================================================
// Trigger: Entropius Darkness
//===========================================================================
globals
    location Point_Entropius_Darkness 
endglobals

function Trig_Entropius_Darkness_Conditions takes nothing returns boolean
    if (GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) < 8300.00 ) and GetUnitTypeId(GetTriggerUnit()) == 'H03X' then
	return true
    endif

    return false
endfunction

function Trig_Entropius_Darkness_Actions takes nothing returns nothing
    local effect disc
    //local location center
    local real angle
    local integer i

    if RectContainsUnit( gg_rct_Z_Sunwell_Plateau, GetEventDamageSource()) then
    	call DisableTrigger(GetTriggeringTrigger())

    	set Point_Entropius_Darkness = GetUnitLoc(GetEventDamageSource())



    	call DestroyEffectBJ(AddSpecialEffectLocBJ(Point_Entropius_Darkness, "war3mapImported\\Voidfall Major.mdx"))
   	 //call PlaySoundAtPointBJ( gg_snd_Pet_Narru_Clickable04, 100.00, Point_Entropius_Darkness, 500.00 )
 
   	call TriggerSleepAction(0.6)

    	call AddSpecialEffectLocBJ(Point_Entropius_Darkness, "war3mapImported\\Void Disc.mdx")
    	set disc = GetLastCreatedEffectBJ()
    	call BlzSetSpecialEffectHeight(disc, 0.00)
    	call BlzSetSpecialEffectScale(disc, 1.0)


    	call TriggerSleepAction(0.35)
    	call EnableTrigger(gg_trg_Entropius_Darkness_Tick)
    
    	call TriggerSleepAction(5.30)
    	call DestroyEffectBJ(disc)
    

    	call DisableTrigger(gg_trg_Entropius_Darkness_Tick)

    	call TriggerSleepAction(10.00)

    	call EnableTrigger(GetTriggeringTrigger())
    	call RemoveLocation( Point_Entropius_Darkness )
    endif

    set disc = null
endfunction


