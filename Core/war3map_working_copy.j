        call SetUnitFlyHeightBJ( udg_Temp_Unit, ( 150.00 * SinBJ(AcosBJ(( 1 - ( udg_Charge_Loop[37] / 8.00 ) ))) ), 0.00 )
        call BlzSetUnitFacingEx( udg_Temp_Unit, ( udg_DruidFacingAngle[4] + ( 24.00 * udg_Charge_Loop[37] ) ) )
