//===========================================================================
// Trigger: Azurelode Capture
//===========================================================================
function Trig_Azurelode_Capture_Func002Func010C takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_Quests[13]) == false ) ) then
        return false
    endif
    if ( not ( IsTriggerEnabled(gg_trg_S_Azurelode) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Azurelode_Capture_Func002Func045C takes nothing returns boolean
    if ( not ( IsTriggerEnabled(gg_trg_E_TaA) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Azurelode_Capture_Func002C takes nothing returns boolean
    if ( not ( GetOwningPlayer(gg_unit_h015_0631) == Player(1) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Azurelode_Capture_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    if ( Trig_Azurelode_Capture_Func002C() ) then
        if ( Trig_Azurelode_Capture_Func002Func045C() ) then
            call TriggerExecute( gg_trg_E_TaA )
        else
        endif
        call SetUnitOwner( gg_unit_h015_0631, Player(3), true )
        set udg_AzurelodeHorde[0] = 4.00
        set udg_AzurelodeHorde[1] = 1.00
        call TriggerSleepAction( 1.50 )
        call DisplayTimedTextToForce( GetPlayersAll(), 3.00, "TRIGSTR_1563" )
        call TriggerSleepAction( 1.50 )
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Azurelode_Matriarch)
        call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl" )
        call PlaySoundAtPointBJ( gg_snd_LightningBolt1, 100.00, udg_Temp_Unit_Point, 0 )
        call RemoveLocation (udg_Temp_Unit_Point)
        call TriggerSleepAction( 0.65 )
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Azurelode_Matriarch)
        call CreateNUnitsAtLoc( 1, 'e02G', Player(3), udg_Temp_Unit_Point, 219.17 )
        call PlaySoundAtPointBJ( gg_snd_BansheeReady1, 90.00, udg_Temp_Unit_Point, 20.00 )
        call RemoveLocation (udg_Temp_Unit_Point)
        set udg_BattleForHillsbrad[2] = GetLastCreatedUnit()
        call TriggerSleepAction( 0.50 )
        call IssueImmediateOrderBJ( udg_BattleForHillsbrad[2], "unravenform" )
        call TriggerSleepAction( 1.28 )
        set bj_forLoopAIndex = 1
        set bj_forLoopAIndexEnd = 3
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
