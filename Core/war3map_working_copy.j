//===========================================================================
// Trigger: Hearth Finish
//===========================================================================
function Trig_Hearth_Finish_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A02D' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hearth_Finish_Func022C takes nothing returns boolean
    if ( not ( IsPlayerInForce(udg_X_Player_MUI, udg_AlliancePlayers) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hearth_Finish_Actions takes nothing returns nothing
    call PlayerNumbtoHeroesNumb()
    set udg_X_Player_MUI = GetTriggerPlayer()
    call BlzSetSpecialEffectAlpha( udg_SpellChannels[udg_Player_Number], 0 )
    call DestroyEffectBJ( udg_SpellChannels[udg_Player_Number] )
    call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "Abilities\\Spells\\Human\\MassTeleport\\MassTeleportCaster.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_RealStatCalc = 90.00
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 3 ]  then
    if udg_Temp_Unit == udg_yA_Resto_Sham or udg_Temp_Unit == udg_yH_Resto_Sham then
    set udg_RealStatCalc = 45.00
    elseif udg_Temp_Unit == udg_yA_Enhance_Shaman or udg_Temp_Unit == udg_yH_Enhance_Shaman then
    set udg_RealStatCalc = 45.00
    elseif udg_Temp_Unit == udg_yA_Ele_Sham or udg_Temp_Unit == udg_yH_Ele_Sham then
    set udg_RealStatCalc = 45.00
    endif
    endif
    call BlzStartUnitAbilityCooldown( udg_Temp_Unit, GetSpellAbilityId(), udg_RealStatCalc )
    call SetUnitTimeScalePercent( udg_Temp_Unit, 100.00 )
    if ( Trig_Hearth_Finish_Func022C() ) then
            call TriggerExecute(gg_trg_Hearth_Alliance)
    else
            call TriggerExecute(gg_trg_Hearth_Horde)
    endif
    call RemoveLocation (udg_Temp_Unit_Point)
    call SetUnitLifeBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) + ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, GetTriggerUnit()) * udg_HEARTH_HEALTH ) ) )
    call SetUnitManaBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) + ( GetUnitStateSwap(UNIT_STATE_MAX_MANA, GetTriggerUnit()) * udg_HEARTH_HEALTH ) ) )
    return
    call SetCameraFieldForPlayer( udg_X_Player_MUI, CAMERA_FIELD_TARGET_DISTANCE, udg_Z_Camera[udg_Player_Number], 0 )
endfunction

//===========================================================================
function InitTrig_Hearth_Finish takes nothing returns nothing
    set gg_trg_Hearth_Finish = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Hearth_Finish, EVENT_PLAYER_UNIT_SPELL_FINISH )
    call TriggerAddCondition( gg_trg_Hearth_Finish, Condition( function Trig_Hearth_Finish_Conditions ) )
    call TriggerAddAction( gg_trg_Hearth_Finish, function Trig_Hearth_Finish_Actions )
endfunction

