function InitTrig_MAKE_WORGEN takes nothing returns nothing
    set gg_trg_MAKE_WORGEN = CreateTrigger(  )
    call DisableTrigger( gg_trg_MAKE_WORGEN )
    call TriggerRegisterPlayerChatEvent( gg_trg_MAKE_WORGEN, Player(2), "-mw", true )
    call TriggerRegisterPlayerChatEvent( gg_trg_MAKE_WORGEN, Player(4), "-mw", true )
