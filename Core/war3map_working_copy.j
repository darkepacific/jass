// Trigger: HW Salv End
//===========================================================================
function Trig_HW_Salv_End_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0FZ' ) ) then
        return false
    endif
    return true
endfunction

function Trig_HW_Salv_End_Actions takes nothing returns nothing
    local unit udg_Temp_Unit = GetTriggerUnit()
    if udg_Temp_Unit == udg_yA_Holy_Priest then
    call DestroyEffectBJ( udg_HWSalvA[0] )
    call DestroyEffectBJ( udg_HWSalvA[1] )
    call DestroyEffectBJ( udg_HWSalvA[2] )
    call DestroyEffectBJ( udg_HWSalvA[3] )
    call DestroyEffectBJ( udg_HWSalvA[4] )
    call DestroyEffectBJ( udg_HWSalvA[5] )
    call RemoveLocation (udg_Blizzard[34])
    call DisableTrigger( gg_trg_HW_Salv_Tick_A)
    elseif udg_Temp_Unit == udg_yH_Holy_Priest then
    call DestroyEffectBJ( udg_HWSalvH[0] )
    call DestroyEffectBJ( udg_HWSalvH[1] )
    call DestroyEffectBJ( udg_HWSalvH[2] )
    call DestroyEffectBJ( udg_HWSalvH[3] )
    call DestroyEffectBJ( udg_HWSalvH[4] )
    call DestroyEffectBJ( udg_HWSalvH[5] )
    call RemoveLocation (udg_Blizzard[35])
    call DisableTrigger( gg_trg_HW_Salv_Tick_H)
    else
    call DestroyEffectBJ( udg_HWSalvN[0] )
    call DestroyEffectBJ( udg_HWSalvN[1] )
    call DestroyEffectBJ( udg_HWSalvN[2] )
    call DestroyEffectBJ( udg_HWSalvN[3] )
    call DestroyEffectBJ( udg_HWSalvN[4] )
    call DestroyEffectBJ( udg_HWSalvN[5] )
    call RemoveLocation (udg_Blizzard[36])
    call DisableTrigger( gg_trg_HW_Salv_Tick_N)
    endif
    set udg_Temp_Unit = null
endfunction

//===========================================================================
function InitTrig_HW_Salv_End takes nothing returns nothing
    set gg_trg_HW_Salv_End = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_HW_Salv_End, EVENT_PLAYER_UNIT_SPELL_ENDCAST )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_HW_Salv_End, EVENT_PLAYER_UNIT_SPELL_FINISH )
    call TriggerAddCondition( gg_trg_HW_Salv_End, Condition( function Trig_HW_Salv_End_Conditions ) )
    call TriggerAddAction( gg_trg_HW_Salv_End, function Trig_HW_Salv_End_Actions )
endfunction

//===========================================================================
// Trigger: Divine Star
//
// Going to require a unit group
//===========================================================================
function Trig_Divine_Star_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0FU' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Divine_Star_Func023C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 2) > 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Divine_Star_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    if udg_Temp_Unit == udg_yA_Holy_Priest then
    set udg_Temp_Int = 39
    elseif udg_Temp_Unit == udg_yH_Holy_Priest then
    set udg_Temp_Int = 40
    endif
    set udg_Point_Charge_Begin[udg_Temp_Int] = GetUnitLoc(GetSpellAbilityUnit())
    set udg_Point_Charge_End[udg_Temp_Int] = GetSpellTargetLoc()
    set udg_Facing_Angle = AngleBetweenPoints(udg_Point_Charge_Begin[udg_Temp_Int], udg_Point_Charge_End[udg_Temp_Int])
    call RemoveLocation (udg_Point_Charge_End[udg_Temp_Int])
    set udg_Point_Charge_End[udg_Temp_Int] = PolarProjectionBJ(udg_Point_Charge_Begin[udg_Temp_Int], 650.00, udg_Facing_Angle)
    call AddSpecialEffectLocBJ( udg_Point_Charge_Begin[udg_Temp_Int], "war3mapImported\\HolyPhoenixMissle.mdx" )
    call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 3.00 )
    set udg_Charge_SE[udg_Temp_Int] = GetLastCreatedEffectBJ()
    call AddSpecialEffectLocBJ( udg_Point_Charge_Begin[udg_Temp_Int], "war3mapImported\\BladeBeamFinalLarger.mdx" )
    call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 0.80 )
    call BlzSetSpecialEffectScale( udg_Charge_SE[( udg_Temp_Int + 3 )], 1.25 )
    call BlzSetSpecialEffectColor( GetLastCreatedEffectBJ(), 155, 155, 255 )
    set udg_Charge_SE[( udg_Temp_Int + 3 )] = GetLastCreatedEffectBJ()
    call BlzSetSpecialEffectYaw( udg_Charge_SE[( udg_Temp_Int + 3 )], Deg2Rad(udg_Facing_Angle) )
    set udg_Charge_Loop[udg_Temp_Int] = 0.00
    // Play Sound
    if ( Trig_Divine_Star_Func023C() ) then
        call StopSoundBJ( gg_snd_DivineStar1, false )
        call PlaySoundAtPointBJ( gg_snd_DivineStar1, 100, udg_Point_Charge_Begin[udg_Temp_Int], 0 )
    else
        call StopSoundBJ( gg_snd_DivineStar2, false )
        call PlaySoundAtPointBJ( gg_snd_DivineStar2, 100, udg_Point_Charge_Begin[udg_Temp_Int], 0 )
    endif
    // Turn on Trigger
    if udg_Temp_Unit == udg_yA_Holy_Priest then
    call GroupClear( udg_DivineStar_A )
    call EnableTrigger( gg_trg_Divine_Star_Tick_A)
    elseif udg_Temp_Unit == udg_yH_Holy_Priest then
    call GroupClear( udg_DivineStar_H )
    call EnableTrigger( gg_trg_Divine_Star_Tick_H)
    endif
endfunction

//===========================================================================
function InitTrig_Divine_Star takes nothing returns nothing
    set gg_trg_Divine_Star = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Divine_Star, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Divine_Star, Condition( function Trig_Divine_Star_Conditions ) )
    call TriggerAddAction( gg_trg_Divine_Star, function Trig_Divine_Star_Actions )
endfunction

//===========================================================================
// Trigger: Divine Star Tick A
//===========================================================================
function Trig_Divine_Star_Tick_A_Func005Func010Func003C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(udg_Point_Charge_Begin[udg_Temp_Int], udg_Point_Charge_End[udg_Temp_Int]) < 11.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Divine_Star_Tick_A_Func005Func010C takes nothing returns boolean
    if ( not ( udg_Charge_Loop[udg_Temp_Int] > 32.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Divine_Star_Tick_A_Func005C takes nothing returns boolean
    if ( not ( udg_Charge_Loop[udg_Temp_Int] == 32.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Divine_Star_Tick_A_Func026A takes nothing returns nothing
    set udg_Temp_Unit = udg_yA_Holy_Priest
    if not (IsUnitInGroup(GetEnumUnit(), udg_DivineStar_A) )then
    // Enemies
    if IsUnitTargetableEnemy( GetEnumUnit(), udg_Temp_Unit ) then
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_Temp_Real, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "war3mapImported\\Radiance Royal.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    if udg_Temp_Bool then
    call IssueTargetOrderBJ( gg_unit_e00H_2048, "ensnare", GetEnumUnit() )
    endif
    call HasFirelords( GetEnumUnit() )
    // Allies
    elseif IsUnitTargetableAlly( GetEnumUnit(), udg_Temp_Unit ) then
    call SetUnitLifeBJ( GetEnumUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetEnumUnit()) + udg_RealStatCalc ) )
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "war3mapImported\\Radiance Holy.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    endif
    // All
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "Abilities\\Spells\\Other\\Transmute\\GoldBottleMissile.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "war3mapImported\\Radiance Silver.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call GroupAddUnitSimple( GetEnumUnit(), udg_DivineStar_A )
    endif
endfunction

function Trig_Divine_Star_Tick_A_Func028C takes nothing returns boolean
    if ( not ( udg_Charge_Loop[udg_Temp_Int] < 90.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Divine_Star_Tick_A_Actions takes nothing returns nothing
    set udg_Temp_Unit = udg_yA_Holy_Priest
    call TriggerExecute( gg_trg_Firelords_Helper)
    set udg_Temp_Int = 39
    // New Point & Special Effect
    if ( Trig_Divine_Star_Tick_A_Func005C() ) then
        call AddSpecialEffectLocBJ( udg_Point_Charge_End[udg_Temp_Int], "war3mapImported\\Valiant Charge Royal.mdx" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call AddSpecialEffectLocBJ( udg_Point_Charge_End[udg_Temp_Int], "war3mapImported\\TheHolyBomb.mdx" )
        call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 1.50 )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call AddSpecialEffectLocBJ( udg_Point_Charge_End[udg_Temp_Int], "war3mapImported\\HolyBlast.mdx" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call GroupClear( udg_DivineStar_A )
    else
        if ( Trig_Divine_Star_Tick_A_Func005Func010C() ) then
            call RemoveLocation (udg_Point_Charge_End[udg_Temp_Int])
            set udg_Point_Charge_End[udg_Temp_Int] = GetUnitLoc(udg_Temp_Unit)
            if ( Trig_Divine_Star_Tick_A_Func005Func010Func003C() ) then
                set udg_Charge_Loop[udg_Temp_Int] = 90.00
            else
            endif
        else
        endif
        set udg_Facing_Angle = AngleBetweenPoints(udg_Point_Charge_Begin[udg_Temp_Int], udg_Point_Charge_End[udg_Temp_Int])
        set udg_Temp_Unit_Point = PolarProjectionBJ(udg_Point_Charge_Begin[udg_Temp_Int], 20.00, udg_Facing_Angle)
        call RemoveLocation (udg_Point_Charge_Begin[udg_Temp_Int])
        set udg_Point_Charge_Begin[udg_Temp_Int] = udg_Temp_Unit_Point
        call BlzSetSpecialEffectPositionLoc( udg_Charge_SE[udg_Temp_Int], udg_Temp_Unit_Point)
        call BlzSetSpecialEffectZ( udg_Charge_SE[udg_Temp_Int], ( 16.00 + GetLocationZ(  udg_Temp_Unit_Point ) ) )
        call BlzSetSpecialEffectYaw( udg_Charge_SE[( udg_Temp_Int + 3 )], Deg2Rad(udg_Facing_Angle) )
        call BlzSetSpecialEffectPositionLoc( udg_Charge_SE[udg_Temp_Int + 3], udg_Temp_Unit_Point)
        call BlzSetSpecialEffectZ( udg_Charge_SE[udg_Temp_Int +3], ( 8.00 + GetLocationZ(  udg_Temp_Unit_Point ) ) )
    endif
    // Chastise Talent
    set udg_Temp_Bool = false
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 12 ]  then
    call DummyRootSet(  GetOwningPlayer(udg_Temp_Unit), udg_Point_Charge_Begin[udg_Temp_Int], udg_Facing_Angle, 2)
    set udg_Temp_Bool = true
    endif
    // Damage Calculation --- Temp_Real = Dmg,  RSC = Heal
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 2.50 * udg_RealStatCalc )
    // Damage
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A0FU', udg_Temp_Unit) * 50 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 30 )
    set udg_Temp_Real = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    // Healing
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A0FU', udg_Temp_Unit) * 50 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 30 )
    call ChaliceSet()
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    // AoE
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(190.00, udg_Point_Charge_Begin[udg_Temp_Int]), function Trig_Divine_Star_Tick_A_Func026A )
    // End
    if ( Trig_Divine_Star_Tick_A_Func028C() ) then
        set udg_Charge_Loop[udg_Temp_Int] = ( udg_Charge_Loop[udg_Temp_Int] + 1 )
    else
        call DisableTrigger( GetTriggeringTrigger() )
        call BlzSetSpecialEffectAlpha( udg_Charge_SE[udg_Temp_Int], 155 )
        call BlzSetSpecialEffectScale( udg_Charge_SE[udg_Temp_Int], 0.50 )
        call DestroyEffectBJ( udg_Charge_SE[udg_Temp_Int] )
        call DestroyEffectBJ( udg_Charge_SE[( udg_Temp_Int + 3 )] )
        call AddSpecialEffectLocBJ( udg_Point_Charge_Begin[udg_Temp_Int], "war3mapImported\\Valiant Charge Royal.mdx" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call AddSpecialEffectLocBJ( udg_Point_Charge_Begin[udg_Temp_Int], "war3mapImported\\HolyBlast.mdx" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call AddSpecialEffectLocBJ( udg_Point_Charge_Begin[udg_Temp_Int], "war3mapImported\\TheHolyBomb.mdx" )
        call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 1.00 )
        call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 1.00 )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call RemoveLocation (udg_Point_Charge_Begin[udg_Temp_Int])
        call RemoveLocation (udg_Point_Charge_End[udg_Temp_Int])
    endif
endfunction

//===========================================================================
function InitTrig_Divine_Star_Tick_A takes nothing returns nothing
    set gg_trg_Divine_Star_Tick_A = CreateTrigger(  )
    call DisableTrigger( gg_trg_Divine_Star_Tick_A )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Divine_Star_Tick_A, 0.02 )
    call TriggerAddAction( gg_trg_Divine_Star_Tick_A, function Trig_Divine_Star_Tick_A_Actions )
endfunction

