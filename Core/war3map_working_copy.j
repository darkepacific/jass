function Trig_Kill_on_Lvl_Up_Actions takes nothing returns nothing
    if ( Trig_Kill_on_Lvl_Up_Func002C() ) then
        set udg_o = udg_z_HU_BEAS_A
    else
        set udg_o = udg_z_HU_BEAS_H
    endif
