function Trig_Firelords_Burn_and_Arcanite_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() != 'ANss' ) ) then
        return false
    endif
    if ( not ( GetSpellAbilityId() != 'A02D' ) ) then
        return false
