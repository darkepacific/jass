function Trig_SU_ENTG_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    local integer udg_Temp_Int = 161
    if IsTriggerEnabled(gg_trg_E_ENTG) == false then
    set udg_TempString = "Entgression"
    set udg_TempString_Quest = "Kill 7 Ents or Dragonhawks"
    call TriggerExecute( gg_trg_Quest_Start_H )
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    call QuestSetEnabledBJ( true, udg_Quests[udg_Temp_Int] )
    call FlashQuestDialogButtonBJ(  )
    endif
    call QuestSetCompletedBJ( udg_Quests[udg_Temp_Int], false )
    call CreateQuestItemBJ( udg_Quests[udg_Temp_Int], "TRIGSTR_11381" )
    set udg_QuestReqs[udg_Temp_Int] = GetLastCreatedQuestItemBJ()
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Eversong_Ent_1)
    call CampaignMinimapIconLocBJ( udg_Temp_Unit_Point, bj_CAMPPINGSTYLE_CONTROL_NEUTRAL )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_MiniMapIcon[udg_Temp_Int] = GetLastCreatedMinimapIcon()
    call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), false )
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), true )
    endif
    call EnableTrigger( gg_trg_E_ENTG)
    else
    // FT Gen
    set udg_QuestENTG = udg_QuestENTG + 1.00
    call QuestItemSetDescriptionBJ( udg_QuestReqs[udg_Temp_Int], ( "Ents or Dragonhawks slain - " + ( I2S(R2I(udg_QuestENTG)) + "/7" ) ) )
    set udg_TempString = GetUnitName(GetTriggerUnit())
    call QuestUnitSlain( GetTriggerUnit())
    endif
    set udg_Temp_Unit_Point = null
endfunction

