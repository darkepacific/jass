//===========================================================================
function Trig_Banshees_Cast_Conditions takes nothing returns boolean
   return ( GetSpellAbilityId() == 'ANss' )
endfunction

function Trig_Banshees_Cast_Actions takes nothing returns nothing
    call DestroyEffectBJ( udg_Banshees[ GetPlayerNumber( GetOwningPlayer(GetTriggerUnit()) ) ] )
    call TriggerSleepAction( 25.00 )
    call HasBanshees( GetTriggerUnit() )
endfunction

//===========================================================================
