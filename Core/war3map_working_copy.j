function InitTrig_ABag_Check takes nothing returns nothing
    set gg_trg_ABag_Check = CreateTrigger(  )
    call TriggerAddAction( gg_trg_ABag_Check, function Trig_ABag_Check_Actions )
endfunction

//===========================================================================
// Trigger: ItemTurnIn
//
// Set temp unit = triger unit in item pick up, use that then to idenifty player force
//===========================================================================
function Trig_ItemTurnIn_Func002Func006C takes nothing returns boolean
    if ( not ( udg_FT_Z < 54.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_ItemTurnIn_Func002C takes nothing returns boolean
    if ( not ( StringLength(udg_TempString) > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_ItemTurnIn_Actions takes nothing returns nothing
    local unit udg_Temp_Unit = GetTriggerUnit()
    if ( Trig_ItemTurnIn_Func002C() ) then
        call CreateTextTagUnitBJ( ( "+1 " + udg_TempString ), udg_Temp_Unit, udg_FT_Z, 8.00, 85.00, 100.00, 0.00, 0 )
        call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
        call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
        call SetTextTagLifespanBJ( GetLastCreatedTextTag(), ( 1.40 - ( udg_FT_Z / 180.00 ) ) )
        call SetTextTagFadepointBJ( GetLastCreatedTextTag(), ( 1.00 - ( udg_FT_Z / 180.00 ) ) )
        if ( Trig_ItemTurnIn_Func002Func006C() ) then
            set udg_FT_Z = ( udg_FT_Z + 18.00 )
        else
            set udg_FT_Z = 0.00
        endif
    else
    endif
    set udg_Temp_Unit = null
endfunction

//===========================================================================
function InitTrig_ItemTurnIn takes nothing returns nothing
    set gg_trg_ItemTurnIn = CreateTrigger(  )
    call TriggerAddAction( gg_trg_ItemTurnIn, function Trig_ItemTurnIn_Actions )
endfunction

