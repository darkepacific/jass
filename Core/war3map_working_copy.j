//===========================================================================
// Trigger: M The Wildhammer Clan 139
//
// 
// Objectives:
//===========================================================================
function Trig_M_The_Wildhammer_Clan_139_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 139
    set udg_TempString = ""
    if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
    set udg_TempString = udg_ExclamationMark
    endif
    call AddSpecialEffectTargetUnitBJ( "overhead", gg_unit_n00N_2046, udg_TempString )
    set udg_QuestMarks[udg_Temp_Int] = GetLastCreatedEffectBJ()
    set udg_TempString = "Hero, the Alliance seeks the strength of the Wildhammer dwarves. Carry the Alliance Battle Standard to Thundermar, place it at the town’s center by the firepit, and defend it. Show our resolve, and they will surely stand with us."
    // Set Quest Rewards
    set udg_QUEST_XP[udg_Temp_Int] = 1000
    set udg_QUEST_GOLD[udg_Temp_Int] = 0
    set udg_QUEST_LVL_REQ[udg_Temp_Int] = udg_QUEST_ZONE_3_LVL_REQ
    call QuestRewards_TextSet(udg_Temp_Int)
    // End Set Quest Rewards
