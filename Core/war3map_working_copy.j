function Trig_Barrel_Roll_Turn_On_H_Actions takes nothing returns nothing
    if (GetTriggerUnit() == udg_yH_Brew_Monk) then
    call DisableTrigger( GetTriggeringTrigger() )
    call EnableTrigger( gg_trg_Barrel_Roll_KnockBack_H)
    call SetPlayerAbilityAvailableBJ( false, 'ANbf', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'ANdh', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'AOw2', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'A09F', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'A09H', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'A0E6', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'A0E7', GetOwningPlayer(GetTriggerUnit()) )
    call GameTimeWait(0.2)
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer( GetTriggerUnit() )) * udg_NUM_OF_TC + 11 ] then 
    call UnitAddAbilityBJ( 'ACm2', GetTriggerUnit() )
    call SetUnitVertexColorBJ( GetTriggerUnit(), 65.00, 65.00, 100.00, 0 )
    endif
    call HasBanshees( GetTriggerUnit() )
    call GameTimeWait(5.5)
    call SetUnitVertexColorBJ( GetTriggerUnit(), 100, 100, 100, 0 )
    call DisableTrigger( gg_trg_Barrel_Roll_KnockBack_H)
    call SetPlayerAbilityAvailableBJ( true, 'ANbf', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'ANdh', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'AOw2', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A09F', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A09H', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A0E6', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A0E7', GetOwningPlayer(GetTriggerUnit()) )
    call GameTimeWait(0.4)
    set udg_Temp_Unit = GetTriggerUnit()
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer( udg_Temp_Unit )) * udg_NUM_OF_TC + 10 ]  then
    call SetUnitMoveSpeed(udg_Temp_Unit, GetUnitDefaultMoveSpeed(udg_Temp_Unit) + 50.0)
    endif
    call HasBanshees( GetTriggerUnit() )
    call EnableTrigger( GetTriggeringTrigger() )
    endif
endfunction

