//===========================================================================
function Trig_M_Killing_Kilrogg_46_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 46
    set udg_TempString = ""
    if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
    set udg_TempString = udg_ExclamationMark
    endif
    call AddSpecialEffectTargetUnitBJ( "overhead", gg_unit_O011_2160, udg_TempString )
    set udg_QuestMarks[46] = GetLastCreatedEffectBJ()
    set udg_TempString = "A warband of Dragonmaw orcs has settled south of here and grows stronger with every new recruit their leader, Kilrogg Deadeye, brings in. They threaten our hold on Grim’Batol. Slay Kilrogg and bring me his other eye as proof."
    // Set Quest Rewards
    set udg_QUEST_XP[udg_Temp_Int] = 750
    set udg_QUEST_GOLD[udg_Temp_Int] = 200
    set udg_QUEST_LVL_REQ[udg_Temp_Int] = udg_QUEST_ZONE_3_LVL_REQ
    call QuestRewards_TextSet(udg_Temp_Int)
    // End Set Quest Rewards
    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_5088", udg_TempString, "ReplaceableTextures\\CommandButtons\\BTNHeroBlademaster.blp" )
    set udg_Quests[46] = GetLastCreatedQuestBJ()
    call QuestSetEnabledBJ( false, udg_Quests[46] )
    call EnableTrigger( gg_trg_S_KKG )
endfunction

