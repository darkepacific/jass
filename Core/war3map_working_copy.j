    call BlzEndUnitAbilityCooldown( GetTriggerUnit(), 'A0EU' )
    call BlzEndUnitAbilityCooldown( GetTriggerUnit(), 'A0EW' )
    call BlzEndUnitAbilityCooldown( GetTriggerUnit(), 'A0EX' )
    return
    call BlzStartUnitAbilityCooldown( GetTriggerUnit(), 'A02D', ( BlzGetUnitAbilityCooldownRemaining(GetTriggerUnit(), 'A02D') - 10.00 ) )
