            call BlzTriggerRegisterPlayerKeyEvent(trigHotkeys, Player(i), OSKEY_V, 0, true)
            call BlzTriggerRegisterPlayerKeyEvent(trigHotkeys, Player(i), OSKEY_W, 0, true)
