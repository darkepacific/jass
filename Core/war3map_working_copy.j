//===========================================================================
function Trig_M_The_Conquest_of_Pyrewood_128_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 128
    local location udg_Temp_Unit_Point
    set udg_TempString = ""
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    set udg_TempString = udg_ExclamationMark
    endif
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_The_SiegeOfGilneas)
    call SetUnitPositionLocFacingBJ( gg_unit_H027_1820, udg_Temp_Unit_Point, 260.00 )
    call RemoveLocation (udg_Temp_Unit_Point)
    call AddSpecialEffectTargetUnitBJ( "overhead", gg_unit_H027_1820, udg_TempString )
    set udg_QuestMarks[udg_Temp_Int] = GetLastCreatedEffectBJ()
    set udg_TempString = "We must seize Pyrewood Village. However, be warned — while the village may appear unassuming, unexpected defenses lurk within its shadows. Carry the Forsaken Crest into the village, plant it at its center, and be prepared to defend it."
    // Set Quest Rewards
    set udg_QUEST_XP[udg_Temp_Int] = 600
    set udg_QUEST_GOLD[udg_Temp_Int] = 100
    set udg_QUEST_LVL_REQ[udg_Temp_Int] = udg_QUEST_ZONE_2_LVL_REQ
    call QuestRewards_TextSet(udg_Temp_Int)
    // End Set Quest Rewards
    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_11429", udg_TempString, "ReplaceableTextures\\CommandButtons\\BTNOrcBattleStandard.blp" )
    set udg_Quests[udg_Temp_Int] = GetLastCreatedQuestBJ()
    call QuestSetEnabledBJ( false, GetLastCreatedQuestBJ() )
    call EnableTrigger(gg_trg_S_PYR)
    set udg_Temp_Unit_Point = null
endfunction

