    call TriggerAddCondition( gg_trg_Banshees_Cast, Condition( function Trig_Banshees_Cast_Conditions ) )
    call TriggerAddAction( gg_trg_Banshees_Cast, function Trig_Banshees_Cast_Actions )
endfunction


//===========================================================================
// Trigger: Firelords Helper
//
// Simple Loop to Set
// - Player_Number
// - hasFirelords
// - hasReaper
// - Temp_Unit
// Takes in a unit any unit as Temp Unit, returns Temp Unit as the Casting hero
// Since it sets tempUnit to hero
//===========================================================================
function Trig_Firelords_Helper_Func004Func001Func001Func002C takes nothing returns boolean
    if ( ( UnitHasItemOfTypeBJ(udg_Heroes[GetForLoopIndexA()], 'I07R') == true ) ) then
        return true
    endif
    if ( ( UnitHasItemOfTypeBJ(udg_Heroes[GetForLoopIndexA()], 'I085') == true ) ) then
        return true
    endif
    return false
endfunction

function Trig_Firelords_Helper_Func004Func001Func001C takes nothing returns boolean
    if ( not Trig_Firelords_Helper_Func004Func001Func001Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_Firelords_Helper_Func004Func001Func002C takes nothing returns boolean
    if ( not ( UnitHasItemOfTypeBJ(udg_Heroes[GetForLoopIndexA()], 'I086') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Firelords_Helper_Func004Func001C takes nothing returns boolean
    if ( not ( GetOwningPlayer(udg_Temp_Unit) == GetOwningPlayer(udg_Heroes[GetForLoopIndexA()]) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Firelords_Helper_Actions takes nothing returns nothing
    set udg_Player_Number = 99
    set udg_hasFirelords = false
    set udg_hasReaper = false
    set bj_forLoopAIndex = 0
    set bj_forLoopAIndexEnd = 7
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_Firelords_Helper_Func004Func001C() ) then
            if ( Trig_Firelords_Helper_Func004Func001Func001C() ) then
                set udg_hasFirelords = true
            else
            endif
            if ( Trig_Firelords_Helper_Func004Func001Func002C() ) then
                set udg_hasReaper = true
            else
            endif
            set udg_Player_Number = GetForLoopIndexA()
            exitwhen true
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    set udg_Temp_Unit = udg_Heroes[udg_Player_Number]
endfunction

//===========================================================================
function InitTrig_Firelords_Helper takes nothing returns nothing
    set gg_trg_Firelords_Helper = CreateTrigger(  )
    call TriggerAddAction( gg_trg_Firelords_Helper, function Trig_Firelords_Helper_Actions )
endfunction

