//===========================================================================
// Trigger: Muru Darkness
//===========================================================================
function Trig_Muru_Darkness_Conditions takes nothing returns boolean
    if (GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) < 10500.00 ) and GetUnitTypeId(GetTriggerUnit()) == 'H03W' then
	return true
    endif

    return false
endfunction

function Trig_Muru_Darkness_Actions takes nothing returns nothing
    local effect array disc
    local location center
    local location loc
    local real angle
    local integer i

    call DisableTrigger(GetTriggeringTrigger())
    set center = GetUnitLoc(GetTriggerUnit())
    call PlaySoundAtPointBJ( gg_snd_Pet_Narru_Clickable04, 100.00, center, 500.00 )
    call AddSpecialEffectLocBJ(center, "war3mapImported\\Void Disc.mdx")
    set disc[0] = GetLastCreatedEffectBJ()
    call BlzSetSpecialEffectHeight(disc[0], 0.00)
    call BlzSetSpecialEffectScale(disc[0], 3.0)


    // Create 8 more void discs at increments of 45 degrees
    set angle = 0.00
    set i = 1
    loop
        exitwhen angle >= 360.00
        set loc = PolarProjectionBJ(center, 250.00, angle)
        call AddSpecialEffectLocBJ(loc, "war3mapImported\\Void Disc.mdx")
        set disc[i] = GetLastCreatedEffectBJ()
        call BlzSetSpecialEffectHeight(disc[i], 0.00)
        call BlzSetSpecialEffectScale(disc[i], 1.00)
        call RemoveLocation(loc)
        set angle = angle + 45.00
        set i = i + 1
    endloop

    call RemoveLocation(center)
    call TriggerSleepAction(0.35)
    call EnableTrigger(gg_trg_Muru_Darkness_Tick)
    call TriggerSleepAction(5.00)
    
    set i = 0
    loop
        exitwhen i > 8
        call DestroyEffectBJ(disc[i])
        set i = i + 1
    endloop

    call DisableTrigger(gg_trg_Muru_Darkness_Tick)
    call TriggerSleepAction(10.30)
    call EnableTrigger(GetTriggeringTrigger())
    set center = null
    set loc = null
endfunction


