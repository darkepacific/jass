//===========================================================================
// Trigger: Ice Revenant Ice Spike
//===========================================================================
//===========================================================================
// ICE REVENANT - ICE SPIKE DROP
//
// Pure trigger-driven mechanic. No ability or order is used.
//
// Once the Ice Revenant is below 75% life, taking damage can start the spell.
// The trigger disables itself for 10 seconds after starting.
//
// Spikes can ONLY spawn inside:
//      gg_rct_Argent_Tournament_Raid
//
// Spike:
//      war3mapImported\IceSpikeFullWrap.mdx
//
// Impact:
//      war3mapImported\Blizzard II Missile.mdx
//
// Requires:
//      udg_Ice_Revenant
//      udg_IceSpikeData  (Hashtable)
//===========================================================================


//===========================================================================
// ADJUSTABLE SETTINGS
//===========================================================================

function Ice_Revenant_Ice_Spike_Damage takes nothing returns real
    return 700.00
endfunction

function Ice_Revenant_Ice_Spike_Radius takes nothing returns real
    return 120.00
endfunction

function Ice_Revenant_Ice_Spike_Count takes nothing returns integer
    return 24
endfunction

function Ice_Revenant_Ice_Spike_Interval takes nothing returns real
    return 0.22
endfunction

function Ice_Revenant_Ice_Spike_Height takes nothing returns real
    return 850.00
endfunction

function Ice_Revenant_Ice_Spike_Speed takes nothing returns real
    return 950.00
endfunction


//===========================================================================
// IMPACT
//===========================================================================

function Ice_Revenant_Ice_Spike_Impact takes unit caster, real x, real y returns nothing
    local group g = CreateGroup()
    local unit u
    local effect e

    set e = AddSpecialEffect("war3mapImported\\Blizzard II Missile.mdx", x, y)
    call DestroyEffect(e)

    call GroupEnumUnitsInRange(g, x, y, Ice_Revenant_Ice_Spike_Radius(), null)

    loop
        set u = FirstOfGroup(g)
        exitwhen u == null
        call GroupRemoveUnit(g, u)

        if GetWidgetLife(u) > 0.405 and IsUnitEnemy(u, GetOwningPlayer(caster)) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) then
            call UnitDamageTarget(caster, u, Ice_Revenant_Ice_Spike_Damage(), false, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
        endif
    endloop

    call DestroyGroup(g)

    set e = null
    set u = null
    set g = null
endfunction


//===========================================================================
// CHOOSE POSITION AND CREATE ONE SPIKE
//===========================================================================

function Ice_Revenant_Ice_Spike_Spawn takes timer t, integer index returns nothing
    local integer key = GetHandleId(t)
    local unit caster = LoadUnitHandle(udg_IceSpikeData, key, 0)
    local group g = CreateGroup()
    local unit u
    local unit target = null
    local integer count = 0
    local real x
    local real y
    local real groundZ
    local real startZ
    local real radius = Ice_Revenant_Ice_Spike_Radius()
    local location loc
    local effect spike

    // Find a random enemy hero who is CURRENTLY inside the raid arena.
    call GroupEnumUnitsInRect(g, gg_rct_Argent_Tournament_Raid, null)

    loop
        set u = FirstOfGroup(g)
        exitwhen u == null
        call GroupRemoveUnit(g, u)

        if GetWidgetLife(u) > 0.405 and IsUnitType(u, UNIT_TYPE_HERO) and IsUnitEnemy(u, GetOwningPlayer(caster)) and RectContainsCoords(gg_rct_Argent_Tournament_Raid, GetUnitX(u), GetUnitY(u)) then
            set count = count + 1

            if GetRandomInt(1, count) == 1 then
                set target = u
            endif
        endif
    endloop

    // Snapshot that hero's CURRENT position.
    if target != null then
        set x = GetUnitX(target)
        set y = GetUnitY(target)
    else
        // No valid hero found. Still keep the spike strictly inside the arena.
        set x = GetRandomReal(GetRectMinX(gg_rct_Argent_Tournament_Raid) + radius, GetRectMaxX(gg_rct_Argent_Tournament_Raid) - radius)
        set y = GetRandomReal(GetRectMinY(gg_rct_Argent_Tournament_Raid) + radius, GetRectMaxY(gg_rct_Argent_Tournament_Raid) - radius)
    endif

    // Extra safety: do not create anything outside the raid.
    if not RectContainsCoords(gg_rct_Argent_Tournament_Raid, x, y) then
        call DestroyGroup(g)
        set target = null
        set u = null
        set g = null
        set caster = null
        return
    endif

    set loc = Location(x, y)
    set groundZ = GetLocationZ(loc)
    call RemoveLocation(loc)

    set startZ = groundZ + Ice_Revenant_Ice_Spike_Height()

    set spike = AddSpecialEffect("war3mapImported\\IceSpikeFullWrap.mdx", x, y)

    // IceSpikeFullWrap points upward normally. Flip it downward.
    call BlzSetSpecialEffectPitch(spike, bj_PI)
    call BlzSetSpecialEffectPosition(spike, x, y, startZ)

    call SaveEffectHandle(udg_IceSpikeData, key, 1000 + index, spike)
    call SaveReal(udg_IceSpikeData, key, 2000 + index, x)
    call SaveReal(udg_IceSpikeData, key, 3000 + index, y)
    call SaveReal(udg_IceSpikeData, key, 4000 + index, startZ)
    call SaveReal(udg_IceSpikeData, key, 5000 + index, groundZ)
    call SaveBoolean(udg_IceSpikeData, key, 6000 + index, true)

    call DestroyGroup(g)

    set spike = null
    set loc = null
    set target = null
    set u = null
    set g = null
    set caster = null
endfunction


//===========================================================================
// PERIODIC
//===========================================================================

function Ice_Revenant_Ice_Spike_Periodic takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer key = GetHandleId(t)
    local unit caster = LoadUnitHandle(udg_IceSpikeData, key, 0)
    local integer spawned = LoadInteger(udg_IceSpikeData, key, 1)
    local integer total = LoadInteger(udg_IceSpikeData, key, 2)
    local integer i = 1
    local integer active = 0
    local real spawnClock = LoadReal(udg_IceSpikeData, key, 3)
    local real period = 0.03125
    local real z
    local real groundZ
    local real x
    local real y
    local effect spike

    // Spawn spikes one at a time.
    set spawnClock = spawnClock + period

    if spawned < total and spawnClock >= Ice_Revenant_Ice_Spike_Interval() then
        set spawnClock = spawnClock - Ice_Revenant_Ice_Spike_Interval()
        set spawned = spawned + 1
        call Ice_Revenant_Ice_Spike_Spawn(t, spawned)
        call SaveInteger(udg_IceSpikeData, key, 1, spawned)
    endif

    call SaveReal(udg_IceSpikeData, key, 3, spawnClock)

    // Move every active spike vertically downward.
    loop
        exitwhen i > spawned

        if LoadBoolean(udg_IceSpikeData, key, 6000 + i) then
            set spike = LoadEffectHandle(udg_IceSpikeData, key, 1000 + i)
            set x = LoadReal(udg_IceSpikeData, key, 2000 + i)
            set y = LoadReal(udg_IceSpikeData, key, 3000 + i)
            set z = LoadReal(udg_IceSpikeData, key, 4000 + i)
            set groundZ = LoadReal(udg_IceSpikeData, key, 5000 + i)

            set z = z - Ice_Revenant_Ice_Spike_Speed() * period

            if z <= groundZ then
                // No death animation on the spike model.
                call BlzSetSpecialEffectAlpha(spike, 0)
                call DestroyEffect(spike)
                call SaveBoolean(udg_IceSpikeData, key, 6000 + i, false)
                call Ice_Revenant_Ice_Spike_Impact(caster, x, y)
            else
                call SaveReal(udg_IceSpikeData, key, 4000 + i, z)
                call BlzSetSpecialEffectPosition(spike, x, y, z)
                set active = active + 1
            endif
        endif

        set i = i + 1
    endloop

    // Everything has spawned and landed.
    if spawned >= total and active == 0 then
        call FlushChildHashtable(udg_IceSpikeData, key)
        call PauseTimer(t)
        call DestroyTimer(t)
    endif

    set spike = null
    set caster = null
    set t = null
endfunction


//===========================================================================
// START SPELL
//===========================================================================

function Ice_Revenant_Ice_Spike_Start takes nothing returns nothing
    local timer t
    local integer key

    if udg_Ice_Revenant == null or GetWidgetLife(udg_Ice_Revenant) <= 0.405 then
        return
    endif

    if udg_IceSpikeData == null then
        set udg_IceSpikeData = InitHashtable()
    endif

    set t = CreateTimer()
    set key = GetHandleId(t)

    call SaveUnitHandle(udg_IceSpikeData, key, 0, udg_Ice_Revenant)
    call SaveInteger(udg_IceSpikeData, key, 1, 0)
    call SaveInteger(udg_IceSpikeData, key, 2, Ice_Revenant_Ice_Spike_Count())

    // Starts at interval so the first spike appears immediately.
    call SaveReal(udg_IceSpikeData, key, 3, Ice_Revenant_Ice_Spike_Interval())

    call TimerStart(t, 0.03125, true, function Ice_Revenant_Ice_Spike_Periodic)

    set t = null
endfunction


//===========================================================================
// DAMAGE TRIGGER
//===========================================================================

function Trig_Ice_Revenant_Ice_Spike_Conditions takes nothing returns boolean
    if GetTriggerUnit() != udg_Ice_Revenant then
        return false
    endif

    if GetUnitState(udg_Ice_Revenant, UNIT_STATE_LIFE) >= GetUnitState(udg_Ice_Revenant, UNIT_STATE_MAX_LIFE) * 0.75 then
        return false
    endif

    return true
endfunction

function Trig_Ice_Revenant_Ice_Spike_Actions takes nothing returns nothing
    local trigger t = GetTriggeringTrigger()

    call DisableTrigger(t)

    // No ability. No order. The mechanic simply begins.
    call Ice_Revenant_Ice_Spike_Start()

    call GameTimeWait(10.00)
    call EnableTrigger(t)

    set t = null
endfunction


