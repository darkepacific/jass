//===========================================================================
function Trig_Thrash_Effect_TA_Actions takes nothing returns nothing
    set udg_Temp_Unit = udg_yH_Feral_Druid
    if ( udg_Charge_Loop[12] < 15.00  ) then
        set udg_Charge_Loop[12] = ( udg_Charge_Loop[12] + 1 )
        call SetUnitFlyHeightBJ( udg_Temp_Unit, ( 150.00 * SinBJ(AcosBJ(( 1 - ( udg_Charge_Loop[12] / 8.00 ) ))) ), 0.00 )
        call BlzSetUnitFacingEx( udg_Temp_Unit, ( udg_DruidFacingAngle[1] + ( 24.00 * udg_Charge_Loop[12] ) ) )
    else
        call BlzSetUnitFacingEx( udg_Temp_Unit, udg_DruidFacingAngle[1] )
        call SetUnitFlyHeightBJ( udg_Temp_Unit, 0.00, 0.00 )
        //call UnitRemoveTypeBJ( UNIT_TYPE_MAGIC_IMMUNE, udg_Temp_Unit )
        call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "Abilities\\Spells\\Other\\Stampede\\StampedeMissile.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call DisableTrigger( GetTriggeringTrigger() )
    endif
