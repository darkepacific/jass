endfunction

//===========================================================================
// Trigger: Bladestorm Start
//===========================================================================
function Trig_Bladestorm_Start_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A02H' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Bladestorm_Start_Func007C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'H028' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Bladestorm_Start_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A02H', udg_Temp_Unit) * 100 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 25 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + 0.00 )
    call DragonRoarSet()
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A02H'), ABILITY_RLF_DAMAGE_PER_SECOND_OWW1, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), udg_RealStatCalc )
    if ( Trig_Bladestorm_Start_Func007C() ) then
        set udg_SpellTicks[1] = 1
        call EnableTrigger( gg_trg_Bladestorm_Tick_Or )
    else
        set udg_SpellTicks[2] = 1
        call EnableTrigger( gg_trg_Bladestorm_Tick_Hu )
    endif
endfunction

//===========================================================================
function InitTrig_Bladestorm_Start takes nothing returns nothing
    set gg_trg_Bladestorm_Start = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Bladestorm_Start, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Bladestorm_Start, Condition( function Trig_Bladestorm_Start_Conditions ) )
    call TriggerAddAction( gg_trg_Bladestorm_Start, function Trig_Bladestorm_Start_Actions )
endfunction

//===========================================================================
// Trigger: Bladestorm Tick Or
//===========================================================================
function Trig_Bladestorm_Tick_Or_Func017A takes nothing returns nothing
    if IsUnitTargetableEnemyHitsAll( GetEnumUnit(), udg_Temp_Unit ) then
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_HERO, DAMAGE_TYPE_ENHANCED )
    ////
    	if udg_Temp_Bool and ( GetUnitMoveSpeed(GetEnumUnit()) <= ( 0.95 * GetUnitDefaultMoveSpeed(GetEnumUnit())) or IsStunned(GetEnumUnit()) ) then
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), I2R(udg_HeroStatCalc), ATTACK_TYPE_HERO, DAMAGE_TYPE_ENHANCED )
    call AddSpecialEffectTargetUnitBJ( "overhead", GetEnumUnit(), "war3mapImported\\Ephemeral Cut Red.mdx" )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00) )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set udg_Temp_Int = 1
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "war3mapImported\\BloodExplosion.mdx" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.80 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    endif
    ////
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_Bladestorm_Tick_Or_Func023C takes nothing returns boolean
    if ( not ( udg_SpellTicks[1] == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Bladestorm_Tick_Or_Actions takes nothing returns nothing
    set udg_Temp_Unit = udg_yH_Arms_Warr
    call TriggerExecute( gg_trg_Firelords_Helper)
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 4.00 * udg_RealStatCalc )
    call DragonRoarSet()
    set udg_Temp_Bool = udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 12 ] 
    if udg_Temp_Bool then
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A02H', udg_Temp_Unit) * 80 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 20 )
    call DragonRoarSetInt()
    set udg_HeroStatCalc = ( udg_HeroStatCalc + R2I(udg_RealStatCalc) )
    set udg_HeroStatCalc = ( ( udg_HeroStatCalc * 3 ) / 10 )
    endif
    set udg_Temp_Int = 0
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(( 205.00 + ( 5.00 * I2R(GetUnitAbilityLevelSwapped('A02H', udg_Temp_Unit)) ) ), udg_Temp_Unit_Point), function Trig_Bladestorm_Tick_Or_Func017A )
    call RemoveLocation (udg_Temp_Unit_Point)
    if udg_Temp_Int > 0 then
    call StopSoundBJ( gg_snd_ArtilleryCorpseExplodeDeath101, false )
    call PlaySoundOnUnitBJ( gg_snd_ArtilleryCorpseExplodeDeath101, 100.00, udg_Temp_Unit )
    endif
    if ( Trig_Bladestorm_Tick_Or_Func023C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
    else
        set udg_SpellTicks[1] = ( udg_SpellTicks[1] + 1 )
    endif
endfunction

//===========================================================================
function InitTrig_Bladestorm_Tick_Or takes nothing returns nothing
    set gg_trg_Bladestorm_Tick_Or = CreateTrigger(  )
    call DisableTrigger( gg_trg_Bladestorm_Tick_Or )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Bladestorm_Tick_Or, 0.95 )
    call TriggerAddAction( gg_trg_Bladestorm_Tick_Or, function Trig_Bladestorm_Tick_Or_Actions )
endfunction

