//===========================================================================
function Trig_Dame_Auriferous_Dies_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'h03L' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dame_Auriferous_Dies_Func006C takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_Quests[107]) == false ) ) then
        return false
    endif
    if ( not ( IsTriggerEnabled(gg_trg_E_GMV) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dame_Auriferous_Dies_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    call TriggerSleepAction( 120.00 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Goldemist_Village_Quest)
    call CreateNUnitsAtLoc( 1, 'h03L', Player(3), udg_Temp_Unit_Point, 319.82 )
    call RemoveLocation (udg_Temp_Unit_Point)
    if ( Trig_Dame_Auriferous_Dies_Func006C() ) then
        call DestroyEffectBJ( udg_QuestMarks[107] )
        set udg_TempString = ""
        if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
        set udg_TempString = udg_ExclamationMark
        endif
        call AddSpecialEffectTargetUnitBJ( "overhead", GetLastCreatedUnit(), udg_TempString )
        set udg_QuestMarks[107] = GetLastCreatedEffectBJ()
    else
    endif
    set udg_Temp_Unit_Point = null
endfunction

