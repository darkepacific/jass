        call QuestUnitSlain( GetTriggerUnit())
        // End FT Gen
    endif
    call QuestItemSetDescriptionBJ( udg_QuestReqs[107], ( "Quel'dorei Wraiths Slain - " + ( I2S(R2I(udg_QuestGMVWraiths)) + ( "/4" + ( "|n- Crypt Fiends Slain - " + ( I2S(R2I(udg_QuestGMVCryptfiend)) + "/4" ) ) ) ) ) )
