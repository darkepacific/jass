//===========================================================================
// Trigger: I Blink
//===========================================================================
globals
    
	item array blinkingItems
	integer blinkingCount = 0

endglobals


function Trig_I_Blink_Timer_Actions takes nothing returns nothing
    local integer i = 0
    local item it
    local integer blinkingTotal = 0

    loop
        exitwhen i >= blinkingCount
        set it = blinkingItems[i]

        if it != null then
            if GetItemUserData(it) >= 0 then
                call SetItemVisible(it,true)
                set blinkingItems[i] = null
            else
                // if GetItemUserData(it) > -31 then
                //     call SetItemVisible(it, not IsItemVisible(it))
                //     call SetItemUserData(it, GetItemUserData(it) - 0.5)
                // endif
		        //call Debug("Blink triggered: " + I2S(i))


                // If it reaches end remove the item from the map
                if GetItemUserData(it) > -37 then
                    if ModuloInteger(GetItemUserData(it), 2) == 0 then
                        call SetItemVisible(it, not IsItemVisible(it))
                    endif
                    call SetItemUserData(it, GetItemUserData(it) - 1)
                else
                    if GetItemUserData(it) > -67 then
                        call SetItemVisible(it, not IsItemVisible(it))
                        call SetItemUserData(it, GetItemUserData(it) - 1)
                    else
                        call RemoveItem(it)
                        set blinkingItems[i] = null
                    endif
                endif
            endif
        else
            set blinkingTotal = blinkingTotal + 1
            if blinkingTotal >= blinkingCount then
                set blinkingCount = 0
                call DisableTrigger(gg_trg_I_Blink)
                call Debug("I Blink Disabled")
            endif
        endif
        
        set i = i + 1
    endloop
    
    set it = null
endfunction

//===========================================================================
// Initialization
function InitTrig_I_Blink takes nothing returns nothing
    set gg_trg_I_Blink = CreateTrigger()
    call TriggerRegisterTimerEventPeriodic(gg_trg_I_Blink, 0.17) // Blinking every second
    call TriggerAddAction(gg_trg_I_Blink, function Trig_I_Blink_Timer_Actions)
endfunction
//===========================================================================
// Trigger: I Clean
//
// Very basic Item clean
//===========================================================================
function Trig_I_Clean_Func001Func001Func001C takes nothing returns boolean
    if ( not ( GetItemUserData(GetEnumItem()) == -1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_I_Clean_Func001Func001C takes nothing returns boolean
    if ( not ( GetItemUserData(GetEnumItem()) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_I_Clean_Func001A takes nothing returns nothing
    if ( Trig_I_Clean_Func001Func001C() ) then
        call SetItemUserData( GetEnumItem(), -1 )
    else
        if ( Trig_I_Clean_Func001Func001Func001C() ) then
            set blinkingItems[blinkingCount] = GetEnumItem()
            set blinkingCount = blinkingCount + 1
            call EnableTrigger(gg_trg_I_Blink)
        else
        endif
    endif
endfunction

function Trig_I_Clean_Actions takes nothing returns nothing
    call EnumItemsInRectBJ( GetPlayableMapRect(), function Trig_I_Clean_Func001A )
endfunction

//===========================================================================
function InitTrig_I_Clean takes nothing returns nothing
    set gg_trg_I_Clean = CreateTrigger(  )
    call TriggerRegisterTimerEventPeriodic( gg_trg_I_Clean, 45.00 )
    call TriggerAddAction( gg_trg_I_Clean, function Trig_I_Clean_Actions )
endfunction

//===========================================================================
// Trigger: KilJaeden Meteor Item 0
//
// 
//===========================================================================
function Trig_KilJaeden_Meteor_Item_0_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0GO' ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetTriggerUnit()) == Player(5) ) ) then
        return false
    endif
    return true
endfunction

function Trig_KilJaeden_Meteor_Item_0_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 55
    local effect indicator
    set udg_Point_Charge_End[udg_Temp_Int] = GetSpellTargetLoc()
    set udg_Point_Charge_Begin[udg_Temp_Int] = PolarProjectionBJ(udg_Point_Charge_End[udg_Temp_Int], 150.00, GetRandomDirectionDeg())
    set indicator = AddSpecialEffectLoc("war3mapImported\\FelMeteorIndicator.mdx", udg_Point_Charge_End[udg_Temp_Int])
        call BlzPlaySpecialEffect( indicator, ANIM_TYPE_STAND )
        call BlzSpecialEffectAddSubAnimation( indicator, SUBANIM_TYPE_LARGE )
        call BlzSetSpecialEffectScale( indicator, 2.2 )
    call AddSpecialEffectLocBJ( udg_Point_Charge_Begin[udg_Temp_Int], "war3mapImported\\FelMeteor.mdx" )
    set udg_Charge_SE[udg_Temp_Int] = GetLastCreatedEffectBJ()
    call BlzSetSpecialEffectZ( udg_Charge_SE[udg_Temp_Int], 1000.00 )
    set udg_Charge_Loop[udg_Temp_Int] = 1.00
    call EnableTrigger(gg_trg_KilJaeden_Meteor_Fall_Tick_Item_0)
    set udg_MeteorCaster[0] = GetTriggerUnit()
    call TriggerSleepAction( 3.00 )
    call DestroyEffect( indicator)
    set indicator = null
endfunction

//===========================================================================
function InitTrig_KilJaeden_Meteor_Item_0 takes nothing returns nothing
    set gg_trg_KilJaeden_Meteor_Item_0 = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_KilJaeden_Meteor_Item_0, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_KilJaeden_Meteor_Item_0, Condition( function Trig_KilJaeden_Meteor_Item_0_Conditions ) )
    call TriggerAddAction( gg_trg_KilJaeden_Meteor_Item_0, function Trig_KilJaeden_Meteor_Item_0_Actions )
endfunction

//===========================================================================
// Trigger: KilJaeden Meteor Fall Tick Item 0
//===========================================================================
function Trig_KilJaeden_Meteor_Fall_Tick_Item_0_Func012A takes nothing returns nothing
    local unit udg_Temp_Unit = udg_MeteorCaster[0]
    if IsUnitTargetableEnemyHitsAll( GetEnumUnit(), udg_Temp_Unit ) then
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "war3mapImported\\FelFirePillarMediumNew.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), 2500.00, ATTACK_TYPE_HERO, DAMAGE_TYPE_MAGIC )
    endif
    set udg_Temp_Unit = null
endfunction

function Trig_KilJaeden_Meteor_Fall_Tick_Item_0_Actions takes nothing returns nothing
    set udg_Temp_Int = 55
    set udg_Temp_Angle = AngleBetweenPoints(udg_Point_Charge_End[udg_Temp_Int], udg_Point_Charge_Begin[udg_Temp_Int])
    call RemoveLocation (udg_Point_Charge_Begin[udg_Temp_Int])
    set udg_Point_Charge_Begin[udg_Temp_Int] = PolarProjectionBJ(udg_Point_Charge_End[udg_Temp_Int], ( 150.00 - udg_Charge_Loop[udg_Temp_Int] ), udg_Temp_Angle)
    call BlzSetSpecialEffectPositionLoc( udg_Charge_SE[udg_Temp_Int], udg_Point_Charge_Begin[udg_Temp_Int] )
    call BlzSetSpecialEffectZ( udg_Charge_SE[udg_Temp_Int], ( 1000.00 - ( 5.00 * udg_Charge_Loop[udg_Temp_Int] ) ) )
    if (udg_Charge_Loop[udg_Temp_Int] < 150) then
    set udg_Charge_Loop[udg_Temp_Int] = ( udg_Charge_Loop[udg_Temp_Int] + 1 )
    else
    call DestroyEffectBJ( udg_Charge_SE[udg_Temp_Int] )
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(250.00, udg_Point_Charge_End[udg_Temp_Int]), function Trig_KilJaeden_Meteor_Fall_Tick_Item_0_Func012A )
    call RemoveLocation (udg_Point_Charge_Begin[udg_Temp_Int])
    call RemoveLocation (udg_Point_Charge_End[udg_Temp_Int])
    call DisableTrigger( GetTriggeringTrigger() )
    endif
endfunction

//===========================================================================
function InitTrig_KilJaeden_Meteor_Fall_Tick_Item_0 takes nothing returns nothing
    set gg_trg_KilJaeden_Meteor_Fall_Tick_Item_0 = CreateTrigger(  )
    call DisableTrigger( gg_trg_KilJaeden_Meteor_Fall_Tick_Item_0 )
    call TriggerRegisterTimerEventPeriodic( gg_trg_KilJaeden_Meteor_Fall_Tick_Item_0, 0.02 )
    call TriggerAddAction( gg_trg_KilJaeden_Meteor_Fall_Tick_Item_0, function Trig_KilJaeden_Meteor_Fall_Tick_Item_0_Actions )
endfunction

