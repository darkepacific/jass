    call TriggerRegisterPlayerChatEvent( gg_trg_UP, Player(12), "-up", false )
    call TriggerRegisterPlayerChatEvent( gg_trg_UP, Player(13), "-up", false )
    call TriggerAddAction( gg_trg_UP, function Trig_UP_Actions )
endfunction

