    call EnableTrigger( gg_trg_E_KnC )
    call EnableTrigger( gg_trg_U_KnC_Acq )
    // Create Treasure
    call TriggerSleepAction( 2.00 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Kobolds_and_Catacombs_Treasure)
    call PingMinimapLocForForce( udg_AlliancePlayers, udg_Temp_Unit_Point, 2.00 )
