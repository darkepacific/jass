        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0FA' ) ) then
        return true
    endif
    return false
endfunction

function Trig_AoE_Fear_Func008Func001C takes nothing returns boolean
    if ( not Trig_AoE_Fear_Func008Func001Func004C() ) then
