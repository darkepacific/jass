function Trig_M_Rescue_Voss_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 104
    local location udg_Temp_Unit_Point
    set udg_TempString = ""
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    set udg_TempString = udg_ExclamationMark
    endif
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Start_Voss)
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, udg_TempString )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), Deg2Rad(90.00), 0.00, 0.0 )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 1.10 )
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), 210.00 )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_QuestMarks[104] = GetLastCreatedEffectBJ()
    set udg_TempString = "Nooo.. noo! I can't be undead.  <Find a way to convince Lillian that she is in fact dead.> "
    // Set Quest Rewards
    set udg_QUEST_XP[udg_Temp_Int] = 250
    set udg_QUEST_GOLD[udg_Temp_Int] = 0
    call QuestRewards_TextSet(udg_Temp_Int)
    // End Set Quest Rewards
    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_9099", udg_TempString, "ReplaceableTextures\\CommandButtons\\BTNDeathKnightVoss.blp" )
    set udg_Quests[104] = GetLastCreatedQuestBJ()
    call QuestSetEnabledBJ( false, GetLastCreatedQuestBJ() )
    call EnableTrigger( gg_trg_C_RV )
    call EnableTrigger( gg_trg_S_RV)
    set udg_Temp_Unit_Point = null
endfunction

