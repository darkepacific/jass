function Trig_TELE_Actions takes nothing returns nothing
    local boolean all = false
    local location udg_Temp_Unit_Point
    set udg_TempString = SubStringBJ(GetEventPlayerChatString(), 4, 4)
    call PlayerNumbtoHeroesNumb()
    if ( Trig_TELE_Func005C() ) then
        set udg_TempString = SubStringBJ(GetEventPlayerChatString(), 5, 6)
        set all = true
    else
        set udg_TempString = SubStringBJ(GetEventPlayerChatString(), 4, 5)
    endif
    if ( Trig_TELE_Func006C() ) then
        //Island
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_TP_Island)
    else
        if ( Trig_TELE_Func006Func004C() ) then
            set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Z_Broken_Isles_Dark_Portal)
        else
            if ( Trig_TELE_Func006Func004Func002C() ) then
                //Cave
                set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Weeping_Cave_Mine_Entrance)
            else
                if ( Trig_TELE_Func006Func004Func002Func001C() ) then
                    //Kara
                    set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_Moonlight_Kara)
                else
                    if ( Trig_TELE_Func006Func004Func002Func001Func001C() ) then
                        //Naxx
                        set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_Naxx_Int)
                    else
                        if ( Trig_TELE_Func006Func004Func002Func001Func001Func001C() ) then
                            //Sunwell
                            set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_Sunwell_Plateau_Portal)
                        else
                            if ( Trig_TELE_Func006Func004Func002Func001Func001Func001Func004C() ) then
                                //TolBarad
                                set udg_Temp_Unit_Point = GetRectCenter(gg_rct_TB_Infernals)
                            else
                                if ( Trig_TELE_Func006Func004Func002Func001Func001Func001Func004Func001C() ) then
                                    //Ghostlands
                                    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Amani_North_Ext)
                                else
                                    if ( Trig_TELE_Func006Func004Func002Func001Func001Func001Func004Func001Func001C() ) then
                                        //twilight highlands
                                        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_GY_GrimBatol)
                                    else
                                        if ( Trig_TELE_Func006Func004Func002Func001Func001Func001Func004Func001Func001Func001C() ) then
                                            //twilight highlands
                                            set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Hinterland_Beavecoons)
                                        else
                                            if ( Trig_TELE_Func006Func004Func002Func001Func001Func001Func004Func001Func001Func001Func001C() ) then
                                                //stromgarde
                                                set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Hearth_Stromgarde_100)
                                            else
                                                if ( Trig_TELE_Func006Func004Func002Func001Func001Func001Func004Func001Func001Func001Func001Func001C() ) then
                                                    //ironforce
                                                    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Hearth_Ironforge_200)
                                                else
                                                    if ( Trig_TELE_Func006Func004Func002Func001Func001Func001Func004Func001Func001Func001Func001Func001Func001C() ) then
                                                        //undercity
                                                        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Hearth_Undercity_100)
                                                    else
                                                        if ( Trig_TELE_Func006Func004Func002Func001Func001Func001Func004Func001Func001Func001Func001Func001Func001Func001C() ) then
                                                            //silvermoon
                                                            set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Hearth_Silvermoon_200)
                                                        else
                                                            if ( Trig_TELE_Func006Func004Func002Func001Func001Func001Func004Func001Func001Func001Func001Func001Func001Func001Func001C() ) then
                                                                //gilneas
                                                                set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Hearth_Gilneas_15)
                                                            else
                                                                if ( Trig_TELE_Func006Func004Func002Func001Func001Func001Func004Func001Func001Func001Func001Func001Func001Func001Func001Func001C() ) then
                                                                    //lichking
                                                                    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Arthas_South)
                                                                else
                                                                    if ( Trig_TELE_Func006Func004Func002Func001Func001Func001Func004Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001C() ) then
                                                                        //Stormheim
                                                                        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_GY_Stormheim)
                                                                    else
                                                                        if ( Trig_TELE_Func006Func004Func002Func001Func001Func001Func004Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001C() ) then
                                                                            //Scarlet Onslaught
                                                                            set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Q_The_Scarlet_Onslaught)
                                                                        else
                                                                            if ( Trig_TELE_Func006Func004Func002Func001Func001Func001Func004Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001C() ) then
                                                                                //strath
                                                                                set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Stratholme_Int)
                                                                            else
                                                                                if ( Trig_TELE_Func006Func004Func002Func001Func001Func001Func004Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001C() ) then
                                                                                    //Greenwardens Grove
                                                                                    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Hearth_Greenwardens_Grove_0)
                                                                                else
                                                                                    if ( Trig_TELE_Func006Func004Func002Func001Func001Func001Func004Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001C() ) then
                                                                                        //Scholomance
                                                                                        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Scholomance_Visitors_Cinematic)
                                                                                    else
                                                                                        if ( Trig_TELE_Func006Func004Func002Func001Func001Func001Func004Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001C() ) then
                                                                                            //Western Plaguelands
                                                                                            set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Z_MoonWell_WP)
                                                                                        else
                                                                                            //Dalaran
                                                                                            set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Hearth_Dalaran_14)
                                                                                        endif
                                                                                    endif
                                                                                endif
                                                                            endif
                                                                        endif
                                                                    endif
                                                                endif
                                                            endif
                                                        endif
                                                    endif
                                                endif
                                            endif
                                        endif
                                    endif
                                endif
                            endif
                        endif
                    endif
                endif
            endif
        endif
    endif
    if all then
    set bj_forLoopAIndex = 0
    set bj_forLoopAIndexEnd = 7
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetUnitPositionLoc( udg_Heroes[GetForLoopIndexA()], udg_Temp_Unit_Point )
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    else
    call SetUnitPositionLoc( udg_Heroes[udg_Player_Number], udg_Temp_Unit_Point )
    endif
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = null
endfunction

