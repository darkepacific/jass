    if ( not ( IsUnitInGroup(GetTriggerUnit(), udg_MakgoraA) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Makgora_Dies_Actions takes nothing returns nothing
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    call StopSoundBJ( gg_snd_CrowdCheer5s, false )
    call PlaySoundAtPointBJ( gg_snd_CrowdCheer5s, 100, udg_Temp_Unit_Point, 50.00 )
    call RemoveLocation (udg_Temp_Unit_Point)
    call BloodlustMakgora ( GetKillingUnitBJ() )
    call IssueTargetOrderBJ( gg_unit_e028_1863, "bloodlust", GetKillingUnitBJ() )
    if ( Trig_Makgora_Dies_Func007C() ) then
        call ForGroupBJ( udg_MakgoraA, function Trig_Makgora_Dies_Func007Func001A )
    else
        call ForGroupBJ( udg_MakgoraH, function Trig_Makgora_Dies_Func007Func002A )
    endif
endfunction

