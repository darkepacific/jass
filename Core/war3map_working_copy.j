//===========================================================================
// Trigger: L TFC
//===========================================================================
function Trig_L_TFC_Func008Func001C takes nothing returns boolean
    if ( not ( GetItemTypeId(udg_P_Items[( udg_Bag_Num + udg_Bag_Iterator )]) == udg_ItemTypeCheck ) ) then
        return false
    endif
    return true
endfunction

function Trig_L_TFC_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    local integer udg_Temp_Int = 124
    local boolean hasItem
                       if IsHordeHero( GetTriggerUnit() ) then
    set hasItem = false
    call SetBagNumber( GetOwningPlayer(GetTriggerUnit()) )
    set udg_ItemTypeCheck = 'I094'
    set udg_Bag_Iterator = 1
    loop
        exitwhen udg_Bag_Iterator > udg_BAG_LOOP_MAX
        if ( Trig_L_TFC_Func008Func001C() ) then
            set hasItem = true
        else
        endif
        set udg_Bag_Iterator = udg_Bag_Iterator + 1
    endloop
    if hasItem == false then
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_S_The_Fallen_Courier)
    call CreateTextTagLocBJ( "TRIGSTR_10910", udg_Temp_Unit_Point, 90.00, 10, 100, 90.00, 45.00, 0 )
    call RemoveLocation (udg_Temp_Unit_Point)
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
    call cleanUpText( 1.25, 0.85 )
    call UnitAddItemByIdSwapped( 'I094', GetTriggerUnit() )
    call DisableTrigger( GetTriggeringTrigger() )
    call TriggerSleepAction( udg_ITEM_LOSS_TIMEOUT )
    if ( IsQuestCompleted(udg_Quests[udg_Temp_Int]) == false ) then
    call EnableTrigger( gg_trg_L_TFC)
    endif
    endif
                       endif
    set udg_Temp_Unit_Point = null
endfunction

