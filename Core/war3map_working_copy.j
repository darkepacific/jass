//===========================================================================
// Trigger: Solar Beam
//===========================================================================
function Trig_Solar_Beam_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0CU' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Solar_Beam_Func024Func001C takes nothing returns boolean
    if ( not ( IsUnitEnemy(GetEnumUnit(), GetOwningPlayer(udg_Temp_Unit)) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_MECHANICAL) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Solar_Beam_Func024A takes nothing returns nothing
    if ( Trig_Solar_Beam_Func024Func001C() ) then
        call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        call HasFirelords( GetEnumUnit() )
    else
    endif
endfunction

function Trig_Solar_Beam_Func027C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_PX_Firelords[udg_Player_Number]) > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Solar_Beam_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    call TriggerExecute( gg_trg_Firelords_Helper)
    if (  GetTriggerUnit() == udg_yA_Bal_Druid ) then
    set udg_Temp_Int = 0
    endif
    if (  GetTriggerUnit() == udg_yH_Bal_Druid ) then
    set udg_Temp_Int = 1
    endif
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A0CU', udg_Temp_Unit) * 80 )
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 3.00 * udg_RealStatCalc )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    if udg_Eclipse[udg_Temp_Int] == 1 then
    set udg_RealStatCalc = ( 1.50 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A0D0', udg_Temp_Unit) * 5 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 40 )
    call BlzSetUnitAbilityManaCost(udg_Temp_Unit, 'A0D0', GetUnitAbilityLevel(udg_Temp_Unit, 'A0D0') - 1, udg_HeroStatCalc )
    set udg_Eclipse[udg_Temp_Int] = 0
    endif
    set udg_Temp_Polar_Point = GetSpellTargetLoc()
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(( 200.00 + ( 15.00 * I2R(GetUnitAbilityLevelSwapped('A0CU', udg_Temp_Unit)) ) ), udg_Temp_Polar_Point), function Trig_Solar_Beam_Func024A )
    call RemoveLocation (udg_Temp_Polar_Point)
    // Determine if Tick Needs to Turn ON
    if ( Trig_Solar_Beam_Func027C() ) then
        call EnableTrigger( gg_trg_Firelords_Burn_Tick )
    else
    endif
endfunction

//===========================================================================
function InitTrig_Solar_Beam takes nothing returns nothing
    set gg_trg_Solar_Beam = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Solar_Beam, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Solar_Beam, Condition( function Trig_Solar_Beam_Conditions ) )
    call TriggerAddAction( gg_trg_Solar_Beam, function Trig_Solar_Beam_Actions )
endfunction

//===========================================================================
// Trigger: Vortex
//
// Calc distance in tics
//===========================================================================
function Trig_Vortex_Func001C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A0CY' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0GL' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Vortex_Conditions takes nothing returns boolean
    if ( not Trig_Vortex_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Vortex_Func004Func005C takes nothing returns boolean
    if ( not ( 'E01C' == GetUnitTypeId(GetTriggerUnit()) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Vortex_Func004Func006C takes nothing returns boolean
    if ( not ( udg_Eclipse[( udg_Temp_Int - 22 )] == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Vortex_Func004C takes nothing returns boolean
    if ( not ( 'Hkal' == GetUnitTypeId(GetTriggerUnit()) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Vortex_Func010Func003C takes nothing returns boolean
    if ( not ( 'E01C' == GetUnitTypeId(GetTriggerUnit()) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Vortex_Func010C takes nothing returns boolean
    if ( not ( 'Hkal' == GetUnitTypeId(GetTriggerUnit()) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Vortex_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    // Looptick Based on Distance
    if ( Trig_Vortex_Func004C() ) then
        set udg_Temp_Int = 54
        set udg_Charge_Distance = 810.00
    else
        set udg_Charge_Distance = 720.00
        if ( Trig_Vortex_Func004Func005C() ) then
            set udg_Temp_Int = 22
        else
            set udg_Temp_Int = 23
        endif
        if ( Trig_Vortex_Func004Func006C() ) then
            set udg_Eclipse[( udg_Temp_Int - 20 )] = 1
            set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A0D0', udg_Temp_Unit) * 5 )
            set udg_HeroStatCalc = ( udg_HeroStatCalc + 40 )
            call BlzSetUnitAbilityManaCost(udg_Temp_Unit, 'A0D0', GetUnitAbilityLevel(udg_Temp_Unit, 'A0D0') - 1, udg_HeroStatCalc )
            set udg_Eclipse[( udg_Temp_Int - 22 )] = 0
        else
        endif
    endif
    set udg_Point_Charge_Begin[udg_Temp_Int] = GetUnitLoc(GetSpellAbilityUnit())
    set udg_Temp_Polar_Point = GetSpellTargetLoc()
    set udg_Point_Charge_End[udg_Temp_Int] = PolarProjectionBJ(udg_Point_Charge_Begin[udg_Temp_Int], udg_Charge_Distance, AngleBetweenPoints(udg_Point_Charge_Begin[udg_Temp_Int], udg_Temp_Polar_Point))
    call RemoveLocation (udg_Temp_Polar_Point)
    set udg_Charge_Loop[udg_Temp_Int] = 0.00
    if ( Trig_Vortex_Func010C() ) then
        call TriggerExecute( gg_trg_Vortex_Tick_Kael)
        call EnableTrigger( gg_trg_Vortex_Tick_Kael)
    else
        if ( Trig_Vortex_Func010Func003C() ) then
            call TriggerExecute( gg_trg_Vortex_Tick_NE)
            call EnableTrigger( gg_trg_Vortex_Tick_NE)
        else
            call TriggerExecute( gg_trg_Vortex_Tick_TA)
            call EnableTrigger( gg_trg_Vortex_Tick_TA)
        endif
    endif
endfunction

//===========================================================================
function InitTrig_Vortex takes nothing returns nothing
    set gg_trg_Vortex = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Vortex, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Vortex, Condition( function Trig_Vortex_Conditions ) )
    call TriggerAddAction( gg_trg_Vortex, function Trig_Vortex_Actions )
endfunction

//===========================================================================
// Trigger: Vortex Tick NE
//===========================================================================
function Trig_Vortex_Tick_NE_Func022Func001C takes nothing returns boolean
    if ( not ( IsUnitEnemy(GetEnumUnit(), GetOwningPlayer(udg_Temp_Unit)) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_FLYING) == false ) ) then
        return false
    endif
    if ( not ( BlzIsUnitInvulnerable(GetEnumUnit()) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Vortex_Tick_NE_Func022A takes nothing returns nothing
    if ( Trig_Vortex_Tick_NE_Func022Func001C() ) then
        call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_HERO, DAMAGE_TYPE_MAGIC )
        call HasFirelords( GetEnumUnit() )
        call IssueTargetOrderBJ( gg_unit_e028_1863, "cyclone", GetEnumUnit() )
    else
    endif
endfunction

function Trig_Vortex_Tick_NE_Func023C takes nothing returns boolean
    if ( not ( udg_Charge_Loop[udg_Temp_Int] < 9.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Vortex_Tick_NE_Actions takes nothing returns nothing
    set udg_Temp_Unit = udg_yA_Bal_Druid
    call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
    set udg_Temp_Int = 22
    // Damage Calculation
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 2.00 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A0CY', udg_Temp_Unit) * 45 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    // point calc
    set udg_Length = 72.00
    set udg_Width = 240.00
    set udg_Facing_Angle = AngleBetweenPoints(udg_Point_Charge_Begin[udg_Temp_Int], udg_Point_Charge_End[udg_Temp_Int])
    set udg_Temp_Unit_Point = PolarProjectionBJ(udg_Point_Charge_Begin[udg_Temp_Int], ( udg_Length * udg_Charge_Loop[udg_Temp_Int] ), udg_Facing_Angle)
    call TriggerExecute( gg_trg_PICK_EVERY_UNIT_IN_RECT )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Spells\\NightElf\\shadowstrike\\ShadowStrikeMissile.mdl" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 2.00 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call RemoveLocation (udg_Temp_Unit_Point)
    // AoE
    call SetUnitOwner( gg_unit_e028_1863, GetOwningPlayer(udg_Heroes[udg_Player_Number]), true )
    call SetUnitAbilityLevelSwapped( 'A0CX', gg_unit_e028_1863, ( 1 + udg_Eclipse[( udg_Temp_Int - 20 )] ) )
    call ForGroupBJ( udg_UnitsInRect, function Trig_Vortex_Tick_NE_Func022A )
    if ( Trig_Vortex_Tick_NE_Func023C() ) then
        set udg_Charge_Loop[udg_Temp_Int] = ( udg_Charge_Loop[udg_Temp_Int] + 1 )
    else
        set udg_Eclipse[( udg_Temp_Int - 20 )] = 0
        call RemoveLocation (udg_Point_Charge_Begin[udg_Temp_Int])
        call RemoveLocation (udg_Point_Charge_End[udg_Temp_Int])
        call DisableTrigger( GetTriggeringTrigger() )
    endif
endfunction

//===========================================================================
function InitTrig_Vortex_Tick_NE takes nothing returns nothing
    set gg_trg_Vortex_Tick_NE = CreateTrigger(  )
    call DisableTrigger( gg_trg_Vortex_Tick_NE )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Vortex_Tick_NE, 0.10 )
    call TriggerAddAction( gg_trg_Vortex_Tick_NE, function Trig_Vortex_Tick_NE_Actions )
endfunction

