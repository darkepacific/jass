    if ( not ( IsUnitEnemy(GetEnumUnit(), GetOwningPlayer(udg_Temp_Unit)) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
        return false
    endif
    if ( not ( BlzIsUnitInvulnerable(GetEnumUnit()) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_MECHANICAL) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Starfall_NE_Func004A takes nothing returns nothing
    if ( Trig_Starfall_NE_Func004Func001C() ) then
        call HasFirelords( GetEnumUnit() )
        set udg_Temp_Unit = udg_yA_Bal_Druid
    else
    endif
endfunction

function Trig_Starfall_NE_Func006C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_PX_Firelords[udg_Player_Number]) > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Starfall_NE_Actions takes nothing returns nothing
    set udg_Temp_Unit = udg_yA_Bal_Druid
    call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
    set bj_wantDestroyGroup = true
