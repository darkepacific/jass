//===========================================================================
// Trigger: Arcane Explosion
//===========================================================================
function Trig_Arcane_Explosion_Func001Func002C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A08C' ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetTriggerUnit()) != Player(PLAYER_NEUTRAL_AGGRESSIVE) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Arcane_Explosion_Func001C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A00G' ) ) then
        return true
    endif
    if ( Trig_Arcane_Explosion_Func001Func002C() ) then
        return true
    endif
    return false
endfunction

function Trig_Arcane_Explosion_Conditions takes nothing returns boolean
    if ( not Trig_Arcane_Explosion_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Arcane_Explosion_Func007Func001C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'H02T' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Arcane_Explosion_Func007C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'H02Q' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Arcane_Explosion_Func025C takes nothing returns boolean
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Arcane_Explosion_Func027A takes nothing returns nothing
    if IsUnitTargetableEnemyGround( GetEnumUnit(), udg_Temp_Unit ) then
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_Arcane_Explosion_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    local real RSC
    local integer p
    local boolean f
    local boolean r
    if ( Trig_Arcane_Explosion_Func007C() ) then
        set udg_Arcane_LastCast[0] = GetSpellAbilityId()
    else
        if ( Trig_Arcane_Explosion_Func007Func001C() ) then
            set udg_Arcane_LastCast[1] = GetSpellAbilityId()
        else
        endif
    endif
    // SetArcane_Last^^
    set udg_Temp_Unit = GetTriggerUnit()
    call TriggerExecute( gg_trg_Firelords_Helper)
    call ResetClearCasting()
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 4.00 * udg_RealStatCalc )
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    set RSC = udg_RealStatCalc
    set p = udg_Player_Number
    set f = udg_hasFirelords
    set r = udg_hasReaper
    call TriggerSleepAction( 0.25 )
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_RealStatCalc = RSC
    set udg_Player_Number = p
    set udg_hasFirelords = f
    set udg_hasReaper = r
    if ( Trig_Arcane_Explosion_Func025C() ) then
        set udg_HeroStatCalc = ( 365 + ( 10 * GetUnitAbilityLevelSwapped('A00G', GetTriggerUnit()) ) )
    else
        set udg_Temp_Unit = udg_Heroes[udg_Player_Number]
        set udg_HeroStatCalc = ( 365 + ( 10 * GetUnitAbilityLevelSwapped('A08C', GetTriggerUnit()) ) )
    endif
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(I2R(udg_HeroStatCalc), udg_Temp_Unit_Point), function Trig_Arcane_Explosion_Func027A )
    call RemoveLocation (udg_Temp_Unit_Point)
endfunction

