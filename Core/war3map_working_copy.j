    set gg_trg_Soul_Drain_Tick_WG = CreateTrigger(  )
    call DisableTrigger( gg_trg_Soul_Drain_Tick_WG )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Soul_Drain_Tick_WG, 0.50 )
