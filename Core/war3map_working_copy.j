function Trig_Ettin_Move_Actions takes nothing returns nothing
    if ( Trig_Ettin_Move_Func001C() ) then
        set udg_EttinLocation = 1
    else
        set udg_EttinLocation = ( udg_EttinLocation + 1 )
    endif
    if ( Trig_Ettin_Move_Func002C() ) then
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Ettin_1)
        call IssuePointOrderLocBJ( gg_unit_e023_1807, "attack", udg_Temp_Unit_Point )
        call RemoveLocation (udg_Temp_Unit_Point)
        call TriggerSleepAction( 7.50 )
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Ettin_1)
        call IssuePointOrderLocBJ( gg_unit_e023_1807, "attack", udg_Temp_Unit_Point )
        call RemoveLocation (udg_Temp_Unit_Point)
    else
        if ( Trig_Ettin_Move_Func002Func001C() ) then
            set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Ettin_2)
            call IssuePointOrderLocBJ( gg_unit_e023_1807, "patrol", udg_Temp_Unit_Point )
            call RemoveLocation (udg_Temp_Unit_Point)
        else
            set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Ettin_3)
            call IssuePointOrderLocBJ( gg_unit_e023_1807, "attack", udg_Temp_Unit_Point )
            call RemoveLocation (udg_Temp_Unit_Point)
            call TriggerSleepAction( 7.50 )
            set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Ettin_3)
            call IssuePointOrderLocBJ( gg_unit_e023_1807, "attack", udg_Temp_Unit_Point )
            call RemoveLocation (udg_Temp_Unit_Point)
        endif
    endif
endfunction

