//===========================================================================
function Trig_Arcane_Burst_Switch_0_Conditions takes nothing returns boolean
    if ( not ( GetTriggerUnit() == udg_Heroes[0] ) ) then
        return false
    endif
    if ( not ( UnitHasItemOfTypeBJ(udg_Heroes[0], 'I078') == true ) ) then
        return false
    endif
    if ( not ( GetSpellAbilityId() != 'A02D' ) ) then
        return false
    endif
    if ( not ( GetSpellAbilityId() != 'ANss' ) ) then
        return false
    endif
    if ( not ( GetSpellAbilityId() != 'A02U' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Arcane_Burst_Switch_0_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    call EnableTrigger( gg_trg_Arcane_Burst_0 )
    call TriggerSleepAction( 3.20 )
    call DisableTrigger( gg_trg_Arcane_Burst_0 )
    call EnableTrigger( GetTriggeringTrigger() )
endfunction

