    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call PlaySoundAtPointBJ( gg_snd_LightningBolt1, 100.00, udg_Temp_Unit_Point, 0 )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Doodads\\Cinematic\\FireTrapUp\\FireTrapUp.mdl" )
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), 20.00 )
    set fireTrap = GetLastCreatedEffectBJ()
    call TriggerSleepAction( 0.85 )
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 15.00, 215.00)
    call CreateNUnitsAtLoc( 1, 'n04S', Player(1), udg_Temp_Polar_Point, 300.00 )
    set ele = GetLastCreatedUnit()
    call SetUnitAnimation( GetLastCreatedUnit(), "Spell" )
    call ResetUnitAnimation( GetLastCreatedUnit() )
    call RemoveLocation (udg_Temp_Polar_Point)
    call RemoveLocation (udg_Temp_Unit_Point)
    call BlzSetUnitStringFieldBJ( GetLastCreatedUnit(), UNIT_SF_NAME, "Princess Myzrael" )
    call PlaySoundOnUnitBJ( gg_snd_WaterElementalDeath, 100, GetLastCreatedUnit() )
    call CreateTextTagUnitBJ( "Free! At last!", GetLastCreatedUnit(), 0, 9.00, 25.00, 100.00, 00.00, 0.00 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
    call cleanUpText(1.4, 1.0)
    call UnitApplyTimedLifeBJ( 90.00, 'BTLF', GetLastCreatedUnit() )
    call TriggerSleepAction( 1.50 )
    call ResetUnitAnimation( ele )
    set ele = null
    call DestroyEffectBJ( fireTrap )
    set fireTrap = null
    set udg_Temp_Unit_Point = null
endfunction

