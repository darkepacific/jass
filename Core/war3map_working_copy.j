function InitTrig_TELE takes nothing returns nothing
    set gg_trg_TELE = CreateTrigger(  )
    call DisableTrigger( gg_trg_TELE )
    call TriggerRegisterPlayerChatEvent( gg_trg_TELE, Player(2), "-tp", false )
    call TriggerRegisterPlayerChatEvent( gg_trg_TELE, Player(7), "-tp", false )
    call TriggerRegisterPlayerChatEvent( gg_trg_TELE, Player(8), "-tp", false )
    call TriggerRegisterPlayerChatEvent( gg_trg_TELE, Player(9), "-tp", false )
    call TriggerRegisterPlayerChatEvent( gg_trg_TELE, Player(4), "-tp", false )
    call TriggerRegisterPlayerChatEvent( gg_trg_TELE, Player(5), "-tp", false )
    call TriggerRegisterPlayerChatEvent( gg_trg_TELE, Player(6), "-tp", false )
    call TriggerRegisterPlayerChatEvent( gg_trg_TELE, Player(10), "-tp", false )
    call TriggerAddAction( gg_trg_TELE, function Trig_TELE_Actions )
endfunction

//===========================================================================
// Trigger: QUICKTEST
//===========================================================================
function Trig_QUICKTEST_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    call TriggerExecute( gg_trg_ENABLE_Cheats )
    call TriggerExecute( gg_trg_EQUIP )
    if udg_Quick_Deaths == false then
    set udg_Quick_Deaths = true
    endif
    call TriggerExecute( gg_trg_VISION_ON )
    call PlayerNumbtoHeroesNumb()
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_TP_Island)
    call SetUnitPositionLoc( udg_Heroes[udg_Player_Number], udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerExecute( gg_trg_GOLD )
    call TriggerExecute( gg_trg_GOLD )
    call TriggerExecute( gg_trg_GOLD )
    call TriggerExecute( gg_trg_GOLD )
    call TriggerExecute( gg_trg_GOLD )
    set udg_TempString = SubStringBJ(GetEventPlayerChatString(), 4, 4)
    if (udg_TempString != "t") then
    call TriggerExecute( gg_trg_TEST )
    endif
    if udg_Debug == false then
    call TriggerExecute( gg_trg_DEBUG )
    endif
    call TriggerExecute( gg_trg_LVLS_UP )
    set udg_Temp_Unit_Point = null
endfunction

