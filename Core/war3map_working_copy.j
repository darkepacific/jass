//===========================================================================
// Trigger: S GWG
//
// Need to change this to team wide display.
//===========================================================================
function Trig_S_GWG_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
                       if IsAllianceHero( GetTriggerUnit() ) then
    set udg_TempString = "The Greenwarden's Grove"
    set udg_TempString_Quest = "Grow 8 Ents for the Greenwarden"
    call TriggerExecute( gg_trg_Quest_Start_A )
    set udg_TempString = ""
    if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
    set udg_TempString = udg_QuestionMark
    call QuestSetEnabledBJ( true, udg_Quests[112] )
    endif
    call FlashQuestDialogButtonBJ(  )
    call DestroyEffectBJ( udg_QuestMarks[112] )
    call AddSpecialEffectTargetUnitBJ( "overhead", gg_unit_etrp_0647, udg_TempString )
    set udg_QuestMarks[112] = GetLastCreatedEffectBJ()
    call QuestSetCompletedBJ( udg_Quests[112], false )
    call CreateQuestItemBJ( udg_Quests[112], "TRIGSTR_9953" )
    set udg_QuestReqs[112] = GetLastCreatedQuestItemBJ()
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Q_Fertile_Soil_4)
    call CampaignMinimapIconLocBJ( udg_Temp_Unit_Point, bj_CAMPPINGSTYLE_CONTROL_NEUTRAL )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_MiniMapIcon[112] = GetLastCreatedMinimapIcon()
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), false )
    endif
    call DisableTrigger( GetTriggeringTrigger() )
    call EnableTrigger( gg_trg_U_GWG_Start)
    call EnableTrigger( gg_trg_U_GWG_Begin)
    call EnableTrigger( gg_trg_U_GWG_Finish)
    call EnableTrigger( gg_trg_H_GWG)
    call EnableTrigger( gg_trg_E_GWG)
    call UnitAddItemByIdSwapped( 'I08S', GetTriggerUnit() )
    // Create Soil
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Q_Fertile_Soil_1)
    call CreateDestructableLoc( 'B02H', udg_Temp_Unit_Point, GetRandomDirectionDeg(), 1, 0 )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Q_Fertile_Soil_2)
    call CreateDestructableLoc( 'B02H', udg_Temp_Unit_Point, GetRandomDirectionDeg(), 1, 0 )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Q_Fertile_Soil_3)
    call CreateDestructableLoc( 'B02H', udg_Temp_Unit_Point, GetRandomDirectionDeg(), 1, 0 )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Q_Fertile_Soil_4)
    call CreateDestructableLoc( 'B02H', udg_Temp_Unit_Point, GetRandomDirectionDeg(), 1, 0 )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Q_Fertile_Soil_5)
    call CreateDestructableLoc( 'B02H', udg_Temp_Unit_Point, GetRandomDirectionDeg(), 1, 0 )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Q_Fertile_Soil_6)
    call CreateDestructableLoc( 'B02H', udg_Temp_Unit_Point, GetRandomDirectionDeg(), 1, 0 )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 10.00 )
    call EnableTrigger( gg_trg_L_GWG)
                       endif
    set udg_Temp_Unit_Point = null
endfunction

