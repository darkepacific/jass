//===========================================================================
// Trigger: S MMT
//
// Need to change this to team wide display.
//===========================================================================
function Trig_S_MMT_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
                       if IsAllianceHero( GetTriggerUnit() ) then
    set udg_TempString = "Murloc Me Timbers!"
    set udg_TempString_Quest = "Kill 12 Murlocs in a Bubble."
    call TriggerExecute( gg_trg_Quest_Start_A )
    call QuestMessageBJ( udg_AlliancePlayers, bj_QUESTMESSAGE_REQUIREMENT, "TRIGSTR_10932" )
    if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
    call QuestSetEnabledBJ( true, udg_Quests[125] )
    call FlashQuestDialogButtonBJ(  )
    endif
    call DestroyEffectBJ( udg_QuestMarks[125] )
    call QuestSetCompletedBJ( udg_Quests[125], false )
    call CreateQuestItemBJ( udg_Quests[125], "TRIGSTR_10931" )
    set udg_QuestReqs[125] = GetLastCreatedQuestItemBJ()
    set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_Bubble_Murlocs)
    call CampaignMinimapIconLocBJ( udg_Temp_Unit_Point, bj_CAMPPINGSTYLE_CONTROL_NEUTRAL )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_MiniMapIcon[125] = GetLastCreatedMinimapIcon()
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), false )
    endif
    call DisableTrigger( GetTriggeringTrigger() )
    set bj_forLoopBIndex = 1
    set bj_forLoopBIndexEnd = 1
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_Bubble_Murlocs)
        call CreateNUnitsAtLoc( 1, 'h03T', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
        call SetUnitAcquireRangeBJ( GetLastCreatedUnit(), 200.00 )
        call RemoveLocation (udg_Temp_Unit_Point)
        set bj_forLoopBIndex = bj_forLoopBIndex + 1
    endloop
    call EnableTrigger(gg_trg_E_MMT)
    call EnableTrigger(gg_trg_H_MMT)
    call EnableTrigger(gg_trg_Cannon_Clicked)
    call TriggerSleepAction( 0.50 )
    call QuestMessageBJ( udg_AlliancePlayers, bj_QUESTMESSAGE_REQUIREMENT, "TRIGSTR_10933" )
                       endif
    set udg_Temp_Unit_Point = null
endfunction

