//===========================================================================
// Trigger: Channel Stops
//===========================================================================
function Trig_Channel_Stops_Func004C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A02D' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0DK' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0FW' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0G4' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0H2' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Channel_Stops_Conditions takes nothing returns boolean
    if ( not Trig_Channel_Stops_Func004C() ) then
        return false
    endif
    return true
endfunction

function Trig_Channel_Stops_Func013C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0H2' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Channel_Stops_Func014Func001C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A0DK' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0FW' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0G4' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Channel_Stops_Func014Func005C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0G4' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Channel_Stops_Func014C takes nothing returns boolean
    if ( not Trig_Channel_Stops_Func014Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Channel_Stops_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point 
    local unit udg_Temp_Unit = GetTriggerUnit()
    call Debug("Stop Channel Triggered" )
    call PlayerNumbtoHeroesNumb()
    set udg_IsHearthing[udg_Player_Number] = false
    call BlzSetSpecialEffectAlpha( udg_SpellChannels[udg_Player_Number], 0 )
    call DestroyEffectBJ( udg_SpellChannels[udg_Player_Number] )
    if GetLocalPlayer() == GetOwningPlayer(GetTriggerUnit()) then
    call StopSoundBJ( gg_snd_Hearthstone, false )
    endif
    call SetUnitTimeScalePercent( udg_Temp_Unit, 100.00 )
    if ( Trig_Channel_Stops_Func013C() ) then
        call StopSoundBJ( gg_snd_PreCastFireHigh, false )
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_DummyIsland)
        call BlzSetSpecialEffectPositionLoc( udg_SpellChannels[( udg_Player_Number + 24 )], udg_Temp_Unit_Point )
        call RemoveLocation (udg_Temp_Unit_Point)
        call DestroyEffectBJ( udg_SpellChannels[( udg_Player_Number + 24 )] )
        call BlzSetSpecialEffectAlpha( udg_SpellChannels[( udg_Player_Number + 24 )], 0 )
        call BlzSetSpecialEffectScale( udg_SpellChannels[( udg_Player_Number + 24 )], 0.01 )
    else
    endif
    if ( Trig_Channel_Stops_Func014C() ) then
        call DestroyEffectBJ( udg_SpellChannels[( udg_Player_Number + 24 )] )
        call DestroyEffectBJ( udg_SpellChannels[( udg_Player_Number + 48 )] )
        call DestroyEffectBJ( udg_SpellChannels[( udg_Player_Number + 72 )] )
        if ( Trig_Channel_Stops_Func014Func005C() ) then
            call StopSoundBJ( gg_snd_NatureCast, false )
        else
            call StopSoundBJ( gg_snd_LayOnHands, false )
        endif
    else
    endif
    set udg_Temp_Unit = null
    set udg_Temp_Unit_Point = null
endfunction

