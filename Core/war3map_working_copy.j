    call TriggerAddAction( gg_trg_Bear_Unmorph_TA, function Trig_Bear_Unmorph_TA_Actions )
endfunction

//===========================================================================
// Trigger: H Feral Druid Dies
//===========================================================================
function Trig_H_Feral_Druid_Dies_Actions takes nothing returns nothing
    call GameTimeWait(1.5)
    call SetPlayerAbilityAvailableBJ( true, 'A00N', GetOwningPlayer(GetTriggerUnit()) )
    call EnableTrigger( gg_trg_Cat_Cast_TA )
    call DisableTrigger( gg_trg_Cat_Unmorph_TA )
    call SetPlayerAbilityAvailableBJ( true, 'A08P', GetOwningPlayer(GetTriggerUnit()) )
    set udg_isDruid_Tauren = true
    call EnableTrigger( gg_trg_Bear_Cast_TA )
    call DisableTrigger( gg_trg_Bear_Unmorph_TA )
    call SetPlayerAbilityAvailableBJ( true, 'A030', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A02Z', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A02Y', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A0CV', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A0E1', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A0E3', GetOwningPlayer(GetTriggerUnit()) )
    call SetUnitVertexColorBJ( GetTriggerUnit(), 100.00, 100.00, 100.00, 0 )
endfunction

//===========================================================================
