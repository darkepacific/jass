    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'h008' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'h02S' ) ) then
        return true
    endif
    return false
endfunction

