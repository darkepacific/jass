//===========================================================================
// Trigger: Arcane Missiles Start
//===========================================================================
function Trig_Arcane_Missiles_Start_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A08A' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Arcane_Missiles_Start_Func003C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'H02Q' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Arcane_Missiles_Start_Actions takes nothing returns nothing
    local integer i
    set i = 0
    if ( Trig_Arcane_Missiles_Start_Func003C() ) then
        set udg_Temp_Int = 0
        set udg_Arcane_LastCast[0] = GetSpellAbilityId()
    else
        set udg_Temp_Int = 3
        set udg_Arcane_LastCast[1] = GetSpellAbilityId()
    endif
    call PlaySoundOnUnitBJ( gg_snd_MageChannel, 75.00, GetSpellAbilityUnit() )
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 0 ]  then
    call CreateNUnitsAtLoc( 1, 'e040', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, GetUnitFacing(GetTriggerUnit()) )
    else
    call CreateNUnitsAtLoc( 1, 'e029', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, GetUnitFacing(GetTriggerUnit()) )
    endif
    call SetUnitPositionLoc( GetLastCreatedUnit(), udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit = GetTriggerUnit()
    call ResetClearCasting()
    set udg_HeroStatCalc = ( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) )
    set udg_HeroStatCalc = ( 2 * udg_HeroStatCalc )
    set udg_HeroStatCalc = ( ( GetUnitAbilityLevelSwapped('A08A', GetTriggerUnit()) * 35 ) + udg_HeroStatCalc )
    call BlzSetUnitWeaponIntegerFieldBJ( GetLastCreatedUnit(), UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 0, ( BlzGetUnitBaseDamage(GetLastCreatedUnit(), 0) + udg_HeroStatCalc ) )
    call UnitApplyTimedLifeBJ( 1.80, 'BTLF', GetLastCreatedUnit() )
    set udg_ArcaneMissiles[udg_Temp_Int] = GetLastCreatedUnit()
    set udg_ArcaneMissiles[( udg_Temp_Int + 1 )] = GetSpellTargetUnit()
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    call SetUnitPositionLoc( udg_ArcaneMissiles[udg_Temp_Int], udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call IssueTargetOrderBJ( udg_ArcaneMissiles[udg_Temp_Int], "attack", udg_ArcaneMissiles[( udg_Temp_Int + 1 )] )
    set i = udg_Temp_Int
    call TriggerSleepAction( 0.50 )
    set udg_Temp_Int = i
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    call SetUnitPositionLoc( udg_ArcaneMissiles[udg_Temp_Int], udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call IssueTargetOrderBJ( udg_ArcaneMissiles[udg_Temp_Int], "attack", udg_ArcaneMissiles[( udg_Temp_Int + 1 )] )
endfunction

