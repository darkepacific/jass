function InitTrig_M_Sindragosa_A takes nothing returns nothing
    set gg_trg_M_Sindragosa_A = CreateTrigger(  )
    call TriggerRegisterTimerEventSingle( gg_trg_M_Sindragosa_A, 11.10 )
    call TriggerAddAction( gg_trg_M_Sindragosa_A, function Trig_M_Sindragosa_A_Actions )
endfunction

//===========================================================================
// Trigger: S Sindra A
//
// Create Quests for ALL players,
// Enable/Disable Quests for specific players
// Enable/Disabling quests does not cause desyncing.
//===========================================================================
function Trig_S_Sindra_A_Actions takes nothing returns nothing
                       if IsAllianceHero( GetTriggerUnit() ) then
    call DisableTrigger( GetTriggeringTrigger() )
    set udg_TempString = "Sindragosa"
    set udg_TempString_Quest = "Kill Sindragosa off the eastside of Northrend"
    call TriggerExecute( gg_trg_Quest_Start_A )
    call DestroyEffectBJ( udg_QuestMarks[84] )
    if IsAlliancePlayer( GetLocalPlayer() ) then
    call QuestSetEnabledBJ( true, udg_Quests[84] )
    call FlashQuestDialogButtonBJ(  )
    endif
    call QuestSetCompletedBJ( udg_Quests[84], false )
    call CreateQuestItemBJ( udg_Quests[84], "TRIGSTR_591" )
    set udg_QuestReqs[84] = GetLastCreatedQuestItemBJ()
    call EnableTrigger( gg_trg_E_Sindra_A )
                       endif
endfunction

