//===========================================================================
// Trigger: Heroic Leap AoE
//===========================================================================
function Trig_Heroic_Leap_AoE_Func003C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A04K' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A07I' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Heroic_Leap_AoE_Conditions takes nothing returns boolean
    if ( not Trig_Heroic_Leap_AoE_Func003C() ) then
        return false
    endif
    return true
endfunction

function Trig_Heroic_Leap_AoE_Func005Func001C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'n024' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'n05N' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Heroic_Leap_AoE_Func005C takes nothing returns boolean
    if ( not Trig_Heroic_Leap_AoE_Func005Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Heroic_Leap_AoE_Func006Func002Func001Func001C takes nothing returns boolean
    if ( not ( IsTriggerEnabled(gg_trg_Charge_Timer_Extra) == false ) ) then
        return false
    endif
    if ( not ( IsTriggerEnabled(gg_trg_Leap_Timer_Extra) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Heroic_Leap_AoE_Func006Func002Func001C takes nothing returns boolean
    if ( not ( udg_Temp_Unit == udg_Kheti_The_Yeti ) ) then
        return false
    endif
    return true
endfunction

function Trig_Heroic_Leap_AoE_Func006Func002C takes nothing returns boolean
    if ( not ( udg_Temp_Unit == udg_yH_Arms_Warr ) ) then
        return false
    endif
    return true
endfunction

function Trig_Heroic_Leap_AoE_Func006C takes nothing returns boolean
    if ( not ( udg_Temp_Unit == udg_yA_Arms_Warr ) ) then
        return false
    endif
    return true
endfunction

function Trig_Heroic_Leap_AoE_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    call PlaySoundOnUnitBJ( gg_snd_WarriorHeroricLeap, 85.00, GetSpellAbilityUnit() )
    if ( Trig_Heroic_Leap_AoE_Func005C() ) then
        call AddSpecialEffectTargetUnitBJ( "origin", GetSpellAbilityUnit(), "war3mapImported\\Valiant Charge Fel.mdx" )
    else
        call AddSpecialEffectTargetUnitBJ( "origin", GetSpellAbilityUnit(), "war3mapImported\\Valiant Charge.mdx" )
    endif
    if ( Trig_Heroic_Leap_AoE_Func006C() ) then
        set udg_Temp_Int = 1
        set udg_Point_Charge_Begin[udg_Temp_Int] = GetUnitLoc(GetSpellAbilityUnit())
        set udg_Point_Charge_End[udg_Temp_Int] = GetSpellTargetLoc()
        set udg_Charge_SE[udg_Temp_Int] = GetLastCreatedEffectBJ()
        set udg_Charge_Loop[udg_Temp_Int] = 3.00
        call EnableTrigger( gg_trg_Leap_Timer_Human )
    else
        if ( Trig_Heroic_Leap_AoE_Func006Func002C() ) then
            set udg_Temp_Int = 4
            set udg_Point_Charge_Begin[udg_Temp_Int] = GetUnitLoc(GetSpellAbilityUnit())
            set udg_Point_Charge_End[udg_Temp_Int] = GetSpellTargetLoc()
            set udg_Charge_SE[udg_Temp_Int] = GetLastCreatedEffectBJ()
            set udg_Charge_Loop[udg_Temp_Int] = 3.00
            call EnableTrigger( gg_trg_Leap_Timer_Orc )
        else
            if ( Trig_Heroic_Leap_AoE_Func006Func002Func001C() ) then
                set udg_Temp_Int = 64
                set udg_Point_Charge_Begin[udg_Temp_Int] = GetUnitLoc(GetSpellAbilityUnit())
                set udg_Point_Charge_End[udg_Temp_Int] = GetSpellTargetLoc()
                set udg_Charge_SE[udg_Temp_Int] = GetLastCreatedEffectBJ()
                set udg_Charge_Loop[udg_Temp_Int] = 3.00
                call EnableTrigger( gg_trg_Leap_Timer_Yeti )
            else
                if ( Trig_Heroic_Leap_AoE_Func006Func002Func001Func001C() ) then
                    set udg_Temp_Int = 8
                    set udg_Charge_Extra = GetTriggerUnit()
                    set udg_Point_Charge_Begin[udg_Temp_Int] = GetUnitLoc(GetSpellAbilityUnit())
                    set udg_Point_Charge_End[udg_Temp_Int] = GetSpellTargetLoc()
                    set udg_Charge_SE[udg_Temp_Int] = GetLastCreatedEffectBJ()
                    set udg_Charge_Loop[udg_Temp_Int] = 1.00
                    call EnableTrigger( gg_trg_Leap_Timer_Extra )
                else
                endif
            endif
        endif
    endif
endfunction

