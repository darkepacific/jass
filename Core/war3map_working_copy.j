//===========================================================================
// Trigger: C Kill KelThuzad
//===========================================================================
function Trig_C_Kill_KelThuzad_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    call IssueImmediateOrderBJ( gg_unit_Hpal_0558, "divineshield" )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_KT_Defeat_Anim)
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\OrbofCorruption.mdl" )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_KTDestroEffect = GetLastCreatedEffectBJ()
    call TriggerSleepAction( 0.85 )
    call IssueImmediateOrderBJ( gg_unit_Hpal_0558, "resurrection" )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_KT_Defeat_Anim)
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Spell_Smite.mdx" )
    call RemoveLocation (udg_Temp_Unit_Point)
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call TriggerSleepAction( 0.27 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_KT_Defeat_Anim)
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl" )
    call RemoveLocation (udg_Temp_Unit_Point)
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call DestroyEffectBJ( udg_KTDestroEffect )
    set udg_Temp_Unit_Point = null
endfunction

