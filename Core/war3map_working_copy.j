//===========================================================================
// Trigger: Sundering Effect
//===========================================================================
function Trig_Sundering_Effect_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A08S' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Sundering_Effect_Func010Func001C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'O00P' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Sundering_Effect_Func010C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'O00J' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Sundering_Effect_Actions takes nothing returns nothing
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    set udg_Temp_Polar_Point = GetSpellTargetLoc()
    call AddSpecialEffectLocBJ( PolarProjectionBJ(udg_Temp_Unit_Point, 350.00, AngleBetweenPoints(udg_Temp_Unit_Point, udg_Temp_Polar_Point)), "Doodads\\Barrens\\Rocks\\BarrensFissure\\BarrensFissure0.mdl" )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), Deg2Rad(AngleBetweenPoints(udg_Temp_Unit_Point, udg_Temp_Polar_Point)), 0.0, 0.0 )
    call RemoveLocation (udg_Temp_Unit_Point)
    call RemoveLocation (udg_Temp_Polar_Point)
    call BlzSetSpecialEffectColor( GetLastCreatedEffectBJ(), 255, 200, 255 )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 1.52 )
    if ( Trig_Sundering_Effect_Func010C() ) then
        set udg_SunderingAndBoJ[0] = GetLastCreatedEffectBJ()
        set udg_SpellTicks[10] = 90
    else
        if ( Trig_Sundering_Effect_Func010Func001C() ) then
            set udg_SunderingAndBoJ[4] = GetLastCreatedEffectBJ()
            set udg_SpellTicks[29] = 90
        else
            set udg_SunderingAndBoJ[1] = GetLastCreatedEffectBJ()
            set udg_SpellTicks[13] = 90
        endif
    endif
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call TriggerSleepAction( 0.30 )
    call EnableTrigger(gg_trg_Sundering_Fade)
endfunction

//===========================================================================
function InitTrig_Sundering_Effect takes nothing returns nothing
    set gg_trg_Sundering_Effect = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Sundering_Effect, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Sundering_Effect, Condition( function Trig_Sundering_Effect_Conditions ) )
    call TriggerAddAction( gg_trg_Sundering_Effect, function Trig_Sundering_Effect_Actions )
endfunction

//===========================================================================
// Trigger: Sundering DMG
//
// // Its the travel time that's causing bugs (0.3s travel time of the impale, cause 0.85s wait to be off)
//===========================================================================
function Trig_Sundering_DMG_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A08S' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Sundering_DMG_Func035Func001C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetEnumUnit(), 'BUim') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Sundering_DMG_Func035A takes nothing returns nothing
    if ( Trig_Sundering_DMG_Func035Func001C() ) then
        if IsUnitTargetableEnemyStab( GetEnumUnit(), udg_Temp_Unit ) then
        call HasFirelords( GetEnumUnit() )
        endif
    else
    endif
endfunction

function Trig_Sundering_DMG_Func049Func002C takes nothing returns boolean
    if ( not ( IsUnitEnemy(GetEnumUnit(), GetOwningPlayer(udg_Temp_Unit)) == true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(GetEnumUnit(), 'BUim') == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( BlzIsUnitInvulnerable(GetEnumUnit()) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Sundering_DMG_Func049A takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    if ( Trig_Sundering_DMG_Func049Func002C() ) then
        call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        call HasFirelords( GetEnumUnit() )
    else
    endif
endfunction

function Trig_Sundering_DMG_Actions takes nothing returns nothing
    local location udg_Temp_Polar_Point
    local real RSC
    local integer p
    local boolean f
    local boolean r
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_Temp_Polar_Point = GetSpellTargetLoc()
    call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, false) ))
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 12 ]  then
    set udg_RealStatCalc = ( 9.00 * udg_RealStatCalc )
    else
    set udg_RealStatCalc = ( 5.00 * udg_RealStatCalc )
    endif
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A08S', udg_Temp_Unit) * 125 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 25 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A08S'), ABILITY_RLF_DAMAGE_DEALT_UIM3, ( GetUnitAbilityLevel( udg_Temp_Unit, GetSpellAbilityId()) - 1 ), udg_RealStatCalc )
    call RemoveLocation (udg_Temp_Polar_Point)
    // Firelords
    call GameTimeWait(1.05)
    // Firelords
    set udg_Temp_Unit = GetTriggerUnit()
    call TriggerExecute( gg_trg_Firelords_Helper)
    set udg_Length = 700.00
    set udg_Width = 350.00
    set udg_Temp_X_Point = GetUnitLoc(udg_Temp_Unit)
    set udg_Facing_Angle = AngleBetweenPoints(udg_Temp_X_Point, udg_Temp_Polar_Point)
    call RemoveLocation (udg_Temp_Polar_Point)
    set udg_Temp_Unit_Point = PolarProjectionBJ(udg_Temp_X_Point, 50.00, udg_Facing_Angle)
    call RemoveLocation (udg_Temp_X_Point)
    call TriggerExecute( gg_trg_PICK_EVERY_UNIT_IN_RECT )
    call RemoveLocation (udg_Temp_Unit_Point)
    call ForGroupBJ( udg_UnitsInRect, function Trig_Sundering_DMG_Func035A )
    set  udg_Temp_Polar_Point = null
    return
    // OLD FIRELORDS
    set RSC = udg_RealStatCalc
    set p = udg_Player_Number
    set f = udg_hasFirelords
    set r = udg_hasReaper
    call TriggerSleepAction( 1.20 )
    set udg_RealStatCalc = RSC
    set udg_Player_Number = p
    set udg_hasFirelords = f
    set udg_hasReaper = r
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(520.00, udg_Temp_Polar_Point), function Trig_Sundering_DMG_Func049A )
    call RemoveLocation (udg_Temp_Polar_Point)
    set  udg_Temp_Polar_Point = null
endfunction

//===========================================================================
function InitTrig_Sundering_DMG takes nothing returns nothing
    set gg_trg_Sundering_DMG = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Sundering_DMG, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Sundering_DMG, Condition( function Trig_Sundering_DMG_Conditions ) )
    call TriggerAddAction( gg_trg_Sundering_DMG, function Trig_Sundering_DMG_Actions )
endfunction

//===========================================================================
// Trigger: Sundering Fade
//===========================================================================
function Trig_Sundering_Fade_Func008C takes nothing returns boolean
    if ( not ( udg_SpellTicks[10] <= 0 ) ) then
        return false
    endif
    if ( not ( udg_SpellTicks[13] <= 0 ) ) then
        return false
    endif
    if ( not ( udg_SpellTicks[29] <= 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Sundering_Fade_Actions takes nothing returns nothing
    set udg_RealStatCalc = ( I2R(udg_SpellTicks[10]) / 100.00 )
    call BlzSetSpecialEffectAlpha( udg_SunderingAndBoJ[0], R2I(( 255.00 * udg_RealStatCalc )) )
    set udg_RealStatCalc = ( I2R(udg_SpellTicks[13]) / 100.00 )
    call BlzSetSpecialEffectAlpha( udg_SunderingAndBoJ[1], R2I(( 255.00 * udg_RealStatCalc )) )
    set udg_RealStatCalc = ( I2R(udg_SpellTicks[29]) / 100.00 )
    call BlzSetSpecialEffectAlpha( udg_SunderingAndBoJ[4], R2I(( 255.00 * udg_RealStatCalc )) )
    if ( Trig_Sundering_Fade_Func008C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
    else
        set udg_SpellTicks[10] = ( udg_SpellTicks[10] - 15 )
        set udg_SpellTicks[13] = ( udg_SpellTicks[13] - 15 )
        set udg_SpellTicks[29] = ( udg_SpellTicks[29] - 15 )
    endif
endfunction

//===========================================================================
function InitTrig_Sundering_Fade takes nothing returns nothing
    set gg_trg_Sundering_Fade = CreateTrigger(  )
    call DisableTrigger( gg_trg_Sundering_Fade )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Sundering_Fade, 0.15 )
    call TriggerAddAction( gg_trg_Sundering_Fade, function Trig_Sundering_Fade_Actions )
endfunction

//===========================================================================
// Trigger: Lightning Shield
//===========================================================================
function Trig_Lightning_Shield_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A08U' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Lightning_Shield_Func030A takes nothing returns nothing
    if IsUnitTargetableEnemyGround( GetEnumUnit(), udg_Temp_Unit ) then
    call AddSpecialEffectTargetUnitBJ( "overhead", GetEnumUnit(), "Abilities\\Weapons\\FireBallMissile\\FireBallMissile.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_Lightning_Shield_Actions takes nothing returns nothing
    local effect eff
    set udg_Temp_Unit = GetTriggerUnit()
    if ( udg_Temp_Unit == udg_yH_Enhance_Shaman) then
    set udg_Temp_Int = 2
    else
    set udg_Temp_Int = 8
    endif
    set udg_Shaman_Eq_Ls[udg_Temp_Int] = GetSpellTargetUnit()
    call EnableTrigger(gg_trg_Lightning_Shield_Tick)
    call EnableTrigger(gg_trg_Lightning_Shield_Heal)
    // Earth Talent
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 9 ]  then
    call AddSpecialEffectTargetUnitBJ( "origin", GetSpellTargetUnit(), "war3mapImported\\Earth Shield2.mdx" )
    set eff = GetLastCreatedEffectBJ()
    call GameTimeWait(2.0)
    call DestroyEffectBJ( eff )
    // Water Talent
    elseif udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 10 ]  then
    call AddSpecialEffectTargetUnitBJ( "origin", GetSpellTargetUnit(), "war3mapImported\\WaterBlast.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    // Fire Talent
    elseif udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 11 ]  then
    call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - 0 ))
    set udg_RealStatCalc = ( 300.00 + ( 3.00 * udg_RealStatCalc ) )
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Shaman_Eq_Ls[udg_Temp_Int])
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Damnation Orange.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(260.00, udg_Temp_Unit_Point), function Trig_Lightning_Shield_Func030A )
    call RemoveLocation (udg_Temp_Unit_Point)
    endif
    set eff = null
endfunction

//===========================================================================
function InitTrig_Lightning_Shield takes nothing returns nothing
    set gg_trg_Lightning_Shield = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Lightning_Shield, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Lightning_Shield, Condition( function Trig_Lightning_Shield_Conditions ) )
