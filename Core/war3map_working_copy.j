    call DisableTrigger(gg_trg_U_SAC_H)
    call DisableTrigger( GetTriggeringTrigger() )
    // Next Quest
    call TriggerExecute(gg_trg_M_KWI_H)
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Q_Big_Cage_Agent_Skully)
    call StopSoundBJ( gg_snd_undeadfemalelaugh, false )
    call PlaySoundAtPointBJ( gg_snd_undeadfemalelaugh, 100.00, udg_Temp_Unit_Point, 0 )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = null
endfunction

