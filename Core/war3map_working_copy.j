//===========================================================================
function Trig_S_PYR_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    local integer udg_Temp_Int = 128
                       if IsHordeHero( GetTriggerUnit() ) then
    call DisableTrigger( GetTriggeringTrigger() )
    set udg_TempString = "The Conquest of Pyrewood"
    set udg_TempString_Quest = "Conquer Pyrewood by placing the Forsaken Crest in the town and defending it."
    call TriggerExecute( gg_trg_Quest_Start_H )
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    call QuestSetEnabledBJ( true, udg_Quests[udg_Temp_Int] )
    call FlashQuestDialogButtonBJ(  )
    endif
    call DestroyEffectBJ( udg_QuestMarks[udg_Temp_Int] )
    call QuestSetCompletedBJ( udg_Quests[udg_Temp_Int], false )
    call CreateQuestItemBJ( udg_Quests[udg_Temp_Int], "TRIGSTR_11431" )
    set udg_QuestReqs[udg_Temp_Int] = GetLastCreatedQuestItemBJ()
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Forsaken_Crest)
    call CampaignMinimapIconLocBJ( udg_Temp_Unit_Point, bj_CAMPPINGSTYLE_CONTROL_NEUTRAL )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_MiniMapIcon[udg_Temp_Int] = GetLastCreatedMinimapIcon()
    if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
    call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), false )
    endif
    call UnitAddItemByIdSwapped( 'I0A9', GetTriggerUnit() )
    set udg_Temp_Unit_Point = null
    call EnableTrigger( gg_trg_U_PYR)
    call EnableTrigger( gg_trg_E_PYR)
    call TriggerSleepAction( 10.00 )
    if ( IsQuestCompleted(udg_Quests[udg_Temp_Int]) == false ) then
    call EnableTrigger( gg_trg_L_PYR)
                       endif
    endif
endfunction

