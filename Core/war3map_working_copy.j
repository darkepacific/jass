//===========================================================================
// Trigger: Virulent Plague Begin
//===========================================================================
function Trig_Virulent_Plague_Begin_Conditions takes nothing returns boolean
    return ( GetSpellAbilityId() == 'A03J' ) 
endfunction

function Trig_Virulent_Plague_Error_Msg takes nothing returns nothing
    call IssueImmediateOrderBJ( GetTriggerUnit(), "stop" )
    call ErrorMessage( "No currently plagued targets.", GetOwningPlayer(GetTriggerUnit()) )
    call SetUnitManaBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) + I2R(BlzGetAbilityManaCost('A03J', ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ))) ) )
endfunction

function Trig_Virulent_Plague_Begin_Actions takes nothing returns nothing
    if ( GetTriggerUnit() == udg_yA_Unholy_DK) then
        call SpellUnits_CleanMissingBuff( udg_z_DK_UNHO_A, 40, 63, 'B01K')
        if  SpellUnits_Count( udg_z_DK_UNHO_A, 40, 63) == 0 then
            call Trig_Virulent_Plague_Error_Msg()
        endif
    elseif ( GetTriggerUnit() == udg_yH_Unholy_DK) then
        call SpellUnits_CleanMissingBuff( udg_z_DK_UNHO_H, 40, 63, 'B039')
        if  SpellUnits_Count( udg_z_DK_UNHO_H, 40, 63) == 0 then
            call Trig_Virulent_Plague_Error_Msg()
        endif
    endif
 endfunction

//===========================================================================
function InitTrig_Virulent_Plague_Begin takes nothing returns nothing
    set gg_trg_Virulent_Plague_Begin = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Virulent_Plague_Begin, EVENT_PLAYER_UNIT_SPELL_CAST )
    call TriggerAddCondition( gg_trg_Virulent_Plague_Begin, Condition( function Trig_Virulent_Plague_Begin_Conditions ) )
    call TriggerAddAction( gg_trg_Virulent_Plague_Begin, function Trig_Virulent_Plague_Begin_Actions )
endfunction


//===========================================================================
// Trigger: Virulent Plague Active
//===========================================================================
function Trig_Virulent_Plague_Active_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A03J' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Virulent_Plague_Active_Func013C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'U036' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Virulent_Plague_Active_Func028C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'U03A' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Virulent_Plague_Active_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    call TriggerExecute( gg_trg_Firelords_Helper)
    call PlaySoundOnUnitBJ( gg_snd_ArtilleryCorpseExplodeDeath101, 100.00, GetSpellAbilityUnit() )
    // Dummy Stats
    call SetPlagueDummyStats()
    // Move the Unit
    set udg_Temp_Unit = gg_unit_e00H_2048
    call SetUnitOwner( udg_Temp_Unit, GetOwningPlayer(GetTriggerUnit()), true )
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    call SetUnitPositionLocFacingBJ( udg_Temp_Unit, udg_Temp_Unit_Point, GetUnitFacing(GetTriggerUnit()) )
    call RemoveLocation (udg_Temp_Unit_Point)
    // Set Abil Lvl
    if ( Trig_Virulent_Plague_Active_Func013C() ) then
        set udg_Temp_Int = 8
    else
        set udg_Temp_Int = 2
    endif
    call SetUnitAbilityLevelSwapped( 'A03H', udg_Temp_Unit, udg_Temp_Int )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A03H'), ABILITY_RLF_PRIMARY_DAMAGE, ( udg_Temp_Int - 1 ), udg_RealStatCalc )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A03H'), ABILITY_RLF_SECONDARY_DAMAGE, ( udg_Temp_Int - 1 ), udg_RealStatCalc )
    // Explosion Stats
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_HeroStatCalc = ( GetHeroStatBJ(bj_HEROSTAT_STR, GetTriggerUnit(), true) - GetHeroStatBJ(bj_HEROSTAT_STR, GetTriggerUnit(), false) )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    set udg_RealStatCalc = ( 4.00 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A03J', udg_Temp_Unit) * 100 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 14 ]  then
    set udg_RealStatCalc = ( udg_RealStatCalc * 1.30 )
    endif
    if ( Trig_Virulent_Plague_Active_Func028C() ) then
        call SpellUnits_ForEach( GetTriggerUnit(), udg_z_DK_UNHO_A, 40, 63, function SpreadPlague)
    else
        call SpellUnits_ForEach( GetTriggerUnit(), udg_z_DK_UNHO_H, 40, 63, function SpreadPlague)
    endif
endfunction

//===========================================================================
function InitTrig_Virulent_Plague_Active takes nothing returns nothing
    set gg_trg_Virulent_Plague_Active = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Virulent_Plague_Active, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Virulent_Plague_Active, Condition( function Trig_Virulent_Plague_Active_Conditions ) )
    call TriggerAddAction( gg_trg_Virulent_Plague_Active, function Trig_Virulent_Plague_Active_Actions )
endfunction

//===========================================================================
// Trigger: Deaths Grasp UD
//
// For use for Brothogg
//===========================================================================
function Trig_Deaths_Grasp_UD_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0DG' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'U036' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Deaths_Grasp_UD_Actions takes nothing returns nothing
    set udg_Temp_Int = 20
    set udg_A_DeathsGraspTarget[3] = GetSpellTargetUnit()
    set udg_Point_Charge_End[udg_Temp_Int] = GetUnitLoc(GetSpellAbilityUnit())
    set udg_Point_Charge_Begin[udg_Temp_Int] = GetUnitLoc(GetSpellTargetUnit())
    set udg_Chain_Target[5] = GetSpellTargetUnit()
    set udg_Charge_Distance = DistanceBetweenPoints(udg_Point_Charge_Begin[udg_Temp_Int], udg_Point_Charge_End[udg_Temp_Int])
    set udg_RealStatCalc = AngleBetweenPoints(udg_Point_Charge_Begin[udg_Temp_Int], udg_Point_Charge_End[udg_Temp_Int])
    set udg_Chain_Terminator_Unholy_UD = ( R2I(( udg_Charge_Distance / 50.00 )) - 1 )
    // Create Distance / 50 chains (1 ~ 10)
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = udg_Chain_Terminator_Unholy_UD
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Point_Charge_Begin[udg_Temp_Int], ( 50.00 * I2R(GetForLoopIndexA()) ), udg_RealStatCalc)
        call CreateNUnitsAtLocFacingLocBJ( 1, 'e024', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, udg_Point_Charge_End[udg_Temp_Int] )
        call RemoveLocation (udg_Temp_Polar_Point)
        set udg_Chain_Units_Unholy_UD[GetForLoopIndexA()] = GetLastCreatedUnit()
        call SetUnitVertexColorBJ( GetLastCreatedUnit(), 58.82, 19.60, 78.43, 12.00 )
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    // make wolf face angle
    call BlzSetUnitFacingEx( udg_A_DeathsGraspTarget[3], udg_RealStatCalc )
    // Turn on Every .05 sec
    call AddSpecialEffectTargetUnitBJ( "chest", udg_A_DeathsGraspTarget[3], "war3mapImported\\Psionic Shot Purple.mdx" )
    set udg_Charge_SE[udg_Temp_Int] = GetLastCreatedEffectBJ()
    set udg_i_Chain_Unholy_UD = 0
    call TriggerSleepAction( 0.28 )
    // playsound
    call EnableTrigger( gg_trg_Charge_Deaths_Grasp_UD)
endfunction

//===========================================================================
function InitTrig_Deaths_Grasp_UD takes nothing returns nothing
    set gg_trg_Deaths_Grasp_UD = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Deaths_Grasp_UD, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Deaths_Grasp_UD, Condition( function Trig_Deaths_Grasp_UD_Conditions ) )
    call TriggerAddAction( gg_trg_Deaths_Grasp_UD, function Trig_Deaths_Grasp_UD_Actions )
endfunction

//===========================================================================
// Trigger: Charge Deaths Grasp UD
//
// Set point position of chain
// Move Chain instantly Back to island
// then move wolf to point (if can be done)
// after charge loop iterations deal damage
//===========================================================================
function Trig_Charge_Deaths_Grasp_UD_Func001C takes nothing returns boolean
    if ( not ( udg_i_Chain_Unholy_UD <= udg_Chain_Terminator_Unholy_UD ) ) then
        return false
    endif
    return true
endfunction

function Trig_Charge_Deaths_Grasp_UD_Actions takes nothing returns nothing
    if ( Trig_Charge_Deaths_Grasp_UD_Func001C() ) then
        set udg_Temp_Unit_Point = GetUnitLoc(udg_Chain_Units_Unholy_UD[udg_i_Chain_Unholy_UD])
        call RemoveUnit( udg_Chain_Units_Unholy_UD[udg_i_Chain_Unholy_UD] )
        if not IsTerrainPathable( GetLocationX(udg_Temp_Unit_Point), GetLocationY(udg_Temp_Unit_Point), PATHING_TYPE_WALKABILITY) then
        call SetUnitPositionLoc( udg_A_DeathsGraspTarget[3], udg_Temp_Unit_Point )
        endif
        call RemoveLocation (udg_Temp_Unit_Point)
        set udg_i_Chain_Unholy_UD = ( udg_i_Chain_Unholy_UD + 1 )
    else
        set udg_Temp_Int = 20
        call RemoveLocation (udg_Point_Charge_Begin[udg_Temp_Int])
        call RemoveLocation (udg_Point_Charge_End[udg_Temp_Int])
        call DestroyEffectBJ( udg_Charge_SE[udg_Temp_Int] )
        set udg_Temp_Unit = udg_yH_Unholy_DK
        set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, false) ))
          call UnitDamageTargetBJ( udg_yH_Unholy_DK, udg_Chain_Target[5], ( 4.00 * udg_RealStatCalc ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        call DisableTrigger( GetTriggeringTrigger() )
    endif
endfunction

//===========================================================================
function InitTrig_Charge_Deaths_Grasp_UD takes nothing returns nothing
    set gg_trg_Charge_Deaths_Grasp_UD = CreateTrigger(  )
    call DisableTrigger( gg_trg_Charge_Deaths_Grasp_UD )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Charge_Deaths_Grasp_UD, 0.03 )
    call TriggerAddAction( gg_trg_Charge_Deaths_Grasp_UD, function Trig_Charge_Deaths_Grasp_UD_Actions )
endfunction

//===========================================================================
// Trigger: Deaths Grasp U HU
//
// For use for Brothogg
//===========================================================================
function Trig_Deaths_Grasp_U_HU_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0DG' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'U03A' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Deaths_Grasp_U_HU_Actions takes nothing returns nothing
    set udg_Temp_Int = 21
    set udg_A_DeathsGraspTarget[4] = GetSpellTargetUnit()
    set udg_Point_Charge_End[udg_Temp_Int] = GetUnitLoc(GetSpellAbilityUnit())
    set udg_Point_Charge_Begin[udg_Temp_Int] = GetUnitLoc(GetSpellTargetUnit())
    set udg_Chain_Target[6] = GetSpellTargetUnit()
    set udg_Charge_Distance = DistanceBetweenPoints(udg_Point_Charge_Begin[udg_Temp_Int], udg_Point_Charge_End[udg_Temp_Int])
    set udg_RealStatCalc = AngleBetweenPoints(udg_Point_Charge_Begin[udg_Temp_Int], udg_Point_Charge_End[udg_Temp_Int])
    set udg_Chain_Terminator_Unholy_HU = ( R2I(( udg_Charge_Distance / 50.00 )) - 1 )
    // Create Distance / 50 chains (1 ~ 10)
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = udg_Chain_Terminator_Unholy_HU
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Point_Charge_Begin[udg_Temp_Int], ( 50.00 * I2R(GetForLoopIndexA()) ), udg_RealStatCalc)
        call CreateNUnitsAtLocFacingLocBJ( 1, 'e024', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, udg_Point_Charge_End[udg_Temp_Int] )
        call RemoveLocation (udg_Temp_Polar_Point)
        set udg_Chain_Units_Unholy_HU[GetForLoopIndexA()] = GetLastCreatedUnit()
        call SetUnitVertexColorBJ( GetLastCreatedUnit(), 58.82, 19.60, 78.43, 12.00 )
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    // make wolf face angle
    call BlzSetUnitFacingEx( udg_A_DeathsGraspTarget[4], udg_RealStatCalc )
    // Turn on Every .05 sec
    call AddSpecialEffectTargetUnitBJ( "chest", udg_A_DeathsGraspTarget[4], "war3mapImported\\Psionic Shot Purple.mdx" )
    set udg_Charge_SE[21] = GetLastCreatedEffectBJ()
    set udg_i_Chain_Unholy_HU = 0
    call TriggerSleepAction( 0.28 )
    // playsound
    call EnableTrigger( gg_trg_Charge_Deaths_Grasp_U_HU)
endfunction

