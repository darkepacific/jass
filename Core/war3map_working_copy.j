function Trig_M_Lady_Waycrest_H_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 95
    local location udg_Temp_Unit_Point
    set udg_TempString = ""
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    set udg_TempString = udg_ExclamationMark
    endif
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Kill_Waycrest)
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, udg_TempString )
    call RemoveLocation (udg_Temp_Unit_Point)
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 1.60 )
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), 32.00 )
    call BlzSetSpecialEffectYaw( GetLastCreatedEffectBJ(), 1.50 )
    call BlzSetSpecialEffectColor( GetLastCreatedEffectBJ(), 255, 175, 140 )
    set udg_QuestMarks[95] = GetLastCreatedEffectBJ()
    set udg_TempString = "Using her dark magic, the Lady has corrupted this town and turned it into the Witch Wood. Kill the Queen of this coven."
    // Set Quest Rewards
    set udg_QUEST_XP[udg_Temp_Int] = 1000
    set udg_QUEST_GOLD[udg_Temp_Int] = 600
    set udg_QUEST_LVL_REQ[udg_Temp_Int] = udg_QUEST_ZONE_3_LVL_REQ
    call QuestRewards_TextSet(udg_Temp_Int)
    // End Set Quest Rewards
    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_860", udg_TempString, "ReplaceableTextures\\CommandButtons\\BTNBanshee.blp" )
    set udg_Quests[95] = GetLastCreatedQuestBJ()
    call QuestSetEnabledBJ( false, udg_Quests[95] )
    call EnableTrigger( gg_trg_S_Lady_Waycrest_H )
    set udg_Temp_Unit_Point = null
endfunction

