//===========================================================================
// Trigger: Smite
//===========================================================================
function Trig_Smite_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A02T' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Smite_Actions takes nothing returns nothing
    local unit udg_Temp_Unit = GetTriggerUnit()
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 3.00 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A02T', udg_Temp_Unit) * 45 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 20 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    // Whitemane Forked Smite-ling
    if udg_Temp_Unit == gg_unit_H01P_0467 then
    set udg_RealStatCalc = ( udg_RealStatCalc + 80.00 )
    call BlzSetAbilityIntegerLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A02T'), ABILITY_ILF_NUMBER_OF_TARGETS_HIT, ( GetUnitAbilityLevel(udg_Temp_Unit, GetSpellAbilityId()) - 1 ), 3 )
    endif
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A02T'), ABILITY_RLF_DAMAGE_PER_TARGET_OCL1, ( GetUnitAbilityLevel(udg_Temp_Unit, GetSpellAbilityId()) - 1 ), udg_RealStatCalc )
    set udg_Temp_Unit = null
    return
    return
    return
    // Forked Smite-ling
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 13 ]  then
    else
    call BlzSetAbilityIntegerLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A02T'), ABILITY_ILF_NUMBER_OF_TARGETS_HIT, ( GetUnitAbilityLevel(udg_Temp_Unit, GetSpellAbilityId()) - 1 ), 1 )
    endif
endfunction

//===========================================================================
function InitTrig_Smite takes nothing returns nothing
    set gg_trg_Smite = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Smite, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Smite, Condition( function Trig_Smite_Conditions ) )
    call TriggerAddAction( gg_trg_Smite, function Trig_Smite_Actions )
endfunction

//===========================================================================
// Trigger: Heal
//
// 
//===========================================================================
function Trig_Heal_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A00K' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Heal_Actions takes nothing returns nothing
    local unit target = GetSpellTargetUnit()
    local unit udg_Temp_Unit = GetTriggerUnit()
    if ( udg_Temp_Unit == udg_yA_Holy_Priest ) then
    set udg_o = udg_z_PR_HOLY_A
    elseif (  udg_Temp_Unit == udg_yH_Holy_Priest ) then
    set udg_o = udg_z_PR_HOLY_H
    endif
    set udg_o = ( udg_o + 4 )
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 5 ]  then
    set udg_SpellUnits[udg_o] = udg_SpellUnits[udg_o+1]
    else
    set udg_SpellUnits[udg_o] = null
    endif
    set udg_SpellUnits[udg_o+1] = target
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 3.00 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A00K', udg_Temp_Unit) * 55 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 10 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    call ChaliceSet()
    // Greater Heal
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 4 ]  then
    set udg_RealStatCalc = ( 1.35 * udg_RealStatCalc )
    endif
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A00K'), ABILITY_RLF_HIT_POINTS_GAINED_HEA1, ( GetUnitAbilityLevel(udg_Temp_Unit, GetSpellAbilityId()) - 1 ), udg_RealStatCalc )
    // Renew
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 13 ]  then
    call Debug("Renew Fired")
    set udg_RealStatCalc = ( 0.25 * udg_RealStatCalc )
    call SetUnitOwner( gg_unit_e028_1863, GetOwningPlayer( udg_Temp_Unit ), true )
    call SetUnitAbilityLevel( gg_unit_e028_1863, 'ACrj', 2 )
     call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility( gg_unit_e028_1863, 'ACrj' ), ABILITY_RLF_HIT_POINTS_GAINED_REJ1, 1, udg_RealStatCalc )
    call IssueTargetOrderBJ( gg_unit_e028_1863, "rejuvination", target )
    endif
    // Mana
    call GameTimeWait( 0.2)
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 5 ]  then
    if udg_SpellUnits[udg_o] == udg_SpellUnits[udg_o+1] then
                set udg_SpellUnits[udg_o+1] = null
                call MaxManaRestore( 0.08, target )
                call AddSpecialEffectTargetUnitBJ( "origin", target, "Abilities\\Spells\\Items\\AIre\\AIreTarget.mdl")
                call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    endif
    endif
    set target = null
    set udg_Temp_Unit = null
endfunction

//===========================================================================
function InitTrig_Heal takes nothing returns nothing
    set gg_trg_Heal = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Heal, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Heal, Condition( function Trig_Heal_Conditions ) )
    call TriggerAddAction( gg_trg_Heal, function Trig_Heal_Actions )
endfunction

//===========================================================================
// Trigger: Holy Nova
//===========================================================================
function Trig_Holy_Nova_Func001C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A08W' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0FO' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Holy_Nova_Conditions takes nothing returns boolean
    if ( not Trig_Holy_Nova_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Holy_Nova_Func009C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A08W' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Holy_Nova_Func011C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 11) > 5 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Holy_Nova_Func044A takes nothing returns nothing
    if IsUnitTargetableEnemyGround( GetEnumUnit(), udg_Temp_Unit ) then
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), ( 3.00 * udg_RealStatCalc ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "Abilities\\Spells\\Orc\\EtherealForm\\SpiritWalkerChange.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call HasFirelords( GetEnumUnit() )
    elseif IsUnitTargetableAllyParams( GetEnumUnit(), udg_Temp_Unit, true, true, true, false) then
    call SetUnitLifeBJ( GetEnumUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetEnumUnit()) + ( ( 1.00 * udg_RealStatCalc ) + I2R(udg_HeroStatCalc) ) ) )
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    endif
endfunction

function Trig_Holy_Nova_Actions takes nothing returns nothing
    local location Target
    local real RSC
    local integer p
    local integer heroNumb
    local boolean f
    local boolean r
    local boolean heroSkill = false
    if ( Trig_Holy_Nova_Func009C() ) then
        set heroSkill = true
    else
    endif
    set udg_Temp_Unit = GetTriggerUnit()
    if ( Trig_Holy_Nova_Func011C() ) then
        call StopSoundBJ( gg_snd_HolyNova_Cast_01, false )
        call PlaySoundOnUnitBJ( gg_snd_HolyNova_Cast_01, 95.00, udg_Temp_Unit )
    else
        call StopSoundBJ( gg_snd_HolyNova_Cast_03, false )
        call PlaySoundOnUnitBJ( gg_snd_HolyNova_Cast_03, 95.00, udg_Temp_Unit )
    endif
    call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    set Target = udg_Temp_Unit_Point
    set RSC = udg_RealStatCalc
    set p = udg_Player_Number
    set f = udg_hasFirelords
    set r = udg_hasReaper
    call TriggerSleepAction( 0.20 )
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_Temp_Unit_Point = Target
    set udg_RealStatCalc = RSC
    set udg_Player_Number = p
    set udg_hasFirelords = f
    set udg_hasReaper = r
    if heroSkill then
    set udg_HeroStatCalc = ( 60 * GetUnitAbilityLevelSwapped('A08W', GetTriggerUnit()) )
    set udg_Temp_Int = ( 350 + ( 10 * GetUnitAbilityLevelSwapped('A08W', GetTriggerUnit()) ) )
    else
    set udg_HeroStatCalc = ( 60 * GetUnitAbilityLevelSwapped('A0FO', GetTriggerUnit()) )
    set udg_Temp_Int = ( 350 + ( 10 * GetUnitAbilityLevelSwapped('A0FO', GetTriggerUnit()) ) )
    endif
    set udg_HeroStatCalc = ( udg_HeroStatCalc / 3 )
    if ChaliceCheck() then
    set udg_HeroStatCalc = R2I(( I2R(udg_HeroStatCalc) * ( 1.00 + udg_CHALICE_HEAL ) ))
    endif
    //whitemane buffs
    if udg_Temp_Unit == gg_unit_H01P_0467 then
    set udg_RealStatCalc = ( udg_RealStatCalc + 100.00 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 100 )
    endif
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(I2R(udg_Temp_Int), udg_Temp_Unit_Point), function Trig_Holy_Nova_Func044A )
    call RemoveLocation (udg_Temp_Unit_Point)
    set Target = null
endfunction

//===========================================================================
function InitTrig_Holy_Nova takes nothing returns nothing
    set gg_trg_Holy_Nova = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Holy_Nova, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Holy_Nova, Condition( function Trig_Holy_Nova_Conditions ) )
    call TriggerAddAction( gg_trg_Holy_Nova, function Trig_Holy_Nova_Actions )
