function InitTrig_Cone_of_Cold takes nothing returns nothing
    set gg_trg_Cone_of_Cold = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Cone_of_Cold, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Cone_of_Cold, Condition( function Trig_Cone_of_Cold_Conditions ) )
    call TriggerAddAction( gg_trg_Cone_of_Cold, function Trig_Cone_of_Cold_Actions )
endfunction

