function Trig_Firelords_Burn_and_Arcanite_Actions takes nothing returns nothing
    local boolean needsWait = false
    local boolean needsTick = false
    local boolean needsUnit = false
    local boolean hasFirelords = false
    local boolean hasReaper = false
    local real AoE
    local integer p
    local location Target
    set udg_Player_Number = 99
    set udg_hasReaper = false
    set udg_hasFirelords = false
    set bj_forLoopAIndex = 0
    set bj_forLoopAIndexEnd = 7
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_Firelords_Burn_and_Arcanite_Func036Func001C() ) then
            if ( Trig_Firelords_Burn_and_Arcanite_Func036Func001Func001C() ) then
                set udg_hasFirelords = true
            else
            endif
            if ( Trig_Firelords_Burn_and_Arcanite_Func036Func001Func002C() ) then
                set udg_hasReaper = true
            else
            endif
            set udg_Player_Number = GetForLoopIndexA()
            exitwhen true
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    call logFirelords()
    if ( Trig_Firelords_Burn_and_Arcanite_Func038C() ) then
        // Initial Targets Hit by spells will burn for 8% of there maxium health. Initial targets include those directly targeted by a spell or within the starting area of an AOE cast.
        // AOE Spells
        set udg_RealStatCalc = 0.00
        // Path of Frost
        if ( Trig_Firelords_Burn_and_Arcanite_Func038Func006C() ) then
            set udg_Temp_Unit_Point = GetSpellTargetLoc()
            set udg_RealStatCalc = 280.00
            set needsWait = true
        else
        endif
        // Dragon's Breath
        if ( Trig_Firelords_Burn_and_Arcanite_Func038Func008C() ) then
            set udg_Temp_Polar_Point = GetUnitLoc(GetTriggerUnit())
            set udg_Temp_Unit_Point = PolarProjectionBJ(udg_Temp_Polar_Point, 325.00, GetUnitFacing(GetTriggerUnit()))
            call RemoveLocation (udg_Temp_Polar_Point)
            set udg_RealStatCalc = 315.00
            set needsWait = true
        else
        endif
        // Breath of Fire
        if ( Trig_Firelords_Burn_and_Arcanite_Func038Func010C() ) then
            set udg_Temp_Polar_Point = GetUnitLoc(GetTriggerUnit())
            set udg_Temp_Unit_Point = PolarProjectionBJ(udg_Temp_Polar_Point, 200.00, GetUnitFacing(GetTriggerUnit()))
            call RemoveLocation (udg_Temp_Polar_Point)
            set udg_RealStatCalc = 250.00
            set needsWait = true
        else
        endif
        // Haunting Wave
        if ( Trig_Firelords_Burn_and_Arcanite_Func038Func012C() ) then
            set udg_RealStatCalc = 290.00
            set udg_Temp_Polar_Point = GetUnitLoc(GetTriggerUnit())
            set udg_Temp_Unit_Point = PolarProjectionBJ(udg_Temp_Polar_Point, 280.00, GetUnitFacing(GetTriggerUnit()))
            call RemoveLocation (udg_Temp_Polar_Point)
        else
        endif
        // Heroic Leap
        if ( Trig_Firelords_Burn_and_Arcanite_Func038Func014C() ) then
            set udg_Temp_Unit_Point = GetSpellTargetLoc()
            set udg_RealStatCalc = BlzGetAbilityRealLevelField(BlzGetUnitAbility(udg_Heroes[udg_Player_Number], 'A04K'), ABILITY_RLF_AREA_OF_EFFECT, ( GetUnitAbilityLevelSwapped('A04K', GetTriggerUnit()) - 1 ))
            set udg_RealStatCalc = 185.00
            set needsWait = true
        else
        endif
        // Bladestorm
        if ( Trig_Firelords_Burn_and_Arcanite_Func038Func016C() ) then
            set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
            set udg_RealStatCalc = BlzGetAbilityRealLevelField(BlzGetUnitAbility(udg_Heroes[udg_Player_Number], 'A02H'), ABILITY_RLF_AREA_OF_EFFECT, ( GetUnitAbilityLevelSwapped('A02H', GetTriggerUnit()) - 1 ))
            set needsTick = true
            set needsUnit = true
        else
        endif
        // Earthquake
        if ( Trig_Firelords_Burn_and_Arcanite_Func038Func018C() ) then
            set udg_Temp_Unit_Point = GetSpellTargetLoc()
            set udg_RealStatCalc = BlzGetAbilityRealLevelField(BlzGetUnitAbility(udg_Heroes[udg_Player_Number], 'AOeq'), ABILITY_RLF_AREA_OF_EFFECT, ( GetUnitAbilityLevelSwapped('AOeq', GetTriggerUnit()) - 1 ))
            set needsTick = true
        else
        endif
        // Blizzard
        if ( Trig_Firelords_Burn_and_Arcanite_Func038Func020C() ) then
            set udg_Temp_Unit_Point = GetSpellTargetLoc()
            set udg_RealStatCalc = BlzGetAbilityRealLevelField(BlzGetUnitAbility(udg_Heroes[udg_Player_Number], 'A01Z'), ABILITY_RLF_AREA_OF_EFFECT, ( GetUnitAbilityLevelSwapped('A01Z', GetTriggerUnit()) - 1 ))
            set needsWait = true
        else
        endif
        // ------------
        set hasFirelords = udg_hasFirelords
        set hasReaper = udg_hasReaper
        // AOE Damage
        // WAIT if necessary
        if needsWait == true then
        set AoE = udg_RealStatCalc
        set Target = udg_Temp_Unit_Point
        set p = udg_Player_Number
        call TriggerSleepAction( 0.25 )
        set udg_RealStatCalc = AoE
        set udg_Temp_Unit_Point = Target
        set udg_Player_Number = p
        set udg_hasFirelords = hasFirelords
        set udg_hasReaper = hasReaper
        endif
        if ( Trig_Firelords_Burn_and_Arcanite_Func038Func037C() ) then
            set udg_RealStatCalc = ( udg_RealStatCalc + 10.00 )
            set bj_wantDestroyGroup = true
            call ForGroupBJ( GetUnitsInRangeOfLocAll(udg_RealStatCalc, udg_Temp_Unit_Point), function Trig_Firelords_Burn_and_Arcanite_Func038Func037Func004A )
            call RemoveLocation (udg_Temp_Unit_Point)
        else
        endif
        // TICK for Moving AoE
        if needsTick == true then
        set AoE = udg_RealStatCalc
        set udg_Temp_Unit_Point = GetSpellTargetLoc()
        set Target = udg_Temp_Unit_Point
        set p = udg_Player_Number
        call TriggerSleepAction( 0.55 )
        set udg_RealStatCalc = AoE
        set udg_Temp_Unit_Point = Target
        set udg_hasFirelords = hasFirelords
        set udg_hasReaper = hasReaper
        if needsUnit == true then
        call RemoveLocation (udg_Temp_Unit_Point)
        set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
        endif
        set udg_Player_Number = p
        endif
        if ( Trig_Firelords_Burn_and_Arcanite_Func038Func055C() ) then
            set udg_RealStatCalc = ( udg_RealStatCalc + 10.00 )
            set bj_wantDestroyGroup = true
            call ForGroupBJ( GetUnitsInRangeOfLocAll(udg_RealStatCalc, udg_Temp_Unit_Point), function Trig_Firelords_Burn_and_Arcanite_Func038Func055Func004A )
            call RemoveLocation (udg_Temp_Unit_Point)
        else
        endif
        // ------------
        // ------------
        // Single Target Spells
        if ( Trig_Firelords_Burn_and_Arcanite_Func038Func059C() ) then
            set udg_Temp_Unit = GetSpellTargetUnit()
            // Single Target Delay
            if ( Trig_Firelords_Burn_and_Arcanite_Func038Func059Func003C() ) then
                set udg_SpellUnits[( 4032 + udg_Player_Number )] = udg_Temp_Unit
                set p = udg_Player_Number
                if ( Trig_Firelords_Burn_and_Arcanite_Func038Func059Func003Func003C() ) then
                    call TriggerSleepAction( 1.00 )
                else
                endif
                call TriggerSleepAction( 0.25 )
                set udg_Player_Number = p
                set udg_Temp_Unit = udg_SpellUnits[ 4032 + p ] 
            else
            endif
            // Single Target Damage
            if ( Trig_Firelords_Burn_and_Arcanite_Func038Func059Func005C() ) then
                call HasFirelords( udg_Temp_Unit )
            else
            endif
        else
        endif
    else
    endif
    set Target = null
endfunction

