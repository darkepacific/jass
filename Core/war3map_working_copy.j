//===========================================================================
// Trigger: SMASHED
//===========================================================================
function Trig_SMASHED_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'e03F' ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetTriggerUnit()) == Player(PLAYER_NEUTRAL_AGGRESSIVE) ) ) then
        return false
    endif
    return true
endfunction

function Trig_SMASHED_Func019Func001Func017C takes nothing returns boolean
    if ( not ( IsUnitInGroup(GetEnumUnit(), udg_KnockBacks) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_SMASHED_Func019Func001C takes nothing returns boolean
    if ( not ( IsUnitEnemy(GetEnumUnit(), Player(PLAYER_NEUTRAL_AGGRESSIVE)) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_MECHANICAL) == false ) ) then
        return false
    endif
    if ( not ( BlzIsUnitInvulnerable(GetEnumUnit()) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_SMASHED_Func019A takes nothing returns nothing
    if ( Trig_SMASHED_Func019Func001C() ) then
        set udg_RealStatCalc = GetUnitStateSwap(UNIT_STATE_MAX_LIFE, GetEnumUnit())
        set udg_RealStatCalc = ( 0.20 * udg_RealStatCalc )
        call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL )
        // mvmnt
        set udg_Temp_Polar_Point = GetUnitLoc(GetEnumUnit())
        set udg_Charge_Distance = DistanceBetweenPoints(udg_Temp_Unit_Point, udg_Temp_Polar_Point)
        set udg_RealStatCalc = AngleBetweenPoints(udg_Temp_Unit_Point, udg_Temp_Polar_Point)
        set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, ( 355.00 - udg_Charge_Distance ), udg_RealStatCalc)
        if not IsTerrainPathable( GetLocationX(udg_Temp_Unit_Point), GetLocationY(udg_Temp_Unit_Point), PATHING_TYPE_WALKABILITY) then
        call SetUnitPositionLoc( GetEnumUnit(), udg_Temp_Unit_Point )
        endif
        call RemoveLocation (udg_Temp_Polar_Point)
        // KnockBackLoop Turn ON
        call UnitAddAbilityBJ( 'Amrf', GetEnumUnit() )
        call UnitRemoveAbilityBJ( 'Amrf', GetEnumUnit() )
        call SetUnitFlyHeightBJ( GetEnumUnit(), 135.00, 0.00 )
        if ( Trig_SMASHED_Func019Func001Func017C() ) then
            call GroupAddUnitSimple( GetEnumUnit(), udg_KnockBacks )
        else
            call FlushChildHashtableBJ( GetHandleIdBJ(GetEnumUnit()), udg_KnockBacksHash )
        endif
        call SaveRealBJ( udg_RealStatCalc, 0, GetHandleIdBJ(GetEnumUnit()), udg_KnockBacksHash )
        call SaveRealBJ( 4.00, 1, GetHandleIdBJ(GetEnumUnit()), udg_KnockBacksHash )
        call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    else
    endif
endfunction

function Trig_SMASHED_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    call DisableTrigger( GetTriggeringTrigger() )
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Judgement NoHive.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 0.55 )
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    call PlaySoundAtPointBJ( gg_snd_Sulfuras_Impact_01, 70.00, udg_Temp_Unit_Point, 0 )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Conflagrate.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call RemoveLocation (udg_Temp_Unit_Point)
    call IssueImmediateOrderBJ( GetTriggerUnit(), "stomp" )
    call IssueImmediateOrderBJ( GetAttacker(), "stop" )
    // oldwait
    set udg_Temp_Unit = gg_unit_Nfir_1988
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(230.00, udg_Temp_Unit_Point), function Trig_SMASHED_Func019A )
    call EnableTrigger( gg_trg_KnockBackLoop)
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 1.00 )
    call EnableTrigger( GetTriggeringTrigger() )
    set udg_Temp_Unit_Point = null
endfunction

