function Trig_M_POL_A_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 166
    set udg_TempString = "Polar bears roam the frozen wilds of Northrend, threatening travelers and camps alike. Cull their numbers to make the region safer to cross."
