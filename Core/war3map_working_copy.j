                    call SetUnitLifeBJ(udg_SpellUnits[udg_o], GetUnitState( udg_SpellUnits[udg_o], UNIT_STATE_LIFE) + udg_RealStatCalc )
                    call PenanceHealSound(i, modulo, SOUND_VOL)
                    //call AddAtonement
