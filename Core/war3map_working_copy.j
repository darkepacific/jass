//
// Need to change this to team wide display.
//===========================================================================
function Trig_S_PA_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    local effect eff1
                       if IsHordeHero( GetTriggerUnit() ) then
    set udg_TempString = "Proving Alliegance"
    set udg_TempString_Quest = "Take a candle, place it on Lilith's Grave and kill her."
    call TriggerExecute( gg_trg_Quest_Start_H )
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    call QuestSetEnabledBJ( true, udg_Quests[39] )
    call FlashQuestDialogButtonBJ(  )
    endif
    call DestroyEffectBJ( udg_QuestMarks[39] )
    call CreateQuestItemBJ( udg_Quests[39], "TRIGSTR_4840" )
    call QuestMessageBJ( udg_HordePlayers, bj_QUESTMESSAGE_ALWAYSHINT, "TRIGSTR_275" )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Candle_of_Beckoning_Spawn)
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "LootEFFECT.mdx" )
    set eff1 = GetLastCreatedEffectBJ()
    call CampaignMinimapIconLocBJ( udg_Temp_Unit_Point, bj_CAMPPINGSTYLE_CONTROL_NEUTRAL )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_MiniMapIcon[39] = GetLastCreatedMinimapIcon()
    call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), false )
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), true )
    endif
    call DisableTrigger( GetTriggeringTrigger() )
    call EnableTrigger( gg_trg_U_PA )
    call EnableTrigger( gg_trg_U_PA_Acq )
    call EnableTrigger( gg_trg_E_PA )
    call TriggerSleepAction( 6.00 )
    call DestroyEffectBJ( eff1 )
                       endif
    set eff1 = null
    set udg_Temp_Unit_Point = null
endfunction

