function Trig_Firelords_Burn_Attack_Reaper_Func014C takes nothing returns boolean
    if ( not ( udg_Player_Number != 99 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Firelords_Burn_Attack_Reaper_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetAttacker()
    set udg_Player_Number = 99
    set udg_hasReaper = false
    set udg_hasFirelords = false
    set bj_forLoopAIndex = 0
    set bj_forLoopAIndexEnd = 7
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_Firelords_Burn_Attack_Reaper_Func013Func001C() ) then
            if ( Trig_Firelords_Burn_Attack_Reaper_Func013Func001Func002C() ) then
                set udg_hasFirelords = true
            else
            endif
            if ( Trig_Firelords_Burn_Attack_Reaper_Func013Func001Func003C() ) then
                set udg_hasReaper = true
            else
            endif
            set udg_Player_Number = GetForLoopIndexA()
            exitwhen true
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    if ( Trig_Firelords_Burn_Attack_Reaper_Func014C() ) then
        set udg_Temp_Unit = GetAttackedUnitBJ()
        if ( Trig_Firelords_Burn_Attack_Reaper_Func014Func002C() ) then
            if ( Trig_Firelords_Burn_Attack_Reaper_Func014Func002Func001C() ) then
                call GroupAddUnitSimple( GetTriggerUnit(), udg_PX_Firelords[udg_Player_Number] )
                call SetUnitUserData( GetTriggerUnit(), ( udg_Player_Number * 5 ) )
                call EnableTrigger( gg_trg_Firelords_Burn_Tick )
            else
            endif
            if ( Trig_Firelords_Burn_Attack_Reaper_Func014Func002Func002C() ) then
                call ArmorDebuff( udg_Temp_Unit )
            else
            endif
        else
        endif
        if ( Trig_Firelords_Burn_Attack_Reaper_Func014Func004C() ) then
            set udg_RealStatCalc = BlzGetUnitArmor(GetTriggerUnit())
            set udg_RealStatCalc = ( I2R(BlzGetUnitWeaponIntegerField(GetAttacker(), UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 0)) / ( 1 + ( udg_RealStatCalc * 0.06 ) ) )
            set udg_RealStatCalc = ( 0.80 * udg_RealStatCalc )
            set udg_RealStatCalc = ( udg_CHALICE_HEAL * udg_RealStatCalc )
            set udg_RealStatCalc =  GetUnitState(udg_Heroes[udg_Player_Number], UNIT_STATE_LIFE ) + udg_RealStatCalc
            call SetUnitState(udg_Heroes[udg_Player_Number], UNIT_STATE_LIFE, udg_RealStatCalc )
        else
        endif
    else
    endif
endfunction

//===========================================================================
function InitTrig_Firelords_Burn_Attack_Reaper takes nothing returns nothing
    set gg_trg_Firelords_Burn_Attack_Reaper = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Firelords_Burn_Attack_Reaper, EVENT_PLAYER_UNIT_ATTACKED )
    call TriggerAddCondition( gg_trg_Firelords_Burn_Attack_Reaper, Condition( function Trig_Firelords_Burn_Attack_Reaper_Conditions ) )
    call TriggerAddAction( gg_trg_Firelords_Burn_Attack_Reaper, function Trig_Firelords_Burn_Attack_Reaper_Actions )
endfunction

