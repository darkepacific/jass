//
// Need to change this to team wide display.
//===========================================================================
function Trig_S_AUM_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
                       if IsHordeHero( GetTriggerUnit() ) then
    set udg_TempString = "An Urgent Matter"
    set udg_TempString_Quest = "Deliver the letter to the Bulwark."
    call TriggerExecute( gg_trg_Quest_Start_H )
    set udg_TempString = ""
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    set udg_TempString = udg_QuestionMark
    call QuestSetEnabledBJ( true, udg_Quests[42] )
    call FlashQuestDialogButtonBJ(  )
    endif
    call DestroyEffectBJ( udg_QuestMarks[42] )
    call AddSpecialEffectTargetUnitBJ( "overhead", gg_unit_ogrk_1720, udg_TempString )
    set udg_QuestMarks[42] = GetLastCreatedEffectBJ()
    call QuestSetCompletedBJ( udg_Quests[42], false )
    call CreateQuestItemBJ( udg_Quests[42], "TRIGSTR_5004" )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Garthok)
    call CampaignMinimapIconLocBJ( udg_Temp_Unit_Point, bj_CAMPPINGSTYLE_TURNIN )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_MiniMapIcon[42] = GetLastCreatedMinimapIcon()
    call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), false )
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), true )
    endif
    call UnitAddItemByIdSwapped( 'I05K', GetTriggerUnit() )
    call DisableTrigger( GetTriggeringTrigger() )
    call EnableTrigger( gg_trg_E_AUM )
    call TriggerSleepAction( 10.00 )
    call EnableTrigger( gg_trg_L_AUM )
                       endif
    set udg_Temp_Unit_Point = null
endfunction

//===========================================================================
function InitTrig_S_AUM takes nothing returns nothing
    set gg_trg_S_AUM = CreateTrigger(  )
    call DisableTrigger( gg_trg_S_AUM )
    call TriggerRegisterEnterRectSimple( gg_trg_S_AUM, gg_rct_A_Letter_to_Garthok )
    call TriggerRegisterUnitInRangeSimple( gg_trg_S_AUM, 256, gg_unit_n00D_0372 )
    call TriggerAddAction( gg_trg_S_AUM, function Trig_S_AUM_Actions )
endfunction

//===========================================================================
// Trigger: L AUM
//===========================================================================
function Trig_L_AUM_Func006Func001C takes nothing returns boolean
    if ( not ( GetItemTypeId(udg_P_Items[( udg_Bag_Num + udg_Bag_Iterator )]) == udg_ItemTypeCheck ) ) then
        return false
    endif
    return true
endfunction

function Trig_L_AUM_Func018C takes nothing returns boolean
    if ( not ( IsTriggerEnabled(gg_trg_E_AUM) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_L_AUM_Actions takes nothing returns nothing
    local boolean hasItem
                       if IsHordeHero( GetTriggerUnit() ) then
    set hasItem = false
    call SetBagNumber( GetOwningPlayer(GetTriggerUnit()) )
    set udg_ItemTypeCheck = 'I05K'
    set udg_Bag_Iterator = 1
    loop
        exitwhen udg_Bag_Iterator > udg_BAG_LOOP_MAX
        if ( Trig_L_AUM_Func006Func001C() ) then
            set hasItem = true
        else
        endif
        set udg_Bag_Iterator = udg_Bag_Iterator + 1
    endloop
    if hasItem == false then
    call CreateTextTagUnitBJ( "TRIGSTR_5005", gg_unit_n00D_0372, 0, 8.00, 80.00, 0.00, 0.00, 0 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
    call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
    call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 1.25 )
    call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 0.85 )
    call UnitAddItemByIdSwapped( 'I05K', GetTriggerUnit() )
    call DisableTrigger( GetTriggeringTrigger() )
    call TriggerSleepAction( udg_ITEM_LOSS_TIMEOUT )
    if ( Trig_L_AUM_Func018C() ) then
        call EnableTrigger( GetTriggeringTrigger() )
    else
    endif
    endif
                       endif
endfunction

//===========================================================================
function InitTrig_L_AUM takes nothing returns nothing
    set gg_trg_L_AUM = CreateTrigger(  )
    call DisableTrigger( gg_trg_L_AUM )
    call TriggerRegisterEnterRectSimple( gg_trg_L_AUM, gg_rct_A_Letter_to_Garthok )
    call TriggerRegisterUnitInRangeSimple( gg_trg_L_AUM, 256, gg_unit_n00D_0372 )
    call TriggerAddAction( gg_trg_L_AUM, function Trig_L_AUM_Actions )
endfunction

//===========================================================================
// Trigger: E AUM
//===========================================================================
function Trig_E_AUM_Func005Func001C takes nothing returns boolean
    if ( not ( GetItemTypeId(udg_P_Items[( udg_Bag_Num + udg_Bag_Iterator )]) == udg_ItemTypeCheck ) ) then
        return false
    endif
    return true
endfunction

function Trig_E_AUM_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 42
                       if IsHordeHero( GetTriggerUnit() ) then
    call SetBagNumber( GetOwningPlayer(GetTriggerUnit()) )
    set udg_ItemTypeCheck = 'I05K'
    set udg_Bag_Iterator = 1
    loop
        exitwhen udg_Bag_Iterator > udg_BAG_LOOP_MAX
        if ( Trig_E_AUM_Func005Func001C() ) then
            call DisableTrigger( gg_trg_L_AUM )
            call DisableTrigger( GetTriggeringTrigger() )
            if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
            call FlashQuestDialogButtonBJ(  )
            endif
            call QuestItemSetCompletedBJ( udg_QuestReqs[42], true )
            call QuestSetCompletedBJ( udg_Quests[42], true )
            call DestroyEffectBJ( udg_QuestMarks[42] )
            call DestroyMinimapIcon( udg_MiniMapIcon[42] )
            // Clean Up Items
            call CleanUpItems( udg_ItemTypeCheck )
            // Rewards
            set udg_XP = udg_QUEST_XP[udg_Temp_Int]
            set udg_Gold = udg_QUEST_GOLD[udg_Temp_Int]
            set udg_LVL_Req = udg_QUEST_LVL_REQ[udg_Temp_Int]
            set udg_TempString = "An Urgent Matter"
            call TriggerExecute( gg_trg_Quest_Complete_H )
            call CreateTextTagUnitBJ( "TRIGSTR_9487", gg_unit_ogrk_1720, 0, 8.00, 100.00, 100.00, 60.00, 0 )
            call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
            call cleanUpText( 1.35, 0.95 )
            return
        else
        endif
        set udg_Bag_Iterator = udg_Bag_Iterator + 1
    endloop
                       endif
endfunction

//===========================================================================
function InitTrig_E_AUM takes nothing returns nothing
    set gg_trg_E_AUM = CreateTrigger(  )
    call DisableTrigger( gg_trg_E_AUM )
    call TriggerRegisterEnterRectSimple( gg_trg_E_AUM, gg_rct_Garthok )
    call TriggerRegisterUnitInRangeSimple( gg_trg_E_AUM, 256, gg_unit_ogrk_1720 )
    call TriggerAddAction( gg_trg_E_AUM, function Trig_E_AUM_Actions )
endfunction

//===========================================================================
// Trigger: M Trouble at Azurelode 92
//===========================================================================
function Trig_M_Trouble_at_Azurelode_92_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 92
    set udg_TempString = ""
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    set udg_TempString = udg_ExclamationMark
    endif
    call AddSpecialEffectTargetUnitBJ( "overhead", gg_unit_uktg_0766, udg_TempString )
    set udg_QuestMarks[92] = GetLastCreatedEffectBJ()
    set udg_TempString = "The Alliance control Azurelode mine to the south. It's resources would prove valuable to us. Slay any humans you find there. Once they are all dead we shall raise their forces as our own."
    // Set Quest Rewards
    set udg_QUEST_XP[udg_Temp_Int] = 650
    set udg_QUEST_GOLD[udg_Temp_Int] = 300
    set udg_QUEST_LVL_REQ[udg_Temp_Int] = udg_QUEST_ZONE_3_LVL_REQ
    call QuestRewards_TextSet(udg_Temp_Int)
    // End Set Quest Rewards
    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_1557", udg_TempString, "ReplaceableTextures\\CommandButtons\\BTNGoldMine.blp" )
    set udg_Quests[92] = GetLastCreatedQuestBJ()
    call QuestSetEnabledBJ( false, GetLastCreatedQuestBJ() )
    call EnableTrigger( gg_trg_S_TaA )
endfunction

//===========================================================================
function InitTrig_M_Trouble_at_Azurelode_92 takes nothing returns nothing
    set gg_trg_M_Trouble_at_Azurelode_92 = CreateTrigger(  )
    call TriggerAddAction( gg_trg_M_Trouble_at_Azurelode_92, function Trig_M_Trouble_at_Azurelode_92_Actions )
endfunction

