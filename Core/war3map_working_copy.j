//===========================================================================
function Trig_Doom_Dies_UD_Conditions takes nothing returns boolean
    if ( not ( GetTriggerUnit() == udg_SpellUnits[( udg_z_WL_DEMO_H + 8 )] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Doom_Dies_UD_Actions takes nothing returns nothing
    local unit udg_Temp_Unit
    local location udg_Temp_Unit_Point
    set udg_Temp_Unit = udg_yH_Demon_Warlock
    set udg_Temp_Unit_Point = GetUnitLoc(GetDyingUnit())
    // Create Doomguard
     if (  GetUnitAbilityLevelSwapped('A02F', udg_Temp_Unit) == 1  ) then
    call CreateNUnitsAtLoc( 1, 'n03Q', GetOwningPlayer(udg_Temp_Unit), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
    call UnitApplyTimedLifeBJ( 20.50, 'BTLF', GetLastCreatedUnit() )
      elseif (  GetUnitAbilityLevelSwapped('A02F', udg_Temp_Unit) == 1  ) then
    call CreateNUnitsAtLoc( 1, 'n02M', GetOwningPlayer(udg_Temp_Unit), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
    call UnitApplyTimedLifeBJ( 22.50, 'BTLF', GetLastCreatedUnit() )
    else
    call CreateNUnitsAtLoc( 1, 'n03P', GetOwningPlayer(udg_Temp_Unit), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
    call UnitApplyTimedLifeBJ( 25.00, 'BTLF', GetLastCreatedUnit() )
    endif
    call RemoveLocation (udg_Temp_Unit_Point)
    call SetUnitAbilityLevelSwapped( 'A07M', GetLastCreatedUnit(), ( GetUnitLevel(GetLastCreatedUnit()) / 15 ) )
    set udg_Temp_Unit = null
    set udg_Temp_Unit_Point = null
endfunction

