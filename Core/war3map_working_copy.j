function Trig_U_BFF_H_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 73
                       if IsHordeHero( GetTriggerUnit() ) then
    if ( Trig_U_BFF_H_Func005C() ) then
        set udg_ItemTypeCheck = 'I07K'
        set udg_ItemQuestNumber = ( I2R(udg_Temp_Int) + 0.10 )
        call TriggerExecute( gg_trg_ABag_Check )
    else
    endif
    if ( Trig_U_BFF_H_Func006C() ) then
        set udg_ItemTypeCheck = 'I07J'
        set udg_ItemQuestNumber = ( I2R(udg_Temp_Int) + 0.20 )
        call TriggerExecute( gg_trg_ABag_Check )
    else
    endif
    if ( Trig_U_BFF_H_Func007C() ) then
        set udg_ItemTypeCheck = 'I07L'
        set udg_ItemQuestNumber = ( I2R(udg_Temp_Int) + 0.30 )
        call TriggerExecute( gg_trg_ABag_Check )
    else
    endif
    set udg_TempString_Quest =  ( "Deed to Brill - " + I2S(R2I(udg_QDeedB_H)) + "/1 |n- Deed to Caer Darrow - " + I2S(R2I(udg_QDeedCD_H)) + "/1 |n- Deed to Southshore - " + I2S(R2I(udg_QDeedSS_H)) + "/1")
    call QuestItemSetDescriptionBJ( udg_QuestReqs[udg_Temp_Int], udg_TempString_Quest )
                       endif
