//===========================================================================
// Trigger: Fan of Knives
//===========================================================================
function Trig_Fan_of_Knives_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'AEfk' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fan_of_Knives_Func030A takes nothing returns nothing
    // hits air, ground, magic imm,     but not mech
    if IsUnitTargetableEnemyParams( GetEnumUnit(), udg_Temp_Unit, true, true, true, false) then
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL )
    set udg_Temp_Bool = true
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_Fan_of_Knives_Func032C takes nothing returns boolean
    if ( not ( udg_NEREviscerate == true ) ) then
        return false
    endif
    if ( not ( udg_Temp_Bool == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fan_of_Knives_Func035C takes nothing returns boolean
    if ( not ( udg_BEREviscerate == true ) ) then
        return false
    endif
    if ( not ( udg_Temp_Bool == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fan_of_Knives_Func051A takes nothing returns nothing
    // hits air, ground, magic imm,     but not mech
    if IsUnitTargetableEnemyParams( GetEnumUnit(), udg_Temp_Unit, true, true, true, false) then
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL )
    set udg_Temp_Bool = true
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_Fan_of_Knives_Func053C takes nothing returns boolean
    if ( not ( udg_NEREviscerate == true ) ) then
        return false
    endif
    if ( not ( udg_Temp_Bool == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fan_of_Knives_Func056C takes nothing returns boolean
    if ( not ( udg_BEREviscerate == true ) ) then
        return false
    endif
    if ( not ( udg_Temp_Bool == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fan_of_Knives_Actions takes nothing returns nothing
    local location Target
    local real RSC
    local integer p
    local boolean f
    local boolean r
    set udg_Temp_Unit = GetTriggerUnit()
     call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'AEfk'), ABILITY_RLF_DAMAGE_PER_TARGET_EFK1, ( GetUnitAbilityLevelSwapped( 'AEfk', udg_Temp_Unit) - 1 ), 0 )
    call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 4.00 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('AEfk', udg_Temp_Unit) * 60 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 5 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    set Target = udg_Temp_Unit_Point
    set RSC = udg_RealStatCalc
    set p = udg_Player_Number
    set f = udg_hasFirelords
    set r = udg_hasReaper
    call TriggerSleepAction( 0.25 )
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_Temp_Bool = false
    set udg_Temp_Unit_Point = Target
    set udg_RealStatCalc = RSC
    set udg_Player_Number = p
    set udg_hasFirelords = f
    set udg_hasReaper = r
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(400.00, udg_Temp_Unit_Point), function Trig_Fan_of_Knives_Func030A )
    if ( udg_Temp_Unit == udg_yA_Subtle_Rogue ) then
    if ( Trig_Fan_of_Knives_Func032C() ) then
        call TriggerExecute(gg_trg_NER_ComboGen)
    else
    endif
    endif
    if ( udg_Temp_Unit == udg_yH_Subtle_Rogue ) then
    if ( Trig_Fan_of_Knives_Func035C() ) then
        call TriggerExecute(gg_trg_BER_ComboGen)
    else
    endif
    endif
    call RemoveLocation (udg_Temp_Unit_Point)
    set Target = null
    call TriggerSleepAction( 0.35 )
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 4 ] then 
    set udg_Temp_Bool = false
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
    call CreateNUnitsAtLoc( 1, 'e00P', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 0.20, 'BTLF', GetLastCreatedUnit() )
    call IssueImmediateOrderBJ( GetLastCreatedUnit(), "fanofknives" )
    set udg_RealStatCalc = RSC / 2
    set udg_Player_Number = p
    set udg_hasFirelords = f
    set udg_hasReaper = r
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(400.00, udg_Temp_Unit_Point), function Trig_Fan_of_Knives_Func051A )
    if ( udg_Temp_Unit == udg_yA_Subtle_Rogue ) then
    if ( Trig_Fan_of_Knives_Func053C() ) then
        call TriggerExecute(gg_trg_NER_ComboGen)
    else
    endif
    endif
    if ( udg_Temp_Unit == udg_yH_Subtle_Rogue ) then
    if ( Trig_Fan_of_Knives_Func056C() ) then
        call TriggerExecute(gg_trg_BER_ComboGen)
    else
    endif
    endif
    call RemoveLocation (udg_Temp_Unit_Point)
    endif
endfunction

