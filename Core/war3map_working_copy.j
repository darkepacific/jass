    call SetUnitAcquireRangeBJ( GetLastCreatedUnit(), 200.00 )
    call RemoveLocation (udg_Temp_Unit_Point)
    if ( Trig_Neutral_Hostile_Spawn_Func017001() ) then
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Angry_Ents_N)
    else
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Angry_Ents_S)
    endif
    call CreateNUnitsAtLoc( 1, 'e005', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
    call SetUnitAcquireRangeBJ( GetLastCreatedUnit(), 200.00 )
    call RemoveLocation (udg_Temp_Unit_Point)
    if ( Trig_Neutral_Hostile_Spawn_Func021001() ) then
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Angry_Ents_W)
    else
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Angry_Ents_SW)
    endif
    call CreateNUnitsAtLoc( 1, 'e005', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
    call SetUnitAcquireRangeBJ( GetLastCreatedUnit(), 200.00 )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_Angry_Ents_SE)
    call CreateNUnitsAtLoc( 1, 'e005', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 2 )
    // Dragon Turtles
