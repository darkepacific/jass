//===========================================================================
// Trigger: Shadow Mend
//===========================================================================
function Trig_Shadow_Mend_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0FN' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Shadow_Mend_Func020C takes nothing returns boolean
    if ( not ( IsUnitEnemy(GetSpellTargetUnit(), GetOwningPlayer(GetTriggerUnit())) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Shadow_Mend_Func026C takes nothing returns boolean
    if ( not ( IsUnitEnemy(GetSpellTargetUnit(), GetOwningPlayer(GetTriggerUnit())) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Shadow_Mend_Actions takes nothing returns nothing
    local unit target = GetSpellTargetUnit()
    local unit udg_Temp_Unit = GetTriggerUnit()
    local integer udg_o
    if ( udg_Temp_Unit == udg_yA_Disc_Priest ) then
    set udg_o = udg_z_PR_DISC_A
    elseif (  udg_Temp_Unit == udg_yH_Disc_Priest ) then
    set udg_o = udg_z_PR_DISC_H
    endif
    set udg_o = ( udg_o + 4 )
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 5 ]  then
    set udg_SpellUnits[udg_o] = udg_SpellUnits[udg_o+1]
    else
    set udg_SpellUnits[udg_o] = null
    endif
    set udg_SpellUnits[udg_o+1] = target
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A0FN', udg_Temp_Unit) * 75 )
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 4.00 * udg_RealStatCalc )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    if ( Trig_Shadow_Mend_Func020C() ) then
        set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
        set udg_RealStatCalc = ( udg_RealStatCalc + 1.00 )
        set udg_RealStatCalc = ( udg_RealStatCalc / 6.00 )
        // Make New if not exist
        if udg_SpellUnits[udg_o+3] == null then
        call CreateNUnitsAtLoc( 1, 'e00H', GetTriggerPlayer(), udg_Temp_Unit_Point, bj_UNIT_FACING )
        set udg_SpellUnits[udg_o+3] = GetLastCreatedUnit()
        endif
        // Move & Set Lvl
        call SetUnitPositionLocFacingBJ( udg_SpellUnits[udg_o+3] , udg_Temp_Unit_Point, GetUnitFacing( udg_Temp_Unit ) )
        call SetUnitAbilityLevel(   udg_SpellUnits[udg_o+3],'A03H', 5)
        call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(  udg_SpellUnits[udg_o+3], 'A03H'), ABILITY_RLF_PRIMARY_DAMAGE, 4, udg_RealStatCalc )
        call RemoveLocation (udg_Temp_Unit_Point)
        set udg_RealStatCalc = 1.00
        call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A0FN'), ABILITY_RLF_DURATION_NORMAL, ( GetUnitAbilityLevel(udg_Temp_Unit, GetSpellAbilityId()) - 1 ), 0.01 )
        call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A0FN'), ABILITY_RLF_DURATION_HERO, ( GetUnitAbilityLevel(udg_Temp_Unit, GetSpellAbilityId()) - 1 ), 0.01 )
    else
        call ChaliceSetUnit(udg_Temp_Unit)
        call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A0FN'), ABILITY_RLF_DURATION_NORMAL, ( GetUnitAbilityLevel(udg_Temp_Unit, GetSpellAbilityId()) - 1 ), 6.0 )
        call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A0FN'), ABILITY_RLF_DURATION_HERO, ( GetUnitAbilityLevel(udg_Temp_Unit, GetSpellAbilityId()) - 1 ), 6.0 )
    endif
    // Set Abil Stats
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A0FN'), ABILITY_RLF_HIT_POINTS_GAINED_REJ1, ( GetUnitAbilityLevelSwapped('A0FN', GetTriggerUnit()) - 1 ), udg_RealStatCalc )
    call AddSpecialEffectTargetUnitBJ( "origin", GetSpellTargetUnit(), "Abilities\\Spells\\Items\\AIil\\AIilTarget.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    // On Enemy
    if ( Trig_Shadow_Mend_Func026C() ) then
        // Shadow Word: Death
        if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 13 ] then
        if GetUnitStatePercent( target, UNIT_STATE_LIFE, UNIT_STATE_MAX_LIFE) < 33.33 then
        set udg_RealStatCalc =  I2R(GetTotalInt( udg_Temp_Unit)) * 4.0
        call UnitDamageTargetBJ( udg_Temp_Unit, GetSpellTargetUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        call AddSpecialEffectTargetUnitBJ( "origin", GetSpellTargetUnit(), "Abilities\\Weapons\\CannonTowerMissile\\CannonTowerMissile.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call AddSpecialEffectTargetUnitBJ( "origin", GetSpellTargetUnit(), "Abilities\\Weapons\\Mortar\\MortarMissile.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call AddSpecialEffectTargetUnitBJ( "origin", GetSpellTargetUnit(), "Abilities\\Weapons\\GyroCopter\\GyroCopterMissile.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        endif
        endif
        // Dummy Casts Damage
        call IssueTargetOrderBJ( udg_SpellUnits[udg_o+3], "acidbomb", target )
        // Silence
        if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 9 ] then
        call SetUnitOwner( gg_unit_e028_1863, GetOwningPlayer(udg_Temp_Unit), true )
        call SetUnitAbilityLevelSwapped( 'A096', gg_unit_e028_1863, 2 )
        call IssueTargetOrderBJ( gg_unit_e028_1863, "soulburn", target )
        endif
    else
    endif
    // Atonement
    call Atonement( udg_Temp_Unit, target )
    // Mana
    call GameTimeWait( 0.1)
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 5 ]  then
    if IsUnitAlly( target, GetOwningPlayer(udg_Temp_Unit) ) then
    if udg_SpellUnits[udg_o] == udg_SpellUnits[udg_o+1] then
                set udg_SpellUnits[udg_o+1] = null
                call MaxManaRestore( 0.08, target )
                call AddSpecialEffectTargetUnitBJ( "origin", target, "Abilities\\Spells\\Items\\AIre\\AIreTarget.mdl")
                call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    endif
    endif
    endif
    set target = null
    set udg_Temp_Unit = null
endfunction

