    local unit udg_Temp_Unit = GetKillingUnit()
    local integer uId = GetUnitTypeId( udg_Temp_Unit)
    if  not ( uId == 'E00F' or uId == 'E02I' ) then
     if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 14 ]  then
    call StopSoundBJ( gg_snd_ObsidianAvengerReady1, false )
    call PlaySoundOnUnitBJ( gg_snd_ObsidianAvengerReady1, 100.00, udg_Temp_Unit )
    call BlzEndUnitAbilityCooldown( udg_Temp_Unit, 'A046' )
    call BlzEndUnitAbilityCooldown( udg_Temp_Unit, 'A02Z' )
     call SetUnitAbilityLevel( gg_unit_e028_1863, 'ACbb', 9 )
    call IssueTargetOrderBJ( gg_unit_e028_1863, "bloodlust", udg_Temp_Unit)
    endif
    endif
    set udg_Temp_Unit = null
endfunction

