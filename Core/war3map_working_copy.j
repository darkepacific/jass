//===========================================================================
// Trigger: Nightblade
//
// Safe to put on non-player units
//===========================================================================
function Trig_Nightblade_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0EU' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Nightblade_Func003C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 6) > 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Nightblade_Func005Func004C takes nothing returns boolean
    if ( not ( GetSpellAbilityUnit() == udg_yH_Subtle_Rogue ) ) then
        return false
    endif
    return true
endfunction

function Trig_Nightblade_Func005C takes nothing returns boolean
    if ( not ( GetSpellAbilityUnit() == udg_yA_Subtle_Rogue ) ) then
        return false
    endif
    return true
endfunction

function Trig_Nightblade_Actions takes nothing returns nothing
    local real ComboPoints = 0
    set udg_Temp_Unit = GetTriggerUnit()
    if ( Trig_Nightblade_Func003C() ) then
        call PlaySoundOnUnitBJ( gg_snd_MetalLightSliceFlesh2, 100.00, GetSpellAbilityUnit() )
    else
        call PlaySoundOnUnitBJ( gg_snd_MetalLightSliceFlesh3, 100.00, GetSpellAbilityUnit() )
    endif
    // Combo Points
    if ( Trig_Nightblade_Func005C() ) then
        call DestroyEffectBJ( udg_NERComboEffects[0] )
        call DestroyEffectBJ( udg_NERComboEffects[1] )
        call DestroyEffectBJ( udg_NERComboEffects[2] )
        set udg_Temp_Real = udg_NERComboPoints
        set ComboPoints = udg_NERComboPoints
        set udg_NERComboPoints = 0.00
        call ResetComboPoints( GetTriggerUnit() )
    else
        if ( Trig_Nightblade_Func005Func004C() ) then
            call DestroyEffectBJ( udg_BERComboEffects[0] )
            call DestroyEffectBJ( udg_BERComboEffects[1] )
            call DestroyEffectBJ( udg_BERComboEffects[2] )
            set udg_Temp_Real = udg_BERComboPoints
            set ComboPoints = udg_BERComboPoints
            set udg_BERComboPoints = 0.00
            call ResetComboPoints( GetTriggerUnit() )
        else
            set udg_Temp_Real = 3.00
        endif
    endif
    // Base Dmg
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, true) + 0 ))
    set udg_RealStatCalc = ( udg_RealStatCalc * ( 0.50 + udg_Temp_Real ) )
    // Marked for Death Multiplier Would go here
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A0EU'), ABILITY_RLF_DECAYING_DAMAGE, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), udg_RealStatCalc )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A0EU'), ABILITY_RLF_DURATION_NORMAL, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), ( 3.10 + ( 1.00 * udg_Temp_Real ) ) )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A0EU'), ABILITY_RLF_DURATION_HERO, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), ( 2.10 + ( 1.00 * udg_Temp_Real ) ) )
    // Find Weakness
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 9 ] then 
    call ArmorReduction( GetSpellTargetUnit() )
    endif
    // Ruthless
    call GameTimeWait(0.1)
    if GetRandomReal( 0.0, 2.99) < ComboPoints then
    set udg_Temp_Unit = GetTriggerUnit()
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 10 ] then 
    call CreateTextTagUnitBJ( "TRIGSTR_9593", udg_Temp_Unit, 12.00, 9.00, 40.00, 100.00, 40.00, 0 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64, 90.00 )
    call cleanUpText(1.0, 0.5)
    if udg_Temp_Unit == udg_yA_Subtle_Rogue then
    call ShowTextTagForceBJ( true, GetLastCreatedTextTag(), udg_AlliancePlayers )
    call TriggerExecute( gg_trg_NER_ComboGen )
    else
    call ShowTextTagForceBJ( true, GetLastCreatedTextTag(), udg_HordePlayers )
    call TriggerExecute( gg_trg_BER_ComboGen )
    endif
    endif
    endif
endfunction

//===========================================================================
function InitTrig_Nightblade takes nothing returns nothing
    set gg_trg_Nightblade = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Nightblade, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Nightblade, Condition( function Trig_Nightblade_Conditions ) )
    call TriggerAddAction( gg_trg_Nightblade, function Trig_Nightblade_Actions )
endfunction

