    set gg_trg_E_TOBB_H = CreateTrigger(  )
    call DisableTrigger( gg_trg_E_TOBB_H )
    call TriggerRegisterUnitInRangeSimple( gg_trg_E_TOBB_H, 256, gg_unit_E027_1847 )
