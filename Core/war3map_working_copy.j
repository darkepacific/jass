//===========================================================================
function Trig_Pain_Suppression_Press_F_Func012C takes nothing returns boolean
    if ( ( GetTriggerPlayer() == GetOwningPlayer(udg_yA_Disc_Priest) ) ) then
        return true
    endif
    if ( ( GetTriggerPlayer() == GetOwningPlayer(udg_yH_Disc_Priest) ) ) then
        return true
    endif
    return false
endfunction

function Trig_Pain_Suppression_Press_F_Conditions takes nothing returns boolean
    if ( not Trig_Pain_Suppression_Press_F_Func012C() ) then
        return false
    endif
    return true
endfunction

function Trig_Pain_Suppression_Press_F_Func003C takes nothing returns boolean
    if ( not ( GetTriggerPlayer() == GetOwningPlayer(udg_yA_Disc_Priest) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Pain_Suppression_Press_F_Actions takes nothing returns nothing
    local unit udg_Temp_Unit
    call Debug("Disc Priest pressed F")
    if ( Trig_Pain_Suppression_Press_F_Func003C() ) then
        set udg_Temp_Unit = udg_yA_Disc_Priest
    else
        set udg_Temp_Unit = udg_yH_Disc_Priest
    endif
    if BlzGetUnitAbilityCooldownRemaining(udg_Temp_Unit, 'A0FP') == 0.0 and GetUnitAbilityLevel(udg_Temp_Unit, 'A0FP') > 0 then
    if IsSilenced(udg_Temp_Unit) then
    call Debug("Pain Suppression off cd")
    call UnitRemoveBuffsBJ( bj_REMOVEBUFFS_NEGATIVE, udg_Temp_Unit)
     call IssueTargetOrderBJ( udg_Temp_Unit, "bloodlust", udg_Temp_Unit)
    endif
    endif
    set udg_Temp_Unit = null
endfunction

