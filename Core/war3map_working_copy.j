//===========================================================================
// Trigger: Burning Charge Event
//===========================================================================
function Trig_Burning_Charge_Event_Conditions takes nothing returns boolean
    if ( not ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) < 5300.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Burning_Charge_Event_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point = GetUnitLoc( gg_unit_H00S_2121 )
    local location udg_Temp_Polar_Point = GetUnitLoc(GetEventDamageSource())
    local real udg_Facing_Angle
    if DistanceBetweenPoints(udg_Temp_Unit_Point, udg_Temp_Polar_Point) > 1200 then
    call DisableTrigger( GetTriggeringTrigger() )
    //if farther then 720 project in the direction of the damage
    if DistanceBetweenPoints(udg_Temp_Unit_Point, udg_Temp_Polar_Point) > 720 then
    set udg_Facing_Angle = AngleBetweenPoints(udg_Temp_Unit_Point, udg_Temp_Polar_Point)
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 720.00, udg_Facing_Angle)
    endif
    call IssuePointOrderLocBJ( gg_unit_H00S_2121, "flamestrike", udg_Temp_Polar_Point )
    call TriggerSleepAction( 11.00 )
    call EnableTrigger( GetTriggeringTrigger() )
    endif
    call RemoveLocation (udg_Temp_Unit_Point)
    call RemoveLocation (udg_Temp_Polar_Point)
    set udg_Temp_Unit_Point = null
    set udg_Temp_Polar_Point = null
endfunction

