//===========================================================================
// Trigger: Crimson Tempest Whirl A
//===========================================================================
function Trig_Crimson_Tempest_Whirl_A_Actions takes nothing returns nothing
    set udg_Temp_Unit = udg_yA_Ass_Rogue
    if ( udg_Charge_Loop[36] < 15.00  ) then
        set udg_Charge_Loop[36] = ( udg_Charge_Loop[36] + 1 )
        call SetUnitFlyHeightBJ( udg_Temp_Unit, ( 150.00 * SinBJ(AcosBJ(( 1 - ( udg_Charge_Loop[36] / 8.00 ) ))) ), 0.00 )
        call BlzSetUnitFacingEx( udg_Temp_Unit, ( udg_DruidFacingAngle[3] + ( 24.00 * udg_Charge_Loop[36] ) ) )
    else
	call BlzSetUnitFacingEx( udg_Temp_Unit, udg_DruidFacingAngle[3] )
        call SetUnitFlyHeightBJ( udg_Temp_Unit, 0.00, 0.00 )
        call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "Abilities\\Spells\\Other\\Stampede\\StampedeMissile.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call DisableTrigger( GetTriggeringTrigger() )
    endif
endfunction

