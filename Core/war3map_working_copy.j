//===========================================================================
// Trigger: Darkmaster Gandling
//===========================================================================
function Trig_Darkmaster_Gandling_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'U01S' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Darkmaster_Gandling_Func024A takes nothing returns nothing
    call DestructableRestoreLife( GetEnumDestructable(), GetDestructableMaxLife(GetEnumDestructable()), false )
endfunction

function Trig_Darkmaster_Gandling_Func025A takes nothing returns nothing
    call DestructableRestoreLife( GetEnumDestructable(), GetDestructableMaxLife(GetEnumDestructable()), false )
endfunction

function Trig_Darkmaster_Gandling_Actions takes nothing returns nothing
    local unit udg_Temp_Unit = GetTriggerUnit()
    local location udg_Temp_Unit_Point
    set udg_Temp_Unit_Point = GetUnitLoc(GetDyingUnit())
    call CreateItemLoc( 'I07I', udg_Temp_Unit_Point )
    call TransmissionFromUnitTypeWithNameBJ( udg_Scholomance_Message_Group, Player(PLAYER_NEUTRAL_AGGRESSIVE), 'U01S', "TRIGSTR_11740", udg_Temp_Unit_Point, gg_snd_15_GANDLING_CLASS_DISMISSED, "TRIGSTR_11741", bj_TIMETYPE_ADD, 0.00, false )
    call RemoveLocation (udg_Temp_Unit_Point)
    call LVT_Release()
    call TriggerSleepAction( 10.00 )
    call LVT_StopAndCleanup()
    // Rez Ras
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Ras_Frostwhisper)
    call ReviveHeroLoc( gg_unit_U02F_1167, udg_Temp_Unit_Point, true )
    call SetUnitAnimation( gg_unit_U02F_1167, "stand channel" )
    call RemoveLocation (udg_Temp_Unit_Point)
    call SetUnitManaPercentBJ( gg_unit_U02F_1167, 100.00 )
    // Reset Gandling
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Darkmaster_Gandling)
    call ReviveHeroLoc( GetTriggerUnit(), udg_Temp_Unit_Point, true )
