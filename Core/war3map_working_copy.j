    set gg_trg_AnimateDead = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_AnimateDead, EVENT_PLAYER_UNIT_SPELL_ENDCAST )
    call TriggerAddCondition( gg_trg_AnimateDead, Condition( function Trig_AnimateDead_Conditions ) )
    call TriggerAddAction( gg_trg_AnimateDead, function Trig_AnimateDead_Actions )
endfunction

//===========================================================================
// Trigger: Animated Dead Dies n Explodes
//
// Set local temp unit
// Make new firelords func that returns unit but doesnt set temp unit
// Need to use something other than temp unit in AoE
//===========================================================================
function Trig_Animated_Dead_Dies_n_Explodes_Func034Func002Func005C takes nothing returns boolean
    if ( ( GetOwningPlayer(GetTriggerUnit()) == GetOwningPlayer(udg_yH_Unholy_DK) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetTriggerUnit()) == GetOwningPlayer(udg_yA_Unholy_DK) ) ) then
        return true
    endif
    return false
endfunction

function Trig_Animated_Dead_Dies_n_Explodes_Func034Func002C takes nothing returns boolean
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_UNDEAD) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == false ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) != 'u005' ) ) then
        return false
    endif
    if ( not ( GetPlayerController(GetOwningPlayer(GetTriggerUnit())) == MAP_CONTROL_USER ) ) then
        return false
    endif
    if ( not Trig_Animated_Dead_Dies_n_Explodes_Func034Func002Func005C() ) then
        return false
    endif
    return true
endfunction

function Trig_Animated_Dead_Dies_n_Explodes_Func034C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'u038' ) ) then
        return true
    endif
    if ( Trig_Animated_Dead_Dies_n_Explodes_Func034Func002C() ) then
        return true
    endif
    return false
endfunction

function Trig_Animated_Dead_Dies_n_Explodes_Conditions takes nothing returns boolean
    if ( not Trig_Animated_Dead_Dies_n_Explodes_Func034C() ) then
        return false
    endif
    return true
endfunction

function Trig_Animated_Dead_Dies_n_Explodes_Func022C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'u038' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Animated_Dead_Dies_n_Explodes_Func029Func003C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'u038' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Animated_Dead_Dies_n_Explodes_Func029A takes nothing returns nothing
    local unit udg_Temp_Unit = udg_Heroes[udg_Temp_Int2]
    if IsUnitTargetableEnemy( GetEnumUnit(), udg_Temp_Unit) then
    if ( Trig_Animated_Dead_Dies_n_Explodes_Func029Func003C() ) then
        call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    else
    endif
    call IssueTargetOrderBJ( gg_unit_e00H_2048, "acidbomb", GetEnumUnit() )
    call AddSpecialEffectTargetUnitBJ( "overhead", GetEnumUnit(), "war3mapImported\\plaguebomb_bigger.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call HasFirelordsPlayerNumber( GetEnumUnit(), udg_Temp_Int2)
    endif
    set udg_Temp_Unit = null
endfunction

function Trig_Animated_Dead_Dies_n_Explodes_Func032C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'u038' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Animated_Dead_Dies_n_Explodes_Actions takes nothing returns nothing
    local integer udg_Player_Number
    local unit udg_Temp_Unit
    // Move the Dummy
    set udg_Temp_Unit = gg_unit_e00H_2048
    call SetUnitOwner( udg_Temp_Unit, GetOwningPlayer(GetTriggerUnit()), true )
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    call SetUnitPositionLocFacingBJ( udg_Temp_Unit, udg_Temp_Unit_Point, GetUnitFacing(GetTriggerUnit()) )
    // Dummy Stats
    set udg_Player_Number = HeroesNumb(GetTriggerPlayer())
    set udg_Temp_Unit = udg_Heroes[udg_Player_Number]
    call SetPlagueDummyStats()
    if udg_Temp_Unit == udg_yA_Unholy_DK then
    set udg_Temp_Int = 1
    else
    set udg_Temp_Int = 7
    endif
    set udg_Temp_Unit = gg_unit_e00H_2048
    call SetUnitAbilityLevelSwapped( 'A03H', udg_Temp_Unit, udg_Temp_Int )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A03H'), ABILITY_RLF_PRIMARY_DAMAGE, ( udg_Temp_Int - 1 ), udg_RealStatCalc )
    set udg_Temp_Unit = udg_Heroes[udg_Player_Number]
    // Explosion Stats
    if ( Trig_Animated_Dead_Dies_n_Explodes_Func022C() ) then
        set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
        set udg_RealStatCalc = ( 6.00 * udg_RealStatCalc )
        set udg_HeroStatCalc = ( GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, false) )
        set udg_HeroStatCalc = ( udg_HeroStatCalc * 6 )
        set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
        set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A03L', udg_Temp_Unit) * 165 )
        set udg_HeroStatCalc = ( udg_HeroStatCalc + 165 )
        set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    else
    endif
    // SE
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Nether Blast III.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    // AoE
    set udg_Temp_Int2 = udg_Player_Number
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(330.00, udg_Temp_Unit_Point), function Trig_Animated_Dead_Dies_n_Explodes_Func029A )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Int2 = udg_Player_Number
    if ( Trig_Animated_Dead_Dies_n_Explodes_Func032C() ) then
        call UnitRemoveAbilityBJ( 'A0FF', udg_Heroes[udg_Temp_Int2] )
        call BlzUnitDisableAbility( udg_Heroes[udg_Temp_Int2], 'A03L', false, false )
    else
    endif
    set udg_Temp_Unit = null
endfunction

