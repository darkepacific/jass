function Trig_Divine_Storm_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    call PlaySoundOnUnitBJ( gg_snd_Shockwave, 95.00, GetTriggerUnit() )
    call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( ( 25.00 * I2R(GetUnitAbilityLevelSwapped('A06D', GetTriggerUnit())) ) + udg_RealStatCalc )
    set udg_RealStatCalc = ( 5.00 + udg_RealStatCalc )
    if ( Trig_Divine_Storm_Func007C() ) then
        set udg_Temp_Real = ( ( 0.10 * I2R(( GetUnitAbilityLevelSwapped('A0AQ', udg_Temp_Unit) + 1 )) ) + 1.00 )
        set udg_RealStatCalc = ( udg_Temp_Real * udg_RealStatCalc )
    else
    endif
    set udg_HeroStatCalc = 0
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    call TriggerExecute( gg_trg_Divine_Storm_Effect )
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(290.00, udg_Temp_Unit_Point), function Trig_Divine_Storm_Func012A )
    call RemoveLocation (udg_Temp_Unit_Point)
    if ( Trig_Divine_Storm_Func014C() ) then
        if (udg_HeroStatCalc > 3 ) then
        set udg_HeroStatCalc = 3
        endif
        set udg_Temp_Unit = GetTriggerUnit()
        call PlaySoundOnUnitBJ( gg_snd_DivineStormHit1, 44.00, GetTriggerUnit() )
        set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, false) ))
        set udg_RealStatCalc = ( 0.50 * udg_RealStatCalc )
        if ChaliceCheck() then
        set udg_RealStatCalc = ( ( ( 2.50 + ( 12.50 * I2R(GetUnitAbilityLevelSwapped('A06D', GetTriggerUnit())) ) ) * ( 1 + udg_CHALICE_HEAL ) ) + udg_RealStatCalc )
        else
        set udg_RealStatCalc = ( ( 12.50 * I2R(GetUnitAbilityLevelSwapped('A06D', GetTriggerUnit())) ) + udg_RealStatCalc )
        endif
        set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) * udg_RealStatCalc )
        if ( Trig_Divine_Storm_Func014Func014C() ) then
            set udg_Temp_Real = ( ( 0.10 * I2R(( GetUnitAbilityLevelSwapped('A0AQ', udg_Temp_Unit) + 1 )) ) + 1.00 )
            set udg_RealStatCalc = ( udg_Temp_Real * udg_RealStatCalc )
        else
        endif
        call SetUnitLifeBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) + udg_RealStatCalc ) )
        // 1% heal talent
        if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 1 ]  then
        call MissingHealthRestore( I2R(udg_HeroStatCalc)/100.00, udg_Temp_Unit)
        endif
        call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "Abilities\\Spells\\Human\\Heal\\HealTarget.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    else
    endif
    call TriggerSleepAction( 0.80 )
    set udg_Temp_Unit = GetTriggerUnit()
    if ( Trig_Divine_Storm_Func017C() ) then
        call TriggerExecute( gg_trg_Divine_Storm_Effect )
        call PlaySoundOnUnitBJ( gg_snd_Shockwave, 95.00, GetTriggerUnit() )
        call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
        set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, false) ))
        set udg_RealStatCalc = ( ( 25.00 * I2R(GetUnitAbilityLevelSwapped('A06D', GetTriggerUnit())) ) + udg_RealStatCalc )
        set udg_RealStatCalc = ( 5.00 + udg_RealStatCalc )
        set udg_HeroStatCalc = 0
        set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
        set bj_wantDestroyGroup = true
        call ForGroupBJ( GetUnitsInRangeOfLocAll(290.00, udg_Temp_Unit_Point), function Trig_Divine_Storm_Func017Func010A )
        call RemoveLocation (udg_Temp_Unit_Point)
        if ( Trig_Divine_Storm_Func017Func012C() ) then
            if (udg_HeroStatCalc > 3 ) then
            set udg_HeroStatCalc = 3
            endif
            set udg_Temp_Unit = GetTriggerUnit()
            if ( Trig_Divine_Storm_Func017Func012Func005C() ) then
                call PlaySoundOnUnitBJ( gg_snd_DivineStormHit2, 44.00, GetTriggerUnit() )
            else
                call PlaySoundOnUnitBJ( gg_snd_DivineStormHit3, 44.00, GetTriggerUnit() )
            endif
            set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_STR, GetTriggerUnit(), true) - GetHeroStatBJ(bj_HEROSTAT_STR, GetTriggerUnit(), false) ))
            set udg_RealStatCalc = ( 0.50 * udg_RealStatCalc )
            if ChaliceCheck() then
            set udg_RealStatCalc = ( ( ( 2.50 + ( 12.50 * I2R(GetUnitAbilityLevelSwapped('A06D', GetTriggerUnit())) ) ) * ( 1 + udg_CHALICE_HEAL ) ) + udg_RealStatCalc )
            else
            set udg_RealStatCalc = ( ( 12.50 * I2R(GetUnitAbilityLevelSwapped('A06D', GetTriggerUnit())) ) + udg_RealStatCalc )
            endif
            set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) * udg_RealStatCalc )
            if ( Trig_Divine_Storm_Func017Func012Func014C() ) then
                set udg_Temp_Real = ( ( 0.10 * I2R(( GetUnitAbilityLevelSwapped('A0AQ', udg_Temp_Unit) + 1 )) ) + 1.00 )
                set udg_RealStatCalc = ( udg_Temp_Real * udg_RealStatCalc )
            else
            endif
            call SetUnitLifeBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) + udg_RealStatCalc ) )
            // 1% heal talent
            if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 1 ]  then
            call MissingHealthRestore( I2R(udg_HeroStatCalc)/100.00, udg_Temp_Unit)
            endif
            call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "Abilities\\Spells\\Human\\Heal\\HealTarget.mdl" )
            call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        else
        endif
    else
    endif
    call TriggerSleepAction( 0.80 )
    set udg_Temp_Unit = GetTriggerUnit()
    if ( Trig_Divine_Storm_Func020C() ) then
        call TriggerExecute( gg_trg_Divine_Storm_Effect )
        call PlaySoundOnUnitBJ( gg_snd_Shockwave, 95.00, GetTriggerUnit() )
        call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
        set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_STR, GetTriggerUnit(), true) - GetHeroStatBJ(bj_HEROSTAT_STR, GetTriggerUnit(), false) ))
        set udg_RealStatCalc = ( ( 25.00 * I2R(GetUnitAbilityLevelSwapped('A06D', GetTriggerUnit())) ) + udg_RealStatCalc )
        set udg_RealStatCalc = ( 5.00 + udg_RealStatCalc )
        set udg_HeroStatCalc = 0
        set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
        set bj_wantDestroyGroup = true
        call ForGroupBJ( GetUnitsInRangeOfLocAll(290.00, udg_Temp_Unit_Point), function Trig_Divine_Storm_Func020Func010A )
        call RemoveLocation (udg_Temp_Unit_Point)
        if ( Trig_Divine_Storm_Func020Func012C() ) then
            if (udg_HeroStatCalc > 3 ) then
            set udg_HeroStatCalc = 3
            endif
            set udg_Temp_Unit = GetTriggerUnit()
            if ( Trig_Divine_Storm_Func020Func012Func005C() ) then
                call PlaySoundOnUnitBJ( gg_snd_DivineStormHit4, 44.00, GetTriggerUnit() )
            else
                call PlaySoundOnUnitBJ( gg_snd_DivineStormHit5, 44.00, GetTriggerUnit() )
            endif
            set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_STR, GetTriggerUnit(), true) - GetHeroStatBJ(bj_HEROSTAT_STR, GetTriggerUnit(), false) ))
            set udg_RealStatCalc = ( 0.50 * udg_RealStatCalc )
            if ChaliceCheck() then
            set udg_RealStatCalc = ( ( ( 2.50 + ( 12.50 * I2R(GetUnitAbilityLevelSwapped('A06D', GetTriggerUnit())) ) ) * ( 1 + udg_CHALICE_HEAL ) ) + udg_RealStatCalc )
            else
            set udg_RealStatCalc = ( ( 12.50 * I2R(GetUnitAbilityLevelSwapped('A06D', GetTriggerUnit())) ) + udg_RealStatCalc )
            endif
            set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) * udg_RealStatCalc )
            if ( Trig_Divine_Storm_Func020Func012Func014C() ) then
                set udg_Temp_Real = ( ( 0.10 * I2R(( GetUnitAbilityLevelSwapped('A0AQ', udg_Temp_Unit) + 1 )) ) + 1.00 )
                set udg_RealStatCalc = ( udg_Temp_Real * udg_RealStatCalc )
            else
            endif
            call SetUnitLifeBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) + udg_RealStatCalc ) )
            // 1% heal talent
            if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 1 ]  then
            call MissingHealthRestore( I2R(udg_HeroStatCalc)/100.00, udg_Temp_Unit)
            endif
            call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "Abilities\\Spells\\Human\\Heal\\HealTarget.mdl" )
            call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        else
        endif
    else
    endif
endfunction

