    set udg_Temp_Unit_Point = PolarProjectionBJ(udg_Temp_Polar_Point, 85.00, GetUnitFacing(GetTriggerUnit()))
    call RemoveLocation (udg_Temp_Polar_Point)
    call CreateNUnitsAtLoc( 1, 'e01P', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, GetUnitFacing(GetTriggerUnit()) )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = GetSpellTargetLoc()
    call IssuePointOrderLocBJ( GetLastCreatedUnit(), "breathoffrost", udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call UnitApplyTimedLifeBJ( 1.20, 'BTLF', GetLastCreatedUnit() )
endfunction

