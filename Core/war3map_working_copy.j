//===========================================================================
// Trigger: Maul
//===========================================================================
function Trig_Maul_Func002C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A03W' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Maul_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    if ( not Trig_Maul_Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_Maul_Func016Func001C takes nothing returns boolean
    if ( not ( IsUnitEnemy(GetEnumUnit(), GetOwningPlayer(udg_Temp_Unit)) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_MECHANICAL) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
        return false
    endif
    if ( not ( BlzIsUnitInvulnerable(GetEnumUnit()) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Maul_Func016A takes nothing returns nothing
    if ( Trig_Maul_Func016Func001C() ) then
        call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        if udg_Temp_Bool then
        call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        endif
        call HasFirelords( GetEnumUnit() )
    else
    endif
endfunction

function Trig_Maul_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
    set udg_Temp_Bool = udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 9 ]
    if udg_Temp_Bool then
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_STR, GetTriggerUnit(), true) - 0 ))
    call AddSpecialEffectTargetUnitBJ( "chest", GetTriggerUnit(), "war3mapImported\\Ephemeral Slash Orange.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    else
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_STR, GetTriggerUnit(), true) - GetHeroStatBJ(bj_HEROSTAT_STR, GetTriggerUnit(), false) ))
    endif
    set udg_RealStatCalc = ( 2.50 * udg_RealStatCalc )
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(250.00, udg_Temp_Unit_Point), function Trig_Maul_Func016A )
    call RemoveLocation (udg_Temp_Unit_Point)
endfunction

//===========================================================================
function InitTrig_Maul takes nothing returns nothing
    set gg_trg_Maul = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Maul, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Maul, Condition( function Trig_Maul_Conditions ) )
    call TriggerAddAction( gg_trg_Maul, function Trig_Maul_Actions )
endfunction

//===========================================================================
// Trigger: Arcane Shot
//===========================================================================
function Trig_Arcane_Shot_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A05M' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Arcane_Shot_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - 0 ))
    set udg_RealStatCalc = ( 1.50 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A05M', udg_Temp_Unit) * 80 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A05M'), ABILITY_RLF_PRIMARY_DAMAGE, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_Temp_Unit) - 1 ), udg_RealStatCalc )
    // Dwarf
    if ArcaneShotCasterCheck( udg_yA_Beast_Hunter ) then
    set udg_o = udg_z_HU_BEAS_A
    set udg_SpellUnits[udg_o] = GetSpellTargetUnit()
    call EnableTrigger( gg_trg_Arcane_Shot_Dwarf )
    call GameTimeWait(1.2)
    call DisableTrigger( gg_trg_Arcane_Shot_Dwarf )
    endif
    // Blood Elf
    if ArcaneShotCasterCheck( udg_yH_Beast_Hunter ) then
    set udg_o = udg_z_HU_BEAS_H
    set udg_SpellUnits[udg_o] = GetSpellTargetUnit()
    call EnableTrigger( gg_trg_Arcane_Shot_BldElf )
    call GameTimeWait(1.2)
    call DisableTrigger( gg_trg_Arcane_Shot_BldElf )
    endif
    // Night Elf
    if ArcaneShotCasterCheck( udg_yA_Marksman_Hunter) then
    set udg_o = udg_z_HU_MARK_A
    set udg_SpellUnits[udg_o] = GetSpellTargetUnit()
    call EnableTrigger( gg_trg_Arcane_Shot_NE )
    call GameTimeWait(1.2)
    call DisableTrigger( gg_trg_Arcane_Shot_NE )
    endif
    // Blood Elf Marksman
    if ArcaneShotCasterCheck( udg_yH_Marksman_Hunter) then
    set udg_o = udg_z_HU_MARK_H
    set udg_SpellUnits[udg_o] = GetSpellTargetUnit()
    call EnableTrigger( gg_trg_Arcane_Shot_BE )
    call GameTimeWait(1.2)
    call DisableTrigger( gg_trg_Arcane_Shot_BE )
    endif
endfunction

//===========================================================================
function InitTrig_Arcane_Shot takes nothing returns nothing
    set gg_trg_Arcane_Shot = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Arcane_Shot, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Arcane_Shot, Condition( function Trig_Arcane_Shot_Conditions ) )
    call TriggerAddAction( gg_trg_Arcane_Shot, function Trig_Arcane_Shot_Actions )
endfunction

//===========================================================================
// Trigger: Arcane Shot Dwarf
//===========================================================================
function Trig_Arcane_Shot_Dwarf_Conditions takes nothing returns boolean
    if ( GetDyingUnit() == udg_SpellUnits[udg_z_HU_BEAS_A]  ) then
        return true
    endif
    return false
endfunction

function Trig_Arcane_Shot_Dwarf_Actions takes nothing returns nothing
	local unit udg_Temp_Unit = udg_yA_Beast_Hunter
	local integer bonusMana = ( 30 + ( 10 * GetUnitAbilityLevelSwapped('A05M', udg_Temp_Unit) ) )
	
	call PlaySoundOnUnitBJ( gg_snd_SiphonMana, 75.00, udg_Temp_Unit )
	call SetUnitManaBJ( udg_Temp_Unit, ( GetUnitStateSwap(UNIT_STATE_MANA, udg_Temp_Unit) + ( bonusMana ) ) )
	call CreateTextTagUnitBJ( ( "+" + ( I2S( bonusMana ) + " Mana!" ) ), udg_Temp_Unit, 0.00, 8.00, 50.00, 50.00, 100.00, 0 )
	call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64.00, 180.00 )
	call cleanUpText( 0.7, 0.5) 

	set udg_Temp_Unit = null 
endfunction

