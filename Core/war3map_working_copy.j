// Trigger: Volley Start
//===========================================================================
function Trig_Volley_Start_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'ANcs' ) ) then
        return false
    endif
    if ( not ( GetPlayerController(GetOwningPlayer(GetTriggerUnit())) == MAP_CONTROL_USER ) ) then
        return false
    endif
    return true
endfunction

function Trig_Volley_Start_Actions takes nothing returns nothing
    if ( GetTriggerUnit() == udg_yA_Marksman_Hunter ) then
    set udg_Blizzard[7] = GetSpellTargetLoc()
    set udg_SpellTicks[15] = 1
    call EnableTrigger( gg_trg_Volley_Tick_NE)
    elseif udg_Temp_Unit == udg_yH_Marksman_Hunter then
    set udg_Blizzard[30] = GetSpellTargetLoc()
    set udg_SpellTicks[30] = 1
    call EnableTrigger( gg_trg_Volley_Tick_BE)
    endif
endfunction

//===========================================================================
function InitTrig_Volley_Start takes nothing returns nothing
    set gg_trg_Volley_Start = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Volley_Start, EVENT_PLAYER_UNIT_SPELL_CHANNEL )
    call TriggerAddCondition( gg_trg_Volley_Start, Condition( function Trig_Volley_Start_Conditions ) )
    call TriggerAddAction( gg_trg_Volley_Start, function Trig_Volley_Start_Actions )
endfunction

//===========================================================================
// Trigger: Volley Tick NE
//===========================================================================
function Trig_Volley_Tick_NE_Func009A takes nothing returns nothing
    if IsUnitTargetableEnemyHitsAll( GetEnumUnit(), udg_Temp_Unit ) then
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_HERO, DAMAGE_TYPE_MAGIC )
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_Volley_Tick_NE_Func010C takes nothing returns boolean
    if ( not ( udg_SpellTicks[15] == 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Volley_Tick_NE_Actions takes nothing returns nothing
    set udg_Temp_Unit = udg_yA_Marksman_Hunter
    call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
    set udg_HeroStatCalc = ( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) )
    set udg_HeroStatCalc = ( 3 * udg_HeroStatCalc )
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 2.00 * udg_RealStatCalc )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(220.00, udg_Blizzard[7]), function Trig_Volley_Tick_NE_Func009A )
    if ( Trig_Volley_Tick_NE_Func010C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
    else
        set udg_SpellTicks[15] = ( udg_SpellTicks[15] + 1 )
    endif
endfunction

//===========================================================================
function InitTrig_Volley_Tick_NE takes nothing returns nothing
    set gg_trg_Volley_Tick_NE = CreateTrigger(  )
    call DisableTrigger( gg_trg_Volley_Tick_NE )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Volley_Tick_NE, 0.20 )
    call TriggerAddAction( gg_trg_Volley_Tick_NE, function Trig_Volley_Tick_NE_Actions )
endfunction

