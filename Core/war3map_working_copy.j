function Trig_Southpoint_Tower_Func002Func001C takes nothing returns boolean
    if ( not ( GetOwningPlayer(gg_unit_ncop_1444) != Player(1) ) ) then
        return false
    endif
    if ( not Trig_Southpoint_Tower_Func002Func001Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_Southpoint_Tower_Func002Func011A takes nothing returns nothing
    call TimerDialogDisplayForPlayerBJ( true, udg_TowerWindows[0], GetEnumPlayer() )
endfunction

function Trig_Southpoint_Tower_Func002C takes nothing returns boolean
    if ( not Trig_Southpoint_Tower_Func002Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Southpoint_Tower_Func004Func001Func002C takes nothing returns boolean
    if ( ( GetOwningPlayer(GetTriggerUnit()) == Player(4) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetTriggerUnit()) == Player(5) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetTriggerUnit()) == Player(6) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetTriggerUnit()) == Player(10) ) ) then
        return true
    endif
    return false
endfunction

function Trig_Southpoint_Tower_Func004Func001C takes nothing returns boolean
    if ( not ( GetOwningPlayer(gg_unit_ncop_1444) != Player(3) ) ) then
        return false
    endif
    if ( not Trig_Southpoint_Tower_Func004Func001Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_Southpoint_Tower_Func004Func010A takes nothing returns nothing
    call TimerDialogDisplayForPlayerBJ( true, udg_TowerWindows[0], GetEnumPlayer() )
endfunction

function Trig_Southpoint_Tower_Func004C takes nothing returns boolean
    if ( not Trig_Southpoint_Tower_Func004Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Southpoint_Tower_Actions takes nothing returns nothing
    // Alliance Capture
    if ( Trig_Southpoint_Tower_Func002C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        call EnableTrigger( gg_trg_Southpoint_Tower_Leave )
        set udg_TowerHeroes[0] = GetEnteringUnit()
        call QuestMessageBJ( GetPlayersAllies(GetOwningPlayer(GetTriggerUnit())), bj_QUESTMESSAGE_ALWAYSHINT, "TRIGSTR_3675" )
        call StartTimerBJ( udg_TowerTimers[0], false, 15.00 )
        set udg_TowerTimers[0] = GetLastCreatedTimerBJ()
        call CreateTimerDialogBJ( udg_TowerTimers[0], "TRIGSTR_3676" )
        set udg_TowerWindows[0] = GetLastCreatedTimerDialogBJ()
        call TimerDialogDisplayBJ( false, udg_TowerWindows[0] )
        call ForForce( udg_AlliancePlayers, function Trig_Southpoint_Tower_Func002Func011A )
    else
    endif
    // Horde Capture
    if ( Trig_Southpoint_Tower_Func004C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        call EnableTrigger( gg_trg_Southpoint_Tower_Leave )
        set udg_TowerHeroes[0] = GetEnteringUnit()
        call QuestMessageBJ( GetPlayersAllies(GetOwningPlayer(GetTriggerUnit())), bj_QUESTMESSAGE_ALWAYSHINT, "TRIGSTR_3678" )
        call StartTimerBJ( udg_TowerTimers[0], false, 15.00 )
        call CreateTimerDialogBJ( udg_TowerTimers[0], "TRIGSTR_3679" )
        set udg_TowerWindows[0] = GetLastCreatedTimerDialogBJ()
        call TimerDialogDisplayBJ( false, udg_TowerWindows[0] )
        call ForForce( udg_HordePlayers, function Trig_Southpoint_Tower_Func004Func010A )
    else
    endif
endfunction

