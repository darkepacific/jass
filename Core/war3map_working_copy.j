//===========================================================================
function Trig_Maexxna_Spawn_Spiders_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'n05N' ) ) then
        return false
    endif
    if ( not ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) < 6600.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Maexxna_Spawn_Spiders_Actions takes nothing returns nothing
    local real udg_Temp_Angle
    local integer udg_Temp_Int = 0
    local location udg_Temp_Unit_Point
    local location udg_Temp_Polar_Point
    set udg_Temp_Polar_Point = GetUnitLoc(GetTriggerUnit())
    set udg_Temp_Int = 1
    loop
        exitwhen udg_Temp_Int > 6
        set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_Naxx_Minion_Spawn)
        set udg_Temp_Angle = AngleBetweenPoints(udg_Temp_Unit_Point, udg_Temp_Polar_Point)
        call CreateNUnitsAtLoc( 1, 'n039', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Temp_Unit_Point, udg_Temp_Angle )
        call UnitApplyTimedLife(GetLastCreatedUnit(), 'BTLF', 60.0)
        call UnitRemoveAbilityBJ( 'Aweb', GetLastCreatedUnit() )
        call IssuePointOrderLocBJ( GetLastCreatedUnit(), "attack", udg_Temp_Polar_Point )
        call RemoveLocation (udg_Temp_Unit_Point)
        set udg_Temp_Int = udg_Temp_Int + 1
    endloop
    call RemoveLocation (udg_Temp_Polar_Point)
    call DisableTrigger( GetTriggeringTrigger() )
    call TriggerSleepAction( 16.00 )
    call EnableTrigger( GetTriggeringTrigger() )
    set udg_Temp_Unit_Point = null
    set udg_Temp_Polar_Point = null
endfunction

