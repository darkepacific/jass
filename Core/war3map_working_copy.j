//===========================================================================
function Trig_Ghostlands_Spawn_Func003Func001C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetEnumUnit()) == 'H01I' ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetEnumUnit()) == Player(PLAYER_NEUTRAL_AGGRESSIVE) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Ghostlands_Spawn_Func003A takes nothing returns nothing
    if ( Trig_Ghostlands_Spawn_Func003Func001C() ) then
        call BlzSetUnitMaxHP( GetEnumUnit(), 1875 )
    else
    endif
endfunction

