//===========================================================================
// Trigger: AnitMagic Zone
//===========================================================================
function Trig_AnitMagic_Zone_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0C5' ) ) then
        return false
    endif
    return true
endfunction

function Trig_AnitMagic_Zone_Actions takes nothing returns nothing
    local real udg_RealStatCalc
    // HeroStat Calc
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 3.00 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A0C5', udg_Temp_Unit) * 40 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 60 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 3 ]  then
    set udg_RealStatCalc = ( udg_RealStatCalc * 1.08 )
    endif
    call UnitTypeCheck( udg_Temp_Unit, 'U02Z', 5 , 6) 
    // Create the Dummy
    set udg_Temp_Unit_Point = GetSpellTargetLoc()
    call CreateNUnitsAtLoc( 1, 'e00W', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, GetUnitFacing(GetTriggerUnit()) )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Shaman_Eq_Ls[udg_Temp_Int] = GetLastCreatedUnit()
    call UnitApplyTimedLifeBJ( 5.50, 'BTLF', udg_Shaman_Eq_Ls[udg_Temp_Int] )
    call SetUnitAbilityLevelSwapped( 'A03O', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0C5', GetTriggerUnit()) )
    call BlzSetAbilityIntegerLevelFieldBJ( BlzGetUnitAbility(udg_Shaman_Eq_Ls[udg_Temp_Int], 'A03O'), ABILITY_ILF_SHIELD_LIFE, ( GetUnitAbilityLevelSwapped('A0C5', GetTriggerUnit()) - 1 ), R2I(udg_RealStatCalc) )
    call SetUnitAbilityLevelSwapped( 'ACsi', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0C5', GetTriggerUnit()) )
    // Shield Allies
    set udg_Temp_Unit = GetTriggerUnit()
    call UnitTypeCheck( udg_Temp_Unit, 'U02Z', 5 , 6) 
    call BlzSetAbilityIntegerLevelFieldBJ( BlzGetUnitAbility(udg_Shaman_Eq_Ls[udg_Temp_Int], 'A03O'), ABILITY_ILF_SHIELD_LIFE, ( GetUnitAbilityLevelSwapped('A0C5', GetTriggerUnit()) - 1 ), R2I(udg_RealStatCalc) )
    set udg_Temp_Real = 1.00
    call  TriggerExecute(gg_trg_AntiMagic_Zone_Tick)
    call TriggerSleepAction( 1.00 )
    // Shield Allies
    set udg_Temp_Unit = GetTriggerUnit()
    call UnitTypeCheck( udg_Temp_Unit, 'U02Z', 5 , 6) 
    call BlzSetAbilityIntegerLevelFieldBJ( BlzGetUnitAbility(udg_Shaman_Eq_Ls[udg_Temp_Int], 'A03O'), ABILITY_ILF_SHIELD_LIFE, ( GetUnitAbilityLevelSwapped('A0C5', GetTriggerUnit()) - 1 ), R2I(udg_RealStatCalc) )
    set udg_Temp_Real = 2.00
    call  TriggerExecute(gg_trg_AntiMagic_Zone_Tick)
    call TriggerSleepAction( 1.00 )
    // Shield Allies
    set udg_Temp_Unit = GetTriggerUnit()
    call UnitTypeCheck( udg_Temp_Unit, 'U02Z', 5 , 6) 
    call BlzSetAbilityIntegerLevelFieldBJ( BlzGetUnitAbility(udg_Shaman_Eq_Ls[udg_Temp_Int], 'A03O'), ABILITY_ILF_SHIELD_LIFE, ( GetUnitAbilityLevelSwapped('A0C5', GetTriggerUnit()) - 1 ), R2I(udg_RealStatCalc) )
    set udg_Temp_Real = 3.00
    call  TriggerExecute(gg_trg_AntiMagic_Zone_Tick)
    call TriggerSleepAction( 1.00 )
    // Shield Allies
    set udg_Temp_Unit = GetTriggerUnit()
    call UnitTypeCheck( udg_Temp_Unit, 'U02Z', 5 , 6) 
    call BlzSetAbilityIntegerLevelFieldBJ( BlzGetUnitAbility(udg_Shaman_Eq_Ls[udg_Temp_Int], 'A03O'), ABILITY_ILF_SHIELD_LIFE, ( GetUnitAbilityLevelSwapped('A0C5', GetTriggerUnit()) - 1 ), R2I(udg_RealStatCalc) )
    set udg_Temp_Real = 4.00
    call  TriggerExecute(gg_trg_AntiMagic_Zone_Tick)
    call TriggerSleepAction( 1.00 )
    // Shield Allies
    set udg_Temp_Unit = GetTriggerUnit()
    call UnitTypeCheck( udg_Temp_Unit, 'U02Z', 5 , 6) 
    call BlzSetAbilityIntegerLevelFieldBJ( BlzGetUnitAbility(udg_Shaman_Eq_Ls[udg_Temp_Int], 'A03O'), ABILITY_ILF_SHIELD_LIFE, ( GetUnitAbilityLevelSwapped('A0C5', GetTriggerUnit()) - 1 ), R2I(udg_RealStatCalc) )
    set udg_Temp_Real = 5.00
    call  TriggerExecute(gg_trg_AntiMagic_Zone_Tick)
    call KillUnit(udg_Shaman_Eq_Ls[udg_Temp_Int])
endfunction

//===========================================================================
function InitTrig_AnitMagic_Zone takes nothing returns nothing
    set gg_trg_AnitMagic_Zone = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_AnitMagic_Zone, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_AnitMagic_Zone, Condition( function Trig_AnitMagic_Zone_Conditions ) )
    call TriggerAddAction( gg_trg_AnitMagic_Zone, function Trig_AnitMagic_Zone_Actions )
endfunction

//===========================================================================
// Trigger: AntiMagic Zone Tick
//===========================================================================
function Trig_AntiMagic_Zone_Tick_Func018Func001C takes nothing returns boolean
    if ( not ( IsUnitAlly(GetEnumUnit(), GetOwningPlayer(udg_Temp_Unit)) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_MECHANICAL) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AntiMagic_Zone_Tick_Func018A takes nothing returns nothing
    if ( Trig_AntiMagic_Zone_Tick_Func018Func001C() ) then
        if udg_HeroStatCalc == 0 then
        call IssueTargetOrderBJ( udg_Shaman_Eq_Ls[udg_Temp_Int], "antimagicshell", GetEnumUnit() )
        set udg_HeroStatCalc =  udg_HeroStatCalc + 1
        elseif udg_HeroStatCalc < 7 then
        call CreateNUnitsAtLoc( 1, 'e00W', GetOwningPlayer(udg_Temp_Unit), udg_Temp_Unit_Point, 0.00 )
        call UnitApplyTimedLifeBJ( ( 5.50 - udg_Temp_Real ), 'Bhwd', GetLastCreatedUnit() )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "antimagicshell", GetEnumUnit() )
        endif
    else
    endif
endfunction

function Trig_AntiMagic_Zone_Tick_Actions takes nothing returns nothing
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Shaman_Eq_Ls[udg_Temp_Int])
    call IssuePointOrderLocBJ( udg_Shaman_Eq_Ls[udg_Temp_Int], "silence", udg_Temp_Unit_Point )
    if udg_Temp_Real < 5.00 then
    call PlaySoundAtPointBJ( gg_snd_SpiritTouch, 100, udg_Temp_Unit_Point, 250.00 )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A0C5', udg_Temp_Unit) * 1 )
    set udg_RealStatCalc = ( ( 0.05 * I2R(udg_HeroStatCalc) ) + 0.80 )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\FreezingRing.mdx" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), udg_RealStatCalc )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set udg_RealStatCalc = ( ( 0.10 * I2R(udg_HeroStatCalc) ) + 1.70 )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Spells\\Undead\\ReplenishMana\\ReplenishManaCasterOverhead.mdl" )
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), ( 150.00 + BlzGetLocalSpecialEffectZ(GetLastCreatedEffectBJ()) ) )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), udg_RealStatCalc )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    endif
    set udg_HeroStatCalc = 0
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(( 220.00 + ( 10.00 * I2R(GetUnitAbilityLevelSwapped('A0C5', udg_Temp_Unit)) ) ), udg_Temp_Unit_Point), function Trig_AntiMagic_Zone_Tick_Func018A )
    call RemoveLocation (udg_Temp_Unit_Point)
endfunction

//===========================================================================
function InitTrig_AntiMagic_Zone_Tick takes nothing returns nothing
    set gg_trg_AntiMagic_Zone_Tick = CreateTrigger(  )
    call TriggerAddAction( gg_trg_AntiMagic_Zone_Tick, function Trig_AntiMagic_Zone_Tick_Actions )
endfunction

//===========================================================================
// Trigger: The Hunt
//===========================================================================
function Trig_The_Hunt_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0G2' ) ) then
        return false
    endif
    return true
endfunction

function Trig_The_Hunt_Func012C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 2) > 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_The_Hunt_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    if udg_Temp_Unit == udg_yA_Demon_Hunt then
    set udg_o = udg_z_DH_VENG_A
    set udg_Temp_Int = 45
    else
    set udg_o = udg_z_DH_VENG_H
    set udg_Temp_Int = 46
    endif
    set udg_o = ( udg_o + 8 )
    set udg_Charge_Loop[udg_Temp_Int] = 0.00
    set udg_SpellUnits[udg_o] = GetSpellTargetUnit()
    if ( Trig_The_Hunt_Func012C() ) then
        if udg_Temp_Unit == udg_yA_Demon_Hunt then
        call StopSoundBJ( gg_snd_FeelTheHatredof10000, false )
        call PlaySoundOnUnitBJ( gg_snd_FeelTheHatredof10000, 95.00, udg_SpellUnits[udg_o] )
        else
        call StopSoundBJ( gg_snd_FeelTheHatredof1000001, false )
        call PlaySoundOnUnitBJ( gg_snd_FeelTheHatredof1000001, 95.00, udg_SpellUnits[udg_o] )
        endif
    else
        if udg_Temp_Unit == udg_yA_Demon_Hunt then
        call StopSoundBJ( gg_snd_YouAreNotPrepared, false )
        call PlaySoundOnUnitBJ( gg_snd_YouAreNotPrepared, 95.00, udg_SpellUnits[udg_o] )
        else
        call StopSoundBJ( gg_snd_YouAreNotPrepared01, false )
        call PlaySoundOnUnitBJ( gg_snd_YouAreNotPrepared01, 95.00, udg_SpellUnits[udg_o] )
        endif
    endif
    call AddSpecialEffectTargetUnitBJ( "origin", GetSpellAbilityUnit(), "war3mapImported\\Valiant Charge Royal.mdx" )
    set udg_Charge_SE[udg_Temp_Int] = GetLastCreatedEffectBJ()
    // Turn on Move
    if udg_Temp_Unit == udg_yA_Demon_Hunt then
    call EnableTrigger( gg_trg_The_Hunt_Tick_A)
    else
    //change
    call EnableTrigger( gg_trg_The_Hunt_Tick_H)
    endif
endfunction

//===========================================================================
function InitTrig_The_Hunt takes nothing returns nothing
    set gg_trg_The_Hunt = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_The_Hunt, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_The_Hunt, Condition( function Trig_The_Hunt_Conditions ) )
    call TriggerAddAction( gg_trg_The_Hunt, function Trig_The_Hunt_Actions )
endfunction

//===========================================================================
// Trigger: The Hunt Tick A
//===========================================================================
function Trig_The_Hunt_Tick_A_Actions takes nothing returns nothing
    local unit caster = udg_yA_Demon_Hunt
    local integer i = 45
    local integer o = udg_z_DH_VENG_A + 8
    local unit target = udg_SpellUnits[o]
    local location begin = GetUnitLoc( caster)
    local location end = GetUnitLoc( target)
    local real dist = DistanceBetweenPoints(begin, end)
    local real angle = AngleBetweenPoints(begin, end)
    local real damage = 0
    local real lvl 
    
    call SetUnitFacing(caster, angle)
    call PauseAddInvuln(caster, null)
    call UnitAddAbility( caster, 'Amrf' )
    call UnitShareVisionBJ( true, target , GetOwningPlayer(caster ) )
    
    call SetUnitPathing( caster, false)
    call SetUnitFlyHeight(caster, 100, 0.0)
    set udg_Charge_Loop[i] = udg_Charge_Loop[i] + 1

    if dist > 100 and udg_Charge_Loop[i] < 150 then
        call RemoveLocation(end)
        set end = PolarProjectionBJ(begin, 32 + udg_Charge_Loop[i], angle)
        call SetUnitPositionLocFacingBJ( caster, end, angle)
    else
        // calc dmg 
        set lvl = I2R(GetUnitAbilityLevel(caster, 'A0G2'))
        set damage = I2R(( GetHeroStatBJ(bj_HEROSTAT_AGI, caster, true)  )) //- GetHeroStatBJ(bj_HEROSTAT_AGI, caster, false)
        set damage = ( (2+lvl) * damage )
        set damage = damage + ( lvl * 100 )
        set damage = damage + 100
        call UnitDamageTargetBJ(caster, target, damage, ATTACK_TYPE_HERO , DAMAGE_TYPE_NORMAL )
        call DummyStun(caster, target, 1.0, begin)

        // apply firelords
        call HasFirelordsPlayerNumber(target, GetPlayerHeroNumber(GetOwningPlayer(caster)))

        call UnitShareVisionBJ( false, target , GetOwningPlayer(caster ) )
        call SetUnitPathing( caster, true)
        call SetUnitFlyHeight(caster,0, 0.0)
        call UnPauseAddInvuln(caster, null)

        call DestroyEffectBJ( udg_Charge_SE[i] )
        call DisableTrigger( GetTriggeringTrigger() )
    endif
   
    call UnitRemoveAbility( caster, 'Amrf' )
    call RemoveLocation(begin)
    call RemoveLocation(end)
    set begin = null
    set end = null
    set target = null
    set caster = null
endfunction


//===========================================================================
function InitTrig_The_Hunt_Tick_A takes nothing returns nothing
    set gg_trg_The_Hunt_Tick_A = CreateTrigger(  )
    call DisableTrigger( gg_trg_The_Hunt_Tick_A )
    call TriggerRegisterTimerEventPeriodic( gg_trg_The_Hunt_Tick_A, 0.02 )
    call TriggerAddAction( gg_trg_The_Hunt_Tick_A, function Trig_The_Hunt_Tick_A_Actions )
endfunction


