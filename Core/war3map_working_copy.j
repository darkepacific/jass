//***************************************************************************
//*  DruidHelpers
function ImproveEclipse takes unit u, integer alvl returns nothing
	local integer manacost
	local real cd 
	set alvl = alvl - 1

	if udg_TalentChoices[ GetPlayerId(GetOwningPlayer( u )) * udg_NUM_OF_TC + 9 ]  then
	
		//BlzGetUnitAbilityManaCost(u, 'A0CW', alvl) 
		set manacost = alvl * 10 + 65
	
		//BlzGetUnitAbilityCooldown(u, 'A0CW', alvl)
		set cd = alvl * -0.2 + 8.5


		call BlzSetUnitAbilityManaCost(u, 'A0CW', alvl, manacost + -35 )
		call BlzSetUnitAbilityCooldown(u, 'A0CW', alvl,  cd + -1.5)

		if udg_Debug then
			call DisplayTextToForce( GetPlayersAll(), "New CD: " + R2S( cd ))
		endif
	endif
endfunction

function SetEntanglingRoots takes unit u returns nothing
	local integer alvl = GetUnitAbilityLevel( u, 'A030') - 1
	call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(gg_unit_e028_1863, 'Aenr'), ABILITY_RLF_DURATION_HERO,  0, BlzGetAbilityRealLevelField( BlzGetUnitAbility(u, 'A030'), ABILITY_RLF_DURATION_HERO, alvl) )
	call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(gg_unit_e028_1863, 'Aenr'), ABILITY_RLF_DURATION_NORMAL, 0, BlzGetAbilityRealLevelField( BlzGetUnitAbility(u, 'A030'), ABILITY_RLF_DURATION_NORMAL, alvl) )
endfunction
