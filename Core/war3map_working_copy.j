    set gg_trg_Windfury = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Windfury, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Windfury, Condition( function Trig_Windfury_Conditions ) )
    call TriggerAddAction( gg_trg_Windfury, function Trig_Windfury_Actions )
endfunction

//===========================================================================
// Trigger: Windfury Crit Orc
//===========================================================================
function Trig_Windfury_Crit_Orc_Conditions takes nothing returns boolean
    if ( not ( GetAttacker() == udg_yH_Enhance_Shaman ) ) then
        return false
    endif
    return true
endfunction

function Trig_Windfury_Crit_Orc_Func017C takes nothing returns boolean
    if ( not ( udg_SpellTicks[9] == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Windfury_Crit_Orc_Actions takes nothing returns nothing
    call TriggerSleepAction( 0.28 )
    set udg_Temp_Unit = udg_yH_Enhance_Shaman
    set udg_HeroStatCalc = ( GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, false) )
    set udg_HeroStatCalc = ( udg_HeroStatCalc * 2 )
    set udg_HeroStatCalc = ( ( udg_HeroStatCalc + 7 ) + BlzGetUnitBaseDamage(udg_Temp_Unit, 1) )
    set udg_HeroStatCalc = ( udg_HeroStatCalc * ( udg_SpellTicks[9] + 0 ) )
    call UnitDamageTargetBJ( udg_Temp_Unit, GetTriggerUnit(), I2R(udg_HeroStatCalc), ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL )
    set udg_HeroStatCalc = ( ( udg_HeroStatCalc + 7 ) + BlzGetUnitBaseDamage(udg_Temp_Unit, 1) )
    // Armor Reduc Calc for FT
    set udg_RealStatCalc = ( BlzGetUnitRealField(GetTriggerUnit(), UNIT_RF_DEFENSE) * 0.06 )
    set udg_RealStatCalc = ( 1 - ( udg_RealStatCalc / ( 1 + udg_RealStatCalc ) ) )
    set udg_HeroStatCalc = R2I(( I2R(udg_HeroStatCalc) * udg_RealStatCalc ))
    call CreateTextTagUnitBJ( ( I2S(udg_HeroStatCalc) + "!" ), udg_Temp_Unit, 0.00, 12.00, 100, 0.00, 0.00, 0 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64, 90.00 )
    call cleanUpText( 1.2, 0.8)
    call ShowTextTagForceBJ( true, GetLastCreatedTextTag(), GetPlayersAll() )
    if ( Trig_Windfury_Crit_Orc_Func017C() ) then
        call BlzSetUnitAttackCooldown( GetTriggerUnit(), 2.28, 1 )
        call DisableTrigger( GetTriggeringTrigger() )
    else
        set udg_SpellTicks[9] = ( udg_SpellTicks[9] + 1 )
    endif
endfunction

//===========================================================================
function InitTrig_Windfury_Crit_Orc takes nothing returns nothing
    set gg_trg_Windfury_Crit_Orc = CreateTrigger(  )
    call DisableTrigger( gg_trg_Windfury_Crit_Orc )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Windfury_Crit_Orc, EVENT_PLAYER_UNIT_ATTACKED )
    call TriggerAddCondition( gg_trg_Windfury_Crit_Orc, Condition( function Trig_Windfury_Crit_Orc_Conditions ) )
    call TriggerAddAction( gg_trg_Windfury_Crit_Orc, function Trig_Windfury_Crit_Orc_Actions )
endfunction

