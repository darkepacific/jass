    set gg_trg_Netherspite = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Netherspite, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_Netherspite, Condition( function Trig_Netherspite_Conditions ) )
    call TriggerAddAction( gg_trg_Netherspite, function Trig_Netherspite_Actions )
endfunction

