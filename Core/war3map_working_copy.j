//===========================================================================
// Trigger: Stampede
//===========================================================================
function Trig_Stampede_Func001C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A0DI' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0ET' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Stampede_Conditions takes nothing returns boolean
    if ( not Trig_Stampede_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Stampede_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) * 2 ))
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_Temp_Unit) * 150 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 50 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
     call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, GetSpellAbilityId()), ABILITY_RLF_DAMAGE_AMOUNT_NST3, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, true) - 0 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc / 15 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 1 )
    call BlzSetAbilityIntegerLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, GetSpellAbilityId()), ABILITY_ILF_BEASTS_PER_SECOND, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), udg_HeroStatCalc )
    set udg_HeroStatCalc = ( GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, true) - 0 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc * 3 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 400 )
    call BlzSetAbilityIntegerFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A0DI'), ABILITY_IF_MISSILE_SPEED, udg_HeroStatCalc )
    return
    return
    call BlzSetAbilityStringLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, GetSpellAbilityId()), ABILITY_SLF_MISSILE_ART, 0, "war3mapImported\\Mammoth Stampede.mdx" )
    call BlzSetAbilityStringLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, GetSpellAbilityId()), ABILITY_SLF_MISSILE_ART, 0, "war3mapImported\\KodoStampedeMissile.mdx" )
    call BlzSetAbilityStringLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, GetSpellAbilityId()), ABILITY_SLF_MISSILE_ART, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), "Abilities\\Spells\\Other\\Stampede\\StampedeMissile.mdl" )
    call BlzSetAbilityStringLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, GetSpellAbilityId()), ABILITY_SLF_MISSILE_ART, 0, "Abilities\\Spells\\Other\\Stampede\\StampedeMissile.mdl" )
endfunction

//===========================================================================
function InitTrig_Stampede takes nothing returns nothing
    set gg_trg_Stampede = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Stampede, EVENT_PLAYER_UNIT_SPELL_CAST )
    call TriggerAddCondition( gg_trg_Stampede, Condition( function Trig_Stampede_Conditions ) )
    call TriggerAddAction( gg_trg_Stampede, function Trig_Stampede_Actions )
endfunction

