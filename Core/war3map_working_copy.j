function InitTrig_Blink_Illusion takes nothing returns nothing
    set gg_trg_Blink_Illusion = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Blink_Illusion, EVENT_PLAYER_UNIT_SUMMON )
    call TriggerAddCondition( gg_trg_Blink_Illusion, Condition( function Trig_Blink_Illusion_Conditions ) )
