//===========================================================================
function Trig_U_GWG_Start_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0F7' ) ) then
        return false
    endif
    return true
endfunction

function Trig_U_GWG_Start_Func002C takes nothing returns boolean
    if ( not ( RectContainsLoc(gg_rct_Q_Fertile_Soil_1, udg_Temp_Unit_Point) == false ) ) then
        return false
    endif
    if ( not ( RectContainsLoc(gg_rct_Q_Fertile_Soil_2, udg_Temp_Unit_Point) == false ) ) then
        return false
    endif
    if ( not ( RectContainsLoc(gg_rct_Q_Fertile_Soil_3, udg_Temp_Unit_Point) == false ) ) then
        return false
    endif
    if ( not ( RectContainsLoc(gg_rct_Q_Fertile_Soil_4, udg_Temp_Unit_Point) == false ) ) then
        return false
    endif
    if ( not ( RectContainsLoc(gg_rct_Q_Fertile_Soil_5, udg_Temp_Unit_Point) == false ) ) then
        return false
    endif
    if ( not ( RectContainsLoc(gg_rct_Q_Fertile_Soil_6, udg_Temp_Unit_Point) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_U_GWG_Start_Actions takes nothing returns nothing
    set udg_Temp_Unit_Point = GetSpellTargetLoc()
    if ( Trig_U_GWG_Start_Func002C() ) then
        call IssueImmediateOrderBJ( GetTriggerUnit(), "stop" )
        call ErrorMessage( "Must plant acorn in Fertile Soil.", GetOwningPlayer(GetTriggerUnit()) )
    else
    endif
    call RemoveLocation (udg_Temp_Unit_Point)
endfunction

