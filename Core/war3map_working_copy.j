//===========================================================================
// Trigger: U GWG Begin
//
// Begins construction, wait 1 sec, create unit order to attack
// Finishes select all in region order to attack
//===========================================================================
function Trig_U_GWG_Begin_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'efon' ) ) then
        return false
    endif
    return true
endfunction

function Trig_U_GWG_Begin_Func004C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 4) > 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_U_GWG_Begin_Actions takes nothing returns nothing
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 620.00, GetRandomDirectionDeg())
    if ( Trig_U_GWG_Begin_Func004C() ) then
        call CreateNUnitsAtLoc( 1, 'nhyh', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Temp_Polar_Point, GetRandomDirectionDeg() )
        call UnitAddAbility( GetLastCreatedUnit(), 'ACdv' )
    else
        call CreateNUnitsAtLoc( 1, 'nsc2', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Temp_Polar_Point, GetRandomDirectionDeg() )
    endif
    call RemoveLocation (udg_Temp_Polar_Point)
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "attack", GetConstructingStructure() )
    call RemoveLocation (udg_Temp_Unit_Point)
endfunction

