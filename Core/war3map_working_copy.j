//===========================================================================
// Trigger: Glacial Advance Start
//
// 
//                         
//===========================================================================
function Trig_Glacial_Advance_Start_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A01G' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Glacial_Advance_Start_Func035Func001C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetEnumUnit(), 'B02H') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Glacial_Advance_Start_Func035A takes nothing returns nothing
    if ( Trig_Glacial_Advance_Start_Func035Func001C() ) then
        if IsUnitTargetableEnemyStab( GetEnumUnit(), udg_Temp_Unit ) then
        call HasFirelords( GetEnumUnit() )
        endif
    else
    endif
endfunction

function Trig_Glacial_Advance_Start_Actions takes nothing returns nothing
    local location udg_Temp_Polar_Point
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_Temp_Polar_Point = GetSpellTargetLoc()
    // Icy Talons
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 5 ]  then
    call SetUnitAbilityLevel( gg_unit_e028_1863, 'ACbb', 7 )
    call IssueTargetOrderBJ( gg_unit_e028_1863, "bloodlust", udg_Temp_Unit )
    endif
    // Glacial Advance Stats
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 6.00 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) )
    set udg_HeroStatCalc = ( 3 * udg_HeroStatCalc )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 530 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 3 ]  then
    set udg_RealStatCalc = ( udg_RealStatCalc * 1.08 )
    endif
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A01G'), ABILITY_RLF_DAMAGE_DEALT_UIM3, ( GetUnitAbilityLevel( udg_Temp_Unit, GetSpellAbilityId()) - 1 ), udg_RealStatCalc )
    // Firelords
    call GameTimeWait(1.05)
    // Firelords
    set udg_Temp_Unit = GetTriggerUnit()
    call TriggerExecute( gg_trg_Firelords_Helper)
    set udg_Length = 700.00
    set udg_Width = 350.00
    set udg_Temp_X_Point = GetUnitLoc(udg_Temp_Unit)
    set udg_Facing_Angle = AngleBetweenPoints(udg_Temp_X_Point, udg_Temp_Polar_Point)
    call RemoveLocation (udg_Temp_Polar_Point)
    set udg_Temp_Unit_Point = PolarProjectionBJ(udg_Temp_X_Point, 50.00, udg_Facing_Angle)
    call RemoveLocation (udg_Temp_X_Point)
    call TriggerExecute( gg_trg_PICK_EVERY_UNIT_IN_RECT )
    call RemoveLocation (udg_Temp_Unit_Point)
    call ForGroupBJ( udg_UnitsInRect, function Trig_Glacial_Advance_Start_Func035A )
    set  udg_Temp_Polar_Point = null
endfunction

//===========================================================================
function InitTrig_Glacial_Advance_Start takes nothing returns nothing
    set gg_trg_Glacial_Advance_Start = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Glacial_Advance_Start, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Glacial_Advance_Start, Condition( function Trig_Glacial_Advance_Start_Conditions ) )
    call TriggerAddAction( gg_trg_Glacial_Advance_Start, function Trig_Glacial_Advance_Start_Actions )
endfunction

