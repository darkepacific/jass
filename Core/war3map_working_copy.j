// Trigger: Lightning Shield Tick
//
// Needs to stay add the way it is since base ability is Inner Fire, for autocast purposes
//===========================================================================
function Trig_Lightning_Shield_Tick_Func001C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(udg_Shaman_Eq_Ls[2], 'Blsh') == false ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_Shaman_Eq_Ls[8], 'Blsh') == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Lightning_Shield_Tick_Func002Func008A takes nothing returns nothing
    if IsUnitTargetableEnemyGround( GetEnumUnit(), udg_Temp_Unit ) then
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "Abilities\\Weapons\\FarseerMissile\\FarseerMissile.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_Lightning_Shield_Tick_Func002C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(udg_Shaman_Eq_Ls[2], 'Blsh') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Lightning_Shield_Tick_Func003Func008A takes nothing returns nothing
    if IsUnitTargetableEnemyGround( GetEnumUnit(), udg_Temp_Unit ) then
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "Abilities\\Weapons\\FarseerMissile\\FarseerMissile.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_Lightning_Shield_Tick_Func003C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(udg_Shaman_Eq_Ls[8], 'Blsh') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Lightning_Shield_Tick_Actions takes nothing returns nothing
    if ( Trig_Lightning_Shield_Tick_Func001C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        call DisableTrigger(gg_trg_Lightning_Shield_Heal)
        return
    else
    endif
    if ( Trig_Lightning_Shield_Tick_Func002C() ) then
        set udg_Temp_Unit = udg_yH_Enhance_Shaman
        call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
        set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
        set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A08U', udg_Temp_Unit) * 11 )
        set udg_RealStatCalc = ( udg_RealStatCalc + I2R(udg_HeroStatCalc) )
        set udg_Temp_Unit_Point = GetUnitLoc(udg_Shaman_Eq_Ls[2])
        set bj_wantDestroyGroup = true
        call ForGroupBJ( GetUnitsInRangeOfLocAll(190.00, udg_Temp_Unit_Point), function Trig_Lightning_Shield_Tick_Func002Func008A )
        call RemoveLocation (udg_Temp_Unit_Point)
    else
    endif
    if ( Trig_Lightning_Shield_Tick_Func003C() ) then
        set udg_Temp_Unit = udg_yA_Enhance_Shaman
        call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
        set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
        set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A08U', udg_Temp_Unit) * 11 )
        set udg_RealStatCalc = ( udg_RealStatCalc + I2R(udg_HeroStatCalc) )
        set udg_Temp_Unit_Point = GetUnitLoc(udg_Shaman_Eq_Ls[8])
        set bj_wantDestroyGroup = true
        call ForGroupBJ( GetUnitsInRangeOfLocAll(190.00, udg_Temp_Unit_Point), function Trig_Lightning_Shield_Tick_Func003Func008A )
        call RemoveLocation (udg_Temp_Unit_Point)
    else
    endif
endfunction

//===========================================================================
function InitTrig_Lightning_Shield_Tick takes nothing returns nothing
    set gg_trg_Lightning_Shield_Tick = CreateTrigger(  )
    call DisableTrigger( gg_trg_Lightning_Shield_Tick )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Lightning_Shield_Tick, 0.50 )
    call TriggerAddAction( gg_trg_Lightning_Shield_Tick, function Trig_Lightning_Shield_Tick_Actions )
endfunction

//===========================================================================
// Trigger: Lightning Shield Heal
//===========================================================================
function Trig_Lightning_Shield_Heal_Func021C takes nothing returns boolean
    if ( ( IsUnitAlly(GetTriggerUnit(), Player(0)) == true ) ) then
        return true
    endif
    if ( ( IsUnitAlly(GetTriggerUnit(), Player(1)) == true ) ) then
        return true
    endif
    return false
endfunction

function Trig_Lightning_Shield_Heal_Conditions takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetTriggerUnit(), 'Blsh') == true ) ) then
        return false
    endif
    if ( not Trig_Lightning_Shield_Heal_Func021C() ) then
        return false
    endif
    return true
endfunction

function Trig_Lightning_Shield_Heal_Func001C takes nothing returns boolean
    if ( not ( IsUnitAlly(GetTriggerUnit(), Player(0)) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Lightning_Shield_Heal_Actions takes nothing returns nothing
    if ( Trig_Lightning_Shield_Heal_Func001C() ) then
        set udg_Temp_Unit = udg_yH_Enhance_Shaman
    else
        set udg_Temp_Unit = udg_yA_Enhance_Shaman
    endif
    set udg_RealStatCalc = 0.02
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 9 ]  then
    set udg_RealStatCalc = 0.03
    endif
    set udg_RealStatCalc = ( udg_RealStatCalc * ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, GetTriggerUnit()) - 0.00 ) )
    if ChaliceCheck() then
    set udg_RealStatCalc = ( ( udg_CHALICE_HEAL * udg_RealStatCalc ) + udg_RealStatCalc )
    endif
    call SetUnitLifeBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) + udg_RealStatCalc ) )
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 10 ]  then
    set udg_RealStatCalc = ( 0.02 * ( GetUnitStateSwap(UNIT_STATE_MAX_MANA, GetTriggerUnit()) - 0.00 ) )
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\WaterBlast.mdx" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.50 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call RemoveLocation (udg_Temp_Unit_Point)
    call SetUnitManaBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) + udg_RealStatCalc ) )
    endif
endfunction

//===========================================================================
function InitTrig_Lightning_Shield_Heal takes nothing returns nothing
    set gg_trg_Lightning_Shield_Heal = CreateTrigger(  )
    call DisableTrigger( gg_trg_Lightning_Shield_Heal )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Lightning_Shield_Heal, EVENT_PLAYER_UNIT_ATTACKED )
    call TriggerAddCondition( gg_trg_Lightning_Shield_Heal, Condition( function Trig_Lightning_Shield_Heal_Conditions ) )
