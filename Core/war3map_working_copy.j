//
// Need to change this to team wide display.
//===========================================================================
function Trig_S_WDH_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
                       if IsHordeHero( GetTriggerUnit() ) then
    set udg_TempString = "War on Deatholme"
    set udg_TempString_Quest = "Kill Scourge within and around Deatholme"
    call TriggerExecute( gg_trg_Quest_Start_H )
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    call QuestSetEnabledBJ( true, udg_Quests[108] )
    call FlashQuestDialogButtonBJ(  )
    endif
    call DestroyEffectBJ( udg_QuestMarks[108] )
    call QuestSetCompletedBJ( udg_Quests[108], false )
    call CreateQuestItemBJ( udg_Quests[108], "TRIGSTR_2455" )
    set udg_QuestReqs[108] = GetLastCreatedQuestItemBJ()
    call QuestItemSetDescriptionBJ( udg_QuestReqs[108], ( "Dar'Khan Drathir Slain - " + ( I2S(R2I(udg_QuestDeatholmeDark)) + ( "/1" + ( "|n- Deatholme Scourge Slain - " + ( I2S(R2I(udg_QuestDeatholme)) + "/9" ) ) ) ) ) )
    // Icon
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Deathhole_NPCs)
    call CampaignMinimapIconLocBJ( udg_Temp_Unit_Point, bj_CAMPPINGSTYLE_CONTROL_NEUTRAL )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_MiniMapIcon[108] = GetLastCreatedMinimapIcon()
    if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
    call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), false )
    endif
    call DisableTrigger( GetTriggeringTrigger() )
    call CampaignMinimapIconUnitBJ( gg_unit_U03J_2037, bj_CAMPPINGSTYLE_BOSS )
    call SetMinimapIconOrphanDestroy( GetLastCreatedMinimapIcon(), true )
    if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
    call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), false )
    endif
    call EnableTrigger( gg_trg_U_WDH)
    call EnableTrigger( gg_trg_U_WDH_DarKhan)
    call EnableTrigger( gg_trg_E_WDH)
                       endif
    set udg_Temp_Unit_Point = null
endfunction

