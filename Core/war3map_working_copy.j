function Trig_Set_Hearths_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetBuyingUnit()
    set udg_Player_Number = HeroesNumb( GetOwningPlayer( udg_Temp_Unit) )
    // HORDE
    if ( Trig_Set_Hearths_Func004C() ) then
        // Cities
        if ( Trig_Set_Hearths_Func004Func002C() ) then
            set udg_Hearthstones[udg_Player_Number] = 100
            set udg_TempString = "The Undercity"
        else
        endif
        if ( Trig_Set_Hearths_Func004Func003C() ) then
            set udg_Hearthstones[udg_Player_Number] = 200
            set udg_TempString = "Silvermoon"
        else
        endif
        // Start Zones
        if ( Trig_Set_Hearths_Func004Func005C() ) then
            set udg_Hearthstones[udg_Player_Number] = 800
            set udg_TempString = "Deathknell"
        else
        endif
        if ( Trig_Set_Hearths_Func004Func006C() ) then
            set udg_Hearthstones[udg_Player_Number] = 900
            set udg_TempString = "Sunstrider Isle"
        else
        endif
        // Towns
        if ( Trig_Set_Hearths_Func004Func008C() ) then
            set udg_Hearthstones[udg_Player_Number] = 0
            set udg_TempString = "Brill"
        else
        endif
        if ( Trig_Set_Hearths_Func004Func009C() ) then
            set udg_Hearthstones[udg_Player_Number] = 1
            set udg_TempString = "Farstrider Retreat"
        else
        endif
        if ( Trig_Set_Hearths_Func004Func010C() ) then
            set udg_Hearthstones[udg_Player_Number] = 2
            set udg_TempString = "Fairbreeze Village"
        else
        endif
        if ( Trig_Set_Hearths_Func004Func011C() ) then
            set udg_Hearthstones[udg_Player_Number] = 3
            set udg_TempString = "Dawnseeker Promonotory"
        else
        endif
        if ( Trig_Set_Hearths_Func004Func012C() ) then
            set udg_Hearthstones[udg_Player_Number] = 4
            set udg_TempString = "The Sepulcher"
        else
        endif
        if ( Trig_Set_Hearths_Func004Func013C() ) then
            set udg_Hearthstones[udg_Player_Number] = 5
            set udg_TempString = "Revantusk Village"
        else
        endif
        if ( Trig_Set_Hearths_Func004Func014C() ) then
            set udg_Hearthstones[udg_Player_Number] = 6
