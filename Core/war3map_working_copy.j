//===========================================================================
// Trigger: E KDS
//===========================================================================
function Trig_E_KDS_Func005Func001C takes nothing returns boolean
    if ( not ( GetItemTypeId(udg_P_Items[( udg_Bag_Num + udg_Bag_Iterator )]) == udg_ItemTypeCheck ) ) then
        return false
    endif
    return true
endfunction

function Trig_E_KDS_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 37
                       if IsAllianceHero( GetTriggerUnit() ) then
    call SetBagNumber( GetOwningPlayer(GetTriggerUnit()) )
    set udg_ItemTypeCheck = 'I05B'
    set udg_Bag_Iterator = 1
    loop
        exitwhen udg_Bag_Iterator > udg_BAG_LOOP_MAX
        if ( Trig_E_KDS_Func005Func001C() ) then
            call DisableTrigger( gg_trg_L_KDS )
            call DisableTrigger( GetTriggeringTrigger() )
            if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
            call FlashQuestDialogButtonBJ(  )
            endif
            call QuestSetCompletedBJ( udg_Quests[37], true )
            call DestroyEffectBJ( udg_QuestMarks[37] )
            call DestroyMinimapIcon( udg_MiniMapIcon[37] )
            set udg_TempString = "Kirk's Delivery Service"
            // Clean Up Items
            call CleanUpItems( udg_ItemTypeCheck )
            // Rewards
            set udg_XP = udg_QUEST_XP[udg_Temp_Int]
            set udg_Gold = udg_QUEST_GOLD[udg_Temp_Int]
            set udg_LVL_Req = udg_QUEST_LVL_REQ[udg_Temp_Int]
            call TriggerExecute( gg_trg_Quest_Complete_A )
            call CreateTextTagUnitBJ( "TRIGSTR_9505", gg_unit_H00K_0455, 0, 8.00, 90.00, 90.00, 0.00, 0 )
            call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 10.00, 90.00 )
            call cleanUpText( 1.25, 0.85 )
            call TriggerSleepAction( 0.50 )
            set udg_TempString = ""
            if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
            set udg_TempString = udg_ExclamationMark
            endif
            call AddSpecialEffectTargetUnitBJ( "overhead", gg_unit_H00K_0455, udg_TempString )
            set udg_QuestMarks[38] = GetLastCreatedEffectBJ()
            call EnableTrigger( gg_trg_S_CFD )
            return
        else
        endif
        set udg_Bag_Iterator = udg_Bag_Iterator + 1
    endloop
                       endif
endfunction

