            call CreateItemLoc( 'I01A', udg_Temp_Unit_Point )
        else
            call CreateItemLoc( 'I03H', udg_Temp_Unit_Point )
        endif
    endif
    call RemoveLocation (udg_Temp_Unit_Point)
    call DisableTrigger( gg_trg_Ettin_Move )
    call DisableTrigger( GetTriggeringTrigger() )
endfunction

