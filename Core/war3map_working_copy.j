    local integer udg_Temp_Int = 14
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    call FlashQuestDialogButtonBJ(  )
    endif
    call DestroyEffectBJ( udg_QuestMarks[14] )
    call QuestSetCompletedBJ( udg_Quests[14], true )
    call DestroyMinimapIcon( udg_MiniMapIcon[14] )
    // Rewards
    set udg_XP = udg_QUEST_XP[udg_Temp_Int]
    set udg_Gold = udg_QUEST_GOLD[udg_Temp_Int]
