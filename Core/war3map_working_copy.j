//===========================================================================
function Trig_LVLS_START_Func002C takes nothing returns boolean
    if ( not ( udg_HeroStatCalc == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_LVLS_START_Func003Func001C takes nothing returns boolean
    if ( not ( GetHeroLevel(udg_Heroes[GetForLoopIndexA()]) < udg_HeroStatCalc ) ) then
        return false
    endif
    return true
endfunction

function Trig_LVLS_START_Actions takes nothing returns nothing
    set udg_HeroStatCalc = S2I(SubStringBJ(GetEventPlayerChatString(), 6, 7))
    if ( Trig_LVLS_START_Func002C() ) then
        set udg_HeroStatCalc = udg_FINALS_LEVEL_1
    else
    endif
    set bj_forLoopAIndex = 0
    set bj_forLoopAIndexEnd = 7
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_LVLS_START_Func003Func001C() ) then
            call SetHeroLevelBJ( udg_Heroes[GetForLoopIndexA()], udg_HeroStatCalc, true )
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
endfunction

