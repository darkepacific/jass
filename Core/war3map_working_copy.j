    call CreateQuestItemBJ( udg_Quests[udg_Temp_Int], "TRIGSTR_11707" )
    set udg_QuestReqs[udg_Temp_Int] = GetLastCreatedQuestItemBJ()
    set udg_QuestMarks[udg_Temp_Int] = GetLastCreatedEffectBJ()
    call DisableTrigger( GetTriggeringTrigger() )
    call EnableTrigger(gg_trg_U_SAC_A)
    call EnableTrigger(gg_trg_E_SAC_A)
