//===========================================================================
// Trigger: E TOBB A
//
// Change to Fel's Essence
//===========================================================================
function Trig_E_TOBB_A_Func005Func001C takes nothing returns boolean
    if ( not ( GetItemTypeId(udg_P_Items[( udg_Bag_Num + udg_Bag_Iterator )]) == udg_ItemTypeCheck ) ) then
        return false
    endif
    return true
endfunction

function Trig_E_TOBB_A_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 72
                       if IsAllianceHero( GetTriggerUnit() ) then
    call SetBagNumber( GetOwningPlayer(GetTriggerUnit()) )
    set udg_ItemTypeCheck = 'I07N'
    set udg_Bag_Iterator = 1
    loop
        exitwhen udg_Bag_Iterator > udg_BAG_LOOP_MAX
        if ( Trig_E_TOBB_A_Func005Func001C() ) then
            if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
            call FlashQuestDialogButtonBJ(  )
            endif
            call DestroyEffectBJ( udg_QuestMarks[72] )
            call QuestSetCompletedBJ( udg_Quests[72], true )
            call QuestItemSetCompletedBJ( udg_QuestReqs[72], true )
            call DestroyMinimapIcon( udg_MiniMapIcon[72] )
            // Clean Up Items
            call CleanUpItems( udg_ItemTypeCheck )
            // Rewards
            set udg_XP = udg_QUEST_XP[udg_Temp_Int]
            set udg_Gold = udg_QUEST_GOLD[udg_Temp_Int]
            set udg_LVL_Req = udg_QUEST_LVL_REQ[udg_Temp_Int]
            set udg_TempString = "The Other Barov Brother"
            call TriggerExecute( gg_trg_Quest_Complete_A )
            call DisableTrigger( GetTriggeringTrigger() )
            call DisableTrigger( gg_trg_U_TOBB_A )
            call DisableTrigger( gg_trg_U_TOBB_Acq_A )
            return
        else
        endif
        set udg_Bag_Iterator = udg_Bag_Iterator + 1
    endloop
                       endif
endfunction

