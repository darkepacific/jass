function Trig_U_PA_Conditions takes nothing returns boolean
    if ( not ( GetItemTypeId(GetManipulatedItem()) == 'I05C' ) ) then
        return false
    endif
    return true
endfunction

function Trig_U_PA_Func004Func001C takes nothing returns boolean
    if ( not ( GetItemTypeId(GetEnumItem()) == 'I05C' ) ) then
        return false
    endif
    return true
endfunction

function Trig_U_PA_Func004A takes nothing returns nothing
    if ( Trig_U_PA_Func004Func001C() ) then
        set udg_Temp_Bool = true
    else
    endif
endfunction

function Trig_U_PA_Func025C takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_Quests[39]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_U_PA_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    call TriggerSleepAction( 0.10 )
    set udg_Temp_Bool = false
    call EnumItemsInRectBJ( gg_rct_Lillith_Neffara, function Trig_U_PA_Func004A )
    if udg_Temp_Bool then
    call DisableTrigger( gg_trg_U_PA_Acq )
    call DisableTrigger( GetTriggeringTrigger() )
    call DestroyEffectBJ( udg_QuestMarks[39] )
    call DestroyMinimapIcon( udg_MiniMapIcon[39] )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Lillith_Spawn)
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl" )
    call PlaySoundAtPointBJ( gg_snd_LightningBolt1, 80.00, udg_Temp_Unit_Point, 0 )
    set udg_QuestMarks[39] = GetLastCreatedEffectBJ()
    call DestroyEffectBJ( udg_QuestMarks[39] )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 0.40 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Lillith_Spawn)
    call CreateNUnitsAtLoc( 1, 'u00T', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
    call RemoveLocation (udg_Temp_Unit_Point)
    call SetUnitAcquireRangeBJ( GetLastCreatedUnit(), 300.00 )
    call CreateTextTagUnitBJ( "TRIGSTR_4841", GetLastCreatedUnit(), 0, 8.00, 70.00, 70.00, 90.00, 0 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
    call cleanUpText(1.5, 1.25) 
    call TriggerSleepAction( 15.00 )
    if ( Trig_U_PA_Func025C() ) then
        call DoNothing(  )
    else
        call EnableTrigger( GetTriggeringTrigger() )
    endif
    set udg_Temp_Unit_Point = null
    endif
endfunction

