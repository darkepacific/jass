    set gg_trg_S_Drunken_Banshees_H = CreateTrigger(  )
    call DisableTrigger( gg_trg_S_Drunken_Banshees_H )
    call TriggerRegisterEnterRectSimple( gg_trg_S_Drunken_Banshees_H, gg_rct_Q_Damned_Banshees )
    call TriggerRegisterUnitInRangeSimple( gg_trg_S_Drunken_Banshees_H, 256, gg_unit_H00K_0269 )
