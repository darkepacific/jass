            endif
            set udg_Temp_Z_Rev = GetRectCenter(gg_rct_GY_WP)
        else
        endif
        if ( Trig_Death_Set_Horde_Func003Func015C() ) then
            if ( Trig_Death_Set_Horde_Func003Func015Func001C() ) then
                if udg_Temp_Bool then
                call CameraSetupApplyForPlayer( true, gg_cam_GY_Headlands, udg_X_Player_MUI, 0.00 )
                endif
                set udg_Temp_Z_Rev = GetRectCenter(gg_rct_GY_Headlands)
            else
                if udg_Temp_Bool then
                call CameraSetupApplyForPlayer( true, gg_cam_GY_Gilneas_City, udg_X_Player_MUI, 0.00 )
                endif
                set udg_Temp_Z_Rev = GetRectCenter(gg_rct_GY_Gilneas_City_Controlled)
            endif
        else
        endif
        if ( Trig_Death_Set_Horde_Func003Func016C() ) then
            if udg_Temp_Bool then
            call CameraSetupApplyForPlayer( true, gg_cam_GY_Valsharah, udg_X_Player_MUI, 0.00 )
            endif
            set udg_Temp_Z_Rev = GetRectCenter(gg_rct_GY_Valsharah)
