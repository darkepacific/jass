//===========================================================================
function Trig_Rattlegore_Dies_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'U002' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Rattlegore_Dies_Func023A takes nothing returns nothing
    call KillDestructable( GetEnumDestructable() )
endfunction

function Trig_Rattlegore_Dies_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    set udg_Temp_Unit_Point = GetUnitLoc(GetDyingUnit())
    call CreateItemLoc( 'I0AB', udg_Temp_Unit_Point )
    call PlaySoundAtPointBJ( gg_snd_RevenantDeath1, 88.00, udg_Temp_Unit_Point, 50.00 )
    call SetSoundOffsetBJ( 1.25, gg_snd_RevenantDeath1 )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Valiant Charge Fel.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call RemoveLocation (udg_Temp_Unit_Point)
    // Turn off Bone Pile Gen
    call RBP_Clear()
    call TriggerSleepAction( 1.25 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Rattlegore_Cinematic_Start)
    call StopSoundBJ( gg_snd_4_GANDLING_THE_WEAVING, false )
    call StopSoundBJ( gg_snd_5_VOSS_I_WILL_NOT_LET_YOU_CURSE, false )
    call TransmissionFromUnitTypeWithNameBJ( udg_Scholomance_Message_Group, Player(PLAYER_NEUTRAL_AGGRESSIVE), 'U01S', "TRIGSTR_11575", udg_Temp_Unit_Point, gg_snd_8_GANDLING_THE_BONES, "TRIGSTR_11576", bj_TIMETYPE_ADD, 0.00, false )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 1.25 )
    call RemoveUnit( GetTriggerUnit() )
    // Destroy 2nd Lightning Wall
    call DestroyLightningBJ( udg_Scholomance_Lightning3 )
    call DestroyLightningBJ( udg_Scholomance_Lightning4 )
    call EnumDestructablesInRectAll( gg_rct_Scholomance_Gandling_Blocker_N, function Trig_Rattlegore_Dies_Func023A )
    call EnableTrigger( gg_trg_C_Gandling_Enter )
    set udg_Temp_Unit_Point = null
endfunction

