    set udg_QUEST_XP[udg_Temp_Int] = 1900
    set udg_QUEST_GOLD[udg_Temp_Int] = 900
    set udg_QUEST_LVL_REQ[udg_Temp_Int] = udg_QUEST_ZONE_5_LVL_REQ
