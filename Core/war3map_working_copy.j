// Trigger: Renewal
//===========================================================================
function Trig_Renewal_Func001C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A0CV' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A091' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Renewal_Conditions takes nothing returns boolean
    if ( not Trig_Renewal_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Renewal_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_RealStatCalc = ( I2R(GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit())) * ( GetUnitStateSwap(UNIT_STATE_MAX_MANA, GetTriggerUnit()) * 0.12 ) )
    set udg_RealStatCalc = ( udg_RealStatCalc + ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, GetTriggerUnit()) * 0.13 ) )
    call ChaliceSet()
    call SetUnitLifeBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) + udg_RealStatCalc ) )
    set udg_RealStatCalc = ( I2R(GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit())) * ( GetUnitStateSwap(UNIT_STATE_MAX_MANA, GetTriggerUnit()) * 0.12 ) )
    set udg_RealStatCalc = ( udg_RealStatCalc + ( GetUnitStateSwap(UNIT_STATE_MAX_MANA, GetTriggerUnit()) * 0.13 ) )
    call SetUnitManaBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) + udg_RealStatCalc ) )
    call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "war3mapImported\\Healing Touch.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
endfunction

