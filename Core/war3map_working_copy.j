    call CreateTextTagUnitBJ( "TRIGSTR_4659", gg_unit_Hblm_0221, 0.00, 8.00, 80.00, 20.00, 100.00, 0 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
    call cleanUpText( 1.5, 1.25 )
    call TriggerSleepAction( 0.35 )
    call IssueImmediateOrderBJ( gg_unit_Hblm_0221, "spiritwolf" )
endfunction

