function Trig_Durnholde_Keep_Capture_Actions takes nothing returns nothing
    // Alliance Capture
    if ( Trig_Durnholde_Keep_Capture_Func003C() ) then
        call DestroyTimerDialogBJ( udg_TowerWindows[6] )
        call DisableTrigger( gg_trg_Durhholde_Keep_Leave )
        call FactionPointCapture( gg_unit_ncop_1859, Player(1), "Durnholde Keep")
        call SetUnitOwner( gg_unit_hkee_0476, Player(1), true )
        call TriggerSleepAction( 4.00 )
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Durnholde_Guard_1)
        call CreateNUnitsAtLoc( 1, 'h00I', Player(1), udg_Temp_Unit_Point, 315.00 )
        call RemoveLocation (udg_Temp_Unit_Point)
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Duronhold_Will)
        call CreateNUnitsAtLoc( 1, 'h00I', Player(1), udg_Temp_Unit_Point, 340.00 )
        call RemoveLocation (udg_Temp_Unit_Point)
    else
    endif
    // Horde Capture
    if ( Trig_Durnholde_Keep_Capture_Func005C() ) then
        call DestroyTimerDialogBJ( udg_TowerWindows[6] )
        call DisableTrigger( gg_trg_Durhholde_Keep_Leave )
        call FactionPointCapture( gg_unit_ncop_1859, Player(3), "Durnholde Keep")
        call SetUnitOwner( gg_unit_hkee_0476, Player(3), true )
        call TriggerSleepAction( 4.00 )
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Durnholde_Guard_1)
        call CreateNUnitsAtLoc( 1, 'u000', Player(3), udg_Temp_Unit_Point, 315.00 )
        call RemoveLocation (udg_Temp_Unit_Point)
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Duronhold_Will)
        call CreateNUnitsAtLoc( 1, 'u000', Player(3), udg_Temp_Unit_Point, 340.00 )
        call RemoveLocation (udg_Temp_Unit_Point)
    else
    endif
    call EnableTrigger( gg_trg_Durnholde_Keep )
endfunction

