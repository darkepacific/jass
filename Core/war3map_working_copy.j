    if ( not ( udg_AbomTableGilneas == null ) ) then
        return false
    endif
    return true
endfunction

function Trig_Genn_Greymane_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    call EnableTrigger( gg_trg_Operating_Table )
    call DisableTrigger( gg_trg_Gilneas_City_Battle_Music )
    call EnableTrigger( gg_trg_Gilneas_City_Classical )
    set udg_Temp_Unit_Point = GetUnitLoc(GetDyingUnit())
    call CreateItemLoc( 'ckng', udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 1.50 )
    call DisplayTimedTextToForce( GetPlayersAll(), 3.00, "TRIGSTR_2567" )
    call TriggerSleepAction( 3.00 )
    call FactionCapture( GetTriggerUnit(), Player(0), "Gilneas City", "", false)
    call SetUnitOwner( gg_unit_ncop_1664, Player(3), true )
    call SetUnitOwner( gg_unit_ncop_1665, Player(3), true )
    call SetUnitOwner( gg_unit_n026_1833, Player(3), true )
    call KillUnit( gg_unit_H02B_1845 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Gilneas_Guard_1)
    call CreateNUnitsAtLoc( 1, 'u00G', Player(3), udg_Temp_Unit_Point, 315.00 )
    call RemoveLocation (udg_Temp_Unit_Point)
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRectOfPlayer(gg_rct_Z_Gilneas_City, Player(11)), function Trig_Genn_Greymane_Func020A )
    call TriggerSleepAction( 6.00 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Genn_Greymane)
    call ReviveHeroLoc( gg_unit_H027_1820, udg_Temp_Unit_Point, true )
    call SetUnitPositionLocFacingBJ( gg_unit_H027_1820, udg_Temp_Unit_Point, 270.00 )
    call RemoveLocation (udg_Temp_Unit_Point)
    if ( Trig_Genn_Greymane_Func026C() ) then
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Tess_Greymane)
        call CreateNUnitsAtLoc( 1, 'N00G', Player(3), udg_Temp_Unit_Point, 360.00 )
        call RemoveLocation (udg_Temp_Unit_Point)
        set udg_ApothecaryGilneas = GetLastCreatedUnit()
        call SetHeroLevelBJ( udg_ApothecaryGilneas, 18, true )
        call SelectHeroSkill( udg_ApothecaryGilneas, 'ANhs' )
        call SelectHeroSkill( udg_ApothecaryGilneas, 'ANab' )
        call SelectHeroSkill( udg_ApothecaryGilneas, 'ANcr' )
        call SelectHeroSkill( udg_ApothecaryGilneas, 'ANcr' )
        call SelectHeroSkill( udg_ApothecaryGilneas, 'ANcr' )
        call SelectHeroSkill( udg_ApothecaryGilneas, 'ANcr' )
        call UnitAddItemByIdSwapped( 'ram3', udg_ApothecaryGilneas )
        call UnitAddItemByIdSwapped( 'I054', udg_ApothecaryGilneas )
        call UnitAddItemByIdSwapped( 'I05X', udg_ApothecaryGilneas )
        call TriggerExecute( gg_trg_M_Test_Subjects_68 )
        call TriggerRegisterUnitEvent( gg_trg_Apothecary_Falthis, udg_ApothecaryGilneas, EVENT_UNIT_DEATH )
    else
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Tess_Greymane)
        call ReviveHeroLoc( udg_ApothecaryGilneas, udg_Temp_Unit_Point, true )
        call RemoveLocation (udg_Temp_Unit_Point)
        call BlzSetUnitFacingEx( udg_ApothecaryGilneas, 358.23 )
    endif
    if ( Trig_Genn_Greymane_Func027C() ) then
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Tobias_Mismantle)
        call CreateNUnitsAtLoc( 1, 'u02P', Player(3), udg_Temp_Unit_Point, 90.00 )
        call RemoveLocation (udg_Temp_Unit_Point)
        set udg_ValkyrGilneas = GetLastCreatedUnit()
        if ( Trig_Genn_Greymane_Func027Func005C() ) then
            call TriggerExecute( gg_trg_M_Godfreys_Downfall_142)
        else
            if ( Trig_Genn_Greymane_Func027Func005Func001C() ) then
                call DestroyEffectBJ( udg_QuestMarks[142] )
                set udg_TempString = ""
                if ( GetLocalPlayer() == Player(4) or GetLocalPlayer() == Player(5) or GetLocalPlayer() == Player(6) or GetLocalPlayer() == Player(10) )then
                set udg_TempString = udg_ExclamationMark
                endif
                call AddSpecialEffectTargetUnitBJ( "overhead", GetLastCreatedUnit(), udg_TempString )
                set udg_QuestMarks[142] = GetLastCreatedEffectBJ()
            else
            endif
        endif
    else
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Tess_Greymane)
        call ReviveHeroLoc( udg_ApothecaryGilneas, udg_Temp_Unit_Point, true )
        call RemoveLocation (udg_Temp_Unit_Point)
        call BlzSetUnitFacingEx( udg_ApothecaryGilneas, 358.23 )
    endif
    if ( Trig_Genn_Greymane_Func028C() ) then
        call SetHeroLevelBJ( gg_unit_H027_1820, 40, false )
    else
    endif
    if ( Trig_Genn_Greymane_Func029C() ) then
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Gilneas_Op_Table)
        call CreateDestructableLoc( 'B01F', udg_Temp_Unit_Point, 283.57, 0.88, 0 )
        call RemoveLocation (udg_Temp_Unit_Point)
        set udg_AbomTableGilneas = GetLastCreatedDestructable()
    else
    endif
    set udg_Temp_Unit_Point = null
endfunction

