function Trig_Gnome_Gate_Lever_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    local destructable udg_Temp_Destructable= GetDyingDestructable()
    if ( Trig_Gnome_Gate_Lever_Func003C() ) then
        call SetDoodadAnimationRectBJ( "Stand Victory", 'D03Y', gg_rct_Z_Gnome_Cave_0 )
        call SetDoodadAnimationRectBJ( "Stand Victory", 'D040', gg_rct_Z_Gnome_Cave_0 )
    else
        call SetDoodadAnimationRectBJ( "Stand Defend", 'D03Y', gg_rct_Z_Gnome_Cave_0 )
        call SetDoodadAnimationRectBJ( "Stand Defend", 'D040', gg_rct_Z_Gnome_Cave_0 )
    endif
    if ( Trig_Gnome_Gate_Lever_Func004C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        call ModifyGateBJ( bj_GATEOPERATION_OPEN, gg_dest_B027_31907 )
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Z_Gnome_Cave_0)
        call PlaySoundAtPointBJ( gg_snd_BattleNetDoorsStereo2, 100, udg_Temp_Unit_Point, 0 )
        call RemoveLocation (udg_Temp_Unit_Point)
    else
    endif
    call TriggerSleepAction( 15.00 )
    call DestructableRestoreLife( udg_Temp_Destructable, 5.00, true )
    set udg_Temp_Destructable = null
    set udg_Temp_Unit_Point = null
