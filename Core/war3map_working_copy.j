    if ( not ( IsUnitInGroup(GetEnumUnit(), udg_PX_Firelords[31]) == true ) ) then
        return false
    endif
    if ( not Trig_Firelords_Burn_Tick_Func001Func002Func002Func001Func001Func004C() ) then
        return false
    endif
    return true
endfunction

function Trig_Firelords_Burn_Tick_Func001Func002Func002Func001C takes nothing returns boolean
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Firelords_Burn_Tick_Func001Func002Func002A takes nothing returns nothing
    if ( Trig_Firelords_Burn_Tick_Func001Func002Func002Func001C() ) then
        if ( Trig_Firelords_Burn_Tick_Func001Func002Func002Func001Func001C() ) then
            call GroupRemoveUnit( udg_PX_Firelords[udg_Player_Number], GetEnumUnit())
            call GroupRemoveUnit( udg_PX_Firelords[31], GetEnumUnit())
        else
        endif
        call UnitDamageTargetBJ( udg_Heroes[udg_Player_Number], GetEnumUnit(), ( ( 10.00 + ( I2R(GetUnitLevel(udg_Heroes[udg_Player_Number])) + 0.00 ) ) + ( 0.01 * GetUnitStateSwap(UNIT_STATE_MAX_LIFE, GetEnumUnit()) ) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        call AddSpecialEffectTargetUnitBJ( "overhead", GetEnumUnit(), "Environment\\NightElfBuildingFire\\ElfLargeBuildingFire2.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "war3mapImported\\Burning Core.mdx" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call ApplyFirelordsBuff( GetEnumUnit() )
    else
        call GroupRemoveUnitSimple( GetEnumUnit(), udg_PX_Firelords[udg_Player_Number] )
    endif
endfunction

function Trig_Firelords_Burn_Tick_Func001Func002C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_PX_Firelords[udg_Player_Number]) > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Firelords_Burn_Tick_Func003Func001C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_PX_Firelords[GetForLoopIndexA()]) > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Firelords_Burn_Tick_Actions takes nothing returns nothing
    set bj_forLoopAIndex = 0
    set bj_forLoopAIndexEnd = 7
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_Player_Number = GetForLoopIndexA()
        if ( Trig_Firelords_Burn_Tick_Func001Func002C() ) then
            call SetUnitOwner( gg_unit_e028_1863, GetOwningPlayer(udg_Heroes[udg_Player_Number]), true )
            call ForGroupBJ( udg_PX_Firelords[udg_Player_Number], function Trig_Firelords_Burn_Tick_Func001Func002Func002A )
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    // For Loop to Determine if Tick Needs to Turn OFF
    set bj_forLoopAIndex = 0
    set bj_forLoopAIndexEnd = 7
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_Firelords_Burn_Tick_Func003Func001C() ) then
            return
            exitwhen true
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    call DisableTrigger( GetTriggeringTrigger() )
endfunction

//===========================================================================
function InitTrig_Firelords_Burn_Tick takes nothing returns nothing
    set gg_trg_Firelords_Burn_Tick = CreateTrigger(  )
    call DisableTrigger( gg_trg_Firelords_Burn_Tick )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Firelords_Burn_Tick, 0.95 )
    call TriggerAddAction( gg_trg_Firelords_Burn_Tick, function Trig_Firelords_Burn_Tick_Actions )
endfunction

