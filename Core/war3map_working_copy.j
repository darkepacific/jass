function Trig_Conscecration_Func022C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Temp_Unit) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Conscecration_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    call PlaySoundOnUnitBJ( gg_snd_Shockwave, 95.00, udg_Temp_Unit )
    call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
    set udg_RealStatCalc = BlzGetAbilityRealLevelField(BlzGetUnitAbility(udg_Temp_Unit, 'A00M'), ABILITY_RLF_AREA_OF_EFFECT, ( GetUnitAbilityLevelSwapped('A00M', udg_Temp_Unit) - 1 ))
    set udg_HeroStatCalc = R2I(udg_RealStatCalc)
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 5 )
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 3.00 * udg_RealStatCalc )
    if ( Trig_Conscecration_Func009C() ) then
        set udg_Temp_Real = ( ( 0.10 * I2R(( GetUnitAbilityLevelSwapped('A0AQ', udg_Temp_Unit) + 1 )) ) + 1.00 )
        set udg_RealStatCalc = ( udg_Temp_Real * udg_RealStatCalc )
    else
    endif
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(I2R(udg_HeroStatCalc), udg_Temp_Unit_Point), function Trig_Conscecration_Func012A )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 0.95 )
    set udg_Temp_Unit = GetTriggerUnit()
    if ( Trig_Conscecration_Func016C() ) then
        call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
        set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
        set udg_HeroStatCalc = ( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) )
        set udg_Temp_Int = 0
        call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "war3mapImported\\RunningFlameAura.mdx" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        set bj_wantDestroyGroup = true
        call ForGroupBJ( GetUnitsInRangeOfLocAll(280.00, udg_Temp_Unit_Point), function Trig_Conscecration_Func016Func008A )
        call RemoveLocation (udg_Temp_Unit_Point)
        if ( Trig_Conscecration_Func016Func010C() ) then
            call StopSoundBJ( gg_snd_FireBallMissileDeath, false )
            call PlaySoundOnUnitBJ( gg_snd_FireBallMissileDeath, 55.00, udg_Temp_Unit )
        else
        endif
    else
    endif
    call TriggerSleepAction( 0.95 )
    set udg_Temp_Unit = GetTriggerUnit()
    if ( Trig_Conscecration_Func019C() ) then
        call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
        set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
        set udg_HeroStatCalc = ( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) )
        set udg_Temp_Int = 0
        call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "war3mapImported\\RunningFlameAura.mdx" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        set bj_wantDestroyGroup = true
        call ForGroupBJ( GetUnitsInRangeOfLocAll(280.00, udg_Temp_Unit_Point), function Trig_Conscecration_Func019Func008A )
        call RemoveLocation (udg_Temp_Unit_Point)
        if ( Trig_Conscecration_Func019Func010C() ) then
            call StopSoundBJ( gg_snd_FireBallMissileDeath01, false )
            call PlaySoundOnUnitBJ( gg_snd_FireBallMissileDeath01, 55.00, udg_Temp_Unit )
        else
        endif
    else
    endif
    call TriggerSleepAction( 0.95 )
    set udg_Temp_Unit = GetTriggerUnit()
    if ( Trig_Conscecration_Func022C() ) then
        call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
        set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
        set udg_HeroStatCalc = ( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) )
        set udg_Temp_Int = 0
        call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "war3mapImported\\RunningFlameAura.mdx" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        set bj_wantDestroyGroup = true
        call ForGroupBJ( GetUnitsInRangeOfLocAll(280.00, udg_Temp_Unit_Point), function Trig_Conscecration_Func022Func008A )
        call RemoveLocation (udg_Temp_Unit_Point)
        if ( Trig_Conscecration_Func022Func010C() ) then
            call StopSoundBJ( gg_snd_FireBallMissileDeath02, false )
            call PlaySoundOnUnitBJ( gg_snd_FireBallMissileDeath02, 66.00, udg_Temp_Unit )
        else
        endif
    else
    endif
endfunction

