function Trig_S_KnC_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
                       if IsAllianceHero( GetTriggerUnit() ) then
    set udg_TempString = "Kobolds and Catacombs"
    set udg_TempString_Quest = "Travel to the east and recover the stolen treasure."
    call TriggerExecute( gg_trg_Quest_Start_A )
    call DisableTrigger( GetTriggeringTrigger() )
    call DestroyEffectBJ( udg_QuestMarks[76] )
    set udg_TempString = ""
    if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
    set udg_TempString = udg_QuestionMark
    call QuestSetEnabledBJ( true, udg_Quests[76] )
    call FlashQuestDialogButtonBJ(  )
    endif
    call AddSpecialEffectTargetUnitBJ( "overhead", gg_unit_h02O_0681, udg_TempString )
    set udg_QuestMarks[76] = GetLastCreatedEffectBJ()
    call QuestSetCompletedBJ( udg_Quests[76], false )
    call CreateQuestItemBJ( udg_Quests[76], "TRIGSTR_642" )
    set udg_QuestReqs[76] = GetLastCreatedQuestItemBJ()
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Kobold_Cave_South)
