//===========================================================================
// Trigger: L KDS
//===========================================================================
function Trig_L_KDS_Func006Func001C takes nothing returns boolean
    if ( not ( GetItemTypeId(udg_P_Items[( udg_Bag_Num + udg_Bag_Iterator )]) == udg_ItemTypeCheck ) ) then
        return false
    endif
    return true
endfunction

function Trig_L_KDS_Func016C takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_Quests[37]) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_L_KDS_Actions takes nothing returns nothing
    local boolean hasItem
                       if IsAllianceHero( GetTriggerUnit() ) then
    set hasItem = false
    call SetBagNumber( GetOwningPlayer(GetTriggerUnit()) )
    set udg_ItemTypeCheck = 'I05B'
    set udg_Bag_Iterator = 1
    loop
        exitwhen udg_Bag_Iterator > udg_BAG_LOOP_MAX
        if ( Trig_L_KDS_Func006Func001C() ) then
            set hasItem = true
        else
        endif
        set udg_Bag_Iterator = udg_Bag_Iterator + 1
    endloop
    if hasItem == false then
    call CreateTextTagUnitBJ( "TRIGSTR_4813", gg_unit_H01N_0653, 0, 8.00, 100.00, 50.00, 10.00, 0 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
    call cleanUpText( 1.25, 0.85 )
    call UnitAddItemByIdSwapped( 'I05B', GetTriggerUnit() )
    call DisableTrigger( GetTriggeringTrigger() )
    call TriggerSleepAction( udg_ITEM_LOSS_TIMEOUT )
