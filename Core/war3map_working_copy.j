    set gg_trg_Carrion_Swarm_Talent = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Carrion_Swarm_Talent, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Carrion_Swarm_Talent, Condition( function Trig_Carrion_Swarm_Talent_Conditions ) )
    call TriggerAddAction( gg_trg_Carrion_Swarm_Talent, function Trig_Carrion_Swarm_Talent_Actions )
endfunction

//===========================================================================
// Trigger: Wraith Walk
//
// TimerGetRemaining(udg_CheatDeath[heroNumb + 8])
//===========================================================================
function Trig_Wraith_Walk_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0FK' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Wraith_Walk_Actions takes nothing returns nothing
    local location Start_Point
    local location Temp_Unit_Point
    local unit udg_Temp_Unit
    set udg_Temp_Unit = GetTriggerUnit()
    call StopSoundBJ( gg_snd_Wraithwalk_2, false )
    call PlaySoundOnUnitBJ( gg_snd_Wraithwalk_2, 100.00, udg_Temp_Unit )
    call PlayerNumbtoHeroesNumb()
    call TimerStart(udg_DamageTimer[udg_Player_Number], 4.25, false, null)
    call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "war3mapImported\\Singularity I White.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call SetUnitVertexColorBJ( GetTriggerUnit(), 100.00, 100.00, 100.00, 45.00 )
    call UnitRemoveBuffsBJ( bj_REMOVEBUFFS_NEGATIVE, GetTriggerUnit() )
    call UnitAddAbility(udg_Temp_Unit, 'Aeth')
    call SetUnitPathing( udg_Temp_Unit, false )
    call BlzSetUnitWeaponBooleanFieldBJ( GetTriggerUnit(), UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, false )
    call BlzSetUnitWeaponBooleanFieldBJ( GetTriggerUnit(), UNIT_WEAPON_BF_ATTACKS_ENABLED, 1, false )
    call WraithWalkSilence(udg_Temp_Unit)
    set Start_Point = GetUnitLoc(udg_Temp_Unit)
    call GameTimeWait(4.0)
    // after 4 s
    call StopSoundBJ( gg_snd_ObsidianAvengerDeath1, false )
    call PlaySoundOnUnitBJ( gg_snd_ObsidianAvengerDeath1, 100.00, udg_Temp_Unit )
    call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "war3mapImported\\Singularity I White.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call SetUnitVertexColorBJ( GetTriggerUnit(), 100, 100, 100, 0 )
    call UnitRemoveAbility(udg_Temp_Unit, 'Aeth')
    call SetUnitPathing( udg_Temp_Unit, true )
    call BlzSetUnitWeaponBooleanFieldBJ( GetTriggerUnit(), UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, true )
    call BlzSetUnitWeaponBooleanFieldBJ( GetTriggerUnit(), UNIT_WEAPON_BF_ATTACKS_ENABLED, 1, true )
    call WraithWalkRemoveSilence(udg_Temp_Unit)
    // Finally Check if it's a valid end point
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
    if IsTerrainPathable( GetLocationX(udg_Temp_Unit_Point), GetLocationY(udg_Temp_Unit_Point), PATHING_TYPE_WALKABILITY) then
     call SetUnitPositionLoc( udg_Temp_Unit, Start_Point )
    endif
    call RemoveLocation (udg_Temp_Unit_Point)
    call RemoveLocation (Start_Point)
    set udg_Temp_Unit = null
    set udg_Temp_Unit_Point = null
    set Start_Point = null
    return
    call AddAndHideSpell(udg_Temp_Unit, 'Aeth')
endfunction

//===========================================================================
function InitTrig_Wraith_Walk takes nothing returns nothing
    set gg_trg_Wraith_Walk = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Wraith_Walk, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Wraith_Walk, Condition( function Trig_Wraith_Walk_Conditions ) )
    call TriggerAddAction( gg_trg_Wraith_Walk, function Trig_Wraith_Walk_Actions )
endfunction

//===========================================================================
// Trigger: Summons Gargoyle
//===========================================================================
function Trig_Summons_Gargoyle_Func004C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetSummonedUnit()) == 'u03V' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetSummonedUnit()) == 'u03W' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetSummonedUnit()) == 'u03X' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Summons_Gargoyle_Conditions takes nothing returns boolean
    if ( not Trig_Summons_Gargoyle_Func004C() ) then
        return false
    endif
    return true
endfunction

function Trig_Summons_Gargoyle_Actions takes nothing returns nothing
    call SetUnitAbilityLevelSwapped( 'Astn', GetSummonedUnit(), ( GetUnitLevel(GetSummonedUnit()) / 11 ) )
    set udg_HeroStatCalc = ( GetHeroStatBJ(bj_HEROSTAT_STR, GetSummoningUnit(), true) * 2 )
    call BlzSetUnitWeaponIntegerFieldBJ( GetSummonedUnit(), UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 0, ( BlzGetUnitBaseDamage(GetSummonedUnit(), 0) + udg_HeroStatCalc ) )
    return
    set udg_Temp_Unit = GetSummoningUnit()
    call SetUnitAbilityLevelSwapped( 'A00A', GetSummonedUnit(), ( GetUnitLevel(GetSummonedUnit()) / 13 ) )
    call SetUnitAbilityLevelSwapped( 'A07D', GetSummonedUnit(), ( GetUnitLevel(GetSummonedUnit()) / 13 ) )
endfunction

//===========================================================================
function InitTrig_Summons_Gargoyle takes nothing returns nothing
    set gg_trg_Summons_Gargoyle = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Summons_Gargoyle, EVENT_PLAYER_UNIT_SUMMON )
    call TriggerAddCondition( gg_trg_Summons_Gargoyle, Condition( function Trig_Summons_Gargoyle_Conditions ) )
    call TriggerAddAction( gg_trg_Summons_Gargoyle, function Trig_Summons_Gargoyle_Actions )
endfunction

//===========================================================================
// Trigger: Bonestorm
//
// Deals 50/75/100 dmg + Numb of Stacks x Armor, and grants a shield for that same amount, but removes all current stacks of shield
// Non-player safe
// Shield and Stacks ignored if used by non-player
//===========================================================================
function Trig_Bonestorm_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0FJ' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Bonestorm_Func012C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 2) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Bonestorm_Func024A takes nothing returns nothing
    if IsUnitTargetableEnemy( GetEnumUnit(), udg_Temp_Unit) then
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "Abilities\\Spells\\Undead\\DeathCoil\\DeathCoilSpecialArt.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_Bonestorm_Actions takes nothing returns nothing
    local effect b1
    local effect b2
    local location udg_Temp_Unit_Point
    if GetBoneShieldLevel(GetTriggerUnit()) == 0 then
    call IssueImmediateOrderBJ( GetTriggerUnit(), "stop" )
    call SetUnitManaBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) + I2R(BlzGetAbilityManaCost('A0FJ', ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ))) ) )
    call Debug( "Not enough stacks of bone armor.")
    call ErrorMessage( "Not enough stacks of bone armor.", GetOwningPlayer(GetTriggerUnit()) )
    else
    // Has Enough Stacks
    set udg_Temp_Unit = GetTriggerUnit()
    if ( Trig_Bonestorm_Func012C() ) then
        call PlaySoundOnUnit("war3mapImported\\Bonestorm2.mp3", GetTriggerUnit() )
    else
        call PlaySoundOnUnit("war3mapImported\\Bonestorm3.mp3", GetTriggerUnit() )
    endif
    set udg_RealStatCalc = BlzGetUnitRealField(udg_Temp_Unit, UNIT_RF_DEFENSE)
    if GetTriggerUnit() == udg_Rattlegore then
    set udg_RealStatCalc = ( 12.00 * udg_RealStatCalc )
    else
    set udg_RealStatCalc = ( 5.00 * udg_RealStatCalc )
    endif
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_Temp_Unit) * 50 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 50 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    call NewShield( udg_Temp_Unit, udg_RealStatCalc, 99 )
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
    call ForGroupBJ( GetUnitsInRangeOfLocAll(300.00, udg_Temp_Unit_Point), function Trig_Bonestorm_Func024A )
    // Effects
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Soul Armor Necro_opt.mdx" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 1.36 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Soul Armor Necro_opt.mdx" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 2.04 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Soul Armor Necro_opt.mdx" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 2.72 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Bone Guard.mdx" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 2.00 )
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), ( -50.00 + BlzGetLocalSpecialEffectZ(GetLastCreatedEffectBJ()) ) )
    set b1 = GetLastCreatedEffectBJ()
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Bone Guard.mdx" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 2.80 )
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), ( -100.00 + BlzGetLocalSpecialEffectZ(GetLastCreatedEffectBJ()) ) )
    set b2 = GetLastCreatedEffectBJ()
    call RemoveLocation (udg_Temp_Unit_Point)
    call GameTimeWait(0.4)
    call DestroyEffectBJ(b1)
    call DestroyEffectBJ(b2)
    endif
    // Clean Up
    set b1 = null
    set b2 = null
    set udg_Temp_Unit_Point = null
endfunction

//===========================================================================
function InitTrig_Bonestorm takes nothing returns nothing
    set gg_trg_Bonestorm = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Bonestorm, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Bonestorm, Condition( function Trig_Bonestorm_Conditions ) )
    call TriggerAddAction( gg_trg_Bonestorm, function Trig_Bonestorm_Actions )
endfunction

//===========================================================================
// Trigger: Blood Plague Passive
//===========================================================================
function Trig_Blood_Plague_Passive_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    local real udg_RealStatCalc
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_HeroStatCalc = ( GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, false) )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    set udg_RealStatCalc = ( 0.50 * udg_RealStatCalc )
    set udg_RealStatCalc = ( 80.00 + udg_RealStatCalc )
    // Move the Unit
    set udg_Temp_Unit = gg_unit_e00H_2048
    call SetUnitOwner( udg_Temp_Unit, GetOwningPlayer(GetTriggerUnit()), true )
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    call SetUnitPositionLocFacingBJ( udg_Temp_Unit, udg_Temp_Unit_Point, GetUnitFacing(GetTriggerUnit()) )
    call RemoveLocation (udg_Temp_Unit_Point)
    // Order to Cast
    call SetUnitAbilityLevelSwapped( 'A03H', udg_Temp_Unit, 4 )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A03H'), ABILITY_RLF_PRIMARY_DAMAGE, 3, udg_RealStatCalc )
    call IssueTargetOrderBJ( gg_unit_e00H_2048, "acidbomb", GetSpellTargetUnit() )
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_Temp_Unit_Point = null
endfunction

//===========================================================================
function InitTrig_Blood_Plague_Passive takes nothing returns nothing
    set gg_trg_Blood_Plague_Passive = CreateTrigger(  )
    call TriggerAddAction( gg_trg_Blood_Plague_Passive, function Trig_Blood_Plague_Passive_Actions )
endfunction

//===========================================================================
// Trigger: Deaths Grasp Orc
//
// Calculate the distance between Position of Unit
// Dont create chain units move them back and forth between island
//===========================================================================
function Trig_Deaths_Grasp_Orc_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0DG' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'U01U' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Deaths_Grasp_Orc_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_A_DeathsGraspTarget[0] = GetSpellTargetUnit()
    set udg_Point_Charge_End[6] = GetUnitLoc(GetSpellAbilityUnit())
    set udg_Point_Charge_Begin[6] = GetUnitLoc(GetSpellTargetUnit())
    set udg_Chain_Target[1] = GetSpellTargetUnit()
    set udg_Charge_Distance = DistanceBetweenPoints(udg_Point_Charge_Begin[6], udg_Point_Charge_End[6])
    set udg_Temp_Angle = AngleBetweenPoints(udg_Point_Charge_Begin[6], udg_Point_Charge_End[6])
    set udg_Chain_Terminator_Orc = ( R2I(( udg_Charge_Distance / 50.00 )) - 1 )
    // bloodplague
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 14 ]  then
    call TriggerExecute(gg_trg_Blood_Plague_Passive)
    endif
    // Create Distance / 50 chains (1 ~ 10)
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = udg_Chain_Terminator_Orc
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Point_Charge_Begin[6], ( 50.00 * I2R(GetForLoopIndexA()) ), udg_Temp_Angle)
        call CreateNUnitsAtLocFacingLocBJ( 1, 'e024', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, udg_Point_Charge_End[6] )
        call RemoveLocation (udg_Temp_Polar_Point)
        set udg_Chain_Units_Orc[GetForLoopIndexA()] = GetLastCreatedUnit()
        call SetUnitVertexColorBJ( GetLastCreatedUnit(), 58.82, 19.60, 78.43, 12.00 )
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    // make wolf face angle
    call BlzSetUnitFacingEx( udg_A_DeathsGraspTarget[0], udg_RealStatCalc )
    // Turn on Every .05 sec
    call AddSpecialEffectTargetUnitBJ( "chest", udg_A_DeathsGraspTarget[0], "war3mapImported\\Psionic Shot Purple.mdx" )
    set udg_Charge_SE[6] = GetLastCreatedEffectBJ()
    set udg_i_Chain_Orc = 0
    call TriggerSleepAction( 0.28 )
    // playsound
    call EnableTrigger( gg_trg_Charge_Deaths_Grasp_ORC )
endfunction

//===========================================================================
function InitTrig_Deaths_Grasp_Orc takes nothing returns nothing
    set gg_trg_Deaths_Grasp_Orc = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Deaths_Grasp_Orc, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Deaths_Grasp_Orc, Condition( function Trig_Deaths_Grasp_Orc_Conditions ) )
    call TriggerAddAction( gg_trg_Deaths_Grasp_Orc, function Trig_Deaths_Grasp_Orc_Actions )
endfunction

//===========================================================================
// Trigger: Charge Deaths Grasp ORC
//
// Set point position of chain
// Move Chain instantly Back to island
// then move wolf to point (if can be done)
// after charge loop iterations deal damage
//===========================================================================
function Trig_Charge_Deaths_Grasp_ORC_Func001C takes nothing returns boolean
    if ( not ( udg_i_Chain_Orc <= udg_Chain_Terminator_Orc ) ) then
        return false
    endif
    return true
endfunction

function Trig_Charge_Deaths_Grasp_ORC_Actions takes nothing returns nothing
    if ( Trig_Charge_Deaths_Grasp_ORC_Func001C() ) then
        set udg_Temp_Unit_Point = GetUnitLoc(udg_Chain_Units_Orc[udg_i_Chain_Orc])
        call RemoveUnit( udg_Chain_Units_Orc[udg_i_Chain_Orc] )
        if not IsTerrainPathable( GetLocationX(udg_Temp_Unit_Point), GetLocationY(udg_Temp_Unit_Point), PATHING_TYPE_WALKABILITY) then
        call SetUnitPositionLoc( udg_A_DeathsGraspTarget[0], udg_Temp_Unit_Point )
        endif
        call RemoveLocation (udg_Temp_Unit_Point)
        set udg_i_Chain_Orc = ( udg_i_Chain_Orc + 1 )
    else
        call RemoveLocation (udg_Point_Charge_Begin[6])
        call RemoveLocation (udg_Point_Charge_End[6])
        call DestroyEffectBJ( udg_Charge_SE[6] )
        set udg_Temp_Unit = udg_yH_Blood_DK
        set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, false) ))
          call UnitDamageTargetBJ( udg_yA_Blood_DK, udg_Chain_Target[2], ( 4.00 * udg_RealStatCalc ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        call DisableTrigger( GetTriggeringTrigger() )
    endif
endfunction

//===========================================================================
function InitTrig_Charge_Deaths_Grasp_ORC takes nothing returns nothing
    set gg_trg_Charge_Deaths_Grasp_ORC = CreateTrigger(  )
    call DisableTrigger( gg_trg_Charge_Deaths_Grasp_ORC )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Charge_Deaths_Grasp_ORC, 0.03 )
    call TriggerAddAction( gg_trg_Charge_Deaths_Grasp_ORC, function Trig_Charge_Deaths_Grasp_ORC_Actions )
endfunction

