    if ( not ( GetHeroLevel(GetTriggerUnit()) >= udg_FINALS_LEVEL_3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Bal_Druid_Max_Func011C takes nothing returns boolean
    if ( not ( GetHeroLevel(GetTriggerUnit()) >= udg_FINALS_LEVEL_2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Bal_Druid_Max_Actions takes nothing returns nothing
    call UnitAddAbilityBJ( 'A0CZ', GetTriggerUnit() )
    call UnitMakeAbilityPermanent(GetTriggerUnit(), true, 'A0CZ')
    call ForForce( udg_AlliancePlayers, function Trig_Bal_Druid_Max_Func003A )
    call ForForce( udg_HordePlayers, function Trig_Bal_Druid_Max_Func004A )
    if ( Trig_Bal_Druid_Max_Func005C() ) then
        call SetPlayerAbilityAvailableBJ( true, 'A0CZ', GetOwningPlayer(GetTriggerUnit()) )
    else
    endif
    call UnitAddAbilityBJ( 'A03B', GetTriggerUnit() )
    call UnitMakeAbilityPermanent(GetTriggerUnit(), true, 'A03B')
    call ForForce( udg_AlliancePlayers, function Trig_Bal_Druid_Max_Func008A )
    call ForForce( udg_HordePlayers, function Trig_Bal_Druid_Max_Func009A )
    if ( Trig_Bal_Druid_Max_Func010C() ) then
        call SetPlayerAbilityAvailableBJ( true, 'A03B', GetOwningPlayer(GetTriggerUnit()) )
    else
    endif
    if ( Trig_Bal_Druid_Max_Func011C() ) then
        call SetUnitAbilityLevelSwapped( 'A03B', GetTriggerUnit(), 2 )
        call SetUnitAbilityLevelSwapped( 'A091', GetTriggerUnit(), 2 )
        call SetUnitAbilityLevelSwapped( 'A0CZ', GetTriggerUnit(), 2 )
        call SetUnitAbilityLevelSwapped( 'A0E1', GetTriggerUnit(), 2 )
        call SetUnitAbilityLevelSwapped( 'A0E4', GetTriggerUnit(), 2 )
        if ( Trig_Bal_Druid_Max_Func011Func006C() ) then
            call SetUnitAbilityLevelSwapped( 'A03B', GetTriggerUnit(), 3 )
            call SetUnitAbilityLevelSwapped( 'A091', GetTriggerUnit(), 3 )
            call SetUnitAbilityLevelSwapped( 'A0CZ', GetTriggerUnit(), 3 )
            call SetUnitAbilityLevelSwapped( 'A0E1', GetTriggerUnit(), 3 )
            call SetUnitAbilityLevelSwapped( 'A0E4', GetTriggerUnit(), 3 )
        else
        endif
    else
    endif
endfunction

