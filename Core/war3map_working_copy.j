    call TriggerAddCondition( gg_trg_Power_Word_Barrier, Condition( function Trig_Power_Word_Barrier_Conditions ) )
    call TriggerAddAction( gg_trg_Power_Word_Barrier, function Trig_Power_Word_Barrier_Actions )
endfunction

//===========================================================================
// Trigger: Power Word Barrier Tick A
//===========================================================================
function Trig_Power_Word_Barrier_Tick_A_Func002Func009A takes nothing returns nothing
    if IsUnitTargetableAlly( GetEnumUnit(), udg_Temp_Unit) then
    call ApplyPowerWordBarrier( udg_Temp_Unit, GetEnumUnit() )
    endif
endfunction

function Trig_Power_Word_Barrier_Tick_A_Func002C takes nothing returns boolean
    if ( not ( udg_SpellTicks[udg_Temp_Int] < 22 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Power_Word_Barrier_Tick_A_Actions takes nothing returns nothing
    set udg_Temp_Int = 40
    if ( Trig_Power_Word_Barrier_Tick_A_Func002C() ) then
        set udg_Temp_Unit = udg_yA_Disc_Priest
        set udg_o = udg_z_PR_DISC_A
        set udg_o = ( udg_o + 12 )
        set udg_Temp_Unit_Point = GetUnitLoc(udg_SpellUnits[udg_o])
        call PowerWordBarrierEffect()
        set bj_wantDestroyGroup = true
        call ForGroupBJ( GetUnitsInRangeOfLocAll(( 220.00 + ( 25.00 * I2R(GetUnitAbilityLevelSwapped('A0FT', udg_Temp_Unit)) ) ), udg_Temp_Unit_Point), function Trig_Power_Word_Barrier_Tick_A_Func002Func009A )
        call RemoveLocation (udg_Temp_Unit_Point)
        set udg_SpellTicks[udg_Temp_Int] = ( udg_SpellTicks[udg_Temp_Int] + 1 )
    else
        call DisableTrigger( GetTriggeringTrigger() )
    endif
endfunction

