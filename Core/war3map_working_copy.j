    set gg_trg_Devouring_Plague = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Devouring_Plague, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Devouring_Plague, Condition( function Trig_Devouring_Plague_Conditions ) )
    call TriggerAddAction( gg_trg_Devouring_Plague, function Trig_Devouring_Plague_Actions )
endfunction

//===========================================================================
// Trigger: DevouringPlagueTick DW
//===========================================================================
function Trig_DevouringPlagueTick_DW_Func004C takes nothing returns boolean
    if ( not ( udg_DPOrbNumberDW > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_DevouringPlagueTick_DW_Func005C takes nothing returns boolean
    if ( not ( udg_SpellTicks[8] == 5 ) ) then
        return false
    endif
    return true
endfunction

function Trig_DevouringPlagueTick_DW_Actions takes nothing returns nothing
    local unit udg_Temp_Unit = udg_yA_Shadow_Priest
    set udg_SpellTicks[8] = ( udg_SpellTicks[8] + 1 )
    if ( Trig_DevouringPlagueTick_DW_Func004C() ) then
        set udg_DPOrbNumberDW = ( udg_DPOrbNumberDW - 1 )
        call DestroyEffectBJ( udg_DPOrbEffectsDW[udg_DPOrbNumberDW] )
        call PlaySoundOnUnitBJ( gg_snd_AntiMagicShellBirth1, 90.00, udg_Temp_Unit )
        call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "Abilities\\Spells\\Undead\\DeathPact\\DeathPactCaster.mdl" )
        set udg_DPOrbEffectsDW[3] = GetLastCreatedEffectBJ()
        call TriggerSleepAction( 1.00 )
        call DestroyEffectBJ( udg_DPOrbEffectsDW[3] )
        set udg_RealStatCalc =  GetUnitState(udg_Temp_Unit, UNIT_STATE_MAX_LIFE ) /8
        // Set Chalice
        if ChaliceCheck() then
        set udg_RealStatCalc = ( ( udg_CHALICE_HEAL * udg_RealStatCalc ) + udg_RealStatCalc )
        endif
        set udg_RealStatCalc =  GetUnitState(udg_Temp_Unit, UNIT_STATE_LIFE ) + udg_RealStatCalc
        call SetUnitState(udg_Temp_Unit, UNIT_STATE_LIFE, udg_RealStatCalc )
        call PlaySoundOnUnitBJ( gg_snd_HealTarget, 90.00, udg_Temp_Unit )
        call AddSpecialEffectTargetUnitBJ( "chest", udg_Temp_Unit, "Abilities\\Spells\\Human\\Heal\\HealTarget.mdl" )
        set udg_DPOrbEffectsDW[3] = GetLastCreatedEffectBJ()
        call TriggerSleepAction( 0.20 )
        call DestroyEffectBJ( udg_DPOrbEffectsDW[3] )
        call ComboPointFrameSetPoints( udg_yA_Shadow_Priest, udg_DPOrbNumberDW)
    else
    endif
    if ( Trig_DevouringPlagueTick_DW_Func005C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
    else
    endif
    set udg_Temp_Unit = null
endfunction

//===========================================================================
function InitTrig_DevouringPlagueTick_DW takes nothing returns nothing
    set gg_trg_DevouringPlagueTick_DW = CreateTrigger(  )
    call DisableTrigger( gg_trg_DevouringPlagueTick_DW )
    call TriggerRegisterTimerEventPeriodic( gg_trg_DevouringPlagueTick_DW, 2 )
    call TriggerAddAction( gg_trg_DevouringPlagueTick_DW, function Trig_DevouringPlagueTick_DW_Actions )
endfunction

