//===========================================================================
// Trigger: Sylvanas Haunting Wave
//===========================================================================
function Trig_Sylvanas_Haunting_Wave_Actions takes nothing returns nothing
    local unit target = BlzGetEventDamageTarget()      // Sylvanas (victim)
    local unit source = GetEventDamageSource()         // attacker / source unit
    local real tx
    local real ty
    local real sx
    local real sy
    local real angDeg
    local location castLoc

    // --- Basic sanity / filters ---
    // Only react if the target is actually Sylvanas (since you registered the unit event, this is mostly redundant)
    if target != gg_unit_Usyl_0179 then
        set target = null
        set source = null
        return
    endif

    // Only if source is a hero
    if source == null or IsUnitType(source, UNIT_TYPE_HERO) == false then
        set target = null
        set source = null
        return
    endif

    // Target life threshold
    if GetUnitState(target, UNIT_STATE_LIFE) >= 5000.00 then
        set target = null
        set source = null
        return
    endif

    // Must be within 1000 range
    set tx = GetUnitX(target)
    set ty = GetUnitY(target)
    set sx = GetUnitX(source)
    set sy = GetUnitY(source)

    if SquareRoot((tx - sx) * (tx - sx) + (ty - sy) * (ty - sy)) > 1000.00 then
        set target = null
        set source = null
        return
    endif

    // --- Refund / reset ---
    call UnitResetCooldown(target)
    call SetUnitState(target, UNIT_STATE_MANA, GetUnitState(target, UNIT_STATE_MANA) + 200.00)
    call UnitRemoveBuffsBJ( bj_REMOVEBUFFS_NEGATIVE, GetTriggerUnit() )

    // Angle from target -> source, in degrees (PolarProjectionBJ expects degrees)
    set angDeg = bj_RADTODEG * Atan2(sy - ty, sx - tx)

    // Choose cast point (your original logic, but using target/source explicitly)
    // Original condition: target life > source life AND target life > 1800 => short hop forward, else big retreat
    if GetUnitState(target, UNIT_STATE_LIFE) > GetUnitState(source, UNIT_STATE_LIFE) and GetUnitState(target, UNIT_STATE_LIFE) > 1800.00 then
        set castLoc = Location(sx + 80.00 * Cos(angDeg * bj_DEGTORAD), sy + 80.00 * Sin(angDeg * bj_DEGTORAD))
    else
        set castLoc = Location(sx - 400.00 * Cos(angDeg * bj_DEGTORAD), sy - 400.00 * Sin(angDeg * bj_DEGTORAD))
    endif

    call IssuePointOrderLocBJ(target, "carrionswarm", castLoc)
    call RemoveLocation(castLoc)
    set castLoc = null

    // --- Cooldown gate (wait-safe) ---
    call DisableTrigger(gg_trg_Sylvanas_Haunting_Wave)
    call TriggerSleepAction(15.00)
    call EnableTrigger(gg_trg_Sylvanas_Haunting_Wave)

    set target = null
    set source = null
endfunction

function InitTrig_Sylvanas_Haunting_Wave takes nothing returns nothing
    set gg_trg_Sylvanas_Haunting_Wave = CreateTrigger()
    call TriggerRegisterUnitEvent(gg_trg_Sylvanas_Haunting_Wave, gg_unit_Usyl_0179, EVENT_UNIT_DAMAGED)
    call TriggerAddAction(gg_trg_Sylvanas_Haunting_Wave, function Trig_Sylvanas_Haunting_Wave_Actions)
endfunction

