    call KillDestructable( GetEnumDestructable() )
endfunction

function Trig_Bridge_Death_Func011A takes nothing returns nothing
    call GroupAddUnitSimple( GetEnumUnit(), udg_MagmaBuddies )
endfunction

function Trig_Bridge_Death_Func014Func001C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) == 'B01U' ) ) then
        return false
    endif
    return true
endfunction

