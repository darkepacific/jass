//===========================================================================
// Trigger: C BLD
//
// Look into faction vision
//    
//    
//===========================================================================
function Trig_C_BLD_Func161Func001Func001Func003C takes nothing returns boolean
    if ( not ( GetPlayerController(GetOwningPlayer(GetEnumUnit())) == MAP_CONTROL_USER ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnumUnit()) == 'nrdr' ) ) then
        return false
    endif
    return true
endfunction

function Trig_C_BLD_Func161Func001Func001C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetEnumUnit()) == 'nrwm' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEnumUnit()) == 'nbwm' ) ) then
        return true
    endif
    if ( Trig_C_BLD_Func161Func001Func001Func003C() ) then
        return true
    endif
    return false
endfunction

function Trig_C_BLD_Func161Func001C takes nothing returns boolean
    if ( not Trig_C_BLD_Func161Func001Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_C_BLD_Func161A takes nothing returns nothing
    if ( Trig_C_BLD_Func161Func001C() ) then
        call KillUnit(GetEnumUnit())
    else
    endif
endfunction

function Trig_C_BLD_Actions takes nothing returns nothing
    local boolean skip_End = false
    local location udg_Temp_Unit_Point
    local location udg_Temp_Polar_Point
    local location udg_Temp_X_Point
    local real udg_RealStatCalc = 0
    local unit DW 
    local unit ST
    local unit Red
    local unit Black
    local effect eff
    local effect eff2
    local fogmodifier fog
    local fogmodifier fog2
    local force udg_Player_Message_Group = CreateForce()
    // set the faction
    local boolean isAlliance = false
    local boolean isHorde = false
    if udg_Faction == 0 then
    call ForceAddPlayerSimple( Player(2), udg_Player_Message_Group )
    call ForceAddPlayerSimple( Player(7), udg_Player_Message_Group )
    call ForceAddPlayerSimple( Player(8), udg_Player_Message_Group )
    call ForceAddPlayerSimple( Player(9), udg_Player_Message_Group )
    call ForceAddPlayerSimple( Player(13), udg_Player_Message_Group )
    set isAlliance = true
    elseif udg_Faction == 1 then
    call ForceAddPlayerSimple( Player(4), udg_Player_Message_Group )
    call ForceAddPlayerSimple( Player(5), udg_Player_Message_Group )
    call ForceAddPlayerSimple( Player(6), udg_Player_Message_Group )
    call ForceAddPlayerSimple( Player(10), udg_Player_Message_Group )
    call ForceAddPlayerSimple( Player(12), udg_Player_Message_Group )
    set isHorde = true
    endif
    // Vision
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Q_Battle_of_Life_and_Death_Fly_Zone)
    if isAlliance then
    call CreateFogModifierRadiusLocBJ( true, Player(1), FOG_OF_WAR_VISIBLE, udg_Temp_Unit_Point, 1250.00 )
    else
    call CreateFogModifierRadiusLocBJ( true, Player(0), FOG_OF_WAR_VISIBLE, udg_Temp_Unit_Point, 1250.00 )
    endif
    set fog = GetLastCreatedFogModifier()
    call RemoveLocation (udg_Temp_Unit_Point)
    // Vision 2
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Battle_of_Life_and_Death_Quest_Start)
    if isAlliance then
    call CreateFogModifierRadiusLocBJ( true, Player(1), FOG_OF_WAR_VISIBLE, udg_Temp_Unit_Point, 800.00 )
    else
    call CreateFogModifierRadiusLocBJ( true, Player(0), FOG_OF_WAR_VISIBLE, udg_Temp_Unit_Point, 800.00 )
    endif
    set fog2 = GetLastCreatedFogModifier()
    call RemoveLocation (udg_Temp_Unit_Point)
    // Dont Skip if Already on else wait for End and Skip
    if IsTriggerEnabled(gg_trg_P_BLD) == false then
    set udg_QuestBLD_Wait = false
    else
    set skip_End = true
    loop
    exitwhen udg_QuestBLD_B_A >= 7 and udg_QuestBLD_R_A >= 4 and udg_QuestBLD_Wait 
    call TriggerSleepAction( 0.50 )
    endloop
    if isAlliance then
    call TriggerExecute(gg_trg_E_BLD_A)
    else
    call TriggerExecute(gg_trg_E_BLD_H)
    endif
    call TriggerSleepAction( 0.50 )
    call TriggerSleepAction( 0.50 )
    call TriggerSleepAction( 2.20 )
    call TriggerSleepAction( 0.30 )
    call TriggerSleepAction( 2.00 )
    call TriggerSleepAction( 5.00 )
    call TriggerSleepAction( 2.50 )
    call TriggerSleepAction( 1.00 )
    endif
    if not skip_End then
    // Create DW
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_BLD_DW)
    call CreateNUnitsAtLoc( 1, 'E034', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Temp_Unit_Point, 70.00 )
    set DW = GetLastCreatedUnit()
     call SetUnitScale( DW, 0.9, 0.9, 0.9)
    call SetUnitAnimation( DW, "Stand Alternate")
    call SetHeroLevel( DW, 60, false)
    call PauseAddInvuln( DW, null)
    call RemoveLocation (udg_Temp_Unit_Point)
    // Create ST
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_BLD_Strasza)
    call CreateNUnitsAtLoc( 1, 'E04L', Player(PLAYER_NEUTRAL_PASSIVE), udg_Temp_Unit_Point, 245.00 )
    set ST = GetLastCreatedUnit()
     call SetUnitScale( ST, 1.33, 1.33, 1.33)
    call SetHeroLevel( ST, 60, false)
    call SetUnitColor( ST, ConvertPlayerColor(12) )
    call PauseAddInvuln( ST, null)
    call RemoveLocation (udg_Temp_Unit_Point)
    // Create Dragons
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Q_Battle_of_Life_and_Death_Fly_Zone)
    set udg_RealStatCalc = -135.00
    set bj_forLoopBIndex = 1
    set bj_forLoopBIndexEnd = 4
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, GetRandomReal(860.00, 920.00), udg_RealStatCalc)
        call CreateNUnitsAtLoc( 1, 'nrwm', Player(PLAYER_NEUTRAL_PASSIVE), udg_Temp_Polar_Point, GetRandomDirectionDeg() )
         call SetUnitScale( GetLastCreatedUnit(), 0.85, 0.85, 0.85)
        set Red = GetLastCreatedUnit()
        set udg_Temp_X_Point = PolarProjectionBJ(udg_Temp_Polar_Point, 165.00, GetRandomDirectionDeg())
        call CreateNUnitsAtLoc( 1, 'nbwm', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Temp_X_Point, GetRandomDirectionDeg() )
         call SetUnitScale( GetLastCreatedUnit(), 0.85, 0.85, 0.85)
        set Black = GetLastCreatedUnit()
        call RemoveLocation (udg_Temp_X_Point)
        call RemoveLocation (udg_Temp_Polar_Point)
         call IssueTargetOrderBJ(Black, "attack", Red)
         call IssueTargetOrderBJ(Red, "attack", Black)
        set udg_RealStatCalc = ( udg_RealStatCalc + GetRandomReal(72.00, 82.00) )
        set bj_forLoopBIndex = bj_forLoopBIndex + 1
    endloop
    set bj_forLoopBIndex = 1
    set bj_forLoopBIndexEnd = 3
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, GetRandomReal(820.00, 880.00), ( udg_RealStatCalc + ( 10.00 * I2R(GetForLoopIndexB()) ) ))
        set udg_Temp_X_Point = PolarProjectionBJ(udg_Temp_Polar_Point, 10.00, GetRandomDirectionDeg())
        call CreateNUnitsAtLoc( 1, 'nbwm', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Temp_X_Point, GetRandomDirectionDeg() )
         call SetUnitScale( GetLastCreatedUnit(), 0.85, 0.85, 0.85)
        set Black = GetLastCreatedUnit()
        call RemoveLocation (udg_Temp_X_Point)
        call RemoveLocation (udg_Temp_Polar_Point)
        set udg_RealStatCalc = ( udg_RealStatCalc + 100.00 )
        set bj_forLoopBIndex = bj_forLoopBIndex + 1
    endloop
    call RemoveLocation (udg_Temp_Unit_Point)
    // Fight Dialogue
    loop
    exitwhen udg_QuestBLD_B_A >= 7 and udg_QuestBLD_R_A >= 4 and udg_QuestBLD_Wait 
    call TriggerSleepAction( 0.50 )
    endloop
    if isAlliance then
    call TriggerExecute(gg_trg_E_BLD_A)
    else
    call TriggerExecute(gg_trg_E_BLD_H)
    endif
    call DisableTrigger(gg_trg_P_BLD)
    call TriggerSleepAction( 0.50 )
    call StopSoundBJ( gg_snd_DW_Roar_2, false )
    call StopSoundBJ( gg_snd_DW_Roar_3, false )
    call StopSoundBJ( gg_snd_DW_IShallTearThisWorldApart, false )
    call StopSoundBJ( gg_snd_Straza_NeltharionLookAtYourself, false )
    call TriggerSleepAction( 0.50 )
    // Final Blow
    call PauseUnit( DW , false )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_BLD_DW)
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_BLD_Strasza)
    call IssuePointOrderLocBJ( DW, "rainoffire", udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call SetUnitAnimation( ST, "Spell Slam" )
    call QueueUnitAnimation( ST, "Spell Slam" )
    call DestroyEffect( AddSpecialEffectTargetUnitBJ("chest", ST, "Objects\\Spawnmodels\\Orc\\Orcblood\\BattrollBlood.mdl") )
    call DestroyEffect( AddSpecialEffectTargetUnitBJ("origin", ST, "Objects\\Spawnmodels\\Orc\\Orcblood\\BattrollBlood.mdl") )
    call TriggerSleepAction( 2.20 )
    // ST Fly Away
    call PauseUnit( ST, false )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_BLD_Strasza)
    call StopSoundBJ( gg_snd_VO_QE_TH_Alexstrasza_WoundCritical01, false )
    call PlaySoundAtPointBJ( gg_snd_VO_QE_TH_Alexstrasza_WoundCritical01, 100, udg_Temp_Unit_Point, 2000.00 )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Enter_the_Draqon_Queen_Start)
    call IssuePointOrderLoc( ST, "move", udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 0.30 )
    call DestroyEffect( AddSpecialEffectTargetUnitBJ("chest", ST, "Objects\\Spawnmodels\\Orc\\Orcblood\\BattrollBlood.mdl") )
    call DestroyEffect( AddSpecialEffectTargetUnitBJ("origin", ST, "Objects\\Spawnmodels\\Orc\\Orcblood\\BattrollBlood.mdl") )
    // DW Fly Away
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Dalaran_Suramar)
    call IssuePointOrderLoc( DW, "move", udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_BLD_DW)
    call TransmissionFromUnitTypeWithNameBJ( udg_Player_Message_Group, Player(PLAYER_NEUTRAL_AGGRESSIVE), 'E034', "TRIGSTR_7285", udg_Temp_Unit_Point, null, "TRIGSTR_7286", bj_TIMETYPE_ADD, 8.00, false )
    call PlaySoundAtPointBJ( gg_snd_DW_Fly_Away, 100, udg_Temp_Unit_Point, 2000.00 )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 2.00 )
    call DestroyEffect( AddSpecialEffectTargetUnitBJ("chest", ST, "Objects\\Spawnmodels\\Orc\\Orcblood\\BattrollBlood.mdl") )
    call DestroyEffect( AddSpecialEffectTargetUnitBJ("origin", ST, "Objects\\Spawnmodels\\Orc\\Orcblood\\BattrollBlood.mdl") )
    call TriggerSleepAction( 5.00 )
    call SetUnitVertexColorBJ( ST, 0, 0, 0, 0 )
    call PauseUnit( ST , true )
    call KillUnit( ST )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Dalaran_Suramar)
    call IssuePointOrderLoc( DW, "move", udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 2.50 )
    // Kill
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRectAll(gg_rct_Q_Battle_of_Life_and_Death_Fly_Zone), function Trig_C_BLD_Func161A )
    call SetUnitVertexColorBJ( DW, 0, 0, 0, 0 )
    call SetUnitVertexColorBJ( ST, 0, 0, 0, 0 )
    call PauseUnit( ST , true )
    call PauseUnit( DW , true )
    call TriggerSleepAction( 1.00 )
    //call DestroyEffect( eff)
    //call DestroyEffect( eff2)
    call RemoveUnit(ST)
    call RemoveUnit(DW)
    // Close Skip End
    endif
    // Clean Up
    set udg_Player_Message_Group = null
    set udg_Temp_Unit_Point = null
    set udg_Temp_Polar_Point = null
    set udg_Temp_X_Point = null
    set eff = null
    set eff2 = null
    set DW = null
    set ST = null
    set Red = null
    set Black = null
    call FogModifierStop( fog )
    call FogModifierStop( fog2 )
    call DestroyFogModifier( fog )
    set fog = null
    set fog2 = null
endfunction

//===========================================================================
function InitTrig_C_BLD takes nothing returns nothing
    set gg_trg_C_BLD = CreateTrigger(  )
    call DisableTrigger( gg_trg_C_BLD )
    call TriggerAddAction( gg_trg_C_BLD, function Trig_C_BLD_Actions )
endfunction

//===========================================================================
// Trigger: P BLD
//===========================================================================
function Trig_P_BLD_Actions takes nothing returns nothing
    // skip
    if udg_QuestBLD_B_A >= 7 and udg_QuestBLD_R_A >= 4 then
    return
    endif
    // endskip
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_BLD_DW)
    call PlaySoundAtPointBJ( gg_snd_DW_Roar_2, 100, udg_Temp_Unit_Point, 2000.00 )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Reapers Claws Red.mdx" )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), Deg2Rad(70.00), 0.0, 0.00 )
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), ( BlzGetLocalSpecialEffectZ(GetLastCreatedEffectBJ()) + 500.00 ) )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 2.00 )
    call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 2.50 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Ephemeral Slash Red.mdx" )
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), ( BlzGetLocalSpecialEffectZ(GetLastCreatedEffectBJ()) + 500.00 ) )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 2.00 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call RemoveLocation (udg_Temp_Unit_Point)
    // skip
    if udg_QuestBLD_B_A >= 7 and udg_QuestBLD_R_A >= 4 then
    return
    endif
    // endskip
    call TriggerSleepAction( 3.00 )
    // skip
    if udg_QuestBLD_B_A >= 7 and udg_QuestBLD_R_A >= 4 then
    return
    endif
    // endskip
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_BLD_Strasza)
    call PlaySoundAtPointBJ( gg_snd_DW_Roar_3, 100, udg_Temp_Unit_Point, 2000.00 )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Reapers Claws Red.mdx" )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), Deg2Rad(245.00), 0.0, 0.00 )
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), ( BlzGetLocalSpecialEffectZ(GetLastCreatedEffectBJ()) + 500.00 ) )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 2.00 )
    call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 2.50 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Ephemeral Slash Red.mdx" )
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), ( BlzGetLocalSpecialEffectZ(GetLastCreatedEffectBJ()) + 500.00 ) )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 2.00 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call RemoveLocation (udg_Temp_Unit_Point)
    // skip
    if udg_QuestBLD_B_A >= 7 and udg_QuestBLD_R_A >= 4 and udg_QuestBLD_Wait then
    return
    endif
    // endskip
    call TriggerSleepAction( 4.00 )
    // skip
    if udg_QuestBLD_B_A >= 7 and udg_QuestBLD_R_A >= 4 and udg_QuestBLD_Wait then
    return
    endif
    // endskip
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_BLD_Strasza)
    call PlaySoundAtPointBJ( gg_snd_Straza_NeltharionLookAtYourself, 100, udg_Temp_Unit_Point, 2000.00 )
    call RemoveLocation (udg_Temp_Unit_Point)
    // skip
    if udg_QuestBLD_B_A >= 7 and udg_QuestBLD_R_A >= 4 and udg_QuestBLD_Wait then
    return
    endif
    // endskip
    call TriggerSleepAction( 8.00 )
    // skip
    if udg_QuestBLD_B_A >= 7 and udg_QuestBLD_R_A >= 4 and udg_QuestBLD_Wait then
    return
    endif
    // endskip
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_BLD_DW)
    call PlaySoundAtPointBJ( gg_snd_DW_IShallTearThisWorldApart, 100, udg_Temp_Unit_Point, 2000.00 )
    call RemoveLocation (udg_Temp_Unit_Point)
    // skip
    if udg_QuestBLD_B_A >= 7 and udg_QuestBLD_R_A >= 4 and udg_QuestBLD_Wait then
    return
    endif
    // endskip
    call TriggerSleepAction( 4.00 )
    set udg_QuestBLD_Wait = true
endfunction

//===========================================================================
function InitTrig_P_BLD takes nothing returns nothing
    set gg_trg_P_BLD = CreateTrigger(  )
    call DisableTrigger( gg_trg_P_BLD )
    call TriggerRegisterTimerEventPeriodic( gg_trg_P_BLD, 40.00 )
    call TriggerAddAction( gg_trg_P_BLD, function Trig_P_BLD_Actions )
endfunction

//===========================================================================
// Trigger: Dragon Clicked
//
// If a player clicks a Dragon, and their FP unit is not currently set, move their Hero to FP and give them a dragon with camera locked on it
// The red dragon only takes damage from black drakes and can only damage them as well. It has one healing spell and a dismount spell
//===========================================================================
function Trig_Dragon_Clicked_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'nrdr' ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetTriggerUnit()) == Player(PLAYER_NEUTRAL_PASSIVE) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dragon_Clicked_Func008Func014C takes nothing returns boolean
    if ( not ( udg_Player_Music[udg_Player_Number] != "BattleOfLifeAndDeath" ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dragon_Clicked_Func008Func027Func001C takes nothing returns boolean
    if ( not ( IsTriggerEnabled(gg_trg_H_BLD_A) == true ) ) then
        return false
    endif
    if ( not ( IsPlayerInForce(GetTriggerPlayer(), udg_AlliancePlayers) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dragon_Clicked_Func008Func027Func002C takes nothing returns boolean
    if ( not ( IsTriggerEnabled(gg_trg_H_BLD_H) == true ) ) then
        return false
    endif
    if ( not ( IsPlayerInForce(GetTriggerPlayer(), udg_HordePlayers) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dragon_Clicked_Func008Func027C takes nothing returns boolean
    if ( Trig_Dragon_Clicked_Func008Func027Func001C() ) then
        return true
    endif
    if ( Trig_Dragon_Clicked_Func008Func027Func002C() ) then
        return true
    endif
    return false
endfunction

function Trig_Dragon_Clicked_Func008C takes nothing returns boolean
    if ( not Trig_Dragon_Clicked_Func008Func027C() ) then
        return false
    endif
    return true
endfunction

function Trig_Dragon_Clicked_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    local location udg_Temp_Polar_Point
    local integer p = 0
    set udg_Player_Number = GetPlayerHeroNumber(GetTriggerPlayer())
    set p = udg_Player_Number
    if ( Trig_Dragon_Clicked_Func008C() ) then
        if IsUnitPaused( udg_Heroes[p]) == false then
        set udg_X_Player_MUI = GetOwningPlayer(udg_Heroes[udg_Player_Number])
        // Make Drake
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Battle_of_Life_and_Death_Quest_Start)
        set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 200.00, ( 270.00 + GetRandomReal(-45.00, 45.00) ))
        call CreateNUnitsAtLoc( 1, 'nrdr', GetTriggerPlayer(), udg_Temp_Polar_Point, bj_UNIT_FACING )
        call RemoveLocation (udg_Temp_Polar_Point)
        call RemoveLocation (udg_Temp_Unit_Point)
        call UnitRemoveAbilityBJ( 'Avul', GetLastCreatedUnit() )
        call SelectUnitForPlayerSingle( GetLastCreatedUnit(), udg_X_Player_MUI )
        call BlzSetUnitAbilityManaCost( GetLastCreatedUnit(), 'ACrj', 0, 0 )
        call BlzSetUnitAbilityManaCost( GetLastCreatedUnit(), 'ACbc', 0, 0 )
        call BlzSetUnitAbilityManaCost( GetLastCreatedUnit(), 'Awfb', 0, 0 )
        if ( Trig_Dragon_Clicked_Func008Func014C() ) then
            if GetLocalPlayer() == GetTriggerPlayer() then
            call ClearMapMusicBJ(  )
            call StopMusicBJ( false )
            call EndThematicMusicBJ(  )
            call PlayMusicBJ( gg_snd_TwilightsHammer )
            call PlayMusicBJ( gg_snd_EndTime )
            endif
            set udg_Player_Music[udg_Player_Number] = "BattleOfLifeAndDeath"
        else
        endif
        // Disable Player Control
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Alliance_Heroes_During_Flight)
        call SetUnitPositionLoc( udg_Heroes[udg_Player_Number], udg_Temp_Unit_Point )
        call RemoveLocation (udg_Temp_Unit_Point)
        call PauseAddInvuln( udg_Heroes[ udg_Player_Number ], null)
        set udg_FP_Bats_n_Gryphons[udg_Player_Number] = GetLastCreatedUnit()
        call TriggerSleepAction( 0.25 )
        set udg_Player_Number = p
        set udg_X_Player_MUI = GetOwningPlayer(udg_Heroes[udg_Player_Number])
        call SetCameraTargetControllerNoZForPlayer( udg_X_Player_MUI, udg_FP_Bats_n_Gryphons[udg_Player_Number], 0, 0, true )
        call SetCameraFieldForPlayer( udg_X_Player_MUI, CAMERA_FIELD_TARGET_DISTANCE, 3000.00, 0.20 )
        endif
    else
    endif
    set udg_Temp_Unit_Point = null
    set udg_Temp_Polar_Point = null
endfunction

//===========================================================================
function InitTrig_Dragon_Clicked takes nothing returns nothing
    set gg_trg_Dragon_Clicked = CreateTrigger(  )
    call DisableTrigger( gg_trg_Dragon_Clicked )
    call TriggerRegisterPlayerSelectionEventBJ( gg_trg_Dragon_Clicked, Player(2), true )
    call TriggerRegisterPlayerSelectionEventBJ( gg_trg_Dragon_Clicked, Player(7), true )
    call TriggerRegisterPlayerSelectionEventBJ( gg_trg_Dragon_Clicked, Player(8), true )
    call TriggerRegisterPlayerSelectionEventBJ( gg_trg_Dragon_Clicked, Player(9), true )
    call TriggerRegisterPlayerSelectionEventBJ( gg_trg_Dragon_Clicked, Player(4), true )
    call TriggerRegisterPlayerSelectionEventBJ( gg_trg_Dragon_Clicked, Player(5), true )
    call TriggerRegisterPlayerSelectionEventBJ( gg_trg_Dragon_Clicked, Player(6), true )
    call TriggerRegisterPlayerSelectionEventBJ( gg_trg_Dragon_Clicked, Player(10), true )
    call TriggerRegisterPlayerSelectionEventBJ( gg_trg_Dragon_Clicked, Player(12), true )
    call TriggerRegisterPlayerSelectionEventBJ( gg_trg_Dragon_Clicked, Player(13), true )
    call TriggerAddCondition( gg_trg_Dragon_Clicked, Condition( function Trig_Dragon_Clicked_Conditions ) )
    call TriggerAddAction( gg_trg_Dragon_Clicked, function Trig_Dragon_Clicked_Actions )
endfunction

//===========================================================================
// Trigger: Dragon Leaves
//
// When the red player dragon leaves kill, when a black dragon leaves TP inside back to random location
//===========================================================================
function Trig_Dragon_Leaves_Func001Func003C takes nothing returns boolean
    if ( not ( GetPlayerController(GetOwningPlayer(GetTriggerUnit())) == MAP_CONTROL_USER ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'nrdr' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dragon_Leaves_Func001C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'nrwm' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'nbwm' ) ) then
        return true
    endif
    if ( Trig_Dragon_Leaves_Func001Func003C() ) then
        return true
    endif
    return false
endfunction

function Trig_Dragon_Leaves_Conditions takes nothing returns boolean
    if ( not Trig_Dragon_Leaves_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Dragon_Leaves_Func005C takes nothing returns boolean
    if ( not ( GetPlayerController(GetOwningPlayer(GetTriggerUnit())) == MAP_CONTROL_USER ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dragon_Leaves_Actions takes nothing returns nothing
    local integer udg_Player_Number
    local location udg_Temp_Unit_Point
    set udg_Player_Number = HeroesNumb( GetOwningPlayer(GetTriggerUnit() ) )
    if ( Trig_Dragon_Leaves_Func005C() ) then
        if GetLocalPlayer() == GetOwningPlayer(GetTriggerUnit() ) then
        call PlaySoundBJ( gg_snd_UI_RaidBossWarning )
        endif
        set udg_X_Player_MUI = GetOwningPlayer(udg_Heroes[udg_Player_Number])
        call CameraSetupApplyForPlayer( true, gg_cam_FP_Vermillion_Redoubt_Landing, udg_X_Player_MUI, 0.25 )
        call TriggerSleepAction( 0.25 )
        set udg_X_Player_MUI = GetOwningPlayer(udg_Heroes[udg_Player_Number])
        // Kill Temp Unit & Enable
        call UnPauseAddInvuln( udg_Heroes[ udg_Player_Number ], null)
        call KillUnit( udg_FP_Bats_n_Gryphons[udg_Player_Number] )
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_FP_Vermillion_Redoubt)
        call SetUnitPositionLoc( udg_Heroes[udg_Player_Number], udg_Temp_Unit_Point )
        call RemoveLocation (udg_Temp_Unit_Point)
        call SetCameraFieldForPlayer( udg_X_Player_MUI, CAMERA_FIELD_TARGET_DISTANCE, udg_Z_Camera[udg_Player_Number], 0 )
    else
        set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_Q_Battle_of_Life_and_Death_Fly_Zone)
        call SetUnitPositionLoc( GetTriggerUnit(), udg_Temp_Unit_Point )
        call RemoveLocation (udg_Temp_Unit_Point)
    endif
    set udg_Temp_Unit_Point = null
endfunction

//===========================================================================
function InitTrig_Dragon_Leaves takes nothing returns nothing
    set gg_trg_Dragon_Leaves = CreateTrigger(  )
    call TriggerRegisterLeaveRectSimple( gg_trg_Dragon_Leaves, gg_rct_Q_Battle_of_Life_and_Death_Fly_Zone )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Dragon_Leaves, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_Dragon_Leaves, Condition( function Trig_Dragon_Leaves_Conditions ) )
    call TriggerAddAction( gg_trg_Dragon_Leaves, function Trig_Dragon_Leaves_Actions )
endfunction

//===========================================================================
// Trigger: Dragon Dismount
//
// When dies or dismount, use GetTrigger unit to find the FP player and return player to start area
// This can also be trigged by E when quest is complete
//===========================================================================
function Trig_Dragon_Dismount_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'nrdr' ) ) then
        return false
    endif
    if ( not ( GetPlayerController(GetOwningPlayer(GetTriggerUnit())) == MAP_CONTROL_USER ) ) then
        return false
    endif
    if ( not ( GetSpellAbilityId() == 'A0G5' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dragon_Dismount_Actions takes nothing returns nothing
    call TriggerExecute(gg_trg_Dragon_Leaves)
endfunction

//===========================================================================
function InitTrig_Dragon_Dismount takes nothing returns nothing
    set gg_trg_Dragon_Dismount = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Dragon_Dismount, EVENT_PLAYER_UNIT_SPELL_CAST )
    call TriggerAddCondition( gg_trg_Dragon_Dismount, Condition( function Trig_Dragon_Dismount_Conditions ) )
    call TriggerAddAction( gg_trg_Dragon_Dismount, function Trig_Dragon_Dismount_Actions )
endfunction

//===========================================================================
