    if ( not ( GetSpellAbilityUnit() == udg_yH_Ass_Rogue ) ) then
        return false
    endif
    if ( not ( udg_HAssComboPoints < 1.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Rupture_Begin_Func002C takes nothing returns boolean
    if ( not ( GetSpellAbilityUnit() == udg_yA_Ass_Rogue ) ) then
        return false
    endif
    if ( not ( udg_AAssComboPoints < 1.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Rupture_Begin_Actions takes nothing returns nothing
    if ( Trig_Rupture_Begin_Func001C() ) then
        call IssueImmediateOrderBJ( GetTriggerUnit(), "stop" )
        call ErrorMessage( "Not enough combo points.", GetOwningPlayer(GetTriggerUnit()) )
    else
    endif
    if ( Trig_Rupture_Begin_Func002C() ) then
        call IssueImmediateOrderBJ( GetTriggerUnit(), "stop" )
        call ErrorMessage( "Not enough combo points.", GetOwningPlayer(GetTriggerUnit()) )
    else
    endif
endfunction

