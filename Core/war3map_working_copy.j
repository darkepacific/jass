//===========================================================================
// Trigger: Entropius Blackhole
//
// war3mapImported\Void Rift II Purple.mdx
//===========================================================================
globals
    location Point_Entropius_Blackhole
    location Point_Entropius_Blackhole_DMG
    effect Entropius_Blackhole
    real Entropius_Blackhole_Angle = 0.0
endglobals

function Trig_Entropius_Blackhole_Conditions takes nothing returns boolean
    if (GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) < 7600.00 ) and GetUnitTypeId(GetTriggerUnit()) == 'H03X' then
	return true
    endif

    return false
endfunction

function Trig_Entropius_Blackhole_Actions takes nothing returns nothing

    if RectContainsUnit( gg_rct_Z_Sunwell_Plateau, GetEventDamageSource()) then

    	call DisableTrigger(GetTriggeringTrigger())

    	// Set the black hole's initial location near the damage source
    	set Point_Entropius_Blackhole_DMG = GetUnitLoc(GetEventDamageSource())
    	set Point_Entropius_Blackhole = PolarProjectionBJ(Point_Entropius_Blackhole_DMG, 80.0, GetRandomReal(0, 360))

    	call RemoveLocation(Point_Entropius_Blackhole_DMG)

    	// First effect: Initial void rift
   	 call DestroyEffectBJ(AddSpecialEffectLocBJ(Point_Entropius_Blackhole, "war3mapImported\\Voidfall Major.mdx"))

    	call TriggerSleepAction(0.6)

    	// Create the black hole effect
    	call AddSpecialEffectLocBJ(Point_Entropius_Blackhole, "war3mapImported\\Void Rift II Purple.mdx")
    	set Entropius_Blackhole = GetLastCreatedEffectBJ()
    	call BlzSetSpecialEffectHeight(Entropius_Blackhole, 40.00) // Slightly above ground
    	call BlzSetSpecialEffectScale(Entropius_Blackhole, 1.5)

    	call TriggerSleepAction(0.35)

    	// Enable periodic movement and unit pulling
    	set Entropius_Blackhole_TickCount = 0
    	call EnableTrigger(gg_trg_Entropius_Blackhole_Tick)

    	call TriggerSleepAction(10.30)

    	// Destroy black hole effect
    	call DestroyEffectBJ(Entropius_Blackhole)

    	call DisableTrigger(gg_trg_Entropius_Blackhole_Tick)

    	call TriggerSleepAction(3.00)

    	// Re-enable the trigger for the next time
    	call EnableTrigger(GetTriggeringTrigger())
    	call RemoveLocation(Point_Entropius_Blackhole)

    endif
endfunction

//===========================================================================
// Initialization
function InitTrig_Entropius_Blackhole takes nothing returns nothing
    set gg_trg_Entropius_Blackhole = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Entropius_Blackhole, EVENT_PLAYER_UNIT_DAMAGED)
    call TriggerAddCondition(gg_trg_Entropius_Blackhole, Condition(function Trig_Entropius_Blackhole_Conditions))
    call TriggerAddAction(gg_trg_Entropius_Blackhole, function Trig_Entropius_Blackhole_Actions)
endfunction

//===========================================================================
// Trigger: Entropius Blackhole Tick
//===========================================================================
globals
    real Entropius_Blackhole_Speed = 0.15 // Speed of circular movement
    real Entropius_Blackhole_Radius = 5.0 // Radius of circular movement
    integer Entropius_Blackhole_TickCount = 0
endglobals

function Trig_Entropius_Blackhole_Tick_Actions takes nothing returns nothing
    local location newLocation
    local group g
    local unit u
    local real x
    local real y
    local real ux
    local real uy
    local real angleToBlackhole
    local real forcePower = 20.0 // How strong units are pulled

    // Update the black hole's angle
    set Entropius_Blackhole_Angle = Entropius_Blackhole_Angle + (0.1 * Entropius_Blackhole_Speed)

    if Entropius_Blackhole_Angle > 6.283 then
        set Entropius_Blackhole_Angle = 0.0 // Reset angle after full circle
    endif

    // Compute new location in circular motion
    set x = GetLocationX(Point_Entropius_Blackhole) + Entropius_Blackhole_Radius * Cos(Entropius_Blackhole_Angle)
    set y = GetLocationY(Point_Entropius_Blackhole) + Entropius_Blackhole_Radius * Sin(Entropius_Blackhole_Angle)
    set newLocation = Location(x, y)

    // Move black hole effect
    call BlzSetSpecialEffectPosition(Entropius_Blackhole, x, y, 100.0)

    // Every 3 ticks, pull in nearby units
    set Entropius_Blackhole_TickCount = Entropius_Blackhole_TickCount + 1
    if Entropius_Blackhole_TickCount >= 3 then
        set Entropius_Blackhole_TickCount = 0 // Reset counter

        set g = CreateGroup()
        call GroupEnumUnitsInRange(g, x, y, 200.0, null)

        loop
            set u = FirstOfGroup(g)
            exitwhen u == null

            // Check if unit is a targetable enemy
            if IsUnitTargetableEnemy(u, gg_unit_H03W_2340) then
                call UnitDamageTargetBJ(gg_unit_H03W_2340, u, 120.0, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_UNIVERSAL)
                
		//SE
    		call AddSpecialEffectTargetUnitBJ( "origin", u, "Abilities\\Spells\\Undead\\DeathandDecay\\DeathandDecayTarget.mdl" )
    		call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    		call AddSpecialEffectTargetUnitBJ( "overhead", u, "Abilities\\Spells\\Undead\\DeathandDecay\\DeathandDecayTarget.mdl" )
    		call DestroyEffectBJ( GetLastCreatedEffectBJ() )

                // Get unit's position
                set ux = GetUnitX(u)
                set uy = GetUnitY(u)

                // Calculate angle towards the black hole's new position
                set angleToBlackhole = Atan2(y - uy, x - ux)

                // Push unit toward the black hole's movement direction
                call SetUnitX(u, ux + forcePower * Cos(angleToBlackhole))
                call SetUnitY(u, uy + forcePower * Sin(angleToBlackhole))
            endif

            call GroupRemoveUnit(g, u)
        endloop

        call DestroyGroup(g)
    endif

    // Update the stored location
    call RemoveLocation(Point_Entropius_Blackhole)
    set Point_Entropius_Blackhole = newLocation

    set newLocation = null

    set g = null
endfunction

//===========================================================================
// Initialization
function InitTrig_Entropius_Blackhole_Tick takes nothing returns nothing
    set gg_trg_Entropius_Blackhole_Tick = CreateTrigger()
    call TriggerRegisterTimerEventPeriodic(gg_trg_Entropius_Blackhole_Tick, 0.03)
    call TriggerAddAction(gg_trg_Entropius_Blackhole_Tick, function Trig_Entropius_Blackhole_Tick_Actions)
endfunction

