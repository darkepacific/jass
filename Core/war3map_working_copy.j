    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 2 )
    call TriggerSleepAction( 2 )
    // Treeants
    if ( Trig_Neutral_Hostile_Spawn_Func013001() ) then
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Angry_Ents_E)
    else
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Angry_Ents_NE)
    endif
