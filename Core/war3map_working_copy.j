	call TalentChoiceCreateTriggerEx(udg_TalentPreMadeChoiceTrigger[8], udg_TalentPreMadeChoiceTrigger[9])
	set udg_TalentChoiceInt1[udg_TalentChoiceLast] = choiceIndex
