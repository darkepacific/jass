//===========================================================================
// Trigger: Demonic Gateway
//===========================================================================
function Trig_Demonic_Gateway_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0EB' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Demonic_Gateway_Func023C takes nothing returns boolean
    if ( not ( udg_SpellUnits[( udg_o + 0 )] == null ) ) then
        return false
    endif
    return true
endfunction

function Trig_Demonic_Gateway_Func028C takes nothing returns boolean
    if ( not ( udg_SpellUnits[( udg_o + 1 )] == null ) ) then
        return false
    endif
    return true
endfunction

function Trig_Demonic_Gateway_Actions takes nothing returns nothing
    local integer o
    local integer whichLock
    // whichLock:  0 = aff, 1 = dem, 2 = des
    if (  GetTriggerUnit() == udg_yA_Demon_Warlock ) then
    set udg_o = udg_z_WL_DEMO_A
    set whichLock = 1
    elseif (  GetTriggerUnit() == udg_yH_Demon_Warlock ) then
    set udg_o = udg_z_WL_DEMO_H
    set whichLock = 1
    elseif (  GetTriggerUnit() == udg_yA_Destro_Warlock ) then
    set udg_o = udg_z_WL_DEST_A
    set whichLock = 2
    elseif (  GetTriggerUnit() == udg_yH_Destro_Warlock ) then
    set udg_o = udg_z_WL_DEST_H
    set whichLock = 2
    endif
    set udg_o = ( udg_o + 16 )
    if udg_Debug then
    call DisplayTextToForce( GetPlayersAll(), "o: " + I2S( udg_o ) )
    endif
    // Create or Move 0
    set udg_Temp_Unit_Point = GetSpellTargetLoc()
    if ( Trig_Demonic_Gateway_Func023C() ) then
        call SetUnitVertexColorBJ( GetLastCreatedUnit(), 88.00, 66.00, 100, 12.00 )
        call CreateNUnitsAtLoc( 1, 'e04D', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, GetUnitFacing(GetTriggerUnit()) )
        set udg_SpellUnits[udg_o] = GetLastCreatedUnit()
        if whichLock == 1 then
        	call TriggerRegisterUnitInRangeSimple( gg_trg_Demonic_Gateway_TP0_Dem, 84.00, udg_SpellUnits[ udg_o + 0 ]  )
        else
        	call TriggerRegisterUnitInRangeSimple( gg_trg_Demonic_Gateway_TP0_Des, 84.00, udg_SpellUnits[ udg_o + 0 ]  )
        endif
    else
        call SetUnitPositionLoc(  udg_SpellUnits[ udg_o + 0 ], udg_Temp_Unit_Point )
        call BlzSetUnitFacingEx( udg_SpellUnits[udg_o], GetUnitFacing(GetTriggerUnit()) )
    endif
    call RemoveLocation (udg_Temp_Unit_Point)
    // Create or Move 1
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 110.00, GetUnitFacing(GetTriggerUnit()))
    if ( Trig_Demonic_Gateway_Func028C() ) then
        call CreateNUnitsAtLoc( 1, 'e04D', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, ( 180.00 + GetUnitFacing(GetTriggerUnit()) ) )
        call SetUnitVertexColorBJ( GetLastCreatedUnit(), 100.00, 100.00, 100, 12.00 )
        set udg_SpellUnits[( udg_o + 1 )] = GetLastCreatedUnit()
        if whichLock == 1 then
        	call TriggerRegisterUnitInRangeSimple( gg_trg_Demonic_Gateway_TP1_Dem, 84.00, udg_SpellUnits[ udg_o + 1 ]  )
        else
        	call TriggerRegisterUnitInRangeSimple( gg_trg_Demonic_Gateway_TP1_Des, 84.00, udg_SpellUnits[ udg_o + 1 ]  )
        endif
    else
        call SetUnitPositionLoc(  udg_SpellUnits[ udg_o + 1 ], udg_Temp_Polar_Point )
        call BlzSetUnitFacingEx( udg_SpellUnits[( udg_o + 1 )], ( GetUnitFacing(GetTriggerUnit()) + 180.00 ) )
    endif
    call RemoveLocation (udg_Temp_Unit_Point)
    call RemoveLocation (udg_Temp_Polar_Point)
    // Move to Island
    set o = udg_o
    call GameTimeWait( 7.0)
    set udg_o = o
    if whichLock == 1 then
    call DisableTrigger( gg_trg_Demonic_Gateway_TP0_Dem )
    call DisableTrigger( gg_trg_Demonic_Gateway_TP1_Dem )
    else
    call DisableTrigger( gg_trg_Demonic_Gateway_TP0_Des )
    call DisableTrigger( gg_trg_Demonic_Gateway_TP1_Des )
    endif
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_DummyIsland)
    call SetUnitPositionLoc(  udg_SpellUnits[ udg_o + 0 ], udg_Temp_Unit_Point )
    call SetUnitPositionLoc(  udg_SpellUnits[ udg_o + 1 ], udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    if whichLock == 1 then
    call EnableTrigger( gg_trg_Demonic_Gateway_TP0_Dem )
    call EnableTrigger( gg_trg_Demonic_Gateway_TP1_Dem )
    else
    call EnableTrigger( gg_trg_Demonic_Gateway_TP0_Des )
    call EnableTrigger( gg_trg_Demonic_Gateway_TP1_Des )
    endif
    // Extra
    return
endfunction

//===========================================================================
function InitTrig_Demonic_Gateway takes nothing returns nothing
    set gg_trg_Demonic_Gateway = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Demonic_Gateway, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Demonic_Gateway, Condition( function Trig_Demonic_Gateway_Conditions ) )
    call TriggerAddAction( gg_trg_Demonic_Gateway, function Trig_Demonic_Gateway_Actions )
endfunction

//===========================================================================
// Trigger: Demonic Gateway TP0 Dem
//
// call SetUnitPositionLoc(  udg_SpellUnits[(udg_SpellUnits_CONST * 1) + 1 ], udg_Temp_Unit_Point )
//  udg_SpellUnits[(udg_SpellUnits_CONST * 1) + 1 ]
//===========================================================================
function Trig_Demonic_Gateway_TP0_Dem_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) != 'e04D' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) != 'e04E' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) != 'e04H' ) ) then
        return false
    endif
    if ( not ( GetPlayerController(GetOwningPlayer(GetTriggerUnit())) == MAP_CONTROL_USER ) ) then
        return false
    endif
    return true
endfunction

function Trig_Demonic_Gateway_TP0_Dem_Actions takes nothing returns nothing
    local integer udg_o
    local location udg_Temp_Unit_Point
    local location udg_Temp_Polar_Point
    local location udg_Temp_X_Point
    if IsPlayerInForce(GetOwningPlayer(GetTriggerUnit()), udg_AlliancePlayers) then
    set udg_Temp_Polar_Point = GetRectCenter(gg_rct_Alliance_Heroes_During_Flight)
    set udg_o = udg_z_WL_DEMO_A
    else
    set udg_Temp_Polar_Point = GetRectCenter(gg_rct_Horde_Heroes_During_Flight)
    set udg_o = udg_z_WL_DEMO_H
    endif
    set udg_o = ( udg_o + 16 )
    if IsUnitAlly( GetTriggerUnit(), GetOwningPlayer(udg_SpellUnits[udg_o] ) ) then
    set udg_Temp_Unit_Point = GetUnitLoc(udg_SpellUnits[( udg_o + 0 )])
    call CreateNUnitsAtLoc( 1, 'e04E', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, GetUnitFacing(GetTriggerUnit()) )
    call UnitApplyTimedLifeBJ( 0.80, 'BTLF', GetLastCreatedUnit() )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = GetUnitLoc(udg_SpellUnits[( udg_o + 1 )])
    call IssuePointOrderLocBJ( GetLastCreatedUnit(), "move", udg_Temp_Unit_Point )
    set udg_Temp_X_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 130.00, GetUnitFacing(udg_SpellUnits[( udg_o + 1 )]))
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    // Wait and Move
    call SetUnitInvulnerable( GetTriggerUnit(), true )
    call PauseUnit( GetTriggerUnit(), true )
    call SetUnitPositionLoc(  GetTriggerUnit() , udg_Temp_Polar_Point )
    call GameTimeWait(0.7)
    call SetUnitInvulnerable( GetTriggerUnit(), false )
    call PauseUnit( GetTriggerUnit(), false )
    if not IsTerrainPathable( GetLocationX(udg_Temp_X_Point), GetLocationY(udg_Temp_X_Point), PATHING_TYPE_WALKABILITY) then
    call SetUnitPositionLoc(  GetTriggerUnit() , udg_Temp_X_Point )
    else
    call DisableTrigger( GetTriggeringTrigger() )
    call SetUnitPositionLoc(  GetTriggerUnit() , udg_Temp_Unit_Point )
    call ErrorMessage( "Can't path there.", GetOwningPlayer( GetTriggerUnit() ) )
    call EnableTrigger( GetTriggeringTrigger() )
    endif
    call RemoveLocation (udg_Temp_X_Point)
    call RemoveLocation (udg_Temp_Unit_Point)
    endif
    call RemoveLocation (udg_Temp_Polar_Point)
    set udg_Temp_Unit_Point = null
    set udg_Temp_Polar_Point = null
    set udg_Temp_X_Point = null
endfunction

//===========================================================================
function InitTrig_Demonic_Gateway_TP0_Dem takes nothing returns nothing
    set gg_trg_Demonic_Gateway_TP0_Dem = CreateTrigger(  )
    call TriggerAddCondition( gg_trg_Demonic_Gateway_TP0_Dem, Condition( function Trig_Demonic_Gateway_TP0_Dem_Conditions ) )
    call TriggerAddAction( gg_trg_Demonic_Gateway_TP0_Dem, function Trig_Demonic_Gateway_TP0_Dem_Actions )
endfunction

