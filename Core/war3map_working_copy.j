function Trig_Bal_Druid_Max_Conditions takes nothing returns boolean
    if ( not ( GetHeroLevel(GetTriggerUnit()) >= udg_FINALS_LEVEL_1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Bal_Druid_Max_Func003A takes nothing returns nothing
    call SetPlayerAbilityAvailableBJ( false, 'A0CZ', GetEnumPlayer() )
endfunction

function Trig_Bal_Druid_Max_Func004A takes nothing returns nothing
    call SetPlayerAbilityAvailableBJ( false, 'A0CZ', GetEnumPlayer() )
endfunction

function Trig_Bal_Druid_Max_Func005Func002C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'E01C' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'E022' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Bal_Druid_Max_Func005C takes nothing returns boolean
    if ( not Trig_Bal_Druid_Max_Func005Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_Bal_Druid_Max_Func008A takes nothing returns nothing
    call SetPlayerAbilityAvailableBJ( false, 'A03B', GetEnumPlayer() )
endfunction

function Trig_Bal_Druid_Max_Func009A takes nothing returns nothing
    call SetPlayerAbilityAvailableBJ( false, 'A03B', GetEnumPlayer() )
endfunction

function Trig_Bal_Druid_Max_Func010Func001C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'E010' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'E02W' ) ) then
        return true
    endif
    return false
endfunction

