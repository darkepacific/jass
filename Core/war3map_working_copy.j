function Trig_S_Test_Subjects_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
                       if IsHordeHero( GetTriggerUnit() ) then
    set udg_TempString = "Test Subjects"
    set udg_TempString_Quest = "Use the plague 15 times on Gilneans."
    call TriggerExecute( gg_trg_Quest_Start_H )
    set udg_TempString = ""
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    set udg_TempString = udg_QuestionMark
    call QuestSetEnabledBJ( true, udg_Quests[68] )
    call FlashQuestDialogButtonBJ(  )
    endif
    call DestroyEffectBJ( udg_QuestMarks[68] )
    call QuestSetCompletedBJ( udg_Quests[68], false )
    call CreateQuestItemBJ( udg_Quests[68], "TRIGSTR_9863" )
    set udg_QuestReqs[68] = GetLastCreatedQuestItemBJ()
    call AddSpecialEffectTargetUnitBJ( "overhead", udg_ApothecaryGilneas, udg_TempString )
    set udg_QuestMarks[68] = GetLastCreatedEffectBJ()
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Z_The_WitchWood)
    call CampaignMinimapIconLocBJ( udg_Temp_Unit_Point, bj_CAMPPINGSTYLE_CONTROL_NEUTRAL )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_MiniMapIcon[68] = GetLastCreatedMinimapIcon()
    call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), false )
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), true )
    endif
    call DisableTrigger( GetTriggeringTrigger() )
    call EnableTrigger( gg_trg_U_Test_Subjects )
    call EnableTrigger( gg_trg_U_Test_Subjects_15 )
    call UnitAddItemByIdSwapped( 'I07G', GetTriggerUnit() )
    call TriggerSleepAction( 10.00 )
    call EnableTrigger( gg_trg_L_Test_Subjects )
