    set gg_trg_Frost_Missiles_Start = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Frost_Missiles_Start, EVENT_PLAYER_UNIT_SPELL_CHANNEL )
