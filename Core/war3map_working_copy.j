    set gg_trg_S_Venomfang = CreateTrigger(  )
    call DisableTrigger( gg_trg_S_Venomfang )
    call TriggerRegisterEnterRectSimple( gg_trg_S_Venomfang, gg_rct_PallyVenomfang )
    call TriggerRegisterUnitInRangeSimple( gg_trg_S_Venomfang, 256, gg_unit_Hpal_0010 )
    call TriggerAddAction( gg_trg_S_Venomfang, function Trig_S_Venomfang_Actions )
endfunction

