//===========================================================================
// Trigger: Sunwell Vision Enter
//===========================================================================
function Trig_Sunwell_Vision_Enter_Func001C takes nothing returns boolean
    if ( ( IsPlayerInForce(GetOwningPlayer(GetTriggerUnit()), udg_HordePlayers) == true ) ) then
        return true
    endif
    if ( ( IsPlayerInForce(GetOwningPlayer(GetTriggerUnit()), udg_AlliancePlayers) == true ) ) then
        return true
    endif
    return false
endfunction

function Trig_Sunwell_Vision_Enter_Conditions takes nothing returns boolean
    if ( not Trig_Sunwell_Vision_Enter_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Sunwell_Vision_Enter_Func004C takes nothing returns boolean
    if ( not ( IsPlayerInForce(GetOwningPlayer(GetTriggerUnit()), udg_AlliancePlayers) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Sunwell_Vision_Enter_Func005C takes nothing returns boolean
    if ( not ( IsPlayerInForce(GetOwningPlayer(GetTriggerUnit()), udg_HordePlayers) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Sunwell_Vision_Enter_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Kael)
    if ( Trig_Sunwell_Vision_Enter_Func004C() ) then
        if udg_Sunwell_A == null then
        call CreateFogModifierRadiusLocBJ( true, Player(1), FOG_OF_WAR_VISIBLE, udg_Temp_Unit_Point, 990.00 )
        set udg_Sunwell_A = GetLastCreatedFogModifier()
        else
        call FogModifierStart( udg_Sunwell_A )
        endif
    else
    endif
    if ( Trig_Sunwell_Vision_Enter_Func005C() ) then
        if udg_Sunwell_H == null then
        call CreateFogModifierRadiusLocBJ( true, Player(0), FOG_OF_WAR_VISIBLE, udg_Temp_Unit_Point, 990.00 )
        set udg_Sunwell_H = GetLastCreatedFogModifier()
        else
        call FogModifierStart( udg_Sunwell_H )
        endif
    else
    endif
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = null
endfunction

//===========================================================================
function InitTrig_Sunwell_Vision_Enter takes nothing returns nothing
    set gg_trg_Sunwell_Vision_Enter = CreateTrigger(  )
    call TriggerRegisterEnterRectSimple( gg_trg_Sunwell_Vision_Enter, gg_rct_Z_Sunwell_Plateau )
    call TriggerAddCondition( gg_trg_Sunwell_Vision_Enter, Condition( function Trig_Sunwell_Vision_Enter_Conditions ) )
    call TriggerAddAction( gg_trg_Sunwell_Vision_Enter, function Trig_Sunwell_Vision_Enter_Actions )
endfunction

//===========================================================================
// Trigger: Sunwell Vision Leaves
//===========================================================================
function Trig_Sunwell_Vision_Leaves_Func001C takes nothing returns boolean
    if ( ( IsPlayerInForce(GetOwningPlayer(GetTriggerUnit()), udg_HordePlayers) == true ) ) then
        return true
    endif
    if ( ( IsPlayerInForce(GetOwningPlayer(GetTriggerUnit()), udg_AlliancePlayers) == true ) ) then
        return true
    endif
    return false
endfunction

function Trig_Sunwell_Vision_Leaves_Conditions takes nothing returns boolean
    if ( not Trig_Sunwell_Vision_Leaves_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Sunwell_Vision_Leaves_Func002C takes nothing returns boolean
    if ( not ( IsPlayerInForce(GetOwningPlayer(GetTriggerUnit()), udg_AlliancePlayers) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Sunwell_Vision_Leaves_Func003C takes nothing returns boolean
    if ( not ( IsPlayerInForce(GetOwningPlayer(GetTriggerUnit()), udg_HordePlayers) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Sunwell_Vision_Leaves_Actions takes nothing returns nothing
    if ( Trig_Sunwell_Vision_Leaves_Func002C() ) then
        if AreAnyUnitsInRegionInForce( gg_rct_Sunwell_Plateau, udg_AlliancePlayers) == false then
        call FogModifierStop( udg_Sunwell_A )
        endif
    else
    endif
    if ( Trig_Sunwell_Vision_Leaves_Func003C() ) then
        if AreAnyUnitsInRegionInForce( gg_rct_Sunwell_Plateau, udg_HordePlayers) == false then
        call FogModifierStop( udg_Sunwell_H )
        endif
    else
    endif
endfunction

