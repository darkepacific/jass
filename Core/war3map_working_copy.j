//===========================================================================
function Trig_E_BFF_A_Func002C takes nothing returns boolean
    if ( not ( udg_QDeedB_A >= 1.00 ) ) then
        return false
    endif
    if ( not ( udg_QDeedCD_A >= 1.00 ) ) then
        return false
    endif
    if ( not ( udg_QDeedSS_A >= 1.00 ) ) then
        return false
    endif
    return true
endfunction

