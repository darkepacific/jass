        if ( Trig_Blood_Rush_N_Func006Func009C() ) then
        else
            call RemoveLocation (udg_Point_Charge_Begin[udg_Temp_Int])
            call RemoveLocation (udg_Point_Charge_End[udg_Temp_Int])
            call DestroyEffectBJ( udg_Charge_SE[udg_Temp_Int] )
            call DisableTrigger( GetTriggeringTrigger() )
            if ( Trig_Blood_Rush_N_Func006Func009Func005C() ) then
                set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
                set udg_HeroStatCalc = 0
                set bj_wantDestroyGroup = true
                call ForGroupBJ( GetUnitsInRangeOfLocAll(210.00, udg_Temp_Unit_Point), function Trig_Blood_Rush_N_Func006Func009Func005Func004A )
                if ( Trig_Blood_Rush_N_Func006Func009Func005Func005C() ) then
                    call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "war3mapImported\\Heal Orange.mdx" )
                    call MaxHPSelfHeal( 0.14)
                    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.80 )
                    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
                else
                endif
                call RemoveLocation (udg_Temp_Unit_Point)
            else
            endif
        endif
    else
    endif
endfunction

