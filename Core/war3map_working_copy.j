    call CreateNUnitsAtLoc( 1, 'h00U', Player(11), udg_Temp_Unit_Point, 311.00 )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Gilneas_Wall_KnockBack)
    call CreateNUnitsAtLoc( 1, 'n033', Player(11), udg_Temp_Unit_Point, 48.58 )
    call RemoveLocation (udg_Temp_Unit_Point)
    call KillDestructable( gg_dest_B023_30866 )
    call KillDestructable( gg_dest_B023_30945 )
endfunction

