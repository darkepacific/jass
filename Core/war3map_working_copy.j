function DummyStunSet takes unit caster, real dur, location point returns nothing
    call SetUnitOwner( gg_unit_e00H_2048, GetOwningPlayer(caster), true )
    call SetUnitPositionLocFacingBJ(  gg_unit_e00H_2048, point, GetUnitFacing(caster) )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility( gg_unit_e00H_2048, 'A06H'), ABILITY_RLF_DURATION_HERO, 0 , dur )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility( gg_unit_e00H_2048, 'A06H'), ABILITY_RLF_DURATION_NORMAL, 0 , dur )
endfunction


