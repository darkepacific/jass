//===========================================================================
// Trigger: Flame Strike Start
//===========================================================================
function Trig_Flame_Strike_Start_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'AHfs' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Flame_Strike_Start_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 14 ]  then
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'AHfs'), ABILITY_RLF_CASTING_TIME, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_Temp_Unit) - 1 ), 0.40 )
    else
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'AHfs'), ABILITY_RLF_CASTING_TIME, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_Temp_Unit) - 1 ), 0.85 )
    endif
    if udg_Temp_Unit == udg_yA_Fire_Mage then
    set udg_Blizzard[6] = GetSpellTargetLoc()
    elseif udg_Temp_Unit == udg_yH_Fire_Mage then
    set udg_Blizzard[2] = GetSpellTargetLoc()
    endif
endfunction

//===========================================================================
function InitTrig_Flame_Strike_Start takes nothing returns nothing
    set gg_trg_Flame_Strike_Start = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Flame_Strike_Start, EVENT_PLAYER_UNIT_SPELL_CAST )
    call TriggerAddCondition( gg_trg_Flame_Strike_Start, Condition( function Trig_Flame_Strike_Start_Conditions ) )
    call TriggerAddAction( gg_trg_Flame_Strike_Start, function Trig_Flame_Strike_Start_Actions )
endfunction

//===========================================================================
// Trigger: Flame Strike Tick BE
//===========================================================================
function Trig_Flame_Strike_Tick_BE_Func006A takes nothing returns nothing
    if IsUnitTargetableEnemyGround( GetEnumUnit(), udg_Temp_Unit ) then
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_Flame_Strike_Tick_BE_Func007C takes nothing returns boolean
    if ( not ( udg_SpellTicks[0] == 9 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Flame_Strike_Tick_BE_Actions takes nothing returns nothing
    set udg_Temp_Unit = udg_yH_Fire_Mage
    call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 1.17 * udg_RealStatCalc )
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(( 200.00 + ( 10.00 * I2R(GetUnitAbilityLevelSwapped('AHfs', gg_unit_Hblm_0221)) ) ), udg_Blizzard[2]), function Trig_Flame_Strike_Tick_BE_Func006A )
    if ( Trig_Flame_Strike_Tick_BE_Func007C() ) then
        call RemoveLocation (udg_Blizzard[2])
        call DisableTrigger( GetTriggeringTrigger() )
    else
        set udg_SpellTicks[0] = ( udg_SpellTicks[0] + 1 )
    endif
endfunction

