//===========================================================================
// Trigger: Immolation
//===========================================================================
function Trig_Immolation_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A08H' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Immolation_Func016A takes nothing returns nothing
    if IsUnitTargetableEnemy( GetEnumUnit(), udg_Temp_Unit) then
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call AddSpecialEffectTargetUnitBJ( "overhead", GetEnumUnit(), "Abilities\\Spells\\NightElf\\Immolation\\ImmolationDamage.mdl" )
    call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 10.00 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_Immolation_Actions takes nothing returns nothing
    local effect Immolation
    set udg_Temp_Unit = GetTriggerUnit()
    call TriggerExecute( gg_trg_Firelords_Helper)
    call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "Abilities\\Spells\\NightElf\\Immolation\\ImmolationTarget.mdl" )
    set Immolation = GetLastCreatedEffectBJ()
    //  
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, false) ))
    set udg_HeroStatCalc = GetUnitAbilityLevelSwapped('A08H', udg_Temp_Unit)
    set udg_HeroStatCalc = ( 0 + ( 25 * udg_HeroStatCalc ) )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "war3mapImported\\Damnation Green.mdx" )
    call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 2.00 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(265.00, udg_Temp_Unit_Point), function Trig_Immolation_Func016A )
    call RemoveLocation (udg_Temp_Unit_Point)
    //  
    if udg_Temp_Unit == udg_yA_Demon_Hunt then
    set udg_SpellTicks[5] = 1
    call EnableTrigger( gg_trg_Immolation_Tick_NE )
    else
    set udg_SpellTicks[6] = 1
    call EnableTrigger( gg_trg_Immolation_Tick_BE )
    endif
    call TriggerSleepAction( 2.50 )
    call DestroyEffect(Immolation)
    set Immolation = null
endfunction

//===========================================================================
function InitTrig_Immolation takes nothing returns nothing
    set gg_trg_Immolation = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Immolation, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Immolation, Condition( function Trig_Immolation_Conditions ) )
    call TriggerAddAction( gg_trg_Immolation, function Trig_Immolation_Actions )
endfunction

//===========================================================================
// Trigger: Immolation Tick NE
//===========================================================================
function Trig_Immolation_Tick_NE_Func014Func003C takes nothing returns boolean
    if ( not ( udg_SpellTicks[5] < 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Immolation_Tick_NE_Func014A takes nothing returns nothing
    if IsUnitTargetableEnemy( GetEnumUnit(), udg_Temp_Unit) then
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    if ( Trig_Immolation_Tick_NE_Func014Func003C() ) then
        call AddSpecialEffectTargetUnitBJ( "overhead", GetEnumUnit(), "Abilities\\Spells\\NightElf\\Immolation\\ImmolationDamage.mdl" )
        call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 10.00 )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    else
    endif
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_Immolation_Tick_NE_Func016C takes nothing returns boolean
    if ( not ( udg_SpellTicks[5] < 5 ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_Temp_Unit) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Immolation_Tick_NE_Actions takes nothing returns nothing
    set udg_Temp_Unit = udg_yA_Demon_Hunt
    call TriggerExecute( gg_trg_Firelords_Helper)
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 1.50 * udg_RealStatCalc )
    set udg_HeroStatCalc = GetUnitAbilityLevelSwapped('A08H', udg_Temp_Unit)
    set udg_HeroStatCalc = ( 0 + ( 20 * udg_HeroStatCalc ) )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "war3mapImported\\Damnation Green.mdx" )
    call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 2.00 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(265.00, udg_Temp_Unit_Point), function Trig_Immolation_Tick_NE_Func014A )
    call RemoveLocation (udg_Temp_Unit_Point)
    if ( Trig_Immolation_Tick_NE_Func016C() ) then
        set udg_SpellTicks[5] = ( udg_SpellTicks[5] + 1 )
    else
        call DisableTrigger( GetTriggeringTrigger() )
    endif
endfunction

