//===========================================================================
// Trigger: L TPL
//===========================================================================
function Trig_L_TPL_Func006Func001C takes nothing returns boolean
    if ( not ( GetItemTypeId(udg_P_Items[( udg_Bag_Num + udg_Bag_Iterator )]) == udg_ItemTypeCheck ) ) then
        return false
    endif
    return true
endfunction

function Trig_L_TPL_Func016C takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_Quests[36]) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_L_TPL_Actions takes nothing returns nothing
    local boolean hasItem
                       if IsHordeHero( GetTriggerUnit() ) then
    set hasItem = false
    call SetBagNumber( GetOwningPlayer(GetTriggerUnit()) )
    set udg_ItemTypeCheck = 'I05A'
    set udg_Bag_Iterator = 1
    loop
        exitwhen udg_Bag_Iterator > udg_BAG_LOOP_MAX
        if ( Trig_L_TPL_Func006Func001C() ) then
            set hasItem = true
        else
        endif
        set udg_Bag_Iterator = udg_Bag_Iterator + 1
    endloop
    if hasItem == false then
    call CreateTextTagUnitBJ( "TRIGSTR_4808", gg_unit_u00G_0057, 0, 8.00, 80.00, 0.00, 0.00, 0 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
    call cleanUpText( 1.25, 0.85 )
    call UnitAddItemByIdSwapped( 'I05A', GetTriggerUnit() )
    call DisableTrigger( GetTriggeringTrigger() )
    call TriggerSleepAction( udg_ITEM_LOSS_TIMEOUT )
    if ( Trig_L_TPL_Func016C() ) then
        call EnableTrigger( GetTriggeringTrigger() )
    else
    endif
    endif
                       endif
endfunction

//===========================================================================
function InitTrig_L_TPL takes nothing returns nothing
    set gg_trg_L_TPL = CreateTrigger(  )
    call DisableTrigger( gg_trg_L_TPL )
    call TriggerRegisterEnterRectSimple( gg_trg_L_TPL, gg_rct_The_Prodigal_Lich )
    call TriggerRegisterUnitInRangeSimple( gg_trg_L_TPL, 256, gg_unit_u00G_0057 )
    call TriggerAddAction( gg_trg_L_TPL, function Trig_L_TPL_Actions )
endfunction

//===========================================================================
// Trigger: E TPL
//===========================================================================
function Trig_E_TPL_Func005Func001C takes nothing returns boolean
    if ( not ( GetItemTypeId(udg_P_Items[( udg_Bag_Num + udg_Bag_Iterator )]) == udg_ItemTypeCheck ) ) then
        return false
    endif
    return true
endfunction

function Trig_E_TPL_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 36
                       if IsHordeHero( GetTriggerUnit() ) then
    call SetBagNumber( GetOwningPlayer(GetTriggerUnit()) )
    set udg_ItemTypeCheck = 'I05A'
    set udg_Bag_Iterator = 1
    loop
        exitwhen udg_Bag_Iterator > udg_BAG_LOOP_MAX
        if ( Trig_E_TPL_Func005Func001C() ) then
            call DisableTrigger( gg_trg_L_TPL )
            call DisableTrigger( GetTriggeringTrigger() )
            if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
            call FlashQuestDialogButtonBJ(  )
            endif
            call QuestSetCompletedBJ( udg_Quests[36], true )
            call DestroyEffectBJ( udg_QuestMarks[36] )
            call DestroyMinimapIcon( udg_MiniMapIcon[36] )
            // Clean Up Items
            call CleanUpItems( udg_ItemTypeCheck )
            // Rewards
            set udg_XP = udg_QUEST_XP[udg_Temp_Int]
            set udg_Gold = udg_QUEST_GOLD[udg_Temp_Int]
            set udg_LVL_Req = udg_QUEST_LVL_REQ[udg_Temp_Int]
            set udg_TempString = "The Prodigal Lich"
            call TriggerExecute( gg_trg_Quest_Complete_H )
            call CreateTextTagUnitBJ( "TRIGSTR_9458", gg_unit_Ulic_0007, 0, 8.00, 70.00, 0.00, 80.00, 0 )
            call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 10.00, 90.00 )
            call cleanUpText(1.25, 0.85)
            call TriggerSleepAction( 0.50 )
            set udg_TempString = ""
            if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
            set udg_TempString = udg_ExclamationMark
            endif
            call AddSpecialEffectTargetUnitBJ( "overhead", gg_unit_Ulic_0007, udg_TempString )
            set udg_QuestMarks[39] = GetLastCreatedEffectBJ()
            call EnableTrigger( gg_trg_S_PA )
            return
        else
        endif
        set udg_Bag_Iterator = udg_Bag_Iterator + 1
    endloop
                       endif
endfunction

