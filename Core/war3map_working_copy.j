//===========================================================================
// Trigger: Obliterate
//
// 
//                         
//===========================================================================
function Trig_Obliterate_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A037' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Obliterate_Func033A takes nothing returns nothing
    if IsUnitTargetableEnemyStab( GetEnumUnit(), udg_Temp_Unit ) then
    call AddSpecialEffectTargetUnitBJ( "overhead", GetEnumUnit(), "war3mapImported\\Ephemeral Cut Midnight.mdx" )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00) )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "overhead", GetEnumUnit(), "war3mapImported\\Ephemeral Cut Red.mdx" )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00) )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL )
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_Obliterate_Actions takes nothing returns nothing
    call AddSpecialEffectTargetUnitBJ( "weapon", GetTriggerUnit(), "war3mapImported\\Piercing Thrust Blue.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set udg_Temp_Unit = GetTriggerUnit()
    call TriggerExecute( gg_trg_Firelords_Helper)
    // Icy Talons
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 5 ]  then
    call SetUnitAbilityLevel( gg_unit_e028_1863, 'ACbb', 7 )
    call IssueTargetOrderBJ( gg_unit_e028_1863, "bloodlust", udg_Temp_Unit )
    endif
    // Damage Calculation
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 6.00 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A037', udg_Temp_Unit) * 65 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 10 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 3 ]  then
    set udg_RealStatCalc = ( udg_RealStatCalc * 1.08 )
    endif
    // Crit Bonus
    call TriggerExecute( gg_trg_Crit_Check)
    // AoE
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_Length = 430.00
    set udg_Width = 215.00
    set udg_Facing_Angle = GetUnitFacing(udg_Temp_Unit)
    set udg_Temp_Polar_Point = GetUnitLoc(udg_Temp_Unit)
    set udg_Temp_Unit_Point = PolarProjectionBJ(udg_Temp_Polar_Point, 50.00, ( udg_Facing_Angle + 180.00 ))
    // Offset by 180 b/c we want it to hit a little from behind
    call RemoveLocation (udg_Temp_Polar_Point)
    call TriggerExecute( gg_trg_PICK_EVERY_UNIT_IN_RECT )
    call RemoveLocation (udg_Temp_Unit_Point)
    call ForGroupBJ( udg_UnitsInRect, function Trig_Obliterate_Func033A )
endfunction

//===========================================================================
function InitTrig_Obliterate takes nothing returns nothing
    set gg_trg_Obliterate = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Obliterate, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Obliterate, Condition( function Trig_Obliterate_Conditions ) )
    call TriggerAddAction( gg_trg_Obliterate, function Trig_Obliterate_Actions )
endfunction

//===========================================================================
// Trigger: Remorseless Winter
//===========================================================================
function Trig_Remorseless_Winter_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A02J' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Remorseless_Winter_Actions takes nothing returns nothing
    local effect storm = null
    call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "war3mapImported\\RemorselessWinter.mdx" )
    		set storm = GetLastCreatedEffectBJ()
    call GameTimeWait( 4.0 )
    if IsUnitDeadBJ( GetTriggerUnit() ) then
    call DestroyEffectBJ( storm )
    set storm = null
    return
    endif
    call GameTimeWait( 4.0 )
    if IsUnitDeadBJ( GetTriggerUnit() ) then
    call DestroyEffectBJ( storm )
    set storm = null
    return
    endif
    call GameTimeWait( 4.0 )
    call DestroyEffectBJ( storm )
    set storm = null
endfunction

