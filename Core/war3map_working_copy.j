//===========================================================================
// Trigger: Thunderclap WarStomp
//
// //Note AOE was 240 + 20 * lvl, 250 to 390 in ability 
//===========================================================================
function Trig_Thunderclap_WarStomp_Func001C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'AHtc' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A034' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Thunderclap_WarStomp_Conditions takes nothing returns boolean
    if ( not Trig_Thunderclap_WarStomp_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Thunderclap_WarStomp_Func019A takes nothing returns nothing
    if IsUnitTargetableEnemyGround( GetEnumUnit(), udg_Temp_Unit ) then
    call HasFirelords( GetEnumUnit() )
    if udg_Temp_Bool then
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "Abilities\\Weapons\\Bolt\\BoltImpact.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    endif
    endif
endfunction

function Trig_Thunderclap_WarStomp_Actions takes nothing returns nothing
    local integer alvl =  GetUnitAbilityLevel(GetTriggerUnit(),GetSpellAbilityId())
    local real AOE = I2R( 245 + ( 15 * alvl ) )

    set udg_Temp_Unit = GetTriggerUnit()
    set udg_Temp_Bool = false
    call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)

    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_STR, GetTriggerUnit(), true) - GetHeroStatBJ(bj_HEROSTAT_STR, GetTriggerUnit(), false) ))
    set udg_RealStatCalc = ( 2.50 * udg_RealStatCalc )
    set udg_RealStatCalc = ( I2R( ( alvl * 40 ) + 20 ) + udg_RealStatCalc )
    
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 9 ]  then
    set udg_RealStatCalc = ( 300.00 + udg_RealStatCalc )
    set udg_Temp_Bool = true
    endif
    call DragonRoarSet()

    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, GetSpellAbilityId()), ABILITY_RLF_AOE_DAMAGE, ( alvl - 1 ), udg_RealStatCalc )

    set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll( AOE, udg_Temp_Unit_Point), function Trig_Thunderclap_WarStomp_Func019A )
    call RemoveLocation (udg_Temp_Unit_Point)
endfunction

//===========================================================================
function InitTrig_Thunderclap_WarStomp takes nothing returns nothing
    set gg_trg_Thunderclap_WarStomp = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Thunderclap_WarStomp, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Thunderclap_WarStomp, Condition( function Trig_Thunderclap_WarStomp_Conditions ) )
    call TriggerAddAction( gg_trg_Thunderclap_WarStomp, function Trig_Thunderclap_WarStomp_Actions )
endfunction


