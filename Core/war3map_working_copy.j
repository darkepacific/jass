//===========================================================================
// Trigger: S TSO A
//
// Create Quests for ALL players,
// Enable/Disable Quests for specific players
// Enable/Disabling quests does not cause desyncing.
//===========================================================================
function Trig_S_TSO_A_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 154
    local location udg_Temp_Unit_Point
                       if IsAllianceHero( GetTriggerUnit() ) then
    set udg_TempString = "The Scarlet Onslaught"
    set udg_TempString_Quest = "Kill 20 Scarlet Onslaught units"
    call TriggerExecute( gg_trg_Quest_Start_A )
    call DestroyEffectBJ( udg_QuestMarks[udg_Temp_Int] )
    // Icon
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Scarlet_Onslaught)
    call CampaignMinimapIconLocBJ( udg_Temp_Unit_Point, bj_CAMPPINGSTYLE_CONTROL_NEUTRAL )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_MiniMapIcon[udg_Temp_Int] = GetLastCreatedMinimapIcon()
    call SetMinimapIconVisible( udg_MiniMapIcon[udg_Temp_Int], false )
    if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
    call QuestSetEnabledBJ( true, udg_Quests[udg_Temp_Int] )
    call FlashQuestDialogButtonBJ(  )
    call SetMinimapIconVisible( udg_MiniMapIcon[udg_Temp_Int], true )
    endif
    call QuestSetCompletedBJ( udg_Quests[udg_Temp_Int], false )
    call CreateQuestItemBJ( udg_Quests[udg_Temp_Int], "TRIGSTR_8254" )
    set udg_QuestReqs[udg_Temp_Int] = GetLastCreatedQuestItemBJ()
    call DisableTrigger( GetTriggeringTrigger() )
    call EnableTrigger(gg_trg_U_TSO_A)
    call EnableTrigger(gg_trg_E_TSO_A)
                       endif
    set udg_Temp_Unit_Point = null
endfunction

