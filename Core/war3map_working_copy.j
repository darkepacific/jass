    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 14 ]  then
    if udg_Temp_Int2 > 0 then
    set udg_RealStatCalc = ( I2R(udg_Temp_Int2) * udg_RealStatCalc )
    call SetUnitLifeBJ( udg_Temp_Unit, ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_Temp_Unit) + ( 0.10 * udg_RealStatCalc ) ) )
    call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "Abilities\\Spells\\Items\\ResourceItems\\ResourceEffectTarget.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    endif
    endif
    if ( Trig_Lights_Hammer_Tick_Blood_Elf_Func033C() ) then
