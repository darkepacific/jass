    call TriggerRegisterAnyUnitEventBJ( gg_trg_Tree_Cast_TA, EVENT_PLAYER_UNIT_SPELL_FINISH )
    call TriggerAddCondition( gg_trg_Tree_Cast_TA, Condition( function Trig_Tree_Cast_TA_Conditions ) )
