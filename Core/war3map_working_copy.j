//===========================================================================
function Trig_Wild_Growth_Tick_TA_Func015Func007Func003C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetEnumUnit()) == 'e01D' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEnumUnit()) == 'e01F' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEnumUnit()) == 'e01G' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEnumUnit()) == 'e01H' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEnumUnit()) == 'e01K' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEnumUnit()) == 'e01L' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Wild_Growth_Tick_TA_Func015Func007C takes nothing returns boolean
    if ( not Trig_Wild_Growth_Tick_TA_Func015Func007Func003C() ) then
        return false
    endif
    return true
endfunction

function Trig_Wild_Growth_Tick_TA_Func015A takes nothing returns nothing
    if IsUnitTargetableAlly( GetEnumUnit(), udg_Temp_Unit ) then
    call SetUnitLifeBJ( GetEnumUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetEnumUnit()) + udg_RealStatCalc ) )
    call AddSpecialEffectTargetUnitBJ( "chest", GetEnumUnit(), "war3mapImported\\Heal Green.mdx" )
    call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 1.50 )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.70 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    if ( Trig_Wild_Growth_Tick_TA_Func015Func007C() ) then
        call BlzSetUnitWeaponRealFieldBJ( GetEnumUnit(), UNIT_WEAPON_RF_ATTACK_BASE_COOLDOWN, 0, 0.90 )
        call BlzSetUnitRealFieldBJ( GetEnumUnit(), UNIT_RF_SPEED, 330.00 )
    else
    endif
    endif
endfunction

function Trig_Wild_Growth_Tick_TA_Func022C takes nothing returns boolean
    if ( not ( udg_SpellTicks[udg_Temp_Int] == udg_Temp_Int2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Wild_Growth_Tick_TA_Actions takes nothing returns nothing
    set udg_Temp_Unit = udg_yH_Bal_Druid
    set udg_Temp_Int = 23
    // real stat calc
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 1.00 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A033', udg_Temp_Unit) * 25 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    call ChaliceSet()
    // scale for 10% dc per subsequent tick
    set udg_RealStatCalc = ( ( 0.10 * ( 11.00 - I2R(udg_SpellTicks[udg_Temp_Int]) ) ) * udg_RealStatCalc )
    // real stat calc has real damage value, and healing bonus
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Shaman_Eq_Ls[8])
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(240.00, udg_Temp_Unit_Point), function Trig_Wild_Growth_Tick_TA_Func015A )
    call RemoveLocation (udg_Temp_Unit_Point)
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 13 ]  then
    set udg_Temp_Int2 = 9
    else
    set udg_Temp_Int2 = 7
    endif
    if ( Trig_Wild_Growth_Tick_TA_Func022C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
    else
        set udg_SpellTicks[udg_Temp_Int] = ( udg_SpellTicks[udg_Temp_Int] + 1 )
    endif
endfunction

//===========================================================================
function InitTrig_Wild_Growth_Tick_TA takes nothing returns nothing
    set gg_trg_Wild_Growth_Tick_TA = CreateTrigger(  )
    call DisableTrigger( gg_trg_Wild_Growth_Tick_TA )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Wild_Growth_Tick_TA, 1.00 )
    call TriggerAddAction( gg_trg_Wild_Growth_Tick_TA, function Trig_Wild_Growth_Tick_TA_Actions )
endfunction

//===========================================================================
// Trigger: FoN Trees
//===========================================================================
function Trig_FoN_Trees_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A03F' ) ) then
        return false
    endif
    return true
endfunction

function Trig_FoN_Trees_Func010Func003C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A03F', GetTriggerUnit()) > 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_FoN_Trees_Func010C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A03F', GetTriggerUnit()) > 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_FoN_Trees_Actions takes nothing returns nothing
    local destructable tree1
    local destructable tree2
    local destructable tree3
    local destructable tree4
    set udg_Temp_Unit_Point = GetSpellTargetLoc()
    call CreateDestructableLoc( 'LTlt', udg_Temp_Unit_Point, GetRandomDirectionDeg(), 0.15, GetRandomInt(1, 9) )
    set tree1 = GetLastCreatedDestructable()
    call CreateDestructableLoc( 'LTlt', udg_Temp_Unit_Point, GetRandomDirectionDeg(), 0.15, GetRandomInt(1, 9) )
    set tree2 = GetLastCreatedDestructable()
    if ( Trig_FoN_Trees_Func010C() ) then
        call CreateDestructableLoc( 'LTlt', udg_Temp_Unit_Point, GetRandomDirectionDeg(), 0.15, GetRandomInt(1, 9) )
        set tree3 = GetLastCreatedDestructable()
        if ( Trig_FoN_Trees_Func010Func003C() ) then
            call CreateDestructableLoc( 'LTlt', udg_Temp_Unit_Point, GetRandomDirectionDeg(), 0.15, GetRandomInt(1, 9) )
            set tree4 = GetLastCreatedDestructable()
        else
        endif
    else
    endif
    call SetUnitOwner( gg_unit_e028_1863, GetOwningPlayer(GetTriggerUnit()), true )
    call SetUnitAbilityLevelSwapped( 'A0CT', gg_unit_e028_1863, GetUnitAbilityLevelSwapped('A03F', GetTriggerUnit()) )
    call IssuePointOrderLocBJ( gg_unit_e028_1863, "forceofnature", udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    // clean up trees
    call GameTimeWait(1.0)
    call KillDestructable(tree1)
    call KillDestructable(tree2)
    call KillDestructable(tree3)
    call KillDestructable(tree4)
    set tree1 = null
    set tree2 = null
    set tree3 = null
    set tree4 = null
endfunction

//===========================================================================
function InitTrig_FoN_Trees takes nothing returns nothing
    set gg_trg_FoN_Trees = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_FoN_Trees, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_FoN_Trees, Condition( function Trig_FoN_Trees_Conditions ) )
    call TriggerAddAction( gg_trg_FoN_Trees, function Trig_FoN_Trees_Actions )
endfunction

//===========================================================================
// Trigger: Typhoon
//
// Calc distance in tics
//===========================================================================
function Trig_Typhoon_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0E4' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Typhoon_Actions takes nothing returns nothing
    local integer udg_Temp_Int
    set udg_Temp_Unit = GetTriggerUnit()
    if (udg_Temp_Unit == udg_yA_Bal_Druid) then
    set udg_Temp_Int = 30
    elseif (udg_Temp_Unit == udg_yH_Bal_Druid) then
    set udg_Temp_Int = 31
    else
    set udg_Temp_Int = 63
    endif
    set udg_Point_Charge_Begin[udg_Temp_Int] = GetUnitLoc(GetSpellAbilityUnit())
    set udg_Temp_Polar_Point = GetSpellTargetLoc()
    set udg_Temp_Unit_Point = PolarProjectionBJ(udg_Point_Charge_Begin[udg_Temp_Int], 10.00, AngleBetweenPoints(udg_Point_Charge_Begin[udg_Temp_Int], udg_Temp_Polar_Point))
    call RemoveLocation (udg_Point_Charge_Begin[udg_Temp_Int])
    set udg_Point_Charge_Begin[udg_Temp_Int] = udg_Temp_Unit_Point
    set udg_Charge_Distance = 480.00
    set udg_Point_Charge_End[udg_Temp_Int] = PolarProjectionBJ(udg_Point_Charge_Begin[udg_Temp_Int], udg_Charge_Distance, AngleBetweenPoints(udg_Point_Charge_Begin[udg_Temp_Int], udg_Temp_Polar_Point))
    call RemoveLocation (udg_Temp_Polar_Point)
    set udg_Charge_Loop[udg_Temp_Int] = 0.00
    set udg_SpellTicks[udg_Temp_Int] = 0
    call PlaySoundAtPointBJ( null, 100, udg_Point_Charge_Begin[udg_Temp_Int], 0 )
    if (udg_Temp_Int == 30) then
    call EnableTrigger( gg_trg_Typhoon_Tick_NE)
    elseif (udg_Temp_Int == 31) then
    call EnableTrigger( gg_trg_Typhoon_Tick_TA)
    else
    call EnableTrigger( gg_trg_Ice_Typhoon_Tick)
    endif
endfunction

//===========================================================================
function InitTrig_Typhoon takes nothing returns nothing
    set gg_trg_Typhoon = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Typhoon, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Typhoon, Condition( function Trig_Typhoon_Conditions ) )
    call TriggerAddAction( gg_trg_Typhoon, function Trig_Typhoon_Actions )
endfunction

//===========================================================================
// Trigger: Typhoon Tick NE
//===========================================================================
function Trig_Typhoon_Tick_NE_Func012C takes nothing returns boolean
    if ( not ( udg_Charge_Loop[udg_Temp_Int] < 14.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Typhoon_Tick_NE_Func031Func023C takes nothing returns boolean
    if ( not ( IsUnitInGroup(GetEnumUnit(), udg_KnockBacks) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Typhoon_Tick_NE_Func031A takes nothing returns nothing
    if IsUnitTargetableEnemyGround( GetEnumUnit(), udg_Temp_Unit ) then
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call AddSpecialEffectTargetUnitBJ( "chest", GetEnumUnit(), "Abilities\\Spells\\Other\\CrushingWave\\CrushingWaveDamage.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call HasFirelords( GetEnumUnit() )
    ////
    // ======= //
    // mvmnt
    set udg_Temp_X_Point = GetUnitLoc(GetEnumUnit())
    set udg_Temp_Real = AngleBetweenPoints(udg_Temp_Unit_Point, udg_Temp_X_Point)
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_X_Point, 80.00, udg_Temp_Real)
    if not IsTerrainPathable( GetLocationX(udg_Temp_Polar_Point), GetLocationY(udg_Temp_Polar_Point), PATHING_TYPE_WALKABILITY) then
    call SetUnitPositionLoc( GetEnumUnit(), udg_Temp_Polar_Point )
    endif
    call AddSpecialEffectLocBJ( udg_Temp_Polar_Point, "Abilities\\Weapons\\BallistaMissile\\BallistaMissile.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call RemoveLocation (udg_Temp_X_Point)
    call RemoveLocation (udg_Temp_Polar_Point)
    // KnockBackLoop Turn ON
    call UnitAddAbilityBJ( 'Amrf', GetEnumUnit() )
    call UnitRemoveAbilityBJ( 'Amrf', GetEnumUnit() )
    call SetUnitFlyHeightBJ( GetEnumUnit(), 135.00, 0.00 )
    if ( Trig_Typhoon_Tick_NE_Func031Func023C() ) then
        call GroupAddUnitSimple( GetEnumUnit(), udg_KnockBacks )
    else
        call FlushChildHashtableBJ( GetHandleIdBJ(GetEnumUnit()), udg_KnockBacksHash )
    endif
    call SaveRealBJ( udg_Temp_Real, 0, GetHandleIdBJ(GetEnumUnit()), udg_KnockBacksHash )
    call SaveRealBJ( 3.00, 1, GetHandleIdBJ(GetEnumUnit()), udg_KnockBacksHash )
    call SaveRealBJ( 172.00, 2, GetHandleIdBJ(GetEnumUnit()), udg_KnockBacksHash )
    call SaveRealBJ( 13.00, 3, GetHandleIdBJ(GetEnumUnit()), udg_KnockBacksHash )
    // ======= //
    ////
    endif
endfunction

function Trig_Typhoon_Tick_NE_Func034C takes nothing returns boolean
    if ( not ( udg_Charge_Loop[udg_Temp_Int] < 14.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Typhoon_Tick_NE_Actions takes nothing returns nothing
    set udg_Temp_Unit = udg_yA_Bal_Druid
    call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
    set udg_Temp_Int = 30
    // Damage Calculation
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - 0 ))
    set udg_RealStatCalc = ( 1.50 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A0E4', udg_Temp_Unit) * 50 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 50 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    // point calc
    set udg_Length = 40.00
    if ( Trig_Typhoon_Tick_NE_Func012C() ) then
        set udg_Width = ( 140.00 + ( 25.00 * udg_Charge_Loop[udg_Temp_Int] ) )
        set udg_Facing_Angle = AngleBetweenPoints(udg_Point_Charge_Begin[udg_Temp_Int], udg_Point_Charge_End[udg_Temp_Int])
        set udg_Temp_Unit_Point = PolarProjectionBJ(udg_Point_Charge_Begin[udg_Temp_Int], ( udg_Length * udg_Charge_Loop[udg_Temp_Int] ), udg_Facing_Angle)
    else
    endif
    call TriggerExecute( gg_trg_PICK_EVERY_UNIT_IN_RECT )
    call DestroyEffectBJ( udg_CrimsonTempest[6] )
    call DestroyEffectBJ( udg_CrimsonTempest[7] )
    call DestroyEffectBJ( udg_CrimsonTempest[8] )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Weapons\\LichMissile\\LichMissile.mdl" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 1.00 )
    set udg_CrimsonTempest[6] = GetLastCreatedEffectBJ()
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, ( udg_Width / 2.80 ), ( udg_Facing_Angle + 90.00 ))
    call AddSpecialEffectLocBJ( udg_Temp_Polar_Point, "Abilities\\Weapons\\LichMissile\\LichMissile.mdl" )
    set udg_CrimsonTempest[7] = GetLastCreatedEffectBJ()
    call RemoveLocation (udg_Temp_Polar_Point)
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, ( udg_Width / 2.80 ), ( udg_Facing_Angle - 90.00 ))
    call AddSpecialEffectLocBJ( udg_Temp_Polar_Point, "Abilities\\Weapons\\LichMissile\\LichMissile.mdl" )
    set udg_CrimsonTempest[8] = GetLastCreatedEffectBJ()
    call RemoveLocation (udg_Temp_Polar_Point)
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = GetUnitLoc( udg_Temp_Unit)
    // AoE
    call ForGroupBJ( udg_UnitsInRect, function Trig_Typhoon_Tick_NE_Func031A )
    call RemoveLocation (udg_Temp_Unit_Point)
    call EnableTrigger( gg_trg_KnockBackLoop)
    if ( Trig_Typhoon_Tick_NE_Func034C() ) then
        set udg_Charge_Loop[udg_Temp_Int] = ( udg_Charge_Loop[udg_Temp_Int] + 1 )
    else
        call DestroyEffectBJ( udg_CrimsonTempest[6] )
        call DestroyEffectBJ( udg_CrimsonTempest[7] )
        call DestroyEffectBJ( udg_CrimsonTempest[8] )
        call RemoveLocation (udg_Point_Charge_Begin[udg_Temp_Int])
        call RemoveLocation (udg_Point_Charge_End[udg_Temp_Int])
        call DisableTrigger( GetTriggeringTrigger() )
    endif
endfunction

//===========================================================================
function InitTrig_Typhoon_Tick_NE takes nothing returns nothing
    set gg_trg_Typhoon_Tick_NE = CreateTrigger(  )
    call DisableTrigger( gg_trg_Typhoon_Tick_NE )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Typhoon_Tick_NE, 0.04 )
    call TriggerAddAction( gg_trg_Typhoon_Tick_NE, function Trig_Typhoon_Tick_NE_Actions )
endfunction

