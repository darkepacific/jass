//===========================================================================
// Trigger: Soul Drain Tick WG
//===========================================================================
function Trig_Soul_Drain_Tick_WG_Actions takes nothing returns nothing
    set udg_Temp_Unit = udg_yA_Demon_Warlock
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_o = ( udg_z_WL_DEMO_A + 4 )
    call UnitDamageTargetBJ( udg_Temp_Unit, udg_SpellUnits[udg_o], ( udg_RealStatCalc / 2.00 ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A00D', udg_Temp_Unit) * 25 )
    call ChaliceSet()
    // Inc Healing Talent
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 2 ] then
        //   RSC  == ( Base + RSC ) * 1.2
    set udg_RealStatCalc = ( ( udg_CHALICE_HEAL * I2R(udg_HeroStatCalc) ) + ( udg_RealStatCalc * ( 1 + udg_CHALICE_HEAL ) ) )
    endif
    call SetUnitLifeBJ( udg_Temp_Unit, ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_Temp_Unit) + ( udg_RealStatCalc / 2.00 ) ) )
    call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
    call HasFirelords(  udg_SpellUnits[udg_o] )
    // Curse of Ex
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 3 ] then
    call SetUnitAbilityLevelSwapped( 'A03P', gg_unit_e028_1863, 4 )
    call SetUnitOwner( gg_unit_e028_1863, GetOwningPlayer(udg_Temp_Unit), true )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(gg_unit_e028_1863, 'A03P'), ABILITY_RLF_DURATION_NORMAL, 3, 0.7 )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(gg_unit_e028_1863, 'A03P'), ABILITY_RLF_DURATION_HERO, 3, 0.7 )
    call IssueTargetOrder( gg_unit_e028_1863, "slow", udg_SpellUnits[udg_o] )
    endif
endfunction

//===========================================================================
