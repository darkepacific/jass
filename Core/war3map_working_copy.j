    set gg_trg_Makgora = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Makgora, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Makgora, Condition( function Trig_Makgora_Conditions ) )
