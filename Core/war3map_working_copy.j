//===========================================================================
// Trigger: Sapplings
//===========================================================================
function Trig_Sapplings_Func012C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'e01D' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'e01F' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'e01G' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'e01H' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'e01K' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'e01L' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Sapplings_Conditions takes nothing returns boolean
    if ( not Trig_Sapplings_Func012C() ) then
        return false
    endif
    return true
endfunction

function Trig_Sapplings_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_X_Player_MUI = GetOwningPlayer( GetTriggerUnit() )
     if udg_TalentChoices[ GetPlayerId( udg_X_Player_MUI ) * udg_NUM_OF_TC + 14 ]  then
    call PlayerNumbtoHeroesNumbParam( udg_X_Player_MUI)
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Objects\\Spawnmodels\\NightElf\\EntBirthTarget\\EntBirthTarget.mdl" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.50 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call CreateSappling( udg_Temp_Unit)
    call RemoveLocation (udg_Temp_Unit_Point)
    endif
endfunction

//===========================================================================
function InitTrig_Sapplings takes nothing returns nothing
    set gg_trg_Sapplings = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Sapplings, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_Sapplings, Condition( function Trig_Sapplings_Conditions ) )
    call TriggerAddAction( gg_trg_Sapplings, function Trig_Sapplings_Actions )
endfunction

//===========================================================================
// Trigger: Moonfire Bal
//
// was wait .65 in between set moonfire target and and temp unit point
//===========================================================================
function Trig_Moonfire_Bal_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0D0' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Moonfire_Bal_Actions takes nothing returns nothing
    call UnitDamageTargetBJ( GetTriggerUnit(), GetSpellTargetUnit(), ( 2.00 * I2R(GetHeroStatBJ(bj_HEROSTAT_INT, GetSpellAbilityUnit(), true)) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
endfunction

//===========================================================================
function InitTrig_Moonfire_Bal takes nothing returns nothing
    set gg_trg_Moonfire_Bal = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Moonfire_Bal, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Moonfire_Bal, Condition( function Trig_Moonfire_Bal_Conditions ) )
    call TriggerAddAction( gg_trg_Moonfire_Bal, function Trig_Moonfire_Bal_Actions )
endfunction

//===========================================================================
// Trigger: Moonfire Finish
//
// was wait .65 in between set moonfire target and and temp unit point
//===========================================================================
function Trig_Moonfire_Finish_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0D0' ) ) then
        return false
    endif
    if ( not ( BlzGetUnitAbilityCooldownRemaining(GetTriggerUnit(), 'A0D0') > 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Moonfire_Finish_Func003C takes nothing returns boolean
    if ( not ( udg_Eclipse[0] == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Moonfire_Finish_Func006C takes nothing returns boolean
    if ( not ( udg_Eclipse[1] == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Moonfire_Finish_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    if (  udg_Temp_Unit == udg_yA_Bal_Druid ) then
    if ( Trig_Moonfire_Finish_Func003C() ) then
        set udg_Eclipse[0] = 0
        set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A0D0', udg_Temp_Unit) * 5 )
        set udg_HeroStatCalc = ( udg_HeroStatCalc + 40 )
        call BlzSetUnitAbilityManaCost(udg_Temp_Unit, 'A0D0', GetUnitAbilityLevel(udg_Temp_Unit, 'A0D0') - 1, udg_HeroStatCalc )
        call BlzEndUnitAbilityCooldown( GetTriggerUnit(), 'A0D0' )
    else
    endif
    endif
    if (  udg_Temp_Unit == udg_yH_Bal_Druid ) then
    if ( Trig_Moonfire_Finish_Func006C() ) then
        set udg_Eclipse[1] = 0
        set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A0D0', udg_Temp_Unit) * 5 )
        set udg_HeroStatCalc = ( udg_HeroStatCalc + 40 )
        call BlzSetUnitAbilityManaCost(udg_Temp_Unit, 'A0D0', GetUnitAbilityLevel(udg_Temp_Unit, 'A0D0') - 1, udg_HeroStatCalc )
        call BlzEndUnitAbilityCooldown( GetTriggerUnit(), 'A0D0' )
    else
    endif
    endif
endfunction

