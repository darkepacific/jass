//===========================================================================
function Trig_Make_Landgren_Conditions takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetDyingDestructable()) == 'LOcg' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Make_Landgren_Func017C takes nothing returns boolean
    if ( not ( GetTriggerExecCount(GetTriggeringTrigger()) > 1 ) ) then
        return false
    endif
    if ( not ( ModuloInteger(GetTriggerExecCount(GetTriggeringTrigger()), 6) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Make_Landgren_Actions takes nothing returns nothing
    local unit Freed
    local destructable cage = GetDyingDestructable()
    local location udg_Temp_Unit_Point
    local unit udg_Temp_Unit
    set udg_Temp_Unit_Point = GetDestructableLoc(GetDyingDestructable())
    call CreateNUnitsAtLoc( 1, 'h042', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
    call StopSoundBJ( gg_snd_Loading, false )
    call PlaySoundAtPointBJ( gg_snd_Loading, 100, udg_Temp_Unit_Point, 25.00 )
    call RemoveLocation (udg_Temp_Unit_Point)
    call SetUnitColor( GetLastCreatedUnit(), PLAYER_COLOR_RED )
    set Freed = GetLastCreatedUnit()
     call CreateTextTagUnitBJ( "!", Freed, 0.00, 8.00, 100.00, 100.00, 0.00, 0 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
    call cleanUpText(1.2, 0.8)
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_High_Abbot_Landgren)
    if ( Trig_Make_Landgren_Func017C() ) then
        if udg_HighAbbotLandgren == null then
        call CreateNUnitsAtLoc( 1, 'H041', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Temp_Unit_Point, 300.00 )
        set udg_HighAbbotLandgren = GetLastCreatedUnit()
        call SetHeroLevelBJ( GetLastCreatedUnit(), 40, false )
        call IncUnitAbilityLevelSwapped( 'A02T', GetLastCreatedUnit() )
        call IncUnitAbilityLevelSwapped( 'A02T', GetLastCreatedUnit() )
        call IncUnitAbilityLevelSwapped( 'A02T', GetLastCreatedUnit() )
        call IncUnitAbilityLevelSwapped( 'A02T', GetLastCreatedUnit() )
        call IncUnitAbilityLevelSwapped( 'A02T', GetLastCreatedUnit() )
        call IncUnitAbilityLevelSwapped( 'A02T', GetLastCreatedUnit() )
        call IncUnitAbilityLevelSwapped( 'A02T', GetLastCreatedUnit() )
        call IncUnitAbilityLevelSwapped( 'A02T', GetLastCreatedUnit() )
        call IncUnitAbilityLevelSwapped( 'A00K', GetLastCreatedUnit() )
        call IncUnitAbilityLevelSwapped( 'A00K', GetLastCreatedUnit() )
        call IncUnitAbilityLevelSwapped( 'A00K', GetLastCreatedUnit() )
        call IncUnitAbilityLevelSwapped( 'A00K', GetLastCreatedUnit() )
        call IncUnitAbilityLevelSwapped( 'A00K', GetLastCreatedUnit() )
        call IncUnitAbilityLevelSwapped( 'A00K', GetLastCreatedUnit() )
        call IncUnitAbilityLevelSwapped( 'A00K', GetLastCreatedUnit() )
        call IncUnitAbilityLevelSwapped( 'A00K', GetLastCreatedUnit() )
        call IncUnitAbilityLevelSwapped( 'A002', GetLastCreatedUnit() )
        call IncUnitAbilityLevelSwapped( 'A002', GetLastCreatedUnit() )
        call IncUnitAbilityLevelSwapped( 'A002', GetLastCreatedUnit() )
        call IncUnitAbilityLevelSwapped( 'A002', GetLastCreatedUnit() )
        call IncUnitAbilityLevelSwapped( 'A002', GetLastCreatedUnit() )
        call IncUnitAbilityLevelSwapped( 'A002', GetLastCreatedUnit() )
        call IncUnitAbilityLevelSwapped( 'A08W', GetLastCreatedUnit() )
        call IncUnitAbilityLevelSwapped( 'A08W', GetLastCreatedUnit() )
        call IncUnitAbilityLevelSwapped( 'A08W', GetLastCreatedUnit() )
        call IncUnitAbilityLevelSwapped( 'A08W', GetLastCreatedUnit() )
        call IncUnitAbilityLevelSwapped( 'A08W', GetLastCreatedUnit() )
        call IncUnitAbilityLevelSwapped( 'A08W', GetLastCreatedUnit() )
        call IncUnitAbilityLevelSwapped( 'A08W', GetLastCreatedUnit() )
        call IncUnitAbilityLevelSwapped( 'A08W', GetLastCreatedUnit() )
        call MaxManaRestore( 1.0, udg_HighAbbotLandgren)
        call SetUnitColor( GetLastCreatedUnit(), GetPlayerColor(Player(0)) )
        else
        set udg_Temp_Unit = udg_HighAbbotLandgren
        call ShowHero(  udg_Temp_Unit ,  udg_Temp_Unit_Point,  false)
        call MaxManaRestore( 1.0, udg_Temp_Unit)
        call SetUnitColor( udg_Temp_Unit, PLAYER_COLOR_RED )
        endif
        call CreateTextTagUnitBJ( "WHO IS FREEING ALL THE PRISONERS?", udg_HighAbbotLandgren, 0, 9.00, 100.00, 15.00, 15.00, 0 )
        call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 10.00, 90.00 )
        call cleanUpText(2.0, 1.6)
        call StopSoundBJ( gg_snd_HumanMaleAggroA, false )
        call PlaySoundAtPointBJ( gg_snd_HumanMaleAggroA, 100, udg_Temp_Unit_Point, 25.00 )
    else
    endif
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 60.00 )
    call DestructableRestoreLife( cage, 50.00, false )
    set Freed = null
    set cage = null
    set udg_Temp_Unit = null
    set udg_Temp_Unit_Point = null
endfunction

