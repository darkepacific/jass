    call IssueTargetOrderBJ( GetAttackedUnitBJ(), "attack", GetAttacker() )
    call TriggerSleepAction( 5.00 )
    call IssueTargetOrderBJ( GetTriggerUnit(), "harvest", gg_unit_n00I_0325 )
    call TriggerSleepAction( 2.00 )
    call IssueTargetOrderBJ( GetTriggerUnit(), "harvest", gg_unit_n00I_0325 )
endfunction

