//===========================================================================
function Trig_U_FBP_Func004C takes nothing returns boolean
    if ( not ( udg_QuestFBP[0] < 3.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_U_FBP_Func005C takes nothing returns boolean
    if ( not ( udg_QuestFBP[1] < 1.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_U_FBP_Func006C takes nothing returns boolean
    if ( not ( udg_QuestFBP[2] < 1.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_U_FBP_Actions takes nothing returns nothing
                       if IsHordeHero( GetTriggerUnit() ) then
    if ( Trig_U_FBP_Func004C() ) then
        set udg_ItemTypeCheck = 'I044'
        set udg_ItemQuestNumber = 47.10
        call TriggerExecute( gg_trg_ABag_Check )
    else
    endif
    if ( Trig_U_FBP_Func005C() ) then
        set udg_ItemTypeCheck = 'I05Q'
        set udg_ItemQuestNumber = 47.20
        call TriggerExecute( gg_trg_ABag_Check )
    else
    endif
    if ( Trig_U_FBP_Func006C() ) then
        set udg_ItemTypeCheck = 'I02X'
        set udg_ItemQuestNumber = 47.30
        call TriggerExecute( gg_trg_ABag_Check )
    else
    endif
    call QuestItemSetDescriptionBJ( udg_QuestReqs[47], ( "Frozen Body Parts, Live Instentines, & Ichor of Undeath |n- " + ( R2SW(udg_QuestFBP[0], 2, 0) + ( "/3.0                            " + ( R2SW(udg_QuestFBP[1], 2, 0) + ( "/1.0                            " + ( R2SW(udg_QuestFBP[2], 2, 0) + "/1.0" ) ) ) ) ) ) )
                       endif
endfunction

