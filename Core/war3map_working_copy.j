function InitTrig_Into_the_Fray_and_Second_Wind takes nothing returns nothing
    set gg_trg_Into_the_Fray_and_Second_Wind = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Into_the_Fray_and_Second_Wind, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddAction( gg_trg_Into_the_Fray_and_Second_Wind, function Trig_Into_the_Fray_and_Second_Wind_Actions )
endfunction

//===========================================================================
// Trigger: Execute Begin
//
// Change values to 
// (300+(500+(129+72)*8))  / (300+(500+(129+0)*8))
//===========================================================================
function Trig_Execute_Begin_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A02E' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Execute_Begin_Actions takes nothing returns nothing
    local unit udg_Temp_Unit = GetTriggerUnit()
    local unit target
    local integer udg_o
    // Arms A
    if udg_Temp_Unit == udg_yA_Arms_Warr then
    set udg_o = ( udg_z_WR_ARMS_A + 0 )
    call EnableTrigger( gg_trg_Execute_Arms_A )
    // Arms H
    elseif udg_Temp_Unit == udg_yH_Arms_Warr then
    set udg_o = ( udg_z_WR_ARMS_H + 0 )
    call EnableTrigger( gg_trg_Execute_Arms_H )
    // Fury A
    elseif udg_Temp_Unit == udg_yA_Fury_Warr then
    set udg_o = ( udg_z_WR_FURY_A + 0 )
    call EnableTrigger( gg_trg_Execute_Fury_A )
    // Fury H
    elseif udg_Temp_Unit == udg_yH_Fury_Warr then
    set udg_o = ( udg_z_WR_FURY_H + 0 )
    call EnableTrigger( gg_trg_Execute_Fury_H )
    // Prot A
    elseif udg_Temp_Unit == udg_yA_Prot_Warr then
    set udg_o = ( udg_z_WR_PROT_A + 0 )
    call EnableTrigger( gg_trg_Execute_Prot_A )
    // Prot H
    elseif udg_Temp_Unit == udg_yH_Prot_Warr then
    set udg_o = ( udg_z_WR_PROT_H + 0 )
    call EnableTrigger( gg_trg_Execute_Prot_H )
    endif
    // Set SpellUnit
    set udg_SpellUnits[udg_o] = GetSpellTargetUnit()
    set target = udg_SpellUnits[udg_o]
    // Wait
    call TriggerSleepAction( 0.10 )
    call ExecuteDamage( target, udg_Temp_Unit)
    call GameTimeWait(1.2)
    // Turn Off
    if udg_SpellUnits[udg_o] == target then
    if udg_Temp_Unit == udg_yA_Arms_Warr then
    call DisableTrigger( gg_trg_Execute_Arms_A )
    elseif udg_Temp_Unit == udg_yH_Arms_Warr then
    call DisableTrigger( gg_trg_Execute_Arms_H )
    elseif udg_Temp_Unit == udg_yA_Fury_Warr then
    call DisableTrigger( gg_trg_Execute_Fury_A )
    elseif udg_Temp_Unit == udg_yH_Fury_Warr then
    call DisableTrigger( gg_trg_Execute_Fury_H )
    elseif udg_Temp_Unit == udg_yA_Prot_Warr then
    call DisableTrigger( gg_trg_Execute_Prot_A )
    elseif udg_Temp_Unit == udg_yH_Prot_Warr then
    call DisableTrigger( gg_trg_Execute_Prot_H )
    endif
    endif
    set target = null
    set udg_Temp_Unit = null
endfunction

//===========================================================================
function InitTrig_Execute_Begin takes nothing returns nothing
    set gg_trg_Execute_Begin = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Execute_Begin, EVENT_PLAYER_UNIT_SPELL_CAST )
    call TriggerAddCondition( gg_trg_Execute_Begin, Condition( function Trig_Execute_Begin_Conditions ) )
    call TriggerAddAction( gg_trg_Execute_Begin, function Trig_Execute_Begin_Actions )
endfunction

