function Trig_M_DoomWeed_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 75
    set udg_TempString = "So you can see the predicament that I'm in. That thing is out there collecting the wrong weeds! I'll make it worth your while. Gather what I need. Bring back to me four doom weed and I'll give you a suitable reward."
    set udg_TempString = ( udg_TempString + " You will find some at the graveyard to the north of here but be wary of the Gnolls." )
    // Set Quest Rewards
    set udg_QUEST_XP[udg_Temp_Int] = 200
    set udg_QUEST_GOLD[udg_Temp_Int] = 100
    call QuestRewards_TextSet(udg_Temp_Int)
    // End Set Quest Rewards
    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_420", udg_TempString, "ReplaceableTextures\\CommandButtons\\BTNInv_misc_herb_13.blp" )
    set udg_Quests[75] = GetLastCreatedQuestBJ()
    call QuestSetEnabledBJ( false, GetLastCreatedQuestBJ() )
    call EnableTrigger( gg_trg_C_DW )
endfunction

