function InitTrig_Advanced_Blink takes nothing returns nothing
    set gg_trg_Advanced_Blink = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Advanced_Blink, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Advanced_Blink, Condition( function Trig_Advanced_Blink_Conditions ) )
    call TriggerAddAction( gg_trg_Advanced_Blink, function Trig_Advanced_Blink_Actions )
endfunction

