//===========================================================================
// Trigger: STUCK
//===========================================================================
function Trig_STUCK_Func001Func001C takes nothing returns boolean
    if ( not ( GetOwningPlayer(udg_Heroes[udg_Player_Number]) == GetTriggerPlayer() ) ) then
        return false
    endif
    return true
endfunction

function Trig_STUCK_Actions takes nothing returns nothing
    set bj_forLoopAIndex = 0
    set bj_forLoopAIndexEnd = 7
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_STUCK_Func001Func001C() ) then
            call KillUnit( udg_Heroes[udg_Player_Number] )
            exitwhen true
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
endfunction

