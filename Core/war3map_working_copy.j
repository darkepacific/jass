//===========================================================================
// Trigger: Reliquary of Souls Turn On
//===========================================================================
function Trig_Reliquary_of_Souls_Turn_On_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0GC' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Reliquary_of_Souls_Turn_On_Actions takes nothing returns nothing
    local effect e
    local unit u = GetTriggerUnit()
    local integer udg_Temp_Int
    if GetUnitTypeId( u ) != 'E04M' then
    if ( u == udg_yA_Dark_Ranger) then
    call StopSoundBJ( gg_snd_Sylvanas_BansheeScreamA, false )
    call PlaySoundOnUnitBJ( gg_snd_Sylvanas_BansheeScream, 81.00, GetTriggerUnit() )
    elseif ( u == udg_yH_Dark_Ranger) then
    call StopSoundBJ( gg_snd_Sylvanas_BansheeScreamH, false )
    call PlaySoundOnUnitBJ( gg_snd_Sylvanas_BansheeScream, 81.00, GetTriggerUnit() )
    else
    call StopSoundBJ( gg_snd_Sylvanas_BansheeScream, false )
    call PlaySoundOnUnitBJ( gg_snd_Sylvanas_BansheeScream, 81.00, GetTriggerUnit() )
    endif
    call SetUnitVertexColorBJ( GetTriggerUnit(), 78.45, 45.00, 100, 0.00 )
    call GameTimeWait(0.25)
    // Important! necessary to prevent where DR dies before fully transforming
    if IsUnitAlive( u ) then
    call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "war3mapImported\\Soul Discharge Purple.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "war3mapImported\\Singularity I Purple.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "Abilities\\Spells\\Other\\Drain\\DrainTarget.mdl" )
    set e = GetLastCreatedEffectBJ()
    if ( u == udg_yA_Dark_Ranger) then
    call EnableTrigger( gg_trg_Reliquary_Tick_A)
    elseif ( u == udg_yH_Dark_Ranger) then
    call EnableTrigger( gg_trg_Reliquary_Tick_H)
    else
    call EnableTrigger( gg_trg_Reliquary_Tick_N)
    endif
    if udg_Temp_Unit != gg_unit_Usyl_0179 then
    call SetPlayerAbilityAvailableBJ( false, 'A04V', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'A04W', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'A05B', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'A04X', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'ACch', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'A0DH', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'AIfs', GetOwningPlayer(GetTriggerUnit()) )
    endif
    call GameTimeWait(5.0)
    call DestroyEffect(e)
    endif
    // ELSE on recasting the ability after 5 seconds
    else
    call GameTimeWait(0.25)
    set udg_Temp_Int = 60
    loop
        exitwhen udg_Temp_Int > 89
        call DestroyLightningBJ( udg_LightningEffects[udg_Temp_Int] )
        set udg_LightningEffects[ udg_Temp_Int ] = null
        set udg_Temp_Int = udg_Temp_Int + 1
    endloop
    call SetUnitVertexColorBJ( GetTriggerUnit(), 100.00, 100.00, 100, 0.00 )
    if udg_Temp_Unit != gg_unit_Usyl_0179 then
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer( u )) * udg_NUM_OF_TC + 4 ]  then
    call BlzSetUnitBaseDamage(u, BlzGetUnitBaseDamage(u,0)+25, 0)
    endif
    endif
    call StopSoundBJ( gg_snd_Spell_PR_Revamp_Shadow_Crash_Impact_02, false )
    call PlaySoundOnUnitBJ( gg_snd_Spell_PR_Revamp_Shadow_Crash_Impact_02, 81.00, GetTriggerUnit() )
    if ( u == udg_yA_Dark_Ranger) then
    call DisableTrigger( gg_trg_Reliquary_Tick_A)
    elseif ( u == udg_yH_Dark_Ranger) then
    call DisableTrigger( gg_trg_Reliquary_Tick_H)
    else
    call DisableTrigger( gg_trg_Reliquary_Tick_N)
    endif
    if udg_Temp_Unit != gg_unit_Usyl_0179 then
    call SetPlayerAbilityAvailableBJ( true, 'A04V', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A04W', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A05B', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A04X', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'ACch', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A0DH', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'AIfs', GetOwningPlayer(GetTriggerUnit()) )
    endif
    call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "war3mapImported\\Singularity I Purple.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    endif
    set e = null
    set u = null
endfunction

