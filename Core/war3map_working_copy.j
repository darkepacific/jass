//===========================================================================
function Trig_S_CFD_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
                       if IsAllianceHero( GetTriggerUnit() ) then
    set udg_TempString = "Claws from the Deep"
    set udg_TempString_Quest = "Kill Gobbler and return his head."
    call TriggerExecute( gg_trg_Quest_Start_A )
    set udg_TempString = ""
    if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
    set udg_TempString = udg_QuestionMark
    call QuestSetEnabledBJ( true, udg_Quests[38] )
    call FlashQuestDialogButtonBJ(  )
    endif
    call DestroyEffectBJ( udg_QuestMarks[38] )
    call AddSpecialEffectTargetUnitBJ( "overhead", gg_unit_H00K_0455, udg_TempString )
    set udg_QuestMarks[38] = GetLastCreatedEffectBJ()
    call QuestSetCompletedBJ( udg_Quests[38], false )
    call CreateQuestItemBJ( udg_Quests[38], "TRIGSTR_4834" )
    call DisableTrigger( GetTriggeringTrigger() )
    call EnableTrigger( gg_trg_U_CFD )
    call EnableTrigger( gg_trg_E_CFD )
    set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_Q_Gobbler)
    call CreateNUnitsAtLoc( 1, 'n02K', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
