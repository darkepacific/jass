function Trig_Netherspite_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'n05T' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Netherspite_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    set udg_Temp_Unit_Point = GetUnitLoc(GetDyingUnit())
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 13.00 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Karazhan_Boss_Spawn)
    call ReviveHeroLoc( gg_unit_E04J_2207, udg_Temp_Unit_Point, true )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = null
endfunction

//===========================================================================
