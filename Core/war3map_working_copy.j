//===========================================================================
// Trigger: Murder of Crows
//
// Generic exp timers eventually remove the unit
//===========================================================================
function Trig_Murder_of_Crows_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A04W' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Murder_of_Crows_Func006Func001C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A04W', GetSpellAbilityUnit()) == GetForLoopIndexA() ) ) then
        return false
    endif
    return true
endfunction

function Trig_Murder_of_Crows_Actions takes nothing returns nothing
    set udg_Temp_Unit_Point = GetSpellTargetLoc()
    call CreateNUnitsAtLoc( 1, 'e01N', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, bj_UNIT_FACING )
    call RemoveLocation (udg_Temp_Unit_Point)
    call UnitApplyTimedLifeBJ( 12.50, 'BTLF', GetLastCreatedUnit() )
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 8
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_Murder_of_Crows_Func006Func001C() ) then
            call SetUnitAbilityLevelSwapped( 'A056', GetLastCreatedUnit(), GetForLoopIndexA() )
            exitwhen true
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    call IssueImmediateOrderBJ( GetLastCreatedUnit(), "locustswarm" )
endfunction

//===========================================================================
function InitTrig_Murder_of_Crows takes nothing returns nothing
    set gg_trg_Murder_of_Crows = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Murder_of_Crows, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Murder_of_Crows, Condition( function Trig_Murder_of_Crows_Conditions ) )
    call TriggerAddAction( gg_trg_Murder_of_Crows, function Trig_Murder_of_Crows_Actions )
endfunction

//===========================================================================
// Trigger: Murder of Crows Scale
//
// Generic exp timers eventually remove the unit
//===========================================================================
function Trig_Murder_of_Crows_Scale_Func008C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetAttacker()) == 'u01K' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'u01L' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'u01M' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'u01N' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'u01O' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'u01P' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'u01Q' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'u01R' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Murder_of_Crows_Scale_Conditions takes nothing returns boolean
    if ( not Trig_Murder_of_Crows_Scale_Func008C() ) then
        return false
    endif
    return true
endfunction

function Trig_Murder_of_Crows_Scale_Actions takes nothing returns nothing
    local unit udg_Temp_Unit = udg_Heroes[ GetPlayerHeroNumber(GetOwningPlayer( GetAttacker() ) ) ]
    local integer udg_HeroStatCalc
    local real udg_RealStatCalc
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_HeroStatCalc = R2I(( udg_RealStatCalc * 1.00 ))
    call BlzSetUnitWeaponIntegerFieldBJ( GetAttacker(), UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 1, udg_HeroStatCalc )
    set udg_Temp_Unit = null
endfunction

