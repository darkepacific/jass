    call DialogSetMessageBJ( udg_AncesDialog, "TRIGSTR_6009" )
    set udg_AncesDialogButtonYes = DialogAddButton( udg_AncesDialog, "Y|cffffcc00es|r",  89)
    set udg_AncesDialogButtonNo = DialogAddButton( udg_AncesDialog, "|cffffffffN|r|cffffcc00o|r",  78)
