function Trig_Death_and_Decay_Actions takes nothing returns nothing
    local effect eff
    local location udg_Temp_Unit_Point
    local integer udg_HeroStatCalc = GetUnitAbilityLevel(GetTriggerUnit(), 'A03Y')
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_Temp_Unit_Point = GetSpellTargetLoc()
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\ExhumingAura.mdx" )
    set udg_RealStatCalc = ( ( 0.28 * I2R(udg_HeroStatCalc) ) + 1.00 )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), udg_RealStatCalc )
    set eff = GetLastCreatedEffectBJ()
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( udg_RealStatCalc * 0.05 )
    set udg_RealStatCalc = ( udg_RealStatCalc / 100.00 )
    set udg_RealStatCalc = ( ( 0.01 * I2R(udg_HeroStatCalc) ) + udg_RealStatCalc )
    call CreateNUnitsAtLoc( 1, 'e01N', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 12.50, 'BTLF', GetLastCreatedUnit() )
    call SetUnitAbilityLevelSwapped( 'A03V', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A03Y', GetTriggerUnit()) )
    set udg_Temp_Unit = GetLastCreatedUnit()
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A03V'), ABILITY_RLF_MAX_LIFE_DRAINED_PER_SECOND_PERCENT, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), udg_RealStatCalc )
    call IssuePointOrderLocBJ( GetLastCreatedUnit(), "deathanddecay", udg_Temp_Unit_Point )
    set udg_Temp_Unit = GetTriggerUnit()
    call TriggerExecute( gg_trg_Firelords_Helper)
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(( 170.00 + ( 40.00 * I2R(udg_HeroStatCalc) ) ), udg_Temp_Unit_Point), function Trig_Death_and_Decay_Func023A )
    call TriggerSleepAction( 1.50 )
    set udg_Temp_Unit = GetTriggerUnit()
    call TriggerExecute( gg_trg_Firelords_Helper)
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(( 170.00 + ( 40.00 * I2R(udg_HeroStatCalc) ) ), udg_Temp_Unit_Point), function Trig_Death_and_Decay_Func028A )
    call TriggerSleepAction( 1.50 )
    set udg_Temp_Unit = GetTriggerUnit()
    call TriggerExecute( gg_trg_Firelords_Helper)
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(( 170.00 + ( 40.00 * I2R(udg_HeroStatCalc) ) ), udg_Temp_Unit_Point), function Trig_Death_and_Decay_Func033A )
    call TriggerSleepAction( 1.50 )
    set udg_Temp_Unit = GetTriggerUnit()
    call TriggerExecute( gg_trg_Firelords_Helper)
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(( 170.00 + ( 40.00 * I2R(udg_HeroStatCalc) ) ), udg_Temp_Unit_Point), function Trig_Death_and_Decay_Func038A )
    call TriggerSleepAction( 1.50 )
    set udg_Temp_Unit = GetTriggerUnit()
    call TriggerExecute( gg_trg_Firelords_Helper)
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(( 170.00 + ( 40.00 * I2R(udg_HeroStatCalc) ) ), udg_Temp_Unit_Point), function Trig_Death_and_Decay_Func043A )
    call TriggerSleepAction( 1.00 )
    call DestroyEffectBJ( eff )
    set eff = null
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = null
endfunction

