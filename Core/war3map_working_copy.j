    call TriggerAddCondition( gg_trg_Soul_Drain_Stop, Condition( function Trig_Soul_Drain_Stop_Conditions ) )
    call TriggerAddAction( gg_trg_Soul_Drain_Stop, function Trig_Soul_Drain_Stop_Actions )
