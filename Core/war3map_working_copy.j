        call DisableTrigger( GetTriggeringTrigger() )
    else
        set udg_SpellTicks[17] = ( udg_SpellTicks[17] + 1 )
    endif
endfunction

//===========================================================================
function InitTrig_Lights_Hammer_Tick_Blood_Elf takes nothing returns nothing
    set gg_trg_Lights_Hammer_Tick_Blood_Elf = CreateTrigger(  )
    call DisableTrigger( gg_trg_Lights_Hammer_Tick_Blood_Elf )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Lights_Hammer_Tick_Blood_Elf, 1.00 )
    call TriggerAddAction( gg_trg_Lights_Hammer_Tick_Blood_Elf, function Trig_Lights_Hammer_Tick_Blood_Elf_Actions )
endfunction

//===========================================================================
// Trigger: Holy Prism
//
// Make Judgement slow via dummy, then effect can be stored using a local
//===========================================================================
function Trig_Holy_Prism_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0EL' ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Holy_Prism_Func029C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(udg_Temp_Unit, 'B01F') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Holy_Prism_Func074A takes nothing returns nothing
    if udg_Temp_Int2 < 5 then
    if IsUnitTargetableAlly( GetEnumUnit(), udg_Temp_Unit ) then
    call SetUnitLifeBJ( GetEnumUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetEnumUnit()) + ( udg_RealStatCalc / 2.00 ) ) )
    call IssueTargetOrderBJ( udg_SpellUnits[udg_Temp_Int], "acidbomb", GetEnumUnit() )
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "Abilities\\Spells\\Other\\HealingSpray\\HealBottleMissile.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set udg_Temp_Int2 = ( udg_Temp_Int2 + 1 )
    endif
    endif
    if udg_Temp_Int2 > 999 and udg_Temp_Int2 < 1005 then
    if IsUnitTargetableEnemy( GetEnumUnit(), udg_Temp_Unit ) then
    call IssueTargetOrderBJ( udg_SpellUnits[udg_Temp_Int], "acidbomb", GetEnumUnit() )
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), ( udg_RealStatCalc / 2.00 ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "Abilities\\Spells\\Human\\StormBolt\\StormBoltMissile.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set udg_Temp_Int2 = ( udg_Temp_Int2 + 1 )
    endif
    endif
endfunction

function Trig_Holy_Prism_Actions takes nothing returns nothing
    local integer udg_o
    local real dist = 0.25
    local boolean isEnemy = false
    call StopSoundBJ( gg_snd_FX_HolyPrism_Impact_05, false )
    call PlaySoundOnUnitBJ( gg_snd_FX_HolyPrism_Impact_05, 85.00, GetSpellAbilityUnit() )
    set udg_Temp_Unit = GetTriggerUnit()
    if udg_Temp_Unit == udg_yA_Holy_Pally then
    set udg_o = udg_z_PA_HOLY_A
    elseif udg_Temp_Unit == udg_yH_Holy_Pally then
    set udg_o = udg_z_PA_HOLY_H
    endif
    set udg_SpellUnits[udg_o + 5] = udg_SpellUnits[udg_o + 4] 
    set udg_SpellUnits[udg_o + 4] = GetSpellTargetUnit()
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    set udg_Temp_Polar_Point = GetUnitLoc(GetSpellTargetUnit())
    set dist = 0.08 + DistanceBetweenPoints(udg_Temp_Unit_Point, udg_Temp_Polar_Point)/2400
    call RemoveLocation(udg_Temp_Unit_Point)
    call RemoveLocation(udg_Temp_Polar_Point)
    call TriggerSleepAction(dist)
    // Set Real Value
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 4.00 * udg_RealStatCalc )
    set udg_HeroStatCalc = 400
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    call ChaliceSet()
    if ( Trig_Holy_Prism_Func029C() ) then
        set udg_Temp_Real = ( ( 0.10 * I2R(( GetUnitAbilityLevelSwapped('A0AQ', udg_Temp_Unit) + 1 )) ) + 1.00 )
        set udg_RealStatCalc = ( udg_Temp_Real * udg_RealStatCalc )
    else
    endif
    set udg_Temp_Unit_Point = GetUnitLoc(udg_SpellUnits[( udg_o + 4 )])
    // Check if Enemy or Ally
    // if Enemy
    if IsUnitEnemy( udg_SpellUnits[udg_o + 4], GetOwningPlayer( udg_Temp_Unit)) then
        set isEnemy = true
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Spells\\Human\\StormBolt\\StormBoltMissile.mdl" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 2.00 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 3 ]  then
    if udg_SpellUnits[udg_o + 5] == udg_SpellUnits[udg_o + 4] then
    call AddSpecialEffectTargetUnitBJ( "origin", udg_SpellUnits[( udg_o + 5 )], "Abilities\\Weapons\\DragonHawkMissile\\DragonHawkMissile.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set udg_Temp_Unit_Point = GetUnitLoc(udg_SpellUnits[( udg_o + 4 )])
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Weapons\\DragonHawkMissile\\DragonHawkMissile.mdl" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 2.00 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set udg_RealStatCalc = ( 1.25 * udg_RealStatCalc )
    endif
    endif
    call UnitDamageTargetBJ( udg_Temp_Unit, udg_SpellUnits[( udg_o + 4 )], udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    // if Ally
    else
    set udg_Temp_Unit = udg_SpellUnits[udg_o + 4]
    call SetUnitLifeBJ( udg_Temp_Unit, ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_Temp_Unit) + udg_RealStatCalc ) )
    call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "Abilities\\Spells\\Other\\HealingSpray\\HealBottleMissile.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    endif
    // Dummy
    set udg_Temp_Int = ( udg_o + 6 )
    call CreateNUnitsAtLoc( 1, 'e01A', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, bj_UNIT_FACING )
    set udg_SpellUnits[udg_o + 6] = GetLastCreatedUnit()
    call UnitApplyTimedLifeBJ( 0.60, 'BTLF', GetLastCreatedUnit() )
    if isEnemy then
    call UnitAddAbilityBJ( 'A0EL', GetLastCreatedUnit() )
    call BlzSetUnitAbilityManaCost( GetLastCreatedUnit() , 'A0EL' , 0, 0)
    call BlzSetUnitAbilityCooldown( GetLastCreatedUnit() , 'A0EL' , 0, 0)
    set udg_Temp_Int2 = 0
    else
    call UnitAddAbilityBJ( 'A0EM', GetLastCreatedUnit() )
    call BlzSetUnitAbilityManaCost( GetLastCreatedUnit() , 'A0EM' , 0, 0)
    call BlzSetUnitAbilityCooldown( GetLastCreatedUnit() , 'A0EM' , 0, 0)
    set udg_Temp_Int2 = 1000
    endif
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(500.00, udg_Temp_Unit_Point), function Trig_Holy_Prism_Func074A )
    call RemoveLocation (udg_Temp_Unit_Point)
    return
    call IssueTargetOrderBJ( udg_SpellUnits[udg_Temp_Int], "acidbomb", GetEnumUnit() )
    call IssueTargetOrderBJ( udg_SpellUnits[udg_Temp_Int], "acidbomb", GetTriggerUnit() )
endfunction

//===========================================================================
function InitTrig_Holy_Prism takes nothing returns nothing
    set gg_trg_Holy_Prism = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Holy_Prism, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Holy_Prism, Condition( function Trig_Holy_Prism_Conditions ) )
    call TriggerAddAction( gg_trg_Holy_Prism, function Trig_Holy_Prism_Actions )
endfunction

//===========================================================================
// Trigger: Wake of Ashes
//===========================================================================
function Trig_Wake_of_Ashes_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0EN' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Wake_of_Ashes_Func028A takes nothing returns nothing
    if IsUnitTargetableEnemyStab( GetEnumUnit(), udg_Temp_Unit ) then
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL )
    call AddSpecialEffectTargetUnitBJ( "overhead", GetEnumUnit(), "war3mapImported\\Ephemeral Cut Red.mdx" )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00) )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "overhead", GetEnumUnit(), "war3mapImported\\Ephemeral Cut Orange.mdx" )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00) )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    if not udg_Temp_Bool then
    call IssueTargetOrderBJ( gg_unit_e028_1863, "slow", GetEnumUnit() )
    endif
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_Wake_of_Ashes_Func037A takes nothing returns nothing
    if IsUnitTargetableEnemy( GetEnumUnit(), udg_Temp_Unit ) then
    set udg_RealStatCalc =I2R(BlzGetUnitMaxHP(GetEnumUnit())) * ( 1.00 + I2R(GetUnitAbilityLevel(udg_Temp_Unit, 'A0EN')) + ( I2R(udg_HeroStatCalc) / 20.00 ) ) 
    set udg_RealStatCalc = ( udg_RealStatCalc / 100.00 )
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "Abilities\\Spells\\Human\\FlameStrike\\FlameStrikeEmbers.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set udg_Temp_Int = 1
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_Wake_of_Ashes_Func038C takes nothing returns boolean
    if ( not ( udg_Temp_Int > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Wake_of_Ashes_Func045A takes nothing returns nothing
    if IsUnitTargetableEnemy( GetEnumUnit(), udg_Temp_Unit ) then
    set udg_RealStatCalc =I2R(BlzGetUnitMaxHP(GetEnumUnit())) * ( 1.00 + I2R(GetUnitAbilityLevel(udg_Temp_Unit, 'A0EN')) + ( I2R(udg_HeroStatCalc) / 20.00 ) ) 
    set udg_RealStatCalc = ( udg_RealStatCalc / 100.00 )
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "Abilities\\Spells\\Human\\FlameStrike\\FlameStrikeEmbers.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set udg_Temp_Int = 1
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_Wake_of_Ashes_Func046C takes nothing returns boolean
    if ( not ( udg_Temp_Int > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Wake_of_Ashes_Func053A takes nothing returns nothing
    if IsUnitTargetableEnemy( GetEnumUnit(), udg_Temp_Unit ) then
    set udg_RealStatCalc =I2R(BlzGetUnitMaxHP(GetEnumUnit())) * ( 1.00 + I2R(GetUnitAbilityLevel(udg_Temp_Unit, 'A0EN')) + ( I2R(udg_HeroStatCalc) / 20.00 ) ) 
    set udg_RealStatCalc = ( udg_RealStatCalc / 100.00 )
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "Abilities\\Spells\\Human\\FlameStrike\\FlameStrikeEmbers.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set udg_Temp_Int = 1
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_Wake_of_Ashes_Func054C takes nothing returns boolean
    if ( not ( udg_Temp_Int > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Wake_of_Ashes_Actions takes nothing returns nothing
    local group wake
    set udg_Temp_Unit = GetTriggerUnit()
    call AddSpecialEffectTargetUnitBJ( "chest", GetTriggerUnit(), "war3mapImported\\Ephemeral Slash Orange.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Ephemeral Slash Yellow.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 100.00, GetUnitFacing(GetTriggerUnit()))
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
    // Damage Calculation
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, true) - 0 ))
    set udg_RealStatCalc = ( 5.00 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A0DN', udg_Temp_Unit) * 150 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 150 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    // Crit Bonus
    call TriggerExecute( gg_trg_Crit_Check)
    // AoE
    call SetUnitAbilityLevelSwapped( 'A03P', gg_unit_e028_1863, 2 )
    call SetUnitOwner( gg_unit_e028_1863, GetOwningPlayer(udg_Heroes[udg_Player_Number]), true )
    call AddSpecialEffectLocBJ( udg_Temp_Polar_Point, "war3mapImported\\RunningFlameAura.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set wake = GetUnitsInRangeOfLocAll(180.00, udg_Temp_Polar_Point)
    set udg_Temp_Group = wake
    call ForGroupBJ( udg_Temp_Group, function Trig_Wake_of_Ashes_Func028A )
    call SetUnitAbilityLevelSwapped( 'A03P', gg_unit_e028_1863, 1 )
    call RemoveLocation (udg_Temp_Polar_Point)
    call TriggerSleepAction( 0.95 )
    // Burn
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_HeroStatCalc = ( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) )
    set udg_Temp_Int = 0
    set udg_Temp_Group = wake
    call ForGroupBJ( udg_Temp_Group, function Trig_Wake_of_Ashes_Func037A )
    if ( Trig_Wake_of_Ashes_Func038C() ) then
        call StopSoundBJ( gg_snd_FireBallMissileDeath, false )
        call PlaySoundOnUnitBJ( gg_snd_FireBallMissileDeath, 55.00, udg_Temp_Unit )
    else
    endif
    call TriggerSleepAction( 0.95 )
    // Burn
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_HeroStatCalc = ( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) )
    set udg_Temp_Int = 0
    set udg_Temp_Group = wake
    call ForGroupBJ( udg_Temp_Group, function Trig_Wake_of_Ashes_Func045A )
    if ( Trig_Wake_of_Ashes_Func046C() ) then
        call StopSoundBJ( gg_snd_FireBallMissileDeath01, false )
        call PlaySoundOnUnitBJ( gg_snd_FireBallMissileDeath01, 55.00, udg_Temp_Unit )
    else
    endif
    call TriggerSleepAction( 0.95 )
    // Burn
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_HeroStatCalc = ( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) )
    set udg_Temp_Int = 0
    set udg_Temp_Group = wake
    call ForGroupBJ( udg_Temp_Group, function Trig_Wake_of_Ashes_Func053A )
    if ( Trig_Wake_of_Ashes_Func054C() ) then
        call StopSoundBJ( gg_snd_FireBallMissileDeath02, false )
        call PlaySoundOnUnitBJ( gg_snd_FireBallMissileDeath02, 55.00, udg_Temp_Unit )
    else
    endif
    call DestroyGroup ( wake)
endfunction

//===========================================================================
function InitTrig_Wake_of_Ashes takes nothing returns nothing
    set gg_trg_Wake_of_Ashes = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Wake_of_Ashes, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Wake_of_Ashes, Condition( function Trig_Wake_of_Ashes_Conditions ) )
    call TriggerAddAction( gg_trg_Wake_of_Ashes, function Trig_Wake_of_Ashes_Actions )
endfunction

//===========================================================================
// Trigger: Blade of Justice
//
// Calc distance in tics
//  gg_unit_e00H_2048
// Because this is has an AoE stun we must set temp unit2, else may cause bugs when stun hits channeling heroes
//===========================================================================
function Trig_Blade_of_Justice_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0DA' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Blade_of_Justice_Func008C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(udg_Temp_Unit, 'B01F') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Blade_of_Justice_Func027A takes nothing returns nothing
    if IsUnitTargetableEnemyGround( GetEnumUnit(), udg_Temp_Unit2 ) then
    set udg_HeroStatCalc = 1
    call IssueTargetOrderBJ( gg_unit_e00H_2048, "thunderbolt", GetEnumUnit() )
    call UnitDamageTargetBJ( udg_Temp_Unit2, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "Abilities\\Spells\\Human\\SunderingBlades\\SunderingBlades.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "Abilities\\Weapons\\SearingArrow\\SearingArrowMissile.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "Abilities\\Spells\\Human\\Feedback\\SpellBreakerAttack.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_Blade_of_Justice_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_Temp_Unit2 = udg_Temp_Unit
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 4.50 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A0DA', udg_Temp_Unit) * 60 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 25 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    if ( Trig_Blade_of_Justice_Func008C() ) then
        set udg_Temp_Real = ( ( 0.10 * I2R(( GetUnitAbilityLevelSwapped('A0AQ', udg_Temp_Unit) + 1 )) ) + 1.00 )
        set udg_RealStatCalc = ( udg_Temp_Real * udg_RealStatCalc )
    else
    endif
    call TriggerExecute( gg_trg_Firelords_Helper)
    set udg_Temp_Unit_Point = GetSpellTargetLoc()
    // Execute the Effect
    call TriggerExecute( gg_trg_BoJ_Effect)
    // Move the Dummy
    call SetUnitOwner( gg_unit_e00H_2048, GetOwningPlayer(udg_Temp_Unit), true )
    call SetUnitPositionLocFacingBJ(  gg_unit_e00H_2048, udg_Temp_Unit_Point, GetUnitFacing(udg_Temp_Unit) )
    // Talent
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 4 ]  then
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility( gg_unit_e00H_2048, 'A06H'), ABILITY_RLF_DURATION_HERO, ( 0 ), 1.0 )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility( gg_unit_e00H_2048, 'A06H'), ABILITY_RLF_DURATION_NORMAL, ( 0 ), 1.0 )
    else
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility( gg_unit_e00H_2048, 'A06H'), ABILITY_RLF_DURATION_HERO, ( 0 ), 0.2 )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility( gg_unit_e00H_2048, 'A06H'), ABILITY_RLF_DURATION_NORMAL, ( 0 ), 0.2 )
    endif
    // AoE
    set udg_HeroStatCalc = 0
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(144.00, udg_Temp_Unit_Point), function Trig_Blade_of_Justice_Func027A )
    if (udg_HeroStatCalc > 0) then
    call PlaySoundAtPointBJ( gg_snd_BoJ1, 74.00, udg_Temp_Unit_Point, 0 )
    endif
    call RemoveLocation (udg_Temp_Unit_Point)
    // Reset Dummy's Stats
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility( gg_unit_e00H_2048, 'A06H'), ABILITY_RLF_DURATION_HERO, ( 0 ), 0.2 )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility( gg_unit_e00H_2048, 'A06H'), ABILITY_RLF_DURATION_NORMAL, ( 0 ), 0.2 )
endfunction

//===========================================================================
function InitTrig_Blade_of_Justice takes nothing returns nothing
    set gg_trg_Blade_of_Justice = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Blade_of_Justice, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Blade_of_Justice, Condition( function Trig_Blade_of_Justice_Conditions ) )
    call TriggerAddAction( gg_trg_Blade_of_Justice, function Trig_Blade_of_Justice_Actions )
endfunction

//===========================================================================
// Trigger: BoJ Effect
//===========================================================================
function Trig_BoJ_Effect_Func004C takes nothing returns boolean
    if ( not ( GetUnitTypeId(udg_Temp_Unit) == 'H00K' ) ) then
        return false
    endif
    return true
endfunction

function Trig_BoJ_Effect_Actions takes nothing returns nothing
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "BladeOfJustice.mdx" )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), Deg2Rad(GetUnitFacing(GetTriggerUnit())), Deg2Rad(270.00), Deg2Rad(90.00) )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 2.25 )
    if ( Trig_BoJ_Effect_Func004C() ) then
        set udg_Temp_Int = 2
        set udg_SunderingAndBoJ[udg_Temp_Int] = GetLastCreatedEffectBJ()
        set udg_SpellTicks[25] = 100
    else
        set udg_Temp_Int = 3
        set udg_SunderingAndBoJ[udg_Temp_Int] = GetLastCreatedEffectBJ()
        set udg_SpellTicks[26] = 100
    endif
    call BlzSetSpecialEffectZ( udg_SunderingAndBoJ[udg_Temp_Int], ( BlzGetLocalSpecialEffectZ(udg_SunderingAndBoJ[udg_Temp_Int]) - 50.00 ) )
    call EnableTrigger(gg_trg_BoJ_Fade)
endfunction

//===========================================================================
