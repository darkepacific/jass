function Trig_E_SNS_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 126
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    call FlashQuestDialogButtonBJ(  )
    endif
    call QuestItemSetCompletedBJ( udg_QuestReqs[126], true )
    call QuestSetCompletedBJ( udg_Quests[126], true )
    call DestroyMinimapIcon( udg_MiniMapIcon[126] )
    // Clean Up Items
    set udg_ItemTypeCheck = 'I095'
    call CleanUpItems( udg_ItemTypeCheck )
    // Rewards
    set udg_XP = udg_QUEST_XP[udg_Temp_Int]
    set udg_Gold = udg_QUEST_GOLD[udg_Temp_Int]
    set udg_LVL_Req = udg_QUEST_LVL_REQ[udg_Temp_Int]
    set udg_TempString = "Sentinel Spies"
    call TriggerExecute( gg_trg_Quest_Complete_H )
    call DisableTrigger( gg_trg_L_SNS)
    call DisableTrigger( gg_trg_H_SNS)
    call DisableTrigger( gg_trg_U_SNS)
    call DisableTrigger( GetTriggeringTrigger() )
endfunction

