//===========================================================================
// Trigger: Cloak of Shadows Timer
//===========================================================================
function Trig_Cloak_of_Shadows_Timer_Actions takes nothing returns nothing
    if udg_Debug then
    call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_9936" )
    endif
    set bj_forLoopBIndex = 40
    set bj_forLoopBIndexEnd = 47
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        if GetExpiredTimer() == udg_CheatDeath[ bj_forLoopBIndex ] then
        if (bj_forLoopBIndex < 44) then
        set udg_Temp_Unit = udg_yH_Subtle_Rogue
        set udg_CloakofShadowsH = false
        else
        set udg_Temp_Unit = udg_yA_Subtle_Rogue
        set udg_CloakofShadowsA = false
        endif
        call RemoveAndUnHideSpell(udg_Temp_Unit, 'ACm2')
        call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "war3mapImported\\Singularity I Purple.mdx" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call SetUnitVertexColorBJ( udg_Temp_Unit, 100, 100, 100, 0 )
        exitwhen true
        endif
        set bj_forLoopBIndex = bj_forLoopBIndex + 1
    endloop
endfunction

//===========================================================================
function InitTrig_Cloak_of_Shadows_Timer takes nothing returns nothing
    set gg_trg_Cloak_of_Shadows_Timer = CreateTrigger(  )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_Cloak_of_Shadows_Timer, udg_CheatDeath[40] )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_Cloak_of_Shadows_Timer, udg_CheatDeath[41] )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_Cloak_of_Shadows_Timer, udg_CheatDeath[42] )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_Cloak_of_Shadows_Timer, udg_CheatDeath[43] )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_Cloak_of_Shadows_Timer, udg_CheatDeath[44] )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_Cloak_of_Shadows_Timer, udg_CheatDeath[45] )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_Cloak_of_Shadows_Timer, udg_CheatDeath[46] )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_Cloak_of_Shadows_Timer, udg_CheatDeath[47] )
    call TriggerAddAction( gg_trg_Cloak_of_Shadows_Timer, function Trig_Cloak_of_Shadows_Timer_Actions )
endfunction

//===========================================================================
// Trigger: Cloak of Shadows
//
// TimerGetRemaining(udg_CheatDeath[heroNumb + 8])
//===========================================================================
function Trig_Cloak_of_Shadows_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0EX' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cloak_of_Shadows_Actions takes nothing returns nothing
    // local unit udg_Temp_Unit
    set udg_Temp_Unit = GetTriggerUnit()
    if udg_Temp_Unit == udg_yH_Subtle_Rogue then
    set udg_CloakofShadowsH = true
    else
    set udg_CloakofShadowsA = true
    endif
    call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "war3mapImported\\Singularity I Purple.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call SetUnitVertexColorBJ( GetTriggerUnit(), 80.00, 25.00, 100.00, 0 )
    call UnitRemoveBuffsBJ( bj_REMOVEBUFFS_NEGATIVE, GetTriggerUnit() )
    call AddAndHideSpell(udg_Temp_Unit, 'ACm2')
    call PlayerNumbtoHeroesNumb()
    call StartTimerBJ( udg_CheatDeath[( 40 + udg_Player_Number )], false, 3.20 )
endfunction

