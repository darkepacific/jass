//===========================================================================
// Trigger: SU SST A
//
// Need to change this to team wide display.
//===========================================================================
function Trig_SU_SST_A_Func005C takes nothing returns boolean
    if ( ( GetOwningPlayer(GetKillingUnitBJ()) == Player(1) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetKillingUnitBJ()) == Player(11) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetKillingUnitBJ()) == Player(2) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetKillingUnitBJ()) == Player(7) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetKillingUnitBJ()) == Player(8) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetKillingUnitBJ()) == Player(9) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetKillingUnitBJ()) == Player(13) ) ) then
        return true
    endif
    return false
endfunction

function Trig_SU_SST_A_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetTriggerUnit()) == Player(PLAYER_NEUTRAL_AGGRESSIVE) ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'n06M' ) ) then
        return false
    endif
    if ( not Trig_SU_SST_A_Func005C() ) then
        return false
    endif
    return true
endfunction

function Trig_SU_SST_A_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    local integer udg_Temp_Int = 176
    if IsTriggerEnabled(gg_trg_E_SST_A) == false then
    set udg_TempString = "Spectral Sea Turtles"
    set udg_TempString_Quest = "Kill 7 Spectral Sea Turtles"
    call TriggerExecute( gg_trg_Quest_Start_A )
    if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
    call QuestSetEnabledBJ( true, udg_Quests[udg_Temp_Int] )
    call FlashQuestDialogButtonBJ(  )
    endif
    call QuestSetCompletedBJ( udg_Quests[udg_Temp_Int], false )
    call CreateQuestItemBJ( udg_Quests[udg_Temp_Int], "TRIGSTR_11995" )
    set udg_QuestReqs[udg_Temp_Int] = GetLastCreatedQuestItemBJ()
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Spectral_Sea_Turtles_NS)
    call CampaignMinimapIconLocBJ( udg_Temp_Unit_Point, bj_CAMPPINGSTYLE_CONTROL_NEUTRAL )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_MiniMapIcon[udg_Temp_Int] = GetLastCreatedMinimapIcon()
    call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), false )
    if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
    call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), true )
    endif
    call EnableTrigger( gg_trg_E_SST_A)
    else
    // FT Gen
    set udg_QuestSST_A = udg_QuestSST_A + 1.00
    call QuestItemSetDescriptionBJ( udg_QuestReqs[udg_Temp_Int], ( "Spectral Sea Turtles slain - " + ( I2S(R2I(udg_QuestSST_A)) + "/7" ) ) )
    set udg_TempString = "Spectral Sea Turtle"
    call QuestUnitSlain( GetTriggerUnit())
    endif
    set udg_Temp_Unit_Point = null
endfunction

