//===========================================================================
// Trigger: E Amani
//
// Change to Fel's Essence
//===========================================================================
function Trig_E_Amani_Func005Func001C takes nothing returns boolean
    if ( not ( GetItemTypeId(udg_P_Items[( udg_Bag_Num + udg_Bag_Iterator )]) == udg_ItemTypeCheck ) ) then
        return false
    endif
    return true
endfunction

function Trig_E_Amani_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 45
                       if IsHordeHero( GetTriggerUnit() ) then
    call SetBagNumber( GetOwningPlayer(GetTriggerUnit()) )
    set udg_ItemTypeCheck = 'I068'
    set udg_Bag_Iterator = 1
    loop
        exitwhen udg_Bag_Iterator > udg_BAG_LOOP_MAX
        if ( Trig_E_Amani_Func005Func001C() ) then
            if ( GetLocalPlayer() == Player(4) or GetLocalPlayer() == Player(5) or GetLocalPlayer() == Player(6) or GetLocalPlayer() == Player(10) )then
            call FlashQuestDialogButtonBJ(  )
            endif
            call QuestSetCompletedBJ( udg_Quests[45], true )
            call DestroyEffectBJ( udg_QuestMarks[45] )
            call DestroyMinimapIcon( udg_MiniMapIcon[45] )
            // Clean Up Items
            call CleanUpItems( udg_ItemTypeCheck )
            // Rewards
            set udg_XP = udg_QUEST_XP[udg_Temp_Int]
            set udg_Gold = udg_QUEST_GOLD[udg_Temp_Int]
            set udg_LVL_Req = udg_QUEST_LVL_REQ[udg_Temp_Int]
            set udg_TempString = "Amani Encroachment"
            call TriggerExecute( gg_trg_Quest_Complete_H )
            call DisableTrigger( gg_trg_U_Amani_Acquire )
            call DisableTrigger( GetTriggeringTrigger() )
            return
        else
        endif
        set udg_Bag_Iterator = udg_Bag_Iterator + 1
    endloop
                       endif
endfunction

