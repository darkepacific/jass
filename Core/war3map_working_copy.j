//===========================================================================
// Trigger: Thrash
//
// //Facing angles 3 & 4 used on fury warr
//===========================================================================
function Trig_Thrash_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetTriggerUnit()) != Player(PLAYER_NEUTRAL_AGGRESSIVE) ) ) then
        return false
    endif
    if ( not ( GetSpellAbilityId() == 'A03T' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Thrash_Func009C takes nothing returns boolean
    if ( not ( udg_isDruid_NightElf == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Thrash_Func011C takes nothing returns boolean
    if ( not ( udg_isDruid_Tauren == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Thrash_Func035A takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    // hits air, ground, magic imm,     but not mech
    if IsUnitTargetableEnemyParams( GetEnumUnit(), udg_Temp_Unit, true, true, true, false) then
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL )
    // Increased x Bonus
    if udg_Temp_Bool then
    call AddSpecialEffectTargetUnitBJ( "overhead", GetEnumUnit(), "war3mapImported\\Ephemeral Cut Red.mdx" )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00) )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "overhead", GetEnumUnit(), "war3mapImported\\Ephemeral Cut Orange.mdx" )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00) )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    endif
    // Bleed
    if udg_Temp_Bool2 then
    call IssueTargetOrderBJ( gg_unit_e00H_2048, "acidbomb", GetEnumUnit() )
    endif
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_Thrash_Actions takes nothing returns nothing
    call TriggerSleepAction( 0.26 )
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
    call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
    if udg_Temp_Unit == udg_yA_Feral_Druid then
    if ( Trig_Thrash_Func009C() ) then
        set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, false) ))
    else
        set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, false) ))
    endif
    elseif udg_Temp_Unit == udg_yH_Feral_Druid then
    if ( Trig_Thrash_Func011C() ) then
        set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, false) ))
    else
        set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, false) ))
    endif
    endif
    // Dmg Calc
    set udg_Temp_Bool = udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 10 ]
    if udg_Temp_Bool then
    set udg_RealStatCalc = ( 6.50 * udg_RealStatCalc )
    else
    set udg_RealStatCalc = ( 2.00 * udg_RealStatCalc )
    endif
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A03T', udg_Temp_Unit) * 75 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 5 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    // Bleed Talent
    set udg_Temp_Bool2 = udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 13 ]
    // Move the Unit
    if udg_Temp_Bool2 then
    set udg_Temp_Unit2 = gg_unit_e00H_2048
    call SetUnitOwner( udg_Temp_Unit2, GetOwningPlayer(GetTriggerUnit()), true )
    call SetUnitPositionLocFacingBJ( udg_Temp_Unit2, udg_Temp_Unit_Point, GetUnitFacing( udg_Temp_Unit) )
    call SetUnitAbilityLevelSwapped( 'A03H', udg_Temp_Unit2, 3 )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit2, 'A03H'), ABILITY_RLF_PRIMARY_DAMAGE, 2, ( 0.11 * udg_RealStatCalc ) )
    endif
    // AoE
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(310.00, udg_Temp_Unit_Point), function Trig_Thrash_Func035A )
    call RemoveLocation (udg_Temp_Unit_Point)
    call UnitRemoveBuffsBJ( bj_REMOVEBUFFS_NEGATIVE, GetTriggerUnit() )
    //// NE
    set udg_Temp_Unit = GetTriggerUnit()
    if udg_Temp_Unit == udg_yA_Feral_Druid then
    set udg_Charge_Loop[9] = 1.00
    set udg_DruidFacingAngle[0] = GetUnitFacing(GetTriggerUnit())
    call UnitAddAbility( udg_Temp_Unit, 'Amrf' )
    call UnitRemoveAbility( udg_Temp_Unit, 'Amrf' )
    call EnableTrigger( gg_trg_Thrash_Effect_NE )
    //// TA
    elseif udg_Temp_Unit == udg_yH_Feral_Druid then
    set udg_Charge_Loop[12] = 1.00
    set udg_DruidFacingAngle[1] = GetUnitFacing(GetTriggerUnit())
    call UnitAddAbility( udg_Temp_Unit, 'Amrf' )
    call UnitRemoveAbility( udg_Temp_Unit, 'Amrf' )
    call EnableTrigger( gg_trg_Thrash_Effect_TA )
    endif
endfunction

//===========================================================================
function InitTrig_Thrash takes nothing returns nothing
    set gg_trg_Thrash = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Thrash, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Thrash, Condition( function Trig_Thrash_Conditions ) )
    call TriggerAddAction( gg_trg_Thrash, function Trig_Thrash_Actions )
endfunction

//===========================================================================
// Trigger: Thrash Effect NE
//===========================================================================
function Trig_Thrash_Effect_NE_Actions takes nothing returns nothing
    set udg_Temp_Unit = udg_yA_Feral_Druid
    if ( udg_Charge_Loop[9] < 15.00  ) then
        set udg_Charge_Loop[9] = ( udg_Charge_Loop[9] + 1 )
        call SetUnitFlyHeightBJ( udg_Temp_Unit, ( 150.00 * SinBJ(AcosBJ(( 1 - ( udg_Charge_Loop[9] / 8.00 ) ))) ), 0.00 )
        call BlzSetUnitFacingEx( udg_Temp_Unit, ( udg_DruidFacingAngle[0] + ( 24.00 * udg_Charge_Loop[9] ) ) )
    else
        call BlzSetUnitFacingEx( udg_Temp_Unit, udg_DruidFacingAngle[0] )
        call SetUnitFlyHeightBJ( udg_Temp_Unit, 0.00, 0.00 )
        //call UnitRemoveTypeBJ( UNIT_TYPE_MAGIC_IMMUNE, udg_Temp_Unit )
        call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "Abilities\\Spells\\Other\\Stampede\\StampedeMissile.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call DisableTrigger( GetTriggeringTrigger() )
    endif
endfunction

//===========================================================================
function InitTrig_Thrash_Effect_NE takes nothing returns nothing
    set gg_trg_Thrash_Effect_NE = CreateTrigger(  )
    call DisableTrigger( gg_trg_Thrash_Effect_NE )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Thrash_Effect_NE, 0.02 )
    call TriggerAddAction( gg_trg_Thrash_Effect_NE, function Trig_Thrash_Effect_NE_Actions )
