function Trig_Operating_Table_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    call DestructableRestoreLife( udg_AbomTableGilneas, 50.00, true )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Gilneas_Op_Table)
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl" )
    call PlaySoundAtPointBJ( gg_snd_LightningBolt1, 100.00, udg_Temp_Unit_Point, 0 )
    call RemoveLocation (udg_Temp_Unit_Point)
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call SetUnitFacingTimed( udg_ApothecaryGilneas, 360.00, 0.55 )
    call DisableTrigger( GetTriggeringTrigger() )
    call TriggerSleepAction( 20.00 )
    if ( Trig_Operating_Table_Func012C() ) then
        call EnableTrigger( GetTriggeringTrigger() )
    else
    endif
    set udg_Temp_Unit_Point = null
