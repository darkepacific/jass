function Trig_Skovald_BloodRush_Conditions takes nothing returns boolean
    if ( not ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) < 8000.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Skovald_BloodRush_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point = GetUnitLoc( gg_unit_H03R_2211 )
    local location udg_Temp_Polar_Point = GetUnitLoc(GetEventDamageSource())
    local real udg_Facing_Angle
    if  RectContainsUnit( gg_rct_Hrydshal,  GetEventDamageSource() )  or RectContainsUnit( gg_rct_Stormheim_South,  GetEventDamageSource() ) or RectContainsUnit( gg_rct_Stormheim_North,  GetEventDamageSource() )then
    if DistanceBetweenPoints(udg_Temp_Unit_Point, udg_Temp_Polar_Point) < 620 then
    set udg_Facing_Angle = AngleBetweenPoints(udg_Temp_Unit_Point, udg_Temp_Polar_Point)
    call RemoveLocation (udg_Temp_Polar_Point)
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 470.00, udg_Facing_Angle)
    endif
    call UnitResetCooldown( GetTriggerUnit() )
    call UnitRemoveBuffsBJ( bj_REMOVEBUFFS_NEGATIVE, GetTriggerUnit() )
    call IssuePointOrderLocBJ( gg_unit_H03R_2211, "carrionswarm", udg_Temp_Polar_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call RemoveLocation (udg_Temp_Polar_Point)
    call DisableTrigger( GetTriggeringTrigger() )
    call TriggerSleepAction( 9.00 )
    call EnableTrigger( GetTriggeringTrigger() )
    endif
    set udg_Temp_Unit_Point = null
    set udg_Temp_Polar_Point = null
endfunction

//===========================================================================
function InitTrig_Skovald_BloodRush takes nothing returns nothing
    set gg_trg_Skovald_BloodRush = CreateTrigger(  )
