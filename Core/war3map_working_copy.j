function Trig_S_CWE_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
                       if IsAllianceHero( GetTriggerUnit() ) then
    set udg_TempString = "The Chillwind Effort"
    set udg_TempString_Quest = "Deliver the supplies to Chillwind Camp."
    call TriggerExecute( gg_trg_Quest_Start_A )
    set udg_TempString = ""
    if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
    set udg_TempString = udg_QuestionMark
    call QuestSetEnabledBJ( true, udg_Quests[41] )
    call FlashQuestDialogButtonBJ(  )
    endif
    call DestroyEffectBJ( udg_QuestMarks[41] )
    call AddSpecialEffectTargetUnitBJ( "overhead", gg_unit_n00N_0382, udg_TempString )
    set udg_QuestMarks[41] = GetLastCreatedEffectBJ()
    call QuestSetCompletedBJ( udg_Quests[41], false )
    call CreateQuestItemBJ( udg_Quests[41], "TRIGSTR_4999" )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Chillwind_Supplies)
    call CampaignMinimapIconLocBJ( udg_Temp_Unit_Point, bj_CAMPPINGSTYLE_TURNIN )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_MiniMapIcon[41] = GetLastCreatedMinimapIcon()
    call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), false )
    if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
    call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), true )
    endif
    call UnitAddItemByIdSwapped( 'I05J', GetTriggerUnit() )
    call DisableTrigger( GetTriggeringTrigger() )
    call EnableTrigger( gg_trg_E_CWE )
    call TriggerSleepAction( 10.00 )
    call EnableTrigger( gg_trg_L_CWE )
                       endif
    set udg_Temp_Unit_Point = null
endfunction

