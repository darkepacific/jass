//===========================================================================
// Trigger: Shadow Spawned
//===========================================================================
function Trig_Shadow_Spawned_Func006C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetSummonedUnit()) == 'u00W' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetSummonedUnit()) == 'u02I' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetSummonedUnit()) == 'u00X' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetSummonedUnit()) == 'u02K' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetSummonedUnit()) == 'u02J' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetSummonedUnit()) == 'u00V' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetSummonedUnit()) == 'u02L' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Shadow_Spawned_Conditions takes nothing returns boolean
    if ( not Trig_Shadow_Spawned_Func006C() ) then
        return false
    endif
    return true
endfunction

function Trig_Shadow_Spawned_Func008C takes nothing returns boolean
    if ( not ( GetSummoningUnit() == udg_yA_Shadow_Priest ) ) then
        return false
    endif
    return true
endfunction

function Trig_Shadow_Spawned_Func010C takes nothing returns boolean
    if ( not ( GetSummoningUnit() == udg_yH_Shadow_Priest ) ) then
        return false
    endif
    return true
endfunction

function Trig_Shadow_Spawned_Actions takes nothing returns nothing
    local effect VoidExplosion
    local integer udg_Player_Number = HeroesNumb(GetTriggerPlayer())
    set udg_Temp_Unit = GetSummoningUnit()
    call UnitAddAbilityBJ( 'A02N', GetSummoningUnit() )
    call TriggerExecute( gg_trg_Firelords_Helper)
    // dwarf
    if ( Trig_Shadow_Spawned_Func008C() ) then
        set udg_ShDW = GetSummonedUnit()
        set udg_Temp_Z_Rev = GetUnitLoc(udg_ShDW)
        call RemoveUnit(udg_ShDW)
        set udg_HeroStatCalc = GetUnitAbilityLevelSwapped('A02M', udg_Temp_Unit)
        if udg_HeroStatCalc == 1 then
        call CreateNUnitsAtLoc( 1, 'u02I', GetOwningPlayer(udg_Temp_Unit), udg_Temp_Z_Rev, GetUnitFacing(GetTriggerUnit()) )
        elseif udg_HeroStatCalc == 2 then
        call CreateNUnitsAtLoc( 1, 'u00X', GetOwningPlayer(udg_Temp_Unit), udg_Temp_Z_Rev, GetUnitFacing(GetTriggerUnit()) )
        else
        call CreateNUnitsAtLoc( 1, 'u02K', GetOwningPlayer(udg_Temp_Unit), udg_Temp_Z_Rev, GetUnitFacing(GetTriggerUnit()) )
        endif
        set udg_ShDW = GetLastCreatedUnit()
        call UnitApplyTimedLifeBJ( 8.35, 'BTLF', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A04H', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A02M', udg_Temp_Unit) )
        call SetUnitAbilityLevelSwapped( 'A07J', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A02M', udg_Temp_Unit) )
        call UnitRemoveAbilityBJ( 'A02M', GetSummoningUnit() )
        call AddSpecialEffectLocBJ( udg_Temp_Z_Rev, "war3mapImported\\Void Disc.mdx" )
        set VoidExplosion = GetLastCreatedEffectBJ()
        // Deal Damage
        set udg_Temp_Int2 = udg_Player_Number
        set udg_VoidExplosion = 1
        call TriggerExecute( gg_trg_Shadow_AOE)
        call RemoveLocation (udg_Temp_Z_Rev)
        call TriggerSleepAction( 0.26 )
        call SetUnitVertexColorBJ( udg_ShDW, 78.45, 0.00, 100, 55.00 )
    else
    endif
    // undead
    if ( Trig_Shadow_Spawned_Func010C() ) then
        set udg_ShUD = GetSummonedUnit()
        call SetUnitAbilityLevelSwapped( 'A04H', GetSummonedUnit(), GetUnitAbilityLevelSwapped('A02M', udg_Temp_Unit) )
        call SetUnitAbilityLevelSwapped( 'A07J', GetSummonedUnit(), GetUnitAbilityLevelSwapped('A02M', udg_Temp_Unit) )
        call UnitRemoveAbilityBJ( 'A02M', GetSummoningUnit() )
        set udg_Temp_Z_Rev = GetUnitLoc(udg_ShUD)
        call AddSpecialEffectLocBJ( udg_Temp_Z_Rev, "war3mapImported\\Void Disc.mdx" )
        set VoidExplosion = GetLastCreatedEffectBJ()
        // Deal Damage
        set udg_Temp_Int2 = udg_Player_Number
        set udg_VoidExplosion = 1
        call TriggerExecute( gg_trg_Shadow_AOE)
        call RemoveLocation (udg_Temp_Z_Rev)
        call TriggerSleepAction( 0.26 )
        call SetUnitVertexColorBJ( udg_ShUD, 78.45, 0.00, 100, 55.00 )
    else
    endif
    call DestroyEffectBJ( VoidExplosion )
    set VoidExplosion = null
endfunction

//===========================================================================
function InitTrig_Shadow_Spawned takes nothing returns nothing
    set gg_trg_Shadow_Spawned = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Shadow_Spawned, EVENT_PLAYER_UNIT_SUMMON )
    call TriggerAddCondition( gg_trg_Shadow_Spawned, Condition( function Trig_Shadow_Spawned_Conditions ) )
    call TriggerAddAction( gg_trg_Shadow_Spawned, function Trig_Shadow_Spawned_Actions )
endfunction

//===========================================================================
// Trigger: Shadow Dies
//===========================================================================
function Trig_Shadow_Dies_Func001C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'u02I' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'u00X' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'u02K' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'u02J' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'u00V' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'u02L' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Shadow_Dies_Conditions takes nothing returns boolean
    if ( not Trig_Shadow_Dies_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Shadow_Dies_Actions takes nothing returns nothing
    local effect VoidExplosion
    local integer udg_Player_Number = HeroesNumb(GetTriggerPlayer())
    // Dwarf
    set udg_Temp_Z_Rev = GetUnitLoc(GetTriggerUnit())
    call AddSpecialEffectLocBJ( udg_Temp_Z_Rev, "war3mapImported\\Void Rift II Purple.mdx" )
    set VoidExplosion = GetLastCreatedEffectBJ()
    set udg_Temp_Int2 = udg_Player_Number
    set udg_VoidExplosion = 1
    call TriggerExecute( gg_trg_Shadow_AOE)
    call RemoveLocation (udg_Temp_Z_Rev)
    // cooldown logic
    call ShadowCD( udg_Heroes[udg_Player_Number] )
    // destroy SE
    call TriggerSleepAction( 0.26 )
    call DestroyEffectBJ( VoidExplosion )
    call RemoveUnit(GetTriggerUnit())
    set VoidExplosion = null
endfunction

//===========================================================================
function InitTrig_Shadow_Dies takes nothing returns nothing
    set gg_trg_Shadow_Dies = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Shadow_Dies, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_Shadow_Dies, Condition( function Trig_Shadow_Dies_Conditions ) )
    call TriggerAddAction( gg_trg_Shadow_Dies, function Trig_Shadow_Dies_Actions )
endfunction

//===========================================================================
// Trigger: Shadow AOE
//===========================================================================
function Trig_Shadow_AOE_Func002A takes nothing returns nothing
    local unit udg_Temp_Unit = udg_Heroes[udg_Temp_Int2]
    local real udg_RealStatCalc
    if IsUnitTargetableEnemy( GetEnumUnit(), udg_Temp_Unit ) then
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    if udg_VoidExplosion == 1 then
    set udg_RealStatCalc = ( 200.00 + ( 4.00 * udg_RealStatCalc ) )
    else
    set udg_RealStatCalc =  I2R(GetTotalInt( udg_Temp_Unit)) * 5.0
    endif
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call AddSpecialEffectTargetUnitBJ( "overhead", GetEnumUnit(), "Abilities\\Spells\\Undead\\DeathandDecay\\DeathandDecayTarget.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call HasFirelordsPlayerNumber( GetEnumUnit(), udg_Temp_Int2)
    endif
    set udg_Temp_Unit = null
endfunction

function Trig_Shadow_AOE_Actions takes nothing returns nothing
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(310.00, udg_Temp_Z_Rev), function Trig_Shadow_AOE_Func002A )
endfunction

//===========================================================================
function InitTrig_Shadow_AOE takes nothing returns nothing
    set gg_trg_Shadow_AOE = CreateTrigger(  )
    call TriggerAddAction( gg_trg_Shadow_AOE, function Trig_Shadow_AOE_Actions )
endfunction

//===========================================================================
// Trigger: Voidblast
//===========================================================================
function Trig_Voidblast_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A04H' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Voidblast_Func001C takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetTriggerUnit()) == Player(PLAYER_NEUTRAL_AGGRESSIVE) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Voidblast_Actions takes nothing returns nothing
    if ( Trig_Voidblast_Func001C() ) then
        set udg_RealStatCalc = ( 40.00 + ( 3.00 * I2R(GetUnitLevel(GetTriggerUnit())) ) )
        call UnitDamageTargetBJ( GetTriggerUnit(), GetSpellTargetUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    else
        set udg_Temp_Unit = GetTriggerUnit()
        call TriggerExecute( gg_trg_Firelords_Helper)
        set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A04H', GetTriggerUnit()) * 100 )
        set udg_HeroStatCalc = ( udg_HeroStatCalc + 100 )
        set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
        set udg_RealStatCalc = ( 2.00 * udg_RealStatCalc )
        set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
        call UnitDamageTargetBJ( GetTriggerUnit(), GetSpellTargetUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        call HasFirelords( GetSpellTargetUnit() )
    endif
endfunction

//===========================================================================
function InitTrig_Voidblast takes nothing returns nothing
    set gg_trg_Voidblast = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Voidblast, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Voidblast, Condition( function Trig_Voidblast_Conditions ) )
    call TriggerAddAction( gg_trg_Voidblast, function Trig_Voidblast_Actions )
endfunction

