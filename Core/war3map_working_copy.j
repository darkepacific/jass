function InitTrig_E_Find_Timmy_H takes nothing returns nothing
    set gg_trg_E_Find_Timmy_H = CreateTrigger(  )
    call DisableTrigger( gg_trg_E_Find_Timmy_H )
    call TriggerRegisterDestDeathInRegionEvent( gg_trg_E_Find_Timmy_H, gg_rct_QTimmyCages1 )
    call TriggerRegisterDestDeathInRegionEvent( gg_trg_E_Find_Timmy_H, gg_rct_QTimmyCages2 )
    call TriggerRegisterDestDeathInRegionEvent( gg_trg_E_Find_Timmy_H, gg_rct_QTimmyCages3 )
    call TriggerRegisterDestDeathInRegionEvent( gg_trg_E_Find_Timmy_H, gg_rct_QTimmyCages4 )
    call TriggerRegisterDestDeathInRegionEvent( gg_trg_E_Find_Timmy_H, gg_rct_QTimmyCages5 )
    call TriggerRegisterDestDeathInRegionEvent( gg_trg_E_Find_Timmy_H, gg_rct_QTimmyCages6 )
    call TriggerAddAction( gg_trg_E_Find_Timmy_H, function Trig_E_Find_Timmy_H_Actions )
endfunction

