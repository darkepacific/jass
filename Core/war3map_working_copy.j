                    set bj_forLoopAIndex = bj_forLoopAIndex + 1
                endloop
                call DisableTrigger( GetTriggeringTrigger() )
            else
            endif
        else
        endif
    else
    endif
    endif
endfunction

//===========================================================================
function InitTrig_Withering_Fire_Tick_H takes nothing returns nothing
    set gg_trg_Withering_Fire_Tick_H = CreateTrigger(  )
    call DisableTrigger( gg_trg_Withering_Fire_Tick_H )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Withering_Fire_Tick_H, 0.02 )
    call TriggerAddAction( gg_trg_Withering_Fire_Tick_H, function Trig_Withering_Fire_Tick_H_Actions )
endfunction

//===========================================================================
// Trigger: Darkhound Trap
//
// Cant use Var unit dies b/c it requires existing units
//===========================================================================
function Trig_Darkhound_Trap_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetDyingUnit()) == 'o00W' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Darkhound_Trap_Func002Func001C takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetTriggerUnit()) == GetOwningPlayer(udg_Heroes[GetForLoopIndexA()]) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Darkhound_Trap_Func005Func002C takes nothing returns boolean
    if ( not ( udg_HeroStatCalc == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Darkhound_Trap_Func005C takes nothing returns boolean
    if ( not ( udg_HeroStatCalc == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Darkhound_Trap_Func012Func002C takes nothing returns boolean
    if ( not ( udg_HeroStatCalc == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Darkhound_Trap_Func012C takes nothing returns boolean
    if ( not ( udg_HeroStatCalc == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Darkhound_Trap_Actions takes nothing returns nothing
    set bj_forLoopAIndex = 0
    set bj_forLoopAIndexEnd = 7
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_Darkhound_Trap_Func002Func001C() ) then
            set udg_Player_Number = GetForLoopIndexA()
            set udg_HeroStatCalc = GetUnitAbilityLevelSwapped('A02G', udg_Heroes[GetForLoopIndexA()])
            set udg_Temp_Unit = udg_Heroes[udg_Player_Number]
            set udg_Temp_Int = ( GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, true) - 0 )
            set udg_Temp_Int = udg_Temp_Int * 2
            exitwhen true
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 200.00, 40.00)
    if ( Trig_Darkhound_Trap_Func005C() ) then
        call CreateNUnitsAtLoc( 1, 'o00V', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, 240.00 )
    else
        if ( Trig_Darkhound_Trap_Func005Func002C() ) then
            call CreateNUnitsAtLoc( 1, 'o00X', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, 240.00 )
        else
            call CreateNUnitsAtLoc( 1, 'o00Y', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, 240.00 )
        endif
    endif
    call BlzSetUnitWeaponIntegerFieldBJ( GetLastCreatedUnit(), UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 0, ( BlzGetUnitBaseDamage(GetLastCreatedUnit(), 0) + udg_Temp_Int ) )
    call SetUnitExplodedBJ( GetLastCreatedUnit(), true )
    call UnitApplyTimedLifeBJ( 10.00, 'Brai', GetLastCreatedUnit() )
    call RemoveLocation (udg_Temp_Polar_Point)
    // Add Jump Script Here
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 200.00, 180.00)
    if ( Trig_Darkhound_Trap_Func012C() ) then
        call CreateNUnitsAtLoc( 1, 'o00V', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, 240.00 )
    else
        if ( Trig_Darkhound_Trap_Func012Func002C() ) then
            call CreateNUnitsAtLoc( 1, 'o00X', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, 240.00 )
        else
            call CreateNUnitsAtLoc( 1, 'o00Y', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, 240.00 )
        endif
    endif
    call BlzSetUnitWeaponIntegerFieldBJ( GetLastCreatedUnit(), UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 1, ( BlzGetUnitBaseDamage(GetLastCreatedUnit(), 1) + udg_Temp_Int ) )
    call SetUnitExplodedBJ( GetLastCreatedUnit(), true )
    call UnitApplyTimedLifeBJ( 10.00, 'Brai', GetLastCreatedUnit() )
    call RemoveLocation (udg_Temp_Polar_Point)
    // Add Jump Script Here
    call RemoveLocation (udg_Temp_Unit_Point)
endfunction

//===========================================================================
function InitTrig_Darkhound_Trap takes nothing returns nothing
    set gg_trg_Darkhound_Trap = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Darkhound_Trap, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_Darkhound_Trap, Condition( function Trig_Darkhound_Trap_Conditions ) )
    call TriggerAddAction( gg_trg_Darkhound_Trap, function Trig_Darkhound_Trap_Actions )
endfunction

//===========================================================================
// Trigger: Haunting Wave Cast
//===========================================================================
function Trig_Haunting_Wave_Cast_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A04V' ) ) then
        return false
    endif
    if ( not ( GetPlayerController(GetOwningPlayer(GetTriggerUnit())) == MAP_CONTROL_USER ) ) then
        return false
    endif
    return true
endfunction

function Trig_Haunting_Wave_Cast_Actions takes nothing returns nothing
    local location SpellLocation = GetSpellTargetLoc()
    local unit caster = GetTriggerUnit()
    set udg_Temp_Unit_Point = GetUnitLoc(caster)

    if ( caster == udg_yA_Dark_Ranger ) then
        set udg_o = udg_z_HU_DARK_A
    endif
    if ( caster == udg_yH_Dark_Ranger ) then
	set udg_o = udg_z_HU_DARK_H
    endif
    call PlaySoundOnUnitBJ( gg_snd_TempleOfTheDamnedWhat, 80.00, caster )
    
    set udg_Temp_Angle = AngleBetweenPoints(udg_Temp_Unit_Point, SpellLocation) 
    set udg_Temp_Polar_Point = PolarProjectionBJ( udg_Temp_Unit_Point, 100.00,  udg_Temp_Angle)
    call CreateNUnitsAtLoc( 1, 'e01M', GetOwningPlayer(caster), udg_Temp_Polar_Point , AngleBetweenPoints( udg_Temp_Unit_Point, udg_Temp_Polar_Point ) )
    set udg_SpellUnits[udg_o] = GetLastCreatedUnit()
    call UnitApplyTimedLifeBJ( 1.10, 'BTLF', udg_SpellUnits[udg_o] )
    call RemoveLocation(udg_Temp_Unit_Point)
    call RemoveLocation(udg_Temp_Polar_Point)

    set udg_Temp_Polar_Point = PolarProjectionBJ( SpellLocation, 520.00,  udg_Temp_Angle)
    call IssuePointOrderLocBJ( udg_SpellUnits[udg_o], "move", udg_Temp_Polar_Point )
    call RemoveLocation(udg_Temp_Polar_Point)
    
    call SetPlayerAbilityAvailableBJ( false, 'A04V', GetOwningPlayer(caster) )
    call UnitAddAbilityBJ( 'A05L', caster )
    if ( caster == udg_yA_Dark_Ranger ) then
        call EnableTrigger( gg_trg_Swap_Haunting_Wave_WG )
    endif
    if ( caster == udg_yH_Dark_Ranger ) then
        call EnableTrigger( gg_trg_Swap_Haunting_Wave_UD )
    endif
    
    // Windrunner
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(caster)) * udg_NUM_OF_TC + 9 ]  then
      call SetUnitAbilityLevel( gg_unit_e028_1863, 'ACbb', 8 )
      call SetUnitOwner( gg_unit_e028_1863, GetOwningPlayer(caster), false )
      call IssueTargetOrderBJ( gg_unit_e028_1863, "bloodlust", caster )
    endif

    call TriggerSleepAction( 1.10 )
    call UnitRemoveAbilityBJ( 'A05L', caster )
    call SetPlayerAbilityAvailableBJ( true, 'A04V', GetOwningPlayer(caster) )
    call BlzStartUnitAbilityCooldown( caster, 'A04V', BlzGetUnitAbilityCooldown(caster, 'A04V', GetUnitAbilityLevelSwapped('A04V', caster)) )
    if ( caster == udg_yA_Dark_Ranger ) then
        call DisableTrigger( gg_trg_Swap_Haunting_Wave_WG )
    endif
    if ( caster == udg_yH_Dark_Ranger ) then
        call DisableTrigger( gg_trg_Swap_Haunting_Wave_UD )
    endif

    call RemoveLocation(SpellLocation)
    set SpellLocation = null
    set caster = null
endfunction

//===========================================================================
function InitTrig_Haunting_Wave_Cast takes nothing returns nothing
    set gg_trg_Haunting_Wave_Cast = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Haunting_Wave_Cast, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Haunting_Wave_Cast, Condition( function Trig_Haunting_Wave_Cast_Conditions ) )
    call TriggerAddAction( gg_trg_Haunting_Wave_Cast, function Trig_Haunting_Wave_Cast_Actions )
endfunction
//===========================================================================
// Trigger: Swap Haunting Wave WG
//===========================================================================
function Trig_Swap_Haunting_Wave_WG_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A05L' ) ) then
        return false
    endif
    if ( not ( GetSpellAbilityUnit() == udg_yA_Dark_Ranger ) ) then
        return false
    endif
    return true
endfunction

function Trig_Swap_Haunting_Wave_WG_Actions takes nothing returns nothing
    set udg_o = udg_z_HU_DARK_A
    set udg_Temp_Unit_Point = GetUnitLoc( udg_SpellUnits[ udg_o + 0] )
    if not IsTerrainPathable( GetLocationX(udg_Temp_Unit_Point), GetLocationY(udg_Temp_Unit_Point), PATHING_TYPE_WALKABILITY) then
    call SetUnitPositionLoc( GetTriggerUnit(), udg_Temp_Unit_Point )
    endif
    call RemoveLocation (udg_Temp_Unit_Point)
    call DisableTrigger( gg_trg_Swap_Haunting_Wave_WG )
endfunction

