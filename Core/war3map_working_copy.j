function Trig_U_TAC_Func008A takes nothing returns nothing
    if ( Trig_U_TAC_Func008Func001C() ) then
        set udg_HeroStatCalc = ( udg_HeroStatCalc + 1 )
        if ( Trig_U_TAC_Func008Func001Func002C() ) then
            call RemoveUnit( GetEnumUnit() )
        else
        endif
        call AddSpecialEffectTargetUnitBJ( "chest", GetEnumUnit(), "Abilities\\Weapons\\FireBallMissile\\FireBallMissile.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "war3mapImported\\FireballRibbons.mdx" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), 300.00, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    else
    endif
endfunction

function Trig_U_TAC_Func009C takes nothing returns boolean
    if ( not ( udg_QuestAmaniCatacombs < 20.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_U_TAC_Actions takes nothing returns nothing
    call QuestItemSetDescriptionBJ( udg_QuestReqs[105], ( "Amani Remains Burned -" + ( I2S(R2I(udg_QuestAmaniCatacombs)) + "/20" ) ) )
    set udg_Temp_Unit_Point = GetSpellTargetLoc()
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Weapons\\DemolisherFireMissile\\DemolisherFireMissile.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set udg_HeroStatCalc = 0
    set udg_Temp_Unit = GetTriggerUnit()
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(220.00, udg_Temp_Unit_Point), function Trig_U_TAC_Func008A )
    if ( Trig_U_TAC_Func009C() ) then
        if udg_HeroStatCalc > 0 then
        set udg_QuestAmaniCatacombs = ( udg_QuestAmaniCatacombs + I2R(udg_HeroStatCalc) )
        call CreateTextTagLocBJ( ( ( "+" + I2S(udg_HeroStatCalc) ) + " Remains Burned" ), udg_Temp_Unit_Point, 40.00, 9.00, 100, 60.00, 0.00, 0 )
        call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
        call cleanUpText(0.7, 0.4)
        endif
    else
    endif
    call RemoveLocation (udg_Temp_Unit_Point)
endfunction

