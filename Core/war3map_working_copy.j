//===========================================================================
function Trig_Charge_Death_Sentence_UR_Func001C takes nothing returns boolean
    if ( not ( udg_i_Chain_Undead <= udg_Chain_Terminator_Undead ) ) then
        return false
    endif
    return true
endfunction

