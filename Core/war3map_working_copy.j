    set gg_trg_Muru = CreateTrigger(  )
    call TriggerRegisterUnitEvent( gg_trg_Muru, gg_unit_H03W_2340, EVENT_UNIT_DEATH )
    call TriggerAddAction( gg_trg_Muru, function Trig_Muru_Actions )
endfunction

