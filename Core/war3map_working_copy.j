    set gg_trg_Die_by_the_Sword = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Die_by_the_Sword, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Die_by_the_Sword, Condition( function Trig_Die_by_the_Sword_Conditions ) )
