//===========================================================================
// Trigger: M The Greenwardens Grove
//===========================================================================
function Trig_M_The_Greenwardens_Grove_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 112
    set udg_TempString = ""
    if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
    set udg_TempString = udg_ExclamationMark
    endif
    call AddSpecialEffectTargetUnitBJ( "overhead", gg_unit_etrp_0647, udg_TempString )
    set udg_QuestMarks[112] = GetLastCreatedEffectBJ()
    set udg_TempString = "If only I could have a grove of my own. Take these acorns, plant them in fertile soil to the west and defend them until they are fully grown. Then command them to move to me."
    // Set Quest Rewards
    set udg_QUEST_XP[udg_Temp_Int] = 600
    set udg_QUEST_GOLD[udg_Temp_Int] = 150
    set udg_QUEST_LVL_REQ[udg_Temp_Int] = udg_QUEST_ZONE_2_LVL_REQ
    call QuestRewards_TextSet(udg_Temp_Int)
    // End Set Quest Rewards
    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_10086", udg_TempString, "ReplaceableTextures\\CommandButtons\\BTNEnt.blp" )
    set udg_Quests[112] = GetLastCreatedQuestBJ()
    call QuestSetEnabledBJ( false, GetLastCreatedQuestBJ() )
    call EnableTrigger( gg_trg_S_GWG)
endfunction

