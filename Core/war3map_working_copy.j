//===========================================================================
// Trigger: Duel End
//===========================================================================
function Trig_Duel_End_Func002Func003Func002C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Duel_End_Func002Func003C takes nothing returns boolean
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Duel_End_Func002A takes nothing returns nothing
    local integer heroNumb = 0
    local player p = GetOwningPlayer(GetEnumUnit())
    if ( Trig_Duel_End_Func002Func003C() ) then
        call BlzEndUnitAbilityCooldown( GetEnumUnit(), 'A02D' )
        if ( Trig_Duel_End_Func002Func003Func002C() ) then
            call SetUnitLifePercentBJ( GetEnumUnit(), 100 )
            call SetUnitManaPercentBJ( GetEnumUnit(), 100 )
            call ResetPlayerForces( p )
            call BJDebugMsg(GetPlayerName( p ) + " won!")
            call PlayLocalSound( gg_snd_GoodJob, p )
            set heroNumb = GetPlayerHeroNumber(p)
            call SetUnitPosition(udg_Heroes[heroNumb], HeroX[heroNumb], HeroY[heroNumb])
            call SetCameraPositionForPlayer(p, HeroX[heroNumb], HeroY[heroNumb])
            call Debug("HeroX,Y: " + R2S(HeroX[heroNumb]) + "," + R2S(HeroY[heroNumb])  + "   heroNumb: " + I2S(heroNumb))
            call HeroScoreFrameDuelRestoreAllianceFlags()
        else
        endif
    else
        call KillUnit( GetEnumUnit() )
    endif
    set p = null
endfunction

function Trig_Duel_End_Actions takes nothing returns nothing
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRectAll(gg_rct_Z_Duel_Island), function Trig_Duel_End_Func002A )
endfunction

