    return true
endfunction

function Trig_Endless_Rage_Press_R_Actions takes nothing returns nothing
    local unit udg_Temp_Unit
    call Debug("Fury Warr pressed R")
    if ( Trig_Endless_Rage_Press_R_Func003C() ) then
        set udg_Temp_Unit = udg_yA_Fury_Warr
    else
        set udg_Temp_Unit = udg_yH_Fury_Warr
