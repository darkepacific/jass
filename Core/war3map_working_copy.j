//===========================================================================
// Trigger: Cat Cast NE
//
// Was a .15s delay in between on and off
// call AddSpellHideSpell( 'Sshm', 'A038' )
// call UnitAddAbility( udg_Temp_Unit, 'Sshm')
//===========================================================================
function Trig_Cat_Cast_NE_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A035' ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetTriggerUnit()) != Player(PLAYER_NEUTRAL_AGGRESSIVE) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cat_Cast_NE_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    call SetPlayerAbilityAvailableBJ( false, 'A031', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'A030', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'A02Z', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'A02Y', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'A0CV', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'A0E1', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'A0E3', GetOwningPlayer(GetTriggerUnit()) )
    call SetUnitAbilityLevelSwapped( 'A042', GetTriggerUnit(), GetUnitAbilityLevelSwapped('A035', GetTriggerUnit()) )
    call SetUnitAbilityLevelSwapped( 'A044', GetTriggerUnit(), GetUnitAbilityLevelSwapped('A035', GetTriggerUnit()) )
    call SetUnitAbilityLevelSwapped( 'A0GT', GetTriggerUnit(), GetUnitAbilityLevelSwapped('A035', GetTriggerUnit()) )
    call SetUnitAbilityLevelSwapped( 'A046', GetTriggerUnit(), GetUnitAbilityLevelSwapped('A035', GetTriggerUnit()) )
    call SetUnitAbilityLevelSwapped( 'A03T', GetTriggerUnit(), GetUnitAbilityLevelSwapped('A035', GetTriggerUnit()) )
    // Inivisibility
    set udg_Temp_Unit = GetTriggerUnit()
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 11 ]  then
    call AddSpellHideSpell( udg_Temp_Unit, 'A0GW', 'A038', false)
    endif
    // Rest
    call HasBanshees( GetTriggerUnit() )
    call GameTimeWait(0.1)
    set udg_Temp_Unit = GetTriggerUnit()
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 11 ]  then
    call IssueImmediateOrder(udg_Temp_Unit, "windwalk")
    endif
    call EnableTrigger( gg_trg_Cat_Unmorph_NE )
endfunction

//===========================================================================
function InitTrig_Cat_Cast_NE takes nothing returns nothing
    set gg_trg_Cat_Cast_NE = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Cat_Cast_NE, EVENT_PLAYER_UNIT_SPELL_FINISH )
    call TriggerAddCondition( gg_trg_Cat_Cast_NE, Condition( function Trig_Cat_Cast_NE_Conditions ) )
    call TriggerAddAction( gg_trg_Cat_Cast_NE, function Trig_Cat_Cast_NE_Actions )
endfunction

