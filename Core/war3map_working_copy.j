    return true
endfunction

function Trig_U_BBW_Func011Func015C takes nothing returns boolean
    if ( not ( udg_QuestBBW_Total < 5.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_U_BBW_Func011C takes nothing returns boolean
    if ( not ( udg_RealStatCalc >= 1.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_U_BBW_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 160
    local location udg_Temp_Unit_Point
    local location udg_Temp_Polar_Point
                       if IsAllianceHero( GetTriggerUnit() ) then
    set udg_RealStatCalc = 0.00
    if ( Trig_U_BBW_Func006C() ) then
        set udg_RealStatCalc = 10000.00
        set udg_QuestBBW_Total =  udg_QuestBBW_Total + 1
    else
    endif
    if ( Trig_U_BBW_Func007C() ) then
        set udg_RealStatCalc = 1000.00
        set udg_QuestBBW_Total =  udg_QuestBBW_Total + 1
    else
    endif
    if ( Trig_U_BBW_Func008C() ) then
        set udg_RealStatCalc = 100.00
        set udg_QuestBBW_Total =  udg_QuestBBW_Total + 1
    else
    endif
    if ( Trig_U_BBW_Func009C() ) then
        set udg_RealStatCalc = 10.00
        set udg_QuestBBW_Total =  udg_QuestBBW_Total + 1
    else
    endif
    if ( Trig_U_BBW_Func010C() ) then
        set udg_RealStatCalc = 1.00
        set udg_QuestBBW_Total =  udg_QuestBBW_Total + 1
    else
    endif
    if ( Trig_U_BBW_Func011C() ) then
        set udg_QuestBBW =  udg_QuestBBW + udg_RealStatCalc
        call QuestItemSetDescriptionBJ( udg_QuestReqs[udg_Temp_Int], ( "Burials Found - " + ( I2S(R2I(udg_QuestBBW_Total)) + "/5" ) ) )
        call CreateTextTagUnitBJ( "TRIGSTR_10911", GetTriggerUnit(), 0.00, 9.00, 20.00, 80.00, 100.00, 0 )
        call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
        call cleanUpText(1.2, 0.85)
        set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
        set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, GetRandomReal(120.00, 160.00), GetRandomDirectionDeg())
        call AddSpecialEffectLocBJ( udg_Temp_Polar_Point, "war3mapImported\\AquaSpike_72_Short_Tail_80_SuperShort.mdx" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        if ( Trig_U_BBW_Func011Func015C() ) then
            call CreateNUnitsAtLoc( 1, 'u046', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Temp_Polar_Point, GetRandomDirectionDeg() )
            call SetUnitVertexColorBJ( GetLastCreatedUnit(), 100.00, 100, 100, 35.00 )
            call SetUnitColor( GetLastCreatedUnit(), GetPlayerColor(Player(13)) )
        else
            call CreateNUnitsAtLoc( 1, 'n063', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Temp_Polar_Point, GetRandomDirectionDeg() )
            call SetUnitVertexColorBJ( GetLastCreatedUnit(), 60.00, 100, 100, 45.00 )
            call SetUnitColor( GetLastCreatedUnit(), GetPlayerColor(Player(21)) )
        endif
        call RemoveLocation (udg_Temp_Unit_Point)
        call RemoveLocation (udg_Temp_Polar_Point)
    else
        // If they are not in any of the key regions, check if they are in the ghostlands
        // if not in ghostlands throw and error
        set udg_Player_Number = HeroesNumb(GetTriggerPlayer())
        if ( Trig_U_BBW_Func011Func005C() ) then
            call ErrorMessage("Must be in Wetlands to use this item.", GetTriggerPlayer() )
            call IssueImmediateOrderBJ( GetTriggerUnit(), "stop" )
        else
            if ( Trig_U_BBW_Func011Func005Func001C() ) then
                call QuestPingRectCenterForPlayer(GetOwningPlayer(GetTriggerUnit()), gg_rct_BBW_5)
            else
            endif
            if ( Trig_U_BBW_Func011Func005Func002C() ) then
                call QuestPingRectCenterForPlayer(GetOwningPlayer(GetTriggerUnit()), gg_rct_BBW_4)
            else
            endif
            if ( Trig_U_BBW_Func011Func005Func003C() ) then
                call QuestPingRectCenterForPlayer(GetOwningPlayer(GetTriggerUnit()), gg_rct_BBW_3)
            else
            endif
            if ( Trig_U_BBW_Func011Func005Func004C() ) then
                call QuestPingRectCenterForPlayer(GetOwningPlayer(GetTriggerUnit()), gg_rct_BBW_2)
            else
            endif
            if ( Trig_U_BBW_Func011Func005Func005C() ) then
                call QuestPingRectCenterForPlayer(GetOwningPlayer(GetTriggerUnit()), gg_rct_BBW_1)
            else
            endif
        endif
    endif
                       else
    call ErrorMessage("This is an Alliance quest item.", GetTriggerPlayer() )
                       endif
    set udg_Temp_Polar_Point = null
    set udg_Temp_Unit_Point = null
endfunction

