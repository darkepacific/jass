//===========================================================================
function Trig_Ice_Crown_Gate_Func005Func001C takes nothing returns boolean
    if ( not ( GetItemTypeId(udg_P_Items[( udg_Bag_Num + udg_Bag_Iterator )]) == udg_ItemTypeCheck ) ) then
        return false
    endif
    return true
endfunction

function Trig_Ice_Crown_Gate_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
                       if IsPlayerHero( GetTriggerUnit() ) then
    call SetBagNumber( GetOwningPlayer(GetTriggerUnit()) )
    set udg_ItemTypeCheck = 'I04I'
    set udg_Bag_Iterator = 1
    loop
        exitwhen udg_Bag_Iterator > udg_BAG_LOOP_MAX
        if ( Trig_Ice_Crown_Gate_Func005Func001C() ) then
            call ModifyGateBJ( bj_GATEOPERATION_DESTROY, gg_dest_ITx1_36484 )
            call PlaySoundOnUnitBJ( gg_snd_BattleShipDeath1, 100.00, GetEnteringUnit() )
            call DisableTrigger( GetTriggeringTrigger() )
            exitwhen true
        else
        endif
        set udg_Bag_Iterator = udg_Bag_Iterator + 1
    endloop
                       endif
    set udg_Temp_Unit_Point = null
endfunction

//===========================================================================
function InitTrig_Ice_Crown_Gate takes nothing returns nothing
    set gg_trg_Ice_Crown_Gate = CreateTrigger(  )
    call TriggerRegisterEnterRectSimple( gg_trg_Ice_Crown_Gate, gg_rct_IceWall_Gate_Icecrown )
    call TriggerAddAction( gg_trg_Ice_Crown_Gate, function Trig_Ice_Crown_Gate_Actions )
endfunction

