//===========================================================================
// Trigger: LVLS DWN
//===========================================================================
function Trig_LVLS_DWN_Func002C takes nothing returns boolean
    if ( not ( udg_HeroStatCalc == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_LVLS_DWN_Actions takes nothing returns nothing
    set udg_HeroStatCalc = S2I(SubStringBJ(GetEventPlayerChatString(), 5, 6))
    if ( Trig_LVLS_DWN_Func002C() ) then
        set udg_HeroStatCalc = udg_FINALS_LEVEL_1
    else
    endif
    set bj_forLoopAIndex = 0
    set bj_forLoopAIndexEnd = 7
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetHeroLevelBJ( udg_Heroes[GetForLoopIndexA()], udg_HeroStatCalc, true )
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
endfunction

//===========================================================================
function InitTrig_LVLS_DWN takes nothing returns nothing
    set gg_trg_LVLS_DWN = CreateTrigger(  )
