//===========================================================================
// Trigger: Frozen Orb
//===========================================================================
function Trig_Frozen_Orb_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0D9'
endfunction

function Trig_Frozen_Orb_Actions takes nothing returns nothing
    local unit caster = GetTriggerUnit()
    local integer o
    local location pt_cast
    local location polar
    local location tgt

    // Pick the frost mage slot (only two frost mages exist)
    if (GetUnitTypeId(caster) == 'H00A') then
        set o = udg_z_MA_FROS_A
    else
        set o = udg_z_MA_FROS_H
    endif

    call PlaySoundOnUnitBJ(gg_snd_FrozenOrbCast, 90.00, caster)

    // Spawn orb slightly in front of caster
    set pt_cast = GetUnitLoc(caster)
    set polar = PolarProjectionBJ(pt_cast, 80.00, GetUnitFacing(caster))
    call CreateNUnitsAtLoc(1, 'e03Z', GetOwningPlayer(caster), polar, GetUnitFacing(caster))
    set udg_SpellUnits[o] = GetLastCreatedUnit()

    call RemoveLocation(polar)
    call RemoveLocation(pt_cast)

    // Order orb to move to target
    set tgt = GetSpellTargetLoc()
    call IssuePointOrderLocBJ(udg_SpellUnits[o], "move", tgt)
    call RemoveLocation(tgt)

    call FrozenOrb_Tick(caster, o)
    call GameTimeWait(0.4)
    call FrozenOrb_Tick(caster, o)
    call GameTimeWait(0.4)
    call FrozenOrb_Tick(caster, o)
    call GameTimeWait(0.4)
    call FrozenOrb_Tick(caster, o)
    call GameTimeWait(0.4)
    call FrozenOrb_Tick(caster, o)
    call GameTimeWait(0.4)

    call FrozenOrb_Explode(caster, o)

    set caster = null
endfunction

function InitTrig_Frozen_Orb takes nothing returns nothing
    set gg_trg_Frozen_Orb = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Frozen_Orb, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Frozen_Orb, Condition(function Trig_Frozen_Orb_Conditions))
    call TriggerAddAction(gg_trg_Frozen_Orb, function Trig_Frozen_Orb_Actions)
endfunction

//===========================================================================
// Trigger: Living Bomb Start
//===========================================================================
function Trig_Living_Bomb_Start_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0DJ' ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Living_Bomb_Start_Func002C takes nothing returns boolean
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Living_Bomb_Start_Actions takes nothing returns nothing
    local unit LivingBomb = GetSpellTargetUnit()
    if ( Trig_Living_Bomb_Start_Func002C() ) then
        // DMG
        // eg lvl 3: 240 (60x3+60) + 2x RSC
        set udg_Temp_Unit = GetTriggerUnit()
        set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
        set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A0DJ', udg_Temp_Unit) + 0 )
        set udg_RealStatCalc = ( ( 0.50 + ( I2R(udg_HeroStatCalc) / 2.00 ) ) * udg_RealStatCalc )
        set udg_HeroStatCalc = ( udg_HeroStatCalc * 60 )
        set udg_HeroStatCalc = ( udg_HeroStatCalc + 60 )
        set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
        call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A0DJ'), ABILITY_RLF_PRIMARY_DAMAGE, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), udg_RealStatCalc )
    else
    endif
    call GameTimeWait(0.3)
    if IsPlayerInForce( GetTriggerPlayer(), udg_AlliancePlayers) then
    set udg_o = udg_z_MA_FIRE_A
    call EnableTrigger( gg_trg_Living_Bomb_Tick_A)
    else
    set udg_o = udg_z_MA_FIRE_H
    call EnableTrigger( gg_trg_Living_Bomb_Tick_H)
    endif
    set udg_o = ( udg_o + 16 )
    set udg_SpellUnits[udg_o] = LivingBomb
    set LivingBomb = null
endfunction

//===========================================================================
function InitTrig_Living_Bomb_Start takes nothing returns nothing
    set gg_trg_Living_Bomb_Start = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Living_Bomb_Start, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Living_Bomb_Start, Condition( function Trig_Living_Bomb_Start_Conditions ) )
    call TriggerAddAction( gg_trg_Living_Bomb_Start, function Trig_Living_Bomb_Start_Actions )
endfunction

//===========================================================================
// Trigger: Living Bomb Tick A
//===========================================================================
function Trig_Living_Bomb_Tick_A_Actions takes nothing returns nothing
    set udg_Temp_Unit = udg_yA_Fire_Mage 
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A0DJ', udg_Temp_Unit) + 0 )
    set udg_RealStatCalc = ( ( 0.50 + ( I2R(udg_HeroStatCalc) / 2.00 ) ) * udg_RealStatCalc )
    set udg_HeroStatCalc = ( udg_HeroStatCalc * 60 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 60 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    if udg_Debug then
    call DisplayTextToForce( GetPlayersAll(), I2S(GetTriggerExecCount(GetTriggeringTrigger())) )
    endif
    set udg_o = udg_z_MA_FIRE_A
    call CheckLivingBombUnits()
    return
    call TriggerExecute( gg_trg_Firelords_Helper)
endfunction

