//===========================================================================
// Trigger: Ancestral Spirit
//===========================================================================
function Trig_Ancestral_Spirit_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0G4' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Ancestral_Spirit_Func002Func010C takes nothing returns boolean
    if ( not ( udg_Temp_Int < 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Ancestral_Spirit_Func002C takes nothing returns boolean
    if ( not ( udg_IsValidRezzTarget == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Ancestral_Spirit_Actions takes nothing returns nothing
    call Debug("Finish Ances Triggered" )
    if ( Trig_Ancestral_Spirit_Func002C() ) then
        set udg_Temp_Unit = GetTriggerUnit()
        set udg_Temp_Unit_CD =  udg_Temp_Unit 
        // Add Logic To Revive Based on Stone
        call PlayerNumbtoHeroesNumb()
        call Debug("Player " + I2S(udg_Player_Number) + ": " )
        set bj_forLoopAIndex = 0
        set bj_forLoopAIndexEnd = 7
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            if udg_Graves[udg_Player_Number + 24] == udg_Graves[bj_forLoopAIndex] then
            call Debug("Attempted to Revive Player: " + I2S(bj_forLoopAIndex) + " " + GetDestructableName( udg_Graves[bj_forLoopAIndex] ))
            set udg_Temp_Int = GetForLoopIndexA()
            exitwhen true
            endif
            set bj_forLoopAIndex = bj_forLoopAIndex + 1
        endloop
        if IsUnitDead( udg_Heroes[udg_Temp_Int]) then
        set udg_DoRevive = true
        set udg_IsARezz = true
        if ( Trig_Ancestral_Spirit_Func002Func010C() ) then
            call TriggerExecute(gg_trg_Death_Set_Horde)
        else
            call TriggerExecute(gg_trg_Death_Set_Alliance)
        endif
        set udg_Temp_Unit_CD = udg_Heroes[udg_Player_Number]
        set udg_RealStatCalc = ( I2R(GetUnitAbilityLevelSwapped('A0G4', udg_Temp_Unit_CD)) * -20.00 )
        set udg_RealStatCalc = ( udg_RealStatCalc + 160.00 )
        call TriggerExecute( gg_trg_Cooldown_Maths)
        set udg_CooldownRemaining = ( udg_CooldownRemaining * udg_RealStatCalc )
        else
        set udg_CooldownRemaining = 0.05
        call ErrorMessage( "Unit is alive.", GetOwningPlayer(udg_Temp_Unit_CD) )
        endif
        call BlzStartUnitAbilityCooldown( udg_Temp_Unit_CD, 'A0G4', udg_CooldownRemaining )
    else
    endif
    set udg_IsValidRezzTarget = true
endfunction

//===========================================================================
function InitTrig_Ancestral_Spirit takes nothing returns nothing
    set gg_trg_Ancestral_Spirit = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Ancestral_Spirit, EVENT_PLAYER_UNIT_SPELL_FINISH )
    call TriggerAddCondition( gg_trg_Ancestral_Spirit, Condition( function Trig_Ancestral_Spirit_Conditions ) )
