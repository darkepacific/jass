function Trig_HW_Salv_Tick_A_Func010A takes nothing returns nothing
    if IsUnitTargetableAlly( GetEnumUnit(), udg_Temp_Unit ) then
    call SetUnitLifeBJ( GetEnumUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetEnumUnit()) + udg_RealStatCalc ) )
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "war3mapImported\\Radiance Holy.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    endif
endfunction

function Trig_HW_Salv_Tick_A_Actions takes nothing returns nothing
    set udg_Temp_Unit = udg_yA_Holy_Priest
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A0FZ', udg_Temp_Unit) * 100 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 100 )
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 3.00 * udg_RealStatCalc )
    call ChaliceSet()
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    set udg_RealStatCalc = ( 0.10 * udg_RealStatCalc )
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(320.00, udg_Blizzard[34]), function Trig_HW_Salv_Tick_A_Func010A )
endfunction

