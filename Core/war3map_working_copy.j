//===========================================================================
// Trigger: S SoG
//
// Icon 66 is used for the WORGEN IN THE WOODS Quest Line
//===========================================================================
function Trig_S_SoG_Func003C takes nothing returns boolean
    if ( not ( IsTriggerEnabled(gg_trg_E_SoG) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_S_SoG_Actions takes nothing returns nothing
                       if IsHordeHero( GetTriggerUnit() ) then
    call DisableTrigger( GetTriggeringTrigger() )
    if ( Trig_S_SoG_Func003C() ) then
        set udg_TempString = "The Siege of Gilneas"
        set udg_TempString_Quest = "Attack Gilneas and Kill Genn Greymane."
        call TriggerExecute( gg_trg_Quest_Start_H )
        if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
        call QuestSetEnabledBJ( true, udg_Quests[66] )
        call FlashQuestDialogButtonBJ(  )
        endif
        call DestroyEffectBJ( udg_QuestMarks[66] )
        call QuestSetCompletedBJ( udg_Quests[66], false )
        call CreateQuestItemBJ( udg_Quests[66], "TRIGSTR_2052" )
        set udg_QuestReqs[66] = GetLastCreatedQuestItemBJ()
        call CampaignMinimapIconUnitBJ( gg_unit_U00J_1218, bj_CAMPPINGSTYLE_BOSS )
        call SetMinimapIconOrphanDestroy( GetLastCreatedMinimapIcon(), true )
        if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
        call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), false )
        endif
        call EnableTrigger( gg_trg_E_SoG )
        call TriggerSleepAction( 2.50 )
    else
    endif
    call TriggerExecute( gg_trg_The_Siege_of_Gilneas )
                       endif
endfunction

