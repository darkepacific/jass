    call TriggerAddCondition( gg_trg_Voidwalker_Summon, Condition( function Trig_Voidwalker_Summon_Conditions ) )
    call TriggerAddAction( gg_trg_Voidwalker_Summon, function Trig_Voidwalker_Summon_Actions )
endfunction

//===========================================================================
// Trigger: Sacrfice Shield
//
// call SaveRealBJ( 1200.00, 0, GetHandleId(udg_Temp_Unit), udg_ShieldsHash )
// call SaveReal(udg_ShieldsHash, GetHandleId( udg_Temp_Unit ), 0, 1200)
//===========================================================================
function Trig_Sacrfice_Shield_Func021C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'E02V' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'E000' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Sacrfice_Shield_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0EG' ) ) then
        return false
    endif
    if ( not Trig_Sacrfice_Shield_Func021C() ) then
        return false
    endif
    return true
endfunction

function Trig_Sacrfice_Shield_Func003C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'E02V' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Sacrfice_Shield_Actions takes nothing returns nothing
    local unit udg_Temp_Unit
    set udg_Temp_Unit = GetTriggerUnit()
    if ( Trig_Sacrfice_Shield_Func003C() ) then
        set udg_o = udg_z_WL_DEMO_A
    else
        set udg_o = udg_z_WL_DEMO_H
    endif
    call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "war3mapImported\\MagicCircle_Devil.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set udg_Temp_Unit_Point = GetUnitLoc(udg_SpellUnits[ udg_o ] )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\MagicCircle_Demon.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\MagicCircle_Fire.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call RemoveLocation (udg_Temp_Unit_Point)
    if udg_Debug then
    call DisplayTextToForce( GetPlayersAll(), "|cccFFaa00HandleId: |r" + I2S(GetHandleId( udg_Temp_Unit)) )
    endif
    call NewShield( udg_Temp_Unit, R2I(I2R(BlzGetUnitMaxHP(udg_Temp_Unit)) * 0.5) , 99 )
    call SetUnitAbilityLevel( gg_unit_e03G_2001, 'A0BF', 14 )
    				call IssueTargetOrder( gg_unit_e03G_2001, "innerfire", udg_Temp_Unit )
    call KillUnit(udg_SpellUnits[ udg_o ] )
    set udg_Temp_Unit = null
endfunction

