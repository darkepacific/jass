//===========================================================================
// Trigger: Haunting Wave Neutral Cast
//===========================================================================
function Trig_Haunting_Wave_Neutral_Cast_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A04V' ) ) then
        return false
    endif
	//Reversed for Computer
    if ( not ( GetPlayerController(GetOwningPlayer(GetTriggerUnit())) == MAP_CONTROL_USER ) ) then
        return true
    endif
    return false
endfunction

function Trig_Haunting_Wave_Neutral_Cast_Actions takes nothing returns nothing
    local unit u
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
    set udg_Temp_Polar_Point = GetSpellTargetLoc()
    call PlaySoundOnUnitBJ( gg_snd_TempleOfTheDamnedWhat, 80.00, GetSpellAbilityUnit() )
    call CreateNUnitsAtLoc( 1, 'e01M', GetOwningPlayer(udg_Temp_Unit), udg_Temp_Unit_Point , AngleBetweenPoints( udg_Temp_Unit_Point, udg_Temp_Polar_Point ) )
    call UnitApplyTimedLifeBJ( 1.10, 'BTLF', GetLastCreatedUnit() )
    call IssuePointOrderLocBJ( GetLastCreatedUnit(), "move", udg_Temp_Polar_Point )
    set u = GetLastCreatedUnit()
    call RemoveLocation(udg_Temp_Unit_Point)
    call RemoveLocation(udg_Temp_Polar_Point)
    
    call GameTimeWait( 1.00 )
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_Temp_Unit_Point = GetUnitLoc(u)
    if not IsTerrainPathable( GetLocationX(udg_Temp_Unit_Point), GetLocationY(udg_Temp_Unit_Point), PATHING_TYPE_WALKABILITY) then
    	call SetUnitPositionLoc( GetTriggerUnit(), udg_Temp_Unit_Point )
    endif
    call RemoveLocation (udg_Temp_Unit_Point)
    set u = null
endfunction

