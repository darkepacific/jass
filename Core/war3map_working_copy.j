    if ( not ( IsTriggerEnabled(gg_trg_E_ABTP_H) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_E_ABTP_A_Func005Func001C takes nothing returns boolean
    if ( not ( GetItemTypeId(udg_P_Items[( udg_Bag_Num + udg_Bag_Iterator )]) == udg_ItemTypeCheck ) ) then
        return false
    endif
    return true
endfunction

function Trig_E_ABTP_A_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 82
                       if IsAllianceHero( GetTriggerUnit() ) then
    call SetBagNumber( GetOwningPlayer(GetTriggerUnit()) )
    set udg_ItemTypeCheck = 'I05G'
    set udg_Bag_Iterator = 1
    loop
        exitwhen udg_Bag_Iterator > udg_BAG_LOOP_MAX
        if ( Trig_E_ABTP_A_Func005Func001C() ) then
            if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
            call FlashQuestDialogButtonBJ(  )
            endif
            call QuestSetCompletedBJ( udg_Quests[82], true )
            call QuestItemSetCompletedBJ( udg_QuestReqs[82], true )
            call DestroyEffectBJ( udg_QuestMarks[82] )
            // Clean Up Items
            call CleanUpItems_Alliance( udg_ItemTypeCheck )
            // Rewards
            set udg_XP = udg_QUEST_XP[udg_Temp_Int]
            set udg_Gold = udg_QUEST_GOLD[udg_Temp_Int]
            set udg_LVL_Req = udg_QUEST_LVL_REQ[udg_Temp_Int]
            set udg_TempString = "A Bone to Pick"
            call TriggerExecute( gg_trg_Quest_Complete_A )
            call DisableTrigger( GetTriggeringTrigger() )
            if ( Trig_E_ABTP_A_Func005Func001Func016C() ) then
                call CleanUpItems_Alliance( udg_ItemTypeCheck )
                call DisableTrigger( gg_trg_U_ABTP )
            else
            endif
            call TriggerSleepAction( 1.50 )
            call PlaySoundOnUnitBJ( gg_snd_DuskWolf, 100.00, gg_unit_n02B_0879 )
            call CreateTextTagUnitBJ( "TRIGSTR_3038", gg_unit_n02B_0879, 0.00, 8.00, 80.00, 10.00, 10.00, 0 )
            call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 10.00, 90.00 )
            call cleanUpText(1.8, 1.5)
        else
        endif
        set udg_Bag_Iterator = udg_Bag_Iterator + 1
    endloop
                       endif
endfunction

