endfunction

function Trig_Energize_Actions takes nothing returns nothing
    call BlzEndUnitAbilityCooldown( GetTriggerUnit(), 'A00V' )
    call BlzEndUnitAbilityCooldown( GetTriggerUnit(), 'AEfk' )
    call BlzEndUnitAbilityCooldown( GetTriggerUnit(), 'A00W' )
    call BlzEndUnitAbilityCooldown( GetTriggerUnit(), 'A017' )
    call BlzEndUnitAbilityCooldown( GetTriggerUnit(), 'A06M' )
