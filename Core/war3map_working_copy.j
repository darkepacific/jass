// Trigger: Blink Illusion
//===========================================================================
function Trig_Blink_Illusion_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetSummoningUnit()) == 'e02A' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Blink_Illusion_Func006C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetSummonedUnit()) == 'H02T' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Blink_Illusion_Func008Func001C takes nothing returns boolean
    if ( not ( udg_Arcane_LastCast[udg_Temp_Int] == 'A08A' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Blink_Illusion_Func008Func002C takes nothing returns boolean
    if ( not ( udg_Arcane_LastCast[udg_Temp_Int] == 'A00G' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Blink_Illusion_Func008C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A08B', udg_Temp_Unit) > 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Blink_Illusion_Actions takes nothing returns nothing
    local integer t
    set t = 0
    set udg_Temp_Unit_Point = GetUnitLoc(GetSummoningUnit())
    call SetUnitPositionLoc( GetSummonedUnit(), udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    if ( Trig_Blink_Illusion_Func006C() ) then
        set udg_Temp_Unit = udg_yH_Arcane_Mage
        set udg_Temp_Int = 1
    else
        set udg_Temp_Unit = udg_yA_Arcane_Mage
        set udg_Temp_Int = 0
    endif
    set udg_HeroStatCalc = ( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) )
    if ( Trig_Blink_Illusion_Func008C() ) then
        if ( Trig_Blink_Illusion_Func008Func001C() ) then
            set udg_Temp_Int = ( ( udg_Temp_Int * 3 ) + 2 )
            set udg_Temp_Unit_Point = GetUnitLoc(GetSummonedUnit())
            call CreateNUnitsAtLoc( 1, 'e029', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, GetUnitFacing(GetTriggerUnit()) )
            set udg_ArcaneMissiles[udg_Temp_Int] = GetLastCreatedUnit()
            call SetUnitPositionLoc( udg_ArcaneMissiles[udg_Temp_Int], udg_Temp_Unit_Point )
            call RemoveLocation (udg_Temp_Unit_Point)
            call UnitApplyTimedLifeBJ( 1.85, 'BTLF', GetLastCreatedUnit() )
            set udg_HeroStatCalc = ( 2 * udg_HeroStatCalc )
            set udg_HeroStatCalc = ( ( GetUnitAbilityLevelSwapped('A08A', udg_Temp_Unit) * 35 ) + udg_HeroStatCalc )
            call BlzSetUnitWeaponIntegerFieldBJ( GetLastCreatedUnit(), UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 0, ( BlzGetUnitBaseDamage(GetLastCreatedUnit(), 0) + udg_HeroStatCalc ) )
            call TriggerSleepAction( 0.60 )
            set t = udg_Temp_Int
            set udg_Temp_Unit_Point = GetUnitLoc(GetSummonedUnit())
            call SetUnitPositionLoc( udg_ArcaneMissiles[udg_Temp_Int], udg_Temp_Unit_Point )
            call RemoveLocation (udg_Temp_Unit_Point)
            call TriggerSleepAction( 0.60 )
            set t = udg_Temp_Int
            set udg_Temp_Unit_Point = GetUnitLoc(GetSummonedUnit())
            call SetUnitPositionLoc( udg_ArcaneMissiles[udg_Temp_Int], udg_Temp_Unit_Point )
            call RemoveLocation (udg_Temp_Unit_Point)
        else
        endif
        if ( Trig_Blink_Illusion_Func008Func002C() ) then
            set udg_Temp_Unit_Point = GetUnitLoc(GetSummonedUnit())
            call CreateNUnitsAtLoc( 1, 'e029', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, GetUnitFacing(GetTriggerUnit()) )
            call SetUnitPositionLoc( GetLastCreatedUnit(), udg_Temp_Unit_Point )
            call RemoveLocation (udg_Temp_Unit_Point)
            call UnitApplyTimedLifeBJ( 0.20, 'BTLF', GetLastCreatedUnit() )
            call SetUnitAbilityLevelSwapped( 'A08C', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A00G', udg_Temp_Unit) )
            call IssueImmediateOrderBJ( GetLastCreatedUnit(), "fanofknives" )
        else
        endif
    else
    endif
endfunction

