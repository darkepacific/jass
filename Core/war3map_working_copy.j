    call TriggerRegisterPlayerChatEvent( gg_trg_QUICKTEST, Player(5), "-qt", false )
    call TriggerRegisterPlayerChatEvent( gg_trg_QUICKTEST, Player(6), "-qt", false )
    call TriggerRegisterPlayerChatEvent( gg_trg_QUICKTEST, Player(7), "-qt", false )
