    call CameraSetupSetField( gg_cam_Hearth_DeathKnell, CAMERA_FIELD_TARGET_DISTANCE, 1650.0, 0.0 )
    call CameraSetupSetField( gg_cam_Hearth_DeathKnell, CAMERA_FIELD_ROLL, 0.0, 0.0 )
