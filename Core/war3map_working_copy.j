//===========================================================================
// Trigger: Withering Fire
//===========================================================================
function Trig_Withering_Fire_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0FD' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Withering_Fire_Actions takes nothing returns nothing
    local unit u = GetTriggerUnit()
    if ( u == udg_yA_Dark_Ranger ) then
    set udg_WitheringShots_A = 0
    call EnableTrigger( gg_trg_Withering_Fire_Tick_A)
    elseif ( u == udg_yH_Dark_Ranger ) then
    set udg_WitheringShots_H = 37
    call EnableTrigger( gg_trg_Withering_Fire_Tick_H)
    else
    endif
    call BlzSetUnitAttackCooldown( u, 13.00, 0) 
    call BlzSetUnitAttackCooldown( u, 13.00, 1) 
    call SetUnitMoveSpeed( GetTriggerUnit(), 50.00 )
    call GameTimeWait(3.0)
    call BlzSetUnitAttackCooldown( u, 2.46, 0) 
    call BlzSetUnitAttackCooldown( u, 2.13, 1) 
    call SetUnitMoveSpeed( GetTriggerUnit(), GetUnitDefaultMoveSpeed(GetTriggerUnit()) )
    set u = null
endfunction

//===========================================================================
function InitTrig_Withering_Fire takes nothing returns nothing
    set gg_trg_Withering_Fire = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Withering_Fire, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Withering_Fire, Condition( function Trig_Withering_Fire_Conditions ) )
    call TriggerAddAction( gg_trg_Withering_Fire, function Trig_Withering_Fire_Actions )
endfunction

//===========================================================================
// Trigger: Withering Fire Tick A
//
// call BlzSetSpecialEffectZ( udg_WitheringFire[udg_Temp_Int],  24.00 + BlzGetLocalSpecialEffectZ( udg_WitheringFire[udg_Temp_Int] )  )
// Localize the points
//===========================================================================
function Trig_Withering_Fire_Tick_A_Func018Func031A takes nothing returns nothing
    set udg_Temp_Unit = udg_yA_Dark_Ranger
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - 0 ))
    set udg_HeroStatCalc = ( GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, true) - 0 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    set udg_RealStatCalc = ( 25.00 + udg_RealStatCalc )
    call TriggerExecute( gg_trg_Crit_Check)
    if IsUnitTargetableEnemyHitsAll( GetEnumUnit(), udg_Temp_Unit ) then
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "war3mapImported\\Void Disc.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL )
    call HasFirelords( GetEnumUnit() )
    ////
    //nulling prevents collide multiple times
    call DestroyEffectBJ( udg_WitheringFire[GetForLoopIndexA()] )
    call BlzSetSpecialEffectAlpha( udg_WitheringFire[GetForLoopIndexA()], 0 )
    set udg_WitheringFire[  bj_forLoopAIndex ] = null
    endif
endfunction

function Trig_Withering_Fire_Tick_A_Func020Func006Func003C takes nothing returns boolean
    if ( not ( udg_WitheringShots_A >= ( ( udg_TOTAL * 2 ) + 1 ) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Withering_Fire_Tick_A_Func020Func006C takes nothing returns boolean
    if ( not ( udg_WitheringShots_A >= udg_TOTAL ) ) then
        return false
    endif
    return true
endfunction

function Trig_Withering_Fire_Tick_A_Func020C takes nothing returns boolean
    if ( not ( udg_WitheringShots_A >= udg_DIST ) ) then
        return false
    endif
    return true
endfunction

function Trig_Withering_Fire_Tick_A_Actions takes nothing returns nothing
    local integer modulo
    local integer exec =  GetTriggerExecCount(GetTriggeringTrigger())
    set udg_Temp_Unit = udg_yA_Dark_Ranger
    call TriggerExecute( gg_trg_Firelords_Helper)
    set udg_TOTAL = ( GetUnitAbilityLevelSwapped('A0FD', udg_Temp_Unit) * 9 )
    set udg_TOTAL = ( udg_TOTAL + 9 )
    if udg_TOTAL == 18 then
    set modulo = 8
    set udg_DIST = 6
    elseif udg_TOTAL == 27 then
    set modulo = 5
    set udg_DIST = 9
    else
    set modulo = 4
    set udg_DIST = 11
    endif
    set bj_forLoopAIndex = 0
    set bj_forLoopAIndexEnd = udg_TOTAL
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        //CREATE NEW
        if bj_forLoopAIndex == udg_WitheringShots_A and ModuloInteger( exec, modulo ) == 0 then
        if IsUnitAliveBJ(udg_Temp_Unit) and not IsStunned(udg_Temp_Unit) then
        if ModuloInteger( exec, 40 ) == 0 then
        call SetUnitAnimation( udg_Temp_Unit, "attack" )
        endif
        set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
        set udg_Facing_Angle = GetUnitFacing( udg_Temp_Unit)
        set udg_WitheringFireAngle[  bj_forLoopAIndex ] = udg_Facing_Angle
        set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 32.00, udg_Facing_Angle)
        call RemoveLocation (udg_Temp_Unit_Point)
        call AddSpecialEffectLocBJ( udg_Temp_Polar_Point, "war3mapImported\\Daemonic Arrow.mdx" )
        set udg_WitheringFire[GetForLoopIndexA()] = GetLastCreatedEffectBJ()
        call BlzSetSpecialEffectYaw( udg_WitheringFire[GetForLoopIndexA()], Deg2Rad(udg_Facing_Angle) )
        call BlzSetSpecialEffectZ( udg_WitheringFire[GetForLoopIndexA()], ( 32.00 + BlzGetLocalSpecialEffectZ(udg_WitheringFire[GetForLoopIndexA()]) ) )
        call RemoveLocation (udg_Temp_Polar_Point)
        endif
        set bj_forLoopAIndex = 50
        set udg_WitheringShots_A = ( udg_WitheringShots_A + 1 )
        call Debug( "Withering Shots: " + I2S(udg_WitheringShots_A) ) 
        else
        //MOVE EXISTING
        if udg_WitheringFire[  bj_forLoopAIndex ] != null then
        set udg_Temp_Unit_Point = GetSpecialEffectLoc( udg_WitheringFire[ bj_forLoopAIndex ] )
        set udg_Facing_Angle =  udg_WitheringFireAngle[  bj_forLoopAIndex ]
        set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 16.00, udg_Facing_Angle)
        call RemoveLocation (udg_Temp_Unit_Point)
        call BlzSetSpecialEffectPositionLoc( udg_WitheringFire[  bj_forLoopAIndex ], udg_Temp_Polar_Point)
        call BlzSetSpecialEffectZ( udg_WitheringFire[bj_forLoopAIndex], ( 32.00 + GetLocationZ( udg_Temp_Polar_Point) ) )
        set bj_wantDestroyGroup = true
        call ForGroupBJ( GetUnitsInRangeOfLocAll(64.00, udg_Temp_Polar_Point), function Trig_Withering_Fire_Tick_A_Func018Func031A )
        call RemoveLocation (udg_Temp_Polar_Point)
        endif
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    if ModuloInteger( exec , modulo ) == 0 then
    if ( Trig_Withering_Fire_Tick_A_Func020C() ) then
        if udg_WitheringFire[udg_WitheringShots_A - udg_DIST] != null then 
        call DestroyEffectBJ( udg_WitheringFire[( udg_WitheringShots_A - udg_DIST )] )
        call BlzSetSpecialEffectAlpha( udg_WitheringFire[( udg_WitheringShots_A - udg_DIST )], 0 )
        set udg_WitheringFire[ udg_WitheringShots_A - udg_DIST ] = null
        endif
        if ( Trig_Withering_Fire_Tick_A_Func020Func006C() ) then
            set udg_WitheringShots_A = ( udg_WitheringShots_A + 1 )
            call Debug( "Withering Shots: " + I2S(udg_WitheringShots_A) ) 
            if ( Trig_Withering_Fire_Tick_A_Func020Func006Func003C() ) then
                set bj_forLoopAIndex = 0
                set bj_forLoopAIndexEnd = udg_TOTAL
                loop
                    exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
                    call DestroyEffectBJ( udg_WitheringFire[( udg_WitheringShots_A - udg_DIST )] )
                    call BlzSetSpecialEffectAlpha( udg_WitheringFire[( udg_WitheringShots_A - udg_DIST )], 0 )
                    set udg_WitheringFire[  bj_forLoopAIndex ] = null
                    set bj_forLoopAIndex = bj_forLoopAIndex + 1
                endloop
                call Debug( "DIST: " + I2S(udg_DIST) ) 
                call Debug( "Total: " + I2S(udg_TOTAL) ) 
                call DisableTrigger( GetTriggeringTrigger() )
            else
            endif
        else
        endif
    else
    endif
    endif
endfunction

//===========================================================================
function InitTrig_Withering_Fire_Tick_A takes nothing returns nothing
    set gg_trg_Withering_Fire_Tick_A = CreateTrigger(  )
    call DisableTrigger( gg_trg_Withering_Fire_Tick_A )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Withering_Fire_Tick_A, 0.02 )
    call TriggerAddAction( gg_trg_Withering_Fire_Tick_A, function Trig_Withering_Fire_Tick_A_Actions )
endfunction

