//===========================================================================
function Trig_Hellfire_Tick_OR_Func026Func003C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetEnumUnit(), 'B00U') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hellfire_Tick_OR_Func026A takes nothing returns nothing
    if IsUnitTargetableEnemy( GetEnumUnit(), udg_Temp_Unit ) then
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    if ( Trig_Hellfire_Tick_OR_Func026Func003C() ) then
        set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A099', udg_Temp_Unit) * 25 )
        call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "Abilities\\Weapons\\DemolisherFireMissile\\DemolisherFireMissile.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), ( ( I2R(udg_HeroStatCalc) + udg_Temp_Real ) / 2.00 ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    else
    endif
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_Hellfire_Tick_OR_Actions takes nothing returns nothing
    set udg_Temp_Unit = udg_yH_Destro_Warlock
    call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "war3mapImported\\Firebolt Rough Major.mdx" )
    call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 1.00 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call Speedbonus( udg_Temp_Unit, 0.25, 1.25)
    call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A0EA', udg_Temp_Unit) * 100 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 100 )
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 1.50 * udg_RealStatCalc )
    // Used for Immolate
    set udg_Temp_Real = udg_RealStatCalc
    // Combine
    set udg_RealStatCalc = ( 2.40 * udg_RealStatCalc )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    set bj_wantDestroyGroup = true
    set udg_Temp_Unit_Point = GetUnitLoc( udg_Temp_Unit)
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Damnation Orange.mdx" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 1.33 )
    call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 1.66 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Conflagrate.mdx" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 1.33 )
    call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 2.70 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call ForGroupBJ( GetUnitsInRangeOfLocAll(( 300.00 + ( 10.00 * I2R(GetUnitAbilityLevelSwapped('A0EA', udg_Temp_Unit)) ) ), udg_Temp_Unit_Point), function Trig_Hellfire_Tick_OR_Func026A )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A0EA', udg_Temp_Unit) * 50 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 50 )
    call UnitDamageTargetBJ( udg_Temp_Unit, udg_Temp_Unit, I2R(udg_HeroStatCalc), ATTACK_TYPE_HERO, DAMAGE_TYPE_UNIVERSAL )
endfunction

