function Trig_AoE_Channel_Tick_Actions takes nothing returns nothing
    local effect eff
    local location Target
    set udg_Temp_Unit_Point = GetSpellTargetLoc()
    set Target = udg_Temp_Unit_Point
    set udg_NelfarionChannel = true
    // effect and dmg
    if udg_NelfarionChannel == true then
    set udg_Temp_Unit = gg_unit_E033_1368
    call StopSoundBJ( gg_snd_Event_DeathwingAttacks_Roar_03, false )
    call PlaySoundOnUnitBJ( gg_snd_Event_DeathwingAttacks_Roar_03, 100.00, udg_Temp_Unit )
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 300.00, GetUnitFacing(GetTriggerUnit()))
    call AddSpecialEffectLocBJ( udg_Temp_Polar_Point, "Abilities\\Spells\\Other\\BreathOfFire\\BreathOfFireMissile.mdl" )
    call RemoveLocation (udg_Temp_Polar_Point)
    call RemoveLocation (udg_Temp_Unit_Point)
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), ( 175.00 + BlzGetLocalUnitZ(GetTriggerUnit()) ) )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 1.25 )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), ( 1.00 * Deg2Rad(GetUnitFacing(GetTriggerUnit())) ), 0.90, 0.0 )
    set eff = GetLastCreatedEffectBJ()
    set udg_Temp_Unit_Point = Target
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(375.00, udg_Temp_Unit_Point), function Trig_AoE_Channel_Tick_Func022A )
    call TriggerSleepAction( 0.80 )
    call DestroyEffectBJ( eff )
    endif
    // effect and dmg
    if udg_NelfarionChannel == true then
    set udg_Temp_Unit = gg_unit_E033_1368
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 300.00, GetUnitFacing(GetTriggerUnit()))
    call AddSpecialEffectLocBJ( udg_Temp_Polar_Point, "Abilities\\Spells\\Other\\BreathOfFire\\BreathOfFireMissile.mdl" )
    call RemoveLocation (udg_Temp_Polar_Point)
    call RemoveLocation (udg_Temp_Unit_Point)
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), ( 175.00 + BlzGetLocalUnitZ(GetTriggerUnit()) ) )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 1.25 )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), ( 1.00 * Deg2Rad(GetUnitFacing(GetTriggerUnit())) ), 0.90, 0.0 )
    set eff = GetLastCreatedEffectBJ()
    set udg_Temp_Unit_Point = Target
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(375.00, udg_Temp_Unit_Point), function Trig_AoE_Channel_Tick_Func041A )
    call TriggerSleepAction( 0.80 )
    call DestroyEffectBJ( eff )
    endif
    // effect and dmg
    if udg_NelfarionChannel == true then
    set udg_Temp_Unit = gg_unit_E033_1368
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 300.00, GetUnitFacing(GetTriggerUnit()))
    call AddSpecialEffectLocBJ( udg_Temp_Polar_Point, "Abilities\\Spells\\Other\\BreathOfFire\\BreathOfFireMissile.mdl" )
    call RemoveLocation (udg_Temp_Polar_Point)
    call RemoveLocation (udg_Temp_Unit_Point)
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), ( 175.00 + BlzGetLocalUnitZ(GetTriggerUnit()) ) )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 1.25 )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), ( 1.00 * Deg2Rad(GetUnitFacing(GetTriggerUnit())) ), 0.90, 0.0 )
    set eff = GetLastCreatedEffectBJ()
    set udg_Temp_Unit_Point = Target
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(375.00, udg_Temp_Unit_Point), function Trig_AoE_Channel_Tick_Func060A )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 0.80 )
    call DestroyEffectBJ( eff )
    endif
    set eff = null
    set Target = null
endfunction

