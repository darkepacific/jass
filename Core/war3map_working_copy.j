function Trig_E_MMT_Func016Func001C takes nothing returns boolean
    if ( not ( udg_Player_Music[GetForLoopIndexA()] == "CannonMusic" ) ) then
        return false
    endif
    return true
endfunction

function Trig_E_MMT_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 125
    if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
    call FlashQuestDialogButtonBJ(  )
    endif
    call QuestSetCompletedBJ( udg_Quests[125], true )
    call QuestItemSetCompletedBJ( udg_QuestReqs[125], true )
    call DestroyMinimapIcon( udg_MiniMapIcon[125] )
    set udg_TempString = "Murloc Me Timbers!"
    // Rewards
    set udg_Gold = udg_QUEST_GOLD[udg_Temp_Int]
    set udg_XP = udg_QUEST_XP[udg_Temp_Int]
    set udg_LVL_Req = udg_QUEST_LVL_REQ[udg_Temp_Int]
    call TriggerExecute( gg_trg_Quest_Complete_A )
    // End Music
    set bj_forLoopAIndex = 4
    set bj_forLoopAIndexEnd = 7
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_E_MMT_Func016Func001C() ) then
            if GetLocalPlayer() == GetOwningPlayer(udg_Heroes[bj_forLoopAIndex]) then
            call ClearMapMusicBJ(  )
            call StopMusicBJ( true )
            endif
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    call DisableTrigger(gg_trg_U_MMT)
    call DisableTrigger(gg_trg_H_MMT)
    call DisableTrigger(gg_trg_Cannon_Dies)
    call DisableTrigger(gg_trg_Cannon_Clicked)
    call DisableTrigger( GetTriggeringTrigger() )
endfunction

