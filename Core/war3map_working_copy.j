function Trig_U_WOgres_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    set udg_QuestWOgres = ( udg_QuestWOgres + 1 )
    call QuestItemSetDescriptionBJ( udg_QuestReqs[16], ( "Ogre Magi Slain - " + ( I2S(R2I(udg_QuestMOgres)) + ( "/4" + ( "|n- Ogre Warrior Slain - " + ( I2S(R2I(udg_QuestWOgres)) + "/4" ) ) ) ) ) )
    // FT Gen
    set udg_TempString = GetUnitName(GetTriggerUnit())
    call QuestUnitSlain( GetTriggerUnit())
    // End FT Gen
    if ( Trig_U_WOgres_Func009C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        if ( Trig_U_WOgres_Func009Func002C() ) then
            call DestroyMinimapIcon( udg_MiniMapIcon[16] )
            set udg_Temp_Unit_Point = GetRectCenter(gg_rct_MOgres)
            call CampaignMinimapIconLocBJ( udg_Temp_Unit_Point, bj_CAMPPINGSTYLE_CONTROL_NEUTRAL )
            call RemoveLocation (udg_Temp_Unit_Point)
            set udg_MiniMapIcon[16] = GetLastCreatedMinimapIcon()
            if ( GetLocalPlayer() == Player(4) or GetLocalPlayer() == Player(5) or GetLocalPlayer() == Player(6) or GetLocalPlayer() == Player(10) )then
            call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), false )
            endif
        else
        endif
    else
    endif
    set udg_Temp_Unit_Point = null
endfunction

