//===========================================================================
// Trigger: E Find Timmy A
//===========================================================================
function Trig_E_Find_Timmy_A_Func006C takes nothing returns boolean
    if ( not ( GetRandomInt(2, 6) < udg_QuestTimmyAttempts ) ) then
        return false
    endif
    return true
endfunction

function Trig_E_Find_Timmy_A_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 62
    local unit Timmy
    local destructable cage = GetDyingDestructable()
    local location udg_Temp_Unit_Point
    local location udg_Temp_Polar_Point
    if ( Trig_E_Find_Timmy_A_Func006C() ) then
        call DestroyEffectBJ( udg_QuestMarks[62] )
        if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
        call FlashQuestDialogButtonBJ(  )
        endif
        call QuestItemSetCompletedBJ( udg_QuestReqs[62], true )
        call QuestSetCompletedBJ( udg_Quests[62], true )
        // Rewards
        set udg_XP = udg_QUEST_XP[udg_Temp_Int]
        set udg_Gold = udg_QUEST_GOLD[udg_Temp_Int]
        set udg_LVL_Req = udg_QUEST_LVL_REQ[udg_Temp_Int]
        set udg_TempString = "Find Timmy"
        call TriggerExecute( gg_trg_Quest_Complete_A )
        call DisableTrigger( GetTriggeringTrigger() )
        set udg_Temp_Polar_Point = GetUnitLoc(gg_unit_n03J_1824)
        set udg_Temp_Unit_Point = GetDestructableLoc(GetDyingDestructable())
        call CreateNUnitsAtLocFacingLocBJ( 1, 'n03K', Player(11), udg_Temp_Unit_Point, udg_Temp_Polar_Point )
        set Timmy = GetLastCreatedUnit()
        call RemoveLocation (udg_Temp_Unit_Point)
        call RemoveLocation (udg_Temp_Polar_Point)
         call CreateTextTagUnitBJ( "Mommy! Mommy!", Timmy, 0.00, 8.00, 100.00, 100.00, 0.00, 0 )
        call ShowTextTagForceBJ( false, GetLastCreatedTextTag(), GetPlayersAll() )
        call ShowTextTagForceBJ( true, GetLastCreatedTextTag(), udg_AlliancePlayers )
        call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
        call cleanUpText(1.2, 0.8)
        call TriggerSleepAction( 1.00 )
        set udg_Temp_Polar_Point = GetUnitLoc(gg_unit_n03J_1824)
        call IssuePointOrderLocBJ(Timmy, "move", udg_Temp_Polar_Point )
        call RemoveLocation (udg_Temp_Polar_Point)
        call TriggerSleepAction( 5.00 )
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Timmy)
         call SetUnitPositionLocFacingBJ( Timmy, udg_Temp_Unit_Point, 225.74 )
        call RemoveLocation (udg_Temp_Unit_Point)
    else
        set udg_QuestTimmyAttempts = ( udg_QuestTimmyAttempts + 1 )
        call TriggerSleepAction( 60.00 )
        call DestructableRestoreLife( cage, 50.00, false )
    endif
    set Timmy = null
    set cage = null
    set udg_Temp_Unit_Point = null
    set udg_Temp_Polar_Point = null
endfunction

//===========================================================================
function InitTrig_E_Find_Timmy_A takes nothing returns nothing
    set gg_trg_E_Find_Timmy_A = CreateTrigger(  )
    call DisableTrigger( gg_trg_E_Find_Timmy_A )
    call TriggerRegisterDestDeathInRegionEvent( gg_trg_E_Find_Timmy_A, gg_rct_QTimmyCages1 )
    call TriggerRegisterDestDeathInRegionEvent( gg_trg_E_Find_Timmy_A, gg_rct_QTimmyCages2 )
    call TriggerRegisterDestDeathInRegionEvent( gg_trg_E_Find_Timmy_A, gg_rct_QTimmyCages3 )
    call TriggerRegisterDestDeathInRegionEvent( gg_trg_E_Find_Timmy_A, gg_rct_QTimmyCages4 )
    call TriggerRegisterDestDeathInRegionEvent( gg_trg_E_Find_Timmy_A, gg_rct_QTimmyCages5 )
    call TriggerRegisterDestDeathInRegionEvent( gg_trg_E_Find_Timmy_A, gg_rct_QTimmyCages6 )
    call TriggerAddAction( gg_trg_E_Find_Timmy_A, function Trig_E_Find_Timmy_A_Actions )
endfunction

