//===========================================================================
// Trigger: RIP Effect
//===========================================================================
function Trig_RIP_Effect_Func017C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A046' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0BD' ) ) then
        return true
    endif
    return false
endfunction

function Trig_RIP_Effect_Conditions takes nothing returns boolean
    if ( not Trig_RIP_Effect_Func017C() ) then
        return false
    endif
    return true
endfunction

function Trig_RIP_Effect_Actions takes nothing returns nothing
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Reapers Claws Red.mdx" )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), Deg2Rad(GetUnitFacing(GetTriggerUnit())), 0.0, 0.00 )
    call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 2.50 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Reapers Claws Red.mdx" )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), Deg2Rad(GetUnitFacing(GetTriggerUnit())), 0.0, Rad2Deg(45.00) )
    call BlzSetSpecialEffectHeight( GetLastCreatedEffectBJ(), ( 45.00 + BlzGetLocalUnitZ(GetTriggerUnit()) ) )
    call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 2.00 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Reapers Claws Red.mdx" )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), Deg2Rad(GetUnitFacing(GetTriggerUnit())), 0.0, Rad2Deg(135.00) )
    call BlzSetSpecialEffectHeight( GetLastCreatedEffectBJ(), ( 45.00 + BlzGetLocalUnitZ(GetTriggerUnit()) ) )
    call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 2.00 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call RemoveLocation (udg_Temp_Unit_Point)
endfunction

