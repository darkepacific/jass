        set udg_AzurelodeAlliance[1] = ( udg_AzurelodeAlliance[1] + 1 )
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Azurelode_Matriarch)
        call CreateNUnitsAtLoc( 1, 'h011', Player(1), udg_Temp_Unit_Point, 219.00 )
        call RemoveLocation (udg_Temp_Unit_Point)
        if ( Trig_Foreman_Bonds_Dies_Func005Func005C() ) then
            call DestroyEffectBJ( udg_QuestMarks[13] )
            set udg_TempString = ""
            if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
            set udg_TempString = udg_ExclamationMark
            endif
            call AddSpecialEffectTargetUnitBJ( "overhead", GetLastCreatedUnit(), udg_TempString )
            set udg_QuestMarks[13] = GetLastCreatedEffectBJ()
