    if ( Trig_Knucklerot_Wander_Func002C() ) then
        set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_Z_Deadscar_Ghostlands_North)
        call IssuePointOrderLocBJ( udg_Knucklerot, "attack", udg_Temp_Unit_Point )
        call RemoveLocation (udg_Temp_Unit_Point)
    else
        if ( Trig_Knucklerot_Wander_Func002Func002C() ) then
            set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_Ghostland_Gnolls_South)
            call IssuePointOrderLocBJ( udg_Knucklerot, "attack", udg_Temp_Unit_Point )
