function Trig_Durnholde_Keep_Actions takes nothing returns nothing
    // Alliance Capture
    if ( Trig_Durnholde_Keep_Func002C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        call EnableTrigger( gg_trg_Durhholde_Keep_Leave )
        set udg_TowerHeroes[6] = GetEnteringUnit()
        call QuestMessageBJ( GetPlayersAllies(GetOwningPlayer(GetTriggerUnit())), bj_QUESTMESSAGE_ALWAYSHINT, "TRIGSTR_694" )
        call StartTimerBJ( udg_TowerTimers[6], false, 20.00 )
        call CreateTimerDialogBJ( udg_TowerTimers[6], "TRIGSTR_695" )
        set udg_TowerWindows[6] = GetLastCreatedTimerDialogBJ()
        call TimerDialogDisplayBJ( false, udg_TowerWindows[6] )
        call ForForce( udg_AlliancePlayers, function Trig_Durnholde_Keep_Func002Func009A )
    else
    endif
    // Horde Capture
    if ( Trig_Durnholde_Keep_Func004C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        call EnableTrigger( gg_trg_Durhholde_Keep_Leave )
        set udg_TowerHeroes[6] = GetEnteringUnit()
        call QuestMessageBJ( GetPlayersAllies(GetOwningPlayer(GetTriggerUnit())), bj_QUESTMESSAGE_ALWAYSHINT, "TRIGSTR_712" )
        call StartTimerBJ( udg_TowerTimers[6], false, 20.00 )
        call CreateTimerDialogBJ( udg_TowerTimers[6], "TRIGSTR_697" )
        set udg_TowerWindows[6] = GetLastCreatedTimerDialogBJ()
        call TimerDialogDisplayBJ( false, udg_TowerWindows[6] )
        call ForForce( udg_HordePlayers, function Trig_Durnholde_Keep_Func004Func009A )
    else
    endif
endfunction

