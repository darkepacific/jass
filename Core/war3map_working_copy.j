//===========================================================================
// Trigger: NER ComboGen
//===========================================================================
function Trig_NER_ComboGen_Func003Func003C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A00W' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A04S' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A06M' ) ) then
        return true
    endif
    return false
endfunction

function Trig_NER_ComboGen_Func003C takes nothing returns boolean
    if ( not ( GetSpellAbilityUnit() == udg_yA_Subtle_Rogue ) ) then
        return false
    endif
    if ( not ( udg_NEREviscerate == true ) ) then
        return false
    endif
    if ( not Trig_NER_ComboGen_Func003Func003C() ) then
        return false
    endif
    return true
endfunction

function Trig_NER_ComboGen_Conditions takes nothing returns boolean
    if ( not Trig_NER_ComboGen_Func003C() ) then
        return false
    endif
    return true
endfunction

function Trig_NER_ComboGen_Func004C takes nothing returns boolean
    if ( not ( udg_NERComboPoints == 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_NER_ComboGen_Func005C takes nothing returns boolean
    if ( not ( udg_NERComboPoints == 1.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_NER_ComboGen_Func006C takes nothing returns boolean
    if ( not ( udg_NERComboPoints == 2.00 ) ) then
        return false
    endif
    return true
