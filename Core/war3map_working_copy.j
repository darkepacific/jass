function Trig_Crusaders_Tower_Capture_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 11
    // Alliance Capture
    if ( Trig_Crusaders_Tower_Capture_Func003C() ) then
        call DestroyTimerDialogBJ( udg_TowerWindows[udg_Temp_Int] )
        call DisableTrigger (gg_trg_Crusaders_Tower_Leave)
        call FactionPointCapture( gg_unit_ncop_0327, Player(1), "Crusader's Tower")
        set bj_wantDestroyGroup = true
        call ForGroupBJ( GetUnitsInRectAll(gg_rct_Crusaders_Tower_Capture), function Trig_Crusaders_Tower_Capture_Func003Func007A )
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Crusaders_Tower_Guard_1)
        call CreateNUnitsAtLoc( 1, 'hfoo', Player(1), udg_Temp_Unit_Point, 235.00 )
        call RemoveLocation (udg_Temp_Unit_Point)
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Crusaders_Tower_Guard_2)
        call CreateNUnitsAtLoc( 1, 'hfoo', Player(1), udg_Temp_Unit_Point, 235.00 )
        call RemoveLocation (udg_Temp_Unit_Point)
    else
    endif
    // Horde Capture
    if ( Trig_Crusaders_Tower_Capture_Func005C() ) then
        call DestroyTimerDialogBJ( udg_TowerWindows[udg_Temp_Int] )
        call DisableTrigger (gg_trg_Crusaders_Tower_Leave)
        call FactionPointCapture( gg_unit_ncop_0327, Player(0), "Crusader's Tower")
        set bj_wantDestroyGroup = true
        call ForGroupBJ( GetUnitsInRectAll(gg_rct_Crusaders_Tower_Capture), function Trig_Crusaders_Tower_Capture_Func005Func007A )
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Crusaders_Tower_Guard_1)
        call CreateNUnitsAtLoc( 1, 'hspt', Player(0), udg_Temp_Unit_Point, 280.00 )
        call RemoveLocation (udg_Temp_Unit_Point)
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Crusaders_Tower_Guard_2)
        call CreateNUnitsAtLoc( 1, 'hspt', Player(0), udg_Temp_Unit_Point, 280.00 )
        call RemoveLocation (udg_Temp_Unit_Point)
    else
    endif
    call EnableTrigger( gg_trg_Crusaders_Tower)
endfunction

