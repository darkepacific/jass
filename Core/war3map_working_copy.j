function InitTrig_Killrog takes nothing returns nothing
    set gg_trg_Killrog = CreateTrigger(  )
    call TriggerRegisterUnitEvent( gg_trg_Killrog, gg_unit_O005_1045, EVENT_UNIT_DEATH )
    call TriggerAddAction( gg_trg_Killrog, function Trig_Killrog_Actions )
endfunction

