    if ( not ( udg_QuestGWG == 8.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_E_GWG_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 112
    local location udg_Temp_Unit_Point
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    call CreateTextTagLocBJ( "TRIGSTR_9955", udg_Temp_Unit_Point, 0, 10, 85.00, 100, 75.00, 0 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
    call cleanUpText( 0.75, 0.5 )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_QuestGWG = ( udg_QuestGWG + 1 )
    call QuestItemSetDescriptionBJ( udg_QuestReqs[112], ( "Ents grown for the Greenwarden - " + ( I2S(R2I(udg_QuestGWG)) + "/8" ) ) )
    call SetUnitOwner( GetTriggerUnit(), Player(1), true )
    if ( Trig_E_GWG_Func011C() ) then
        if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
        call FlashQuestDialogButtonBJ(  )
        endif
        call QuestSetCompletedBJ( udg_Quests[112], true )
        call QuestItemSetCompletedBJ( udg_QuestReqs[112], true )
        call DestroyMinimapIcon( udg_MiniMapIcon[112] )
        call DestroyEffectBJ( udg_QuestMarks[112] )
        // Clean Up Items
        set udg_ItemTypeCheck = 'I08S'
        call CleanUpItems( udg_ItemTypeCheck )
        // Rewards
        set udg_XP = udg_QUEST_XP[udg_Temp_Int]
        set udg_Gold = udg_QUEST_GOLD[udg_Temp_Int]
        set udg_LVL_Req = udg_QUEST_LVL_REQ[udg_Temp_Int]
        set udg_TempString = "The Greenwarden's Grove"
        call TriggerExecute( gg_trg_Quest_Complete_A )
        call DisableTrigger( gg_trg_U_GWG_Start)
        call DisableTrigger( gg_trg_U_GWG_Begin)
        call DisableTrigger( gg_trg_H_GWG)
        call DisableTrigger( gg_trg_L_GWG)
        call TriggerSleepAction( 30.00 )
        call DisableTrigger( GetTriggeringTrigger() )
        call DisableTrigger( gg_trg_U_GWG_Finish)
    else
    endif
    set udg_Temp_Unit_Point = null
endfunction

