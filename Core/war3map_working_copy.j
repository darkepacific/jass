    set gg_trg_Land = CreateTrigger(  )
    call DisableTrigger( gg_trg_Land )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Land, 2.50 )
    call TriggerAddAction( gg_trg_Land, function Trig_Land_Actions )
endfunction

//===========================================================================
// Trigger: DW SHIELD
//===========================================================================
function Trig_DW_SHIELD_Func002Func003C takes nothing returns boolean
    if ( not ( udg_SHIELD[0] <= 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_DW_SHIELD_Func002C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetTriggerUnit(), 'B00X') == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_DW_SHIELD_Actions takes nothing returns nothing
    local unit udg_Temp_Unit
    if ( Trig_DW_SHIELD_Func002C() ) then
        set udg_SHIELD[0] = 0.00
        call DisableTrigger( GetTriggeringTrigger() )
    else
        set udg_SHIELD[0] = ( udg_SHIELD[0] - GetEventDamage() )
        set udg_Temp_Unit = gg_unit_E033_1368
        if ( Trig_DW_SHIELD_Func002Func003C() ) then
            call BlzSetEventDamage( ( -1.00 * udg_SHIELD[0] ) )
            call UnitRemoveBuffBJ( 'B00X', GetTriggerUnit() )
            call DisableTrigger( GetTriggeringTrigger() )
        else
            call BlzSetEventDamage( 0.00 )
            call AddSpecialEffectTargetUnitBJ( "overhead", udg_Temp_Unit, "war3mapImported\\Effect_ShieldBuff_Red.mdx" )
            call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 1.02 )
            call DestroyEffectBJ( GetLastCreatedEffectBJ() )
            call PlaySoundOnUnitBJ( gg_snd_DefendCaster, 100.00, udg_Temp_Unit )
            call UnitRemoveBuffsBJ( bj_REMOVEBUFFS_NEGATIVE, udg_Temp_Unit )
        endif
    endif
    set udg_Temp_Unit = null
endfunction

//===========================================================================
function InitTrig_DW_SHIELD takes nothing returns nothing
    set gg_trg_DW_SHIELD = CreateTrigger(  )
    call DisableTrigger( gg_trg_DW_SHIELD )
    call TriggerRegisterUnitEvent( gg_trg_DW_SHIELD, gg_unit_E033_1368, EVENT_UNIT_DAMAGED )
    call TriggerAddAction( gg_trg_DW_SHIELD, function Trig_DW_SHIELD_Actions )
endfunction

