    return true
endfunction

function Trig_Sap_Periodic_Check_Actions takes nothing returns nothing
    // Ass A
    if ( UnitHasBuffBJ(udg_yA_Ass_Rogue, 'B001') == false ) then
    call SetPlayerAbilityAvailableBJ( true, 'A0AN', GetOwningPlayer(udg_yA_Ass_Rogue) )
    call SetPlayerAbilityAvailableBJ( false, 'A04S', GetOwningPlayer(udg_yA_Ass_Rogue) )
    call DisableTrigger( gg_trg_A_Sap_Ability_Cast)
    else
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_yA_Ass_Rogue)) * udg_NUM_OF_TC + 12 ] then 
    if ( Trig_Sap_Periodic_Check_Func008C() ) then
        set udg_Temp_Unit = udg_yA_Ass_Rogue
                            if GetUnitLifePercent(udg_Temp_Unit) < 100.00 or GetUnitManaPercent(udg_Temp_Unit) < 100.00 then
        if ChaliceCheck() then
        call MaxHPSelfHeal( 0.015)
        call MaxManaRestore( 0.015, udg_Temp_Unit)
        else
        call MaxHPSelfHeal( 0.0125)
        call MaxManaRestore( 0.0125, udg_Temp_Unit)
        endif
        call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "war3mapImported\\Ember Purple.mdx" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        if ( Trig_Sap_Periodic_Check_Func008Func012C() ) then
            call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "Abilities\\Spells\\Undead\\DarkRitual\\DarkRitualCaster.mdl" )
            call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        else
            call AddSpecialEffectTargetUnitBJ( "chest", udg_Temp_Unit, "war3mapImported\\Ember Purple.mdx" )
            call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        endif
        endif
    else
    endif
    endif
    endif
    // Ass H
    if ( Trig_Sap_Periodic_Check_Func012C() ) then
        call SetPlayerAbilityAvailableBJ( true, 'A0AN', GetOwningPlayer(udg_yH_Ass_Rogue) )
        call SetPlayerAbilityAvailableBJ( false, 'A04S', GetOwningPlayer(udg_yH_Ass_Rogue) )
        call DisableTrigger( gg_trg_H_Sap_Ability_Cast)
    else
        if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_yH_Ass_Rogue)) * udg_NUM_OF_TC + 12 ] then 
        if ( Trig_Sap_Periodic_Check_Func012Func002C() ) then
            set udg_Temp_Unit = udg_yH_Ass_Rogue
                                if GetUnitLifePercent(udg_Temp_Unit) < 100.00 or GetUnitManaPercent(udg_Temp_Unit) < 100.00 then
            if ChaliceCheck() then
            call MaxHPSelfHeal( 0.015)
            call MaxManaRestore( 0.015, udg_Temp_Unit)
            else
            call MaxHPSelfHeal( 0.0125)
            call MaxManaRestore( 0.0125, udg_Temp_Unit)
            endif
            call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "war3mapImported\\Ember Purple.mdx" )
            call DestroyEffectBJ( GetLastCreatedEffectBJ() )
            if ( Trig_Sap_Periodic_Check_Func012Func002Func012C() ) then
                call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "Abilities\\Spells\\Undead\\DarkRitual\\DarkRitualCaster.mdl" )
                call DestroyEffectBJ( GetLastCreatedEffectBJ() )
            else
                call AddSpecialEffectTargetUnitBJ( "chest", udg_Temp_Unit, "war3mapImported\\Ember Purple.mdx" )
                call DestroyEffectBJ( GetLastCreatedEffectBJ() )
            endif
            endif
        else
        endif
        endif
    endif
    // Subtle A
    //      -- Not Stealthed
    if ( UnitHasBuffBJ(udg_yA_Subtle_Rogue, 'B001') == false ) then
    call SetPlayerAbilityAvailableBJ( true, 'AEfk', GetOwningPlayer(udg_yA_Subtle_Rogue) )
    call SetPlayerAbilityAvailableBJ( true, 'A00W', GetOwningPlayer(udg_yA_Subtle_Rogue) )
    call SetPlayerAbilityAvailableBJ( false, 'A04S', GetOwningPlayer(udg_yA_Subtle_Rogue) )
    call SetPlayerAbilityAvailableBJ( false, 'A0EU', GetOwningPlayer(udg_yA_Subtle_Rogue) )
    call DisableTrigger( gg_trg_As_Sap_Ability_Cast)
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_yA_Subtle_Rogue)) * udg_NUM_OF_TC + 14 ] then 
    call GameTimeWait(2.05)
    if ( UnitHasBuffBJ(udg_yA_Subtle_Rogue, 'B001') == false ) then
    call UnitRemoveAbility(udg_yA_Subtle_Rogue, 'ACes')
    endif
    endif
    //      -- Stealthed
    else
    //      --  -- Veil of Midnight
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_yA_Subtle_Rogue)) * udg_NUM_OF_TC + 14 ] then 
    call UnitAddAbility(udg_yA_Subtle_Rogue, 'ACes')
    else
    call UnitRemoveAbility(udg_yA_Subtle_Rogue, 'ACes')
    endif
    //      --  -- Soothing Darkness
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_yA_Subtle_Rogue)) * udg_NUM_OF_TC + 13 ] then 
    if ( Trig_Sap_Periodic_Check_Func037C() ) then
        set udg_Temp_Unit = udg_yA_Subtle_Rogue
                            if GetUnitLifePercent(udg_Temp_Unit) < 100.00 or GetUnitManaPercent(udg_Temp_Unit) < 100.00 then
        if ChaliceCheck() then
        call MaxHPSelfHeal( 0.015)
        call MaxManaRestore( 0.015, udg_Temp_Unit)
        else
        call MaxHPSelfHeal( 0.0125)
        call MaxManaRestore( 0.0125, udg_Temp_Unit)
        endif
        call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "war3mapImported\\Ember Purple.mdx" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        if ( Trig_Sap_Periodic_Check_Func037Func012C() ) then
            call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "Abilities\\Spells\\Undead\\DarkRitual\\DarkRitualCaster.mdl" )
            call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        else
            call AddSpecialEffectTargetUnitBJ( "chest", udg_Temp_Unit, "war3mapImported\\Ember Purple.mdx" )
            call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        endif
        endif
    else
    endif
    endif
    endif
    // Subtle H
    //      -- Not Stealthed
    if ( UnitHasBuffBJ(udg_yH_Subtle_Rogue, 'B001') == false ) then
    call SetPlayerAbilityAvailableBJ( true, 'AEfk', GetOwningPlayer(udg_yH_Subtle_Rogue) )
    call SetPlayerAbilityAvailableBJ( true, 'A00W', GetOwningPlayer(udg_yH_Subtle_Rogue) )
    call SetPlayerAbilityAvailableBJ( false, 'A04S', GetOwningPlayer(udg_yH_Subtle_Rogue) )
    call SetPlayerAbilityAvailableBJ( false, 'A0EU', GetOwningPlayer(udg_yH_Subtle_Rogue) )
    call DisableTrigger( gg_trg_Hs_Sap_Ability_Cast)
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_yH_Subtle_Rogue)) * udg_NUM_OF_TC + 14 ] then 
    call GameTimeWait(2.05)
    if ( UnitHasBuffBJ(udg_yH_Subtle_Rogue, 'B001') == false ) then
    call UnitRemoveAbility(udg_yH_Subtle_Rogue, 'ACes')
    endif
    endif
    //      -- Stealthed
    else
    //      --  -- Veil of Midnight
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_yH_Subtle_Rogue)) * udg_NUM_OF_TC + 14 ] then 
    call UnitAddAbility(udg_yH_Subtle_Rogue, 'ACes')
    else
    call UnitRemoveAbility(udg_yH_Subtle_Rogue, 'ACes')
    endif
    //      --  -- Soothing Darkness
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_yH_Subtle_Rogue)) * udg_NUM_OF_TC + 13 ] then 
    if ( Trig_Sap_Periodic_Check_Func064C() ) then
        set udg_Temp_Unit = udg_yH_Subtle_Rogue
                            if GetUnitLifePercent(udg_Temp_Unit) < 100.00 or GetUnitManaPercent(udg_Temp_Unit) < 100.00 then
        if ChaliceCheck() then
        call MaxHPSelfHeal( 0.015)
        call MaxManaRestore( 0.015, udg_Temp_Unit)
        else
        call MaxHPSelfHeal( 0.0125)
        call MaxManaRestore( 0.0125, udg_Temp_Unit)
        endif
        call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "war3mapImported\\Ember Purple.mdx" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        if ( Trig_Sap_Periodic_Check_Func064Func012C() ) then
            call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "Abilities\\Spells\\Undead\\DarkRitual\\DarkRitualCaster.mdl" )
            call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        else
            call AddSpecialEffectTargetUnitBJ( "chest", udg_Temp_Unit, "war3mapImported\\Ember Purple.mdx" )
            call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        endif
        endif
    else
    endif
    endif
    endif
    if ( UnitHasBuffBJ(udg_yA_Ass_Rogue, 'B001') == false ) and ( UnitHasBuffBJ(udg_yH_Ass_Rogue, 'B001') == false )  then
    if ( UnitHasBuffBJ(udg_yA_Subtle_Rogue, 'B001') == false ) and ( UnitHasBuffBJ(udg_yH_Subtle_Rogue, 'B001') == false )  then
    call DisableTrigger( gg_trg_Sap_Periodic_Check)
    endif
    endif
    return
    call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_6140" )
endfunction

