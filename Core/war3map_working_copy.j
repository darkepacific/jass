function Trig_Cloak_of_Shadows_Press_F_Actions takes nothing returns nothing
    local unit udg_Temp_Unit
    call Debug("Subtle Rogue pressed F")
    if ( Trig_Cloak_of_Shadows_Press_F_Func003C() ) then
        set udg_Temp_Unit = udg_yA_Subtle_Rogue
    else
        set udg_Temp_Unit = udg_yH_Subtle_Rogue
    endif
    if BlzGetUnitAbilityCooldownRemaining(udg_Temp_Unit, 'A0EX') == 0.0 and GetUnitAbilityLevel(udg_Temp_Unit, 'A0EX') > 0 then
    call Debug("Cloak of Shadows off cd")
    call UnitRemoveBuffsBJ(1, udg_Temp_Unit)
    endif
    set udg_Temp_Unit = null
endfunction

