function Trig_Breath_of_Sindragosa_Func046Func014A takes nothing returns nothing
    if IsUnitTargetableEnemy( GetEnumUnit(), udg_Temp_Unit ) then
     if ( UnitHasBuffBJ( GetEnumUnit(), 'BCbf') ) then
    call HasFirelords( GetEnumUnit() )
    endif
    endif
endfunction

function Trig_Breath_of_Sindragosa_Func046C takes nothing returns boolean
    if ( not Trig_Breath_of_Sindragosa_Func046Func007C() ) then
        return false
    endif
    return true
endfunction

function Trig_Breath_of_Sindragosa_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 0
    local effect eff
    local unit dummy
    set udg_Temp_Unit = GetTriggerUnit()
    if ( Trig_Breath_of_Sindragosa_Func005C() ) then
        set udg_Temp_Int = 3
        call EnableTrigger(gg_trg_Breath_of_Sindragosa_Channel_A)
    else
        set udg_Temp_Int = 0
        call EnableTrigger(gg_trg_Breath_of_Sindragosa_Channel_H)
    endif
    call StopSoundBJ( gg_snd_spell_dk_breathofsindragosa_cast_01, false )
    call PlaySoundOnUnitBJ( gg_snd_spell_dk_breathofsindragosa_cast_01, 100.00, GetSpellAbilityUnit() )
    set udg_PathofFrost[udg_Temp_Int] = GetUnitLoc(GetTriggerUnit())
    set udg_PathofFrost[( udg_Temp_Int + 1 )] = GetSpellTargetLoc()
    set udg_Facing_Angle = AngleBetweenPoints(udg_PathofFrost[udg_Temp_Int], udg_PathofFrost[( udg_Temp_Int + 1 )])
    set udg_PathofFrost[( udg_Temp_Int + 2 )] = PolarProjectionBJ(udg_PathofFrost[udg_Temp_Int], -95.00, udg_Facing_Angle)
    // SE
    call AddSpecialEffectLocBJ( udg_PathofFrost[udg_Temp_Int], "war3mapImported\\Dragon Ice.mdx" )
    set eff = GetLastCreatedEffectBJ()
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), Deg2Rad(udg_Facing_Angle), 0.00, 0.00 )
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), ( 75.00 + BlzGetLocalUnitZ(GetTriggerUnit()) ) )
    call BlzPlaySpecialEffect( GetLastCreatedEffectBJ(), ANIM_TYPE_STAND )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 1.60 )
    call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 2.00 )
    call BlzSetSpecialEffectColor( GetLastCreatedEffectBJ(), 10, 60, 255 )
    // Create Dummy
    call CreateNUnitsAtLoc( 1, 'e025', GetOwningPlayer(GetTriggerUnit()), udg_PathofFrost[( udg_Temp_Int + 2 )], udg_Facing_Angle )
    call UnitApplyTimedLifeBJ( 4.10, 'BTLF', GetLastCreatedUnit() )
    set dummy = GetLastCreatedUnit()
    call SetUnitFlyHeightBJ( dummy, 60.00, 0.00 )
    // Set Damage
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, true) - 0 ))
    set udg_RealStatCalc = ( 2.00 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - 0 )
    set udg_HeroStatCalc = ( 2 * udg_HeroStatCalc )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A0EP', udg_Temp_Unit) * 80 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 80 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 3 ]  then
    set udg_RealStatCalc = ( udg_RealStatCalc * 1.08 )
    endif
    call SetUnitAbilityLevelSwapped( 'ACbf', GetLastCreatedUnit(), ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) + 1 ) )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(dummy, 'ACbf'), ABILITY_RLF_DAMAGE_UCS1, GetUnitAbilityLevel(dummy, 'ACbf') - 1, udg_RealStatCalc )
    // Cast
    call IssuePointOrderLocBJ( dummy, "breathoffrost", udg_PathofFrost[udg_Temp_Int + 1] )
    call GameTimeWait(0.90)
    call DestroyEffectBJ( eff )
    if ( Trig_Breath_of_Sindragosa_Func044C() ) then
        // SE
        call AddSpecialEffectLocBJ( udg_PathofFrost[udg_Temp_Int], "war3mapImported\\Dragon Ice.mdx" )
        set eff = GetLastCreatedEffectBJ()
        call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), Deg2Rad(udg_Facing_Angle), 0.00, 0.00 )
        call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), ( 75.00 + BlzGetLocalUnitZ(GetTriggerUnit()) ) )
        call BlzPlaySpecialEffect( GetLastCreatedEffectBJ(), ANIM_TYPE_STAND )
        call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 1.60 )
        call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 2.00 )
        call BlzSetSpecialEffectColor( GetLastCreatedEffectBJ(), 10, 60, 255 )
        // firelords
        set udg_Temp_Unit = GetTriggerUnit()
        call TriggerExecute( gg_trg_Firelords_Helper)
        set bj_wantDestroyGroup = true
        call ForGroupBJ( GetUnitsInRangeOfLocAll(800.00, udg_PathofFrost[( udg_Temp_Int + 1 )]), function Trig_Breath_of_Sindragosa_Func044Func015A )
        // Dmg
        call IssuePointOrderLocBJ( dummy, "breathoffrost", udg_PathofFrost[udg_Temp_Int + 1] )
        call GameTimeWait(0.90)
        call DestroyEffectBJ( eff )
    else
    endif
    if ( Trig_Breath_of_Sindragosa_Func045C() ) then
        // SE
        call AddSpecialEffectLocBJ( udg_PathofFrost[udg_Temp_Int], "war3mapImported\\Dragon Ice.mdx" )
        set eff = GetLastCreatedEffectBJ()
        call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), Deg2Rad(udg_Facing_Angle), 0.00, 0.00 )
        call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), ( 75.00 + BlzGetLocalUnitZ(GetTriggerUnit()) ) )
        call BlzPlaySpecialEffect( GetLastCreatedEffectBJ(), ANIM_TYPE_STAND )
        call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 1.60 )
        call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 2.00 )
        call BlzSetSpecialEffectColor( GetLastCreatedEffectBJ(), 10, 60, 255 )
        // firelords
        set udg_Temp_Unit = GetTriggerUnit()
        call TriggerExecute( gg_trg_Firelords_Helper)
        set bj_wantDestroyGroup = true
        call ForGroupBJ( GetUnitsInRangeOfLocAll(800.00, udg_PathofFrost[( udg_Temp_Int + 1 )]), function Trig_Breath_of_Sindragosa_Func045Func015A )
        // Dmg
        call IssuePointOrderLocBJ( dummy, "breathoffrost", udg_PathofFrost[udg_Temp_Int + 1] )
        call GameTimeWait(0.90)
        call DestroyEffectBJ( eff )
    else
    endif
    if ( Trig_Breath_of_Sindragosa_Func046C() ) then
        // firelords
        set udg_Temp_Unit = GetTriggerUnit()
        call TriggerExecute( gg_trg_Firelords_Helper)
        set bj_wantDestroyGroup = true
        call ForGroupBJ( GetUnitsInRangeOfLocAll(800.00, udg_PathofFrost[( udg_Temp_Int + 1 )]), function Trig_Breath_of_Sindragosa_Func046Func005A )
        // Dmg
        call IssuePointOrderLocBJ( dummy, "breathoffrost", udg_PathofFrost[udg_Temp_Int + 1] )
        call GameTimeWait(0.90)
        // firelords
        set udg_Temp_Unit = GetTriggerUnit()
        call TriggerExecute( gg_trg_Firelords_Helper)
        set bj_wantDestroyGroup = true
        call ForGroupBJ( GetUnitsInRangeOfLocAll(800.00, udg_PathofFrost[( udg_Temp_Int + 1 )]), function Trig_Breath_of_Sindragosa_Func046Func014A )
    else
    endif
    call StopSoundBJ( gg_snd_spell_dk_breathofsindragosa_cast_01, false )
    call RemoveLocation (udg_PathofFrost[(udg_Temp_Int)])
    call RemoveLocation (udg_PathofFrost[(udg_Temp_Int + 1)])
    call RemoveLocation (udg_PathofFrost[(udg_Temp_Int + 2)])
    set eff = null
    set dummy = null
endfunction

