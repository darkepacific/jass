//===========================================================================
// Trigger: E KnC
//
// Change to Fel's Essence
//===========================================================================
function Trig_E_KnC_Func007Func001C takes nothing returns boolean
    if ( not ( GetItemTypeId(udg_P_Items[( udg_Bag_Num + udg_Bag_Iterator )]) == udg_ItemTypeCheck ) ) then
        return false
    endif
    return true
endfunction

function Trig_E_KnC_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 76
                       if IsAllianceHero( GetTriggerUnit() ) then
    call SetBagNumber( GetOwningPlayer(GetTriggerUnit()) )
    set udg_ItemTypeCheck = 'I07Q'
    set udg_Bag_Iterator = 1
    loop
        exitwhen udg_Bag_Iterator > udg_BAG_LOOP_MAX
        if ( Trig_E_KnC_Func007Func001C() ) then
            if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
            call FlashQuestDialogButtonBJ(  )
            endif
            call QuestSetCompletedBJ( udg_Quests[76], true )
            call QuestItemSetCompletedBJ( udg_QuestReqs[76], true )
            call DestroyMinimapIcon( udg_MiniMapIcon[76] )
            call DestroyEffectBJ( udg_QuestMarks[76] )
            // Clean Up Items
            call CleanUpItems( udg_ItemTypeCheck )
            // End Clean Up Items
            // Rewards
            set udg_Gold = udg_QUEST_GOLD[udg_Temp_Int]
            set udg_XP = udg_QUEST_XP[udg_Temp_Int]
            set udg_LVL_Req = udg_QUEST_LVL_REQ[udg_Temp_Int]
            set udg_TempString = "Kobolds and Catacombs"
            call TriggerExecute( gg_trg_Quest_Complete_A )
            call DisableTrigger( gg_trg_U_KnC_Acq )
            call DisableTrigger( gg_trg_Stolen_Treasure_Replenish )
            call DisableTrigger( GetTriggeringTrigger() )
            return
        else
        endif
        set udg_Bag_Iterator = udg_Bag_Iterator + 1
    endloop
                       endif
endfunction

