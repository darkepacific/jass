        call QuestMessageBJ( bj_FORCE_PLAYER[10], bj_QUESTMESSAGE_ALWAYSHINT, ( udg_TempString + " is your new hearth." ) )
    else
    endif
    if GetLocalPlayer() == GetOwningPlayer(GetBuyingUnit()) then
    call BlzSetAbilityExtendedTooltip( 'A02D', ( "After a short delay teleports the hero back to a city or town. Restores 50% of health and mana." + ( "|n|nCurrent Hearth: " + ( udg_TempString + "" ) ) ), 0 )
    endif
endfunction

//===========================================================================
function InitTrig_Set_Hearths takes nothing returns nothing
    set gg_trg_Set_Hearths = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Set_Hearths, EVENT_PLAYER_UNIT_SELL_ITEM )
    call TriggerAddCondition( gg_trg_Set_Hearths, Condition( function Trig_Set_Hearths_Conditions ) )
    call TriggerAddAction( gg_trg_Set_Hearths, function Trig_Set_Hearths_Actions )
endfunction

