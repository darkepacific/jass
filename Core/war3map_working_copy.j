//===========================================================================
// Trigger: FrostNova
//===========================================================================
function Trig_FrostNova_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A01V' ) ) then
        return false
    endif
    return true
endfunction

function Trig_FrostNova_Func025A takes nothing returns nothing
    if IsUnitTargetableEnemyGround( GetEnumUnit(), udg_Temp_Unit ) then
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_FrostNova_Actions takes nothing returns nothing
    local location Target
    local real RSC
    local integer p
    local boolean f
    local boolean r
    set udg_Temp_Unit = GetTriggerUnit()
    call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 3.00 * udg_RealStatCalc )
    set Target = udg_Temp_Unit_Point
    set RSC = udg_RealStatCalc
    set p = udg_Player_Number
    set f = udg_hasFirelords
    set r = udg_hasReaper
    call TriggerSleepAction( 0.25 )
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_Temp_Unit_Point = Target
    set udg_RealStatCalc = RSC
    set udg_Player_Number = p
    set udg_hasFirelords = f
    set udg_hasReaper = r
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(( 365.00 + ( 20.00 * I2R(GetUnitAbilityLevelSwapped('A01V', udg_Temp_Unit)) ) ), udg_Temp_Unit_Point), function Trig_FrostNova_Func025A )
    call RemoveLocation (udg_Temp_Unit_Point)
    set Target = null
endfunction

