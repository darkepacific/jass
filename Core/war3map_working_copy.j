    //  
    // CHANGE HERE: Assign Temp Unit & Order it to Fly
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Hearth_Stromgarde_100)
    call SetCameraTargetControllerNoZForPlayer( udg_X_Player_MUI, udg_FP_Bats_n_Gryphons[udg_Player_Number], 0, 0, true )
    call IssuePointOrderLocBJ( udg_FP_Bats_n_Gryphons[udg_Player_Number], "move", udg_Temp_Unit_Point )
