            return true
        endif
        //Slowed
        if(UnitHasBuffBJ(u, 'Bfro') ) then
            return true
        endif
        //Frozen
        if(UnitHasBuffBJ(u, 'B008') ) then
            return true
        endif
        //Slow
        if(UnitHasBuffBJ(u, 'Bslo') ) then
            return true
        endif
        //Slow Icy
        if(UnitHasBuffBJ(u, 'B01M') ) then
            return true
        endif
        //Slow Earthquake
        if(UnitHasBuffBJ(u, 'BOeq') ) then
            return true
        endif
        //Slow Aura Tornado
        if(UnitHasBuffBJ(u, 'Basl') ) then
            return true
        endif
        //Slow Poison (Non-stack)
        if(UnitHasBuffBJ(u, 'Bspo') ) then
            return true
        endif
        //Slow Poison (stack)
        if(UnitHasBuffBJ(u, 'Bssd') ) then
            return true
        endif
        if IsRooted(u) then
            return true
        endif
        return false
    endfunction

