function Trig_RIP_Actions takes nothing returns nothing
    call PlaySoundOnUnitBJ( gg_snd_ArtilleryCorpseExplodeDeath1, 100.00, GetSpellAbilityUnit() )
    set udg_Temp_Unit = GetSpellTargetUnit()
    if ( Trig_RIP_Func004C() ) then
        set udg_DruidDoTs = ( udg_DruidDoTs + 1 )
    else
    endif
    if ( Trig_RIP_Func005C() ) then
        set udg_DruidDoTs = ( udg_DruidDoTs + 1 )
    else
    endif
    if ( Trig_RIP_Func006C() ) then
        set udg_DruidDoTs = ( udg_DruidDoTs + 1 )
    else
    endif
    if ( Trig_RIP_Func007C() ) then
        set udg_DruidDoTs = ( udg_DruidDoTs + 1 )
    else
    endif
    if ( Trig_RIP_Func008C() ) then
        set udg_DruidDoTs = ( udg_DruidDoTs + 1 )
    else
    endif
    if ( Trig_RIP_Func009C() ) then
        set udg_DruidDoTs = ( udg_DruidDoTs + 1 )
    else
    endif
    if ( Trig_RIP_Func010C() ) then
        set udg_DruidDoTs = ( udg_DruidDoTs + 1 )
    else
    endif
    if ( Trig_RIP_Func011C() ) then
        set udg_DruidDoTs = ( udg_DruidDoTs + 1 )
    else
    endif
    if ( Trig_RIP_Func012C() ) then
        set udg_DruidDoTs = ( udg_DruidDoTs + 1 )
    else
    endif
    if ( Trig_RIP_Func013C() ) then
        set udg_DruidDoTs = ( udg_DruidDoTs + 1 )
    else
    endif
    if ( Trig_RIP_Func014C() ) then
        set udg_DruidDoTs = ( udg_DruidDoTs + 1 )
    else
    endif
    if ( Trig_RIP_Func015C() ) then
        set udg_DruidDoTs = ( udg_DruidDoTs + 1 )
    else
    endif
    if ( Trig_RIP_Func016C() ) then
        set udg_DruidDoTs = ( udg_DruidDoTs + 1 )
    else
    endif
    if ( Trig_RIP_Func017C() ) then
        set udg_DruidDoTs = ( udg_DruidDoTs + 1 )
    else
    endif
    if ( Trig_RIP_Func018C() ) then
        set udg_DruidDoTs = ( udg_DruidDoTs + 1 )
    else
    endif
    if ( Trig_RIP_Func019C() ) then
        set udg_DruidDoTs = ( udg_DruidDoTs + 1 )
    else
    endif
    if ( Trig_RIP_Func020C() ) then
        set udg_DruidDoTs = ( udg_DruidDoTs + 1 )
    else
    endif
    if ( Trig_RIP_Func021C() ) then
        set udg_DruidDoTs = ( udg_DruidDoTs + 1 )
    else
    endif
     if ( udg_DruidDoTs > 4) then
    set udg_DruidDoTs = 4
    endif
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A046', GetTriggerUnit()) * 50 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 50 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + 0.00 )
    call UnitDamageTargetBJ( GetTriggerUnit(), GetSpellTargetUnit(), ( udg_RealStatCalc * ( udg_DruidDoTs * 1.00 ) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL )
    // Damage will already be multiplied by trigger, this just adjustes the floating text
    if ( UnitHasBuffBJ( GetTriggerUnit(), 'B026') ) then
    set udg_RealStatCalc = ( udg_RealStatCalc * 1.25 )
    endif
    call CreateTextTagUnitBJ( ( R2SW(( udg_RealStatCalc + ( udg_RealStatCalc * udg_DruidDoTs ) ), 4, 0) + " Damage!" ), GetSpellTargetUnit(), 13.00, 10.00, 100, 0.00, 0.00, 0 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64, 90.00 )
    call cleanUpText( 1.2, 0.8)
    set udg_DruidDoTs = 0.00
endfunction

