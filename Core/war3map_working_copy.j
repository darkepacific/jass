//===========================================================================
// Trigger: Power Word Barrier
//===========================================================================
function Trig_Power_Word_Barrier_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0FT' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Power_Word_Barrier_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_Temp_Unit_Point = GetSpellTargetLoc()
    if ( udg_Temp_Unit == udg_yA_Disc_Priest ) then
    set udg_o = udg_z_PR_DISC_A
    call PlaySoundAtPointBJ( gg_snd_PowerWordBarrier, 100, udg_Temp_Unit_Point, 0 )
    elseif (  udg_Temp_Unit == udg_yH_Disc_Priest ) then
    set udg_o = udg_z_PR_DISC_H
    call PlaySoundAtPointBJ( gg_snd_PowerWordBarrier01, 100, udg_Temp_Unit_Point, 0 )
    endif
    set udg_o = ( udg_o + 12 )
    // Create the Dummy
    call CreateNUnitsAtLoc( 1, 'e00W', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, GetUnitFacing(GetTriggerUnit()) )
    call UnitApplyTimedLifeBJ( 3.50, 'Bhwd', GetLastCreatedUnit() )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_SpellUnits[udg_o] = GetLastCreatedUnit()
    // Turn On Tick
    if ( udg_Temp_Unit == udg_yA_Disc_Priest ) then
    set udg_SpellTicks[40] = 0
    call EnableTrigger(gg_trg_Power_Word_Barrier_Tick_A)
    elseif (  udg_Temp_Unit == udg_yH_Disc_Priest ) then
    set udg_SpellTicks[41] = 0
    call EnableTrigger(gg_trg_Power_Word_Barrier_Tick_H)
    endif
endfunction

