    local unit udg_Temp_Unit = GetTriggerUnit()
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer( udg_Temp_Unit )) * udg_NUM_OF_TC + 2 ]  then
    if IsUnitAlly( GetSpellTargetUnit() , GetOwningPlayer( udg_Temp_Unit) ) then
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'AHbn'), ABILITY_RLF_MOVEMENT_SPEED_REDUCTION_PERCENT_HBN1, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), 0.00 )
    else
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'AHbn'), ABILITY_RLF_MOVEMENT_SPEED_REDUCTION_PERCENT_HBN1, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), 0.50 )
    endif
    endif
    set udg_Temp_Unit = null
endfunction

