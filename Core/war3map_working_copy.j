function Trig_KilJaeden_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    local location udg_Temp_Polar_Point
    set udg_Temp_Unit_Point = GetUnitLoc(GetDyingUnit())
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 256, 270.00)
    call CreateItemLoc( 'I073', udg_Temp_Polar_Point )
    call PlaySoundAtPointBJ( gg_snd_KilJaeden_Death, 100.00, udg_Temp_Polar_Point, 200.00 )
    call RemoveLocation (udg_Temp_Unit_Point)
    call RemoveLocation (udg_Temp_Polar_Point)
    call TriggerSleepAction( 1.00 )
    set udg_Temp_Unit_Point = GetUnitLoc(GetDyingUnit())
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Fireball Major.mdx" )
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), ( BlzGetLocalSpecialEffectZ(GetLastCreatedEffectBJ()) + 300.00 ) )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 5.00 )
    call HideHero( gg_unit_Nkjx_2318 )
    call TriggerSleepAction( 40.00 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Kael)
    call ShowHero( gg_unit_Hkal_1415, udg_Temp_Unit_Point, true )
    call EnableTrigger( gg_trg_KilJaeden_Oblivion)
    call EnableTrigger( gg_trg_Shadowbolt_Volley_KJ)
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = null
    set udg_Temp_Polar_Point = null
endfunction

