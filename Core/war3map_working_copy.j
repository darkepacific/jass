//===========================================================================
// Trigger: U JC
//===========================================================================
function Trig_U_JC_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0G8' ) ) then
        return false
    endif
    return true
endfunction

function Trig_U_JC_Func003C takes nothing returns boolean
    if ( not ( RectContainsLoc(gg_rct_Jammalans_Cauldron, udg_Temp_Unit_Point) == true ) ) then
        return false
    endif
    if ( not ( udg_QuestJammalansCauldron < 8.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_U_JC_Actions takes nothing returns nothing
    local location udg_Temp_Polar_Point
    set udg_Temp_Unit_Point = GetSpellTargetLoc()
    if ( Trig_U_JC_Func003C() ) then
        call RemoveLocation (udg_Temp_Unit_Point)
        call GameTimeWait(0.5)
        set udg_QuestJammalansCauldron = ( udg_QuestJammalansCauldron + 1.00 )
        call CreateTextTagLocBJ( "TRIGSTR_11041", udg_Temp_Unit_Point, 40.00, 9.00, 100, 60.00, 0.00, 0 )
        call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
        call cleanUpText(0.8, 0.6)
        set udg_Temp_Polar_Point = GetRectCenter(gg_rct_Jammalans_Cauldron)
        call AddSpecialEffectLocBJ( udg_Temp_Polar_Point, "war3mapImported\\AquaSpike_Green3.mdx" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call AddSpecialEffectLocBJ( udg_Temp_Polar_Point, "Objects\\Spawnmodels\\Naga\\NagaBlood\\NagaBloodWindserpent.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call RemoveLocation (udg_Temp_Polar_Point)
    else
        call RemoveLocation (udg_Temp_Unit_Point)
        set udg_Temp_Polar_Point = GetSpellTargetLoc()
        call GameTimeWait(0.5)
        call AddSpecialEffectLocBJ( udg_Temp_Polar_Point, "Objects\\Spawnmodels\\Naga\\NagaBlood\\NagaBloodWindserpent.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call RemoveLocation (udg_Temp_Polar_Point)
    endif
    call QuestItemSetDescriptionBJ( udg_QuestReqs[129], ( "Sea Meat thrown into Cauldron - " + ( I2S(R2I(udg_QuestJammalansCauldron)) + "/8" ) ) )
    set udg_Temp_Polar_Point = null
endfunction

