    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_4728", udg_TempString, "ReplaceableTextures\\CommandButtons\\BTNGem.blp" )
    set udg_Quests[23] = GetLastCreatedQuestBJ()
    call QuestSetEnabledBJ( false, GetLastCreatedQuestBJ() )
    call EnableTrigger( gg_trg_S_Precious_Tears )
