    if ( Trig_Set_Hearths_Func017C() ) then
        call QuestMessageBJ( bj_FORCE_PLAYER[2], bj_QUESTMESSAGE_ALWAYSHINT, ( udg_TempString + " is your new hearth." ) )
    else
