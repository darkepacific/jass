//===========================================================================
// Trigger: Warbreaker
//
// Does 1241 really need to be moved? Can it all just be done with 1 now?
//===========================================================================
function Trig_Warbreaker_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A006' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Warbreaker_Func042Func019C takes nothing returns boolean
    if ( not ( IsUnitInGroup(GetEnumUnit(), udg_KnockBacks) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Warbreaker_Func042A takes nothing returns nothing
    if IsUnitTargetableEnemyStab( GetEnumUnit(), udg_Temp_Unit ) then
    if udg_Debug then
    call DisplayTextToForce( GetPlayersAll(), R2S( udg_RealStatCalc) )
    endif
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL )
    call AddSpecialEffectTargetUnitBJ( "overhead", GetEnumUnit(), "war3mapImported\\Ephemeral Cut Red.mdx" )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00) )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "overhead", GetEnumUnit(), "war3mapImported\\Ephemeral Cut Orange.mdx" )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00) )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call IssueTargetOrderBJ( gg_unit_e01S_1241, "acidbomb", GetEnumUnit() )
    call HasFirelords( GetEnumUnit() )
    // mvmnt
    // KnockBackLoop Turn ON
    call UnitAddAbilityBJ( 'Amrf', GetEnumUnit() )
    call UnitRemoveAbilityBJ( 'Amrf', GetEnumUnit() )
    call SetUnitFlyHeightBJ( GetEnumUnit(), 135.00, 0.00 )
    if ( Trig_Warbreaker_Func042Func019C() ) then
        call GroupAddUnitSimple( GetEnumUnit(), udg_KnockBacks )
    else
        call FlushChildHashtableBJ( GetHandleIdBJ(GetEnumUnit()), udg_KnockBacksHash )
    endif
    call SaveRealBJ( 0.00, 0, GetHandleIdBJ(GetEnumUnit()), udg_KnockBacksHash )
    call SaveRealBJ( 4.00, 1, GetHandleIdBJ(GetEnumUnit()), udg_KnockBacksHash )
    call SaveRealBJ( 172.00, 2, GetHandleIdBJ(GetEnumUnit()), udg_KnockBacksHash )
    call SaveRealBJ( 0.00, 3, GetHandleIdBJ(GetEnumUnit()), udg_KnockBacksHash )
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    endif
endfunction

function Trig_Warbreaker_Actions takes nothing returns nothing
    local location t1
    call AddSpecialEffectTargetUnitBJ( "chest", GetTriggerUnit(), "war3mapImported\\Ephemeral Slash Orange.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "chest", GetTriggerUnit(), "war3mapImported\\Culling Cleave Red.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 160.00, GetUnitFacing(GetTriggerUnit()))
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = udg_Temp_Polar_Point
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Coup de Grace.mdx" )
    call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 1.25 )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), 0.0, Deg2Rad(GetUnitFacing(GetTriggerUnit())), 0.0 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call UnitAddAbility( udg_Temp_Unit, 'Amrf' )
    call UnitRemoveAbility( udg_Temp_Unit, 'Amrf' )
    call SetUnitFlyHeight( udg_Temp_Unit, 0, 65.00 )
    // Circle
    set t1 = udg_Temp_Unit_Point
    call GameTimeWait(0.2)
    set udg_Temp_Unit_Point = t1
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\RedAftershock.mdx" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 1.00 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_Temp_X_Point = GetUnitLoc(udg_Temp_Unit)
    call SetUnitFlyHeight( udg_Temp_Unit, 0, 0.00 )
    // Damage Calculation
    call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A006', udg_Temp_Unit) + 0 )
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_STR, GetTriggerUnit(), true) - 0 ))
    set udg_RealStatCalc = ( ( 1.50 + ( I2R(udg_HeroStatCalc) * 1.50 ) ) * udg_RealStatCalc )
    set udg_HeroStatCalc = ( udg_HeroStatCalc * 150 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 150 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    // AoE
    call SetUnitPositionLoc( gg_unit_e01S_1241, udg_Temp_Unit_Point )
    call SetUnitOwner( gg_unit_e01S_1241, GetOwningPlayer(udg_Temp_Unit), true )
    call SetUnitAbilityLevel( gg_unit_e01S_1241, 'A06G',  GetUnitAbilityLevel(udg_Temp_Unit, 'A006') + 1)
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(190.00, udg_Temp_Unit_Point), function Trig_Warbreaker_Func042A )
    call EnableTrigger( gg_trg_KnockBackLoop)
    call RemoveLocation (udg_Temp_Unit_Point)
    call RemoveLocation (udg_Temp_X_Point)
    set t1 = null
endfunction

//===========================================================================
function InitTrig_Warbreaker takes nothing returns nothing
    set gg_trg_Warbreaker = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Warbreaker, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Warbreaker, Condition( function Trig_Warbreaker_Conditions ) )
    call TriggerAddAction( gg_trg_Warbreaker, function Trig_Warbreaker_Actions )
endfunction

//===========================================================================
// Trigger: Die by the Sword
//===========================================================================
function Trig_Die_by_the_Sword_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A08F' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Die_by_the_Sword_Actions takes nothing returns nothing
    local effect eff
    local player udg_X_Player_MUI = GetTriggerPlayer()
    local unit udg_Temp_Unit = GetTriggerUnit()
    call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "war3mapImported\\DieByTheSword.mdx" )
    set eff = GetLastCreatedEffectBJ()
    call StopSoundBJ( gg_snd_DieByTheSword_StateDone_02, false )
    call PlaySoundOnUnitBJ( gg_snd_DieByTheSword_StateDone_02, 100.00, GetSpellAbilityUnit() )
    call UnitAddAbilityBJ( 'A0E8', GetTriggerUnit() )
    call BlzUnitHideAbility( GetTriggerUnit(), 'A0E8', true )
    call SetPlayerAbilityAvailableBJ( false, 'A04N', udg_X_Player_MUI )
    call GameTimeWait(3.0)
    call DestroyEffectBJ( eff )
    call SetPlayerAbilityAvailableBJ( true, 'A04N', udg_X_Player_MUI )
    call BlzUnitHideAbility( GetTriggerUnit(), 'A0E8', false )
    call UnitRemoveAbilityBJ( 'A0E8', GetTriggerUnit() )
    set udg_X_Player_MUI = null
    set udg_Temp_Unit = null
    set eff = null
endfunction

