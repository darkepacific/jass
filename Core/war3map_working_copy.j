function Trig_HB_Tick_H_Actions takes nothing returns nothing
    set udg_Temp_Unit = udg_yH_Frost_DK
    call TriggerExecute( gg_trg_Firelords_Helper)
    set udg_Temp_Int = 19
    // Damage Calculation
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 3.00 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A02V', udg_Temp_Unit) * 55 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 10 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 3 ]  then
    set udg_RealStatCalc = ( udg_RealStatCalc * 1.08 )
    endif
    // point calc
    set udg_Facing_Angle = AngleBetweenPoints(udg_Point_Charge_Begin[udg_Temp_Int], udg_Point_Charge_End[udg_Temp_Int])
    set udg_Length = 100.00
    set udg_Width = 188.00
    set udg_Temp_Unit_Point = PolarProjectionBJ(udg_Point_Charge_Begin[udg_Temp_Int], ( udg_Length * udg_Charge_Loop[udg_Temp_Int] ), udg_Facing_Angle)
    call TriggerExecute( gg_trg_PICK_EVERY_UNIT_IN_RECT )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Weapons\\LichMissile\\LichMissile.mdl" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 2.00 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Blizzard II Missile.mdx" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 2.00 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call RemoveLocation (udg_Temp_Unit_Point)
    // AoE
    call SetUnitOwner( gg_unit_e028_1863, GetOwningPlayer(udg_Heroes[udg_Player_Number]), true )
    call SetUnitAbilityLevelSwapped( 'A03P', gg_unit_e028_1863, 1 )
    call ForGroupBJ( udg_UnitsInRect, function Trig_HB_Tick_H_Func029A )
    if ( Trig_HB_Tick_H_Func030C() ) then
        set udg_SpellTicks[udg_Temp_Int] = ( udg_SpellTicks[udg_Temp_Int] + 1 )
        set udg_Charge_Loop[udg_Temp_Int] = ( udg_Charge_Loop[udg_Temp_Int] + 1 )
    else
        call DisableTrigger( GetTriggeringTrigger() )
        // Make Ice
        call AddSpecialEffectLocBJ( udg_Point_Charge_End[udg_Temp_Int], "war3mapImported\\ArcaneExplosion.mdx" )
        call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 1.00 )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        set bj_forLoopAIndex = 12
        set bj_forLoopAIndexEnd = 23
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Point_Charge_End[udg_Temp_Int], 156.00, ( 30.00 * ( 1 + I2R(ModuloInteger(GetForLoopIndexA(), 12)) ) ))
            call AddSpecialEffectLocBJ( udg_Temp_Polar_Point, "Ice Shard.mdx" )
            call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.81 )
            call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 1.20 )
            call RemoveLocation (udg_Temp_Polar_Point)
            set udg_IceRing[GetForLoopIndexA()] = GetLastCreatedEffectBJ()
            set bj_forLoopAIndex = bj_forLoopAIndex + 1
        endloop
        // DummySet
        if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 12 ]  then
        call DummyStunSet(  udg_Temp_Unit, 1.3, udg_Point_Charge_Begin[udg_Temp_Int] )
        else
        call DummyRootSet(  GetOwningPlayer(udg_Temp_Unit), udg_Point_Charge_Begin[udg_Temp_Int], udg_Facing_Angle, 1)
        endif
        // Circle
        set bj_wantDestroyGroup = true
        call ForGroupBJ( GetUnitsInRangeOfLocAll(192.00, udg_Point_Charge_End[udg_Temp_Int]), function Trig_HB_Tick_H_Func030Func017A )
        call RemoveLocation (udg_Point_Charge_Begin[udg_Temp_Int])
        call RemoveLocation (udg_Point_Charge_End[udg_Temp_Int])
        call TriggerSleepAction( 1.70 )
        // Break Ice
        set bj_forLoopAIndex = 12
        set bj_forLoopAIndexEnd = 23
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call DestroyEffectBJ( udg_IceRing[GetForLoopIndexA()] )
            set bj_forLoopAIndex = bj_forLoopAIndex + 1
        endloop
    endif
endfunction

