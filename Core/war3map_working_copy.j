//===========================================================================
// Trigger: Mind Blast
//===========================================================================
function Trig_Mind_Blast_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A003' ) ) then
        return false
    endif
    if ( not ( GetSpellAbilityId() == 'A08V' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mind_Blast_Actions takes nothing returns nothing
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 2 ] then
    if GetTriggerUnit() == udg_yA_Shadow_Priest or GetTriggerUnit() == udg_yH_Shadow_Priest then
    call UnitDamageTargetBJ( GetTriggerUnit(), GetSpellTargetUnit(), ( 5.00 * ( I2R(GetHeroStatBJ(bj_HEROSTAT_INT, GetTriggerUnit(), true)) - I2R(GetHeroStatBJ(bj_HEROSTAT_INT, GetTriggerUnit(), false)) ) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    endif
    else
    call UnitDamageTargetBJ( GetTriggerUnit(), GetSpellTargetUnit(), ( 2.50 * ( I2R(GetHeroStatBJ(bj_HEROSTAT_INT, GetTriggerUnit(), true)) - I2R(GetHeroStatBJ(bj_HEROSTAT_INT, GetTriggerUnit(), false)) ) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    endif
endfunction

