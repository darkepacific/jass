function Trig_Durhholde_Keep_Leave_Actions takes nothing returns nothing
    local integer udg_Temp_Int
    set udg_Temp_Int = 6
    set udg_TowerHeroes[udg_Temp_Int] = null
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRectAll(gg_rct_Durnholde_Keep_Capture), function Trig_Durhholde_Keep_Leave_Func005A )
    if ( udg_TowerHeroes[udg_Temp_Int] == null) then
    call DisableTrigger( GetTriggeringTrigger() )
    call PauseTimerBJ( true, udg_TowerTimers[6] )
    call DestroyTimerDialogBJ( udg_TowerWindows[6] )
    call QuestMessageBJ( GetPlayersAll(), bj_QUESTMESSAGE_ALWAYSHINT, "TRIGSTR_4052" )
    call EnableTrigger( gg_trg_Durnholde_Keep )
    endif
endfunction

