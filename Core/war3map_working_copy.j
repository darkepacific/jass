//===========================================================================
function Trig_Summon_Skeletons_Func008C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetSummonedUnit()) == 'n059' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetSummonedUnit()) == 'nsca' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Summon_Skeletons_Conditions takes nothing returns boolean
    if ( not Trig_Summon_Skeletons_Func008C() ) then
        return false
    endif
    return true
endfunction

function Trig_Summon_Skeletons_Actions takes nothing returns nothing
    local unit udg_Temp_Unit = GetSummonedUnit()
    local unit caster = GetSummoningUnit()
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer( caster )) * udg_NUM_OF_TC + 2 ]  then
    call BlzSetUnitBaseDamage( udg_Temp_Unit, BlzGetUnitBaseDamage( udg_Temp_Unit, 0) + (4 * GetHeroStatBJ(bj_HEROSTAT_INT, caster, true)) / 5 , 0)
    endif
    set udg_Temp_Unit = null
    set caster = null
endfunction

