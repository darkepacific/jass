        call IssueImmediateOrderBJ( gg_unit_e03I_2003, "stop")
        call IssueImmediateOrderBJ( gg_unit_e03J_2004, "stop")
        call RemoveGuardPosition( gg_unit_e03G_2001 )
        call RemoveGuardPosition( gg_unit_e03H_2002 )
        call RemoveGuardPosition( gg_unit_e03I_2003 )
        call RemoveGuardPosition( gg_unit_e03J_2004 )
    else
        set udg_Debug = false
        call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_5281" )
    endif
endfunction

