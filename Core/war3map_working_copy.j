function Trig_E_TWC_Func023Func001Func005C takes nothing returns boolean
    if ( ( GetUnitRace(GetEnumUnit()) == RACE_HUMAN ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEnumUnit()) == 'n026' ) ) then
        return true
    endif
    return false
endfunction

function Trig_E_TWC_Func023Func001C takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetEnumUnit()) == Player(PLAYER_NEUTRAL_AGGRESSIVE) ) ) then
        return false
    endif
    if ( not Trig_E_TWC_Func023Func001Func005C() ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_E_TWC_Func023A takes nothing returns nothing
    if ( Trig_E_TWC_Func023Func001C() ) then
        call AddSpecialEffectTargetUnitBJ( "overhead", GetEnumUnit(), "Abilities\\Spells\\Other\\TalkToMe\\TalkToMe.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call SetUnitOwner( GetEnumUnit(), Player(1), true )
    else
    endif
endfunction

function Trig_E_TWC_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 139
    local location udg_Temp_Unit_Point
    local location udg_Temp_Polar_Point
    if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
    call FlashQuestDialogButtonBJ(  )
    endif
    call DestroyTimerDialogBJ( udg_QuestTimerWindows[udg_Temp_Int] )
    call QuestItemSetCompletedBJ( udg_QuestReqs[udg_Temp_Int], true )
    call QuestSetCompletedBJ( udg_Quests[udg_Temp_Int], true )
    call DestroyMinimapIcon( udg_MiniMapIcon[udg_Temp_Int] )
    // Clean Up Items
    set udg_ItemTypeCheck = 'I0A7'
    call CleanUpItems( udg_ItemTypeCheck )
    // Rewards
    set udg_XP = udg_QUEST_XP[udg_Temp_Int]
    set udg_Gold = udg_QUEST_GOLD[udg_Temp_Int]
    set udg_LVL_Req = udg_QUEST_LVL_REQ[udg_Temp_Int]
    set udg_TempString = "The Wildhammer Clan"
    call TriggerExecute( gg_trg_Quest_Complete_A )
    // Convert to Allies
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Thundermar)
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(1400.00, udg_Temp_Unit_Point), function Trig_E_TWC_Func023A )
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 325.00, 25.00)
    call CreateNUnitsAtLoc( 1, 'n05R', Player(1), udg_Temp_Polar_Point, 244.04 )
    call RemoveLocation (udg_Temp_Polar_Point)
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Lachlan_MacGraff)
    call ReviveHeroLoc( gg_unit_O011_2160, udg_Temp_Unit_Point, true )
    call RemoveLocation (udg_Temp_Unit_Point)
    call SetUnitOwner( gg_unit_O011_2160, Player(1), true)
    call DisableTrigger(gg_trg_L_TWC)
    call DisableTrigger(gg_trg_U_TWC)
    call DisableTrigger(gg_trg_F_TWC)
    call TriggerExecute(gg_trg_M_Killing_Kilrogg_46)
    call DisableTrigger( GetTriggeringTrigger() )
    set udg_Temp_Unit_Point = null
    set udg_Temp_Polar_Point = null
endfunction

