function InitTrig_SMASHED takes nothing returns nothing
    set gg_trg_SMASHED = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_SMASHED, EVENT_PLAYER_UNIT_ATTACKED )
    call TriggerAddCondition( gg_trg_SMASHED, Condition( function Trig_SMASHED_Conditions ) )
    call TriggerAddAction( gg_trg_SMASHED, function Trig_SMASHED_Actions )
