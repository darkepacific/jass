    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_9735", udg_TempString, "ReplaceableTextures\\CommandButtons\\BTNAbominationTeddy.blp" )
    set udg_Quests[65] = GetLastCreatedQuestBJ()
    call QuestSetEnabledBJ( false, GetLastCreatedQuestBJ() )
    call EnableTrigger( gg_trg_S_Find_Dolly_A_by_Entry )
    call EnableTrigger( gg_trg_S_or_U_Find_Dolly_A_by_Acquire )
endfunction

