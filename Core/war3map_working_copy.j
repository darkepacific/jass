    set udg_QuestReqs[udg_Temp_Int] = GetLastCreatedQuestItemBJ()
    call DisableTrigger( GetTriggeringTrigger() )
    if ( Trig_S_KJA_Func022C() ) then
        call KhadgarPortal()
        call EnableTrigger( gg_trg_P_KJ_Ext)
    else
    endif
    call EnableTrigger( gg_trg_E_KJA)
                       endif
endfunction

