function Trig_Turtle_n_Elemental_Taunt_Func002C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0BE' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Turtle_n_Elemental_Taunt_Actions takes nothing returns nothing
    local effect eff
    if ( Trig_Turtle_n_Elemental_Taunt_Func002C() ) then
        set udg_Temp_Int = ( GetUnitLevel(GetTriggerUnit()) / 5 )
        set udg_Temp_Int = ( udg_Temp_Int + 1 )
        if udg_TalentChoices[ GetPlayerId(GetOwningPlayer( GetTriggerUnit() )) * udg_NUM_OF_TC + 14 ]  then
        set udg_Temp_Int = ( udg_Temp_Int + 4 )
        endif
    else
        set udg_Temp_Int = ( GetUnitLevel(GetTriggerUnit()) + 0 )
        set udg_Temp_Int = ( R2I(( I2R(udg_Temp_Int) / 3.75 )) + 0 )
        call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "war3mapImported\\Earth Shield2.mdx" )
        set eff = GetLastCreatedEffectBJ()
    endif
    call SetUnitAbilityLevelSwapped( 'A0BF', gg_unit_e03G_2001, udg_Temp_Int )
    call IssueTargetOrder( gg_unit_e03G_2001, "innerfire", GetTriggerUnit() )
    call GameTimeWait(4.6)
    call DestroyEffectBJ( eff )
    set eff = null
endfunction

//===========================================================================
function InitTrig_Turtle_n_Elemental_Taunt takes nothing returns nothing
    set gg_trg_Turtle_n_Elemental_Taunt = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Turtle_n_Elemental_Taunt, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Turtle_n_Elemental_Taunt, Condition( function Trig_Turtle_n_Elemental_Taunt_Conditions ) )
    call TriggerAddAction( gg_trg_Turtle_n_Elemental_Taunt, function Trig_Turtle_n_Elemental_Taunt_Actions )
endfunction

//===========================================================================
// Trigger: Serpent Sting
//
// Hunter shots 3 & 4 = Open now (6,7)
//===========================================================================
function Trig_Serpent_Sting_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A00C' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Serpent_Sting_Func027A takes nothing returns nothing
    if udg_HeroStatCalc == 0 then
    if IsUnitTargetableEnemy( GetEnumUnit(), udg_Temp_Unit ) then
    if not (GetEnumUnit() == GetSpellTargetUnit() ) then
    call IssueTargetOrderBJ( gg_unit_e00H_2048, "shadowstrike", GetEnumUnit() )
    set udg_HeroStatCalc = 1
    endif
    endif
    endif
endfunction

function Trig_Serpent_Sting_Actions takes nothing returns nothing
    local integer i
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A00C', udg_Temp_Unit) * 55 )
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, false) ))
    set i = GetPlayerId(GetOwningPlayer(udg_Temp_Unit))
    if udg_TalentChoices[ i * udg_NUM_OF_TC + 0] then
    set udg_RealStatCalc = ( 5.00 * udg_RealStatCalc )
    else
    set udg_RealStatCalc = ( 3.00 * udg_RealStatCalc )
    endif
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A00C'), ABILITY_RLF_INITIAL_DAMAGE_ESH5, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_Temp_Unit) - 1 ), udg_RealStatCalc )
    // Chimaera Shot
    if udg_TalentChoices[ i * udg_NUM_OF_TC + 3] then
    // Move the Unit
    set udg_Temp_Unit = gg_unit_e00H_2048
    call SetUnitOwner( udg_Temp_Unit, GetOwningPlayer(GetTriggerUnit()), true )
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    call SetUnitPositionLocFacingBJ( udg_Temp_Unit, udg_Temp_Unit_Point, GetUnitFacing(GetTriggerUnit()) )
    call RemoveLocation (udg_Temp_Unit_Point)
    // Order to Cast
    set udg_RealStatCalc = ( 0.50 * udg_RealStatCalc )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A0ES'), ABILITY_RLF_INITIAL_DAMAGE_ESH5, 0, udg_RealStatCalc )
    set udg_Temp_Unit_Point = GetUnitLoc(GetSpellTargetUnit())
    set udg_HeroStatCalc = 0
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(420.00, udg_Temp_Unit_Point), function Trig_Serpent_Sting_Func027A )
    call RemoveLocation (udg_Temp_Unit_Point)
    endif
endfunction

//===========================================================================
function InitTrig_Serpent_Sting takes nothing returns nothing
    set gg_trg_Serpent_Sting = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Serpent_Sting, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Serpent_Sting, Condition( function Trig_Serpent_Sting_Conditions ) )
    call TriggerAddAction( gg_trg_Serpent_Sting, function Trig_Serpent_Sting_Actions )
endfunction

