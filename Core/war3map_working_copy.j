//===========================================================================
// Trigger: M Venomfang
//===========================================================================
function Trig_M_Venomfang_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 4
    set udg_TempString = ""
    if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
    set udg_TempString = udg_ExclamationMark
    endif
    call AddSpecialEffectTargetUnitBJ( "overhead", gg_unit_Hpal_0010, udg_TempString )
    set udg_QuestMarks[4] = GetLastCreatedEffectBJ()
    set udg_TempString = "Return Venomfang's Head to the paladin."
    // Set Quest Rewards
    set udg_QUEST_XP[udg_Temp_Int] = 175
    set udg_QUEST_GOLD[udg_Temp_Int] = 75
    call QuestRewards_TextSet(udg_Temp_Int)
    // End Set Quest Rewards
    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_4601", udg_TempString, "ReplaceableTextures\\CommandButtons\\BTNSpiderGreen.blp" )
    set udg_Quests[4] = GetLastCreatedQuestBJ()
    call QuestSetEnabledBJ( false, udg_Quests[4] )
    call EnableTrigger( gg_trg_S_Venomfang )
endfunction

//===========================================================================
function InitTrig_M_Venomfang takes nothing returns nothing
    set gg_trg_M_Venomfang = CreateTrigger(  )
    call TriggerRegisterTimerEventSingle( gg_trg_M_Venomfang, 1.00 )
    call TriggerAddAction( gg_trg_M_Venomfang, function Trig_M_Venomfang_Actions )
endfunction

//===========================================================================
// Trigger: S Venomfang
//
// Need to change this to team wide display.
//===========================================================================
function Trig_S_Venomfang_Actions takes nothing returns nothing
                       if IsAllianceHero( GetTriggerUnit() ) then
    set udg_TempString = "Venomfang"
    set udg_TempString_Quest = "Kill Venomfang and return its head."
    call TriggerExecute( gg_trg_Quest_Start_A )
    set udg_TempString = ""
    if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
    set udg_TempString = udg_QuestionMark
    call QuestSetEnabledBJ( true, udg_Quests[4] )
    call FlashQuestDialogButtonBJ(  )
    endif
    call DestroyEffectBJ( udg_QuestMarks[4] )
    call AddSpecialEffectTargetUnitBJ( "overhead", gg_unit_Hpal_0010, udg_TempString )
    set udg_QuestMarks[4] = GetLastCreatedEffectBJ()
    call QuestSetCompletedBJ( udg_Quests[4], false )
    call CreateQuestItemBJ( udg_Quests[4], "TRIGSTR_4603" )
    set udg_QuestReqs[4] = GetLastCreatedQuestItemBJ()
    call CampaignMinimapIconUnitBJ( gg_unit_n01Z_1378, bj_CAMPPINGSTYLE_BOSS )
    call SetMinimapIconOrphanDestroy( GetLastCreatedMinimapIcon(), false )
    set udg_MiniMapIcon[4] = GetLastCreatedMinimapIcon()
    if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
    call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), false )
    endif
    call DisableTrigger( GetTriggeringTrigger() )
    call EnableTrigger( gg_trg_E_Venomfang )
    call EnableTrigger( gg_trg_U_Venomfang_Head_Acquire )
                       endif
endfunction

