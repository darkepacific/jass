//===========================================================================
// Trigger: Feign Death S
//===========================================================================
function Trig_Feign_Death_S_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0A4' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Feign_Death_S_Actions takes nothing returns nothing
    local unit udg_Temp_Unit = GetTriggerUnit()
    if udg_Temp_Unit == udg_yA_Marksman_Hunter then
    set udg_FeignDeathWait[0] = true
    else
    set udg_FeignDeathWait[2] = true
    endif
    call IssueImmediateOrderBJ( GetTriggerUnit(), "stop" )
    call SetUnitInvulnerable( udg_Temp_Unit , true )
    call PauseUnit( udg_Temp_Unit, true )
    call SetUnitAnimation( GetTriggerUnit(), "death" )
    call GameTimeWait(0.55)
    // heal
    call FeignDeathHeal( udg_Temp_Unit )
    call GameTimeWait(0.55)
    // heal
    call FeignDeathHeal( udg_Temp_Unit )
    call GameTimeWait(0.55)
    // heal
    call FeignDeathHeal( udg_Temp_Unit )
    call GameTimeWait(0.55)
    // heal
    call FeignDeathHeal( udg_Temp_Unit )
    call GameTimeWait(0.55)
    // heal
    call FeignDeathHeal( udg_Temp_Unit )
    call PauseUnitBJ( false, udg_Temp_Unit )
    call SetUnitInvulnerable( udg_Temp_Unit , false)
    call IssueImmediateOrderBJ( GetTriggerUnit(), "stop" )
    set udg_Temp_Unit_CD = udg_Temp_Unit
    call TriggerExecute( gg_trg_Cooldown_Maths) 
     call BlzStartUnitAbilityCooldown( udg_Temp_Unit_CD, 'A0A4', ( udg_CooldownRemaining * BlzGetUnitAbilityCooldownRemaining( udg_Temp_Unit_CD, 'A0A4') ) )
    set udg_Temp_Unit = null
endfunction

//===========================================================================
function InitTrig_Feign_Death_S takes nothing returns nothing
    set gg_trg_Feign_Death_S = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Feign_Death_S, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Feign_Death_S, Condition( function Trig_Feign_Death_S_Conditions ) )
    call TriggerAddAction( gg_trg_Feign_Death_S, function Trig_Feign_Death_S_Actions )
endfunction

