    if ( not ( UnitHasItemOfTypeBJ(udg_Heroes[5], 'I078') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Arcane_Burst_5_Func016Func002C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 4) > 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Arcane_Burst_5_Func016C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 3) > 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Arcane_Burst_5_Actions takes nothing returns nothing
    local real dist
    local real udg_RealStatCalc
    local integer udg_Player_Number
    local location udg_Temp_Unit_Point
    local location udg_Temp_Polar_Point
    set dist = 0.26
    call DisableTrigger( GetTriggeringTrigger() )
    set udg_Player_Number = 5
    set udg_Temp_Polar_Point = GetUnitLoc(GetTriggerUnit())
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Heroes[udg_Player_Number])
    set udg_RealStatCalc = ( 0.26 + ( DistanceBetweenPoints(udg_Temp_Polar_Point, udg_Temp_Unit_Point) / 1420.00 ) )
    call RemoveLocation (udg_Temp_Polar_Point)
    call RemoveLocation (udg_Temp_Unit_Point)
    set dist = udg_RealStatCalc
    call TriggerSleepAction(dist)
    if ( Trig_Arcane_Burst_5_Func016C() ) then
        call PlaySoundOnUnitBJ( gg_snd_046_item_deathfiresgrasp_oh_0101, 85.00, GetTriggerUnit() )
    else
        if ( Trig_Arcane_Burst_5_Func016Func002C() ) then
            call PlaySoundOnUnitBJ( gg_snd_047_item_deathfiresgrasp_oh_0201, 85.00, GetTriggerUnit() )
        else
            call PlaySoundOnUnitBJ( gg_snd_048_item_deathfiresgrasp_oh_0301, 85.00, GetTriggerUnit() )
        endif
    endif
    call AddSpecialEffectTargetUnitBJ( "chest", GetTriggerUnit(), "war3mapImported\\EnergyBurstNoSound.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Heroes[udg_Player_Number], true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Heroes[udg_Player_Number], false) ))
    call UnitDamageTargetBJ( udg_Heroes[udg_Player_Number], GetTriggerUnit(), ( 100.00 + ( udg_ARCANE_BURST_MULTIPLIER * udg_RealStatCalc ) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    set udg_Temp_Unit_Point = null
    set udg_Temp_Polar_Point = null
endfunction

