//===========================================================================
// Trigger: Marked For Death
//===========================================================================
function Trig_Marked_For_Death_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A04O' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Marked_For_Death_Actions takes nothing returns nothing
    if ( GetSpellAbilityUnit() == udg_yA_Ass_Rogue ) then
    set udg_o = udg_z_RO_ASSA_A
    endif
    if ( GetSpellAbilityUnit() == udg_yH_Ass_Rogue ) then
    set udg_o = udg_z_RO_ASSA_H
    endif
    set udg_SpellUnits[ udg_o + 0] = GetSpellTargetUnit()
    call AddSpecialEffectTargetUnitBJ( "origin", udg_SpellUnits[( udg_o + 0 )], "war3mapImported\\Dark Execution.mdx" )
    call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 5.00 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call EnableTrigger( gg_trg_Marked_For_Death_DIES)
    call EnableTrigger( gg_trg_Marked_For_Death_Buff_Check)
endfunction

//===========================================================================
function InitTrig_Marked_For_Death takes nothing returns nothing
    set gg_trg_Marked_For_Death = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Marked_For_Death, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Marked_For_Death, Condition( function Trig_Marked_For_Death_Conditions ) )
    call TriggerAddAction( gg_trg_Marked_For_Death, function Trig_Marked_For_Death_Actions )
endfunction

//===========================================================================
// Trigger: Marked For Death DIES
//===========================================================================
function Trig_Marked_For_Death_DIES_Func002Func001C takes nothing returns boolean
    if ( not ( GetTriggerUnit() == udg_SpellUnits[( udg_z_RO_ASSA_H + 0 )] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Marked_For_Death_DIES_Func002C takes nothing returns boolean
    if ( not ( GetTriggerUnit() == udg_SpellUnits[( udg_z_RO_ASSA_A + 0 )] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Marked_For_Death_DIES_Actions takes nothing returns nothing
    local unit udg_Temp_Unit 
    if ( Trig_Marked_For_Death_DIES_Func002C() ) then
        set udg_o = udg_z_RO_ASSA_A
        call AddSpecialEffectTargetUnitBJ( "origin", udg_SpellUnits[( udg_o + 0 )], "Abilities\\Spells\\Demon\\DemonBoltImpact\\DemonBoltImpact.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        set udg_Temp_Unit = udg_yA_Ass_Rogue
        call BlzEndUnitAbilityCooldown( udg_Temp_Unit, 'A04O' )
        // Combo Gen
        call DestroyEffectBJ( udg_AAssComboEffects[0] )
        call DestroyEffectBJ( udg_AAssComboEffects[1] )
        call DestroyEffectBJ( udg_AAssComboEffects[2] )
        call AddSpecialEffectTargetUnitBJ( "overhead", udg_Temp_Unit, "RedSpellOrb.mdx" )
        call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.18 )
        set udg_AAssComboEffects[0] = GetLastCreatedEffectBJ()
        call AddSpecialEffectTargetUnitBJ( "right hand", udg_Temp_Unit, "RedSpellOrb.mdx" )
        call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.18 )
        set udg_AAssComboEffects[1] = GetLastCreatedEffectBJ()
        call AddSpecialEffectTargetUnitBJ( "left hand", udg_Temp_Unit, "RedSpellOrb.mdx" )
        call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.18 )
        set udg_AAssComboEffects[2] = GetLastCreatedEffectBJ()
        set udg_AAssComboPoints = 3.00
        set udg_SpellUnits[ udg_o + 0 ] = null
        call CreateTextTagUnitBJ( "TRIGSTR_8642", udg_Temp_Unit, 10.00, 8.00, 100, 100, 0.00, 0 )
        call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64, 0.00 )
        call cleanUpText (1.0, 0.5)
        call ShowTextTagForceBJ( true, GetLastCreatedTextTag(), udg_HordePlayers )
        call ComboPointFrameSetPoints( udg_yA_Ass_Rogue, udg_AAssComboPoints)
    else
        if ( Trig_Marked_For_Death_DIES_Func002Func001C() ) then
            set udg_o = udg_z_RO_ASSA_H
            call AddSpecialEffectTargetUnitBJ( "origin", udg_SpellUnits[( udg_o + 0 )], "Abilities\\Spells\\Demon\\DemonBoltImpact\\DemonBoltImpact.mdl" )
            call DestroyEffectBJ( GetLastCreatedEffectBJ() )
            set udg_Temp_Unit = udg_yH_Ass_Rogue
            call BlzEndUnitAbilityCooldown( udg_Temp_Unit, 'A04O' )
            // Combo Gen
            call DestroyEffectBJ( udg_HAssComboEffects[0] )
            call DestroyEffectBJ( udg_HAssComboEffects[1] )
            call DestroyEffectBJ( udg_HAssComboEffects[2] )
            call AddSpecialEffectTargetUnitBJ( "overhead", udg_Temp_Unit, "RedSpellOrb.mdx" )
            call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.18 )
            set udg_HAssComboEffects[0] = GetLastCreatedEffectBJ()
            call AddSpecialEffectTargetUnitBJ( "right hand", udg_Temp_Unit, "RedSpellOrb.mdx" )
            call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.18 )
            set udg_HAssComboEffects[1] = GetLastCreatedEffectBJ()
            call AddSpecialEffectTargetUnitBJ( "left hand", udg_Temp_Unit, "RedSpellOrb.mdx" )
            call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.18 )
            set udg_HAssComboEffects[2] = GetLastCreatedEffectBJ()
            set udg_HAssComboPoints = 3.00
            set udg_SpellUnits[ udg_o + 0 ] = null
            call CreateTextTagUnitBJ( "TRIGSTR_8643", udg_Temp_Unit, 10.00, 8.00, 100, 100, 0.00, 0 )
            call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64, 0.00 )
            call cleanUpText (1.0, 0.5)
            call ShowTextTagForceBJ( true, GetLastCreatedTextTag(), udg_HordePlayers )
            call ComboPointFrameSetPoints( udg_yH_Ass_Rogue, udg_HAssComboPoints)
        else
        endif
    endif
    set udg_Temp_Unit = null
endfunction

//===========================================================================
function InitTrig_Marked_For_Death_DIES takes nothing returns nothing
    set gg_trg_Marked_For_Death_DIES = CreateTrigger(  )
    call DisableTrigger( gg_trg_Marked_For_Death_DIES )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Marked_For_Death_DIES, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddAction( gg_trg_Marked_For_Death_DIES, function Trig_Marked_For_Death_DIES_Actions )
endfunction

//===========================================================================
// Trigger: Marked For Death Buff Check
//===========================================================================
function Trig_Marked_For_Death_Buff_Check_Func001C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(udg_SpellUnits[( udg_z_RO_ASSA_A + 0 )], 'B01B') == false ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_SpellUnits[( udg_z_RO_ASSA_H + 0 )], 'B01B') == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Marked_For_Death_Buff_Check_Actions takes nothing returns nothing
    if ( Trig_Marked_For_Death_Buff_Check_Func001C() ) then
        call DisableTrigger( gg_trg_Marked_For_Death_DIES)
        set udg_SpellUnits[ udg_z_RO_ASSA_A ] = null
        set udg_SpellUnits[ udg_z_RO_ASSA_H ] = null
        call DisableTrigger( GetTriggeringTrigger() )
    else
    endif
endfunction

//===========================================================================
function InitTrig_Marked_For_Death_Buff_Check takes nothing returns nothing
    set gg_trg_Marked_For_Death_Buff_Check = CreateTrigger(  )
    call DisableTrigger( gg_trg_Marked_For_Death_Buff_Check )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Marked_For_Death_Buff_Check, 0.05 )
    call TriggerAddAction( gg_trg_Marked_For_Death_Buff_Check, function Trig_Marked_For_Death_Buff_Check_Actions )
endfunction

