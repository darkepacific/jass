    if ( Trig_Hyrdas_Func020C() ) then
        call TriggerSleepAction( 80.00 )
        if ( Trig_Hyrdas_Func020Func002C() ) then
            set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_Hyrdas_1)
            call CreateNUnitsAtLoc( 1, 'nhyh', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
        else
            if ( Trig_Hyrdas_Func020Func002Func003C() ) then
                set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_Hyrdas_2)
                call CreateNUnitsAtLoc( 1, 'nhyh', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
            else
                set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_Hyrdas_3)
                call CreateNUnitsAtLoc( 1, 'nhyh', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
            endif
