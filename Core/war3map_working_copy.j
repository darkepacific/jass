function InitTrig_E_AWT takes nothing returns nothing
    set gg_trg_E_AWT = CreateTrigger(  )
    call DisableTrigger( gg_trg_E_AWT )
    call TriggerRegisterEnterRectSimple( gg_trg_E_AWT, gg_rct_A_Wretched_Task )
    call TriggerRegisterUnitInRangeSimple( gg_trg_E_AWT, 256, gg_unit_h01U_0238 )
