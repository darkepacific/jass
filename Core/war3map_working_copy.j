//===========================================================================
function Trig_Second_Wind_Mana_Toggle_Conditions takes nothing returns boolean
    if ( not ( GetPlayerController(GetOwningPlayer(GetTriggerUnit())) == MAP_CONTROL_USER ) ) then
        return false
    endif
    return true
endfunction

function Trig_Second_Wind_Mana_Toggle_Func003C takes nothing returns boolean
    if ( not ( TimerGetRemaining(udg_DamageTimer[udg_Player_Number]) <= 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Second_Wind_Mana_Toggle_Actions takes nothing returns nothing
    call PlayerNumbtoHeroesNumb()
    if ( Trig_Second_Wind_Mana_Toggle_Func003C() ) then
        call OutOfCombat( GetTriggerUnit() )
    else
    endif
    if IsTriggerEnabled(gg_trg_Second_Wind_Arms_A) == false then
    if IsTriggerEnabled(gg_trg_Second_Wind_Arms_H) == false then
    if IsTriggerEnabled(gg_trg_Second_Wind_Prot_A) == false then
    if IsTriggerEnabled(gg_trg_Second_Wind_Prot_H) == false then
    call DisableTrigger( GetTriggeringTrigger() )
    endif
    endif
    endif
    endif
endfunction

