//===========================================================================
// Trigger: Critter Spawn
//===========================================================================
function Trig_Critter_Spawn_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    // Albatross
    set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_Eversong_Crabs_and_Seagulls)
    call CreateNUnitsAtLoc( 2, 'nalb', Player(PLAYER_NEUTRAL_PASSIVE), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_Naga_Royal_Guards_East)
    call CreateNUnitsAtLoc( 2, 'nalb', Player(PLAYER_NEUTRAL_PASSIVE), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
    call RemoveLocation (udg_Temp_Unit_Point)
    // Bats
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 4
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_Tirisfal_Bats)
        call CreateNUnitsAtLoc( 1, 'nbat', Player(PLAYER_NEUTRAL_PASSIVE), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
        call RemoveLocation (udg_Temp_Unit_Point)
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
