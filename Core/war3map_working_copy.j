            call SetPlayerAbilityAvailableBJ( true, 'A031', GetOwningPlayer(udg_yA_Feral_Druid) )
            call SetPlayerAbilityAvailableBJ( false, 'A035', GetOwningPlayer(udg_yA_Feral_Druid) )
        else
