    return ( GetRandomInt(1, 6) == 1 )
endfunction

function Trig_U_Find_Dolly_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    local boolean drop = false
    if ( Trig_U_Find_Dolly_Func003C() ) then
        set drop = true
    else
        if ( Trig_U_Find_Dolly_Func003Func003C() ) then
            set drop = true
        else
        endif
    endif
    if drop then
    set udg_Temp_Unit_Point = GetUnitLoc(GetDyingUnit())
    if ( Trig_U_Find_Dolly_Func006001() ) then
        call CreateItemLoc( 'I079', udg_Temp_Unit_Point )
    else
        call DoNothing(  )
    endif
    call RemoveLocation (udg_Temp_Unit_Point)
    endif
    set udg_Temp_Unit_Point = null
endfunction

