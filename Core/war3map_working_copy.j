function InitTrig_E_TPL takes nothing returns nothing
    set gg_trg_E_TPL = CreateTrigger(  )
    call DisableTrigger( gg_trg_E_TPL )
    call TriggerRegisterEnterRectSimple( gg_trg_E_TPL, gg_rct_Proving_Allegiance )
    call TriggerRegisterUnitInRangeSimple( gg_trg_E_TPL, 256, gg_unit_Ulic_0007 )
    call TriggerAddAction( gg_trg_E_TPL, function Trig_E_TPL_Actions )
