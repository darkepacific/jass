// Trigger: Conscecration
//===========================================================================
function Trig_Conscecration_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A00M' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Conscecration_Func009C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(udg_Temp_Unit, 'B01F') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Conscecration_Func012A takes nothing returns nothing
    if IsUnitTargetableEnemyGround( GetEnumUnit(), udg_Temp_Unit ) then
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_Conscecration_Func016Func008Func003C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(udg_Temp_Unit, 'B01F') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Conscecration_Func016Func008A takes nothing returns nothing
    if IsUnitTargetableEnemyGround( GetEnumUnit(), udg_Temp_Unit ) then
    set udg_RealStatCalc =I2R(BlzGetUnitMaxHP(GetEnumUnit())) * ( 2.00 + ( I2R(udg_HeroStatCalc) / 20.00 ) ) 
    if ( Trig_Conscecration_Func016Func008Func003C() ) then
        set udg_Temp_Real = ( ( 0.10 * I2R(( GetUnitAbilityLevelSwapped('A0AQ', udg_Temp_Unit) + 1 )) ) + 1.00 )
        set udg_RealStatCalc = ( udg_Temp_Real * udg_RealStatCalc )
    else
    endif
    set udg_RealStatCalc = ( udg_RealStatCalc / 100.00 )
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call AddSpecialEffectTargetUnitBJ( "overhead", GetEnumUnit(), "Abilities\\Spells\\Other\\ImmolationRed\\ImmolationRedDamage.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set udg_Temp_Int = 1
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_Conscecration_Func016Func010C takes nothing returns boolean
    if ( not ( udg_Temp_Int > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Conscecration_Func016C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Temp_Unit) == true ) ) then
        return false
    endif
    return true
endfunction

