    set udg_XP = udg_QUEST_XP[udg_Temp_Int]
    set udg_Gold = udg_QUEST_GOLD[udg_Temp_Int]
    set udg_LVL_Req = udg_QUEST_LVL_REQ[udg_Temp_Int]
    set udg_TempString = "Kill Magni"
    call TriggerExecute( gg_trg_Quest_Complete_H )
    call DisableTrigger( GetTriggeringTrigger() )
    if udg_GameMode == "PVP" then
    if ( Trig_E_Kill_Magni_Func017C() ) then
        call QuestMessageBJ( GetPlayersAll(), bj_QUESTMESSAGE_ALWAYSHINT, "TRIGSTR_5232" )
        call PlaySoundBJ( gg_snd_GameFound )
        call DisableTrigger( gg_trg_E_Kill_Sylvanas )
        call DisableTrigger( gg_trg_E_Kill_Lorthemar )
        call GameTimeWait(9.0)
        call ForForce( udg_HordePlayers, function Trig_E_Kill_Magni_Func017Func006A )
        call ForForce( udg_AlliancePlayers, function Trig_E_Kill_Magni_Func017Func007A )
    else
    endif
    endif
endfunction

