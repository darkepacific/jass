//===========================================================================
// Trigger: Black Arrow WG Jass
//===========================================================================
function Trig_Black_Arrow_WG_Jass_Conditions takes nothing returns boolean
    if ( not ( GetDyingUnit() == udg_SpellUnits[udg_z_HU_DARK_A] ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_MECHANICAL) == false ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetTriggerUnit()) != Player(PLAYER_NEUTRAL_PASSIVE) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Black_Arrow_WG_Jass_Actions takes nothing returns nothing
    local location Dying_Unit_Point = GetUnitLoc( udg_SpellUnits[udg_z_HU_DARK_A] )
    call AddSpecialEffectLocBJ( Dying_Unit_Point, "Abilities\\Spells\\Undead\\RaiseSkeletonWarrior\\RaiseSkeleton.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )

    call CreateDarkMinion(udg_yA_Dark_Ranger, Dying_Unit_Point)
    call RemoveLocation (Dying_Unit_Point)

    set Dying_Unit_Point = null
endfunction

