function Trig_TEST_Func002C takes nothing returns boolean
    if ( not Trig_TEST_Func002Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_TEST_Actions takes nothing returns nothing
    set udg_TempString = SubStringBJ(GetEventPlayerChatString(), 6, 6)
    if ( Trig_TEST_Func002C() ) then
        set udg_TempString = SubStringBJ(GetEventPlayerChatString(), 7, 8)
        set udg_Temp_Int = S2I(udg_TempString)
        if ( Trig_TEST_Func002Func004C() ) then
            set udg_Temp_Int = 5
        else
        endif
        set bj_forLoopAIndex = 1
        set bj_forLoopAIndexEnd = udg_Temp_Int
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_TempIsland)
            call CreateNUnitsAtLoc( 1, 'n049', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
            call RemoveLocation (udg_Temp_Unit_Point)
            if udg_TempString == "m" then
            call SetUnitMoveSpeed( GetLastCreatedUnit(), 50.00 )
            endif
            set bj_forLoopAIndex = bj_forLoopAIndex + 1
        endloop
    else
        if ( Trig_TEST_Func002Func006C() ) then
            set udg_TempString = SubStringBJ(GetEventPlayerChatString(), 7, 8)
            set udg_Temp_Int = S2I(udg_TempString)
            if ( Trig_TEST_Func002Func006Func004C() ) then
                set udg_Temp_Int = 5
            else
            endif
            set bj_forLoopAIndex = 1
            set bj_forLoopAIndexEnd = udg_Temp_Int
            loop
                exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
                set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_TempIsland)
                call CreateNUnitsAtLoc( 1, 'hhdl', GetTriggerPlayer(), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
                    call BlzSetUnitMaxHP( GetLastCreatedUnit(), 10000 )
                    call SetUnitLifeBJ( GetLastCreatedUnit(), 100 )
                call RemoveLocation (udg_Temp_Unit_Point)
                set bj_forLoopAIndex = bj_forLoopAIndex + 1
            endloop
        else
            if ( Trig_TEST_Func002Func006Func001C() ) then
                set udg_TempString = SubStringBJ(GetEventPlayerChatString(), 7, 8)
                set udg_Temp_Int = S2I(udg_TempString)
                if ( Trig_TEST_Func002Func006Func001Func006C() ) then
                    set udg_Temp_Int = 1
                else
                endif
                set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_TempIsland)
                call CreateNUnitsAtLoc( 1, 'Hgam', Player(PLAYER_NEUTRAL_PASSIVE), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
                    call SetHeroLevelBJ( GetLastCreatedUnit(), udg_Temp_Int, true )
                call RemoveLocation (udg_Temp_Unit_Point)
            else
                set udg_TempString = SubStringBJ(GetEventPlayerChatString(), 6, 8)
                set udg_Temp_Int = S2I(udg_TempString)
                if ( Trig_TEST_Func002Func006Func001Func003C() ) then
                    set udg_Temp_Int = 5
                else
                endif
                set bj_forLoopAIndex = 1
                set bj_forLoopAIndexEnd = udg_Temp_Int
                loop
                    exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
                    set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_TempIsland)
                    call CreateNUnitsAtLoc( 1, 'n03R', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
                    call RemoveLocation (udg_Temp_Unit_Point)
                    set bj_forLoopAIndex = bj_forLoopAIndex + 1
                endloop
            endif
        endif
    endif
endfunction

