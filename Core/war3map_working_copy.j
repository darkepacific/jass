//===========================================================================
// Trigger: E BFF H
//===========================================================================
function Trig_E_BFF_H_Func002C takes nothing returns boolean
    if ( not ( udg_QDeedB_H >= 1.00 ) ) then
        return false
    endif
    if ( not ( udg_QDeedCD_H >= 1.00 ) ) then
        return false
    endif
    if ( not ( udg_QDeedSS_H >= 1.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_E_BFF_H_Conditions takes nothing returns boolean
    if ( not Trig_E_BFF_H_Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_E_BFF_H_Func023C takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_Quests[74]) == true ) ) then
        return false
    endif
    if ( not ( IsQuestCompleted(udg_Quests[73]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_E_BFF_H_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 73
    if IsHordePlayer( GetLocalPlayer() ) then
    call FlashQuestDialogButtonBJ(  )
    endif
    call DestroyEffectBJ( udg_QuestMarks[udg_Temp_Int] )
    call QuestSetCompletedBJ( udg_Quests[udg_Temp_Int], true )
    call QuestItemSetCompletedBJ( udg_QuestReqs[udg_Temp_Int], true )
    call DestroyMinimapIcon( udg_MiniMapIcon[udg_Temp_Int] )
    // Rewards
    set udg_XP = udg_QUEST_XP[udg_Temp_Int]
    set udg_Gold = udg_QUEST_GOLD[udg_Temp_Int]
    set udg_LVL_Req = udg_QUEST_LVL_REQ[udg_Temp_Int]
    set udg_TempString = "Barov Family Fortune"
    call TriggerExecute( gg_trg_Quest_Complete_H )
    // Triggers
    call DisableTrigger(gg_trg_U_BFF_H)
    call DisableTrigger(gg_trg_H_BFF_H)
    call DisableTrigger( GetTriggeringTrigger() )
    if ( Trig_E_BFF_H_Func023C() ) then
        set udg_ItemTypeCheck = 'I07K'
        call CleanUpItems( udg_ItemTypeCheck )
        set udg_ItemTypeCheck = 'I07J'
        call CleanUpItems( udg_ItemTypeCheck )
        set udg_ItemTypeCheck = 'I07L'
        call CleanUpItems( udg_ItemTypeCheck )
        call DisableTrigger(gg_trg_D_BFF)
    else
    endif
    call GameTimeWait(0.8)
    call TriggerExecute(gg_trg_M_TOBB_H)
endfunction

//===========================================================================
function InitTrig_E_BFF_H takes nothing returns nothing
    set gg_trg_E_BFF_H = CreateTrigger(  )
    call DisableTrigger( gg_trg_E_BFF_H )
    call TriggerRegisterVariableEvent( gg_trg_E_BFF_H, "udg_QDeedB_H", GREATER_THAN_OR_EQUAL, 1.00 )
    call TriggerRegisterVariableEvent( gg_trg_E_BFF_H, "udg_QDeedCD_H", GREATER_THAN_OR_EQUAL, 1.00 )
    call TriggerRegisterVariableEvent( gg_trg_E_BFF_H, "udg_QDeedSS_H", GREATER_THAN_OR_EQUAL, 1.00 )
    call TriggerAddCondition( gg_trg_E_BFF_H, Condition( function Trig_E_BFF_H_Conditions ) )
    call TriggerAddAction( gg_trg_E_BFF_H, function Trig_E_BFF_H_Actions )
endfunction

