//===========================================================================
// Trigger: Ghost Wolf Cast Dwarf
//
// Begins
//===========================================================================
function Trig_Ghost_Wolf_Cast_Dwarf_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0AE' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Ghost_Wolf_Cast_Dwarf_Actions takes nothing returns nothing
    if ( GetTriggerUnit() == udg_yA_Resto_Sham) then
    call SetPlayerAbilityAvailableBJ( false, 'A09S', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'AOcl', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'A0AD', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'A03C', GetOwningPlayer(GetTriggerUnit()) )
    call SpiritwalkersGrace( udg_yA_Resto_Sham, 4)
    call HasBanshees( GetTriggerUnit() )
    call DisableTrigger( GetTriggeringTrigger() )
    call SetUnitVertexColorBJ( GetTriggerUnit(), 100.00, 100.00, 100.00, 33.33 )
    call SetUnitAbilityLevelSwapped( 'A0AF', GetTriggerUnit(), GetUnitAbilityLevelSwapped('A0AE', GetTriggerUnit()) )
    call TriggerSleepAction( 0.75 )
    call EnableTrigger( gg_trg_Ghost_Wolf_Unmorph_Dwarf )
    endif
endfunction

