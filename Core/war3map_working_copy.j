//===========================================================================
// Trigger: Cleave
//===========================================================================
function Trig_Cleave_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A04M' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cleave_Func020A takes nothing returns nothing
    if IsUnitTargetableEnemyParams( GetEnumUnit(), udg_Temp_Unit, false, true, false, false) then
    set udg_Temp_Int = ( udg_Temp_Int + 1 )
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_Cleave_Func022Func006C takes nothing returns boolean
    if ( not ( udg_RealStatCalc <= 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cleave_Func022C takes nothing returns boolean
    if ( not ( udg_Temp_Int > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cleave_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    set udg_Temp_Unit = GetTriggerUnit()
    call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
    set udg_Temp_Int = 0
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
    // cleaver effect
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Cleaver.mdx" )
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), ( BlzGetLocalSpecialEffectZ(GetLastCreatedEffectBJ()) + 50.00 ) )
    call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 2.50 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    // end effect
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 2.50 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A04M', udg_Temp_Unit) * 55 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 5 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A04M'), ABILITY_RLF_AOE_DAMAGE, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), udg_RealStatCalc )
    call DragonRoarSet()
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(290.00, udg_Temp_Unit_Point), function Trig_Cleave_Func020A )
    call RemoveLocation (udg_Temp_Unit_Point)
    if ( Trig_Cleave_Func022C() ) then
        if udg_Temp_Int > 4 then
        set udg_Temp_Int = 4
        endif
        set udg_RealStatCalc = BlzGetUnitAbilityCooldownRemaining(udg_Temp_Unit, 'A02H')
        set udg_RealStatCalc = ( udg_RealStatCalc - ( 2.00 * I2R(udg_Temp_Int) ) )
        if ( Trig_Cleave_Func022Func006C() ) then
            set udg_RealStatCalc = 0.10
        else
        endif
        call BlzStartUnitAbilityCooldown( udg_Temp_Unit, 'A02H', udg_RealStatCalc )
    else
    endif
    set udg_Temp_Unit_Point = null
    return
    // used to have facing angle logic here
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL )
endfunction

//===========================================================================
function InitTrig_Cleave takes nothing returns nothing
    set gg_trg_Cleave = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Cleave, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Cleave, Condition( function Trig_Cleave_Conditions ) )
    call TriggerAddAction( gg_trg_Cleave, function Trig_Cleave_Actions )
endfunction

//===========================================================================
// Trigger: Second Wind Arms A
//===========================================================================
function Trig_Second_Wind_Arms_A_Actions takes nothing returns nothing
    set udg_Temp_Unit = udg_yA_Arms_Warr
     if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 13 ]  then
    call MaxHPSelfHeal( 0.06)
    call MaxManaRestore( 0.06, udg_Temp_Unit)
    call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "war3mapImported\\VampiricAuraTarget.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    if GetUnitState( udg_Temp_Unit, UNIT_STATE_LIFE ) ==  GetUnitState( udg_Temp_Unit, UNIT_STATE_MAX_LIFE) then
    if GetUnitState( udg_Temp_Unit, UNIT_STATE_MANA ) ==  GetUnitState( udg_Temp_Unit, UNIT_STATE_MAX_MANA) then
    call DisableTrigger( GetTriggeringTrigger() )
    endif
    endif
    else
    call DisableTrigger( GetTriggeringTrigger() )
    endif
endfunction

