    if ( Trig_MS_BFH_A_Func040Func006Func001C() ) then
        call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), 1375.00, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL )
    else
    endif
endfunction

function Trig_MS_BFH_A_Func040C takes nothing returns boolean
    if ( not ( GetOwningPlayer(gg_unit_ncop_1859) == Player(1) ) ) then
        return false
    endif
    return true
endfunction

function Trig_MS_BFH_A_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 88
    local location udg_Temp_Unit_Point
    call DisableTrigger( GetTriggeringTrigger() )
    call SetUnitInvulnerable( gg_unit_H00A_0289, false )
    if ( Trig_MS_BFH_A_Func005C() ) then
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Q_42M)
    else
        if ( Trig_MS_BFH_A_Func005Func001C() ) then
            set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Q_43M)
        else
            if ( Trig_MS_BFH_A_Func005Func001Func001C() ) then
                set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Q_44M)
            else
                if ( Trig_MS_BFH_A_Func005Func001Func001Func001C() ) then
                    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Q_45M)
                else
                endif
            endif
        endif
    endif
    call SetUnitPositionLoc( GetSummonedUnit(), udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_BattleForHillsbrad[1] = GetSummonedUnit()
    set udg_TempString = ""
    if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
    set udg_TempString = udg_ExclamationMark
    endif
    call AddSpecialEffectTargetUnitBJ( "overhead", udg_BattleForHillsbrad[1], udg_TempString )
    call BlzSetSpecialEffectColor( GetLastCreatedEffectBJ(), 255, 255, 255 )
    set udg_QuestMarks[88] = GetLastCreatedEffectBJ()
    call PlaySoundOnUnitBJ( gg_snd_QuestAutoComplete, 100.00, udg_BattleForHillsbrad[1] )
    call TriggerSleepAction( 2.25 )
    set udg_TempString = "Excellent work. But the Forsaken will not yield, and other foes gather. Durnholde Keep, east of Tarren Mill, now shelters the Syndicate and overlooks our lands. Capture it and secure this strategic stronghold for the Alliance."
    // Set Quest Rewards
    set udg_QUEST_XP[udg_Temp_Int] = 900
    set udg_QUEST_GOLD[udg_Temp_Int] = 400
    set udg_QUEST_LVL_REQ[udg_Temp_Int] = udg_QUEST_ZONE_3_LVL_REQ
    call QuestRewards_TextSet(udg_Temp_Int)
    // End Set Quest Rewards
    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_678", udg_TempString, "ReplaceableTextures\\CommandButtons\\BTNKeep.blp" )
    set udg_Quests[88] = GetLastCreatedQuestBJ()
    call QuestSetEnabledBJ( false, udg_Quests[88] )
    if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
    call QuestSetEnabledBJ( true, udg_Quests[88] )
    call FlashQuestDialogButtonBJ(  )
    endif
    set udg_TempString = "Battle for Hillsbrad"
    set udg_TempString_Quest = "Capture Durnholde Keep."
    call TriggerExecute( gg_trg_Quest_Start_A )
    call DestroyEffectBJ( udg_QuestMarks[88] )
    call QuestSetCompletedBJ( udg_Quests[88], false )
    call CreateQuestItemBJ( udg_Quests[88], "TRIGSTR_680" )
    set udg_QuestReqs[88] = GetLastCreatedQuestItemBJ()
    call EnableTrigger( gg_trg_E_BFH_A )
    if ( Trig_MS_BFH_A_Func040C() ) then
        set udg_TowerHeroes[6] = gg_unit_n026_0866
        call PauseTimerBJ( true, udg_TowerTimers[6] )
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Durnholde_Damage)
        set udg_Temp_Unit = gg_unit_Uktl_0568
        set bj_wantDestroyGroup = true
        call ForGroupBJ( GetUnitsInRangeOfLocAll(500.00, udg_Temp_Unit_Point), function Trig_MS_BFH_A_Func040Func006A )
        call RemoveLocation (udg_Temp_Unit_Point)
        call TriggerExecute( gg_trg_Durnholde_Keep_Capture )
    else
    endif
    set udg_Temp_Unit_Point = null
endfunction

