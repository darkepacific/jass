//*  Shop Hints

//***************************************************************************
//*  Ress Helpers
	function DebugRess takes destructable d returns nothing
		call Debug("Destructable: " + GetDestructableName(d))
		call Debug("Destructable X: " + R2S(GetDestructableX(d)) + "Y: " + R2S(GetDestructableY(d)) )
