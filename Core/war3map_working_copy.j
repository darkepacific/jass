//===========================================================================
// Trigger: Dwarf Cage Destroyed
//===========================================================================
function Trig_Dwarf_Cage_Destroyed_Conditions takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetDyingDestructable()) == 'LOcg' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dwarf_Cage_Destroyed_Func012Func003C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 4) > 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dwarf_Cage_Destroyed_Func012C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 3) > 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dwarf_Cage_Destroyed_Actions takes nothing returns nothing
    local unit Dwarf
    local destructable Cage = GetDyingDestructable()
    local location udg_Temp_Unit_Point
    local location udg_Temp_Polar_Point
    set udg_Temp_Polar_Point = GetRectCenter(gg_rct_Z_Highbank_14)
    set udg_Temp_Unit_Point = GetDestructableLoc(GetDyingDestructable())
    call CreateNUnitsAtLocFacingLocBJ( 1, 'e04K', Player(11), udg_Temp_Unit_Point, udg_Temp_Polar_Point )
    set Dwarf = GetLastCreatedUnit()
    call RemoveLocation (udg_Temp_Unit_Point)
    call RemoveLocation (udg_Temp_Polar_Point)
    if ( Trig_Dwarf_Cage_Destroyed_Func012C() ) then
        call PlaySoundOnUnitBJ( gg_snd_DwarfMaleFlee01, 100.00, Dwarf )
         call CreateTextTagUnitBJ( "Run Away!", Dwarf, 0.00, 8.00, 100.00, 100.00, 0.00, 0 )
    else
        if ( Trig_Dwarf_Cage_Destroyed_Func012Func003C() ) then
            call PlaySoundOnUnitBJ( gg_snd_DwarfMaleFlee02, 100.00, Dwarf )
             call CreateTextTagUnitBJ( "Let's Run!", Dwarf, 0.00, 8.00, 100.00, 100.00, 0.00, 0 )
        else
            call PlaySoundOnUnitBJ( gg_snd_DwarfMaleFlee03, 100.00, Dwarf )
             call CreateTextTagUnitBJ( "Run!!", Dwarf, 0.00, 8.00, 100.00, 100.00, 0.00, 0 )
        endif
    endif
    call ShowTextTagForceBJ( true, GetLastCreatedTextTag(), GetPlayersAll() )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
    call cleanUpText(1.2, 0.9)
    set udg_Temp_Polar_Point = GetRectCenter(gg_rct_Z_Highbank_14)
    call IssuePointOrderLocBJ(Dwarf, "move", udg_Temp_Polar_Point )
    call RemoveLocation (udg_Temp_Polar_Point)
    call TriggerSleepAction( 50.00 )
    call DestructableRestoreLife( Cage, 50.00, false )
    set Dwarf = null
    set Cage = null
    set udg_Temp_Unit_Point = null
    set udg_Temp_Polar_Point = null
endfunction

//===========================================================================
function InitTrig_Dwarf_Cage_Destroyed takes nothing returns nothing
    set gg_trg_Dwarf_Cage_Destroyed = CreateTrigger(  )
    call TriggerRegisterDestDeathInRegionEvent( gg_trg_Dwarf_Cage_Destroyed, gg_rct_Z_Bastion_of_Twilight_14 )
    call TriggerRegisterDestDeathInRegionEvent( gg_trg_Dwarf_Cage_Destroyed, gg_rct_Z_Bastion_of_Twilight_South )
    call TriggerRegisterDestDeathInRegionEvent( gg_trg_Dwarf_Cage_Destroyed, gg_rct_QSaveTheDwarvesOuter )
    call TriggerRegisterDestDeathInRegionEvent( gg_trg_Dwarf_Cage_Destroyed, gg_rct_QSaveTheDwarvesInner )
    call TriggerAddCondition( gg_trg_Dwarf_Cage_Destroyed, Condition( function Trig_Dwarf_Cage_Destroyed_Conditions ) )
    call TriggerAddAction( gg_trg_Dwarf_Cage_Destroyed, function Trig_Dwarf_Cage_Destroyed_Actions )
endfunction

