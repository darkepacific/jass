function Trig_Footman_Thornby_Dies_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    call TriggerSleepAction( 120.00 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Kobolds_and_Catacombs)
    call CreateNUnitsAtLoc( 1, 'h02O', Player(1), udg_Temp_Unit_Point, 185.00 )
    call RemoveLocation (udg_Temp_Unit_Point)
    if ( Trig_Footman_Thornby_Dies_Func006C() ) then
        call DestroyEffectBJ( udg_QuestMarks[76] )
        set udg_TempString = ""
        if ( Trig_Footman_Thornby_Dies_Func006Func003C() ) then
            if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
            set udg_TempString = udg_ExclamationMark
            endif
            call AddSpecialEffectTargetUnitBJ( "overhead", GetLastCreatedUnit(), udg_TempString )
            set udg_QuestMarks[76] = GetLastCreatedEffectBJ()
        else
            if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
            set udg_TempString = udg_QuestionMark
            endif
            call AddSpecialEffectTargetUnitBJ( "overhead", GetLastCreatedUnit(), udg_TempString )
            set udg_QuestMarks[76] = GetLastCreatedEffectBJ()
        endif
    else
    endif
    set udg_Temp_Unit_Point = null
endfunction

