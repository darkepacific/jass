//===========================================================================
// Trigger: Muru
//
// https://www.youtube.com/watch?v=bmpVXEQYIcg
// Add an out of combat timer, if it trigger hide Entrop and go back to Muru
//===========================================================================
function Trig_Muru_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    set udg_Temp_Unit_Point = GetUnitLoc(GetDyingUnit())
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Spells\\Undead\\DarkRitual\\DarkRitualTarget.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call PlaySoundAtPointBJ( gg_snd_SPELL_Naaru_Lura_NaarusLament_End_2, 100.00, udg_Temp_Unit_Point, 500.00 )
    call TriggerSleepAction( 1.25 )
    call PlaySoundAtPointBJ( gg_snd_DemonHunterMorph1, 100.00, udg_Temp_Unit_Point, 500.00 )
    call RemoveLocation (udg_Temp_Unit_Point)
    call HideHero( GetTriggerUnit() )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Muru)
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Spells\\Human\\ManaFlare\\ManaFlareBoltImpact.mdl" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 2.00 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call ShowHero( gg_unit_H03X_2614, udg_Temp_Unit_Point, false )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TimerStart(Entropius_Damage_Timer, udg_BOSS_COMBAT_TIMER, false, function Trig_Entropius_Dmg_Timer_Actions)
    set udg_Temp_Unit_Point = null
endfunction

