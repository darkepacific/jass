function InitTrig_Greymane_Gate_Dies takes nothing returns nothing
    set gg_trg_Greymane_Gate_Dies = CreateTrigger(  )
    call TriggerRegisterDeathEvent( gg_trg_Greymane_Gate_Dies, gg_dest_DTg8_0488 )
    call TriggerAddAction( gg_trg_Greymane_Gate_Dies, function Trig_Greymane_Gate_Dies_Actions )
