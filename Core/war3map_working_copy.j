//===========================================================================
function Trig_U_Hurts_So_Good_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'Ashs' ) ) then
        return false
    endif
    return true
endfunction

function Trig_U_Hurts_So_Good_Func002Func011C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 4) <= 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_U_Hurts_So_Good_Func002C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetSpellTargetUnit()) == 'h02A' ) ) then
        return false
    endif
    return true
endfunction

function Trig_U_Hurts_So_Good_Actions takes nothing returns nothing
    local unit WorgenPeasant
    if ( Trig_U_Hurts_So_Good_Func002C() ) then
        call PlaySoundOnUnitBJ( gg_snd_whip4, 85.00, GetTriggerUnit() )
        set WorgenPeasant = GetSpellTargetUnit()
        set udg_QuestWorgenPeasants = ( udg_QuestWorgenPeasants + 1 )
        call QuestItemSetDescriptionBJ( udg_QuestReqs[64], ( "Worgen Peasants Whipped - " + ( I2S(R2I(udg_QuestWorgenPeasants)) + "/12" ) ) )
        call TriggerSleepAction( 0.65 )
        call SetUnitMoveSpeed( WorgenPeasant, ( GetUnitDefaultMoveSpeed(WorgenPeasant) + 25.00 ) )
        if ( Trig_U_Hurts_So_Good_Func002Func011C() ) then
            call PlaySoundOnUnitBJ( gg_snd_WolfDeath1, 90.00, WorgenPeasant )
        else
            call PlaySoundOnUnitBJ( gg_snd_Wolf1, 90.00, WorgenPeasant )
            call SetUnitInvulnerable( WorgenPeasant, false )
            call IssueTargetOrderBJ( WorgenPeasant, "attack", GetTriggerUnit() )
            call CreateTextTagUnitBJ( "TRIGSTR_3597", GetTriggerUnit(), 0.00, 10.00, 100.00, 0.00, 0.00, 0 )
            call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
            call cleanUpText(0.6, 0.4)
        endif
        call TriggerSleepAction( 10.00 )
        call SetUnitMoveSpeed( WorgenPeasant, ( GetUnitDefaultMoveSpeed(WorgenPeasant) ) )
    else
        call IssueImmediateOrderBJ( GetTriggerUnit(), "stop" )
        if GetLocalPlayer() == GetOwningPlayer(GetTriggerUnit()) then
        call PlaySoundBJ( gg_snd_Error )
        endif
    endif
    set WorgenPeasant = null
endfunction

