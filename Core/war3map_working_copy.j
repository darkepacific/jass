//===========================================================================
// Trigger: Tree Unmorph TA
//
// Begins and wiats .40s
//===========================================================================
function Trig_Tree_Unmorph_TA_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0D2' ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetTriggerUnit()) != Player(PLAYER_NEUTRAL_AGGRESSIVE) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Tree_Unmorph_TA_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    call SetPlayerAbilityAvailableBJ( true, 'A0D1', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A0D0', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'A03B', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'A033', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A091', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A0E1', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A0E4', GetOwningPlayer(GetTriggerUnit()) )
    call HasBanshees( GetTriggerUnit() )
    call EnableTrigger( gg_trg_Tree_Cast_TA )
endfunction

//===========================================================================
function InitTrig_Tree_Unmorph_TA takes nothing returns nothing
    set gg_trg_Tree_Unmorph_TA = CreateTrigger(  )
    call DisableTrigger( gg_trg_Tree_Unmorph_TA )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Tree_Unmorph_TA, EVENT_PLAYER_UNIT_SPELL_FINISH )
    call TriggerAddCondition( gg_trg_Tree_Unmorph_TA, Condition( function Trig_Tree_Unmorph_TA_Conditions ) )
    call TriggerAddAction( gg_trg_Tree_Unmorph_TA, function Trig_Tree_Unmorph_TA_Actions )
endfunction

//===========================================================================
// Trigger: H Bal Druid Dies
//===========================================================================
function Trig_H_Bal_Druid_Dies_Actions takes nothing returns nothing
    call GameTimeWait(1.5)
    call SetPlayerAbilityAvailableBJ( true, 'A0D1', GetOwningPlayer(GetTriggerUnit()) )
    call EnableTrigger( gg_trg_Owl_Cast_TA)
    call DisableTrigger( gg_trg_Owl_Unmorph_TA)
    call SetPlayerAbilityAvailableBJ( true, 'A0D2', GetOwningPlayer(GetTriggerUnit()) )
    call EnableTrigger( gg_trg_Tree_Cast_TA)
    call DisableTrigger( gg_trg_Tree_Unmorph_TA)
    call SetPlayerAbilityAvailableBJ( true, 'A030', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A0D0', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A02Y', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'A03B', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'A0CZ', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A091', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A0E1', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A0E4', GetOwningPlayer(GetTriggerUnit()) )
endfunction

//===========================================================================
