//===========================================================================
// Trigger: Desperate Prayer
//===========================================================================
function Trig_Desperate_Prayer_Actions takes nothing returns nothing
    local unit udg_Temp_Unit
    local real bonusHP
    call Debug( "Desperate Prayer Expired" )
    set bj_forLoopBIndex = 48
    set bj_forLoopBIndexEnd = 63
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        if GetExpiredTimer() == udg_CheatDeath[ bj_forLoopBIndex ] then
        if udg_CheatDeathBool[ bj_forLoopBIndex ] == true then
        set udg_CheatDeathBool[ bj_forLoopBIndex ] = false
        call Debug( "Starting Longer Desperate Prayer Timer:" + I2S(  bj_forLoopBIndex) )
        call StartTimerBJ( udg_CheatDeath[GetForLoopIndexB()], false, 45.00 )
        if bj_forLoopBIndex < 52 then
        set bonusHP = udg_DespPrayer_Disc_H
        set udg_Temp_Unit = udg_yH_Disc_Priest
        elseif bj_forLoopBIndex < 56 then
        set bonusHP = udg_DespPrayer_Disc_A
        set udg_Temp_Unit = udg_yA_Disc_Priest
        elseif bj_forLoopBIndex < 60 then
        set bonusHP = udg_DespPrayer_Holy_H
        set udg_Temp_Unit = udg_yH_Holy_Priest
        else
        set bonusHP = udg_DespPrayer_Holy_A
        set udg_Temp_Unit = udg_yA_Holy_Priest
        endif
        call Debug( "bonusHP" + R2S(bonusHP) )
        call BlzSetUnitMaxHP(udg_Temp_Unit, BlzGetUnitMaxHP(udg_Temp_Unit) - R2I( bonusHP ) )
        endif
        exitwhen true
        endif
        set bj_forLoopBIndex = bj_forLoopBIndex + 1
    endloop
    set udg_Temp_Unit = null
endfunction

