    call TriggerRegisterEnterRectSimple( gg_trg_S_SoG, gg_rct_The_SiegeOfGilneas )
    call TriggerRegisterUnitInRangeSimple( gg_trg_S_SoG, 256, gg_unit_H027_1820 )
