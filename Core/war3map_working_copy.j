//===========================================================================
// Trigger: Death Coil
//===========================================================================
function Trig_Death_Coil_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A001' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Death_Coil_Func011C takes nothing returns boolean
    if ( not ( IsUnitEnemy(GetSpellTargetUnit(), GetOwningPlayer(GetTriggerUnit())) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Death_Coil_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 3.00 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A001', udg_Temp_Unit) * 105 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 10 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 3 ]  then
    set udg_RealStatCalc = ( udg_RealStatCalc * 1.20 )
    call MissingHPSelfHeal( 0.016)
    endif
    if ( Trig_Death_Coil_Func011C() ) then
    else
        call ChaliceSet()
    endif
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A001'), ABILITY_RLF_AMOUNT_HEALED_DAMAGED_UDC1, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), udg_RealStatCalc )
    call MissingHPSelfHeal( 0.08)
endfunction

//===========================================================================
function InitTrig_Death_Coil takes nothing returns nothing
    set gg_trg_Death_Coil = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Death_Coil, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Death_Coil, Condition( function Trig_Death_Coil_Conditions ) )
    call TriggerAddAction( gg_trg_Death_Coil, function Trig_Death_Coil_Actions )
endfunction

//===========================================================================
// Trigger: Death Gate
//===========================================================================
function Trig_Death_Gate_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0FE' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Death_Gate_Func016C takes nothing returns boolean
    if ( not ( udg_SpellUnits[( udg_o + 0 )] == null ) ) then
        return false
    endif
    return true
endfunction

function Trig_Death_Gate_Func023C takes nothing returns boolean
    if ( not ( udg_SpellUnits[( udg_o + 1 )] == null ) ) then
        return false
    endif
    return true
endfunction

function Trig_Death_Gate_Actions takes nothing returns nothing
    local integer o
    set udg_Temp_Int = HeroesNumb(GetTriggerPlayer())
    set udg_DoRevive = false
    set udg_IsARezz = false
    if (  GetTriggerUnit() == udg_yA_Unholy_DK ) then
    set udg_o = udg_z_DK_UNHO_A
    call TriggerExecute(gg_trg_Death_Set_Alliance)
    elseif (  GetTriggerUnit() == udg_yH_Unholy_DK ) then
    set udg_o = udg_z_DK_UNHO_H
    call TriggerExecute(gg_trg_Death_Set_Horde)
    endif
    set udg_o = ( udg_o + 16 )
    set o = udg_o
    // Create or Move 0
    set udg_Temp_Unit_Point = udg_Temp_Z_Rev
    if ( Trig_Death_Gate_Func016C() ) then
        call SetUnitVertexColorBJ( GetLastCreatedUnit(), 88.00, 66.00, 100, 12.00 )
        call CreateNUnitsAtLoc( 1, 'e04H', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, GetRandomReal(250.00, 290.00) )
        set udg_SpellUnits[udg_o] = GetLastCreatedUnit()
        	call TriggerRegisterUnitInRangeSimple( gg_trg_Death_Gate_TP0, 64.00, udg_SpellUnits[ udg_o + 0 ]  )
    else
        call SetUnitPositionLoc(  udg_SpellUnits[ udg_o + 0 ], udg_Temp_Unit_Point )
        call BlzSetUnitFacingEx( udg_SpellUnits[udg_o], GetRandomReal(250.00, 290.00) )
    endif
    call RemoveLocation (udg_Temp_Unit_Point)
    call RemoveLocation (udg_Temp_Z_Rev)
    // Create or Move 1
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    call PlaySoundAtPointBJ( gg_snd_Diablo_2___Portal, 100, udg_Temp_Unit_Point, 0 )
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 110.00, GetUnitFacing(GetTriggerUnit()))
    if ( Trig_Death_Gate_Func023C() ) then
        call CreateNUnitsAtLoc( 1, 'e04H', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, ( 180.00 + GetUnitFacing(GetTriggerUnit()) ) )
        call SetUnitVertexColorBJ( GetLastCreatedUnit(), 100.00, 100.00, 100, 12.00 )
        set udg_SpellUnits[( udg_o + 1 )] = GetLastCreatedUnit()
        	call TriggerRegisterUnitInRangeSimple( gg_trg_Death_Gate_TP1, 64.00, udg_SpellUnits[ udg_o + 1 ]  )
    else
        call SetUnitPositionLoc(  udg_SpellUnits[ udg_o + 1 ], udg_Temp_Polar_Point )
        call BlzSetUnitFacingEx( udg_SpellUnits[( udg_o + 1 )], ( GetUnitFacing(GetTriggerUnit()) + 180.00 ) )
    endif
    call RemoveLocation (udg_Temp_Unit_Point)
    call RemoveLocation (udg_Temp_Polar_Point)
    // Move to Island
    set udg_HeroStatCalc = ( GetUnitLevel(GetTriggerUnit()) / 5 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 9 )
    call GameTimeWait( I2R(udg_HeroStatCalc) )
    set udg_o = o
    call DisableTrigger( gg_trg_Death_Gate_TP0)
    call DisableTrigger( gg_trg_Death_Gate_TP1)
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_DummyIsland)
    call SetUnitPositionLoc(  udg_SpellUnits[ udg_o + 0 ], udg_Temp_Unit_Point )
    call SetUnitPositionLoc(  udg_SpellUnits[ udg_o + 1 ], udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call EnableTrigger( gg_trg_Death_Gate_TP0)
    call EnableTrigger( gg_trg_Death_Gate_TP1)
    return
    call PlaySoundAtPointBJ( gg_snd_Diablo_Portal_Sound, 100, udg_Temp_X_Point, 0 )
endfunction

//===========================================================================
function InitTrig_Death_Gate takes nothing returns nothing
    set gg_trg_Death_Gate = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Death_Gate, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Death_Gate, Condition( function Trig_Death_Gate_Conditions ) )
    call TriggerAddAction( gg_trg_Death_Gate, function Trig_Death_Gate_Actions )
endfunction

//===========================================================================
// Trigger: Death Gate TP0
//
// call SetUnitPositionLoc(  udg_SpellUnits[(udg_SpellUnits_CONST * 1) + 1 ], udg_Temp_Unit_Point )
//  udg_SpellUnits[(udg_SpellUnits_CONST * 1) + 1 ]
//===========================================================================
function Trig_Death_Gate_TP0_Func005C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'U03A' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'U036' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Death_Gate_TP0_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) != 'e04D' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) != 'e04E' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) != 'e04H' ) ) then
        return false
    endif
    if ( not ( GetPlayerController(GetOwningPlayer(GetTriggerUnit())) == MAP_CONTROL_USER ) ) then
        return false
    endif
    if ( not Trig_Death_Gate_TP0_Func005C() ) then
        return false
    endif
    return true
endfunction

function Trig_Death_Gate_TP0_Actions takes nothing returns nothing
    local integer udg_o
    local boolean succesfulBack = false
    local location udg_Temp_Unit_Point
    local location udg_Temp_X_Point
    if IsAlliancePlayer( GetOwningPlayer(GetTriggerUnit()) ) then
    set udg_o = udg_z_DK_UNHO_A
    else
    set udg_o = udg_z_DK_UNHO_H
    endif
    set udg_o = ( udg_o + 16 )
    if IsUnitAlly( GetTriggerUnit(), GetOwningPlayer(udg_SpellUnits[udg_o] ) ) then
    set udg_Temp_Unit_Point = GetUnitLoc(udg_SpellUnits[( udg_o + 1 )])
    set udg_Temp_X_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 60.00, GetUnitFacing(udg_SpellUnits[( udg_o + 1 )]))
    call RemoveLocation (udg_Temp_Unit_Point)
    call DisableTrigger( gg_trg_Death_Gate_TP1)
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    // TP
    call DisableTrigger( GetTriggeringTrigger() )
    if not IsTerrainPathable( GetLocationX(udg_Temp_X_Point), GetLocationY(udg_Temp_X_Point), PATHING_TYPE_WALKABILITY) then
    call SetUnitPositionLoc(  GetTriggerUnit() , udg_Temp_X_Point )
    call StopSoundBJ( gg_snd_IllidanShadowBlast1, false )
    call PlaySoundAtPointBJ( gg_snd_IllidanShadowBlast1, 100, udg_Temp_X_Point, 0 )
    set succesfulBack = true
    else
    call SetUnitPositionLoc(  GetTriggerUnit() , udg_Temp_Unit_Point )
    call ErrorMessage( "Can't path there.", GetOwningPlayer( GetTriggerUnit() ) )
    call EnableTrigger( GetTriggeringTrigger() )
    endif
    call RemoveLocation (udg_Temp_X_Point)
    call RemoveLocation (udg_Temp_Unit_Point)
    endif
    set udg_Temp_Unit_Point = null
    set udg_Temp_X_Point = null
    call GameTimeWait( 0.2)
    if succesfulBack then
    call DisableTrigger( gg_trg_Death_Gate_TP0)
    call DisableTrigger( gg_trg_Death_Gate_TP1)
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_DummyIsland)
    call SetUnitPositionLoc(  udg_SpellUnits[ udg_o + 0 ], udg_Temp_Unit_Point )
    call SetUnitPositionLoc(  udg_SpellUnits[ udg_o + 1 ], udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call EnableTrigger( gg_trg_Death_Gate_TP0)
    call EnableTrigger( gg_trg_Death_Gate_TP1)
    endif
endfunction

//===========================================================================
function InitTrig_Death_Gate_TP0 takes nothing returns nothing
    set gg_trg_Death_Gate_TP0 = CreateTrigger(  )
    call TriggerAddCondition( gg_trg_Death_Gate_TP0, Condition( function Trig_Death_Gate_TP0_Conditions ) )
    call TriggerAddAction( gg_trg_Death_Gate_TP0, function Trig_Death_Gate_TP0_Actions )
endfunction

//===========================================================================
// Trigger: Death Gate TP1
//
// call SetUnitPositionLoc(  udg_SpellUnits[(udg_SpellUnits_CONST * 1) + 1 ], udg_Temp_Unit_Point )
//  udg_SpellUnits[(udg_SpellUnits_CONST * 1) + 1 ]
