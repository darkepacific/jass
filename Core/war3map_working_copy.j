    set udg_TempString = "With the deeds recovered, there is but one thing left to do. Alexi must be killed. With him dead, I need not ever worry about an unscrupulous gang of mercenaries seeking my head.|n"
    set udg_TempString = ( udg_TempString + " It's a simple task. Alexi hides under the protection of the Horde at the Bulwark. I want his head." )
    // Set Quest Rewards
    set udg_QUEST_XP[udg_Temp_Int] = 1800
    set udg_QUEST_GOLD[udg_Temp_Int] = 1000
    set udg_QUEST_LVL_REQ[udg_Temp_Int] = udg_QUEST_ZONE_4_LVL_REQ
    call QuestRewards_TextSet(udg_Temp_Int)
