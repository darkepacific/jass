    call ForGroupBJ( GetUnitsInRectOfPlayer(gg_rct_Amani_Dark_Priest_Spawn, Player(PLAYER_NEUTRAL_AGGRESSIVE)), function Trig_Dark_Troll_Priest_Func017A )
