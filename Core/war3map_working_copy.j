function Trig_Dunwald_Capture_Actions takes nothing returns nothing
    // Alliance Capture
    if ( Trig_Dunwald_Capture_Func002C() ) then
        call DestroyTimerDialogBJ( udg_TowerWindows[8] )
        call DisableTrigger( gg_trg_Dunwald_Leave)
        call FactionPointCapture( gg_unit_ncop_1457, Player(11), "The Ruins of Dunwald")
        call TriggerSleepAction( 4.00 )
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Dunwald_Guard_1)
        call CreateNUnitsAtLoc( 1, 'hrif', Player(11), udg_Temp_Unit_Point, 317.81 )
        call RemoveLocation (udg_Temp_Unit_Point)
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Dunwald_Guard_2)
        call CreateNUnitsAtLoc( 1, 'hrif', Player(11), udg_Temp_Unit_Point, 335.96 )
        call RemoveLocation (udg_Temp_Unit_Point)
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Dunwald_Guard_3)
        call CreateNUnitsAtLoc( 1, 'hrif', Player(11), udg_Temp_Unit_Point, 275.80 )
        call RemoveLocation (udg_Temp_Unit_Point)
    else
    endif
    // Horde Capture
    if ( Trig_Dunwald_Capture_Func004C() ) then
        call DestroyTimerDialogBJ( udg_TowerWindows[8] )
        call DisableTrigger( gg_trg_Dunwald_Leave)
        call FactionPointCapture( gg_unit_ncop_1457, Player(3), "The Ruins of Dunwald")
        call TriggerSleepAction( 4.00 )
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Dunwald_Guard_1)
        call CreateNUnitsAtLoc( 1, 'ogru', Player(3), udg_Temp_Unit_Point, 317.81 )
        call RemoveLocation (udg_Temp_Unit_Point)
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Dunwald_Guard_2)
        call CreateNUnitsAtLoc( 1, 'ogru', Player(3), udg_Temp_Unit_Point, 335.00 )
        call RemoveLocation (udg_Temp_Unit_Point)
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Dunwald_Guard_3)
        call CreateNUnitsAtLoc( 1, 'ogru', Player(3), udg_Temp_Unit_Point, 275.00 )
        call RemoveLocation (udg_Temp_Unit_Point)
    else
    endif
    call EnableTrigger( gg_trg_Dunwald)
endfunction

