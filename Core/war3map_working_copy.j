    set gg_trg_Breath_of_Sindragosa = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Breath_of_Sindragosa, EVENT_PLAYER_UNIT_SPELL_CHANNEL )
    call TriggerAddCondition( gg_trg_Breath_of_Sindragosa, Condition( function Trig_Breath_of_Sindragosa_Conditions ) )
