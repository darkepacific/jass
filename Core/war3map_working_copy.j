function Trig_UR_ComboGen_Actions takes nothing returns nothing
    set udg_Temp_Unit = udg_yH_Combat_Rogue
    if ( Trig_UR_ComboGen_Func004C() ) then
        call AddSpecialEffectTargetUnitBJ( "overhead", udg_Temp_Unit, "RedSpellOrb.mdx" )
        call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.18 )
        set udg_URComboEffects[0] = GetLastCreatedEffectBJ()
        if ( Trig_UR_ComboGen_Func004Func005C() ) then
            set udg_URComboPoints = 1.00
        else
        endif
    else
    endif
    if ( Trig_UR_ComboGen_Func005C() ) then
        call AddSpecialEffectTargetUnitBJ( "right hand", udg_Temp_Unit, "RedSpellOrb.mdx" )
        call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.18 )
        set udg_URComboEffects[1] = GetLastCreatedEffectBJ()
        if ( Trig_UR_ComboGen_Func005Func004C() ) then
            set udg_URComboPoints = 2.00
        else
        endif
    else
    endif
    if ( Trig_UR_ComboGen_Func006C() ) then
        call AddSpecialEffectTargetUnitBJ( "left hand", udg_Temp_Unit, "RedSpellOrb.mdx" )
        call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.18 )
        set udg_URComboEffects[2] = GetLastCreatedEffectBJ()
        if ( Trig_UR_ComboGen_Func006Func004C() ) then
            call CreateTextTagUnitBJ( "TRIGSTR_5506", udg_Temp_Unit, 10.00, 8.00, 100, 100, 0.00, 0 )
            call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64, 0.00 )
            call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
            call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 1.00 )
            call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 0.50 )
            call ShowTextTagForceBJ( true, GetLastCreatedTextTag(), udg_HordePlayers )
            set udg_URComboPoints = 3.00
            call ComboPointFrameSetPoints( udg_yH_Combat_Rogue, udg_URComboPoints)
            return
        else
        endif
    else
    endif
    if ( Trig_UR_ComboGen_Func007C() ) then
        call CreateTextTagUnitBJ( "TRIGSTR_5507", udg_Temp_Unit, 10.00, 8.00, 100, 100, 0.00, 0 )
        call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64, 0.00 )
        call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
        call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 1.00 )
        call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 0.50 )
        call ShowTextTagForceBJ( true, GetLastCreatedTextTag(), udg_HordePlayers )
        set udg_URComboPoints = ( udg_URComboPoints + 1 )
    else
    endif
    call ComboPointFrameSetPoints( udg_yH_Combat_Rogue, udg_URComboPoints)
endfunction

