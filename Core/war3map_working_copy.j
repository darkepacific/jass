    set gg_trg_Arcane_Shot_Dwarf = CreateTrigger(  )
    call DisableTrigger( gg_trg_Arcane_Shot_Dwarf )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Arcane_Shot_Dwarf, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_Arcane_Shot_Dwarf, Condition( function Trig_Arcane_Shot_Dwarf_Conditions ) )
