    set gg_trg_Rezz_Start = CreateTrigger(  )
    call TriggerAddAction( gg_trg_Rezz_Start, function Trig_Rezz_Start_Actions )
endfunction

//===========================================================================
// Trigger: Ress Click
//===========================================================================
function Trig_Ress_Click_Func002Func011C takes nothing returns boolean
    if ( not ( udg_Player_Number < 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Ress_Click_Func002C takes nothing returns boolean
    if ( not ( GetClickedButtonBJ() == udg_RessDialogButtonYes ) ) then
        return false
    endif
    return true
endfunction

function Trig_Ress_Click_Actions takes nothing returns nothing
    local integer i
    if ( Trig_Ress_Click_Func002C() ) then
        call Debug( "Yes")
        set i = PlayerNumbtoHeroesNumb()
        set udg_CooldownRemaining = BlzGetUnitAbilityCooldownRemaining(udg_Heroes[udg_Player_Number], 'A0FW')
        if udg_CooldownRemaining == 0.0 then
        set udg_Temp_Int = udg_Player_Number
        set udg_DoRevive = true
        set udg_IsARezz = true
        if ( Trig_Ress_Click_Func002Func011C() ) then
            call TriggerExecute(gg_trg_Death_Set_Horde)
        else
            call TriggerExecute(gg_trg_Death_Set_Alliance)
        endif
        set udg_Temp_Unit_CD = udg_Heroes[udg_Player_Number]
        set udg_RealStatCalc = ( I2R(GetUnitAbilityLevelSwapped('A0FW', udg_Temp_Unit_CD)) * -20.00 )
        set udg_RealStatCalc = ( udg_RealStatCalc + 160.00 )
        call TriggerExecute( gg_trg_Cooldown_Maths)
        set udg_CooldownRemaining = ( udg_CooldownRemaining * udg_RealStatCalc )
        call BlzStartUnitAbilityCooldown( udg_Temp_Unit_CD, 'A0FW', udg_CooldownRemaining )
        else
        call ErrorMessage( "Resurrection has a remaining cooldown of: |cffffffff" + R2S(udg_CooldownRemaining), GetTriggerPlayer() )
        call GameTimeWait( udg_CooldownRemaining)
        if ( TimerGetRemaining(udg_RespawnTimer[ i ]) > 0.4  ) then
        // Reroll has pause set to 0.25
        call DialogDisplayBJ( true, udg_RessDialog, GetTriggerPlayer() )
        endif
        endif
    else
        call Debug( "No")
        call DialogDisplayBJ( false, udg_RessDialog, GetTriggerPlayer() )
    endif
endfunction

//===========================================================================
function InitTrig_Ress_Click takes nothing returns nothing
    set gg_trg_Ress_Click = CreateTrigger(  )
    call TriggerRegisterDialogEventBJ( gg_trg_Ress_Click, udg_RessDialog )
    call TriggerAddAction( gg_trg_Ress_Click, function Trig_Ress_Click_Actions )
endfunction

