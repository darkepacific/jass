//===========================================================================
// Trigger: Holy Light
//===========================================================================
function Trig_Holy_Light_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'AHhb' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Holy_Light_Func007C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(udg_Temp_Unit, 'B01F') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Holy_Light_Func008C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'Hapm' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Holy_Light_Func009C takes nothing returns boolean
    if ( not ( IsUnitEnemy(GetSpellTargetUnit(), GetOwningPlayer(GetTriggerUnit())) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Holy_Light_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 3.00 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('AHhb', udg_Temp_Unit) * 105 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 10 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    if ( Trig_Holy_Light_Func007C() ) then
        set udg_Temp_Real = ( ( 0.10 * I2R(( GetUnitAbilityLevelSwapped('A0AQ', udg_Temp_Unit) + 1 )) ) + 1.00 )
        set udg_RealStatCalc = ( udg_Temp_Real * udg_RealStatCalc )
    else
    endif
    if ( Trig_Holy_Light_Func008C() ) then
        set udg_RealStatCalc = ( udg_RealStatCalc + 800.00 )
    else
    endif
    if ( Trig_Holy_Light_Func009C() ) then
        if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 2 ]  then
        set udg_RealStatCalc = ( 1.70 * udg_RealStatCalc )
        endif
    else
    endif
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'AHhb'), ABILITY_RLF_AMOUNT_HEALED_DAMAGED_HHB1, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), udg_RealStatCalc )
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 0 ]  then
    call MissingHPSelfHeal( 0.14)
    else
    call MissingHPSelfHeal( 0.08)
    endif
    // Sacred Shield
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 13 ]  then
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) + GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, true) ))
    set udg_RealStatCalc = ( 100.00 + udg_RealStatCalc )
    if not IsUnitEnemy( udg_Temp_Unit, GetOwningPlayer(GetSpellTargetUnit()) ) then
    set udg_Temp_Unit = GetSpellTargetUnit()
    if udg_Debug then
    call DisplayTextToForce( GetPlayersAll(), "|cccFFaa00HandleId: |r" + I2S(GetHandleId( udg_Temp_Unit)) )
    endif
    call NewShield( udg_Temp_Unit, udg_RealStatCalc, 99 )
    call SetUnitAbilityLevel( gg_unit_e03G_2001, 'A0BF', 16 )
    				call IssueTargetOrder( gg_unit_e03G_2001, "innerfire", udg_Temp_Unit )
    endif
    endif
endfunction

//===========================================================================
function InitTrig_Holy_Light takes nothing returns nothing
    set gg_trg_Holy_Light = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Holy_Light, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Holy_Light, Condition( function Trig_Holy_Light_Conditions ) )
    call TriggerAddAction( gg_trg_Holy_Light, function Trig_Holy_Light_Actions )
endfunction

