            set udg_BERComboPoints = 0.00
            call ResetComboPoints( GetTriggerUnit() )
        else
            set udg_Temp_Real = 3.00
        endif
    endif
    // Number of Clones
    call BlzSetAbilityIntegerLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A0EW'), ABILITY_ILF_NUMBER_OF_IMAGES, ( GetUnitAbilityLevelSwapped('A0EW', GetTriggerUnit()) - 1 ), R2I(ComboPoints) )
    // Ruthless
    call GameTimeWait(0.1)
    if GetRandomReal( 0.0, 2.99) < ComboPoints then
    set udg_Temp_Unit = GetTriggerUnit()
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 10 ] then 
    call CreateTextTagUnitBJ( "TRIGSTR_5578", udg_Temp_Unit, 12.00, 9.00, 40.00, 100.00, 40.00, 0 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64, 90.00 )
    call cleanUpText(1.0, 0.5)
    if udg_Temp_Unit == udg_yA_Subtle_Rogue then
    call ShowTextTagForceBJ( true, GetLastCreatedTextTag(), udg_AlliancePlayers )
    call TriggerExecute( gg_trg_NER_ComboGen )
    else
    call ShowTextTagForceBJ( true, GetLastCreatedTextTag(), udg_HordePlayers )
    call TriggerExecute( gg_trg_BER_ComboGen )
    endif
    endif
    endif
endfunction

