    call TriggerAddAction(gg_trg_Magnatuar, function Trig_Magnatuar_Actions)
endfunction


//===========================================================================
// Trigger: Mammoth
//===========================================================================
function Trig_Mammoth_Conditions takes nothing returns boolean
    // Death event: snapshot is taken in Actions, but condition still needs event response.
    return GetUnitTypeId(GetDyingUnit()) == 'nmam'
endfunction

function Trig_Mammoth_Actions takes nothing returns nothing
    local unit dying = GetDyingUnit()
    local integer exec = GetTriggerExecCount(gg_trg_Mammoth) // snapshot BEFORE wait
    local integer k = ModuloInteger(exec, 4)

    local location p
    local integer i = 0

    // ITEM TABLE
    set udg_ItemDropTable[i] = 'I046'
    set udg_ItemDropPerc[i]  = 20.00
    set i = i + 1

    set udg_ItemDropTable[i] = 'I041'
    set udg_ItemDropPerc[i]  = 20.00
    set i = i + 1

    set udg_ItemDropTable[i] = 'I044'
    set udg_ItemDropPerc[i]  = 20.00
    set i = i + 1

    set udg_ItemDropTable[i] = 'I049'
    set udg_ItemDropPerc[i]  = 20.00
    set i = i + 1

    set udg_ItemDropTable[i] = 'I03S'
    set udg_ItemDropPerc[i]  = 20.00
    set i = i + 1

    // DROP ITEM at death location (safe because we snapshot dying first)
    set p = GetUnitLoc(dying)
    call CreateItemsFromDropTable(p)
    call RemoveLocation(p)
    set p = null

    // Respawn delay
    call TriggerSleepAction(100.00)

    // Respawn cycle based on snapshotted exec count
    if (k == 0) then
        set p = GetRectCenter(gg_rct_Mammoth_1)
        call CreateNUnitsAtLoc(1, 'nmam', Player(PLAYER_NEUTRAL_AGGRESSIVE), p, 328.07)
    elseif (k == 1) then
        set p = GetRectCenter(gg_rct_Mammoth_2)
        call CreateNUnitsAtLoc(1, 'nmam', Player(PLAYER_NEUTRAL_AGGRESSIVE), p, 156.53)
    elseif (k == 2) then
        set p = GetRectCenter(gg_rct_Mammoth_3)
        call CreateNUnitsAtLoc(1, 'nmam', Player(PLAYER_NEUTRAL_AGGRESSIVE), p, 185.57)
    else
        set p = GetRectCenter(gg_rct_Mammoth_4)
        call CreateNUnitsAtLoc(1, 'nmam', Player(PLAYER_NEUTRAL_AGGRESSIVE), p, 94.69)
    endif

    call RemoveLocation(p)
    set p = null

    call SetUnitAcquireRangeBJ(GetLastCreatedUnit(), 200.00)

    set dying = null
endfunction

function InitTrig_Mammoth takes nothing returns nothing
    set gg_trg_Mammoth = CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_Mammoth, Player(PLAYER_NEUTRAL_AGGRESSIVE), EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_Mammoth, Condition(function Trig_Mammoth_Conditions))
    call TriggerAddAction(gg_trg_Mammoth, function Trig_Mammoth_Actions)
endfunction

