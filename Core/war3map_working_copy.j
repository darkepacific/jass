//===========================================================================
// Trigger: Alter Time
//===========================================================================
function Trig_Alter_Time_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0DF' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Alter_Time_Actions takes nothing returns nothing
    local effect eff
    local effect sparkle
    local effect clock
    local location start
    local real life
    local real mana
    set udg_RealStatCalc = GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit())
    set life = udg_RealStatCalc
    set udg_RealStatCalc = GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit())
    set mana = udg_RealStatCalc
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
    set start = udg_Temp_Unit_Point
    call StopSoundBJ( gg_snd_HourglassCast_3, false )
    call PlaySoundOnUnitBJ( gg_snd_HourglassCast_3, 85.00, GetTriggerUnit() )
    call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "war3mapImported\\Singularity II Orange.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\ClockRune.mdx" )
    call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 4.00 )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 1.25 )
    set eff = GetLastCreatedEffectBJ()
    call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "war3mapImported\\ClockRune.mdx" )
    set clock = GetLastCreatedEffectBJ()
    call AddSpecialEffectTargetUnitBJ( "chest", GetTriggerUnit(), "LootEFFECT.mdx" )
    set sparkle = GetLastCreatedEffectBJ()
    call SetUnitVertexColorBJ( GetTriggerUnit(), 100, 80.00, 25.00, 0 )
    call GameTimeWait(3.6)
    // after 4 s
    set udg_Temp_Unit_Point = start
    call SetUnitPositionLocFacingLocBJ( GetTriggerUnit(), udg_Temp_Unit_Point, udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call UnitRemoveBuffsBJ( bj_REMOVEBUFFS_NEGATIVE, GetTriggerUnit() )
    set udg_RealStatCalc = GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit())
    if life > udg_RealStatCalc then
    set udg_RealStatCalc = life
    endif
    call SetUnitLifeBJ( GetTriggerUnit(), udg_RealStatCalc )
    set udg_RealStatCalc = GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit())
    if mana > udg_RealStatCalc then
    set udg_RealStatCalc = mana
    endif
    call SetUnitManaBJ( GetTriggerUnit(), udg_RealStatCalc )
    call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "war3mapImported\\Singularity II Orange.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call DestroyEffectBJ( eff )
    call DestroyEffectBJ( clock )
    call DestroyEffectBJ( sparkle )
    call RemoveLocation (udg_Temp_Unit_Point)
    set sparkle = null
    set eff = null
    set clock = null
    set start = null
    call SetUnitVertexColorBJ( GetTriggerUnit(), 100, 100, 100, 0 )
endfunction

//===========================================================================
function InitTrig_Alter_Time takes nothing returns nothing
    set gg_trg_Alter_Time = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Alter_Time, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Alter_Time, Condition( function Trig_Alter_Time_Conditions ) )
    call TriggerAddAction( gg_trg_Alter_Time, function Trig_Alter_Time_Actions )
endfunction

//===========================================================================
// Trigger: Frostbolt
//===========================================================================
function Trig_Frostbolt_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A08I' ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetTriggerUnit()) != Player(PLAYER_NEUTRAL_AGGRESSIVE) ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetTriggerUnit()) != Player(PLAYER_NEUTRAL_PASSIVE) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Frostbolt_Actions takes nothing returns nothing
    local real dist = 0.25
    local integer udg_o
    local unit udg_Temp_Unit = GetTriggerUnit()
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 0 ]  then
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A08I'), ABILITY_RLF_DURATION_NORMAL, ( GetUnitAbilityLevel(udg_Temp_Unit, GetSpellAbilityId()) - 1 ), 1.0 )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A08I'), ABILITY_RLF_DURATION_HERO, ( GetUnitAbilityLevel(udg_Temp_Unit, GetSpellAbilityId()) - 1 ), 1.0 )
    else
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A08I'), ABILITY_RLF_DURATION_NORMAL, ( GetUnitAbilityLevel(udg_Temp_Unit, GetSpellAbilityId()) - 1 ), 0.5 )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A08I'), ABILITY_RLF_DURATION_HERO, ( GetUnitAbilityLevel(udg_Temp_Unit, GetSpellAbilityId()) - 1 ), 0.5 )
    endif
    set udg_Temp_Unit = GetSpellTargetUnit()
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    set udg_Temp_Polar_Point = GetUnitLoc(GetSpellTargetUnit())
    set dist = 0.12 + DistanceBetweenPoints(udg_Temp_Unit_Point, udg_Temp_Polar_Point)/3000
    call RemoveLocation(udg_Temp_Unit_Point)
    call RemoveLocation(udg_Temp_Polar_Point)
    call TriggerSleepAction(dist)
    // Crit!
    if IsSlowed( udg_Temp_Unit ) then
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, GetTriggerUnit(), true) - 0 ))
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(GetTriggerUnit())) * udg_NUM_OF_TC + 1 ]  then
    set udg_RealStatCalc = ( 3.00 * udg_RealStatCalc )
    else
    set udg_RealStatCalc = ( 2.00 * udg_RealStatCalc )
    endif
    call UnitDamageTargetBJ( GetTriggerUnit(), udg_Temp_Unit, udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "Abilities\\Weapons\\FrostWyrmMissile\\FrostWyrmMissile.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "war3mapImported\\ShivasWrath.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call CreateTextTagUnitBJ( "TRIGSTR_8646", udg_Temp_Unit, 0.00, 10.00, 100.00, 100.00, 100.00, 0 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64, 90.00 )
    call cleanUpText(1.25, 0.75)
    endif
    // Clean Up Locals
    set udg_Temp_Unit = null
endfunction

//===========================================================================
function InitTrig_Frostbolt takes nothing returns nothing
    set gg_trg_Frostbolt = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Frostbolt, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Frostbolt, Condition( function Trig_Frostbolt_Conditions ) )
    call TriggerAddAction( gg_trg_Frostbolt, function Trig_Frostbolt_Actions )
endfunction

