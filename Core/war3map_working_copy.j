//===========================================================================
function Trig_U_CNR_Conditions takes nothing returns boolean
    if ( not ( RectContainsUnit(gg_rct_Moonlight_NE, GetTriggerUnit()) == true ) ) then
        return false
    endif
    if ( not ( SubStringBJ(GetItemName(GetManipulatedItem()), ( StringLength(GetItemName(GetManipulatedItem())) - 10 ), StringLength(GetItemName(GetManipulatedItem()))) == "in a Cage|r" ) ) then
        return false
    endif
    return true
endfunction

function Trig_U_CNR_Func018C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0GB' ) ) then
        return false
    endif
    return true
endfunction

function Trig_U_CNR_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 134
                       if IsAllianceHero( GetTriggerUnit() ) then
    call Debug("Quest string:" + udg_QuestCatchNRelease_String)
    if StringContains(  udg_QuestCatchNRelease_String , udg_LastCritterReleased) then
    call Debug("It contained:" + udg_LastCritterReleased)
    else 
    call Debug("Adding" + udg_LastCritterReleased)
    set udg_QuestCatchNRelease_String = ( udg_QuestCatchNRelease_String + udg_LastCritterReleased )
    set udg_QuestCatchNRelease = ( udg_QuestCatchNRelease + 1 )
    call QuestItemSetDescriptionBJ( udg_QuestReqs[udg_Temp_Int], ( "Unique Critters Released -" + ( I2S(R2I(udg_QuestCatchNRelease)) + "/6" ) ) )
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_TempString = "Unique Critter"
    call TriggerExecute( gg_trg_ItemTurnIn )
    endif
    call Debug("Quest string:" + udg_QuestCatchNRelease_String)
    //SAVE
    if ( Trig_U_CNR_Func018C() ) then
        call Debug("TempString" + udg_TempString)
        set udg_TempString = SubStringBJ(GetItemName(GetManipulatedItem()), ( StringLength(GetItemName(GetManipulatedItem())) - 8 ), StringLength(GetItemName(GetManipulatedItem())))
        set udg_TempString = SubStringBJ(GetItemName(GetManipulatedItem()), ( StringLength(GetItemName(GetManipulatedItem())) - 8 ), StringLength(GetItemName(GetManipulatedItem())))
    else
    endif
                       endif
endfunction

