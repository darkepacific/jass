function Trig_Footman_Thornby_Dies_Func006Func003C takes nothing returns boolean
    if ( not ( IsTriggerEnabled(gg_trg_E_KnC) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Footman_Thornby_Dies_Func006C takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_Quests[76]) == false ) ) then
