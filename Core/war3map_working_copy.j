//===========================================================================
// Trigger: Charge Timer Dwarf
//===========================================================================
function Trig_Charge_Timer_Dwarf_Func011C takes nothing returns boolean
    if ( not ( udg_Charge_Loop[0] < 20.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Charge_Timer_Dwarf_Actions takes nothing returns nothing
    set udg_Temp_Int = 0
    set udg_Charge_Distance = DistanceBetweenPoints(udg_Point_Charge_Begin[udg_Temp_Int], udg_Point_Charge_End[udg_Temp_Int])
    set udg_RealStatCalc = AngleBetweenPoints(udg_Point_Charge_Begin[0], udg_Point_Charge_End[0])
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Point_Charge_Begin[0], ( udg_Charge_Distance * ( udg_Charge_Loop[0] / 20.00 ) ), udg_RealStatCalc)
    if not IsTerrainPathable( GetLocationX(udg_Temp_Polar_Point), GetLocationY(udg_Temp_Polar_Point), PATHING_TYPE_WALKABILITY) then
    set udg_Temp_Unit = udg_yA_Prot_Warr
    call SetUnitPositionLocFacingLocBJ( udg_Temp_Unit, udg_Temp_Polar_Point, udg_Point_Charge_End[0] )
    endif
    call RemoveLocation (udg_Temp_Polar_Point)
    if ( Trig_Charge_Timer_Dwarf_Func011C() ) then
        set udg_Charge_Loop[0] = ( udg_Charge_Loop[0] + 1 )
    else
        call RemoveLocation (udg_Point_Charge_Begin[0])
        call RemoveLocation (udg_Point_Charge_End[0])
        call DestroyEffectBJ( udg_Charge_SE[0] )
        call DisableTrigger( GetTriggeringTrigger() )
         if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 12 ]  then
        set udg_o = ( udg_z_WR_PROT_A + 4 )
        if udg_SpellUnits[udg_o+1] != udg_SpellUnits[udg_o] then
        call MaxHPSelfHeal( 0.09)
        call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "war3mapImported\\Heal Orange.mdx" )
        call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.90 )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        endif
        endif
    endif
endfunction

