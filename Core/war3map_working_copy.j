endfunction

function Trig_Southpoint_Tower_Capture_Actions takes nothing returns nothing
    set udg_TempString = "Southpoint Tower"
    // Alliance Capture
    if ( Trig_Southpoint_Tower_Capture_Func004C() ) then
        call DestroyTimerDialogBJ( udg_TowerWindows[0] )
        call DisableTrigger( gg_trg_Southpoint_Tower_Leave )
        call QuestMessageBJ( GetPlayersAll(), bj_QUESTMESSAGE_ALWAYSHINT, "TRIGSTR_643" )
        call FactionPointCapture( gg_unit_ncop_1444, Player(1), udg_TempString)
        call SetUnitOwner( gg_unit_h00D_0149, Player(1), true )
        call TriggerSleepAction( 4.00 )
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Southpoint_Guard_1)
        call CreateNUnitsAtLoc( 1, 'h00I', Player(1), udg_Temp_Unit_Point, 0.00 )
        call RemoveLocation (udg_Temp_Unit_Point)
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Southpoint_Guard_2)
        call CreateNUnitsAtLoc( 1, 'h00I', Player(1), udg_Temp_Unit_Point, 150.00 )
        call RemoveLocation (udg_Temp_Unit_Point)
    else
    endif
    // Horde Capture
    if ( Trig_Southpoint_Tower_Capture_Func006C() ) then
        call DestroyTimerDialogBJ( udg_TowerWindows[0] )
        call DisableTrigger( gg_trg_Southpoint_Tower_Leave )
        call QuestMessageBJ( GetPlayersAll(), bj_QUESTMESSAGE_ALWAYSHINT, "TRIGSTR_701" )
        call FactionPointCapture( gg_unit_ncop_1444, Player(3), udg_TempString)
        call SetUnitOwner( gg_unit_h00D_0149, Player(3), true )
        call TriggerSleepAction( 4.00 )
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Southpoint_Guard_1)
        call CreateNUnitsAtLoc( 1, 'u000', Player(3), udg_Temp_Unit_Point, 0.00 )
        call RemoveLocation (udg_Temp_Unit_Point)
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Southpoint_Guard_2)
        call CreateNUnitsAtLoc( 1, 'u000', Player(3), udg_Temp_Unit_Point, 150.00 )
        call RemoveLocation (udg_Temp_Unit_Point)
    else
    endif
    call EnableTrigger( gg_trg_Southpoint_Tower )
endfunction

//===========================================================================
function InitTrig_Southpoint_Tower_Capture takes nothing returns nothing
    set gg_trg_Southpoint_Tower_Capture = CreateTrigger(  )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_Southpoint_Tower_Capture, udg_TowerTimers[0] )
    call TriggerAddAction( gg_trg_Southpoint_Tower_Capture, function Trig_Southpoint_Tower_Capture_Actions )
endfunction

