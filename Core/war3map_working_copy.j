//===========================================================================
// Trigger: Mind Flay Dies
//
// Can't use shadowing here because the custom conditions are stored in separate functions
// udg_Temp_Unit 
//===========================================================================
function Trig_Mind_Flay_Dies_Actions takes nothing returns nothing
    local unit udg_Temp_Unit
    local effect eff = null
    local integer udg_Player_Number = HeroesNumb(GetTriggerPlayer())
    if GetTriggerUnit() == udg_SpellUnits[ udg_z_PR_SHAD_A + 4 ] then
    set udg_Temp_Unit = udg_yA_Shadow_Priest
    set udg_o = udg_z_PR_SHAD_A + 4
    elseif GetTriggerUnit() == udg_SpellUnits[udg_z_PR_SHAD_H + 4] then
    set udg_Temp_Unit = udg_yH_Shadow_Priest
    set udg_o = udg_z_PR_SHAD_H + 4
    else
    return
    endif
    // CD Reset Talent
    if  udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 5 ] then
    call BlzEndUnitAbilityCooldown( udg_Temp_Unit, 'A05F' )
    endif
    // Void Explosion
    if  udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 14 ] then
    set udg_Temp_Z_Rev = GetUnitLoc(udg_SpellUnits[udg_o])
    call AddSpecialEffectLocBJ( udg_Temp_Z_Rev, "war3mapImported\\Void Rift II Purple.mdx" )
    set eff = GetLastCreatedEffectBJ()
    set udg_Temp_Int2 = HeroesNumb(GetOwningPlayer(udg_Temp_Unit))
    set udg_VoidExplosion = 2
    call TriggerExecute( gg_trg_Shadow_AOE)
    call RemoveLocation (udg_Temp_Z_Rev)
    // destroy SE
    call TriggerSleepAction( 0.26 )
    call DestroyEffectBJ( eff)
    endif
    set eff = null
    set udg_Temp_Unit = null
endfunction

//===========================================================================
function InitTrig_Mind_Flay_Dies takes nothing returns nothing
    set gg_trg_Mind_Flay_Dies = CreateTrigger(  )
    call DisableTrigger( gg_trg_Mind_Flay_Dies )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Mind_Flay_Dies, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddAction( gg_trg_Mind_Flay_Dies, function Trig_Mind_Flay_Dies_Actions )
endfunction

//===========================================================================
// Trigger: Mind Flay Stop
//===========================================================================
function Trig_Mind_Flay_Stop_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A05F' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mind_Flay_Stop_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    if udg_Temp_Unit == udg_yA_Shadow_Priest then
    call StopSoundBJ( gg_snd_Mind_Flay1, false )
    call DisableTrigger( gg_trg_Mind_Flay_Tick_A)
    endif
    if udg_Temp_Unit == udg_yH_Shadow_Priest then
    call StopSoundBJ( gg_snd_Mind_Flay101, false )
    call DisableTrigger( gg_trg_Mind_Flay_Tick_H)
    endif
    if not IsTriggerEnabled(gg_trg_Mind_Flay_Tick_A) and not IsTriggerEnabled(gg_trg_Mind_Flay_Tick_H) then
    call DisableTrigger( gg_trg_Mind_Flay_Dies)
    endif
endfunction

//===========================================================================
function InitTrig_Mind_Flay_Stop takes nothing returns nothing
    set gg_trg_Mind_Flay_Stop = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Mind_Flay_Stop, EVENT_PLAYER_UNIT_SPELL_FINISH )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Mind_Flay_Stop, EVENT_PLAYER_UNIT_SPELL_ENDCAST )
    call TriggerAddCondition( gg_trg_Mind_Flay_Stop, Condition( function Trig_Mind_Flay_Stop_Conditions ) )
    call TriggerAddAction( gg_trg_Mind_Flay_Stop, function Trig_Mind_Flay_Stop_Actions )
endfunction

//===========================================================================
// Trigger: Shadow Word Pain
//===========================================================================
function Trig_Shadow_Word_Pain_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0GS' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Shadow_Word_Pain_Func002C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'H00T' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Shadow_Word_Pain_Actions takes nothing returns nothing
    local unit udg_Temp_Unit = GetTriggerUnit()
    if ( Trig_Shadow_Word_Pain_Func002C() ) then
        call StopSoundBJ( gg_snd_ShadowHit, false )
        call PlaySoundOnUnitBJ( gg_snd_ShadowHit, 85.00, GetSpellTargetUnit() )
    else
        call StopSoundBJ( gg_snd_ShadowHit01, false )
        call PlaySoundOnUnitBJ( gg_snd_ShadowHit01, 85.00, GetSpellTargetUnit() )
    endif
    // Shadow Word: Death
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 13 ] then
    if GetUnitStatePercent( GetSpellTargetUnit(), UNIT_STATE_LIFE, UNIT_STATE_MAX_LIFE) < 33.33 then
    set udg_RealStatCalc =  I2R(GetTotalInt( udg_Temp_Unit)) * 4.0
    call UnitDamageTargetBJ( udg_Temp_Unit, GetSpellTargetUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call AddSpecialEffectTargetUnitBJ( "origin", GetSpellTargetUnit(), "Abilities\\Weapons\\CannonTowerMissile\\CannonTowerMissile.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "origin", GetSpellTargetUnit(), "Abilities\\Weapons\\Mortar\\MortarMissile.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "origin", GetSpellTargetUnit(), "Abilities\\Weapons\\GyroCopter\\GyroCopterMissile.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    endif
    endif
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_Temp_Unit) * 15 )
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 1.00 * udg_RealStatCalc )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A0GS'), ABILITY_RLF_DAMAGE_PER_SECOND_UHF2, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), udg_RealStatCalc )
    // Silence
    set udg_Temp_Unit = GetTriggerUnit()
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 9 ] then
    call SetUnitOwner( gg_unit_e028_1863, GetOwningPlayer(udg_Temp_Unit), true )
    call SetUnitAbilityLevelSwapped( 'A096', gg_unit_e028_1863, 2 )
    call IssueTargetOrderBJ( gg_unit_e028_1863, "soulburn", GetSpellTargetUnit() )
    endif
    set udg_Temp_Unit = null
endfunction

//===========================================================================
function InitTrig_Shadow_Word_Pain takes nothing returns nothing
    set gg_trg_Shadow_Word_Pain = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Shadow_Word_Pain, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Shadow_Word_Pain, Condition( function Trig_Shadow_Word_Pain_Conditions ) )
    call TriggerAddAction( gg_trg_Shadow_Word_Pain, function Trig_Shadow_Word_Pain_Actions )
endfunction

//===========================================================================
// Trigger: Vampiric Embrace
//===========================================================================
function Trig_Vampiric_Embrace_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0E9' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Vampiric_Embrace_Func004C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 2) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Vampiric_Embrace_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "war3mapImported\\Soul Discharge Purple.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    if ( Trig_Vampiric_Embrace_Func004C() ) then
        call StopSoundBJ( gg_snd_vampiric_embrace_1713568, false )
        call PlaySoundOnUnitBJ( gg_snd_vampiric_embrace_1713568, 85.00, GetSpellAbilityUnit() )
    else
        call StopSoundBJ( gg_snd_vampiric_embrace_1713571, false )
        call PlaySoundOnUnitBJ( gg_snd_vampiric_embrace_1713571, 85.00, GetSpellAbilityUnit() )
    endif
    if GetTriggerUnit() == udg_yA_Shadow_Priest then
    set udg_VampEmbrace_A = true
    elseif GetTriggerUnit() == udg_yH_Shadow_Priest then
    set udg_VampEmbrace_H = true
    endif
    call GameTimeWait(6.02)
    if GetTriggerUnit() == udg_yA_Shadow_Priest then
    set udg_VampEmbrace_A = false
    elseif GetTriggerUnit() == udg_yH_Shadow_Priest then
    set udg_VampEmbrace_H = false
    endif
endfunction

//===========================================================================
function InitTrig_Vampiric_Embrace takes nothing returns nothing
    set gg_trg_Vampiric_Embrace = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Vampiric_Embrace, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Vampiric_Embrace, Condition( function Trig_Vampiric_Embrace_Conditions ) )
    call TriggerAddAction( gg_trg_Vampiric_Embrace, function Trig_Vampiric_Embrace_Actions )
endfunction

//===========================================================================
// Trigger: Devouring Plague
//
// data rush betweem Mind Blac
// Turn MB off when evaluating what to do about orbs
//===========================================================================
function Trig_Devouring_Plague_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A007' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Devouring_Plague_Func003C takes nothing returns boolean
    if ( not ( udg_DPOrbNumberDW > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Devouring_Plague_Func008C takes nothing returns boolean
    if ( not ( udg_DPOrbNumberUP > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Devouring_Plague_Actions takes nothing returns nothing
    local unit udg_Temp_Unit = GetTriggerUnit()
    if udg_Temp_Unit == udg_yA_Shadow_Priest then
    if ( Trig_Devouring_Plague_Func003C() ) then
        set udg_DPOrbNumberDW = ( udg_DPOrbNumberDW - 1 )
        call DestroyEffectBJ( udg_DPOrbEffectsDW[udg_DPOrbNumberDW] )
        call PlaySoundOnUnitBJ( gg_snd_AntiMagicShellBirth1, 90.00, udg_Temp_Unit )
        call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "Abilities\\Spells\\Undead\\DeathPact\\DeathPactCaster.mdl" )
        set udg_DPOrbEffectsDW[3] = GetLastCreatedEffectBJ()
        call TriggerSleepAction( 1.00 )
        call DestroyEffectBJ( udg_DPOrbEffectsDW[3] )
        set udg_RealStatCalc =  GetUnitState(udg_Temp_Unit, UNIT_STATE_MAX_LIFE ) /8
        set udg_RealStatCalc =  GetUnitState(udg_Temp_Unit, UNIT_STATE_LIFE ) + udg_RealStatCalc
        call SetUnitState(udg_Temp_Unit, UNIT_STATE_LIFE, udg_RealStatCalc )
        call PlaySoundOnUnitBJ( gg_snd_HealTarget, 90.00, udg_Temp_Unit )
        call AddSpecialEffectTargetUnitBJ( "chest", udg_Temp_Unit, "Abilities\\Spells\\Human\\Heal\\HealTarget.mdl" )
        set udg_DPOrbEffectsDW[3] = GetLastCreatedEffectBJ()
        call TriggerSleepAction( 0.20 )
        call DestroyEffectBJ( udg_DPOrbEffectsDW[3] )
    else
    endif
    call EnableTrigger( gg_trg_DevouringPlagueTick_DW )
    call ComboPointFrameSetPoints( udg_yA_Shadow_Priest, udg_DPOrbNumberDW)
    set udg_SpellTicks[8] = 1
    elseif udg_Temp_Unit == udg_yH_Shadow_Priest then
    if ( Trig_Devouring_Plague_Func008C() ) then
        set udg_DPOrbNumberUP = ( udg_DPOrbNumberUP - 1 )
        call DestroyEffectBJ( udg_DPOrbEffectsUP[udg_DPOrbNumberUP] )
        call PlaySoundOnUnitBJ( gg_snd_AntiMagicShellBirth1, 90.00, udg_Temp_Unit )
        call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "Abilities\\Spells\\Undead\\DeathPact\\DeathPactCaster.mdl" )
        set udg_DPOrbEffectsUP[3] = GetLastCreatedEffectBJ()
        call TriggerSleepAction( 1.00 )
        call DestroyEffectBJ( udg_DPOrbEffectsUP[3] )
        set udg_RealStatCalc =  GetUnitState(udg_Temp_Unit, UNIT_STATE_MAX_LIFE ) /8
        set udg_RealStatCalc =  GetUnitState(udg_Temp_Unit, UNIT_STATE_LIFE ) + udg_RealStatCalc
        call SetUnitState(udg_Temp_Unit, UNIT_STATE_LIFE, udg_RealStatCalc )
        call PlaySoundOnUnitBJ( gg_snd_HealTarget, 90.00, udg_Temp_Unit )
        call AddSpecialEffectTargetUnitBJ( "chest", udg_Temp_Unit, "Abilities\\Spells\\Human\\Heal\\HealTarget.mdl" )
        set udg_DPOrbEffectsUP[3] = GetLastCreatedEffectBJ()
        call TriggerSleepAction( 0.20 )
        call DestroyEffectBJ( udg_DPOrbEffectsUP[3] )
    else
    endif
    call EnableTrigger( gg_trg_DevouringPlagueTick_UD )
    set udg_SpellTicks[7] = 1
    call ComboPointFrameSetPoints( udg_yH_Shadow_Priest, udg_DPOrbNumberUP)
    endif
    set udg_Temp_Unit = null
endfunction

