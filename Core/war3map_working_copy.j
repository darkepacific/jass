//===========================================================================
function Trig_Holy_Word_Salvation_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0FZ' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Holy_Word_Salvation_Actions takes nothing returns nothing
    local unit udg_Temp_Unit = GetTriggerUnit()
    local integer udg_Temp_Int
    if udg_Temp_Unit == udg_yA_Holy_Priest then
    set udg_Temp_Int = 34
    elseif udg_Temp_Unit == udg_yH_Holy_Priest then
    set udg_Temp_Int = 35
    else
    set udg_Temp_Int = 36
    endif
    set udg_Blizzard[udg_Temp_Int] = GetUnitLoc(GetTriggerUnit())
    call AddSpecialEffectLocBJ( udg_Blizzard[udg_Temp_Int], "war3mapImported\\FieldBASE.mdx" )
    call BlzSetSpecialEffectColor( GetLastCreatedEffectBJ(), 255, 255, 125 )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.65 )
    call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 5.00 )
    if udg_Temp_Unit == udg_yA_Holy_Priest then
    set udg_HWSalvA[0] = GetLastCreatedEffectBJ()
    elseif udg_Temp_Unit == udg_yH_Holy_Priest then
    set udg_HWSalvH[0] = GetLastCreatedEffectBJ()
    else
    set udg_HWSalvN[0] = GetLastCreatedEffectBJ()
    call StopSoundBJ( gg_snd_AnduinBase_Ultimate1Used00, false )
    call PlaySoundOnUnitBJ( gg_snd_AnduinBase_Ultimate1Used00, 100.00, GetSpellTargetUnit() )
    endif
    call AddSpecialEffectLocBJ( udg_Blizzard[udg_Temp_Int], "war3mapImported\\FieldBASE.mdx" )
    call BlzSetSpecialEffectColor( GetLastCreatedEffectBJ(), 255, 255, 125 )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.65 )
    call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 5.00 )
    if udg_Temp_Unit == udg_yA_Holy_Priest then
    set udg_HWSalvA[1] = GetLastCreatedEffectBJ()
    call EnableTrigger( gg_trg_HW_Salv_Tick_A)
    elseif udg_Temp_Unit == udg_yH_Holy_Priest then
    set udg_HWSalvH[1] = GetLastCreatedEffectBJ()
    call EnableTrigger( gg_trg_HW_Salv_Tick_H)
    else
    set udg_HWSalvN[1] = GetLastCreatedEffectBJ()
    call EnableTrigger( gg_trg_HW_Salv_Tick_N)
    endif
    call AddSpecialEffectLocBJ( udg_Blizzard[udg_Temp_Int], "war3mapImported\\FieldBASE.mdx" )
    call BlzSetSpecialEffectColor( GetLastCreatedEffectBJ(), 255, 255, 125 )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.65 )
    call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 5.00 )
    if udg_Temp_Unit == udg_yA_Holy_Priest then
    set udg_HWSalvA[5] = GetLastCreatedEffectBJ()
    elseif udg_Temp_Unit == udg_yH_Holy_Priest then
    set udg_HWSalvH[5] = GetLastCreatedEffectBJ()
    else
    set udg_HWSalvN[5] = GetLastCreatedEffectBJ()
    endif
    call AddSpecialEffectLocBJ( udg_Blizzard[udg_Temp_Int], "war3mapImported\\Sacred Storm.mdx" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 1.50 )
    call BlzSetSpecialEffectAlpha( GetLastCreatedEffectBJ(), 0 )
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), ( BlzGetLocalSpecialEffectZ(GetLastCreatedEffectBJ()) - 100.00 ) )
    if udg_Temp_Unit == udg_yA_Holy_Priest then
    set udg_HWSalvA[2] = GetLastCreatedEffectBJ()
    elseif udg_Temp_Unit == udg_yH_Holy_Priest then
    set udg_HWSalvH[2] = GetLastCreatedEffectBJ()
    else
    set udg_HWSalvN[2] = GetLastCreatedEffectBJ()
    endif
    call AddSpecialEffectLocBJ( udg_Blizzard[udg_Temp_Int], "war3mapImported\\Spell Marker TC.mdx" )
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), ( BlzGetLocalSpecialEffectZ(GetLastCreatedEffectBJ()) - 50.00 ) )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 2.85 )
    call BlzSetSpecialEffectColorByPlayer( GetLastCreatedEffectBJ(), Player(4) )
    if udg_Temp_Unit == udg_yA_Holy_Priest then
    set udg_HWSalvA[3] = GetLastCreatedEffectBJ()
    elseif udg_Temp_Unit == udg_yH_Holy_Priest then
    set udg_HWSalvH[3] = GetLastCreatedEffectBJ()
    else
    set udg_HWSalvN[3] = GetLastCreatedEffectBJ()
    endif
    call AddSpecialEffectLocBJ( udg_Blizzard[udg_Temp_Int], "war3mapImported\\Mana Storm.mdx" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 1.00 )
    call BlzSetSpecialEffectAlpha( GetLastCreatedEffectBJ(), 0 )
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), ( BlzGetLocalSpecialEffectZ(GetLastCreatedEffectBJ()) - 100.00 ) )
    if udg_Temp_Unit == udg_yA_Holy_Priest then
    set udg_HWSalvA[4] = GetLastCreatedEffectBJ()
    elseif udg_Temp_Unit == udg_yH_Holy_Priest then
    set udg_HWSalvH[4] = GetLastCreatedEffectBJ()
    else
    set udg_HWSalvN[4] = GetLastCreatedEffectBJ()
    endif
    set udg_Temp_Unit = null
endfunction

