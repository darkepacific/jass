function InitTrig_E_Amani takes nothing returns nothing
    set gg_trg_E_Amani = CreateTrigger(  )
    call DisableTrigger( gg_trg_E_Amani )
    call TriggerRegisterEnterRectSimple( gg_trg_E_Amani, gg_rct_Amani_Enchroachment )
    call TriggerRegisterUnitInRangeSimple( gg_trg_E_Amani, 256, gg_unit_n010_0348 )
