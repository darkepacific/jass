//===========================================================================
// Trigger: Legion Spawn
//===========================================================================
function Trig_Legion_Spawn_Func020Func001C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetEnumUnit()) == 'u03B' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Legion_Spawn_Func020A takes nothing returns nothing
    if ( Trig_Legion_Spawn_Func020Func001C() ) then
        call IssueImmediateOrderBJ( GetEnumUnit(), "ravenform" )
    else
    endif
endfunction

function Trig_Legion_Spawn_Actions takes nothing returns nothing
    // Portal Demons
    set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_Dark_Portal_Demons_S)
    call CreateNUnitsAtLoc( 1, 'n03P', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
    call SetUnitAbilityLevelSwapped( 'A07M', GetLastCreatedUnit(), ( GetUnitLevel(GetLastCreatedUnit()) / 13 ) )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_Dark_Portal_Demons_S)
    call CreateNUnitsAtLoc( 1, 'n040', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_Dark_Portal_Demons_N)
    call CreateNUnitsAtLoc( 1, 'n03P', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
    call SetUnitAbilityLevelSwapped( 'A07M', GetLastCreatedUnit(), ( GetUnitLevel(GetLastCreatedUnit()) / 13 ) )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_Dark_Portal_Demons_N)
    call CreateNUnitsAtLoc( 1, 'n040', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
    call RemoveLocation (udg_Temp_Unit_Point)
    call DestroyTrigger( GetTriggeringTrigger())
    // Eyir
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRectOfPlayer(gg_rct_Hyrja_the_Golden_Valkyr, Player(PLAYER_NEUTRAL_AGGRESSIVE)), function Trig_Legion_Spawn_Func020A )
endfunction

