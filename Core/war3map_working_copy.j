    set gg_trg_U_PYR = CreateTrigger(  )
    call DisableTrigger( gg_trg_U_PYR )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_U_PYR, EVENT_PLAYER_UNIT_SPELL_CAST )
    call TriggerAddCondition( gg_trg_U_PYR, Condition( function Trig_U_PYR_Conditions ) )
