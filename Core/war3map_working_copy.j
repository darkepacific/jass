//===========================================================================
// Trigger: Rake
//===========================================================================
function Trig_Rake_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    if ( not ( GetSpellAbilityId() == 'A042' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Rake_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 5 ] then
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A042'), ABILITY_RLF_MOVEMENT_SPEED_FACTOR_ESH2, ( GetUnitAbilityLevel(GetTriggerUnit(), GetSpellAbilityId()) - 1 ), 0.5 )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A042'), ABILITY_RLF_ATTACK_SPEED_FACTOR_ESH3, ( GetUnitAbilityLevel(GetTriggerUnit(), GetSpellAbilityId()) - 1 ), 0.5 )
    else
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A042'), ABILITY_RLF_MOVEMENT_SPEED_FACTOR_ESH2, ( GetUnitAbilityLevel(GetTriggerUnit(), GetSpellAbilityId()) - 1 ), 0.0 )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A042'), ABILITY_RLF_ATTACK_SPEED_FACTOR_ESH3, ( GetUnitAbilityLevel(GetTriggerUnit(), GetSpellAbilityId()) - 1 ), 0.0)
    endif
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A042', udg_Temp_Unit) * 55 )
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_AGI, GetTriggerUnit(), true) - 0 ))
    set udg_RealStatCalc = ( 1.50 * udg_RealStatCalc )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A042'), ABILITY_RLF_INITIAL_DAMAGE_ESH5, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A042', udg_Temp_Unit) * 15 )
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 5 ] then
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_AGI, GetTriggerUnit(), true) - 0 ))
    else
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_AGI, GetTriggerUnit(), true) - GetHeroStatBJ(bj_HEROSTAT_AGI, GetTriggerUnit(), false) ))
    endif
    set udg_RealStatCalc = ( 0.50 * udg_RealStatCalc )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A042'), ABILITY_RLF_DECAYING_DAMAGE, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), udg_RealStatCalc )
endfunction

