//===========================================================================
// Trigger: E RV
//===========================================================================
function Trig_E_RV_Func006Func001C takes nothing returns boolean
    if ( not ( GetItemTypeId(udg_P_Items[( udg_Bag_Num + udg_Bag_Iterator )]) == udg_ItemTypeCheck ) ) then
        return false
    endif
    return true
endfunction

function Trig_E_RV_Func011Func001C takes nothing returns boolean
    if ( not ( ModuloInteger(GetTriggerExecCount(GetTriggeringTrigger()), 3) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_E_RV_Func011C takes nothing returns boolean
    if ( not ( ModuloInteger(GetTriggerExecCount(GetTriggeringTrigger()), 3) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_E_RV_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 104
    local location udg_Temp_Unit_Point
                       if IsHordeHero( GetTriggerUnit() ) then
    call SetBagNumber( GetOwningPlayer(GetTriggerUnit()) )
    set udg_ItemTypeCheck = 'I08J'
    set udg_Bag_Iterator = 1
    loop
        exitwhen udg_Bag_Iterator > udg_BAG_LOOP_MAX
        if ( Trig_E_RV_Func006Func001C() ) then
            call DisableTrigger( gg_trg_U_RV)
            call DisableTrigger( GetTriggeringTrigger() )
            if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
            call FlashQuestDialogButtonBJ(  )
            endif
            call QuestSetCompletedBJ( udg_Quests[104], true )
            call DestroyEffectBJ( udg_QuestMarks[104] )
            call DestroyMinimapIcon( udg_MiniMapIcon[104] )
            // Clean Up Items
            call CleanUpItems( udg_ItemTypeCheck )
            // Rewards
            set udg_XP = udg_QUEST_XP[udg_Temp_Int]
            set udg_Gold = udg_QUEST_GOLD[udg_Temp_Int]
            set udg_LVL_Req = udg_QUEST_LVL_REQ[udg_Temp_Int]
            set udg_TempString = "A Deadly New Ally"
            call TriggerExecute( gg_trg_Quest_Complete_H )
            call CreateTextTagUnitBJ( "TRIGSTR_9390", udg_LillianVoss, 0, 8.00, 85.00, 40.00, 100.00, 0 )
            call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 10.00, 90.00 )
            call cleanUpText(1.3, 1.0)
            call TriggerSleepAction( 1.20 )
            call IssueImmediateOrderBJ( udg_LillianVoss, "stop" )
            call IssueImmediateOrderBJ( udg_LillianVoss, "windwalk" )
            set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_Balnir_Farmstead)
            call IssuePointOrderLocBJ( udg_LillianVoss, "move", udg_Temp_Unit_Point )
            call RemoveLocation (udg_Temp_Unit_Point)
            call TriggerSleepAction( 6.00 )
              call RemoveUnit( udg_LillianVoss )
            return
        else
        endif
        set udg_Bag_Iterator = udg_Bag_Iterator + 1
    endloop
    // Run Away
    call CreateTextTagUnitBJ( "TRIGSTR_9393", udg_LillianVoss, 0, 8.00, 85.00, 40.00, 100.00, 0 )
    call cleanUpText(1.3, 1.0)
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
    if ( Trig_E_RV_Func011C() ) then
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_VossRunW)
    else
        if ( Trig_E_RV_Func011Func001C() ) then
            set udg_Temp_Unit_Point = GetRectCenter(gg_rct_VossRunM)
        else
            set udg_Temp_Unit_Point = GetRectCenter(gg_rct_VossRunE)
        endif
    endif
    call IssuePointOrderLocBJ( udg_LillianVoss, "move", udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call DisableTrigger( GetTriggeringTrigger() )
    call TriggerSleepAction( 1.00 )
    call EnableTrigger( GetTriggeringTrigger() )
    return
                       endif
    set udg_Temp_Unit_Point = null
endfunction

