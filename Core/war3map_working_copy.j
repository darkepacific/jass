//===========================================================================
// Trigger: Dwarf Rescued
//===========================================================================
function Trig_Dwarf_Rescued_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'e04K' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dwarf_Rescued_Func007C takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_Quests[122]) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dwarf_Rescued_Func008C takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_Quests[122]) == true ) ) then
        return false
    endif
    if ( not ( IsQuestCompleted(udg_Quests[123]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dwarf_Rescued_Actions takes nothing returns nothing
    local unit Dwarf
    local location udg_Temp_Polar_Point
    set Dwarf = GetTriggerUnit()
    set udg_Temp_Polar_Point = GetRectCenter(gg_rct_Z_StromGarde_Harbor_1)
    call IssuePointOrderLocBJ(Dwarf, "move", udg_Temp_Polar_Point )
    call RemoveLocation (udg_Temp_Polar_Point)
    if ( Trig_Dwarf_Rescued_Func007C() ) then
        set udg_QuestDwarvesSaved = ( udg_QuestDwarvesSaved + 1 )
        call QuestItemSetDescriptionBJ( udg_QuestReqs[122], ( "Dwarves Saved - " + ( I2S(R2I(udg_QuestDwarvesSaved)) + "/12" ) ) )
        call CreateTextTagUnitBJ( "TRIGSTR_7058", GetTriggerUnit(), 0, 10, 80.00, 100, 75.00, 0 )
        call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
        call cleanUpText( 0.8 , 0.6 )
    else
    endif
    if ( Trig_Dwarf_Rescued_Func008C() ) then
        call DisableTrigger(gg_trg_Dwarf_Cage_Destroyed)
    else
    endif
    call TriggerSleepAction( 6.25 )
    call SetUnitVertexColor(Dwarf, 0,0,0,0)
    call KillUnit(Dwarf)
    set Dwarf = null
    set udg_Temp_Polar_Point = null
endfunction

