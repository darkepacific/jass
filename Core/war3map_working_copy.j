//===========================================================================
// Trigger: Scarlet Gate
//===========================================================================
function Trig_Scarlet_Gate_Func007Func001C takes nothing returns boolean
    if ( not ( GetItemTypeId(udg_P_Items[( udg_Bag_Num + udg_Bag_Iterator )]) == udg_ItemTypeCheck ) ) then
        return false
    endif
    return true
endfunction

function Trig_Scarlet_Gate_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    local boolean hasItem
    set hasItem = false
                       if IsPlayerHero( GetTriggerUnit() ) then
    call SetBagNumber( GetOwningPlayer(GetTriggerUnit()) )
    set udg_ItemTypeCheck = 'I00Y'
    set udg_Bag_Iterator = 1
    loop
        exitwhen udg_Bag_Iterator > udg_BAG_LOOP_MAX
        if ( Trig_Scarlet_Gate_Func007Func001C() ) then
            set hasItem = true
        else
        endif
        set udg_Bag_Iterator = udg_Bag_Iterator + 1
    endloop
    if hasItem == true then
    call DisableTrigger( GetTriggeringTrigger() )
    call ModifyGateBJ( bj_GATEOPERATION_OPEN, gg_dest_DTg5_0744 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Scarlet_Gate)
    call PlaySoundAtPointBJ( gg_snd_BattleNetDoorsStereo2, 100, udg_Temp_Unit_Point, 0 )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 10.00 )
    call ModifyGateBJ( bj_GATEOPERATION_CLOSE, gg_dest_DTg5_0744 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Scarlet_Gate)
    call PlaySoundAtPointBJ( gg_snd_BattlenetBirth1, 100, udg_Temp_Unit_Point, 0 )
    call RemoveLocation (udg_Temp_Unit_Point)
    call EnableTrigger( GetTriggeringTrigger() )
    endif
                       endif
    set udg_Temp_Unit_Point = null
endfunction

