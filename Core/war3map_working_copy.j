endfunction

//===========================================================================
// Trigger: Into the Fray and Second Wind
//===========================================================================
function Trig_Into_the_Fray_and_Second_Wind_Actions takes nothing returns nothing
    local unit udg_Temp_Unit
    // Into the Fray
    set udg_Temp_Unit = GetKillingUnit()
    if udg_Temp_Unit == udg_yA_Prot_Warr or  udg_Temp_Unit == udg_yH_Prot_Warr then
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 3 ]  then
    call BlzEndUnitAbilityCooldown( udg_Temp_Unit, 'A018' )
    endif
    endif
    // Second Wind
    set udg_Temp_Unit = GetTriggerUnit()
    if udg_Temp_Unit == udg_yA_Prot_Warr then
    call DisableTrigger( gg_trg_Second_Wind_Prot_A )
    elseif udg_Temp_Unit == udg_yH_Prot_Warr then
    call DisableTrigger( gg_trg_Second_Wind_Prot_H )
    elseif udg_Temp_Unit == udg_yA_Arms_Warr then
    call DisableTrigger( gg_trg_Second_Wind_Arms_A )
    elseif udg_Temp_Unit == udg_yH_Arms_Warr then
    call DisableTrigger( gg_trg_Second_Wind_Arms_H )
    endif
    set udg_Temp_Unit = null
endfunction

