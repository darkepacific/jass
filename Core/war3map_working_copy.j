//===========================================================================
// Trigger: Gouge
//===========================================================================
function Trig_Gouge_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A00W' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Gouge_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    // Instant Dmg
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A00W', udg_Temp_Unit) * 45 )
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A00W'), ABILITY_RLF_INITIAL_DAMAGE_ESH5, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), udg_RealStatCalc )
    // Decaying Dmg
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A00W', udg_Temp_Unit) * 15 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 10 )
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A00W'), ABILITY_RLF_DECAYING_DAMAGE, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), udg_RealStatCalc )
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 9 ] then 
    call ArmorReduction( GetSpellTargetUnit() )
    endif
endfunction

//===========================================================================
function InitTrig_Gouge takes nothing returns nothing
    set gg_trg_Gouge = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Gouge, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Gouge, Condition( function Trig_Gouge_Conditions ) )
    call TriggerAddAction( gg_trg_Gouge, function Trig_Gouge_Actions )
endfunction

//===========================================================================
// Trigger: Chain Lightning
//===========================================================================
function Trig_Chain_Lightning_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'AOcl' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Chain_Lightning_Func009Func001C takes nothing returns boolean
    if ( ( GetRandomReal(0, 100.00) <= ( ( 2.00 + I2R(GetUnitAbilityLevelSwapped('AOcl', GetTriggerUnit())) ) + ( 0.75 * udg_RealStatCalc ) ) ) ) then
        return true
    endif
    if ( ( udg_Temp_Bool == true ) ) then
        return true
    endif
    return false
endfunction

function Trig_Chain_Lightning_Func009C takes nothing returns boolean
    if ( not Trig_Chain_Lightning_Func009Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Chain_Lightning_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 1 ]  then
    set udg_RealStatCalc = ( 10.70 + udg_RealStatCalc )
    endif
    call Debug("Chain Lightning RSC: " +  R2S(udg_RealStatCalc))
    // Echo
    call EchoOfTheElements()
    if ( Trig_Chain_Lightning_Func009C() ) then
        set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
        call CreateNUnitsAtLoc( 1, 'e01R', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, GetUnitFacing(GetTriggerUnit()) )
        call RemoveLocation (udg_Temp_Unit_Point)
        call SetUnitAbilityLevelSwapped( 'A00L', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('AOcl', GetTriggerUnit()) )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "chainlightning", GetSpellTargetUnit() )
        call UnitApplyTimedLifeBJ( 0.80, 'BTLF', GetLastCreatedUnit() )
    else
    endif
endfunction

//===========================================================================
function InitTrig_Chain_Lightning takes nothing returns nothing
    set gg_trg_Chain_Lightning = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Chain_Lightning, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Chain_Lightning, Condition( function Trig_Chain_Lightning_Conditions ) )
    call TriggerAddAction( gg_trg_Chain_Lightning, function Trig_Chain_Lightning_Actions )
