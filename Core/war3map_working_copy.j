    set udg_ItemDropTable[udg_i] = 'mnst'
    set udg_ItemDropPerc[udg_i] = 33.00
    set udg_i = ( udg_i + 1 )
    // DROP ITEM
    set udg_Temp_Unit_Point = GetUnitLoc(GetDyingUnit())
    call CreateItemsFromDropTable( udg_Temp_Unit_Point)
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 150.00 )
    set udg_Temp_Int = 0
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRectAll(gg_rct_Z_Dragonblight_Scarlet_Onslaught), function Trig_Scarlet_Inquisitor_Func015A )
    if ( Trig_Scarlet_Inquisitor_Func016C() ) then
        set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_Scarlet_Onslaught_Inquisitors)
        call CreateNUnitsAtLoc( 1, 'n060', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
        call RemoveLocation (udg_Temp_Unit_Point)
        call SetUnitColor( GetLastCreatedUnit(), GetPlayerColor(Player(12)) )
        call SetUnitAcquireRangeBJ( GetLastCreatedUnit(), 200.00 )
        set udg_Temp_Unit_Point = null
    else
    endif
endfunction

