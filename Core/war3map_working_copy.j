//===========================================================================
// Trigger: Blood Thirst
//
// Can be changed to just charges now
//===========================================================================
function Trig_Blood_Thirst_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Blood_Thirst_Func002Func001C takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetKillingUnitBJ()) == GetOwningPlayer(udg_Heroes[GetForLoopIndexA()]) ) ) then
        return false
    endif
    if ( not ( UnitHasItemOfTypeBJ(udg_Heroes[GetForLoopIndexA()], 'I06X') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Blood_Thirst_Func003Func005Func002Func001C takes nothing returns boolean
    if ( not ( SubStringBJ(BlzGetItemDescription(udg_Temp_Item), 25, 26) == I2S(GetForLoopIndexA()) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Blood_Thirst_Func003Func005C takes nothing returns boolean
    if ( not ( SubStringBJ(BlzGetItemDescription(udg_Temp_Item), 25, 26) != "30" ) ) then
        return false
    endif
    return true
endfunction

function Trig_Blood_Thirst_Func003C takes nothing returns boolean
    if ( not ( udg_Player_Number != 99 ) ) then
        return false
    endif
    if ( not ( GetHeroLevel(GetTriggerUnit()) > ( GetHeroLevel(udg_Heroes[udg_Player_Number]) - 11 ) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Blood_Thirst_Actions takes nothing returns nothing
    set udg_Player_Number = 99
    set bj_forLoopAIndex = 0
    set bj_forLoopAIndexEnd = 7
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_Blood_Thirst_Func002Func001C() ) then
            set udg_Player_Number = GetForLoopIndexA()
            exitwhen true
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    if ( Trig_Blood_Thirst_Func003C() ) then
        set udg_Temp_Unit = udg_Heroes[udg_Player_Number]
        set udg_Temp_Item = GetItemOfTypeFromUnitBJ(udg_Temp_Unit, 'I06X')
        if ( Trig_Blood_Thirst_Func003Func005C() ) then
            set bj_forLoopAIndex = 15
            set bj_forLoopAIndexEnd = 29
            loop
                exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
                if ( Trig_Blood_Thirst_Func003Func005Func002Func001C() ) then
                    call BlzItemRemoveAbilityBJ( udg_Temp_Item, udg_InitBloodThirst[( GetForLoopIndexA() - 15 )] )
                    call BlzItemAddAbilityBJ( udg_Temp_Item, udg_InitBloodThirst[( GetForLoopIndexA() - 14 )] )
                    call BlzSetItemDescription( udg_Temp_Item, ( "+45 Attack +8 Strength +" + ( I2S(( GetForLoopIndexA() + 1 )) + "% Life Steal |n|n|cccFF2200Non-Stacking Passive:|r Each Hero or Boss you kill with this item equipped increases the Life Steal of it by 1% up to a maximum of 30%. |cffc0c0c0(Enemies must not be 10 levels below your own.)|r" ) ) )
                    call BlzSetItemExtendedTooltip( udg_Temp_Item, ( "+45 Attack +8 Strength +" + ( I2S(( GetForLoopIndexA() + 1 )) + "% Life Steal |n|n|cccFF2200Non-Stacking Passive:|r Each Hero or Boss you kill with this item equipped increases the Life Steal of it by 1% up to a maximum of 30%. |cffc0c0c0(Enemies must not be 10 levels below your own.)|r" ) ) )
                    call BlzSetItemIntegerFieldBJ( udg_Temp_Item, ITEM_IF_NUMBER_OF_CHARGES, ( BlzGetItemIntegerField(udg_Temp_Item, ITEM_IF_NUMBER_OF_CHARGES) + 1 ) )
                    return
                else
                endif
                set bj_forLoopAIndex = bj_forLoopAIndex + 1
            endloop
        else
        endif
    else
    endif
endfunction

//===========================================================================
function InitTrig_Blood_Thirst takes nothing returns nothing
    set gg_trg_Blood_Thirst = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Blood_Thirst, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_Blood_Thirst, Condition( function Trig_Blood_Thirst_Conditions ) )
    call TriggerAddAction( gg_trg_Blood_Thirst, function Trig_Blood_Thirst_Actions )
endfunction

//===========================================================================
// Trigger: Dreadlords Claws
//
// 
//===========================================================================
function Trig_Dreadlords_Claws_Conditions takes nothing returns boolean
    if ( not ( UnitHasItemOfTypeBJ(GetKillingUnitBJ(), 'I03I') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dreadlords_Claws_Actions takes nothing returns nothing
    local item Item
    local unit udg_Temp_Unit
    set udg_Temp_Unit = GetKillingUnitBJ()
      call SetUnitAbilityLevel( gg_unit_e028_1863, 'ACbb', 11 )
    call SetUnitOwner( gg_unit_e028_1863, GetOwningPlayer(udg_Temp_Unit), false )
          call IssueTargetOrderBJ( gg_unit_e028_1863, "bloodlust", udg_Temp_Unit )
    set udg_Temp_Unit = null
    return
    // Old Impl, item based
    set udg_Temp_Item = GetItemOfTypeFromUnitBJ(udg_Temp_Unit, 'I03I')
    set Item = udg_Temp_Item
    call BlzItemAddAbilityBJ( udg_Temp_Item, 'A08E' )
    call TriggerSleepAction( 4.00 )
    set udg_Temp_Item = Item
    call BlzItemRemoveAbilityBJ( udg_Temp_Item, 'A08E' )
    set Item = null
    set udg_Temp_Unit = null
endfunction

