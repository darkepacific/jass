//===========================================================================
// Trigger: M BFF A
//===========================================================================
function Trig_M_BFF_A_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 74
    set udg_TempString = ""
    if IsAlliancePlayer( GetLocalPlayer() ) then
    set udg_TempString = udg_ExclamationMark
    endif
    call AddSpecialEffectTargetUnitBJ( "overhead", gg_unit_H02E_1848, udg_TempString )
    set udg_QuestMarks[udg_Temp_Int] = GetLastCreatedEffectBJ()
    set udg_TempString = "The Barov family fortune was divided during the Third War, its deeds scattered and contested. One lies among the dead in the Plaguelands, another within Scholomance, and the last among some Bandits."
    set udg_TempString = ( udg_TempString + " Recover all three deeds, and the matter of my inheritance may finally be… resolved." )
    // Set Quest Rewards
    set udg_QUEST_XP[udg_Temp_Int] = 1600
    set udg_QUEST_GOLD[udg_Temp_Int] = 500
    set udg_QUEST_LVL_REQ[udg_Temp_Int] = udg_QUEST_ZONE_4_LVL_REQ
    call QuestRewards_TextSet(udg_Temp_Int)
    // End Set Quest Rewards
    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_11718", udg_TempString, "ReplaceableTextures\\CommandButtons\\BTNThreeSnazzyScrolls-white-2_Classic.blp" )
    set udg_Quests[udg_Temp_Int] = GetLastCreatedQuestBJ()
    call QuestSetCompletedBJ( udg_Quests[udg_Temp_Int], false )
    call QuestSetEnabledBJ( false, udg_Quests[udg_Temp_Int] )
    call EnableTrigger(gg_trg_S_BFF_A)
endfunction

//===========================================================================
function InitTrig_M_BFF_A takes nothing returns nothing
    set gg_trg_M_BFF_A = CreateTrigger(  )
    call TriggerRegisterTimerEventSingle( gg_trg_M_BFF_A, 2.00 )
    call TriggerAddAction( gg_trg_M_BFF_A, function Trig_M_BFF_A_Actions )
endfunction

//===========================================================================
// Trigger: S BFF A
//
// Create Quests for ALL players,
// Enable/Disable Quests for specific players
// Enable/Disabling quests does not cause desyncing.
//===========================================================================
function Trig_S_BFF_A_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 74
    local location udg_Temp_Unit_Point
                       if IsAllianceHero( GetTriggerUnit() ) then
    set udg_TempString = "Barov Family Fortune"
    set udg_TempString_Quest = "Bring the Deeds to Brill, Caer Darrow, & Southshore to Weldon Barov"
    call TriggerExecute( gg_trg_Quest_Start_A )
    call DisableTrigger( GetTriggeringTrigger() )
    call DestroyEffectBJ( udg_QuestMarks[udg_Temp_Int] )
    if IsAlliancePlayer( GetLocalPlayer() ) then
    call QuestSetEnabledBJ( true, udg_Quests[udg_Temp_Int] )
    call FlashQuestDialogButtonBJ(  )
    endif
    call CreateQuestItemBJ( udg_Quests[udg_Temp_Int], udg_TempString_Quest )
    set udg_QuestReqs[udg_Temp_Int] = GetLastCreatedQuestItemBJ()
    set udg_TempString = ""
    if IsAlliancePlayer( GetLocalPlayer() ) then
    set udg_TempString = udg_QuestionMark
    endif
    call AddSpecialEffectTargetUnitBJ( "overhead", gg_unit_H02E_1848, udg_TempString )
    set udg_QuestMarks[udg_Temp_Int] = GetLastCreatedEffectBJ()
    call CampaignMinimapIconUnitBJ( gg_unit_H02E_1848, bj_CAMPPINGSTYLE_TURNIN )
    call SetMinimapIconOrphanDestroy( GetLastCreatedMinimapIcon(), false )
    set udg_MiniMapIcon[udg_Temp_Int] = GetLastCreatedMinimapIcon()
    call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), false )
    if IsAlliancePlayer( GetLocalPlayer() ) then
    call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), true )
    endif
    call EnableTrigger(gg_trg_U_BFF_A)
    call EnableTrigger(gg_trg_E_BFF_A)
                       endif
    set udg_Temp_Unit_Point = null
endfunction

//===========================================================================
function InitTrig_S_BFF_A takes nothing returns nothing
    set gg_trg_S_BFF_A = CreateTrigger(  )
    call DisableTrigger( gg_trg_S_BFF_A )
    call TriggerRegisterEnterRectSimple( gg_trg_S_BFF_A, gg_rct_A_BarovFF )
    call TriggerRegisterUnitInRangeSimple( gg_trg_S_BFF_A, 256, gg_unit_H02E_1848 )
    call TriggerAddAction( gg_trg_S_BFF_A, function Trig_S_BFF_A_Actions )
endfunction

