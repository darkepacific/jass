function InitTrig_Ice_Revenant_Ice_Spike takes nothing returns nothing
    set gg_trg_Ice_Revenant_Ice_Spike = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Ice_Revenant_Ice_Spike, EVENT_PLAYER_UNIT_DAMAGED)
    call TriggerAddCondition(gg_trg_Ice_Revenant_Ice_Spike, Condition(function Trig_Ice_Revenant_Ice_Spike_Conditions))
    call TriggerAddAction(gg_trg_Ice_Revenant_Ice_Spike, function Trig_Ice_Revenant_Ice_Spike_Actions)
endfunction
