        return false
    endif
    return true
endfunction

function Trig_Totem_Buffs_Func005C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'Aeye' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Totem_Buffs_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_Temp_Bool = udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 9 ] 
    if ( Trig_Totem_Buffs_Func003C() ) then
        if udg_Temp_Bool then
        set udg_RealStatCalc = 30.00
        else
        set udg_RealStatCalc = 15.00
        endif
        	call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A045'), ABILITY_RLF_DURATION_NORMAL, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_Temp_Unit) - 1 ), udg_RealStatCalc )
        	call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A045'), ABILITY_RLF_DURATION_HERO, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_Temp_Unit) - 1 ), udg_RealStatCalc )
        // Earth Talent
        set udg_Temp_Bool3 = udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 12 ] 
        if udg_Temp_Bool3 then
        call SetUnitAbilityLevelSwapped( 'A03P', gg_unit_e028_1863, 2 )
        call SetUnitOwner( gg_unit_e028_1863, GetOwningPlayer(udg_Temp_Unit), false )
        endif
        // Magma Talent
        set udg_Temp_Bool2 = udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 4 ] 
        if udg_Temp_Bool2 or udg_Temp_Bool3 then
        set udg_Temp_Unit_Point = GetSpellTargetLoc()
        if udg_Temp_Bool2 then
        call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
        set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - 0 ))
        set udg_RealStatCalc = ( 50.00 + ( 2.00 * udg_RealStatCalc ) )
        call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Damnation Orange.mdx" )
        call BlzSetSpecialEffectAlpha( GetLastCreatedEffectBJ(), 125 )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        endif
        set bj_wantDestroyGroup = true
        call ForGroupBJ( GetUnitsInRangeOfLocAll(260.00, udg_Temp_Unit_Point), function Trig_Totem_Buffs_Func003Func027A )
        call RemoveLocation (udg_Temp_Unit_Point)
        set udg_Temp_Unit = GetTriggerUnit()
        endif
    else
    endif
    if ( Trig_Totem_Buffs_Func004C() ) then
        if udg_Temp_Bool then
        set udg_RealStatCalc = 20.00
        else
        set udg_RealStatCalc = 10.00
        endif
        	call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'AChw'), ABILITY_RLF_DURATION_NORMAL, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_Temp_Unit) - 1 ), udg_RealStatCalc )
        	call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'AChw'), ABILITY_RLF_DURATION_HERO, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_Temp_Unit) - 1 ), udg_RealStatCalc )
    else
    endif
    if ( Trig_Totem_Buffs_Func005C() ) then
        if udg_Temp_Bool then
        set udg_RealStatCalc = 90.00
        else
        set udg_RealStatCalc = 45.00
        endif
        	call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'Aeye'), ABILITY_RLF_DURATION_NORMAL, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_Temp_Unit) - 1 ), udg_RealStatCalc )
        	call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'Aeye'), ABILITY_RLF_DURATION_HERO, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_Temp_Unit) - 1 ), udg_RealStatCalc )
    else
    endif
endfunction

