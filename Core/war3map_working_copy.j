//===========================================================================
// Trigger: Deaths Grasp LK
//
// Calculate the distance between Position of Unit
// Dont create chain units move them back and forth between island
//===========================================================================
function Trig_Deaths_Grasp_LK_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0DG' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'Uear' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Deaths_Grasp_LK_Actions takes nothing returns nothing
    set udg_A_DeathsGraspTarget[2] = GetSpellTargetUnit()
    set udg_Point_Charge_End[15] = GetUnitLoc(GetSpellAbilityUnit())
    set udg_Point_Charge_Begin[15] = GetUnitLoc(GetSpellTargetUnit())
    set udg_Chain_Target[3] = GetSpellTargetUnit()
    set udg_Charge_Distance = DistanceBetweenPoints(udg_Point_Charge_Begin[15], udg_Point_Charge_End[15])
    set udg_RealStatCalc = AngleBetweenPoints(udg_Point_Charge_Begin[15], udg_Point_Charge_End[15])
    set udg_Chain_Terminator_LK = ( R2I(( udg_Charge_Distance / 50.00 )) - 1 )
    // Create Distance / 50 chains (1 ~ 10)
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = udg_Chain_Terminator_LK
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Point_Charge_Begin[15], ( 50.00 * I2R(GetForLoopIndexA()) ), udg_RealStatCalc)
        call CreateNUnitsAtLocFacingLocBJ( 1, 'e024', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, udg_Point_Charge_End[15] )
        call RemoveLocation (udg_Temp_Polar_Point)
        set udg_Chain_Units_LK[GetForLoopIndexA()] = GetLastCreatedUnit()
        call SetUnitVertexColorBJ( GetLastCreatedUnit(), 58.82, 19.60, 78.43, 12.00 )
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    // make wolf face angle
    call BlzSetUnitFacingEx( udg_A_DeathsGraspTarget[2], udg_RealStatCalc )
    // Turn on Every .05 sec
    call AddSpecialEffectTargetUnitBJ( "chest", udg_A_DeathsGraspTarget[2], "war3mapImported\\Psionic Shot Purple.mdx" )
    set udg_Charge_SE[15] = GetLastCreatedEffectBJ()
    set udg_i_Chain_LK = 0
    call TriggerSleepAction( 0.28 )
    // playsound
    call EnableTrigger( gg_trg_Charge_Deaths_Grasp_LK)
endfunction

//===========================================================================
function InitTrig_Deaths_Grasp_LK takes nothing returns nothing
    set gg_trg_Deaths_Grasp_LK = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Deaths_Grasp_LK, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Deaths_Grasp_LK, Condition( function Trig_Deaths_Grasp_LK_Conditions ) )
    call TriggerAddAction( gg_trg_Deaths_Grasp_LK, function Trig_Deaths_Grasp_LK_Actions )
endfunction

//===========================================================================
// Trigger: Charge Deaths Grasp LK
//
// Set point position of chain
// Move Chain instantly Back to island
// then move wolf to point (if can be done)
// after charge loop iterations deal damage
//===========================================================================
function Trig_Charge_Deaths_Grasp_LK_Func001C takes nothing returns boolean
    if ( not ( udg_i_Chain_LK <= udg_Chain_Terminator_LK ) ) then
        return false
    endif
    return true
endfunction

function Trig_Charge_Deaths_Grasp_LK_Actions takes nothing returns nothing
    if ( Trig_Charge_Deaths_Grasp_LK_Func001C() ) then
        set udg_Temp_Unit_Point = GetUnitLoc(udg_Chain_Units_LK[udg_i_Chain_LK])
        call RemoveUnit( udg_Chain_Units_LK[udg_i_Chain_LK] )
        if not IsTerrainPathable( GetLocationX(udg_Temp_Unit_Point), GetLocationY(udg_Temp_Unit_Point), PATHING_TYPE_WALKABILITY) then
        call SetUnitPositionLoc( udg_A_DeathsGraspTarget[2], udg_Temp_Unit_Point )
        endif
        call RemoveLocation (udg_Temp_Unit_Point)
        set udg_i_Chain_LK = ( udg_i_Chain_LK + 1 )
    else
        call RemoveLocation (udg_Point_Charge_Begin[15])
        call RemoveLocation (udg_Point_Charge_End[15])
        call DestroyEffectBJ( udg_Charge_SE[15] )
        set udg_RealStatCalc = 40.00
        call UnitDamageTargetBJ( gg_unit_Uear_1259, udg_Chain_Target[3], ( 4.00 * udg_RealStatCalc ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        call DisableTrigger( GetTriggeringTrigger() )
    endif
endfunction

//===========================================================================
function InitTrig_Charge_Deaths_Grasp_LK takes nothing returns nothing
    set gg_trg_Charge_Deaths_Grasp_LK = CreateTrigger(  )
    call DisableTrigger( gg_trg_Charge_Deaths_Grasp_LK )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Charge_Deaths_Grasp_LK, 0.03 )
    call TriggerAddAction( gg_trg_Charge_Deaths_Grasp_LK, function Trig_Charge_Deaths_Grasp_LK_Actions )
endfunction

//===========================================================================
// Trigger: HeartSeeking Strike
//===========================================================================
function Trig_HeartSeeking_Strike_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A03U' ) ) then
        return false
    endif
    return true
endfunction

function Trig_HeartSeeking_Strike_Func041A takes nothing returns nothing
    if IsUnitTargetableEnemyStab( GetEnumUnit(), udg_Temp_Unit ) then
    ////
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "war3mapImported\\BloodExplosion.mdx" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.40 )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00) )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "overhead", GetEnumUnit(), "war3mapImported\\Ephemeral Cut Red.mdx" )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00) )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 1 )
    ////
    if udg_Temp_Bool then
    call IssueTargetOrderBJ( gg_unit_e00H_2048, "acidbomb", GetEnumUnit() )
    endif
    ////
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_HeartSeeking_Strike_Func042C takes nothing returns boolean
    if ( not ( udg_HeroStatCalc > 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_HeartSeeking_Strike_Func043C takes nothing returns boolean
    if ( not ( udg_HeroStatCalc > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_HeartSeeking_Strike_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    call AddSpecialEffectTargetUnitBJ( "weapon", GetTriggerUnit(), "war3mapImported\\Piercing Thrust.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "chest", GetTriggerUnit(), "war3mapImported\\ExecuteThrust.mdx" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.90 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 3 ]  then
    call SetUnitLifeBJ( udg_Temp_Unit, ( GetUnitState( udg_Temp_Unit, UNIT_STATE_LIFE ) * 0.96 ) )
    endif
    call TriggerSleepAction( 0.25 )
    set udg_Temp_Unit = GetTriggerUnit()
    call TriggerExecute( gg_trg_Firelords_Helper)
    // Blood Plague Talent
    set udg_Temp_Bool = udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 14 ] 
    if udg_Temp_Bool then
    call TriggerExecute(gg_trg_Blood_Plague_Passive)
    endif
    // Damage Calculation
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_STR, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 4.00 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A03U', udg_Temp_Unit) * 55 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 15 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 3 ]  then
    set udg_RealStatCalc = ( 1.50 * udg_RealStatCalc )
    endif
    // Crit Bonus
    call TriggerExecute( gg_trg_Crit_Check)
    // AoE
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_Length = 430.00
    set udg_Width = 200.00
    set udg_Facing_Angle = GetUnitFacing(udg_Temp_Unit)
    set udg_Temp_Polar_Point = GetUnitLoc(udg_Temp_Unit)
    set udg_Temp_Unit_Point = PolarProjectionBJ(udg_Temp_Polar_Point, 50.00, ( udg_Facing_Angle + 180.00 ))
    call RemoveLocation (udg_Temp_Polar_Point)
    call TriggerExecute( gg_trg_PICK_EVERY_UNIT_IN_RECT )
    set udg_HeroStatCalc = 0
    call RemoveLocation (udg_Temp_Unit_Point)
    call ForGroupBJ( udg_UnitsInRect, function Trig_HeartSeeking_Strike_Func041A )
    if ( Trig_HeartSeeking_Strike_Func042C() ) then
        set udg_HeroStatCalc = 3
    else
    endif
    if ( Trig_HeartSeeking_Strike_Func043C() ) then
        call PlaySoundOnUnitBJ( gg_snd_HealTarget, 66.00, GetTriggerUnit() )
        set udg_RealStatCalc = ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, GetTriggerUnit()) * I2R(udg_HeroStatCalc) )
        set udg_RealStatCalc = ( udg_RealStatCalc * ( ( 0.00 * I2R(GetUnitAbilityLevelSwapped('A03U', GetTriggerUnit())) ) + 4.00 ) )
        set udg_RealStatCalc = ( udg_RealStatCalc / 100.00 )
        call ChaliceSetRSC()
        call SetUnitLifeBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) + udg_RealStatCalc ) )
        call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "war3mapImported\\VampiricAuraTarget.mdx" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    else
    endif
endfunction

//===========================================================================
function InitTrig_HeartSeeking_Strike takes nothing returns nothing
    set gg_trg_HeartSeeking_Strike = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_HeartSeeking_Strike, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_HeartSeeking_Strike, Condition( function Trig_HeartSeeking_Strike_Conditions ) )
    call TriggerAddAction( gg_trg_HeartSeeking_Strike, function Trig_HeartSeeking_Strike_Actions )
endfunction

//===========================================================================
// Trigger: Bloodworm
//===========================================================================
function Trig_Bloodworm_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'ndwm' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Bloodworm_Actions takes nothing returns nothing
    local unit udg_Temp_Unit = udg_Heroes[ HeroesNumb( GetTriggerPlayer() ) ]
    local real Healing = 0.08
    if ChaliceCheck() then
    set Healing =  Healing + ( udg_CHALICE_HEAL * Healing )
    endif
    call MissingHealthRestore( Healing, udg_Temp_Unit )
    call PlaySoundOnUnitBJ( gg_snd_HealTarget, 66.00, udg_Temp_Unit )
    call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "war3mapImported\\VampiricAuraTarget.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set udg_Temp_Unit = null
endfunction

