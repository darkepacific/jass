//===========================================================================
// Trigger: S GD
//
// Create Quests for ALL players,
// Enable/Disable Quests for specific players
// Enable/Disabling quests does not cause desyncing.
//===========================================================================
function Trig_S_GD_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 142
                       if IsHordeHero( GetTriggerUnit() ) then
    set udg_TempString = "Godfrey's Downfall"
    set udg_TempString_Quest = "Kill Lord Godfrey"
    call TriggerExecute( gg_trg_Quest_Start_H )
    call DestroyEffectBJ( udg_QuestMarks[udg_Temp_Int] )
    // Icon
    call CampaignMinimapIconUnitBJ( gg_unit_H022_1762, bj_CAMPPINGSTYLE_BOSS )
    set udg_MiniMapIcon[udg_Temp_Int] = GetLastCreatedMinimapIcon()
    call SetMinimapIconOrphanDestroy( GetLastCreatedMinimapIcon(), false )
    call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), false )
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    call FlashQuestDialogButtonBJ(  )
    call QuestSetEnabledBJ( true, udg_Quests[udg_Temp_Int] )
    call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), true )
    endif
    call QuestSetCompletedBJ( udg_Quests[udg_Temp_Int], false )
    call CreateQuestItemBJ( udg_Quests[udg_Temp_Int], "TRIGSTR_9358" )
    set udg_QuestReqs[udg_Temp_Int] = GetLastCreatedQuestItemBJ()
    call DisableTrigger( GetTriggeringTrigger() )
    call EnableTrigger(gg_trg_E_GD)
                       endif
endfunction

//===========================================================================
function InitTrig_S_GD takes nothing returns nothing
    set gg_trg_S_GD = CreateTrigger(  )
    call DisableTrigger( gg_trg_S_GD )
    call TriggerRegisterEnterRectSimple( gg_trg_S_GD, gg_rct_Repel_The_Invaders )
    call TriggerAddAction( gg_trg_S_GD, function Trig_S_GD_Actions )
endfunction

//===========================================================================
// Trigger: C GD
//
//  "I'll never obey! Never!!!"
//===========================================================================
function Trig_C_GD_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    if ( IsUnitDead( udg_ValkyrGilneas ) ) then
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_GY_Gilneas_City_Controlled)
    call CreateNUnitsAtLoc( 1, 'u02P', Player(3), udg_Temp_Unit_Point, 90.00 )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_ValkyrGilneas = GetLastCreatedUnit()
    endif
    call TriggerSleepAction( 0.50 )
    call IssueImmediateOrderBJ( udg_ValkyrGilneas, "ravenform" )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Lord_Godfrey)
    call IssuePointOrderLocBJ( udg_ValkyrGilneas, "move", udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call SetUnitMoveSpeed( udg_ValkyrGilneas, 522.00 )
    call TriggerSleepAction( 7.00 )
    call CreateTextTagUnitBJ( "TRIGSTR_9459", udg_ValkyrGilneas, 0, 9.00, 50.00, 100, 100, 0 )
    call cleanUpText(2.5,2.2)
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Lord_Godfrey)
    call CreateNUnitsAtLoc( 1, 'e02H', Player(PLAYER_NEUTRAL_PASSIVE), udg_Temp_Unit_Point, 0.00 )
    call IssueTargetOrderBJ( udg_ValkyrGilneas, "forkedlightning", GetLastCreatedUnit() )
    call UnitApplyTimedLifeBJ( 1.10, 'BTLF', GetLastCreatedUnit() )
    call PlaySoundAtPointBJ( gg_snd_LightningBolt1, 100.00, udg_Temp_Unit_Point, 0 )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 1.00 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Lord_Godfrey)
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl" )
    call ReviveHeroLoc( gg_unit_H022_1762, udg_Temp_Unit_Point, true )
    call SetUnitVertexColorBJ(gg_unit_H022_1762,90,65,100, 0)
    call AddSpecialEffectTargetUnitBJ( "head", gg_unit_H022_1762, "war3mapImported\\Blackmage Hat Black.mdx" )
    call RemoveLocation (udg_Temp_Unit_Point)
    call PauseAddInvuln(gg_unit_H022_1762, null)
    call TriggerSleepAction( 1.70 )
    call CreateTextTagUnitBJ( "TRIGSTR_9482", gg_unit_H022_1762, 0, 9.00, 100.00, 30.00, 0.00, 0 )
    call cleanUpText(2.5,2.2)
    call TriggerSleepAction( 0.25 )
    call UnPauseAddInvuln(gg_unit_H022_1762, null)
    call TriggerSleepAction( 1.25 )
    call KnockBackUnit(gg_unit_H022_1762, 285, 130, 300, 1, 48, true)
    call TriggerSleepAction( 0.60 )
    call PauseAddInvuln(gg_unit_H022_1762, null)
    call KillUnit(gg_unit_H022_1762)
    call UnPauseAddInvuln(gg_unit_H022_1762, null)
    set udg_Temp_Unit_Point = null
endfunction

