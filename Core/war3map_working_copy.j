function Trig_E_Find_Dolly_A_Func005Func001C takes nothing returns boolean
    if ( not ( GetItemTypeId(udg_P_Items[( udg_Bag_Num + udg_Bag_Iterator )]) == udg_ItemTypeCheck ) ) then
        return false
    endif
    return true
endfunction

function Trig_E_Find_Dolly_A_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 65
                       if IsAllianceHero( GetTriggerUnit() ) then
    call SetBagNumber( GetOwningPlayer(GetTriggerUnit()) )
    set udg_ItemTypeCheck = 'I079'
    set udg_Bag_Iterator = 1
    loop
        exitwhen udg_Bag_Iterator > udg_BAG_LOOP_MAX
        if ( Trig_E_Find_Dolly_A_Func005Func001C() ) then
            if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
            call FlashQuestDialogButtonBJ(  )
            endif
            call QuestItemSetCompletedBJ( udg_QuestReqs[65], true )
            call QuestSetCompletedBJ( udg_Quests[65], true )
            call DestroyMinimapIcon( udg_MiniMapIcon[65] )
            call DestroyEffectBJ( udg_QuestMarks[65] )
            // Clean Up Items
            call CleanUpItems_Alliance( udg_ItemTypeCheck )
            // Rewards
            set udg_XP = udg_QUEST_XP[udg_Temp_Int]
            set udg_Gold = udg_QUEST_GOLD[udg_Temp_Int]
            set udg_LVL_Req = udg_QUEST_LVL_REQ[udg_Temp_Int]
            set udg_TempString = "Find Dolly"
            call TriggerExecute( gg_trg_Quest_Complete_A )
            if ( Trig_E_Find_Dolly_A_Func005Func001Func016C() ) then
                call CleanUpItems( udg_ItemTypeCheck )
                call DisableTrigger( gg_trg_U_Find_Dolly )
            else
            endif
            call DisableTrigger( gg_trg_S_or_U_Find_Dolly_A_by_Acquire )
            call DisableTrigger( GetTriggeringTrigger() )
            call TriggerSleepAction( 1.75 )
            call PlaySoundOnUnitBJ( gg_snd_H01VillagerC37, 100.00, gg_unit_n03L_1843 )
            call CreateTextTagUnitBJ( "TRIGSTR_1925", gg_unit_n03L_1843, 0.00, 8.00, 100.00, 100.00, 0.00, 0 )
            call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
            call cleanUpText(1.2, 0.8)
            return
        else
        endif
        set udg_Bag_Iterator = udg_Bag_Iterator + 1
    endloop
                       endif
endfunction

