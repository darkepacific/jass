    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'Nkjx' ) ) then
        return false
    endif
    if ( not ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) < 7800.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_KilJaeden_Oblivion_Func050A takes nothing returns nothing
    local unit udg_Temp_Unit = gg_unit_Nkjx_2318
    local location udg_Temp_Unit_Point
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Oblivion_Blue_Shield)
    if IsUnitTargetableEnemyHitsAll( GetEnumUnit(), udg_Temp_Unit ) then
    if IsUnitInRangeLoc( GetEnumUnit(), udg_Temp_Unit_Point, 320) == false then
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), 10000.00, ATTACK_TYPE_HERO, DAMAGE_TYPE_UNIVERSAL )
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "war3mapImported\\Voidball Major.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    else
    call AddSpecialEffectTargetUnitBJ( "overhead", GetEnumUnit(), "war3mapImported\\Armor Penetration Blue.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    endif
    endif
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit = null
    set udg_Temp_Unit_Point = null
endfunction

function Trig_KilJaeden_Oblivion_Actions takes nothing returns nothing
    local unit udg_Temp_Unit = gg_unit_Nkjx_2318
    local effect shield1
    local effect shield2
    local effect shield3
    local effect shield4
    local effect shield5
    local effect circle
    local location udg_Temp_Unit_Point
    if RectContainsUnit( gg_rct_Sunwell_Plateau,  GetEventDamageSource() ) then
    call DisableTrigger( GetTriggeringTrigger() )
    call DisableTrigger( gg_trg_Shadowbolt_Volley_KJ)
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Oblivion_Blue_Shield)
    call SetUnitAnimation( gg_unit_Nkjx_2318, "cinematic 2178" )
    call PlaySoundOnUnitBJ( gg_snd_KilJaeden_AnakKiri, 100.00, GetTriggerUnit() )
    call BlzSetUnitAttackCooldown( udg_Temp_Unit, 6.00, 0) 
    call BlzSetUnitAttackCooldown( udg_Temp_Unit, 6.00, 1) 
    call Create_Oblivion_Shield( udg_Temp_Unit_Point)
    set shield1 = bj_lastCreatedEffect
    call Create_Oblivion_Shield( udg_Temp_Unit_Point)
    set shield2 = bj_lastCreatedEffect
    call Create_Oblivion_Shield( udg_Temp_Unit_Point)
    set shield3 = bj_lastCreatedEffect
    call Create_Oblivion_Shield( udg_Temp_Unit_Point)
    set shield4 = bj_lastCreatedEffect
    call Create_Oblivion_Shield( udg_Temp_Unit_Point)
    set shield5 = bj_lastCreatedEffect
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Spell Marker TC.mdx" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 2.85 )
    call BlzSetSpecialEffectColorByPlayer( GetLastCreatedEffectBJ(), Player(1) )
    set circle = bj_lastCreatedEffect
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 1.00 )
    if IsUnitAliveBJ(udg_Temp_Unit)  then
    call SetUnitAnimation( gg_unit_Nkjx_2318, "cinematic 2186" )
    endif
    call TriggerSleepAction( 1.67 )
    if IsUnitAliveBJ(udg_Temp_Unit)  then
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    call PlaySoundOnUnitBJ( gg_snd_KilJaeden_Oblivion, 100.00, GetTriggerUnit() )
    call SetUnitAnimation( gg_unit_Nkjx_2318, "cinematic 2197" )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\ArcaneExplosion.mdx" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 2.00 )
    call BlzSetSpecialEffectColor( GetLastCreatedEffectBJ(), 255, 50, 255 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Arcane Explosion.mdx" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 5.00 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call RemoveLocation (udg_Temp_Unit_Point)
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRectAll(gg_rct_Z_Sunwell_Plateau), function Trig_KilJaeden_Oblivion_Func050A )
    endif
    call TriggerSleepAction( 0.26 )
    call DestroyEffect(shield1)
    call DestroyEffect(shield2)
    call DestroyEffect(shield3)
    call DestroyEffect(shield4)
    call DestroyEffect(shield5)
    call DestroyEffect(circle)
    call TriggerSleepAction( 0.50 )
    set udg_Temp_Unit = gg_unit_Nkjx_2318
    call BlzSetUnitAttackCooldown( udg_Temp_Unit, 1.60, 0) 
    call BlzSetUnitAttackCooldown( udg_Temp_Unit, 2.13, 1) 
    call IssueImmediateOrder(udg_Temp_Unit, "stop")
    call IssueImmediateOrder(udg_Temp_Unit, "holdposition")

    call IssuePointOrder(udg_Temp_Unit, "attack", GetUnitX(udg_Temp_Unit), GetUnitY(udg_Temp_Unit))

    call TriggerSleepAction( 5.00 )
    call EnableTrigger( gg_trg_Shadowbolt_Volley_KJ)
    endif
    set shield1 = null
    set shield2 = null
    set shield3 = null
    set shield4 = null
    set shield5 = null
    set circle = null
    set udg_Temp_Unit_Point = null
    set udg_Temp_Unit = null
endfunction

