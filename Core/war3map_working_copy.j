function InitTrig_U_TBWW takes nothing returns nothing
    set gg_trg_U_TBWW = CreateTrigger(  )
    call DisableTrigger( gg_trg_U_TBWW )
    call TriggerRegisterEnterRectSimple( gg_trg_U_TBWW, gg_rct_Q_The_Bride_Who_Waits_Turn_In )
    call TriggerAddAction( gg_trg_U_TBWW, function Trig_U_TBWW_Actions )
