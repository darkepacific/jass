function Trig_Blood_DK_Max_Actions takes nothing returns nothing
    if ( Trig_Blood_DK_Max_Func001C() ) then
        call SetUnitAbilityLevelSwapped( 'A03Y', GetTriggerUnit(), 2 )
        call SetUnitAbilityLevelSwapped( 'A073', GetTriggerUnit(), 2 )
        call SetUnitAbilityLevelSwapped( 'A0FJ', GetTriggerUnit(), 2 )
        if ( Trig_Blood_DK_Max_Func001Func004C() ) then
            call SetUnitAbilityLevelSwapped( 'A03Y', GetTriggerUnit(), 3 )
            call SetUnitAbilityLevelSwapped( 'A073', GetTriggerUnit(), 3 )
            call SetUnitAbilityLevelSwapped( 'A0FJ', GetTriggerUnit(), 3 )
        else
        endif
    else
    endif
endfunction

