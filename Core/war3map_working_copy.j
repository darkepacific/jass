    set gg_trg_Bloodworm = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Bloodworm, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_Bloodworm, Condition( function Trig_Bloodworm_Conditions ) )
    call TriggerAddAction( gg_trg_Bloodworm, function Trig_Bloodworm_Actions )
