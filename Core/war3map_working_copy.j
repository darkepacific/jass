//===========================================================================
// Trigger: MultiShot Cast Copy Copy
//===========================================================================
function Trig_MultiShot_Cast_Copy_Copy_Func002C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A0A2' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A065' ) ) then
        return true
    endif
    return false
endfunction

function Trig_MultiShot_Cast_Copy_Copy_Conditions takes nothing returns boolean
    if ( not ( GetPlayerController(GetOwningPlayer(GetTriggerUnit())) == MAP_CONTROL_USER ) ) then
        return false
    endif
    if ( not Trig_MultiShot_Cast_Copy_Copy_Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_MultiShot_Cast_Copy_Copy_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    if udg_Temp_Unit != udg_yA_Marksman_Hunter and  udg_Temp_Unit != udg_yH_Marksman_Hunter then
    return
    endif
    if IsMultiShotForm( udg_Temp_Unit) == false then
    // remove item abils
    call TriggerExecute( gg_trg_Orb_Removal)
    call GameTimeWait(0.1)
    set udg_Temp_Unit = GetTriggerUnit()
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer( udg_Temp_Unit )) * udg_NUM_OF_TC + 12 ]  then
    call BlzSetUnitBaseDamage( udg_Temp_Unit , BlzGetUnitBaseDamage( udg_Temp_Unit, 0 ) + 135, 0)
    call BlzSetUnitBaseDamage( udg_Temp_Unit , BlzGetUnitBaseDamage( udg_Temp_Unit, 1 ) + 135, 1)
    endif
    else
    // add item abils
    call TriggerExecute( gg_trg_Orb_Added)
    endif
endfunction

//===========================================================================
function InitTrig_MultiShot_Cast_Copy_Copy takes nothing returns nothing
    set gg_trg_MultiShot_Cast_Copy_Copy = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_MultiShot_Cast_Copy_Copy, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_MultiShot_Cast_Copy_Copy, Condition( function Trig_MultiShot_Cast_Copy_Copy_Conditions ) )
    call TriggerAddAction( gg_trg_MultiShot_Cast_Copy_Copy, function Trig_MultiShot_Cast_Copy_Copy_Actions )
endfunction

//===========================================================================
// Trigger: Busting Shot
//
// Calc distance in tics
//===========================================================================
function Trig_Busting_Shot_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0ED' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Busting_Shot_Func019C takes nothing returns boolean
    if ( not ( udg_Temp_Int == 32 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Busting_Shot_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    if ( GetTriggerUnit() == udg_yA_Marksman_Hunter ) then
    set udg_Temp_Int = 32
    else
    set udg_Temp_Int = 33
    endif
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    set udg_Temp_Polar_Point = GetSpellTargetLoc()
    set udg_Facing_Angle = AngleBetweenPoints(udg_Temp_Unit_Point, udg_Temp_Polar_Point)
    set udg_Point_Charge_Begin[udg_Temp_Int] = PolarProjectionBJ(udg_Temp_Unit_Point, 64.00, udg_Facing_Angle)
    call RemoveLocation (udg_Temp_Unit_Point)
    call RemoveLocation (udg_Temp_Polar_Point)
    set udg_Point_Charge_End[udg_Temp_Int] = PolarProjectionBJ(udg_Point_Charge_Begin[udg_Temp_Int], 1700.00, udg_Facing_Angle)
    set udg_Charge_Loop[udg_Temp_Int] = 0.00
    call AddSpecialEffectLocBJ( udg_Point_Charge_Begin[udg_Temp_Int], "war3mapImported\\FirecrackerArrow.mdx" )
    set udg_Charge_SE[udg_Temp_Int] = GetLastCreatedEffectBJ()
    call BlzSetSpecialEffectYaw( udg_Charge_SE[udg_Temp_Int], Deg2Rad(udg_Facing_Angle) )
    call BlzSetSpecialEffectScale( udg_Charge_SE[udg_Temp_Int], 2.20 )
    if ( Trig_Busting_Shot_Func019C() ) then
        call EnableTrigger( gg_trg_Bursting_Shot_Tick_NE)
    else
        call EnableTrigger( gg_trg_Bursting_Shot_Tick_BE)
    endif
endfunction

//===========================================================================
function InitTrig_Busting_Shot takes nothing returns nothing
    set gg_trg_Busting_Shot = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Busting_Shot, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Busting_Shot, Condition( function Trig_Busting_Shot_Conditions ) )
    call TriggerAddAction( gg_trg_Busting_Shot, function Trig_Busting_Shot_Actions )
endfunction

//===========================================================================
// Trigger: Bursting Shot Tick NE
//===========================================================================
function Trig_Bursting_Shot_Tick_NE_Func016A takes nothing returns nothing
    if IsUnitTargetableEnemyGround( GetEnumUnit(), udg_Temp_Unit ) then
    set udg_Temp_Bool = true
    endif
endfunction

function Trig_Bursting_Shot_Tick_NE_Func025Func027C takes nothing returns boolean
    if ( not ( IsUnitInGroup(GetEnumUnit(), udg_KnockBacks) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Bursting_Shot_Tick_NE_Func025A takes nothing returns nothing
    set udg_Temp_Unit = udg_yA_Marksman_Hunter
    if IsUnitTargetableEnemyGround( GetEnumUnit(), udg_Temp_Unit ) then
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "Abilities\\Weapons\\RedDragonBreath\\RedDragonMissile.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call HasFirelords( GetEnumUnit() )
    ////
    // ======= //
    // mvmnt
    set udg_Temp_X_Point = GetUnitLoc(GetEnumUnit())
    set udg_Temp_Real = AngleBetweenPoints(udg_Temp_Unit_Point, udg_Temp_X_Point)
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_X_Point, 80.00, udg_Temp_Real)
    if not IsTerrainPathable( GetLocationX(udg_Temp_Polar_Point), GetLocationY(udg_Temp_Polar_Point), PATHING_TYPE_WALKABILITY) then
    call SetUnitPositionLoc( GetEnumUnit(), udg_Temp_Polar_Point )
    endif
    call AddSpecialEffectLocBJ( udg_Temp_Polar_Point, "Abilities\\Weapons\\CannonTowerMissile\\CannonTowerMissile.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectLocBJ( udg_Temp_Polar_Point, "war3mapImported\\FirecrackerArrow.mdx" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 2.00 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call RemoveLocation (udg_Temp_X_Point)
    call RemoveLocation (udg_Temp_Polar_Point)
    // KnockBackLoop Turn ON
    call UnitAddAbilityBJ( 'Amrf', GetEnumUnit() )
    call UnitRemoveAbilityBJ( 'Amrf', GetEnumUnit() )
    call SetUnitFlyHeightBJ( GetEnumUnit(), 135.00, 0.00 )
    if ( Trig_Bursting_Shot_Tick_NE_Func025Func027C() ) then
        call GroupAddUnitSimple( GetEnumUnit(), udg_KnockBacks )
    else
        call FlushChildHashtableBJ( GetHandleIdBJ(GetEnumUnit()), udg_KnockBacksHash )
    endif
    call SaveRealBJ( udg_Temp_Real, 0, GetHandleIdBJ(GetEnumUnit()), udg_KnockBacksHash )
    call SaveRealBJ( 3.00, 1, GetHandleIdBJ(GetEnumUnit()), udg_KnockBacksHash )
    call SaveRealBJ( 172.00, 2, GetHandleIdBJ(GetEnumUnit()), udg_KnockBacksHash )
    call SaveRealBJ( 13.00, 3, GetHandleIdBJ(GetEnumUnit()), udg_KnockBacksHash )
    call EnableTrigger( gg_trg_KnockBackLoop)
    // ======= //
    ////
    endif
endfunction

function Trig_Bursting_Shot_Tick_NE_Func028C takes nothing returns boolean
    if ( not ( udg_Charge_Loop[udg_Temp_Int] < 69.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Bursting_Shot_Tick_NE_Actions takes nothing returns nothing
    set udg_Temp_Unit = udg_yA_Marksman_Hunter
    call TriggerExecute( gg_trg_Firelords_Helper)
    set udg_Temp_Int = 32
    // point calc
    set udg_Length = 27.00
    set udg_Facing_Angle = AngleBetweenPoints(udg_Point_Charge_Begin[udg_Temp_Int], udg_Point_Charge_End[udg_Temp_Int])
    set udg_Temp_Unit_Point = PolarProjectionBJ(udg_Point_Charge_Begin[udg_Temp_Int], ( udg_Length * udg_Charge_Loop[udg_Temp_Int] ), udg_Facing_Angle)
    call BlzSetSpecialEffectPositionLoc( udg_Charge_SE[udg_Temp_Int], udg_Temp_Unit_Point )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Weapons\\RedDragonBreath\\RedDragonMissile.mdl" )
    call BlzSetSpecialEffectZ( udg_Charge_SE[udg_Temp_Int], ( 24.00 + BlzGetLocalSpecialEffectZ(GetLastCreatedEffectBJ()) ) )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.70 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    // Detection
    set udg_Temp_Bool = false
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(140.00, udg_Temp_Unit_Point), function Trig_Bursting_Shot_Tick_NE_Func016A )
    // AoE DMG
    if udg_Temp_Bool then
    call StopSoundBJ( gg_snd_BurstingShot_Impact01, false )
    call PlaySoundAtPointBJ( gg_snd_BurstingShot_Impact01, 100, udg_Temp_Unit_Point, 20.00 )
    set udg_RealStatCalc = CalculateBurstingShotDmg(udg_Temp_Unit)
    set udg_RealStatCalc = ( ( ( udg_Charge_Loop[udg_Temp_Int] / 34.00 ) + 1.00 ) * udg_RealStatCalc )
    set udg_Charge_Loop[udg_Temp_Int] = 70.00
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(240.00, udg_Temp_Unit_Point), function Trig_Bursting_Shot_Tick_NE_Func025A )
    endif
    set udg_Temp_Int = 32
    if ( Trig_Bursting_Shot_Tick_NE_Func028C() ) then
        set udg_Charge_Loop[udg_Temp_Int] = ( udg_Charge_Loop[udg_Temp_Int] + 1 )
        call RemoveLocation (udg_Temp_Unit_Point)
    else
        call DisableTrigger( GetTriggeringTrigger() )
        call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Firebolt Rough Major.mdx" )
        call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.80 )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call DestroyEffectBJ( udg_Charge_SE[udg_Temp_Int] )
        call RemoveLocation (udg_Temp_Unit_Point)
        call RemoveLocation (udg_Point_Charge_Begin[udg_Temp_Int])
        call RemoveLocation (udg_Point_Charge_End[udg_Temp_Int])
    endif
endfunction

//===========================================================================
function InitTrig_Bursting_Shot_Tick_NE takes nothing returns nothing
    set gg_trg_Bursting_Shot_Tick_NE = CreateTrigger(  )
    call DisableTrigger( gg_trg_Bursting_Shot_Tick_NE )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Bursting_Shot_Tick_NE, 0.03 )
    call TriggerAddAction( gg_trg_Bursting_Shot_Tick_NE, function Trig_Bursting_Shot_Tick_NE_Actions )
endfunction

