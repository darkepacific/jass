function Trig_S_CVE_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
                       if IsHordeHero( GetTriggerUnit() ) then
    set udg_TempString = "Collecting Void Essence"
    set udg_TempString_Quest = "Kill void walkers and return 3 of their essence."
    call TriggerExecute( gg_trg_Quest_Start_H )
    set udg_TempString = ""
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    set udg_TempString = udg_QuestionMark
    call QuestSetEnabledBJ( true, udg_Quests[14] )
    call FlashQuestDialogButtonBJ(  )
    endif
    call DestroyEffectBJ( udg_QuestMarks[14] )
    call AddSpecialEffectTargetUnitBJ( "overhead", gg_unit_Hblm_0221, udg_TempString )
    set udg_QuestMarks[14] = GetLastCreatedEffectBJ()
    call QuestSetCompletedBJ( udg_Quests[14], false )
    call CreateQuestItemBJ( udg_Quests[14], "TRIGSTR_4646" )
    set udg_QuestReqs[14] = GetLastCreatedQuestItemBJ()
    // Icon
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Voidwalkers_East)
    call CampaignMinimapIconLocBJ( udg_Temp_Unit_Point, bj_CAMPPINGSTYLE_CONTROL_NEUTRAL )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_MiniMapIcon[14] = GetLastCreatedMinimapIcon()
    call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), false )
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), true )
    endif
    call DisableTrigger( GetTriggeringTrigger() )
    call EnableTrigger( gg_trg_U_CVE )
    call EnableTrigger( gg_trg_E_CVE )
                       endif
    set udg_Temp_Unit_Point = null
endfunction

