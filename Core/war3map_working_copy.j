//===========================================================================
// Trigger: Hyrja
//===========================================================================
function Trig_Hyrja_Func005C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'e019' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'u03B' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Hyrja_Conditions takes nothing returns boolean
    if ( not Trig_Hyrja_Func005C() ) then
        return false
    endif
    return true
endfunction

function Trig_Hyrja_Func017Func001C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetEnumUnit()) == 'u03B' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hyrja_Func017A takes nothing returns nothing
    if ( Trig_Hyrja_Func017Func001C() ) then
        call IssueImmediateOrderBJ( GetEnumUnit(), "ravenform" )
    else
    endif
endfunction

function Trig_Hyrja_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    set udg_Temp_Unit_Point = GetUnitLoc(GetDyingUnit())
    call CreateItemLoc( 'I0AG', udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 120.00 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Hyrja_the_Golden_Valkyr)
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl" )
    call PlaySoundAtPointBJ( gg_snd_LightningBolt1, 100.00, udg_Temp_Unit_Point, 0 )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 0.65 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Hyrja_the_Golden_Valkyr)
    call PlaySoundAtPointBJ( gg_snd_BansheeReady1, 90.00, udg_Temp_Unit_Point, 20.00 )
    call CreateNUnitsAtLoc( 1, 'u03B', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Temp_Unit_Point, 256.78 )
    call RemoveLocation (udg_Temp_Unit_Point)
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRectOfPlayer(gg_rct_Hyrja_the_Golden_Valkyr, Player(PLAYER_NEUTRAL_AGGRESSIVE)), function Trig_Hyrja_Func017A )
    set udg_Temp_Unit_Point = null
endfunction

//===========================================================================
function InitTrig_Hyrja takes nothing returns nothing
    set gg_trg_Hyrja = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Hyrja, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_Hyrja, Condition( function Trig_Hyrja_Conditions ) )
    call TriggerAddAction( gg_trg_Hyrja, function Trig_Hyrja_Actions )
endfunction

//===========================================================================
// Trigger: Vrykul Battle Maiden
//===========================================================================
function Trig_Vrykul_Battle_Maiden_Conditions takes nothing returns boolean
    return GetUnitTypeId(GetDyingUnit()) == 'E04P'
endfunction

function Trig_Vrykul_Battle_Maiden_Actions takes nothing returns nothing
    local unit dying = GetDyingUnit()
    local integer exec = GetTriggerExecCount(gg_trg_Vrykul_Battle_Maiden) // snapshot BEFORE wait
    local integer k = ModuloInteger(exec, 2)

    local location p

    // Drop item at death location
    set p = GetUnitLoc(dying)
    call CreateItemLoc('I0A5', p)
    call RemoveLocation(p)
    set p = null

    call TriggerSleepAction(120.00)

    // Revive location based on exec count (region 1 / 2)
    if (k == 0) then
        set p = GetRectCenter(gg_rct_Vrykul_Battlemaiden_1)
    else
        set p = GetRectCenter(gg_rct_Vrykul_Battlemaiden_2)
    endif

    call ReviveHeroLoc(dying, p, true)
    call RemoveLocation(p)
    set p = null

    call SetUnitManaPercentBJ(dying, 100.00)

    set dying = null
endfunction

function InitTrig_Vrykul_Battle_Maiden takes nothing returns nothing
    set gg_trg_Vrykul_Battle_Maiden = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Vrykul_Battle_Maiden, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_Vrykul_Battle_Maiden, Condition(function Trig_Vrykul_Battle_Maiden_Conditions))
    call TriggerAddAction(gg_trg_Vrykul_Battle_Maiden, function Trig_Vrykul_Battle_Maiden_Actions)
endfunction

