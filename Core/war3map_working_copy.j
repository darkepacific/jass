function InitTrig_Firelords_Burn_and_Arcanite takes nothing returns nothing
    set gg_trg_Firelords_Burn_and_Arcanite = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Firelords_Burn_and_Arcanite, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Firelords_Burn_and_Arcanite, Condition( function Trig_Firelords_Burn_and_Arcanite_Conditions ) )
    call TriggerAddAction( gg_trg_Firelords_Burn_and_Arcanite, function Trig_Firelords_Burn_and_Arcanite_Actions )
endfunction

