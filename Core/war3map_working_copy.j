function InitTrig_Remorseless_Winter takes nothing returns nothing
    set gg_trg_Remorseless_Winter = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Remorseless_Winter, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Remorseless_Winter, Condition( function Trig_Remorseless_Winter_Conditions ) )
    call TriggerAddAction( gg_trg_Remorseless_Winter, function Trig_Remorseless_Winter_Actions )
endfunction

//===========================================================================
// Trigger: Howling Blast
//
// Calc distance in tics
//===========================================================================
function Trig_Howling_Blast_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A02V' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Howling_Blast_Func011C takes nothing returns boolean
    if ( not ( 'U02Z' == GetUnitTypeId(GetTriggerUnit()) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Howling_Blast_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    // Looptick Based on Distance
    set udg_Length = 100.00
    set udg_Width = 160.00
    call UnitTypeCheck( udg_Temp_Unit, 'U02Z', 18 , 19) 
    set udg_Point_Charge_Begin[udg_Temp_Int] = GetUnitLoc(GetSpellAbilityUnit())
    set udg_Point_Charge_End[udg_Temp_Int] = GetSpellTargetLoc()
    set udg_Charge_Distance = DistanceBetweenPoints(udg_Point_Charge_Begin[udg_Temp_Int], udg_Point_Charge_End[udg_Temp_Int])
    set udg_Charge_Loop[udg_Temp_Int] = 0.00
    set udg_SpellTicks[udg_Temp_Int] = 0
    if ( Trig_Howling_Blast_Func011C() ) then
        set udg_Chain_Terminator_Frost_W = R2I(( udg_Charge_Distance / udg_Length ))
        call EnableTrigger( gg_trg_HB_Tick_A)
    else
        set udg_Chain_Terminator_Frost_BE = R2I(( udg_Charge_Distance / udg_Length ))
        call EnableTrigger( gg_trg_HB_Tick_H)
    endif
endfunction

//===========================================================================
function InitTrig_Howling_Blast takes nothing returns nothing
    set gg_trg_Howling_Blast = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Howling_Blast, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Howling_Blast, Condition( function Trig_Howling_Blast_Conditions ) )
    call TriggerAddAction( gg_trg_Howling_Blast, function Trig_Howling_Blast_Actions )
endfunction

//===========================================================================
// Trigger: HB Tick A
//
// call DummyRootSet()
//===========================================================================
function Trig_HB_Tick_A_Func029A takes nothing returns nothing
    if IsUnitTargetableEnemyGround( GetEnumUnit(), udg_Temp_Unit ) then
    call IssueTargetOrderBJ( gg_unit_e028_1863, "slow", GetEnumUnit() )
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "war3mapImported\\Blizzard II Missile" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_HB_Tick_A_Func030Func017Func011C takes nothing returns boolean
    if ( not ( IsUnitInGroup(GetEnumUnit(), udg_UnitsInRect) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_HB_Tick_A_Func030Func017A takes nothing returns nothing
    if IsUnitTargetableEnemyGround( GetEnumUnit(), udg_Temp_Unit ) then
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 12 ]  then
    call DummyStunNoSet( GetEnumUnit() )
    else
    call IssueTargetOrderBJ( gg_unit_e00H_2048, "ensnare", GetEnumUnit() )
    endif
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "war3mapImported\\Blizzard II Missile" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "Abilities\\Spells\\Undead\\FreezingBreath\\FreezingBreathTargetArt.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    if ( Trig_HB_Tick_A_Func030Func017Func011C() ) then
        call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    else
    endif
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_HB_Tick_A_Func030C takes nothing returns boolean
    if ( not ( udg_SpellTicks[udg_Temp_Int] < udg_Chain_Terminator_Frost_W ) ) then
        return false
    endif
    return true
endfunction

function Trig_HB_Tick_A_Actions takes nothing returns nothing
    set udg_Temp_Unit = udg_yA_Frost_DK
    call TriggerExecute( gg_trg_Firelords_Helper)
    set udg_Temp_Int = 18
    // Damage Calculation
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 3.00 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A02V', udg_Temp_Unit) * 55 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 10 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 3 ]  then
    set udg_RealStatCalc = ( udg_RealStatCalc * 1.08 )
    endif
    // point calc
    set udg_Facing_Angle = AngleBetweenPoints(udg_Point_Charge_Begin[udg_Temp_Int], udg_Point_Charge_End[udg_Temp_Int])
    set udg_Length = 100.00
    set udg_Width = 188.00
    set udg_Temp_Unit_Point = PolarProjectionBJ(udg_Point_Charge_Begin[udg_Temp_Int], ( udg_Length * udg_Charge_Loop[udg_Temp_Int] ), udg_Facing_Angle)
    call TriggerExecute( gg_trg_PICK_EVERY_UNIT_IN_RECT )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Weapons\\LichMissile\\LichMissile.mdl" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 2.00 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Blizzard II Missile.mdx" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 2.00 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call RemoveLocation (udg_Temp_Unit_Point)
    // AoE
    call SetUnitOwner( gg_unit_e028_1863, GetOwningPlayer(udg_Heroes[udg_Player_Number]), true )
    call SetUnitAbilityLevelSwapped( 'A03P', gg_unit_e028_1863, 1 )
    call ForGroupBJ( udg_UnitsInRect, function Trig_HB_Tick_A_Func029A )
    if ( Trig_HB_Tick_A_Func030C() ) then
        set udg_SpellTicks[udg_Temp_Int] = ( udg_SpellTicks[udg_Temp_Int] + 1 )
        set udg_Charge_Loop[udg_Temp_Int] = ( udg_Charge_Loop[udg_Temp_Int] + 1 )
    else
        call DisableTrigger( GetTriggeringTrigger() )
        // Make Ice
        call AddSpecialEffectLocBJ( udg_Point_Charge_End[udg_Temp_Int], "war3mapImported\\ArcaneExplosion.mdx" )
        call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 1.00 )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        set bj_forLoopAIndex = 0
        set bj_forLoopAIndexEnd = 11
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Point_Charge_End[udg_Temp_Int], 156.00, ( 30.00 * ( 1 + I2R(GetForLoopIndexA()) ) ))
            call AddSpecialEffectLocBJ( udg_Temp_Polar_Point, "Ice Shard.mdx" )
            call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.81 )
            call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 1.20 )
            call RemoveLocation (udg_Temp_Polar_Point)
            set udg_IceRing[GetForLoopIndexA()] = GetLastCreatedEffectBJ()
            set bj_forLoopAIndex = bj_forLoopAIndex + 1
        endloop
        // DummySet
        if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 12 ]  then
        call DummyStunSet(  udg_Temp_Unit, 1.2, udg_Point_Charge_Begin[udg_Temp_Int] )
        else
        call DummyRootSet(  GetOwningPlayer(udg_Temp_Unit), udg_Point_Charge_Begin[udg_Temp_Int], udg_Facing_Angle, 1)
        endif
        // Circle
        set bj_wantDestroyGroup = true
        call ForGroupBJ( GetUnitsInRangeOfLocAll(192.00, udg_Point_Charge_End[udg_Temp_Int]), function Trig_HB_Tick_A_Func030Func017A )
        call RemoveLocation (udg_Point_Charge_Begin[udg_Temp_Int])
        call RemoveLocation (udg_Point_Charge_End[udg_Temp_Int])
        call TriggerSleepAction( 1.70 )
        // Break Ice
        set bj_forLoopAIndex = 0
        set bj_forLoopAIndexEnd = 11
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call DestroyEffectBJ( udg_IceRing[GetForLoopIndexA()] )
            set bj_forLoopAIndex = bj_forLoopAIndex + 1
        endloop
    endif
endfunction

//===========================================================================
function InitTrig_HB_Tick_A takes nothing returns nothing
    set gg_trg_HB_Tick_A = CreateTrigger(  )
    call DisableTrigger( gg_trg_HB_Tick_A )
    call TriggerRegisterTimerEventPeriodic( gg_trg_HB_Tick_A, 0.15 )
    call TriggerAddAction( gg_trg_HB_Tick_A, function Trig_HB_Tick_A_Actions )
endfunction

