    set udg_QuestMarks[23] = GetLastCreatedEffectBJ()
    set udg_TempString = "Legend has it that a nightelf preistess once traveled these lands, weeping at the loss of her husband.. A sad story it be... But! Legend also has it her tears were precious gems! Help me out and bring me back a few."
