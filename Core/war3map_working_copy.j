function Trig_Thaurissan_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'O00Q' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Thaurissan_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    set udg_Temp_Unit_Point = GetUnitLoc(GetDyingUnit())
    call CreateItemLoc( 'I03W', udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 120.00 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Thaurissan)
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Weapons\\FireBallMissile\\FireBallMissile.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call ReviveHeroLoc( GetTriggerUnit(), udg_Temp_Unit_Point, true )
    call RemoveLocation (udg_Temp_Unit_Point)
    call SetUnitManaPercentBJ( GetTriggerUnit(), 100.00 )
    set udg_Temp_Unit_Point = null
endfunction

//===========================================================================
function InitTrig_Thaurissan takes nothing returns nothing
    set gg_trg_Thaurissan = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Thaurissan, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_Thaurissan, Condition( function Trig_Thaurissan_Conditions ) )
    call TriggerAddAction( gg_trg_Thaurissan, function Trig_Thaurissan_Actions )
endfunction

//===========================================================================
// Trigger: Thermaplugg
//===========================================================================
function Trig_Thermaplugg_Func002C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'U03D' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'U03C' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Thermaplugg_Conditions takes nothing returns boolean
    if ( not Trig_Thermaplugg_Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_Thermaplugg_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    set udg_Temp_Unit_Point = GetUnitLoc(GetDyingUnit())
    call CreateItemLoc( 'oli2', udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 60.00 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Thermaplugg)
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl" )
    call PlaySoundAtPointBJ( gg_snd_LightningBolt1, 100.00, udg_Temp_Unit_Point, 0 )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 0.65 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Thermaplugg)
    call ReviveHeroLoc( GetTriggerUnit(), udg_Temp_Unit_Point, true )
    call RemoveLocation (udg_Temp_Unit_Point)
    call SetUnitManaPercentBJ( GetTriggerUnit(), 100.00 )
    call ModifyGateBJ( bj_GATEOPERATION_CLOSE, gg_dest_B027_31907 )
    call DestructableRestoreLife( gg_dest_DTlv_32126, 5.00, true )
    call DestructableRestoreLife( gg_dest_DTlv_32127, 5.00, true )
    call DestructableRestoreLife( gg_dest_DTlv_32128, 5.00, true )
    call DestructableRestoreLife( gg_dest_DTlv_32211, 5.00, true )
    call EnableTrigger(gg_trg_Gnome_Gate_Lever)
    set udg_Temp_Unit_Point = null
endfunction

