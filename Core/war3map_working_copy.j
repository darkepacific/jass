//===========================================================================
// Trigger: Killrog
//===========================================================================
function Trig_Killrog_Func002Func005C takes nothing returns boolean
    if ( ( GetOwningPlayer(GetKillingUnitBJ()) == Player(1) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetKillingUnitBJ()) == Player(11) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetKillingUnitBJ()) == Player(2) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetKillingUnitBJ()) == Player(7) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetKillingUnitBJ()) == Player(8) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetKillingUnitBJ()) == Player(9) ) ) then
        return true
    endif
    return false
endfunction

function Trig_Killrog_Func002C takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_Quests[46]) == false ) ) then
        return false
    endif
    if ( not Trig_Killrog_Func002Func005C() ) then
        return false
    endif
    return true
endfunction

function Trig_Killrog_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    if ( Trig_Killrog_Func002C() ) then
        set udg_Temp_Unit_Point = GetUnitLoc(GetDyingUnit())
        call CreateItemLoc( 'I05O', udg_Temp_Unit_Point )
        call RemoveLocation (udg_Temp_Unit_Point)
    else
    endif
    call TriggerSleepAction( 150.00 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Killrog_Deadeye)
    call ReviveHeroLoc( gg_unit_O005_1045, udg_Temp_Unit_Point, true )
    call RemoveLocation (udg_Temp_Unit_Point)
    call SetUnitManaPercentBJ( GetTriggerUnit(), 75.00 )
    set udg_Temp_Unit_Point = null
endfunction

