function Trig_U_HHK_Acquire_Actions takes nothing returns nothing
                       if IsAllianceHero( GetTriggerUnit() ) then
    call QuestMessageBJ( udg_AlliancePlayers, bj_QUESTMESSAGE_UPDATED, "TRIGSTR_11169" )
    set udg_TempString = ""
    if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
    set udg_TempString = udg_QuestionMark
    call FlashQuestDialogButtonBJ(  )
    endif
    call QuestItemSetCompletedBJ( udg_QuestReqs[31], true )
    call CreateQuestItemBJ( udg_Quests[31], "TRIGSTR_3610" )
    set udg_QuestReqs[31] = GetLastCreatedQuestItemBJ()
    call AddSpecialEffectTargetUnitBJ( "overhead", gg_unit_Ewar_0890, udg_TempString )
    set udg_QuestMarks[31] = GetLastCreatedEffectBJ()
