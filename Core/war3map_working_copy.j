endfunction

function Trig_Wild_Imps_Actions takes nothing returns nothing
    call PlaySoundOnUnitBJ( gg_snd_Imp, 85.00, GetSpellAbilityUnit() )
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_HeroStatCalc = ( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) )
    set udg_Temp_Bool = udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 14 ] 
    if ( Trig_Wild_Imps_Func005C() ) then
        set udg_HeroStatCalc = ( udg_HeroStatCalc / 40 )
        if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 14 ]  then
        set udg_HeroStatCalc = ( udg_HeroStatCalc + 1 )
        endif
        set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
        set udg_Temp_Int = GetUnitAbilityLevelSwapped('A005', GetTriggerUnit())
        set udg_RealStatCalc = 6.40
        if ( Trig_Wild_Imps_Func005Func009C() ) then
            set bj_forLoopAIndex = 1
            set bj_forLoopAIndexEnd = udg_HeroStatCalc
            loop
                exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
                call CreateNUnitsAtLoc( 1, 'n01J', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
                call UnitApplyTimedLifeBJ( udg_RealStatCalc, 'BTLF', GetLastCreatedUnit() )
                set bj_forLoopAIndex = bj_forLoopAIndex + 1
            endloop
        else
            if ( Trig_Wild_Imps_Func005Func009Func001C() ) then
                set bj_forLoopAIndex = 1
                set bj_forLoopAIndexEnd = udg_HeroStatCalc
                loop
                    exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
                    call CreateNUnitsAtLoc( 1, 'n01T', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
                    call UnitApplyTimedLifeBJ( udg_RealStatCalc, 'BTLF', GetLastCreatedUnit() )
                    set bj_forLoopAIndex = bj_forLoopAIndex + 1
                endloop
            else
                if ( Trig_Wild_Imps_Func005Func009Func001Func001C() ) then
                    set bj_forLoopAIndex = 1
                    set bj_forLoopAIndexEnd = udg_HeroStatCalc
                    loop
                        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
                        call CreateNUnitsAtLoc( 1, 'n01S', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
                        call UnitApplyTimedLifeBJ( udg_RealStatCalc, 'BTLF', GetLastCreatedUnit() )
                        set bj_forLoopAIndex = bj_forLoopAIndex + 1
                    endloop
                else
                    if ( Trig_Wild_Imps_Func005Func009Func001Func001Func001C() ) then
                        set bj_forLoopAIndex = 1
                        set bj_forLoopAIndexEnd = udg_HeroStatCalc
                        loop
                            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
                            call CreateNUnitsAtLoc( 1, 'n01R', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
                            call UnitApplyTimedLifeBJ( udg_RealStatCalc, 'BTLF', GetLastCreatedUnit() )
                            set bj_forLoopAIndex = bj_forLoopAIndex + 1
                        endloop
                    else
                        if ( Trig_Wild_Imps_Func005Func009Func001Func001Func001Func001C() ) then
                            set bj_forLoopAIndex = 1
                            set bj_forLoopAIndexEnd = udg_HeroStatCalc
                            loop
                                exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
                                call CreateNUnitsAtLoc( 1, 'n01Q', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
                                call UnitApplyTimedLifeBJ( udg_RealStatCalc, 'BTLF', GetLastCreatedUnit() )
                                set bj_forLoopAIndex = bj_forLoopAIndex + 1
                            endloop
                        else
                            if ( Trig_Wild_Imps_Func005Func009Func001Func001Func001Func001Func001C() ) then
                                set bj_forLoopAIndex = 1
                                set bj_forLoopAIndexEnd = udg_HeroStatCalc
                                loop
                                    exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
                                    call CreateNUnitsAtLoc( 1, 'n01P', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
                                    call UnitApplyTimedLifeBJ( udg_RealStatCalc, 'BTLF', GetLastCreatedUnit() )
                                    set bj_forLoopAIndex = bj_forLoopAIndex + 1
                                endloop
                            else
                                if ( Trig_Wild_Imps_Func005Func009Func001Func001Func001Func001Func001Func001C() ) then
                                    set bj_forLoopAIndex = 1
                                    set bj_forLoopAIndexEnd = udg_HeroStatCalc
                                    loop
                                        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
                                        call CreateNUnitsAtLoc( 1, 'n01O', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
                                        call UnitApplyTimedLifeBJ( udg_RealStatCalc, 'BTLF', GetLastCreatedUnit() )
                                        set bj_forLoopAIndex = bj_forLoopAIndex + 1
                                    endloop
                                else
                                    if ( Trig_Wild_Imps_Func005Func009Func001Func001Func001Func001Func001Func001Func001C() ) then
                                        set bj_forLoopAIndex = 1
                                        set bj_forLoopAIndexEnd = udg_HeroStatCalc
                                        loop
                                            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
                                            call CreateNUnitsAtLoc( 1, 'n01N', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
                                            call UnitApplyTimedLifeBJ( udg_RealStatCalc, 'BTLF', GetLastCreatedUnit() )
                                            set bj_forLoopAIndex = bj_forLoopAIndex + 1
                                        endloop
                                    else
                                    endif
                                endif
                            endif
                        endif
                    endif
                endif
            endif
        endif
        call RemoveLocation (udg_Temp_Unit_Point)
    else
    endif
endfunction

