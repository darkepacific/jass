//===========================================================================
// Trigger: AnimateDead
//===========================================================================
function Trig_AnimateDead_Func002C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'AUan' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A03X' ) ) then
        return true
    endif
    return false
endfunction

function Trig_AnimateDead_Conditions takes nothing returns boolean
    if ( not Trig_AnimateDead_Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_AnimateDead_Func001C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'AUan' ) ) then
        return false
    endif
    if ( not ( BlzGetUnitAbilityCooldownRemaining(GetTriggerUnit(), 'AUan') > 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_AnimateDead_Func003C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A03X' ) ) then
        return false
    endif
    if ( not ( BlzGetUnitAbilityCooldownRemaining(GetTriggerUnit(), 'A03X') > 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_AnimateDead_Actions takes nothing returns nothing
    if ( Trig_AnimateDead_Func001C() ) then
        call BlzUnitDisableAbility( GetTriggerUnit(), 'AUan', false, true )
        call UnitAddAbilityBJ( 'A03M', GetTriggerUnit() )
        call SetUnitAbilityLevelSwapped( 'A03M', GetTriggerUnit(), GetUnitAbilityLevelSwapped('AUan', GetTriggerUnit()) )
        if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 11 ]  then
        call BlzSetUnitAbilityCooldown(udg_Temp_Unit, 'A03M' , GetUnitAbilityLevel(udg_Temp_Unit, 'A03M' ) - 1, BlzGetUnitAbilityCooldown(udg_Temp_Unit,'A03M', GetUnitAbilityLevel(udg_Temp_Unit, 'A03M' ) - 1) - 2.5)
        endif
        call TriggerSleepAction( 20.00 )
        call UnitRemoveAbilityBJ( 'A03M', GetTriggerUnit() )
        call BlzUnitDisableAbility( GetTriggerUnit(), 'AUan', false, false )
    else
    endif
    if ( Trig_AnimateDead_Func003C() ) then
        call BlzUnitDisableAbility( GetTriggerUnit(), 'A03X', false, true )
        call UnitAddAbilityBJ( 'A03M', GetTriggerUnit() )
        call SetUnitAbilityLevelSwapped( 'A03M', GetTriggerUnit(), GetUnitAbilityLevelSwapped('A03X', GetTriggerUnit()) )
        call TriggerSleepAction( 20.00 )
        call UnitRemoveAbilityBJ( 'A03M', GetTriggerUnit() )
        call BlzUnitDisableAbility( GetTriggerUnit(), 'A03X', false, false )
    else
    endif
endfunction

