    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_121", udg_TempString, "ReplaceableTextures\\CommandButtons\\BTNINV_Misc_Head_Undead_01.blp" )
    set udg_Quests[72] = GetLastCreatedQuestBJ()
    call QuestSetEnabledBJ( false, udg_Quests[72] )
    call EnableTrigger( gg_trg_S_TOBB_A )
endfunction

