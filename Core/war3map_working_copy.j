//===========================================================================
function Trig_Duel_Leave_Func002C takes nothing returns boolean
    if ( not ( RectContainsUnit(gg_rct_Alliance_Heroes_During_Flight, GetTriggerUnit()) == false ) ) then
        return false
    endif
    if ( not ( RectContainsUnit(gg_rct_Horde_Heroes_During_Flight, GetTriggerUnit()) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Duel_Leave_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    if ( not Trig_Duel_Leave_Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_Duel_Leave_Actions takes nothing returns nothing
    call DuelEnds()
endfunction

