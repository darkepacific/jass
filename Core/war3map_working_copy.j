function Trig_Spawn_Banshees_55k_Actions takes nothing returns nothing
    local real udg_Temp_Angle = 45
    local integer udg_Temp_Int = 0
    local location udg_Temp_Unit_Point
    local location udg_Temp_Polar_Point
    local group udg_Temp_Group = CreateGroup()
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Naxx_Minion_Spawn)
    set udg_Temp_Int = 1
    loop
        exitwhen udg_Temp_Int > 4
        set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 880.00, udg_Temp_Angle)
        call CreateNUnitsAtLoc( 1, 'u044', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Temp_Polar_Point, udg_Temp_Angle )
        call UnitApplyTimedLife(GetLastCreatedUnit(), 'BTLF', 120.0)
        call RemoveLocation (udg_Temp_Polar_Point)
        call GroupAddUnit( udg_Temp_Group, GetLastCreatedUnit())
        call IssueTargetOrder( GetEnumUnit(), "antimagicshell", gg_unit_Uktl_0568)
        set udg_Temp_Angle = udg_Temp_Angle + 90
        set udg_Temp_Int = udg_Temp_Int + 1
    endloop
    call DisableTrigger( GetTriggeringTrigger() )
    call GameTimeWait(1.65)
    call ForGroupBJ( udg_Temp_Group, function Trig_Spawn_Banshees_55k_Func012A )
    call DestroyGroup(udg_Temp_Group)
    call TriggerSleepAction( 18.00 )
    call EnableTrigger( GetTriggeringTrigger() )
    set udg_Temp_Group = null
    set udg_Temp_Unit_Point = null
    set udg_Temp_Polar_Point = null
endfunction

