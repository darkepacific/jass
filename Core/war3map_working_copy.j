function Trig_Ogres_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    local integer udg_i = 0
    // ITEM TABLE
    // Set 1
    set udg_ItemDropTable[udg_i] = 'I01S'
    set udg_ItemDropPerc[udg_i] = 35.00
    set udg_i = ( udg_i + 1 )
    set udg_ItemDropTable[udg_i] = 'I00G'
    set udg_ItemDropPerc[udg_i] = 30.00
