//===========================================================================
// Trigger: Magnatuar
//===========================================================================
function Trig_Magnatuar_Conditions takes nothing returns boolean
    return GetUnitTypeId(GetTriggerUnit()) == 'nmgr'
endfunction

function Trig_Magnatuar_Actions takes nothing returns nothing
    local unit    dying = GetDyingUnit()  // snapshot before wait
    local integer exec  = GetTriggerExecCount(gg_trg_Magnatuar)
    local integer k     = ModuloInteger(exec, 5)

    local location p
    local integer i = 0

    // item table
    set udg_ItemDropTable[i] = 'I046'
    set udg_ItemDropPerc[i]  = 20.00
    set i = i + 1
    set udg_ItemDropTable[i] = 'I041'
    set udg_ItemDropPerc[i]  = 20.00
    set i = i + 1
    set udg_ItemDropTable[i] = 'I044'
    set udg_ItemDropPerc[i]  = 20.00
    set i = i + 1
    set udg_ItemDropTable[i] = 'I047'
    set udg_ItemDropPerc[i]  = 20.00
    set i = i + 1
    set udg_ItemDropTable[i] = 'I03Z'
    set udg_ItemDropPerc[i]  = 20.00
    set i = i + 1

    // drop at death spot
    set p = GetUnitLoc(dying)
    call CreateItemsFromDropTable(p)
    call RemoveLocation(p)
    set p = null

    call TriggerSleepAction(110.00)

    // spawn cycle based on snapshotted exec count
    if (k == 0) then
        set p = GetRectCenter(gg_rct_Magnataur_1)
        call CreateNUnitsAtLoc(1, 'nmgr', Player(PLAYER_NEUTRAL_AGGRESSIVE), p, 171.50)
    elseif (k == 1) then
        set p = GetRectCenter(gg_rct_Magnataur_2)
        call CreateNUnitsAtLoc(1, 'nmgr', Player(PLAYER_NEUTRAL_AGGRESSIVE), p, 339.76)
    elseif (k == 2) then
        set p = GetRectCenter(gg_rct_Magnataur_3)
        call CreateNUnitsAtLoc(1, 'nmgr', Player(PLAYER_NEUTRAL_AGGRESSIVE), p, 33.53)
    elseif (k == 3) then
        set p = GetRectCenter(gg_rct_Magnataur_4)
        call CreateNUnitsAtLoc(1, 'nmgr', Player(PLAYER_NEUTRAL_AGGRESSIVE), p, 259.53)
    else
        set p = GetRectCenter(gg_rct_Magnataur_5)
        call CreateNUnitsAtLoc(1, 'nmgr', Player(PLAYER_NEUTRAL_AGGRESSIVE), p, 348.92)
    endif

    call RemoveLocation(p)
    set p = null

    call SetUnitAcquireRangeBJ(GetLastCreatedUnit(), 200.00)

    set dying = null
endfunction

function InitTrig_Magnatuar takes nothing returns nothing
    set gg_trg_Magnatuar = CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_Magnatuar, Player(PLAYER_NEUTRAL_AGGRESSIVE), EVENT_PLAYER_UNIT_DEATH)
