    call TriggerRegisterPlayerChatEvent( gg_trg_QUICKTEST, Player(9), "-qt", false )
    call TriggerRegisterPlayerChatEvent( gg_trg_QUICKTEST, Player(10), "-qt", false )
    call TriggerAddAction( gg_trg_QUICKTEST, function Trig_QUICKTEST_Actions )
endfunction

