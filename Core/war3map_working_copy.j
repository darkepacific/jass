            set udg_Hearthstones[udg_Player_Number] = 21
            set udg_TempString = "Agmar's Hammer"
        else
        endif
    else
    endif
    // ALLIANCE
    if ( Trig_Set_Hearths_Func006C() ) then
        // Cities
        if ( Trig_Set_Hearths_Func006Func002C() ) then
            set udg_Hearthstones[udg_Player_Number] = 100
            set udg_TempString = "Stromgarde"
        else
        endif
        if ( Trig_Set_Hearths_Func006Func003C() ) then
            set udg_Hearthstones[udg_Player_Number] = 200
