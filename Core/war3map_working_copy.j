//===========================================================================
// Trigger: Moonfire Feral Begin
//
// was wait .65 in between set moonfire target and and temp unit point
//===========================================================================
function Trig_Moonfire_Feral_Begin_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A02Z' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Moonfire_Feral_Begin_Func003C takes nothing returns boolean
    if ( not ( udg_isDruid_NightElf == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Moonfire_Feral_Begin_Func005C takes nothing returns boolean
    if ( not ( udg_isDruid_Tauren == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Moonfire_Feral_Begin_Actions takes nothing returns nothing
    local unit udg_Temp_Unit = GetTriggerUnit()
    if udg_Temp_Unit == udg_yA_Feral_Druid then
    if ( Trig_Moonfire_Feral_Begin_Func003C() ) then
        call UnitDamageTargetBJ( GetTriggerUnit(), GetSpellTargetUnit(), ( 2.00 * I2R(GetHeroStatBJ(bj_HEROSTAT_INT, GetSpellAbilityUnit(), true)) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        call AddSpecialEffectTargetUnitBJ( "overhead", GetSpellTargetUnit(), "Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call CreateTextTagUnitBJ( I2S(( GetHeroStatBJ(bj_HEROSTAT_INT, GetSpellAbilityUnit(), true) * 2 )), GetSpellTargetUnit(), 0, 10, 60.00, 30.00, 100, 0 )
        call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
        call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 0.75 )
        call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 0.60 )
        call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64.00, 90 )
    else
        set udg_MoonfireTarget[0] = GetSpellTargetUnit()
        call TriggerSleepAction( 0.10 )
        set udg_Temp_Unit_Point = GetUnitLoc(udg_MoonfireTarget[0])
        if not IsTerrainPathable( GetLocationX(udg_Temp_Unit_Point), GetLocationY(udg_Temp_Unit_Point), PATHING_TYPE_WALKABILITY) then
        call SetUnitPositionLocFacingLocBJ( GetTriggerUnit(), udg_Temp_Unit_Point, udg_Temp_Unit_Point )
        endif
        call PlaySoundOnUnitBJ( gg_snd_BlinkArrival1, 88.00, GetTriggerUnit() )
        call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "Abilities\\Spells\\NightElf\\Blink\\BlinkTarget.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call RemoveLocation (udg_Temp_Unit_Point)
    endif
    elseif udg_Temp_Unit == udg_yH_Feral_Druid then
    if ( Trig_Moonfire_Feral_Begin_Func005C() ) then
        call UnitDamageTargetBJ( GetTriggerUnit(), GetSpellTargetUnit(), ( 2.00 * I2R(GetHeroStatBJ(bj_HEROSTAT_INT, GetSpellAbilityUnit(), true)) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        call AddSpecialEffectTargetUnitBJ( "overhead", GetSpellTargetUnit(), "Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call CreateTextTagUnitBJ( I2S(( GetHeroStatBJ(bj_HEROSTAT_INT, GetSpellAbilityUnit(), true) * 2 )), GetSpellTargetUnit(), 0, 10, 60.00, 30.00, 100, 0 )
        call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
        call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 0.75 )
        call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 0.60 )
        call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64.00, 90 )
    else
        set udg_MoonfireTarget[1] = GetSpellTargetUnit()
        call TriggerSleepAction( 0.10 )
        set udg_Temp_Unit_Point = GetUnitLoc(udg_MoonfireTarget[1])
        if not IsTerrainPathable( GetLocationX(udg_Temp_Unit_Point), GetLocationY(udg_Temp_Unit_Point), PATHING_TYPE_WALKABILITY) then
        call SetUnitPositionLocFacingLocBJ( GetTriggerUnit(), PolarProjectionBJ(udg_Temp_Unit_Point, 100.00, AngleBetweenPoints(udg_Temp_Unit_Point, GetUnitLoc(GetTriggerUnit()))), udg_Temp_Unit_Point )
        endif
        call PlaySoundOnUnitBJ( gg_snd_BlinkArrival1, 88.00, GetTriggerUnit() )
        call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "Abilities\\Spells\\NightElf\\Blink\\BlinkTarget.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call RemoveLocation (udg_Temp_Unit_Point)
    endif
    endif
    set udg_Temp_Unit = null
endfunction

//===========================================================================
function InitTrig_Moonfire_Feral_Begin takes nothing returns nothing
    set gg_trg_Moonfire_Feral_Begin = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Moonfire_Feral_Begin, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Moonfire_Feral_Begin, Condition( function Trig_Moonfire_Feral_Begin_Conditions ) )
    call TriggerAddAction( gg_trg_Moonfire_Feral_Begin, function Trig_Moonfire_Feral_Begin_Actions )
endfunction

//===========================================================================
// Trigger: Shred
//===========================================================================
function Trig_Shred_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0GT' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Shred_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A0GT', udg_Temp_Unit) * 19 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 6 )
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 0.75 * udg_RealStatCalc )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A0GT'), ABILITY_RLF_PRIMARY_DAMAGE, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), udg_RealStatCalc )
    call AddSpecialEffectTargetUnitBJ( "overhead", GetSpellTargetUnit(), "war3mapImported\\Armor Penetration Orange.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    return
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A044'), ABILITY_RLF_DAMAGE_PER_SECOND_POI1, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), udg_RealStatCalc )
endfunction

