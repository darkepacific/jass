        else
        endif
        if ( Trig_Set_Hearths_Func006Func018C() ) then
            set udg_Hearthstones[udg_Player_Number] = 16
            set udg_TempString = "Thundermar"
        else
        endif
        if ( Trig_Set_Hearths_Func006Func019C() ) then
