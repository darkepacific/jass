        set udg_Facing_Angle = AngleBetweenPoints(udg_Point_Charge_End[udg_Temp_Int], udg_Point_Charge_Begin[udg_Temp_Int])
        set udg_Temp_Unit_Point = PolarProjectionBJ(udg_Point_Charge_End[udg_Temp_Int], ( udg_Length * ( udg_Charge_Loop[udg_Temp_Int] - 9.00 ) ), udg_Facing_Angle)
    endif
    call TriggerExecute( gg_trg_PICK_EVERY_UNIT_IN_RECT )
    call DestroyEffectBJ( udg_CrimsonTempest[3] )
    call DestroyEffectBJ( udg_CrimsonTempest[4] )
    call DestroyEffectBJ( udg_CrimsonTempest[5] )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Weapons\\SentinelMissile\\SentinelMissile.mdl" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 1.00 )
    set udg_CrimsonTempest[3] = GetLastCreatedEffectBJ()
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, ( udg_Width / 2.80 ), ( udg_Facing_Angle + 90.00 ))
    call AddSpecialEffectLocBJ( udg_Temp_Polar_Point, "Abilities\\Weapons\\SentinelMissile\\SentinelMissile.mdl" )
    set udg_CrimsonTempest[4] = GetLastCreatedEffectBJ()
    call RemoveLocation (udg_Temp_Polar_Point)
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, ( udg_Width / 2.80 ), ( udg_Facing_Angle - 90.00 ))
    call AddSpecialEffectLocBJ( udg_Temp_Polar_Point, "Abilities\\Weapons\\SentinelMissile\\SentinelMissile.mdl" )
    set udg_CrimsonTempest[5] = GetLastCreatedEffectBJ()
    call RemoveLocation (udg_Temp_Polar_Point)
