function Trig_ABag_Check_Actions takes nothing returns nothing
    call DisableTrigger( gg_trg_Lose_Item )
    set udg_Player_Number = GetPlayerHeroNumber( GetOwningPlayer(GetTriggerUnit()) )
    call SetBagNumber( GetOwningPlayer(GetTriggerUnit()) )
    set udg_Bag_Iterator = 1
    loop
        exitwhen udg_Bag_Iterator > udg_BAG_LOOP_MAX
        if ( Trig_ABag_Check_Func004Func001C() ) then
            set bj_forLoopBIndex = 1
            set bj_forLoopBIndexEnd = 20
            loop
                exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
                // FT Gen
                set udg_TempString = GetItemName(udg_P_Items[( udg_Bag_Num + udg_Bag_Iterator )])
                call TriggerExecute( gg_trg_ItemTurnIn )
                // End FT Gen
                if ( Trig_ABag_Check_Func004Func001Func001Func005C() ) then
                    call SetItemCharges( udg_P_Items[( udg_Bag_Num + udg_Bag_Iterator )], ( GetItemCharges(udg_P_Items[( udg_Bag_Num + udg_Bag_Iterator )]) - 1 ) )
                    if ( Trig_ABag_Check_Func004Func001Func001Func005Func015C() ) then
                        call RemoveItem( udg_P_Items[( udg_Bag_Num + udg_Bag_Iterator )] )
                        set udg_P_Items[( udg_Bag_Num + udg_Bag_Iterator )] = null
                    else
                    endif
                    // Horde
                    // Scarlet Sacraments H
                    if ( Trig_ABag_Check_Func004Func001Func001Func005Func018C() ) then
                        set udg_QuestSAC_H = udg_QuestSAC_H + 1
                        if ( Trig_ABag_Check_Func004Func001Func001Func005Func018Func003C() ) then
                            // Clean Up Items
                            call CleanUpItems_Horde( udg_ItemTypeCheck )
                            return
                        else
                        endif
                    else
                    endif
                    // Drunken Banshees H
                    if ( Trig_ABag_Check_Func004Func001Func001Func005Func020C() ) then
                        if ( Trig_ABag_Check_Func004Func001Func001Func005Func020Func002C() ) then
                            set udg_QuestBansheeAles_H = ( udg_QuestBansheeAles_H + 1.00 )
                        else
                            set udg_QuestBansheeAles_H = ( udg_QuestBansheeAles_H + 1.00 )
                            return
                        endif
                    else
                    endif
                    // FBP
                    if ( Trig_ABag_Check_Func004Func001Func001Func005Func022C() ) then
                        if ( Trig_ABag_Check_Func004Func001Func001Func005Func022Func002C() ) then
                            set udg_QuestFBP[0] = ( udg_QuestFBP[0] + 1 )
                            set udg_QFB0 = ( udg_QuestFBP[0] + 0.00 )
                        else
                            set udg_QuestFBP[0] = ( udg_QuestFBP[0] + 1 )
                            set udg_QFB0 = ( udg_QuestFBP[0] + 0.00 )
                            return
                        endif
                    else
                    endif
                    if ( Trig_ABag_Check_Func004Func001Func001Func005Func023C() ) then
                        if ( Trig_ABag_Check_Func004Func001Func001Func005Func023Func001C() ) then
                            set udg_QuestFBP[1] = ( udg_QuestFBP[1] + 1 )
                            set udg_QFB1 = ( udg_QuestFBP[1] + 0.00 )
                            return
                        else
                        endif
                    else
                    endif
                    if ( Trig_ABag_Check_Func004Func001Func001Func005Func024C() ) then
                        if ( Trig_ABag_Check_Func004Func001Func001Func005Func024Func001C() ) then
                            set udg_QuestFBP[2] = ( udg_QuestFBP[2] + 1 )
                            set udg_QFB2 = ( udg_QuestFBP[2] + 0.00 )
                            return
                        else
                        endif
                    else
                    endif
                    // CVE
                    if ( Trig_ABag_Check_Func004Func001Func001Func005Func026C() ) then
                        if ( Trig_ABag_Check_Func004Func001Func001Func005Func026Func001C() ) then
                            set udg_QuestVoidEss = ( udg_QuestVoidEss + 1 )
                        else
                            set udg_QuestVoidEss = ( udg_QuestVoidEss + 1 )
                            return
                        endif
                    else
                    endif
                    // Rot Hide Ichor
                    if ( Trig_ABag_Check_Func004Func001Func001Func005Func028C() ) then
                        if ( Trig_ABag_Check_Func004Func001Func001Func005Func028Func001C() ) then
                            set udg_QuestGnollIchors = ( udg_QuestGnollIchors + 1 )
                        else
                            set udg_QuestGnollIchors = ( udg_QuestGnollIchors + 1 )
                            return
                        endif
                    else
                    endif
                    // Doom Weed
                    if ( Trig_ABag_Check_Func004Func001Func001Func005Func030C() ) then
                        if ( Trig_ABag_Check_Func004Func001Func001Func005Func030Func001C() ) then
                            set udg_QuestDoomWeeds = ( udg_QuestDoomWeeds + 1 )
                        else
                            set udg_QuestDoomWeeds = ( udg_QuestDoomWeeds + 1 )
                            return
                        endif
                    else
                    endif
                    // Party Favors
                    if ( Trig_ABag_Check_Func004Func001Func001Func005Func032C() ) then
                        if ( Trig_ABag_Check_Func004Func001Func001Func005Func032Func001C() ) then
                            set udg_QuestPartyFavors = ( udg_QuestPartyFavors + 1 )
                        else
                            set udg_QuestPartyFavors = ( udg_QuestPartyFavors + 1 )
                            return
                        endif
                    else
                    endif
                    // Alliance
                    // Scarlet Sacraments A
                    if ( Trig_ABag_Check_Func004Func001Func001Func005Func035C() ) then
                        set udg_QuestSAC_A = udg_QuestSAC_A + 1
                        if ( Trig_ABag_Check_Func004Func001Func001Func005Func035Func003C() ) then
                            // Clean Up Items
                            call CleanUpItems_Alliance( udg_ItemTypeCheck )
                            return
                        else
                        endif
                    else
                    endif
                    // Drunken Banshees A
                    if ( Trig_ABag_Check_Func004Func001Func001Func005Func037C() ) then
                        if ( Trig_ABag_Check_Func004Func001Func001Func005Func037Func002C() ) then
                            set udg_QuestBansheeAles_A = ( udg_QuestBansheeAles_A + 1.00 )
                        else
                            set udg_QuestBansheeAles_A = ( udg_QuestBansheeAles_A + 1.00 )
                            return
                        endif
                    else
                    endif
                    // Staff of Elune
                    if ( Trig_ABag_Check_Func004Func001Func001Func005Func039C() ) then
                        if ( Trig_ABag_Check_Func004Func001Func001Func005Func039Func002C() ) then
                            set udg_QSoE0 = ( udg_QSoE0 + 1 )
                        else
                            set udg_QSoE0 = ( udg_QSoE0 + 1 )
                            return
                        endif
                    else
                    endif
                    if ( Trig_ABag_Check_Func004Func001Func001Func005Func040C() ) then
                        if ( Trig_ABag_Check_Func004Func001Func001Func005Func040Func001C() ) then
                            set udg_QSoE1 = ( udg_QSoE1 + 1 )
                        else
                            set udg_QSoE1 = ( udg_QSoE1 + 1 )
                            return
                        endif
                    else
                    endif
                    // Precious Tears
                    if ( Trig_ABag_Check_Func004Func001Func001Func005Func042C() ) then
                        if ( Trig_ABag_Check_Func004Func001Func001Func005Func042Func002C() ) then
                            set udg_QuestPT = ( udg_QuestPT + 1 )
                        else
                            set udg_QuestPT = ( udg_QuestPT + 1 )
                            return
                        endif
                    else
                    endif
                    // Wishing Waters
                    if ( Trig_ABag_Check_Func004Func001Func001Func005Func044C() ) then
                        if ( Trig_ABag_Check_Func004Func001Func001Func005Func044Func002C() ) then
                            set udg_QuestWishingWaters = ( udg_QuestWishingWaters + 1 )
                        else
                            set udg_QuestWishingWaters = ( udg_QuestWishingWaters + 1 )
                            return
                        endif
                    else
                    endif
                    // Heckin Hyrdas
                    if ( Trig_ABag_Check_Func004Func001Func001Func005Func046C() ) then
                        if ( Trig_ABag_Check_Func004Func001Func001Func005Func046Func002C() ) then
                            set udg_QuestHH = ( udg_QuestHH + 1 )
                        else
                            set udg_QuestHH = ( udg_QuestHH + 1 )
                            return
                        endif
                    else
                    endif
                    // Beasts of Loch Modan
                    if ( Trig_ABag_Check_Func004Func001Func001Func005Func048C() ) then
                        if ( Trig_ABag_Check_Func004Func001Func001Func005Func048Func002C() ) then
                            set udg_QuestLochBeasts = ( udg_QuestLochBeasts + 1 )
                        else
                            set udg_QuestLochBeasts = ( udg_QuestLochBeasts + 1 )
                            return
                        endif
                    else
                    endif
                else
                    call RemoveItem( udg_P_Items[( udg_Bag_Num + udg_Bag_Iterator )] )
                    set udg_P_Items[( udg_Bag_Num + udg_Bag_Iterator )] = null
                    // BFF A
                    if ( Trig_ABag_Check_Func004Func001Func001Func005Func004C() ) then
                        if ( Trig_ABag_Check_Func004Func001Func001Func005Func004Func001C() ) then
                            set udg_QDeedB_A = udg_QDeedB_A + 1
                            // Clean Up Items
                            call CleanUpItems_Alliance( udg_ItemTypeCheck )
                            return
                        else
                        endif
                    else
                    endif
                    if ( Trig_ABag_Check_Func004Func001Func001Func005Func005C() ) then
                        if ( Trig_ABag_Check_Func004Func001Func001Func005Func005Func001C() ) then
                            set udg_QDeedCD_A = udg_QDeedCD_A + 1
                            // Clean Up Items
                            call CleanUpItems_Alliance( udg_ItemTypeCheck )
                            return
                        else
                        endif
                    else
                    endif
                    if ( Trig_ABag_Check_Func004Func001Func001Func005Func006C() ) then
                        if ( Trig_ABag_Check_Func004Func001Func001Func005Func006Func001C() ) then
                            set udg_QDeedSS_A = udg_QDeedSS_A + 1
                            // Clean Up Items
                            call CleanUpItems_Alliance( udg_ItemTypeCheck )
                            return
                        else
                        endif
                    else
                    endif
                    // BFF H
                    if ( Trig_ABag_Check_Func004Func001Func001Func005Func008C() ) then
                        if ( Trig_ABag_Check_Func004Func001Func001Func005Func008Func001C() ) then
                            set udg_QDeedB_H = udg_QDeedB_H + 1
                            // Clean Up Items
                            call CleanUpItems_Horde( udg_ItemTypeCheck )
                            return
                        else
                        endif
                    else
                    endif
                    if ( Trig_ABag_Check_Func004Func001Func001Func005Func009C() ) then
                        if ( Trig_ABag_Check_Func004Func001Func001Func005Func009Func001C() ) then
                            set udg_QDeedCD_H = udg_QDeedCD_H + 1
                            // Clean Up Items
                            call CleanUpItems_Horde( udg_ItemTypeCheck )
                            return
                        else
                        endif
                    else
                    endif
                    if ( Trig_ABag_Check_Func004Func001Func001Func005Func010C() ) then
                        if ( Trig_ABag_Check_Func004Func001Func001Func005Func010Func001C() ) then
                            set udg_QDeedSS_H = udg_QDeedSS_H + 1
                            // Clean Up Items
                            call CleanUpItems_Horde( udg_ItemTypeCheck )
                            return
                        else
                        endif
                    else
                    endif
                    // Staff of Elune (Javeline)
                    if ( Trig_ABag_Check_Func004Func001Func001Func005Func012C() ) then
                        if ( Trig_ABag_Check_Func004Func001Func001Func005Func012Func001C() ) then
                            set udg_QSoE2 = ( udg_QSoE2 + 1 )
                            return
                        else
                        endif
                    else
                    endif
                endif
                call TasItemBag_RequestUIUpdate()
                set bj_forLoopBIndex = bj_forLoopBIndex + 1
            endloop
        else
        endif
        set udg_Bag_Iterator = udg_Bag_Iterator + 1
    endloop
    call EnableTrigger( gg_trg_Lose_Item )
endfunction

