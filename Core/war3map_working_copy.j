//===========================================================================
// Trigger: Gift Of The Ox
//
// 	call TriggerRegisterUnitInRangeSimple( gg_trg_Healing_Spheres_1, 64.00, udg_SpellUnits[(udg_ZA_MK_BREW) + GetForLoopIndexA()]  )
//===========================================================================
function Trig_Gift_Of_The_Ox_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0E7' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Gift_Of_The_Ox_Func009Func008C takes nothing returns boolean
    if ( not ( udg_SpellUnits[( udg_o + GetForLoopIndexA() )] == null ) ) then
        return false
    endif
    return true
endfunction

function Trig_Gift_Of_The_Ox_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    local location udg_Temp_X_Point
    set udg_Temp_Unit = GetTriggerUnit()
    call StopSoundBJ( gg_snd_HealingSpheresGong, false )
    call PlaySoundOnUnitBJ( gg_snd_HealingSpheresGong, 88.00, GetSpellAbilityUnit() )
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
    set udg_Temp_Real = GetRandomDirectionDeg()
    set udg_Temp_Int  = 0
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 3
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_Temp_X_Point = PolarProjectionBJ(udg_Temp_Unit_Point, GetRandomReal(180.00, 260.00), ( udg_Temp_Real + ( GetRandomReal(90.00, 120.00) * I2R(GetForLoopIndexA()) ) ))
        if not IsTerrainPathable( GetLocationX(udg_Temp_X_Point), GetLocationY(udg_Temp_X_Point), PATHING_TYPE_WALKABILITY) then
        if udg_Temp_Unit == udg_yA_Brew_Monk then
        set udg_o = udg_z_MK_BREW_A
        else
        set udg_o = udg_z_MK_BREW_H
        endif
        if ( Trig_Gift_Of_The_Ox_Func009Func008C() ) then
            call CreateNUnitsAtLoc( 1, 'e04C', GetOwningPlayer(GetTriggerUnit()), udg_Temp_X_Point, GetRandomDirectionDeg() )
            set udg_SpellUnits[( udg_o + GetForLoopIndexA() )] = GetLastCreatedUnit()
            if GetForLoopIndexA() == 1 then
            	call TriggerRegisterUnitInRangeSimple( gg_trg_Healing_Spheres_1, 64.00, udg_SpellUnits[ udg_o + GetForLoopIndexA()]  )
            call TriggerRegisterUnitEvent( gg_trg_Healing_Spheres_Death, udg_Temp_Unit, EVENT_UNIT_DEATH  )
            elseif GetForLoopIndexA() == 2 then
            	call TriggerRegisterUnitInRangeSimple( gg_trg_Healing_Spheres_2, 64.00, udg_SpellUnits[ udg_o + GetForLoopIndexA()]  )
            else
            	call TriggerRegisterUnitInRangeSimple( gg_trg_Healing_Spheres_3, 64.00, udg_SpellUnits[ udg_o + GetForLoopIndexA()]  )
            endif
        else
            call SetUnitPositionLoc( udg_SpellUnits[( udg_o + GetForLoopIndexA() )], udg_Temp_X_Point )
        endif
        else
        // This will attempt up to N  times to find a suitable pathing for the orbs, else it breaks the loop
        if udg_Temp_Int  < 20 then
        set bj_forLoopAIndex = bj_forLoopAIndex - 1
        set udg_Temp_Int  =  udg_Temp_Int + 1
        endif
        endif
        call RemoveLocation (udg_Temp_X_Point)
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = null
    set udg_Temp_X_Point = null
endfunction

//===========================================================================
function InitTrig_Gift_Of_The_Ox takes nothing returns nothing
    set gg_trg_Gift_Of_The_Ox = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Gift_Of_The_Ox, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Gift_Of_The_Ox, Condition( function Trig_Gift_Of_The_Ox_Conditions ) )
    call TriggerAddAction( gg_trg_Gift_Of_The_Ox, function Trig_Gift_Of_The_Ox_Actions )
endfunction

//===========================================================================
// Trigger: Healing Spheres 0
//
// call SetUnitPositionLoc(  udg_SpellUnits[(udg_SpellUnits_CONST * 1) + 1 ], udg_Temp_Unit_Point )
//  udg_SpellUnits[(udg_SpellUnits_CONST * 1) + 1 ]
//===========================================================================
function Trig_Healing_Spheres_0_Func009C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'N041' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'E032' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Healing_Spheres_0_Conditions takes nothing returns boolean
    if ( not Trig_Healing_Spheres_0_Func009C() ) then
        return false
    endif
    return true
endfunction

function Trig_Healing_Spheres_0_Actions takes nothing returns nothing
    local unit udg_Temp_Unit = GetTriggerUnit()
    local location udg_Temp_Unit_Point
    local integer udg_o
    if IsPlayerInForce(GetOwningPlayer(GetTriggerUnit()), udg_AlliancePlayers) then
    set udg_o = udg_z_MK_BREW_A
    else
    set udg_o = udg_z_MK_BREW_H
    endif
    if IsUnitAlly( GetTriggerUnit(), GetOwningPlayer(udg_SpellUnits[udg_o] ) ) then
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_DummyIsland)
    call SetUnitPositionLoc(  udg_SpellUnits[ udg_o + 0 ], udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( udg_RealStatCalc / 1000.00 )
    if ChaliceCheckUnit( udg_Temp_Unit ) then
    set udg_RealStatCalc = ( 0.14 + udg_RealStatCalc )
    else
    set udg_RealStatCalc = ( 0.12 + udg_RealStatCalc )
    endif
    call MaxHealthRestore( udg_RealStatCalc, udg_Temp_Unit )
    call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "war3mapImported\\Heal Green.mdx" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.75 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    endif
    set udg_Temp_Unit = null
    set udg_Temp_Unit_Point = null
endfunction

//===========================================================================
function InitTrig_Healing_Spheres_0 takes nothing returns nothing
    set gg_trg_Healing_Spheres_0 = CreateTrigger(  )
    call TriggerAddCondition( gg_trg_Healing_Spheres_0, Condition( function Trig_Healing_Spheres_0_Conditions ) )
    call TriggerAddAction( gg_trg_Healing_Spheres_0, function Trig_Healing_Spheres_0_Actions )
endfunction

