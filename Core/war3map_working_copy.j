function InitTrig_Hellfire_Tick_OR takes nothing returns nothing
    set gg_trg_Hellfire_Tick_OR = CreateTrigger(  )
    call DisableTrigger( gg_trg_Hellfire_Tick_OR )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Hellfire_Tick_OR, 1.00 )
    call TriggerAddAction( gg_trg_Hellfire_Tick_OR, function Trig_Hellfire_Tick_OR_Actions )
endfunction

