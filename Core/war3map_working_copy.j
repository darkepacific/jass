function InitTrig_Dwarf_Rescued takes nothing returns nothing
    set gg_trg_Dwarf_Rescued = CreateTrigger(  )
    call TriggerRegisterEnterRectSimple( gg_trg_Dwarf_Rescued, gg_rct_Z_Highbank_14 )
    call TriggerAddCondition( gg_trg_Dwarf_Rescued, Condition( function Trig_Dwarf_Rescued_Conditions ) )
    call TriggerAddAction( gg_trg_Dwarf_Rescued, function Trig_Dwarf_Rescued_Actions )
