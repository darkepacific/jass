    if ( not ( GetUnitTypeId(GetSummonedUnit()) == 'ohwd' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Manatide_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetSummoningUnit()
