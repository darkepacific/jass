    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'nfgu' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'Nman' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'n040' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'n061' ) ) then
        return true
    endif
    return false
