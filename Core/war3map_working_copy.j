    set gg_trg_S_ASK_H = CreateTrigger(  )
    call DisableTrigger( gg_trg_S_ASK_H )
    call TriggerRegisterEnterRectSimple( gg_trg_S_ASK_H, gg_rct_Q_Big_Cage_Agent_Skully )
    call TriggerAddAction( gg_trg_S_ASK_H, function Trig_S_ASK_H_Actions )
endfunction

//===========================================================================
// Trigger: E ASK H
//===========================================================================
function Trig_E_ASK_H_Func007Func001C takes nothing returns boolean
    if ( not ( GetItemTypeId(udg_P_Items[( udg_Bag_Num + udg_Bag_Iterator )]) == udg_ItemTypeCheck ) ) then
        return false
    endif
    return true
endfunction

function Trig_E_ASK_H_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 169
    local location udg_Temp_Unit_Point
                       if IsHordeHero( GetTriggerUnit() ) then
    call SetBagNumber( GetOwningPlayer(GetTriggerUnit()) )
    set udg_ItemTypeCheck = 'I0AJ'
    set udg_Bag_Iterator = 1
    loop
        exitwhen udg_Bag_Iterator > udg_BAG_LOOP_MAX
        if ( Trig_E_ASK_H_Func007Func001C() ) then
            call DisableTrigger( GetTriggeringTrigger() )
            if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
            call FlashQuestDialogButtonBJ(  )
            endif
            call QuestSetCompletedBJ( udg_Quests[udg_Temp_Int], true )
            call DestroyEffectBJ( udg_QuestMarks[udg_Temp_Int] )
            call DestroyMinimapIcon( udg_MiniMapIcon[udg_Temp_Int] )
            // Clean Up Items
            call CleanUpItems_Horde( udg_ItemTypeCheck )
            // Rewards
            set udg_XP = udg_QUEST_XP[udg_Temp_Int]
            set udg_Gold = udg_QUEST_GOLD[udg_Temp_Int]
            set udg_LVL_Req = udg_QUEST_LVL_REQ[udg_Temp_Int]
            set udg_TempString = "Agent Skully"
            call TriggerExecute( gg_trg_Quest_Complete_H )
            // Create Skully if not
            if udg_AgentSkully == null then
            set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Q_Big_Cage_Agent_Skully)
            call CreateNUnitsAtLoc( 1, 'E04R', Player(PLAYER_NEUTRAL_PASSIVE), udg_Temp_Unit_Point, 150.00 )
            call RemoveLocation (udg_Temp_Unit_Point)
            set udg_Temp_Unit_Point = null
            set udg_AgentSkully = GetLastCreatedUnit()
            call SetUnitInvulnerable( GetLastCreatedUnit(), true )
            call SetHeroLevelBJ( GetLastCreatedUnit(), 40, false )
            call SetUnitColor( GetLastCreatedUnit(), PLAYER_COLOR_RED )
            call MaxManaRestore( 1.0, udg_AgentSkully)
            endif
            if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) and (IsTriggerEnabled(gg_trg_S_ASK_A) or IsTriggerEnabled(gg_trg_E_ASK_A)) then
            call SetUnitVertexColorBJ( udg_AgentSkully, 100, 100, 100, 100.00 )
            call BlzSetUnitRealField(udg_AgentSkully, UNIT_RF_SELECTION_SCALE, 0.01)
            call BlzSetUnitRealField(udg_AgentSkully, UNIT_RF_SHADOW_IMAGE_HEIGHT, 0.0)
            else
            call SetUnitVertexColorBJ( udg_AgentSkully, 100, 100, 100, 0.00 )
            call BlzSetUnitRealField(udg_AgentSkully, UNIT_RF_SELECTION_SCALE, 1.5)
            call BlzSetUnitRealField(udg_AgentSkully, UNIT_RF_SHADOW_IMAGE_HEIGHT, 200.0)
            endif
            call TriggerExecute( gg_trg_Quest_Rescue_Sound_H )
            call CreateTextTagUnitBJ( "TRIGSTR_11687", udg_AgentSkully, 0, 8.00, 100.00, 85.00, 65.00, 0 )
            call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 10.00, 90.00 )
            call cleanUpText(1.3, 1.0)
            call ShowTextTagForceBJ( false, GetLastCreatedTextTag(), GetPlayersAll() )
            call ShowTextTagForceBJ( true, GetLastCreatedTextTag(), udg_HordePlayers )
            call KillDestructable( gg_dest_B02P_35606 )
            call TriggerExecute(gg_trg_M_SAC_H)
            call TriggerSleepAction( 12.00 )
            call DestructableRestoreLife( gg_dest_B02P_35606, 50.00, true )
            return
        else
        endif
        set udg_Bag_Iterator = udg_Bag_Iterator + 1
    endloop
                       endif
    set udg_Temp_Unit_Point = null
endfunction

