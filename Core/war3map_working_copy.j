function InitTrig_Shadow_Mend takes nothing returns nothing
    set gg_trg_Shadow_Mend = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Shadow_Mend, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Shadow_Mend, Condition( function Trig_Shadow_Mend_Conditions ) )
    call TriggerAddAction( gg_trg_Shadow_Mend, function Trig_Shadow_Mend_Actions )
endfunction

