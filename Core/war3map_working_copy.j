    set gg_trg_F_PYR = CreateTrigger(  )
    call DisableTrigger( gg_trg_F_PYR )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_F_PYR, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_F_PYR, Condition( function Trig_F_PYR_Conditions ) )
    call TriggerAddAction( gg_trg_F_PYR, function Trig_F_PYR_Actions )
endfunction

//===========================================================================
// Trigger: E PYR
//===========================================================================
function Trig_E_PYR_Func023Func001Func005C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetEnumUnit()) == 'n026' ) ) then
        return true
    endif
    return false
endfunction

function Trig_E_PYR_Func023Func001C takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetEnumUnit()) == Player(PLAYER_NEUTRAL_AGGRESSIVE) ) ) then
        return false
    endif
    if ( not Trig_E_PYR_Func023Func001Func005C() ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_E_PYR_Func023A takes nothing returns nothing
    if ( Trig_E_PYR_Func023Func001C() ) then
        call AddSpecialEffectTargetUnitBJ( "overhead", GetEnumUnit(), "Abilities\\Spells\\Other\\TalkToMe\\TalkToMe.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call SetUnitOwner( GetEnumUnit(), Player(3), true )
    else
    endif
endfunction

function Trig_E_PYR_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 128
    local location udg_Temp_Unit_Point
    local location udg_Temp_Polar_Point
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    call FlashQuestDialogButtonBJ(  )
    endif
    call DestroyTimerDialogBJ( udg_QuestTimerWindows[udg_Temp_Int] )
    call QuestItemSetCompletedBJ( udg_QuestReqs[udg_Temp_Int], true )
    call QuestSetCompletedBJ( udg_Quests[udg_Temp_Int], true )
    call DestroyMinimapIcon( udg_MiniMapIcon[udg_Temp_Int] )
    // Clean Up Items
    set udg_ItemTypeCheck = 'I0A9'
    call CleanUpItems( udg_ItemTypeCheck )
    // Rewards
    set udg_XP = udg_QUEST_XP[udg_Temp_Int]
    set udg_Gold = udg_QUEST_GOLD[udg_Temp_Int]
    set udg_LVL_Req = udg_QUEST_LVL_REQ[udg_Temp_Int]
    set udg_TempString = "The Conquest of Pyrewood"
    call TriggerExecute( gg_trg_Quest_Complete_H )
    // Convert to Allies
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Forsaken_Crest)
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(1400.00, udg_Temp_Unit_Point), function Trig_E_PYR_Func023A )
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 300.00, 25.00)
    call CreateNUnitsAtLoc( 1, 'u00G', Player(3), udg_Temp_Polar_Point, 277.04 )
    call RemoveLocation (udg_Temp_Polar_Point)
    call RemoveLocation (udg_Temp_Unit_Point)
    call DisableTrigger(gg_trg_L_PYR)
    call DisableTrigger(gg_trg_U_PYR)
    call DisableTrigger( gg_trg_P_PYR)
    call DisableTrigger(gg_trg_F_PYR)
    call DisableTrigger(gg_trg_Pyrewood_Villagers)
    call TriggerExecute(gg_trg_M_Siege_of_Gilneas)
    call DisableTrigger( GetTriggeringTrigger() )
    set udg_Temp_Unit_Point = null
    set udg_Temp_Polar_Point = null
endfunction

