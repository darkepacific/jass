    call TriggerRegisterEnterRectSimple( gg_trg_Tirisfal_0, gg_rct_Z_Tirisfal_Murloc_Coast_0 )
    call TriggerRegisterEnterRectSimple( gg_trg_Tirisfal_0, gg_rct_Z_Trisfal_Glades_0 )
    call TriggerRegisterEnterRectSimple( gg_trg_Tirisfal_0, gg_rct_Z_Tirisfal_South_Tower_0 )
    call TriggerAddCondition( gg_trg_Tirisfal_0, Condition( function Trig_Tirisfal_0_Conditions ) )
    call TriggerAddAction( gg_trg_Tirisfal_0, function Trig_Tirisfal_0_Actions )
endfunction

//===========================================================================
// Trigger: Undercity
//===========================================================================
function Trig_Undercity_Func001C takes nothing returns boolean
    if ( ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'u01A' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'u013' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'u005' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Undercity_Conditions takes nothing returns boolean
    if ( not Trig_Undercity_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Undercity_Func003Func001Func001C takes nothing returns boolean
    if ( ( GetTriggerUnit() == udg_Heroes[GetForLoopIndexA()] ) ) then
        return true
    endif
    if ( ( GetTriggerUnit() == udg_FP_Bats_n_Gryphons[GetForLoopIndexA()] ) ) then
        return true
    endif
    return false
endfunction

function Trig_Undercity_Func003Func001C takes nothing returns boolean
    if ( not Trig_Undercity_Func003Func001Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Undercity_Func004C takes nothing returns boolean
    if ( not ( udg_Player_Music[udg_Player_Number] != "Undercity" ) ) then
        return false
    endif
    if ( not ( udg_Player_Number != 11 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Undercity_Actions takes nothing returns nothing
    set udg_Player_Number = 11
    set bj_forLoopAIndex = 0
    set bj_forLoopAIndexEnd = 7
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_Undercity_Func003Func001C() ) then
            set udg_Player_Number = GetForLoopIndexA()
            exitwhen true
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    if ( Trig_Undercity_Func004C() ) then
        if GetLocalPlayer() == GetOwningPlayer(GetTriggerUnit()) then
        call ClearMapMusicBJ(  )
        call StopMusicBJ( false )
        call EndThematicMusicBJ(  )
        call PlayThematicMusicBJ( "war3mapImported\\INTRO_Undercity.mp3" )
        call PlayMusicBJ( gg_snd_Undercity_Walk )
        call PlayMusicBJ( gg_snd_INTRO_Undercity )
        endif
        set udg_Player_Music[udg_Player_Number] = "Undercity"
    else
    endif
endfunction

//===========================================================================
function InitTrig_Undercity takes nothing returns nothing
    set gg_trg_Undercity = CreateTrigger(  )
    call TriggerRegisterEnterRectSimple( gg_trg_Undercity, gg_rct_Z_Undercity )
    call TriggerAddCondition( gg_trg_Undercity, Condition( function Trig_Undercity_Conditions ) )
    call TriggerAddAction( gg_trg_Undercity, function Trig_Undercity_Actions )
endfunction

