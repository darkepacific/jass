//===========================================================================
// Trigger: M BLD A
//===========================================================================
function Trig_M_BLD_A_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 116
    set udg_TempString = ""
    if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
    set udg_TempString = udg_ExclamationMark
    endif
    call AddSpecialEffectTargetUnitBJ( "overhead", gg_unit_nrdr_1580, udg_TempString )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 1.70 )
    set udg_QuestMarks[udg_Temp_Int] = GetLastCreatedEffectBJ()
    set udg_TempString = "Mount a red dragon and use it to aid Alexstrasza in her fight against the corrupted black dragon flight."
    // Set Quest Rewards
    set udg_QUEST_XP[udg_Temp_Int] = 1000
    set udg_QUEST_GOLD[udg_Temp_Int] = 200
    set udg_QUEST_LVL_REQ[udg_Temp_Int] = udg_QUEST_ZONE_3_LVL_REQ
    call QuestRewards_TextSet(udg_Temp_Int)
    // End Set Quest Rewards
    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_672", udg_TempString, "ReplaceableTextures\\CommandButtons\\BTNRedDragon.blp" )
    set udg_Quests[udg_Temp_Int] = GetLastCreatedQuestBJ()
    call QuestSetEnabledBJ( false, GetLastCreatedQuestBJ() )
    call EnableTrigger(gg_trg_S_BLD_A)
endfunction

//===========================================================================
function InitTrig_M_BLD_A takes nothing returns nothing
    set gg_trg_M_BLD_A = CreateTrigger(  )
    call TriggerAddAction( gg_trg_M_BLD_A, function Trig_M_BLD_A_Actions )
endfunction

//===========================================================================
// Trigger: S BLD A
//
// 
//===========================================================================
function Trig_S_BLD_A_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 116
    local player udg_X_Player_MUI
    local location udg_Temp_Unit_Point
    local effect eff
                       if IsAllianceHero( GetTriggerUnit() ) then
    call CreateQuestItemBJ( udg_Quests[udg_Temp_Int], "TRIGSTR_10517" )
    set udg_QuestReqs[udg_Temp_Int] = GetLastCreatedQuestItemBJ()
    set udg_TempString = "The Battle of Life & Death"
    set udg_TempString_Quest = "Aid Alexstrasza in her fight against Deathwing"
    call TriggerExecute( gg_trg_Quest_Start_A )
    if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
    call QuestSetEnabledBJ( true, udg_Quests[udg_Temp_Int] )
    call FlashQuestDialogButtonBJ(  )
    endif
    call DestroyEffectBJ( udg_QuestMarks[udg_Temp_Int] )
    call QuestSetCompletedBJ( udg_Quests[udg_Temp_Int], false )
    call TriggerExecute(gg_trg_C_BLD)
    call EnableTrigger(gg_trg_Dragon_Clicked)
    call EnableTrigger(gg_trg_H_BLD_A)
    call EnableTrigger(gg_trg_U_BLD_B)
    call EnableTrigger(gg_trg_U_BLD_R)
    call EnableTrigger(gg_trg_P_BLD)
    call DisableTrigger( GetTriggeringTrigger() )
    call GameTimeWait(1.0)
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Battle_of_Life_and_Death_Quest_Start)
    set udg_TempString = ""
    if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
    set udg_TempString = udg_LootEffect
    endif
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, udg_TempString )
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), ( BlzGetLocalSpecialEffectZ(GetLastCreatedEffectBJ()) + 500.00 ) )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 3.00 )
    set eff = GetLastCreatedEffectBJ()
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_X_Player_MUI = GetOwningPlayer(GetTriggerUnit())
    call ForceAddPlayerSimple( udg_X_Player_MUI, udg_Player_Message_Group )
    call QuestMessageBJ( udg_Player_Message_Group, bj_QUESTMESSAGE_REQUIREMENT, "TRIGSTR_10516" )
    call ForceRemovePlayerSimple( udg_X_Player_MUI, udg_Player_Message_Group )
    call GameTimeWait(2.8)
    call DestroyEffect( eff)
                       endif
    set udg_X_Player_MUI = null
    set udg_Temp_Unit_Point = null
    set eff = null
endfunction

//===========================================================================
function InitTrig_S_BLD_A takes nothing returns nothing
    set gg_trg_S_BLD_A = CreateTrigger(  )
    call DisableTrigger( gg_trg_S_BLD_A )
    call TriggerRegisterEnterRectSimple( gg_trg_S_BLD_A, gg_rct_Battle_of_Life_and_Death_Quest_Start )
    call TriggerAddAction( gg_trg_S_BLD_A, function Trig_S_BLD_A_Actions )
endfunction

