//===========================================================================
// Trigger: Firestone Acquired
//===========================================================================
function Trig_Firestone_Acquired_Conditions takes nothing returns boolean
    if ( not ( GetItemTypeId(GetManipulatedItem()) == 'I04I' ) ) then
        return false
    endif
    if ( not ( RectContainsUnit(gg_rct_Z_Lots_O_Seels_n_Penwens_Music, GetTriggerUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Firestone_Acquired_Func009Func001A takes nothing returns nothing
    call SetUnitLifeBJ( GetEnumUnit(), 0.00 )
endfunction

function Trig_Firestone_Acquired_Func009A takes nothing returns nothing
    call ForGroupBJ( udg_Temp_Group, function Trig_Firestone_Acquired_Func009Func001A )
endfunction

function Trig_Firestone_Acquired_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    call PlaySoundOnUnitBJ( gg_snd_LichKingDream, 90.00, GetTriggerUnit() )
    call CameraSetEQNoiseForPlayer( GetOwningPlayer(GetTriggerUnit()), 6.00 )
    call TriggerSleepAction( 1.20 )
    call CameraClearNoiseForPlayer( GetOwningPlayer(GetTriggerUnit()) )
    call TriggerSleepAction( 3.00 )
    // KILL
    set udg_Temp_Group = GetUnitsInRectAll(gg_rct_Lots_O_Seels_n_Penwens)
    call ForGroupBJ( udg_Temp_Group, function Trig_Firestone_Acquired_Func009A )
    // FIRE
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Fire_Effect_1)
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Fire_Effect_2)
    call PlaySoundAtPointBJ( gg_snd_BlueFireBurst, 100, udg_Temp_Unit_Point, 100.00 )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Fire_Effect_3)
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call RemoveLocation (udg_Temp_Unit_Point)
    call DestroyGroup (udg_Temp_Group)
    call TriggerSleepAction( 15.00 )
    // NEW STONE
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Fire_Gem)
    call CreateItemLoc( 'I04I', udg_Temp_Unit_Point )
    call SetItemUserData( GetLastCreatedItem(), 99 )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 15.00 )
    // NEW CRITTERS
    set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_Lots_O_Seels_n_Penwens)
    call CreateNUnitsAtLoc( 2, 'npng', Player(PLAYER_NEUTRAL_PASSIVE), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = GetRandomLocInRect(gg_rct_Lots_O_Seels_n_Penwens)
    call CreateNUnitsAtLoc( 2, 'nsea', Player(PLAYER_NEUTRAL_PASSIVE), udg_Temp_Unit_Point, GetRandomDirectionDeg() )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = null
endfunction

//===========================================================================
function InitTrig_Firestone_Acquired takes nothing returns nothing
    set gg_trg_Firestone_Acquired = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Firestone_Acquired, EVENT_PLAYER_UNIT_PICKUP_ITEM )
    call TriggerAddCondition( gg_trg_Firestone_Acquired, Condition( function Trig_Firestone_Acquired_Conditions ) )
    call TriggerAddAction( gg_trg_Firestone_Acquired, function Trig_Firestone_Acquired_Actions )
endfunction

//===========================================================================
// Trigger: M Sindragosa A
//===========================================================================
function Trig_M_Sindragosa_A_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 84
    set udg_TempString = ""
    if IsAlliancePlayer( GetLocalPlayer() ) then
    set udg_TempString = udg_ExclamationMark
    endif
    call AddSpecialEffectTargetUnitBJ( "overhead", gg_unit_ntkc_0641, udg_TempString )
    set udg_QuestMarks[84] = GetLastCreatedEffectBJ()
    set udg_TempString = "The mighty dragon Sindragosa lives in a tower to the east. Her spawn enchroach upon our village at night. Please ensure our survival! You will need something hot to destroy the icy walls that protect her..."
    // Set Quest Rewards
    set udg_QUEST_XP[udg_Temp_Int] = 2000
    set udg_QUEST_GOLD[udg_Temp_Int] = 500
    set udg_QUEST_LVL_REQ[udg_Temp_Int] = udg_QUEST_ZONE_5_LVL_REQ
    call QuestRewards_TextSet(udg_Temp_Int)
    // End Set Quest Rewards
    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_589", udg_TempString, "ReplaceableTextures\\CommandButtons\\BTNAzureDragon.blp" )
    set udg_Quests[84] = GetLastCreatedQuestBJ()
    call QuestSetEnabledBJ( false, GetLastCreatedQuestBJ() )
    call EnableTrigger( gg_trg_S_Sindra_A )
endfunction

