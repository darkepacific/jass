    return true
endfunction

function Trig_Soul_Drain_Stop_Func001C takes nothing returns boolean
    if ( not ( GetTriggerUnit() == udg_yA_Demon_Warlock ) ) then
        return false
    endif
    return true
endfunction

function Trig_Soul_Drain_Stop_Func002C takes nothing returns boolean
    if ( not ( GetTriggerUnit() == udg_yH_Demon_Warlock ) ) then
        return false
    endif
    return true
endfunction

function Trig_Soul_Drain_Stop_Actions takes nothing returns nothing
    if ( Trig_Soul_Drain_Stop_Func001C() ) then
        call DisableTrigger( gg_trg_Soul_Drain_Tick_WG )
    else
    endif
    if ( Trig_Soul_Drain_Stop_Func002C() ) then
