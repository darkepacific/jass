    set udg_TempString = ""
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    set udg_TempString = udg_ExclamationMark
    endif
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Party_Favors)
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, udg_TempString )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 1.10 )
    call BlzSetSpecialEffectYaw( GetLastCreatedEffectBJ(), Deg2Rad(210.00) )
    call BlzSetSpecialEffectZ(GetLastCreatedEffectBJ(), BlzGetLocalSpecialEffectZ(GetLastCreatedEffectBJ()) + 160)
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_QuestMarks[110] = GetLastCreatedEffectBJ()
    set udg_TempString = "The sign reads; |nWANTED: The murlocs who stole our party supplies. Fellow partiers inquire."
    // Set Quest Rewards
    set udg_QUEST_XP[udg_Temp_Int] = 250
    set udg_QUEST_GOLD[udg_Temp_Int] = 0
    call QuestRewards_TextSet(udg_Temp_Int)
    // End Set Quest Rewards
    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_9549", udg_TempString, "ReplaceableTextures\\CommandButtons\\BTNinv_misc_red_fireworks.blp" )
    set udg_Quests[110] = GetLastCreatedQuestBJ()
    call QuestSetEnabledBJ( false, udg_Quests[110] )
    call QuestSetDiscoveredBJ( udg_Quests[110], false )
    call EnableTrigger( gg_trg_S_Party_Favors)
    call DisableTrigger( gg_trg_H_Party_Favors)
    set udg_Temp_Unit_Point = null
endfunction

