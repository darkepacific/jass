    if GetUnitManaPercent(udg_Temp_Unit) < 100.00 then
    call MaxManaRestore( 0.00125, udg_Temp_Unit)
    if ( Trig_Prowl_Periodic_NE_Func006C() ) then
        call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "war3mapImported\\Ember Blue.mdx" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    else
    endif
    endif
    else
    call DisableTrigger( GetTriggeringTrigger() )
    endif
endfunction

