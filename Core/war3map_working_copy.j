    set gg_trg_Sacrifice_Summon = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Sacrifice_Summon, EVENT_PLAYER_UNIT_SUMMON )
    call TriggerAddCondition( gg_trg_Sacrifice_Summon, Condition( function Trig_Sacrifice_Summon_Conditions ) )
    call TriggerAddAction( gg_trg_Sacrifice_Summon, function Trig_Sacrifice_Summon_Actions )
endfunction

//===========================================================================
// Trigger: Sacrfice Heal
//===========================================================================
function Trig_Sacrfice_Heal_Func031C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'E02Z' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'E04A' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Sacrfice_Heal_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A09B' ) ) then
        return false
    endif
    if ( not Trig_Sacrfice_Heal_Func031C() ) then
        return false
    endif
    return true
endfunction

function Trig_Sacrfice_Heal_Func002C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'E04A' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Sacrfice_Heal_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    if ( Trig_Sacrfice_Heal_Func002C() ) then
        set udg_o = udg_z_WL_DEST_A
    else
        set udg_o = udg_z_WL_DEST_H
    endif
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 3 ]  then
    set udg_Eclipse[udg_o] = 1
    endif
    call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "war3mapImported\\MagicCircle_Devil.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set udg_Temp_Unit_Point = GetUnitLoc(udg_SpellUnits[ udg_o ] )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Weapons\\MeatwagonMissile\\MeatwagonMissile.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\MagicCircle_Devil.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\MagicCircle_Demon.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\MagicCircle_Fire.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_RealStatCalc = ( 200.00 * I2R(GetUnitAbilityLevelSwapped('A09B', GetTriggerUnit())) )
    set udg_RealStatCalc = ( ( udg_RealStatCalc / 100.00 ) * GetUnitLifePercent(udg_SpellUnits[udg_o]) )
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 14 ]  then
    set udg_RealStatCalc = ( 1.66 * udg_RealStatCalc )
    endif
    call SetUnitManaBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) + ( ( udg_RealStatCalc / 5.00 ) * 3.00 ) ) )
    set udg_Temp_Unit = GetTriggerUnit()
    if ChaliceCheck() then
    set udg_RealStatCalc = ( ( udg_CHALICE_HEAL * udg_RealStatCalc ) + udg_RealStatCalc )
    endif
    call SetUnitLifeBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) + udg_RealStatCalc ) )
    call KillUnit(udg_SpellUnits[ udg_o ] )
endfunction

//===========================================================================
function InitTrig_Sacrfice_Heal takes nothing returns nothing
    set gg_trg_Sacrfice_Heal = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Sacrfice_Heal, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Sacrfice_Heal, Condition( function Trig_Sacrfice_Heal_Conditions ) )
    call TriggerAddAction( gg_trg_Sacrfice_Heal, function Trig_Sacrfice_Heal_Actions )
endfunction

