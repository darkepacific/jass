    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_11677", udg_TempString, "ReplaceableTextures\\CommandButtons\\BTNHeroAvatarOfFlame.blp" )
    set udg_Quests[udg_Temp_Int] = GetLastCreatedQuestBJ()
