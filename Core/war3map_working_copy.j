//===========================================================================
// Trigger: Windfury
//===========================================================================
function Trig_Windfury_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A08T' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Windfury_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    call PlaySoundOnUnitBJ( gg_snd_Windfury_1, 90.00, udg_Temp_Unit )
    call SetUnitMoveSpeed( GetTriggerUnit(), ( GetUnitMoveSpeed(GetTriggerUnit()) * 1.25 ) )
    call BlzSetUnitAttackCooldown( GetTriggerUnit(), 1.70, 1 )
    call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "Abilities\\Spells\\Items\\AIsp\\SpeedTarget.mdl" )
    if ( GetTriggerUnit() == udg_yH_Enhance_Shaman) then
    set udg_Charge_SE[22] = GetLastCreatedEffectBJ()
    set udg_SpellTicks[9] = 1
    call EnableTrigger(gg_trg_Windfury_Crit_Orc)
    else
    set udg_Charge_SE[23] = GetLastCreatedEffectBJ()
    set udg_SpellTicks[28] = 1
    call EnableTrigger(gg_trg_Windfury_Crit_Dwf)
    endif
    call SetUnitTimeScalePercent( udg_Temp_Unit, 260.00 )
    call TriggerSleepAction( 0.40 )
    set udg_Temp_Unit = GetTriggerUnit()
    call SetUnitTimeScalePercent( udg_Temp_Unit, 100.00 )
    call TriggerSleepAction( 2.40 )
    if ( GetTriggerUnit() == udg_yH_Enhance_Shaman) then
    call DestroyEffectBJ( udg_Charge_SE[22] )
    else
    call DestroyEffectBJ( udg_Charge_SE[23] )
    endif
    call SetUnitMoveSpeed( GetTriggerUnit(), GetUnitDefaultMoveSpeed(GetTriggerUnit()) )
    call TriggerSleepAction( 2.20 )
    call BlzSetUnitAttackCooldown( GetTriggerUnit(), 2.28, 1 )
    if ( GetTriggerUnit() == udg_yH_Enhance_Shaman) then
    call DisableTrigger(gg_trg_Windfury_Crit_Orc)
    else
    call DisableTrigger(gg_trg_Windfury_Crit_Dwf)
    endif
endfunction

