//===========================================================================
// Trigger: FlameWalkers Lvl Up
//===========================================================================
function Trig_FlameWalkers_Lvl_Up_Conditions takes nothing returns boolean
    if ( not ( GetPlayerController(GetOwningPlayer(GetTriggerUnit())) == MAP_CONTROL_USER ) ) then
        return false
    endif
    return true
endfunction

function Trig_FlameWalkers_Lvl_Up_Func002Func001C takes nothing returns boolean
    if ( not ( GetItemTypeId(UnitItemInSlotBJ(GetTriggerUnit(), GetForLoopIndexB())) == 'I06T' ) ) then
        return false
    endif
    return true
endfunction

function Trig_FlameWalkers_Lvl_Up_Actions takes nothing returns nothing
    set bj_forLoopBIndex = 1
    set bj_forLoopBIndexEnd = 6
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        if ( Trig_FlameWalkers_Lvl_Up_Func002Func001C() ) then
            set udg_Temp_Item = UnitItemInSlotBJ(GetTriggerUnit(), GetForLoopIndexB())
            // Remove old buff
            set udg_Temp_Int = S2I(SubStringBJ(BlzGetItemDescription(udg_Temp_Item), 226, 228))
            set udg_Temp_Int = ( ( udg_Temp_Int - 20 ) / 3 )
            call BlzItemRemoveAbilityBJ( udg_Temp_Item, udg_InitFlamewalkers[udg_Temp_Int] )
            // Add new buffs
            set udg_HeroStatCalc = GetUnitLevel(GetTriggerUnit())
            call BlzItemAddAbilityBJ( udg_Temp_Item, udg_InitFlamewalkers[udg_HeroStatCalc] )
            set udg_HeroStatCalc = ( ( udg_HeroStatCalc * 3 ) + 20 )
            call BlzSetItemDescription( udg_Temp_Item, ( "+6 Armor +400 Health +8 Strength |n|n|cccFFaa00Non-Stacking Passive:|r Nearby enemies take |cffffcc00|r|cffffcc0020|r + |cffffcc00|r|cffffcc003|r x Hero Level|r magic damage per second. |n|cccFFaa00Current Bonus:|r |cffffcc00" + ( I2S(udg_HeroStatCalc) + " |rdps" ) ) )
            call BlzSetItemExtendedTooltip( udg_Temp_Item, ( "+6 Armor +400 Health +8 Strength |n|n|cccFFaa00Non-Stacking Passive:|r Nearby enemies take |cffffcc00|r|cffffcc0020|r + |cffffcc00|r|cffffcc003|r x Hero Level|r magic damage per second. |n|cccFFaa00Current Bonus:|r |cffffcc00" + ( I2S(udg_HeroStatCalc) + " |rdps" ) ) )
        else
        endif
        set bj_forLoopBIndex = bj_forLoopBIndex + 1
    endloop
endfunction

//===========================================================================
function InitTrig_FlameWalkers_Lvl_Up takes nothing returns nothing
    set gg_trg_FlameWalkers_Lvl_Up = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_FlameWalkers_Lvl_Up, EVENT_PLAYER_HERO_LEVEL )
    call TriggerAddCondition( gg_trg_FlameWalkers_Lvl_Up, Condition( function Trig_FlameWalkers_Lvl_Up_Conditions ) )
    call TriggerAddAction( gg_trg_FlameWalkers_Lvl_Up, function Trig_FlameWalkers_Lvl_Up_Actions )
endfunction

