    if ( not ( RectContainsUnit(gg_rct_Kael, GetTriggerUnit()) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Kael_Leave_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Kael)
    call IssuePointOrderLocBJ( GetTriggerUnit(), "move", udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call GameTimeWait(3.0)
    if ( Trig_Kael_Leave_Func006C() ) then
        set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Kael)
        call IssuePointOrderLocBJ( GetTriggerUnit(), "move", udg_Temp_Unit_Point )
        call RemoveLocation (udg_Temp_Unit_Point)
        call GameTimeWait(3.0)
        if ( Trig_Kael_Leave_Func006Func006C() ) then
            set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Kael)
            call IssuePointOrderLocBJ( GetTriggerUnit(), "move", udg_Temp_Unit_Point )
            call RemoveLocation (udg_Temp_Unit_Point)
            call GameTimeWait(3.0)
            if ( Trig_Kael_Leave_Func006Func006Func006C() ) then
                set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Kael)
                call IssuePointOrderLocBJ( GetTriggerUnit(), "move", udg_Temp_Unit_Point )
                call RemoveLocation (udg_Temp_Unit_Point)
            else
            endif
        else
        endif
    else
    endif
    set udg_Temp_Unit_Point = null
endfunction

