        else
        endif
        if ( Trig_Set_Hearths_Func006Func021C() ) then
            set udg_Hearthstones[udg_Player_Number] = 19
            set udg_TempString = "Highbank"
        else
        endif
        if ( Trig_Set_Hearths_Func006Func022C() ) then
            set udg_Hearthstones[udg_Player_Number] = 20
