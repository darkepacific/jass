function InitTrig_FrostNova takes nothing returns nothing
    set gg_trg_FrostNova = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_FrostNova, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_FrostNova, Condition( function Trig_FrostNova_Conditions ) )
    call TriggerAddAction( gg_trg_FrostNova, function Trig_FrostNova_Actions )
endfunction

//===========================================================================
// Trigger: Cone of Cold
//
// call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A03G'), ABILITY_RLF_AREA_OF_EFFECT_DAMAGE, 0, udg_RealStatCalc )
//===========================================================================
function Trig_Cone_of_Cold_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A08J' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cone_of_Cold_Func006Func001C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 2) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cone_of_Cold_Func006C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 3) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cone_of_Cold_Func010Func001C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 2) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cone_of_Cold_Func010C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 3) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cone_of_Cold_Func022A takes nothing returns nothing
    if IsUnitTargetableEnemyGround( GetEnumUnit(), udg_Temp_Unit ) then
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "Abilities\\Spells\\Other\\FrostDamage\\FrostDamage.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_Cone_of_Cold_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
    if udg_Temp_Unit == udg_yA_Frost_Mage then
    call PlaySoundOnUnitBJ( gg_snd_ConeofCold, 55.00, GetSpellAbilityUnit() )
    call PlaySoundOnUnitBJ( gg_snd_FrostNovaTarget101, 90.00, GetSpellAbilityUnit() )
    if ( Trig_Cone_of_Cold_Func006C() ) then
        call PlaySoundOnUnitBJ( gg_snd_Cone_of_Cold_01, 80.00, GetSpellAbilityUnit() )
    else
        if ( Trig_Cone_of_Cold_Func006Func001C() ) then
            call PlaySoundOnUnitBJ( gg_snd_Cone_of_Cold_02, 80.00, GetSpellAbilityUnit() )
        else
            call PlaySoundOnUnitBJ( gg_snd_Cone_of_Cold_03, 80.00, GetSpellAbilityUnit() )
        endif
    endif
    elseif udg_Temp_Unit == udg_yH_Frost_Mage then
    call PlaySoundOnUnitBJ( gg_snd_ConeofCold, 55.00, GetSpellAbilityUnit() )
    call PlaySoundOnUnitBJ( gg_snd_FrostNovaTarget102, 90.00, GetSpellAbilityUnit() )
    if ( Trig_Cone_of_Cold_Func010C() ) then
        call PlaySoundOnUnitBJ( gg_snd_Cone_of_Cold_0101, 80.00, GetSpellAbilityUnit() )
    else
        if ( Trig_Cone_of_Cold_Func010Func001C() ) then
            call PlaySoundOnUnitBJ( gg_snd_Cone_of_Cold_0201, 80.00, GetSpellAbilityUnit() )
        else
            call PlaySoundOnUnitBJ( gg_snd_Cone_of_Cold_0301, 80.00, GetSpellAbilityUnit() )
        endif
    endif
    else
    call PlaySoundOnUnitBJ( gg_snd_ConeofCold, 60.00, GetSpellAbilityUnit() )
    endif
    set udg_Temp_Unit_Point = GetUnitLoc(GetTriggerUnit())
    set udg_Temp_Polar_Point = GetSpellTargetLoc()
    set udg_Temp_Angle = AngleBetweenPoints(udg_Temp_Unit_Point, udg_Temp_Polar_Point)
    call RemoveLocation (udg_Temp_Polar_Point)
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 300.00, udg_Temp_Angle)
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( udg_RealStatCalc * 4.00 )
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(410.00, udg_Temp_Polar_Point), function Trig_Cone_of_Cold_Func022A )
    call CreateNUnitsAtLoc( 1, 'e02B', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Polar_Point, udg_Temp_Angle )
    set udg_Temp_Unit = GetLastCreatedUnit()
    call RemoveLocation (udg_Temp_Polar_Point)
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 150.00, udg_Temp_Angle)
    call AddSpecialEffectLocBJ( udg_Temp_Polar_Point, "war3mapImported\\cone of cold.mdx" )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), Deg2Rad(udg_Temp_Angle), 0.00, 0.00 )
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), ( BlzGetLocalUnitZ(GetTriggerUnit()) - 50.00 ) )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 1.80 )
    call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 2.12 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call RemoveLocation (udg_Temp_Unit_Point)
    call RemoveLocation (udg_Temp_Polar_Point)
    if udg_TalentChoices[  GetPlayerId(GetOwningPlayer(udg_Temp_Unit))  * udg_NUM_OF_TC + 3 ]  then
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A03G'), ABILITY_RLF_DURATION_NORMAL, 0, 4.0 )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A03G'), ABILITY_RLF_DURATION_HERO, 0, 4.0 )
    else
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A03G'), ABILITY_RLF_DURATION_NORMAL, 0, 2.5 )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A03G'), ABILITY_RLF_DURATION_HERO, 0, 2.5 )
    endif
    call UnitApplyTimedLifeBJ( 0.75, 'BTLF', GetLastCreatedUnit() )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "frostnova", GetLastCreatedUnit() )
endfunction

