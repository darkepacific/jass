    call CameraSetupSetField( gg_cam_Hearth_DeathKnell, CAMERA_FIELD_LOCAL_YAW, 0.0, 0.0 )
    call CameraSetupSetField( gg_cam_Hearth_DeathKnell, CAMERA_FIELD_LOCAL_ROLL, 0.0, 0.0 )
    call CameraSetupSetField( gg_cam_Hearth_DeathKnell, CAMERA_FIELD_DEPTH_OF_FIELD_DISTANCE, 0.0, 0.0 )
    call CameraSetupSetField( gg_cam_Hearth_DeathKnell, CAMERA_FIELD_DEPTH_OF_FIELD_SCALE, 0.0, 0.0 )
    call CameraSetupSetField( gg_cam_Hearth_DeathKnell, CAMERA_FIELD_ZABSOLUTE, 0.0, 0.0 )
    call CameraSetupSetDestPosition( gg_cam_Hearth_DeathKnell, -7201.7, 2988.6, 0.0 )
    call BlzCameraSetupSetCameraType( gg_cam_Hearth_DeathKnell, 0 )

    set gg_cam_Argent_Tournament_Rev = CreateCameraSetup(  )
    call CameraSetupSetField( gg_cam_Argent_Tournament_Rev, CAMERA_FIELD_ZOFFSET, 0.0, 0.0 )
    call CameraSetupSetField( gg_cam_Argent_Tournament_Rev, CAMERA_FIELD_ROTATION, 90.0, 0.0 )
    call CameraSetupSetField( gg_cam_Argent_Tournament_Rev, CAMERA_FIELD_ANGLE_OF_ATTACK, 304.0, 0.0 )
    call CameraSetupSetField( gg_cam_Argent_Tournament_Rev, CAMERA_FIELD_TARGET_DISTANCE, 1650.0, 0.0 )
    call CameraSetupSetField( gg_cam_Argent_Tournament_Rev, CAMERA_FIELD_ROLL, 0.0, 0.0 )
    call CameraSetupSetField( gg_cam_Argent_Tournament_Rev, CAMERA_FIELD_FIELD_OF_VIEW, 70.0, 0.0 )
    call CameraSetupSetField( gg_cam_Argent_Tournament_Rev, CAMERA_FIELD_FARZ, 5000.0, 0.0 )
    call CameraSetupSetField( gg_cam_Argent_Tournament_Rev, CAMERA_FIELD_NEARZ, 100.0, 0.0 )
    call CameraSetupSetField( gg_cam_Argent_Tournament_Rev, CAMERA_FIELD_LOCAL_PITCH, 0.0, 0.0 )
    call CameraSetupSetField( gg_cam_Argent_Tournament_Rev, CAMERA_FIELD_LOCAL_YAW, 0.0, 0.0 )
    call CameraSetupSetField( gg_cam_Argent_Tournament_Rev, CAMERA_FIELD_LOCAL_ROLL, 0.0, 0.0 )
    call CameraSetupSetField( gg_cam_Argent_Tournament_Rev, CAMERA_FIELD_DEPTH_OF_FIELD_DISTANCE, 0.0, 0.0 )
    call CameraSetupSetField( gg_cam_Argent_Tournament_Rev, CAMERA_FIELD_DEPTH_OF_FIELD_SCALE, 0.0, 0.0 )
    call CameraSetupSetField( gg_cam_Argent_Tournament_Rev, CAMERA_FIELD_ZABSOLUTE, 0.0, 0.0 )
    call CameraSetupSetDestPosition( gg_cam_Argent_Tournament_Rev, -16310.3, 18864.4, 0.0 )
    call BlzCameraSetupSetCameraType( gg_cam_Argent_Tournament_Rev, 0 )

    set gg_cam_Wintergarde_Rev = CreateCameraSetup(  )
    call CameraSetupSetField( gg_cam_Wintergarde_Rev, CAMERA_FIELD_ZOFFSET, 0.0, 0.0 )
    call CameraSetupSetField( gg_cam_Wintergarde_Rev, CAMERA_FIELD_ROTATION, 90.0, 0.0 )
