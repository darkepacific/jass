//
// {Figure out why smoke cloud is choosy with it targeting}
// BER seems to get it fine but HR has issues, including misses applying to self
//===========================================================================
function Trig_SmokeCloud_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A06M' ) ) then
        return false
    endif
    return true
endfunction

function Trig_SmokeCloud_Actions takes nothing returns nothing
    call CreateNUnitsAtLoc( 1, 'e00A', GetOwningPlayer(GetTriggerUnit()), GetSpellTargetLoc(), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 6.50, 'BTLF', GetLastCreatedUnit() )
    set udg_Temp_Unit_Point = GetSpellTargetLoc()
    call IssuePointOrderLocBJ( GetLastCreatedUnit(), "cloudoffog", udg_Temp_Unit_Point )
    call PlaySoundAtPointBJ( gg_snd_PhaseShift1, 100, udg_Temp_Unit_Point, 0 )
    call RemoveLocation (udg_Temp_Unit_Point)
