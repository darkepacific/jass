        call SetPlayerAbilityAvailableBJ( false, 'A0E1', GetOwningPlayer(udg_yH_Feral_Druid) )
        call SetPlayerAbilityAvailableBJ( false, 'A0E3', GetOwningPlayer(udg_yH_Feral_Druid) )
        if ( Trig_Feral_Druid_Form_Check_Func005Func004C() ) then
