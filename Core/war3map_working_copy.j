//===========================================================================
// Trigger: Endless Rage
//===========================================================================
function Trig_Endless_Rage_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A05K' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Endless_Rage_Actions takes nothing returns nothing
    local effect eff
    local real heal
    local unit udg_Temp_Unit = GetTriggerUnit()
    call AddSpecialEffectTargetUnitBJ( "overhead", udg_Temp_Unit, "MaskOfDeath.mdx" )
    set eff = GetLastCreatedEffectBJ()
    call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "war3mapImported\\BloodTornado.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    // Remove Debuffs
    //call AddAndHideSpell(udg_Temp_Unit, 'ACm2')
    call UnitRemoveBuffsBJ( bj_REMOVEBUFFS_NEGATIVE, GetTriggerUnit() )
    //call RemoveAndUnHideSpell(udg_Temp_Unit, 'ACm2')
    // A
    if udg_Temp_Unit == udg_yA_Fury_Warr then
    set udg_A_Fury_Warr_Endless = true
    call StopSoundBJ( gg_snd_UndeadRoar, false )
    call PlaySoundOnUnitBJ( gg_snd_UndeadRoar, 85.00, GetSpellAbilityUnit() )
    call GameTimeWait(7.0)
    set udg_A_Fury_Warr_Endless = false
    // H
    elseif udg_Temp_Unit == udg_yA_Fury_Warr then
    set udg_H_Fury_Warr_Endless = true
    call StopSoundBJ( gg_snd_OrcMaleRoar, false )
    call PlaySoundOnUnitBJ( gg_snd_OrcMaleRoar, 85.00, GetSpellAbilityUnit() )
    call GameTimeWait(7.0)
    set udg_H_Fury_Warr_Endless = false
    // N (Skovald)
    else
    set udg_N_God_King_Skovald_Endless = true
    call StopSoundBJ( gg_snd_OrcMaleRoar, false )
    call PlaySoundOnUnitBJ( gg_snd_OrcMaleRoar, 85.00, GetSpellAbilityUnit() )
    call GameTimeWait(7.0)
    set udg_N_God_King_Skovald_Endless = false
    endif
    // End Effect
    call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    // Talent
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 9 ]  or udg_Temp_Unit == gg_unit_H03R_2211 then
    set heal = 0.25
    if ChaliceCheck() then
    set heal = heal * (1 + udg_CHALICE_HEAL )
    endif
    call MaxHealthRestore( heal, udg_Temp_Unit)
    call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "war3mapImported\\Heal Orange.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    endif
    call DestroyEffectBJ( eff )
    set eff = null
    set udg_Temp_Unit = null
endfunction

//===========================================================================
function InitTrig_Endless_Rage takes nothing returns nothing
    set gg_trg_Endless_Rage = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Endless_Rage, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Endless_Rage, Condition( function Trig_Endless_Rage_Conditions ) )
    call TriggerAddAction( gg_trg_Endless_Rage, function Trig_Endless_Rage_Actions )
endfunction

//===========================================================================
// Trigger: Makgora
//
// Cannot shadow here due to neseted function
//===========================================================================
function Trig_Makgora_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A05H' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Makgora_Func019A takes nothing returns nothing
    call Debug ("Magkora Temp_Int:" + I2S(udg_Temp_Int) )
    if IsUnitTargetableEnemyHitsAll( GetEnumUnit(), udg_Temp_Unit) then
    if udg_Temp_Int == 28 then
    call GroupAddUnitSimple( GetEnumUnit(), udg_MakgoraA )
    else
    call GroupAddUnitSimple( GetEnumUnit(), udg_MakgoraH )
    endif
    call IssueTargetOrderBJ( gg_unit_e028_1863, "faeriefire", GetEnumUnit() )
    endif
endfunction

function Trig_Makgora_Func045A takes nothing returns nothing
    call MakgoraEnd( udg_MakgoraA)
endfunction

function Trig_Makgora_Func049A takes nothing returns nothing
    call MakgoraEnd( udg_MakgoraH)
endfunction

function Trig_Makgora_Actions takes nothing returns nothing
    local integer i
    set udg_Temp_Int = 28
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
    set udg_Facing_Angle = GetUnitFacing(GetTriggerUnit())
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 150.00, udg_Facing_Angle)
    if udg_Temp_Unit == udg_yA_Fury_Warr then
    set udg_Temp_Int = 28
    set i = udg_Temp_Int
    else
    set udg_Temp_Int = 29
    set i = udg_Temp_Int
    endif
    set udg_Blizzard[udg_Temp_Int] = udg_Temp_Polar_Point
    call RemoveLocation (udg_Temp_Unit_Point)
    call StopSoundBJ( gg_snd_MakGora_Orc, false )
    call PlaySoundAtPointBJ( gg_snd_MakGora_Orc, 100, udg_Temp_Polar_Point, 50.00 )
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(375.00, udg_Temp_Polar_Point), function Trig_Makgora_Func019A )
    // Talent
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 12 ]  then
    call SetUnitAbilityLevelSwapped( 'ACbb', gg_unit_e028_1863, 2 )
        	call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(  gg_unit_e028_1863, 'ACbb'), ABILITY_RLF_DURATION_HERO, 1, 8.0 )
        	call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(  gg_unit_e028_1863, 'ACbb'), ABILITY_RLF_DURATION_NORMAL, 1, 8.0 )
    call SetUnitOwner( gg_unit_e028_1863, GetOwningPlayer(udg_Temp_Unit), true )
    call IssueTargetOrderBJ( gg_unit_e028_1863, "bloodlust", udg_Temp_Unit )
    endif
    // Create the arena
    set bj_forLoopAIndex = 0
    set bj_forLoopAIndexEnd = 14
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_Temp_Angle = udg_Facing_Angle + ( 24.00 * I2R( GetForLoopIndexA() ) )
        set udg_Temp_Unit_Point = PolarProjectionBJ(udg_Temp_Polar_Point, 360.00, udg_Temp_Angle)
        if not IsTerrainPathable( GetLocationX(udg_Temp_Unit_Point), GetLocationY(udg_Temp_Unit_Point), PATHING_TYPE_WALKABILITY) then
        if udg_Temp_Unit == udg_yA_Fury_Warr then
        call CreateNUnitsAtLoc( 1, 'hfoo', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, ( udg_Temp_Angle + 180.00 ) )
        call PauseAddInvuln ( GetLastCreatedUnit(), udg_MakgoraA)
        else
        call CreateNUnitsAtLoc( 1, 'ogru', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, ( udg_Temp_Angle + 180.00 ) )
        call PauseAddInvuln ( GetLastCreatedUnit(), udg_MakgoraH)
        endif
        endif
        call RemoveLocation (udg_Temp_Unit_Point)
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    // Turn On Leave
    set udg_Temp_Int = i
    if udg_Temp_Int == 28 then
    call EnableTrigger( gg_trg_Makgora_Leaves_A)
    else
    call EnableTrigger( gg_trg_Makgora_Leaves_H)
    endif
    call GameTimeWait(7.4)
    set udg_Temp_Int = i
    call StopSoundBJ( gg_snd_MakGora_End, false )
    call PlaySoundAtPointBJ( gg_snd_MakGora_End, 100, udg_Blizzard[udg_Temp_Int], 50.00 )
    call GameTimeWait(0.8)
    set udg_Temp_Int = i
    if udg_Temp_Int == 28 then
    call DisableTrigger( gg_trg_Makgora_Leaves_A)
    call ForGroupBJ( udg_MakgoraA, function Trig_Makgora_Func045A )
    call GroupClear( udg_MakgoraA )
    else
    call DisableTrigger( gg_trg_Makgora_Leaves_H)
    call ForGroupBJ( udg_MakgoraH, function Trig_Makgora_Func049A )
    call GroupClear( udg_MakgoraH )
    endif
    call RemoveLocation( udg_Blizzard[udg_Temp_Int] )
endfunction

