//===========================================================================
// Trigger: E SoE
//===========================================================================
function Trig_E_SoE_Func003C takes nothing returns boolean
    if ( not ( udg_QSoE0 >= 2.00 ) ) then
        return false
    endif
    if ( not ( udg_QSoE1 >= 2.00 ) ) then
        return false
    endif
    if ( not ( udg_QSoE2 >= 1.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_E_SoE_Conditions takes nothing returns boolean
    if ( not Trig_E_SoE_Func003C() ) then
        return false
    endif
    return true
endfunction

function Trig_E_SoE_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 48
    local location udg_Temp_Unit_Point
    call DisableTrigger( GetTriggeringTrigger() )
    call DestroyEffectBJ( udg_QuestMarks[48] )
    if IsAlliancePlayer( GetLocalPlayer() ) then
    call FlashQuestDialogButtonBJ(  )
    endif
    call QuestSetCompletedBJ( udg_Quests[48], true )
    // Rewards
    set udg_XP = udg_QUEST_XP[udg_Temp_Int]
    set udg_Gold = udg_QUEST_GOLD[udg_Temp_Int]
    set udg_LVL_Req = udg_QUEST_LVL_REQ[udg_Temp_Int]
    set udg_TempString = "The Staff of Elune"
    call TriggerExecute( gg_trg_Quest_Complete_A )
    call DisableTrigger( gg_trg_U_FBP )
    call SetUnitAnimation( gg_unit_hkee_1232, "stand work" )
    call CreateTextTagUnitBJ( "TRIGSTR_5143", gg_unit_Emoo_1239, 0, 8.00, 70.00, 40.00, 90.00, 0 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
    call cleanUpText( 1.5, 1.2)
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_SoEStaff)
    call PlaySoundAtPointBJ( gg_snd_HeroMoonPriestessReady1, 100.00, udg_Temp_Unit_Point, 0 )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 1.40 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_SoEStaff)
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "Abilities\\Spells\\NightElf\\Starfall\\StarfallTarget.mdl" )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_QuestMarks[48] = GetLastCreatedEffectBJ()
    call TriggerSleepAction( 1.20 )
    call DestroyEffectBJ( udg_QuestMarks[48] )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_SoEStaff)
    call CreateItemLoc( 'I05R', udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call SetUnitAnimation( gg_unit_hkee_1232, "stand" )
    set udg_Temp_Unit_Point = null
endfunction

//===========================================================================
function InitTrig_E_SoE takes nothing returns nothing
    set gg_trg_E_SoE = CreateTrigger(  )
    call DisableTrigger( gg_trg_E_SoE )
    call TriggerRegisterVariableEvent( gg_trg_E_SoE, "udg_QSoE0", GREATER_THAN_OR_EQUAL, 2.00 )
