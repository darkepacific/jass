    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'h01U' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Meledor_Dies_Func006Func003C takes nothing returns boolean
    if ( not ( IsTriggerEnabled(gg_trg_E_AWT) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Meledor_Dies_Func006C takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_Quests[60]) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Meledor_Dies_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    call TriggerSleepAction( 120.00 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_A_Wretched_Task)
    call CreateNUnitsAtLoc( 1, 'h01U', Player(0), udg_Temp_Unit_Point, 109.65 )
    call RemoveLocation (udg_Temp_Unit_Point)
    if ( Trig_Meledor_Dies_Func006C() ) then
        call DestroyEffectBJ( udg_QuestMarks[60] )
        set udg_TempString = ""
        if ( Trig_Meledor_Dies_Func006Func003C() ) then
            if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
            set udg_TempString = udg_ExclamationMark
            endif
            call AddSpecialEffectTargetUnitBJ( "overhead", GetLastCreatedUnit(), udg_TempString )
            set udg_QuestMarks[60] = GetLastCreatedEffectBJ()
        else
            if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
            set udg_TempString = udg_QuestionMark
            endif
            call AddSpecialEffectTargetUnitBJ( "overhead", GetLastCreatedUnit(), udg_TempString )
            set udg_QuestMarks[60] = GetLastCreatedEffectBJ()
        endif
    else
    endif
    set udg_Temp_Unit_Point = null
endfunction

