    if ( not ( GetSpellAbilityId() == 'A00B' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Concussive_Shot_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    call PlaySoundOnUnitBJ( gg_snd_Shockwave, 95.00, GetSpellAbilityUnit() )
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 2.00 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A00B', udg_Temp_Unit) * 40 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Temp_Unit, 'A00B'), ABILITY_RLF_DAMAGE_HTB1, ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ), udg_RealStatCalc )
endfunction

