function Trig_All_Emotes_Actions takes nothing returns nothing
    local effect sfx
    call PlayerNumbtoHeroesNumb()
    set udg_TempString = SubStringBJ(GetEventPlayerChatString(), 2, 2)
    // dance
    if (udg_TempString == "d") then
    if ( Trig_All_Emotes_Func006C() ) then
        call SetUnitAnimation( udg_Heroes[udg_Player_Number], "Spell" )
    else
    endif
    if ( Trig_All_Emotes_Func007C() ) then
        call SetUnitAnimation( udg_Heroes[udg_Player_Number], "Stand Victory" )
    else
    endif
    if ( Trig_All_Emotes_Func008C() ) then
        call SetUnitAnimation( udg_Heroes[udg_Player_Number], ParseTags("Channel") )
    else
    endif
    if ( Trig_All_Emotes_Func009C() ) then
        call SetUnitAnimation( udg_Heroes[udg_Player_Number], "Attack Spell Slam" )
    else
    endif
    if ( Trig_All_Emotes_Func010C() ) then
        call SetUnitAnimation( udg_Heroes[udg_Player_Number], "Spell Slam" )
    else
    endif
    if ( Trig_All_Emotes_Func011C() ) then
        call SetUnitAnimation( udg_Heroes[udg_Player_Number], "Spell Throw" )
    else
    endif
    if ( Trig_All_Emotes_Func012C() ) then
        call SetUnitAnimation( udg_Heroes[udg_Player_Number], "Dissipate" )
    else
    endif
    if ( Trig_All_Emotes_Func013C() ) then
        call SetUnitAnimation( udg_Heroes[udg_Player_Number], "Attack 2" )
    else
    endif
    if ( Trig_All_Emotes_Func014C() ) then
        call SetUnitAnimation( udg_Heroes[udg_Player_Number], "Attack Slam" )
    else
    endif
    if ( Trig_All_Emotes_Func015C() ) then
        call SetUnitAnimation( udg_Heroes[udg_Player_Number], "Morph" )
    else
    endif
    if ( Trig_All_Emotes_Func016C() ) then
        call SetUnitAnimation( udg_Heroes[udg_Player_Number], "Stand Defend" )
    else
    endif
    endif
    // salt
    if (udg_TempString == "s") then
    call AddSpecialEffectTargetUnitBJ( "overhead", udg_Heroes[udg_Player_Number], "war3mapImported\\SaltOnce.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
            call CreateTextTagUnitBJ( "SALT", udg_Heroes[udg_Player_Number], 80.00, 8.00, 80, 80, 80, 0 )
            call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 160, 90 )
            call cleanUpText( 1.0, 0.8) 
    endif
    // happy
    if (udg_TempString == "h") then
    call AddSpecialEffectTargetUnitBJ( "overhead", udg_Heroes[udg_Player_Number], "war3mapImported\\SmileEmoji.mdx" )
    set sfx = GetLastCreatedEffectBJ()
    call TriggerSleepAction( 0.75 )
    call DestroyEffectBJ(sfx)
    endif
    // angry
    if (udg_TempString == "a")  then
    call AddSpecialEffectTargetUnitBJ( "overhead", udg_Heroes[udg_Player_Number], "war3mapImported\\RedSadEmoji_SND.mdx" )
    set sfx = GetLastCreatedEffectBJ()
    call TriggerSleepAction( 0.75 )
    call DestroyEffectBJ(sfx)
    endif
    // love
    if (udg_TempString == "l") then
    call AddSpecialEffectTargetUnitBJ( "overhead", udg_Heroes[udg_Player_Number], "war3mapImported\\Fallinlove.mdx" )
    set sfx = GetLastCreatedEffectBJ()
    call TriggerSleepAction( 0.40 )
    call DestroyEffectBJ(sfx)
    endif
    // chicken
    if (udg_TempString == "c") then
    call AddSpecialEffectTargetUnitBJ( "overhead", udg_Heroes[udg_Player_Number], "units\\critters\\EasterChicken\\EasterChicken.mdl" )
    set sfx = GetLastCreatedEffectBJ()
    call StopSoundBJ( gg_snd_ChickenWhat1, false )
    call PlaySoundOnUnitBJ( gg_snd_ChickenWhat1, 95.00, udg_Temp_Unit )
    call TriggerSleepAction( 0.40 )
    call DestroyEffectBJ(sfx)
    endif
    // end
    set sfx = null
endfunction

