    if ( not ( GetUnitAbilityLevelSwapped('A09D', udg_Temp_Unit) > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Crit_Check_Func026C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0H0', udg_Temp_Unit) > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Crit_Check_Func029C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 100) <= udg_HeroStatCalc ) ) then
        return false
    endif
    return true
endfunction

function Trig_Crit_Check_Actions takes nothing returns nothing
    local boolean skipCalculation = false
    set udg_HeroStatCalc = 0
    // Obliterate
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 13 ]  then
    if udg_Temp_Unit == udg_yA_Frost_DK and udg_DmgTaken_FrostDK_A > 799 then
    set udg_DmgTaken_FrostDK_A = 0.00
    set udg_HeroStatCalc = 100
    set skipCalculation = true
    call CreateTextTagUnitBJ( "TRIGSTR_6831", udg_Temp_Unit, 80.00, 9.00, 40.00, 40.00, 100.00, 0 )
    call ObliterateEffect()
    elseif udg_Temp_Unit == udg_yH_Frost_DK and udg_DmgTaken_FrostDK_H > 799 then
    set udg_DmgTaken_FrostDK_H = 0.00
    set udg_HeroStatCalc = 100
    set skipCalculation = true
    call CreateTextTagUnitBJ( "TRIGSTR_7786", udg_Temp_Unit, 80.00, 9.00, 50.00, 50.00, 100.00, 0 )
    call ObliterateEffect()
    set udg_RealStatCalc = ( 1.50 * udg_RealStatCalc )
    endif
    endif
    // Normal Crit Calc
    if not skipCalculation then
    set bj_forLoopBIndex = 1
    set bj_forLoopBIndexEnd = 6
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        set udg_Temp_Item = UnitItemInSlotBJ(udg_Temp_Unit, GetForLoopIndexB())
        if ( Trig_Crit_Check_Func022Func002C() ) then
            set udg_HeroStatCalc = ( udg_HeroStatCalc + 10 )
        else
            if ( Trig_Crit_Check_Func022Func002Func001C() ) then
                set udg_HeroStatCalc = ( udg_HeroStatCalc + 15 )
            else
                if ( Trig_Crit_Check_Func022Func002Func001Func003C() ) then
                    set udg_HeroStatCalc = ( udg_HeroStatCalc + 20 )
                else
                    if ( Trig_Crit_Check_Func022Func002Func001Func003Func001C() ) then
                        set udg_HeroStatCalc = ( udg_HeroStatCalc + 25 )
                    else
                    endif
                endif
            endif
        endif
        set bj_forLoopBIndex = bj_forLoopBIndex + 1
    endloop
    if ( Trig_Crit_Check_Func023C() ) then
        set udg_HeroStatCalc = ( udg_HeroStatCalc + ( 10 + ( 10 * GetUnitAbilityLevelSwapped('A0DM', udg_Temp_Unit) ) ) )
    else
    endif
    if ( Trig_Crit_Check_Func024C() ) then
        set udg_HeroStatCalc = ( udg_HeroStatCalc + ( 4 + ( 2 * GetUnitAbilityLevelSwapped('A04N', udg_Temp_Unit) ) ) )
    else
    endif
    if ( Trig_Crit_Check_Func025C() ) then
        set udg_HeroStatCalc = ( udg_HeroStatCalc + 30 )
    else
    endif
    if ( Trig_Crit_Check_Func026C() ) then
        set udg_HeroStatCalc = ( udg_HeroStatCalc + 40 )
    else
    endif
    endif
    call Debug( "Crit Chance: " + I2S( udg_HeroStatCalc ) )
    if ( Trig_Crit_Check_Func029C() ) then
        if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 9 ] then 
        if udg_Temp_Unit == udg_yA_Ass_Rogue or udg_Temp_Unit == udg_yH_Ass_Rogue  then
        set udg_RealStatCalc = ( 1.50 * udg_RealStatCalc )
        endif
        endif
        if udg_Temp_Unit == udg_yA_Dark_Ranger or udg_Temp_Unit == udg_yH_Dark_Ranger  then
        set udg_RealStatCalc = ( 1.50 * udg_RealStatCalc )
        else
        set udg_RealStatCalc = ( 2.00 * udg_RealStatCalc )
        endif
        call CreateTextTagUnitBJ( ( I2S(R2I(udg_RealStatCalc)) + "Crit!" ), udg_Temp_Unit, 10.00, 10.00, 100, 0.00, 0.00, 0 )
        call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64, 0.00 )
        call cleanUpText(1.2, 0.7)
        call ShowTextTagForceBJ( true, GetLastCreatedTextTag(), GetPlayersAll() )
    else
    endif
endfunction

