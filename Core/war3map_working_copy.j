function DuelEnds takes nothing returns nothing
    if udg_IsThereADuel then
	call ResetPlayerForces( GetOwningPlayer(GetTriggerUnit()) )
        call BJDebugMsg("Duel Ended")
        set udg_IsThereADuel = false
	call TriggerExecute(gg_trg_Duel_End)
    endif
endfunction

