//===========================================================================
// Trigger: L ALTJ
//===========================================================================
function Trig_L_ALTJ_Func006Func001C takes nothing returns boolean
    if ( not ( GetItemTypeId(udg_P_Items[( udg_Bag_Num + udg_Bag_Iterator )]) == udg_ItemTypeCheck ) ) then
        return false
    endif
    return true
endfunction

function Trig_L_ALTJ_Func015C takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_Quests[51]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_L_ALTJ_Actions takes nothing returns nothing
    local boolean hasItem
    set hasItem = false
                       if IsAllianceHero( GetTriggerUnit() ) then
    call SetBagNumber( GetOwningPlayer(GetTriggerUnit()) )
    set udg_ItemTypeCheck = 'I05T'
    set udg_Bag_Iterator = 1
    loop
        exitwhen udg_Bag_Iterator > udg_BAG_LOOP_MAX
        if ( Trig_L_ALTJ_Func006Func001C() ) then
            set hasItem = true
        else
        endif
        set udg_Bag_Iterator = udg_Bag_Iterator + 1
    endloop
    if hasItem == false then
    call CreateTextTagUnitBJ( "TRIGSTR_5206", gg_unit_n00N_1213, 0, 8.00, 80.00, 0.00, 0.00, 0 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
    call cleanUpText( 1.5, 1.25 )
    call UnitAddItemByIdSwapped( 'I05T', GetTriggerUnit() )
    call DisableTrigger( GetTriggeringTrigger() )
    call TriggerSleepAction( udg_ITEM_LOSS_TIMEOUT )
    if ( Trig_L_ALTJ_Func015C() ) then
        call EnableTrigger( GetTriggeringTrigger() )
    else
    endif
    endif
                       endif
endfunction

