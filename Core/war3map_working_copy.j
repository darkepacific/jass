    call QuestSetCompletedBJ( udg_Quests[udg_Temp_Int], false )
    call CreateQuestItemBJ( udg_Quests[udg_Temp_Int], "TRIGSTR_9133" )
    set udg_QuestReqs[udg_Temp_Int] = GetLastCreatedQuestItemBJ()
    call DisableTrigger( GetTriggeringTrigger() )
    call EnableTrigger(gg_trg_U_TSO_H)
    call EnableTrigger(gg_trg_E_TSO_H)
                       endif
    set udg_Temp_Unit_Point = null
endfunction

