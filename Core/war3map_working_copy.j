    else
        call SetUnitFlyHeightBJ( udg_Charge_Extra, 0.00, 0.00 )
        call CreateNUnitsAtLoc( 1, 'e01I', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Temp_Polar_Point, bj_UNIT_FACING )
