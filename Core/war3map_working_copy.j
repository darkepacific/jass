            set udg_QuestTimerWindows[udg_Temp_Int] = GetLastCreatedTimerDialogBJ()
            call TimerDialogDisplayBJ( false, udg_QuestTimerWindows[udg_Temp_Int] )
            call ForForce( udg_HordePlayers, function Trig_U_TDC_Func004Func001Func015A )
            call EnableTrigger( gg_trg_F_TDC)
        else
            call ErrorMessage("Quest already in progress.", GetTriggerPlayer() )
            call IssueImmediateOrderBJ( GetTriggerUnit(), "stop" )
        endif
    else
        call ErrorMessage("Must be in Bloodgulch to use this item.", GetTriggerPlayer() )
        call IssueImmediateOrderBJ( GetTriggerUnit(), "stop" )
    endif
                       endif
    set udg_Temp_Unit_Point = null
endfunction

