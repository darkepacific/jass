//===========================================================================
// Trigger: Reliquary Damage
//===========================================================================
function Trig_Reliquary_Damage_Func009C takes nothing returns boolean
    if ( not ( udg_Temp_Bool2 == true ) ) then
        return false
    endif
    if ( not ( udg_Temp_Bool3 == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Reliquary_Damage_Func028Func003Func005C takes nothing returns boolean
    if ( not ( udg_Temp_Bool3 == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Reliquary_Damage_Func028Func003Func006C takes nothing returns boolean
    if ( not ( udg_Temp_Bool2 == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Reliquary_Damage_Func028Func003Func007C takes nothing returns boolean
    if ( not ( udg_ReliquaryOfSoulsCount < 6 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Reliquary_Damage_Func028Func003C takes nothing returns boolean
    if ( not ( udg_ReliquaryOfSoulsCount < 10 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Reliquary_Damage_Func028A takes nothing returns nothing
    local integer udg_Temp_Int
    local unit u
    if ( Trig_Reliquary_Damage_Func028Func003C() ) then
        set u = GetEnumUnit()
        set udg_Temp_Unit = udg_Heroes[udg_Player_Number]
        if IsUnitTargetableEnemy( u, udg_Temp_Unit) then
        call UnitDamageTargetBJ( udg_Temp_Unit, u, udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        if ( Trig_Reliquary_Damage_Func028Func003Func005C() ) then
            if udg_Temp_Unit != gg_unit_Usyl_0179 then
            call HasFirelords( u )
            endif
        else
        endif
        if ( Trig_Reliquary_Damage_Func028Func003Func006C() ) then
            call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "Abilities\\Weapons\\ZigguratMissile\\ZigguratMissile.mdl" )
            call DestroyEffectBJ( GetLastCreatedEffectBJ() )
            call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "war3mapImported\\Affliction040_Purple.mdx" )
            call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        else
        endif
        if ( Trig_Reliquary_Damage_Func028Func003Func007C() ) then
            if ( udg_Temp_Unit == udg_yA_Dark_Ranger) then
            set udg_Temp_Int = ( udg_ReliquaryOfSoulsCount + 60 )
            elseif ( udg_Temp_Unit == udg_yH_Dark_Ranger) then
            set udg_Temp_Int = ( udg_ReliquaryOfSoulsCount + 70 )
            else
            set udg_Temp_Int = ( udg_ReliquaryOfSoulsCount + 80 )
            endif
            if udg_LightningEffects[udg_Temp_Int] == null then
            set bj_lastCreatedLightning = AddLightningEx("DRAL", true, GetUnitX(udg_Temp_Unit), GetUnitY(udg_Temp_Unit), BlzGetUnitZ(udg_Temp_Unit), GetUnitX(u), GetUnitY(u), BlzGetUnitZ(u))
            set udg_LightningEffects[udg_Temp_Int] = GetLastCreatedLightningBJ()
            else
            call MoveLightningEx( udg_LightningEffects[udg_Temp_Int], true, GetUnitX(udg_Temp_Unit), GetUnitY(udg_Temp_Unit), BlzGetUnitZ(udg_Temp_Unit), GetUnitX(u), GetUnitY(u), BlzGetUnitZ(u))
            endif
        else
        endif
        set udg_ReliquaryOfSoulsCount = ( udg_ReliquaryOfSoulsCount + 1 )
        endif
    else
    endif
    set u = null
endfunction

function Trig_Reliquary_Damage_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    local integer udg_Temp_Int
    set udg_Temp_Bool2 = ModuloInteger(GetTriggerExecCount(GetTriggeringTrigger()), 2) == 0 
    set udg_Temp_Bool3 = ModuloInteger(GetTriggerExecCount(GetTriggeringTrigger()), 3) == 0 
    if IsSilenced(udg_Temp_Unit) == true then
    set udg_Temp_Bool2 = true
    set udg_Temp_Bool3 = true
    endif
    if ( Trig_Reliquary_Damage_Func009C() ) then
        set udg_Temp_Int = 60
        loop
            exitwhen udg_Temp_Int > 89
            call DestroyLightningBJ( udg_LightningEffects[udg_Temp_Int] )
            set udg_LightningEffects[ udg_Temp_Int ] = null
            set udg_Temp_Int = udg_Temp_Int + 1
        endloop
    else
    endif
    // StatCalc
    if udg_Temp_Unit != gg_unit_Usyl_0179 then
    call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
    set udg_HeroStatCalc = GetUnitAbilityLevelSwapped('A0GC', udg_Temp_Unit)
    set udg_RealStatCalc = ( 0.00 + ( 0.00 + ( 0.75 * I2R(GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, true)) ) ) )
    set udg_RealStatCalc = ( udg_RealStatCalc + ( 0.00 + ( 0.75 * I2R(GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true)) ) ) )
    set udg_RealStatCalc = ( ( 25.00 * I2R(udg_HeroStatCalc) ) + udg_RealStatCalc )
    set udg_RealStatCalc = ( 0.20 * udg_RealStatCalc )
    else
    set udg_RealStatCalc = 36.00
    endif
    call Debug("Banshee form RSC: " + R2S(udg_RealStatCalc) )
    // Don't Execute any Group Logic if Silenced or Stunned
    if IsSilenced(udg_Temp_Unit) == false then
    // Group Logic
    set udg_ReliquaryOfSoulsCount = 0
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(260.00, udg_Temp_Unit_Point), function Trig_Reliquary_Damage_Func028A )
    call RemoveLocation (udg_Temp_Unit_Point)
    // End Group Logic
    endif
    set udg_Temp_Unit_Point = null
endfunction

//===========================================================================
function InitTrig_Reliquary_Damage takes nothing returns nothing
    set gg_trg_Reliquary_Damage = CreateTrigger(  )
    call DisableTrigger( gg_trg_Reliquary_Damage )
    call TriggerAddAction( gg_trg_Reliquary_Damage, function Trig_Reliquary_Damage_Actions )
endfunction

//===========================================================================
// Trigger: Dark Ranger Dies
//===========================================================================
function Trig_Dark_Ranger_Dies_Actions takes nothing returns nothing
    local integer udg_Temp_Int
    local unit udg_Temp_Unit = GetTriggerUnit()
    if udg_Temp_Unit == udg_yA_Dark_Ranger or udg_Temp_Unit == udg_yH_Dark_Ranger or  udg_Temp_Unit == gg_unit_Usyl_0179 then
    call SetUnitVertexColorBJ( GetTriggerUnit(), 100.00, 100.00, 100, 0.00 )
    if ( udg_Temp_Unit == udg_yA_Dark_Ranger) then
    call StopSoundBJ( gg_snd_Sylvanas_BansheeScreamA, false )
    call DisableTrigger( gg_trg_Reliquary_Tick_A)
    elseif ( udg_Temp_Unit  == udg_yH_Dark_Ranger) then
    call StopSoundBJ( gg_snd_Sylvanas_BansheeScreamH, false )
    call DisableTrigger( gg_trg_Reliquary_Tick_H)
    else
    call StopSoundBJ( gg_snd_Sylvanas_BansheeScream, false )
    call DisableTrigger( gg_trg_Reliquary_Tick_N)
    endif
    set udg_Temp_Int = 60
    loop
        exitwhen udg_Temp_Int > 89
        call DestroyLightningBJ( udg_LightningEffects[udg_Temp_Int] )
        set udg_LightningEffects[ udg_Temp_Int ] = null
        set udg_Temp_Int = udg_Temp_Int + 1
    endloop
    call SetPlayerAbilityAvailableBJ( true, 'A04V', GetOwningPlayer(GetTriggerUnit()) )
    if udg_Temp_Unit != gg_unit_Usyl_0179 then
    call SetPlayerAbilityAvailableBJ( true, 'A04W', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A05B', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A04X', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'ACch', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A0DH', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'AIfs', GetOwningPlayer(GetTriggerUnit()) )
    endif
    // IF died while BANSHEE set boolean to check for TALENT on revive
    if GetUnitTypeId(udg_Temp_Unit) == 'E04M' then
    if ( udg_Temp_Unit == udg_yA_Dark_Ranger) then
    set udg_WasBansheeA = true
    elseif ( udg_Temp_Unit  == udg_yH_Dark_Ranger) then
    set udg_WasBansheeH = true
    endif
    endif
    endif
    set udg_Temp_Unit = null
endfunction

//===========================================================================
function InitTrig_Dark_Ranger_Dies takes nothing returns nothing
    set gg_trg_Dark_Ranger_Dies = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Dark_Ranger_Dies, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddAction( gg_trg_Dark_Ranger_Dies, function Trig_Dark_Ranger_Dies_Actions )
endfunction

//===========================================================================
// Trigger: Counterspell
//
// Make this ability check if MS is less than 270, if it is deal crit damage
//===========================================================================
function Trig_Counterspell_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A04I' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Counterspell_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - 0 ))
    set udg_RealStatCalc = ( 2.50 * udg_RealStatCalc )
    call UnitDamageTargetBJ( GetTriggerUnit(), GetSpellTargetUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call AddSpecialEffectTargetUnitBJ( "origin", GetSpellTargetUnit(), "Abilities\\Weapons\\Bolt\\BoltImpact.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
endfunction

//===========================================================================
function InitTrig_Counterspell takes nothing returns nothing
    set gg_trg_Counterspell = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Counterspell, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Counterspell, Condition( function Trig_Counterspell_Conditions ) )
    call TriggerAddAction( gg_trg_Counterspell, function Trig_Counterspell_Actions )
endfunction

//===========================================================================
// Trigger: Ice Block
//
//  call PauseUnitBJ( true, GetTriggerUnit() )
//===========================================================================
function Trig_Ice_Block_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A08G' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Ice_Block_Actions takes nothing returns nothing
    local effect eff
    local unit u
    set u = GetTriggerUnit()
    call SetUnitVertexColorBJ( GetTriggerUnit(), 60.00, 60.00, 100.00, 0 )
    call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "Abilities\\Spells\\Undead\\FreezingBreath\\FreezingBreathTargetArt.mdl" )
    set eff = GetLastCreatedEffectBJ()
    call IssueImmediateOrderBJ( GetTriggerUnit(), "stop" )
    call SetUnitInvulnerable( u, true)
     call PauseUnit( u, true )
    call GameTimeWait(2.5)
     call PauseUnit( u, false)
    call SetUnitInvulnerable( u, false)
    call IssueImmediateOrderBJ( GetTriggerUnit(), "stop" )
    call SetUnitVertexColorBJ( GetTriggerUnit(), 100, 100, 100, 0 )
    set udg_Temp_Unit_CD = u
    call TriggerExecute( gg_trg_Cooldown_Maths) 
     call BlzStartUnitAbilityCooldown( udg_Temp_Unit_CD, 'A08G', ( udg_CooldownRemaining * BlzGetUnitAbilityCooldownRemaining( udg_Temp_Unit_CD, 'A08G') ) )
    call DestroyEffectBJ( eff )
    set eff = null
    set u = null
endfunction

//===========================================================================
function InitTrig_Ice_Block takes nothing returns nothing
    set gg_trg_Ice_Block = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Ice_Block, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Ice_Block, Condition( function Trig_Ice_Block_Conditions ) )
    call TriggerAddAction( gg_trg_Ice_Block, function Trig_Ice_Block_Actions )
endfunction

//===========================================================================
// Trigger: Clear Casting
//===========================================================================
function Trig_Clear_Casting_Conditions takes nothing returns boolean
    if not ((GetUnitTypeId(GetTriggerUnit()) == 'H02Q') or (GetUnitTypeId(GetTriggerUnit()) == 'H02T')) then
        return false
    endif
    
    //Arcane Missiles
    if ( GetSpellAbilityId() == 'A08A' ) then
        return true
    endif
    //Arcane Explosion
    if ( GetSpellAbilityId() == 'A00G' ) then
        return true
    endif

    //Advance Blink
    if ( GetSpellAbilityId() == 'A08B' ) then
        return true
    endif
    //Polymorph
    if ( GetSpellAbilityId() == 'A00F' ) then
        return true
    endif

    //Arcane Intellect
    if ( GetSpellAbilityId() == 'A00H' ) then
        return true
    endif
    //Slow
    if ( GetSpellAbilityId() == 'Aslo' ) then
        return true
    endif
    //Counter Spell
    if ( GetSpellAbilityId() == 'A04I' ) then
        return true
    endif

    //Teleport
    if ( GetSpellAbilityId() == 'A08D' ) then
        return true
    endif
    //Alter Time
    if ( GetSpellAbilityId() == 'A0DF' ) then
        return true
    endif
    //Ice Block
    if ( GetSpellAbilityId() == 'A08G' ) then
        return true
    endif

    if ( GetSpellAbilityId() == 'A02D' ) then
        return false
    endif
    if ( GetSpellAbilityId() == 'A02U' ) then
        return false
    endif
    return false
endfunction

function Trig_Clear_Casting_Actions takes nothing returns nothing
    local unit caster = GetTriggerUnit()
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(caster)) * udg_NUM_OF_TC + 2 ]  then

        if GetRandomInt(1,5)  > 4 then
            // set udg_TalentChoices[ GetPlayerId(GetOwningPlayer(caster)) * udg_NUM_OF_TC + 3 ] = true

            call AddSpecialEffectTargetUnitBJ( "overhead", caster, "Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl")
            call DestroyEffectBJ( GetLastCreatedEffectBJ() )
            call AddSpecialEffectTargetUnitBJ( "origin", caster, "Abilities\\Spells\\Items\\AIre\\AIreTarget.mdl")
            call DestroyEffectBJ( GetLastCreatedEffectBJ() )

            set udg_HeroStatCalc = BlzGetAbilityIntegerLevelField(BlzGetUnitAbility(caster, GetSpellAbilityId()), ABILITY_ILF_MANA_COST, GetUnitAbilityLevel(caster, GetSpellAbilityId()) - 1)
            call SetUnitManaBJ(caster,  GetUnitStateSwap(UNIT_STATE_MANA, caster) + I2R(udg_HeroStatCalc ) ) 

            call CreateTextTagUnitBJ( "Clear Casting", caster, 0.00, 10.00, 20.00, 60.00, 100.00, 0 )
            call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64, 90.00 )
            call SetTextTagLifespan( GetLastCreatedTextTag(), 1.25 )
            call cleanUpText( 1.25, 0.75)
        endif
    endif
    set caster = null
endfunction


