    set udg_Blizzard[3] = GetSpellTargetLoc()
    call EnableTrigger( gg_trg_Rain_of_Fire_Tick_OR)
    elseif (  GetSpellAbilityUnit() == udg_yA_Destro_Warlock ) then
    set udg_Blizzard[31] = GetSpellTargetLoc()
    call EnableTrigger( gg_trg_Rain_of_Fire_Tick_GN)
