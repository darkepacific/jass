//===========================================================================
// Trigger: Cheat Death Timer
//===========================================================================
function Trig_Cheat_Death_Timer_Actions takes nothing returns nothing
    call Debug( "Cheat Death Expired")
    set bj_forLoopBIndex = 0
    set bj_forLoopBIndexEnd = 7
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        if GetExpiredTimer() == udg_CheatDeath[ bj_forLoopBIndex ] then
        if udg_CheatDeathBool[ bj_forLoopBIndex ] == true then
        set udg_CheatDeathBool[ bj_forLoopBIndex ] = false
        call StartTimerBJ( udg_CheatDeath[GetForLoopIndexB()], false, 60.00 )
        endif
        exitwhen true
        endif
        set bj_forLoopBIndex = bj_forLoopBIndex + 1
    endloop
endfunction

//===========================================================================
function InitTrig_Cheat_Death_Timer takes nothing returns nothing
    set gg_trg_Cheat_Death_Timer = CreateTrigger(  )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_Cheat_Death_Timer, udg_CheatDeath[0] )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_Cheat_Death_Timer, udg_CheatDeath[1] )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_Cheat_Death_Timer, udg_CheatDeath[2] )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_Cheat_Death_Timer, udg_CheatDeath[3] )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_Cheat_Death_Timer, udg_CheatDeath[4] )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_Cheat_Death_Timer, udg_CheatDeath[5] )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_Cheat_Death_Timer, udg_CheatDeath[6] )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_Cheat_Death_Timer, udg_CheatDeath[7] )
    call TriggerAddAction( gg_trg_Cheat_Death_Timer, function Trig_Cheat_Death_Timer_Actions )
endfunction

//===========================================================================
// Trigger: Vanish
//===========================================================================
function Trig_Vanish_Func001C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A04U' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A00V' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Vanish_Conditions takes nothing returns boolean
    if ( not Trig_Vanish_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Vanish_Func023C takes nothing returns boolean
    if ( not ( udg_BEREviscerate == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Vanish_Func034C takes nothing returns boolean
    if ( not ( udg_NEREviscerate == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Vanish_Actions takes nothing returns nothing
    if ( GetSpellAbilityUnit() == udg_yH_Ass_Rogue ) then
    call UnitAddAbilityBJ( 'A04S', GetTriggerUnit() )
    call SetPlayerAbilityAvailableBJ( false, 'A0AN', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A04S', GetOwningPlayer(GetTriggerUnit()) )
    call EnableTrigger( gg_trg_Sap_Periodic_Check)
    call EnableTrigger( gg_trg_H_Sap_Ability_Cast)
    endif
    if ( GetSpellAbilityUnit() == udg_yA_Ass_Rogue ) then
    call UnitAddAbilityBJ( 'A04S', GetTriggerUnit() )
    call SetPlayerAbilityAvailableBJ( false, 'A0AN', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A04S', GetOwningPlayer(GetTriggerUnit()) )
    call EnableTrigger( gg_trg_Sap_Periodic_Check)
    call EnableTrigger( gg_trg_A_Sap_Ability_Cast)
    endif
    if ( GetSpellAbilityUnit() == udg_yH_Subtle_Rogue ) then
    call UnitAddAbilityBJ( 'A04S', GetTriggerUnit() )
    call SetPlayerAbilityAvailableBJ( true, 'A04S', GetOwningPlayer(GetTriggerUnit()) )
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(GetTriggerUnit())) * udg_NUM_OF_TC + 3 ] then 
    	call BlzSetUnitAbilityManaCost( GetTriggerUnit() , 'A04S' , 0, 0)
    endif
    call SetPlayerAbilityAvailableBJ( false, 'AEfk', GetOwningPlayer(GetTriggerUnit()) )
    if ( Trig_Vanish_Func023C() ) then
        call UnitAddAbilityBJ( 'A0EU', GetTriggerUnit() )
        call SetPlayerAbilityAvailableBJ( true, 'A0EU', GetOwningPlayer(GetTriggerUnit()) )
        if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(GetTriggerUnit())) * udg_NUM_OF_TC + 3 ] then 
        	call BlzSetUnitAbilityManaCost( GetTriggerUnit() , 'A0EU' , 0, 80)
        endif
        call SetPlayerAbilityAvailableBJ( false, 'A00W', GetOwningPlayer(GetTriggerUnit()) )
    else
    endif
    call EnableTrigger( gg_trg_Sap_Periodic_Check)
    call EnableTrigger( gg_trg_Hs_Sap_Ability_Cast)
    endif
    if ( GetSpellAbilityUnit() == udg_yA_Subtle_Rogue ) then
    call UnitAddAbilityBJ( 'A04S', GetTriggerUnit() )
    call SetPlayerAbilityAvailableBJ( true, 'A04S', GetOwningPlayer(GetTriggerUnit()) )
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(GetTriggerUnit())) * udg_NUM_OF_TC + 3 ] then 
    	call BlzSetUnitAbilityManaCost( GetTriggerUnit() , 'A04S' , 0, 0)
    endif
    call SetPlayerAbilityAvailableBJ( false, 'AEfk', GetOwningPlayer(GetTriggerUnit()) )
    if ( Trig_Vanish_Func034C() ) then
        call UnitAddAbilityBJ( 'A0EU', GetTriggerUnit() )
        call SetPlayerAbilityAvailableBJ( true, 'A0EU', GetOwningPlayer(GetTriggerUnit()) )
        if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(GetTriggerUnit())) * udg_NUM_OF_TC + 3 ] then 
        	call BlzSetUnitAbilityManaCost( GetTriggerUnit() , 'A0EU' , 0, 80)
        endif
        call SetPlayerAbilityAvailableBJ( false, 'A00W', GetOwningPlayer(GetTriggerUnit()) )
    else
    endif
    call EnableTrigger( gg_trg_Sap_Periodic_Check)
    call EnableTrigger( gg_trg_As_Sap_Ability_Cast)
    endif
endfunction

//===========================================================================
function InitTrig_Vanish takes nothing returns nothing
    set gg_trg_Vanish = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Vanish, EVENT_PLAYER_UNIT_SPELL_ENDCAST )
    call TriggerAddCondition( gg_trg_Vanish, Condition( function Trig_Vanish_Conditions ) )
    call TriggerAddAction( gg_trg_Vanish, function Trig_Vanish_Actions )
endfunction

