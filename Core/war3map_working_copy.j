//===========================================================================
// Trigger: CAMERA ZOOM
//===========================================================================
function gg_trg_CameraZoom_Conditions takes nothing returns boolean
    local real r
    local integer p
    local string s
    if GetLocalPlayer() == GetTriggerPlayer() then

	set s = SubString(GetEventPlayerChatString(), 1, 5) 
	if s == "zoom" then
		set p = 6
	elseif s == "cam " then
		set p = 5
	elseif s == "came" then
		set p = 8
	endif	

        set s = SubString(GetEventPlayerChatString(), p, StringLength(GetEventPlayerChatString()))
        set r = S2R(s)
 
        if s == "default" then
            set r = 1650
        endif

        if s == "d" then
            set r = 1650
        endif
 
        if s == "med" then
            set r = 2075
        endif

        if s == "m" then
            set r = 2075
        endif
 
        if s == "high" then
      	    set r = 2500
        endif

        if s == "h" then
      	    set r = 2500
        endif

        if s == "max" then
            set r = 3000
        endif
	
	if r > 3000 then
	    set r = 3000
	endif

	if r < 1650 then
	    set r = 1650
	endif
	
	if GetPlayerId(GetTriggerPlayer()) == 5 then
		set udg_Z_Camera[0] = r
	endif
	if GetPlayerId(GetTriggerPlayer()) == 4 then
		set udg_Z_Camera[1] = r
	endif
	if GetPlayerId(GetTriggerPlayer()) == 6 then
		set udg_Z_Camera[2] = r
	endif
	if GetPlayerId(GetTriggerPlayer()) == 10 then
		set udg_Z_Camera[3] = r
	endif

	if GetPlayerId(GetTriggerPlayer()) == 2 then
		set udg_Z_Camera[4] = r
	endif
	if GetPlayerId(GetTriggerPlayer()) == 7 then
		set udg_Z_Camera[5] = r
	endif
	if GetPlayerId(GetTriggerPlayer()) == 8 then
		set udg_Z_Camera[6] = r
	endif
	if GetPlayerId(GetTriggerPlayer()) == 9 then
		set udg_Z_Camera[7] = r
	endif

 
        call SetCameraField(CAMERA_FIELD_TARGET_DISTANCE, r, 0.00)
        call SetCameraField(CAMERA_FIELD_FARZ, 5000.00, 0)
    endif
    return false
endfunction
 
//===========================================================================
function InitTrig_CAMERA_ZOOM takes nothing returns nothing
    local trigger trig = CreateTrigger()
    local integer i = 0
    loop
        exitwhen i == bj_MAX_PLAYERS
        call TriggerRegisterPlayerChatEvent(trig, Player(i), "-zoom ", false)
	call TriggerRegisterPlayerChatEvent(trig, Player(i), "-cam ", false)
	call TriggerRegisterPlayerChatEvent(trig, Player(i), "-camera ", false)
        set i = i + 1
    endloop
    call TriggerAddCondition(trig, Condition(function gg_trg_CameraZoom_Conditions))
 
    //call SetTerrainFogExBJ( 0, 10000000.00, 1000000.00, 0.5, 100, 100, 100 )
endfunction
