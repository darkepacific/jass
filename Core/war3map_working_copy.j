//===========================================================================
function Trig_C_DW_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    local unit Gordo
                       if IsHordeHero( GetTriggerUnit() ) then
    call DisableTrigger( GetTriggeringTrigger() )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_GordoSpawn)
    call CreateNUnitsAtLoc( 1, 'uabo', Player(3), udg_Temp_Unit_Point, bj_UNIT_FACING )
    call RemoveLocation (udg_Temp_Unit_Point)
    set Gordo = GetLastCreatedUnit()
        call SetUnitMoveSpeed( Gordo, 335.00 )
      call BlzSetUnitStringFieldBJ( Gordo, UNIT_SF_NAME, "GORDO" )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Gathering_Doomweed)
        call IssuePointOrderLocBJ( Gordo, "move", udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 1.00 )
    call CreateTextTagUnitBJ( "TRIGSTR_8039", gg_unit_u02N_0903, 0, 8.00, 100.00, 85.00, 50.00, 0.00 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
    call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
    call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 1.25 )
    call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 0.85 )
     call PlaySoundOnUnitBJ( gg_snd_AbominationYes4, 100, Gordo )
    call TriggerSleepAction( 0.55 )
    call PlaySoundOnUnitBJ( gg_snd_NecromancerDeath, 100, gg_unit_u02N_0903 )
    call TriggerSleepAction( 0.55 )
    call StopSoundBJ( GetLastPlayedSound(), false )
    call CreateTextTagUnitBJ( "TRIGSTR_8040", gg_unit_u02N_0903, 0, 8.00, 100.00, 85.00, 50.00, 0 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
    call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
    call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 1.25 )
    call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 0.85 )
    call TriggerSleepAction( 0.62 )
        call CreateTextTagUnitBJ( "BLEGGGHH!", Gordo, 0, 10.00, 100.00, 75.00, 50.00, 0 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
    call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
    call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 1.25 )
    call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 0.85 )
        call PlaySoundOnUnitBJ( gg_snd_AbominationYesAttack2, 100, Gordo )
    call EnableTrigger( gg_trg_S_DW )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_DoomWeed2)
    call IssuePointOrderLocBJ( Gordo, "move", udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_TempString = ""
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    set udg_TempString = udg_ExclamationMark
    endif
    call AddSpecialEffectTargetUnitBJ( "overhead", gg_unit_u02N_0903, udg_TempString )
    set udg_QuestMarks[75] = GetLastCreatedEffectBJ()
    call TriggerSleepAction( 8.00 )
      call RemoveUnit( Gordo )
                       endif
    set Gordo = null
    set udg_Temp_Unit_Point = null
endfunction

