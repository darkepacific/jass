//===========================================================================
// Trigger: Resto Sham Death
//===========================================================================
function Trig_Resto_Sham_Death_Actions takes nothing returns nothing
    call TriggerSleepAction( 0.90 )
    call SetPlayerAbilityAvailableBJ( true, 'A09S', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'AOcl', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A0AD', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A03C', GetOwningPlayer(GetTriggerUnit()) )
    if ( GetTriggerUnit() == udg_yA_Resto_Sham) then
    call DisableTrigger( gg_trg_Ghost_Wolf_Unmorph_Dwarf )
    call EnableTrigger( gg_trg_Ghost_Wolf_Cast_Dwarf )
    elseif ( GetTriggerUnit() == udg_yH_Resto_Sham) then
    call DisableTrigger( gg_trg_Ghost_Wolf_Unmorph_Troll )
    call EnableTrigger( gg_trg_Ghost_Wolf_Cast_Troll )
    endif
endfunction

