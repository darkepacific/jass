//===========================================================================
// Trigger: S Party Favors
//
// Need to change this to team wide display.
//===========================================================================
function Trig_S_Party_Favors_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
                       if IsHordeHero( GetTriggerUnit() ) then
    set udg_TempString = "Party Favors"
    set udg_TempString_Quest = "Find and return the Stolen Fireworks"
    call TriggerExecute( gg_trg_Quest_Start_H )
    call DisableTrigger( GetTriggeringTrigger() )
    call DestroyEffectBJ( udg_QuestMarks[110] )
    set udg_TempString = ""
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    set udg_TempString = udg_QuestionMark
    call QuestSetEnabledBJ( true, udg_Quests[110] )
    call FlashQuestDialogButtonBJ(  )
    endif
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Party_Favors)
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, udg_TempString )
    call BlzSetSpecialEffectZ(GetLastCreatedEffectBJ(), BlzGetLocalSpecialEffectZ(GetLastCreatedEffectBJ()) + 160)
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_QuestMarks[110] = GetLastCreatedEffectBJ()
    call QuestSetCompletedBJ( udg_Quests[110], false )
    call QuestSetDiscoveredBJ( udg_Quests[110], true )
    call CreateQuestItemBJ( udg_Quests[110], "TRIGSTR_9551" )
    set udg_QuestReqs[110] = GetLastCreatedQuestItemBJ()
    call QuestItemSetDescriptionBJ( udg_QuestReqs[110], ( "Return 6 Stolen Fireworks -" + ( I2S(R2I(udg_QuestPartyFavors)) + "/6" ) ) )
    // Icon
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Z_Eversong_Murlocs_EW)
    call CampaignMinimapIconLocBJ( udg_Temp_Unit_Point, bj_CAMPPINGSTYLE_CONTROL_NEUTRAL )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_MiniMapIcon[110] = GetLastCreatedMinimapIcon()
    call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), false )
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    call SetMinimapIconVisible( GetLastCreatedMinimapIcon(), true )
    endif
    call EnableTrigger( gg_trg_H_Party_Favors)
    call EnableTrigger( gg_trg_G_Party_Favors)
    call EnableTrigger( gg_trg_U_Party_Favors)
    call EnableTrigger( gg_trg_E_Party_Favors)
                       endif
    set udg_Temp_Unit_Point = null
endfunction

