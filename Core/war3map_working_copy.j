//===========================================================================
// Trigger: PING A
//===========================================================================
function Trig_PING_A_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    set bj_forLoopAIndex = 4
    set bj_forLoopAIndexEnd = 7
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
         if udg_Heroes[bj_forLoopAIndex] != null then
        set udg_Temp_Unit_Point = GetUnitLoc(udg_Heroes[GetForLoopIndexA()])
        call PingMinimapLocForForceEx( udg_AlliancePlayers, udg_Temp_Unit_Point, 1.00, bj_MINIMAPPINGSTYLE_FLASHY, 100, 100, 100 )
        call RemoveLocation (udg_Temp_Unit_Point)
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    call TriggerSleepAction( 2 )
    call EnableTrigger( GetTriggeringTrigger() )
endfunction

//===========================================================================
function InitTrig_PING_A takes nothing returns nothing
    set gg_trg_PING_A = CreateTrigger(  )
    call TriggerRegisterPlayerChatEvent( gg_trg_PING_A, Player(2), "ping", false )
    call TriggerRegisterPlayerChatEvent( gg_trg_PING_A, Player(7), "ping", false )
    call TriggerRegisterPlayerChatEvent( gg_trg_PING_A, Player(8), "ping", false )
    call TriggerRegisterPlayerChatEvent( gg_trg_PING_A, Player(9), "ping", false )
    call TriggerAddAction( gg_trg_PING_A, function Trig_PING_A_Actions )
endfunction

//===========================================================================
// Trigger: PING H
//===========================================================================
function Trig_PING_H_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    set bj_forLoopAIndex = 0
    set bj_forLoopAIndexEnd = 3
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
         if udg_Heroes[bj_forLoopAIndex] != null then
        set udg_Temp_Unit_Point = GetUnitLoc(udg_Heroes[GetForLoopIndexA()])
        call PingMinimapLocForForceEx( udg_HordePlayers, udg_Temp_Unit_Point, 1.00, bj_MINIMAPPINGSTYLE_FLASHY, 100, 100, 100 )
        call RemoveLocation (udg_Temp_Unit_Point)
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    call TriggerSleepAction( 2 )
    call EnableTrigger( GetTriggeringTrigger() )
endfunction

