//===========================================================================
// Trigger: Operating Table Northrend
//===========================================================================
function Trig_Operating_Table_Northrend_Actions takes nothing returns nothing
    local destructable d = GetDyingDestructable()
    local location p
    local effect e

    // Only handle the correct destructable type
    if GetDestructableTypeId(d) != 'B01F' then
        set d = null
        return
    endif

    call TriggerSleepAction(10.00)

    // Restore the same destructable that died
    call DestructableRestoreLife(d, 50.00, true)

    // Lightning + sound at the destructable's position
    set p = GetDestructableLoc(d)
    set e = AddSpecialEffectLoc("Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl", p)
    call PlaySoundAtPointBJ(gg_snd_LightningBolt1, 100.00, p, 0)

    // Cleanup
    call DestroyEffect(e)
    call RemoveLocation(p)

    set e = null
    set p = null
    set d = null
endfunction

function InitTrig_Operating_Table_Northrend takes nothing returns nothing
    set gg_trg_Operating_Table_Northrend = CreateTrigger()
    call TriggerRegisterDestDeathInRegionEvent(gg_trg_Operating_Table_Northrend, gg_rct_Z_Howling_Fjord_Forsaken)
    call TriggerAddAction(gg_trg_Operating_Table_Northrend, function Trig_Operating_Table_Northrend_Actions)
endfunction

