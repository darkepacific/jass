function Trig_M_TBWW_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 151
    local location udg_Temp_Unit_Point
    set udg_TempString = ""
    if IsPlayerInForce(GetLocalPlayer(), udg_HordePlayers) then
    set udg_TempString = udg_ExclamationMark
    endif
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Q_The_Bride_Who_Waits_Start)
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, udg_TempString )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 1.30 )
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), ( BlzGetLocalSpecialEffectZ(GetLastCreatedEffectBJ()) + 75.00 ) )
    set udg_QuestMarks[udg_Temp_Int] = GetLastCreatedEffectBJ()
    call CreateItemLoc( 'I04V', udg_Temp_Unit_Point )
    call SetItemUserData( GetLastCreatedItem(), 99 )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_TempString = "Beneath the statue lies a jar of ashes, far too fresh to belong to the statue’s age. Someone laid these remains here in haste, without name or honor. If you carry them to the graveyard near Deatholme, perhaps their spirit will find peace…"
    // Set Quest Rewards
    set udg_QUEST_XP[udg_Temp_Int] = 500
    set udg_QUEST_GOLD[udg_Temp_Int] = 100
    set udg_QUEST_LVL_REQ[udg_Temp_Int] = udg_QUEST_ZONE_2_LVL_REQ
    call QuestRewards_TextSet(udg_Temp_Int)
    // End Set Quest Rewards
    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_4811", udg_TempString, "ReplaceableTextures\\CommandButtons\\BTNGhost.blp" )
    set udg_Quests[udg_Temp_Int] = GetLastCreatedQuestBJ()
    call QuestSetEnabledBJ( false, udg_Quests[udg_Temp_Int] )
    call QuestSetCompletedBJ( udg_Quests[udg_Temp_Int], false )
    call EnableTrigger( gg_trg_S_TBWW)
    call EnableTrigger( gg_trg_Ashes_Replenish_TBWW)
    set udg_Temp_Unit_Point = null
endfunction

