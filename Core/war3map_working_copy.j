//===========================================================================
// Trigger: Shadowstep
//
// //Added +4 to  o 
//===========================================================================
function Trig_Shadowstep_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0AM' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Shadowstep_Func035Func001C takes nothing returns boolean
    if ( not ( IsUnitEnemy(GetEnumUnit(), GetOwningPlayer(udg_Temp_Unit)) == true ) ) then
        return false
    endif
    if ( not ( GetEnumUnit() != udg_SpellUnits[( udg_o + 1 )] ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( BlzIsUnitInvulnerable(GetEnumUnit()) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Shadowstep_Func035A takes nothing returns nothing
    if ( Trig_Shadowstep_Func035Func001C() ) then
        if udg_Temp_Bool == false then
        call AddSpecialEffectTargetUnitBJ( "overhead", GetEnumUnit(), "war3mapImported\\Ephemeral Cut Midnight.mdx" )
        call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00) )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        ////
        call HasFirelords( GetEnumUnit() )
        ////
        set udg_SpellUnits[ udg_o + 2 ] = GetEnumUnit()
        set udg_SpellUnits[ udg_o + 0 ] = GetEnumUnit()
        call TriggerExecute( gg_trg_ShadowStep_TP_n_DMG )
        set udg_Temp_Bool = true
        endif
    else
    endif
endfunction

function Trig_Shadowstep_Func061Func001C takes nothing returns boolean
    if ( not ( IsUnitEnemy(GetEnumUnit(), GetOwningPlayer(udg_Temp_Unit)) == true ) ) then
        return false
    endif
    if ( not ( GetEnumUnit() != udg_SpellUnits[( udg_o + 1 )] ) ) then
        return false
    endif
    if ( not ( GetEnumUnit() != udg_SpellUnits[( udg_o + 2 )] ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( BlzIsUnitInvulnerable(GetEnumUnit()) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Shadowstep_Func061A takes nothing returns nothing
    if ( Trig_Shadowstep_Func061Func001C() ) then
        if udg_Temp_Bool == false then
        call AddSpecialEffectTargetUnitBJ( "overhead", GetEnumUnit(), "war3mapImported\\Ephemeral Cut Midnight.mdx" )
        call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00) )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        ////
        call HasFirelords( GetEnumUnit() )
        ////
        set udg_SpellUnits[ udg_o + 0 ] = GetEnumUnit()
        call TriggerExecute( gg_trg_ShadowStep_TP_n_DMG )
        set udg_Temp_Bool = true
        endif
    else
    endif
endfunction

function Trig_Shadowstep_Func081Func001C takes nothing returns boolean
    if ( not ( IsUnitEnemy(GetEnumUnit(), GetOwningPlayer(udg_Temp_Unit)) == true ) ) then
        return false
    endif
    if ( not ( GetEnumUnit() != udg_SpellUnits[( udg_o + 1 )] ) ) then
        return false
    endif
    if ( not ( GetEnumUnit() != udg_SpellUnits[( udg_o + 2 )] ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( BlzIsUnitInvulnerable(GetEnumUnit()) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Shadowstep_Func081A takes nothing returns nothing
    if ( Trig_Shadowstep_Func081Func001C() ) then
        if udg_Temp_Bool == false then
        call AddSpecialEffectTargetUnitBJ( "overhead", GetEnumUnit(), "war3mapImported\\Ephemeral Cut Midnight.mdx" )
        call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00) )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        ////
        call HasFirelords( GetEnumUnit() )
        ////
        set udg_SpellUnits[ udg_o + 0 ] = GetEnumUnit()
        call TriggerExecute( gg_trg_ShadowStep_TP_n_DMG )
        set udg_Temp_Bool = true
        endif
    else
    endif
endfunction

function Trig_Shadowstep_Actions takes nothing returns nothing
    local boolean extraSteps
    local integer p
    local boolean f
    local boolean r
    local integer i
    set udg_Temp_Unit = GetTriggerUnit()
    call TriggerExecute( gg_trg_Firelords_Helper)
    if ( udg_Temp_Unit == udg_yH_Ass_Rogue ) then
    set udg_o = udg_z_RO_ASSA_A
    elseif ( udg_Temp_Unit == udg_yA_Ass_Rogue ) then
    set udg_o = udg_z_RO_ASSA_H
    endif
    set udg_o = ( udg_o + 4 )
    set udg_SpellUnits[( udg_o + 1 )] = GetSpellTargetUnit()
    set p = udg_Player_Number
    set f = udg_hasFirelords
    set r = udg_hasReaper
    set i = udg_o 
    call TriggerSleepAction( 0.10 )
    // First Cut
    // Must use i to set udg_o b/c of pick AoE func
    set udg_o = i
    set udg_Temp_Bool = false
    set udg_Player_Number = p
    set udg_hasFirelords = f
    set udg_hasReaper = r
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
    set udg_Temp_Polar_Point = GetUnitLoc(udg_SpellUnits[( udg_o + 1 )])
    set udg_Temp_Real = AngleBetweenPoints(udg_Temp_Unit_Point, udg_Temp_Polar_Point)
    call RemoveLocation (udg_Temp_Polar_Point)
    set udg_Temp_X_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 200.00, udg_Temp_Real)
    call RemoveLocation (udg_Temp_Unit_Point)
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(320.00, udg_Temp_X_Point), function Trig_Shadowstep_Func035A )
    call RemoveLocation (udg_Temp_X_Point)
    set extraSteps = udg_Temp_Bool
    if extraSteps == true then
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 3 ] then 
    if udg_Temp_Unit == udg_yA_Ass_Rogue then
    call TriggerExecute( gg_trg_A_Ass_ComboGen )
    else
    call TriggerExecute( gg_trg_H_Ass_ComboGen )
    endif
    endif
    call TriggerSleepAction( 0.10 )
    // Second Cut
    set udg_o = i
    set udg_Temp_Bool = false
    set udg_Player_Number = p
    set udg_hasFirelords = f
    set udg_hasReaper = r
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
    set udg_Temp_Polar_Point = GetUnitLoc(udg_SpellUnits[( udg_o + 1 )])
    set udg_Temp_Real = AngleBetweenPoints(udg_Temp_Unit_Point, udg_Temp_Polar_Point)
    call RemoveLocation (udg_Temp_Polar_Point)
    set udg_Temp_X_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 200.00, udg_Temp_Real)
    call RemoveLocation (udg_Temp_Unit_Point)
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(320.00, udg_Temp_X_Point), function Trig_Shadowstep_Func061A )
    call RemoveLocation (udg_Temp_X_Point)
    set extraSteps = udg_Temp_Bool
    if extraSteps == true then
    call TriggerSleepAction( 0.10 )
    // Third cut (Talent)
    if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 3 ] then 
    set udg_o = i
    set udg_Temp_Bool = false
    set udg_Player_Number = p
    set udg_hasFirelords = f
    set udg_hasReaper = r
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
    set udg_Temp_Polar_Point = GetUnitLoc(udg_SpellUnits[( udg_o + 1 )])
    set udg_Temp_Real = AngleBetweenPoints(udg_Temp_Unit_Point, udg_Temp_Polar_Point)
    call RemoveLocation (udg_Temp_Polar_Point)
    set udg_Temp_X_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 200.00, udg_Temp_Real)
    call RemoveLocation (udg_Temp_Unit_Point)
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(320.00, udg_Temp_X_Point), function Trig_Shadowstep_Func081A )
    call RemoveLocation (udg_Temp_X_Point)
    set extraSteps = udg_Temp_Bool
    if extraSteps == true then
    call TriggerSleepAction( 0.10 )
    endif
    endif
    // closing if extraSteps
    endif
    endif
    // Final Cut
    // 0 is used as the place holder for the currently stepped unit till the end
    set udg_SpellUnits[ i + 0 ] = udg_SpellUnits[ i + 1]
    set udg_Temp_Unit = GetTriggerUnit()
    call TriggerExecute( gg_trg_ShadowStep_TP_n_DMG )
endfunction

//===========================================================================
function InitTrig_Shadowstep takes nothing returns nothing
    set gg_trg_Shadowstep = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Shadowstep, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Shadowstep, Condition( function Trig_Shadowstep_Conditions ) )
    call TriggerAddAction( gg_trg_Shadowstep, function Trig_Shadowstep_Actions )
endfunction

//===========================================================================
// Trigger: ShadowStep TP n DMG
//===========================================================================
function Trig_ShadowStep_TP_n_DMG_Actions takes nothing returns nothing
    set udg_Temp_Unit_Point = GetUnitLoc(udg_SpellUnits[( udg_o + 0 )])
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 80.00, ( GetUnitFacing(udg_SpellUnits[( udg_o + 0 )]) + 180.00 ))
    call SetUnitPositionLocFacingLocBJ( udg_Temp_Unit, udg_Temp_Polar_Point, udg_Temp_Unit_Point )
    call BlzSetUnitFacingEx( udg_Temp_Unit, GetUnitFacing(udg_SpellUnits[( udg_o + 0 )]) )
    if not IsTerrainPathable( GetLocationX(udg_Temp_Polar_Point), GetLocationY(udg_Temp_Polar_Point), PATHING_TYPE_WALKABILITY) then
    endif
    call RemoveLocation (udg_Temp_Unit_Point)
    call RemoveLocation (udg_Temp_Polar_Point)
    call AddSpecialEffectTargetUnitBJ( "origin", udg_Temp_Unit, "Abilities\\Spells\\NightElf\\Blink\\BlinkTarget.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    // Damage Calculation
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 4.00 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A0AM', udg_Temp_Unit) * 80 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    // Crit Bonus
    call TriggerExecute( gg_trg_Crit_Check)
    // Damage
    call UnitDamageTargetBJ( GetTriggerUnit(), udg_SpellUnits[ udg_o + 0], ( udg_RealStatCalc ), ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL )
endfunction

//===========================================================================
function InitTrig_ShadowStep_TP_n_DMG takes nothing returns nothing
    set gg_trg_ShadowStep_TP_n_DMG = CreateTrigger(  )
    call TriggerAddAction( gg_trg_ShadowStep_TP_n_DMG, function Trig_ShadowStep_TP_n_DMG_Actions )
endfunction

//===========================================================================
// Trigger: Mutilate
//===========================================================================
function Trig_Mutilate_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0AN' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mutilate_Func020A takes nothing returns nothing
    if IsUnitTargetableEnemyHitsAll( GetEnumUnit(), udg_Temp_Unit ) then
    call AddSpecialEffectTargetUnitBJ( "overhead", GetEnumUnit(), "war3mapImported\\Ephemeral Cut Midnight.mdx" )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00) )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL )
    set udg_Temp_Bool = true
    call HasFirelords( GetEnumUnit() )
    endif
endfunction

function Trig_Mutilate_Func022C takes nothing returns boolean
    if ( not ( GetSpellAbilityUnit() == udg_yA_Ass_Rogue ) ) then
        return false
    endif
    if ( not ( udg_AAssEviscerate == true ) ) then
        return false
    endif
    if ( not ( udg_Temp_Bool == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mutilate_Func023C takes nothing returns boolean
    if ( not ( GetSpellAbilityUnit() == udg_yH_Ass_Rogue ) ) then
        return false
    endif
    if ( not ( udg_HAssEviscerate == true ) ) then
        return false
    endif
    if ( not ( udg_Temp_Bool == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mutilate_Actions takes nothing returns nothing
    call AddSpecialEffectTargetUnitBJ( "chest", GetTriggerUnit(), "war3mapImported\\Ephemeral Slash Midnight.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 100.00, GetUnitFacing(GetTriggerUnit()))
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerExecute( gg_trg_Firelords_Helper_Keep_Temp)
    // Damage Calculation
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, true) - GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Temp_Unit, false) ))
    set udg_RealStatCalc = ( 4.00 * udg_RealStatCalc )
    set udg_HeroStatCalc = ( GetUnitAbilityLevelSwapped('A0AN', udg_Temp_Unit) * 55 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc + 15 )
    set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + udg_RealStatCalc )
    // Crit Bonus
    call TriggerExecute( gg_trg_Crit_Check)
    // AoE
    set udg_Temp_Bool = false
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(160.00, udg_Temp_Polar_Point), function Trig_Mutilate_Func020A )
    call RemoveLocation (udg_Temp_Polar_Point)
    if ( Trig_Mutilate_Func022C() ) then
        call TriggerExecute(gg_trg_A_Ass_ComboGen_2x)
    else
    endif
    if ( Trig_Mutilate_Func023C() ) then
        call TriggerExecute(gg_trg_H_Ass_ComboGen_2x)
    else
    endif
endfunction

//===========================================================================
function InitTrig_Mutilate takes nothing returns nothing
    set gg_trg_Mutilate = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Mutilate, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Mutilate, Condition( function Trig_Mutilate_Conditions ) )
    call TriggerAddAction( gg_trg_Mutilate, function Trig_Mutilate_Actions )
endfunction

//===========================================================================
// Trigger: WR ComboGen
//===========================================================================
function Trig_WR_ComboGen_Func003Func003C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A09J' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'AEfk' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0DS' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A06I' ) ) then
        return true
    endif
    return false
endfunction

function Trig_WR_ComboGen_Func003C takes nothing returns boolean
    if ( not ( GetSpellAbilityUnit() == udg_yA_Combat_Rogue ) ) then
        return false
    endif
    if ( not ( udg_WREviscerate == true ) ) then
        return false
    endif
    if ( not Trig_WR_ComboGen_Func003Func003C() ) then
        return false
    endif
    return true
endfunction

function Trig_WR_ComboGen_Conditions takes nothing returns boolean
    if ( not Trig_WR_ComboGen_Func003C() ) then
        return false
    endif
    return true
endfunction

function Trig_WR_ComboGen_Func004Func005C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A06I' ) ) then
        return false
    endif
    return true
endfunction

function Trig_WR_ComboGen_Func004C takes nothing returns boolean
    if ( not ( udg_WRComboPoints == 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_WR_ComboGen_Func005Func004C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A06I' ) ) then
        return false
    endif
    return true
endfunction

function Trig_WR_ComboGen_Func005C takes nothing returns boolean
    if ( not ( udg_WRComboPoints == 1.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_WR_ComboGen_Func006Func004C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A06I' ) ) then
        return false
    endif
    return true
endfunction

function Trig_WR_ComboGen_Func006C takes nothing returns boolean
    if ( not ( udg_WRComboPoints == 2.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_WR_ComboGen_Func007C takes nothing returns boolean
    if ( not ( udg_WRComboPoints < 3.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_WR_ComboGen_Actions takes nothing returns nothing
    set udg_Temp_Unit = udg_yA_Combat_Rogue
    if ( Trig_WR_ComboGen_Func004C() ) then
        call AddSpecialEffectTargetUnitBJ( "overhead", udg_Temp_Unit, "RedSpellOrb.mdx" )
        call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.18 )
        set udg_WRComboEffects[0] = GetLastCreatedEffectBJ()
        if ( Trig_WR_ComboGen_Func004Func005C() ) then
            set udg_WRComboPoints = 1.00
        else
        endif
    else
    endif
    if ( Trig_WR_ComboGen_Func005C() ) then
        call AddSpecialEffectTargetUnitBJ( "right hand", udg_Temp_Unit, "RedSpellOrb.mdx" )
        call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.20 )
        set udg_WRComboEffects[1] = GetLastCreatedEffectBJ()
        if ( Trig_WR_ComboGen_Func005Func004C() ) then
            set udg_WRComboPoints = 2.00
        else
        endif
    else
    endif
    if ( Trig_WR_ComboGen_Func006C() ) then
        call AddSpecialEffectTargetUnitBJ( "left hand", udg_Temp_Unit, "RedSpellOrb.mdx" )
        call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.20 )
        set udg_WRComboEffects[2] = GetLastCreatedEffectBJ()
        if ( Trig_WR_ComboGen_Func006Func004C() ) then
            call CreateTextTagUnitBJ( "TRIGSTR_11778", udg_Temp_Unit, 10.00, 8.00, 100, 100, 0.00, 0 )
            call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64, 0.00 )
            call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
            call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 1.00 )
            call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 0.50 )
            call ShowTextTagForceBJ( true, GetLastCreatedTextTag(), udg_AlliancePlayers )
            set udg_WRComboPoints = 3.00
            call ComboPointFrameSetPoints( udg_yA_Combat_Rogue, udg_WRComboPoints)
            return
        else
        endif
    else
    endif
    if ( Trig_WR_ComboGen_Func007C() ) then
        call CreateTextTagUnitBJ( "TRIGSTR_11779", udg_Temp_Unit, 10.00, 8.00, 100, 100, 0.00, 0 )
        call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64, 0.00 )
        call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
        call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 1.00 )
        call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 0.50 )
        call ShowTextTagForceBJ( true, GetLastCreatedTextTag(), udg_AlliancePlayers )
        set udg_WRComboPoints = ( udg_WRComboPoints + 1 )
    else
    endif
    call ComboPointFrameSetPoints( udg_yA_Combat_Rogue, udg_WRComboPoints)
endfunction

