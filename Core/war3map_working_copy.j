endfunction

//===========================================================================
// Trigger: Fire Blast
//===========================================================================
function Trig_Fire_Blast_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0DE' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fire_Blast_Actions takes nothing returns nothing
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_RealStatCalc = I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, udg_Temp_Unit, true) - 0 ))
    set udg_RealStatCalc = ( 1.50 * udg_RealStatCalc )
    if IsBurning( GetSpellTargetUnit() ) then
    set udg_RealStatCalc = ( 400.00 + ( 2.00 * udg_RealStatCalc ) )
    call AddSpecialEffectTargetUnitBJ( "origin", GetSpellTargetUnit(), "Abilities\\Weapons\\FireBallMissile\\FireBallMissile.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "origin", GetSpellTargetUnit(), "war3mapImported\\Tank Shell Silver.mdx'''" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call CreateTextTagUnitBJ( "TRIGSTR_8007", GetSpellTargetUnit(), 0.00, 10.00, 100.00, 20.00, 0.00, 0 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64, 90.00 )
    call CleanUpText(1.25, 0.8)
    endif
    call AddSpecialEffectTargetUnitBJ( "origin", GetSpellTargetUnit(), "war3mapImported\\BuildingDmgBlast016.mdx" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call UnitDamageTargetBJ( GetTriggerUnit(), GetSpellTargetUnit(), udg_RealStatCalc, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
endfunction

