//***************************************************************************
//*  DeathPactNearest 
function DeathPactNearest takes unit caster returns nothing
    local group g = CreateGroup()
    local unit target = null
    local unit u
    local real minDist = 99999.0
    local real dist = 0

    // Pick all units within range
    call GroupEnumUnitsInRange(g, GetUnitX(caster), GetUnitY(caster), 1000.0, null)
    
    loop
        set u = FirstOfGroup(g)
        exitwhen u == null
        
        // Check if the unit is owned by the caster's player, is undead, and is not the caster itself
        if GetOwningPlayer(u) == GetOwningPlayer(caster) and IsUnitType(u, UNIT_TYPE_UNDEAD) and u != caster then
            set dist = DistanceBetweenUnits(caster, u)
            if dist < minDist then
                set minDist = dist
                set target = u
            endif
        endif
        
        call GroupRemoveUnit(g, u)
    endloop

    // Cast Death Pact if a valid target was found
    if target != null then
        call IssueTargetOrder(caster, "deathpact", target)
    endif

    // Cleanup
    call DestroyGroup(g)
    set g = null
    set target = null
    set u = null
endfunction
