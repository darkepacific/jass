//===========================================================================
// Trigger: C KnC
//
// Need to change this to team wide display.
//===========================================================================
function Trig_C_KnC_Actions takes nothing returns nothing
    local location udg_Temp_Unit_Point
    local unit Kobold
                       if IsAllianceHero( GetTriggerUnit() ) then
    call DisableTrigger( GetTriggeringTrigger() )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_KB_Spawn)
    call CreateNUnitsAtLoc( 1, 'nkot', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Temp_Unit_Point, bj_UNIT_FACING )
    call RemoveLocation (udg_Temp_Unit_Point)
      set Kobold = GetLastCreatedUnit()
        call PlaySoundOnUnitBJ( gg_snd_KoboldAggro, 100, Kobold )
        call CreateTextTagUnitBJ( "Shiny!", Kobold, 0, 8.00, 100.00, 80.00, 50.00, 0.00 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
    call cleanUpText(1.25, 0.8)
     call SetUnitInvulnerable( Kobold, true )
    call TriggerSleepAction( 0.40 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Kobold_Cave_South)
    call IssuePointOrderLocBJ( Kobold, "move", udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call PlaySoundOnUnitBJ( gg_snd_FootmanYesAttack1, 100, gg_unit_h02O_0681 )
    call CreateTextTagUnitBJ( "!!!", Kobold, 0, 8.00, 100.00, 40.00, 40.00, 0.00 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
    call cleanUpText(1.25, 0.8)
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Kobold_Cave_South)
    call IssuePointOrderLocBJ( gg_unit_h02O_0681, "move", udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 1.25 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Kobolds_and_Catacombs)
    call IssuePointOrderLocBJ( gg_unit_h02O_0681, "move", udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    call TriggerSleepAction( 1.25 )
    set udg_Temp_Unit_Point = GetRectCenter(gg_rct_Kobolds_and_Catacombs)
    call IssuePointOrderLocBJ( gg_unit_h02O_0681, "move", udg_Temp_Unit_Point )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_TempString = ""
    if IsPlayerInForce(GetLocalPlayer(), udg_AlliancePlayers) then
    set udg_TempString = udg_ExclamationMark
    endif
    call AddSpecialEffectTargetUnitBJ( "overhead", gg_unit_h02O_0681, udg_TempString )
    set udg_QuestMarks[76] = GetLastCreatedEffectBJ()
    call EnableTrigger( gg_trg_S_KnC )
    call TriggerSleepAction( 3.00 )
       call RemoveUnit( Kobold )
                       endif
    set Kobold = null
    set udg_Temp_Unit_Point = null
endfunction

