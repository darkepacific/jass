//===========================================================================
// Trigger: Eyir Hammer
//===========================================================================
function Trig_Eyir_Hammer_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'e019' ) ) then
        return false
    endif
    if ( not ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) < 6600.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Eyir_Hammer_Actions takes nothing returns nothing
    local effect hammer
    local location udg_Temp_Unit_Point
    local location udg_Temp_Polar_Point
    call DisableTrigger( GetTriggeringTrigger() )
    call PlaySoundOnUnitBJ( gg_snd_Unworthy, 100.00, GetTriggerUnit() )
    call CreateTextTagUnitBJ( "TRIGSTR_8956", GetTriggerUnit(), 0, 10.00, 100.00, 80.00, 10.00, 0 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
    call cleanUpText( 1.6, 1.25)
    call UnitRemoveBuffsBJ( bj_REMOVEBUFFS_NEGATIVE, GetTriggerUnit() )
    call UnitResetCooldown( GetTriggerUnit() )
    call IssueTargetOrderBJ( GetTriggerUnit(), "innerfire", GetTriggerUnit() )
    set udg_Temp_Polar_Point = GetUnitLoc(GetTriggerUnit())
    set udg_Temp_Unit_Point = PolarProjectionBJ(udg_Temp_Polar_Point, 220.00, GetUnitFacing(GetTriggerUnit()))
    call RemoveLocation (udg_Temp_Polar_Point)
    // drop the hammer
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Judgement NoHive.mdx" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.50 )
    call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 3.60 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    // hammer effect
    call AddSpecialEffectLocBJ( udg_Temp_Unit_Point, "war3mapImported\\Sulfuras Hand Of Ragnaros.mdx" )
    call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), 0.00, Deg2Rad(45.00), 0.00 )
    call BlzSetSpecialEffectZ( GetLastCreatedEffectBJ(), ( BlzGetLocalSpecialEffectZ(GetLastCreatedEffectBJ()) + 32.00 ) )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 1.70 )
    call BlzSetSpecialEffectColor( GetLastCreatedEffectBJ(), 185, 255, 150 )
    call BlzSetSpecialEffectAlpha( GetLastCreatedEffectBJ(), 185 )
    set hammer = GetLastCreatedEffectBJ()
    // create dummy
    call CreateNUnitsAtLoc( 1, 'e01A', GetOwningPlayer(GetTriggerUnit()), udg_Temp_Unit_Point, bj_UNIT_FACING )
    call SetUnitAbilityLevelSwapped( 'A0AO', GetLastCreatedUnit(), 8 )
    call RemoveLocation (udg_Temp_Unit_Point)
    set udg_Shaman_Eq_Ls[31] = GetLastCreatedUnit()
    call UnitApplyTimedLifeBJ( 6.06, 'BTLF', udg_Shaman_Eq_Ls[31] )
    set udg_SpellTicks[31] = 1
    call EnableTrigger( gg_trg_Lights_Hammer_Tick_Eyir )
    call TriggerSleepAction( 6.06 )
    call DestroyEffectBJ( hammer )
    set hammer = null
    set udg_Temp_Unit_Point = null
    set udg_Temp_Polar_Point = null
    call GameTimeWait( 13.00)
    call EnableTrigger( GetTriggeringTrigger() )
endfunction

//===========================================================================
function InitTrig_Eyir_Hammer takes nothing returns nothing
    set gg_trg_Eyir_Hammer = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Eyir_Hammer, EVENT_PLAYER_UNIT_DAMAGED )
    call TriggerAddCondition( gg_trg_Eyir_Hammer, Condition( function Trig_Eyir_Hammer_Conditions ) )
    call TriggerAddAction( gg_trg_Eyir_Hammer, function Trig_Eyir_Hammer_Actions )
endfunction

//===========================================================================
// Trigger: Lights Hammer Tick Eyir
//
// RealStatCalc - Ability + Scaling Damage
// HeroStatCalc - Ability Damage
// TempReal - Stores the Avenging Crusader Multiplier
//===========================================================================
function Trig_Lights_Hammer_Tick_Eyir_Func009A takes nothing returns nothing
    if IsUnitTargetableEnemy( GetEnumUnit(), udg_Temp_Unit ) then
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "Abilities\\Weapons\\GryphonRiderMissile\\GryphonRiderMissile.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "Abilities\\Spells\\Human\\StormBolt\\StormBoltMissile.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    elseif IsUnitTargetableAlly( GetEnumUnit(), udg_Temp_Unit ) then
    call SetUnitLifeBJ( GetEnumUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetEnumUnit()) + 200.00 ) )
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "war3mapImported\\Heal.mdx" )
    call BlzSetSpecialEffectTimeScale( GetLastCreatedEffectBJ(), 1.50 )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 0.75 )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    endif
endfunction

function Trig_Lights_Hammer_Tick_Eyir_Func011C takes nothing returns boolean
    if ( not ( udg_SpellTicks[31] == 6 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Lights_Hammer_Tick_Eyir_Actions takes nothing returns nothing
    local integer udg_Temp_Int = 31
    set udg_Temp_Unit = gg_unit_Uktl_0568
    // real stat calc
    call BlzSetAbilityRealLevelFieldBJ( BlzGetUnitAbility(udg_Shaman_Eq_Ls[udg_Temp_Int], 'A0AO'), ABILITY_RLF_DAMAGE_PER_TARGET_EFK1, ( GetUnitAbilityLevelSwapped('A0AO', udg_Shaman_Eq_Ls[udg_Temp_Int]) - 1 ), 360.00 )
    call IssueImmediateOrderBJ( udg_Shaman_Eq_Ls[udg_Temp_Int], "fanofknives" )
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Shaman_Eq_Ls[udg_Temp_Int])
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(275.00, udg_Temp_Unit_Point), function Trig_Lights_Hammer_Tick_Eyir_Func009A )
    call RemoveLocation (udg_Temp_Unit_Point)
    if ( Trig_Lights_Hammer_Tick_Eyir_Func011C() ) then
        call KillUnit(udg_Shaman_Eq_Ls[31])
        call DisableTrigger( GetTriggeringTrigger() )
    else
        set udg_SpellTicks[31] = ( udg_SpellTicks[31] + 1 )
    endif
endfunction

//===========================================================================
function InitTrig_Lights_Hammer_Tick_Eyir takes nothing returns nothing
    set gg_trg_Lights_Hammer_Tick_Eyir = CreateTrigger(  )
    call DisableTrigger( gg_trg_Lights_Hammer_Tick_Eyir )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Lights_Hammer_Tick_Eyir, 1.00 )
    call TriggerAddAction( gg_trg_Lights_Hammer_Tick_Eyir, function Trig_Lights_Hammer_Tick_Eyir_Actions )
endfunction

