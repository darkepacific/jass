        return false
    endif
    return true
endfunction

function Trig_Shadow_Bolt_Volley_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    set udg_WitheringShots_C = 74
    call EnableTrigger( gg_trg_Shadowbolt_Volley_Tick)
    call SetUnitMoveSpeed( GetTriggerUnit(), 60.00 )
    call PlaySoundOnUnitBJ( gg_snd_NowTheySeeTheDarkness, 90.00, GetTriggerUnit() )
    call GameTimeWait(3.0)
    call SetUnitMoveSpeed( GetTriggerUnit(), GetUnitDefaultMoveSpeed(GetTriggerUnit()) )
