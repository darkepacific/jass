    call TriggerAddCondition( gg_trg_Bal_Druid_Max, Condition( function Trig_Bal_Druid_Max_Conditions ) )
    call TriggerAddAction( gg_trg_Bal_Druid_Max, function Trig_Bal_Druid_Max_Actions )
