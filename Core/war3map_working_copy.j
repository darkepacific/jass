    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_11708", udg_TempString, "ReplaceableTextures\\CommandButtons\\BTNInsigniaOfTheCrusade.blp" )
    set udg_Quests[udg_Temp_Int] = GetLastCreatedQuestBJ()
    call QuestSetCompletedBJ( udg_Quests[udg_Temp_Int], false )
    call QuestSetEnabledBJ( false, GetLastCreatedQuestBJ() )
    call GameTimeWait(1.0)
    call TriggerExecute(gg_trg_S_SAC_A)
endfunction

