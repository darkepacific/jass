//===========================================================================
// Trigger: L GWG
//===========================================================================
function Trig_L_GWG_Func008Func001C takes nothing returns boolean
    if ( not ( GetItemTypeId(udg_P_Items[( udg_Bag_Num + udg_Bag_Iterator )]) == udg_ItemTypeCheck ) ) then
        return false
    endif
    return true
endfunction

function Trig_L_GWG_Func016C takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_Quests[112]) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_L_GWG_Actions takes nothing returns nothing
    local boolean hasItem
                       if IsAllianceHero( GetTriggerUnit() ) then
    set hasItem = false
    call SetBagNumber( GetOwningPlayer(GetTriggerUnit()) )
    set udg_ItemTypeCheck = 'I08S'
    set udg_Bag_Iterator = 1
    loop
        exitwhen udg_Bag_Iterator > udg_BAG_LOOP_MAX
        if ( Trig_L_GWG_Func008Func001C() ) then
            set hasItem = true
        else
        endif
        set udg_Bag_Iterator = udg_Bag_Iterator + 1
    endloop
    if hasItem == false then
    call CreateTextTagUnitBJ( "TRIGSTR_9956", gg_unit_etrp_0647, 0, 8.00, 100.00, 75.00, 10.00, 0 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 20.00, 90.00 )
    call UnitAddItemByIdSwapped( 'I08S', GetTriggerUnit() )
    call cleanUpText( 1.5, 1.25 )
    call DisableTrigger( GetTriggeringTrigger() )
    call TriggerSleepAction( udg_ITEM_LOSS_TIMEOUT )
    if ( Trig_L_GWG_Func016C() ) then
        call EnableTrigger( GetTriggeringTrigger() )
    else
    endif
    endif
                       endif
endfunction

