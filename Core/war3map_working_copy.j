//===========================================================================
// Trigger: Shield Wall
//
// call BlzSetUnitAttackCooldown(, BlzGetUnitAttackCooldown(udg_Talent__Unit, udg_TalentChoiceInt1[udg_Talent__Choice]) + udg_TalentChoiceReal1[udg_Talent__Choice], udg_TalentChoiceInt1[udg_Talent__Choice])
//===========================================================================
function Trig_Shield_Wall_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0E0' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Shield_Wall_Actions takes nothing returns nothing
    local unit udg_Temp_Unit = GetTriggerUnit()
    local player udg_X_Player_MUI = GetTriggerPlayer()
    call StopSoundBJ( gg_snd_Shieldwall1, false )
    call PlaySoundOnUnitBJ( gg_snd_Shieldwall1, 100, udg_Temp_Unit )
    call UnitAddAbilityBJ( 'A0DZ', GetTriggerUnit() )
    call SetPlayerAbilityAvailableBJ( false, 'A0E0', udg_X_Player_MUI )
    call GameTimeWait(3.6)
    call SetPlayerAbilityAvailableBJ( true, 'A0E0', udg_X_Player_MUI )
    call UnitRemoveAbilityBJ( 'A0DZ', GetTriggerUnit() )
    set udg_X_Player_MUI = null
    set udg_Temp_Unit = null
endfunction

