function Trig_Voidwalker_Summon_Func004C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetSummoningUnit()) == 'E02V' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetSummoningUnit()) == 'E000' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Voidwalker_Summon_Func005C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'n00F' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'n00L' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'n00J' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'n01L' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'n01M' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'n011' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'n04V' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Voidwalker_Summon_Conditions takes nothing returns boolean
    if ( not Trig_Voidwalker_Summon_Func004C() ) then
        return false
    endif
    if ( not Trig_Voidwalker_Summon_Func005C() ) then
        return false
    endif
    return true
endfunction

function Trig_Voidwalker_Summon_Func003C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetSummoningUnit()) == 'E02V' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Voidwalker_Summon_Func008C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(GetTriggerUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Voidwalker_Summon_Actions takes nothing returns nothing
    local unit udg_Temp_Unit
    local integer udg_o
    if ( Trig_Voidwalker_Summon_Func003C() ) then
        set udg_o = udg_z_WL_DEMO_A
    else
        set udg_o = udg_z_WL_DEMO_H
    endif
    set udg_SpellUnits[udg_o] = GetSummonedUnit()
    call GameTimeWait(0.6)
    if ( Trig_Voidwalker_Summon_Func008C() ) then
        if udg_o == udg_z_WL_DEMO_A then
        set udg_Temp_Unit = udg_yA_Demon_Warlock
        else
        set udg_Temp_Unit = udg_yH_Demon_Warlock
        endif
        if udg_TalentChoices[ GetPlayerId(GetOwningPlayer(udg_Temp_Unit)) * udg_NUM_OF_TC + 13 ]  then
        call BlzUnitDisableAbility( udg_Temp_Unit, 'A01E', true, true )
        call UnitAddAbilityBJ( 'A0EG', udg_Temp_Unit )
        endif
    else
    endif
    set udg_Temp_Unit = null
endfunction

