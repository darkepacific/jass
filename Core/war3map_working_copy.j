function InitTrig_SU_SST_A takes nothing returns nothing
    set gg_trg_SU_SST_A = CreateTrigger(  )
    call DisableTrigger( gg_trg_SU_SST_A )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_SU_SST_A, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_SU_SST_A, Condition( function Trig_SU_SST_A_Conditions ) )
