//===========================================================================
// Trigger: Rend
//===========================================================================
function Trig_Rend_Func001C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A0BD' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Rend_Conditions takes nothing returns boolean
    if ( not Trig_Rend_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Rend_Func013Func001Func007C takes nothing returns boolean
    if ( not ( udg_RealStatCalc >= udg_Temp_Real ) ) then
        return false
    endif
    return true
endfunction

function Trig_Rend_Func013Func001C takes nothing returns boolean
    if ( not ( IsUnitEnemy(GetEnumUnit(), GetOwningPlayer(udg_Temp_Unit)) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( BlzIsUnitInvulnerable(GetEnumUnit()) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Rend_Func013A takes nothing returns nothing
    if ( Trig_Rend_Func013Func001C() ) then
        call AddSpecialEffectTargetUnitBJ( "overhead", GetEnumUnit(), "war3mapImported\\Ephemeral Cut Red.mdx" )
        call BlzSetSpecialEffectOrientation( GetLastCreatedEffectBJ(), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00), GetRandomReal(0, 360.00) )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        set udg_RealStatCalc = ( I2R(udg_HeroStatCalc) + ( ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, GetEnumUnit()) - GetUnitStateSwap(UNIT_STATE_LIFE, GetEnumUnit()) ) * ( ( ( I2R(udg_Temp_Int) * 1.50 ) + 5.50 ) / 100.00 ) ) )
        call UnitDamageTargetBJ( udg_Temp_Unit, GetEnumUnit(), udg_RealStatCalc, ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL )
        // Floating Text
        if ( Trig_Rend_Func013Func001Func007C() ) then
            call AddSpecialEffectTargetUnitBJ( "overhead", GetEnumUnit(), "war3mapImported\\BloodExplosion.mdx" )
            call DestroyEffectBJ( GetLastCreatedEffectBJ() )
            call CreateTextTagUnitBJ( ( R2SW(udg_RealStatCalc, 4, 0) + "!" ), GetEnumUnit(), 13.00, 10.00, 100, 0.00, 0.00, 0 )
            call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64, 90.00 )
            call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
            call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 1.00 )
            call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 0.80 )
        else
        endif
    else
    endif
endfunction

function Trig_Rend_Actions takes nothing returns nothing
    call PlaySoundOnUnitBJ( gg_snd_ArtilleryCorpseExplodeDeath1, 100.00, GetSpellAbilityUnit() )
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_Temp_Int = ( GetUnitAbilityLevelSwapped('A0BD', udg_Temp_Unit) + 0 )
    set udg_HeroStatCalc = ( udg_Temp_Int * 70 )
    set udg_HeroStatCalc = ( udg_HeroStatCalc - 0 )
    set udg_Temp_Real = ( I2R(udg_HeroStatCalc) * 1.66 )
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_Temp_Unit_Point = GetUnitLoc(udg_Temp_Unit)
    set udg_Temp_Polar_Point = PolarProjectionBJ(udg_Temp_Unit_Point, 80.00, GetUnitFacing(GetTriggerUnit()))
    call RemoveLocation (udg_Temp_Unit_Point)
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRangeOfLocAll(172.00, udg_Temp_Polar_Point), function Trig_Rend_Func013A )
    call RemoveLocation (udg_Temp_Polar_Point)
endfunction

//===========================================================================
function InitTrig_Rend takes nothing returns nothing
    set gg_trg_Rend = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Rend, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Rend, Condition( function Trig_Rend_Conditions ) )
    call TriggerAddAction( gg_trg_Rend, function Trig_Rend_Actions )
endfunction

