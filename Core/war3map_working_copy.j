// Trigger: Sacrfice Dies Voidwalker
//===========================================================================
function Trig_Sacrfice_Dies_Voidwalker_Conditions takes nothing returns boolean
    if ( GetTriggerUnit() == udg_SpellUnits[udg_z_WL_DEMO_A]  ) then
        return true
    elseif ( GetTriggerUnit() == udg_SpellUnits[udg_z_WL_DEMO_H]  ) then
        return true
    endif
    return false    
endfunction

function Trig_Sacrfice_Dies_Voidwalker_Actions takes nothing returns nothing
    local unit u
    if ( GetTriggerUnit() == udg_SpellUnits[udg_z_WL_DEMO_A]  ) then
	set u = udg_yA_Demon_Warlock 
    else
	set u = udg_yH_Demon_Warlock 
    endif
    if GetUnitAbilityLevel(u, 'A0EG') > 0 then
	call UnitRemoveAbilityBJ( 'A0EG', u)
    	call BlzUnitDisableAbility( u, 'A01E', false, false )
    endif  
    set u = null  
endfunction

