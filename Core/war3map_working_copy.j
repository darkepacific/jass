    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'H00S' ) ) then
        return false
    endif
    if ( not ( GetSpellAbilityId() == 'ACfs' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Burning_Charge_Actions takes nothing returns nothing
    call Debug( "Burning Charge Begins")
    set udg_Temp_Unit = GetTriggerUnit()
    set udg_Temp_Int = 36
    call DestroyEffectBJ( udg_Charge_SE[udg_Temp_Int] )
    call BlzStartUnitAbilityCooldown( udg_Temp_Unit, GetSpellAbilityId(), 4.50 )
    call PlaySoundOnUnitBJ( gg_snd_ChoRealmOfFire, 85.00, GetSpellAbilityUnit() )
    call AddSpecialEffectTargetUnitBJ( "origin", GetSpellAbilityUnit(), "war3mapImported\\Valiant Charge.mdx" )
    set udg_Point_Charge_Begin[udg_Temp_Int] = GetUnitLoc(GetSpellAbilityUnit())
    set udg_Point_Charge_End[udg_Temp_Int] = GetSpellTargetLoc()
    set udg_Charge_SE[udg_Temp_Int] = GetLastCreatedEffectBJ()
    set udg_Charge_Loop[udg_Temp_Int] = 3.00
    call EnableTrigger( gg_trg_Burning_Charge_Tick)
endfunction

