function InitTrig_Arcane_Missiles_Start takes nothing returns nothing
    set gg_trg_Arcane_Missiles_Start = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Arcane_Missiles_Start, EVENT_PLAYER_UNIT_SPELL_CHANNEL )
    call TriggerAddCondition( gg_trg_Arcane_Missiles_Start, Condition( function Trig_Arcane_Missiles_Start_Conditions ) )
