function InitTrig_Southpoint_Tower takes nothing returns nothing
    set gg_trg_Southpoint_Tower = CreateTrigger(  )
    call TriggerRegisterEnterRectSimple( gg_trg_Southpoint_Tower, gg_rct_Southpoint_Tower_Capture )
    call TriggerAddCondition( gg_trg_Southpoint_Tower, Condition( function Trig_Southpoint_Tower_Conditions ) )
    call TriggerAddAction( gg_trg_Southpoint_Tower, function Trig_Southpoint_Tower_Actions )
endfunction

//===========================================================================
// Trigger: Southpoint Tower Leave
//===========================================================================
function Trig_Southpoint_Tower_Leave_Conditions takes nothing returns boolean
    if ( not ( GetTriggerUnit() == udg_TowerHeroes[0] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Southpoint_Tower_Leave_Func005A takes nothing returns nothing
    call SetNewTowerHero( GetEnumUnit(), 0 )
endfunction

function Trig_Southpoint_Tower_Leave_Actions takes nothing returns nothing
    local integer udg_Temp_Int
    set udg_Temp_Int = 0
    set udg_TowerHeroes[udg_Temp_Int] = null
    set bj_wantDestroyGroup = true
    call ForGroupBJ( GetUnitsInRectAll(gg_rct_Southpoint_Tower_Capture), function Trig_Southpoint_Tower_Leave_Func005A )
    if ( udg_TowerHeroes[udg_Temp_Int] == null) then
    call DisableTrigger( GetTriggeringTrigger() )
    call PauseTimerBJ( true, udg_TowerTimers[0] )
    call DestroyTimerDialogBJ( udg_TowerWindows[0] )
    call QuestMessageBJ( GetPlayersAll(), bj_QUESTMESSAGE_ALWAYSHINT, "TRIGSTR_8854" )
    call EnableTrigger( gg_trg_Southpoint_Tower )
    endif
endfunction

//===========================================================================
function InitTrig_Southpoint_Tower_Leave takes nothing returns nothing
    set gg_trg_Southpoint_Tower_Leave = CreateTrigger(  )
    call DisableTrigger( gg_trg_Southpoint_Tower_Leave )
    call TriggerRegisterLeaveRectSimple( gg_trg_Southpoint_Tower_Leave, gg_rct_Southpoint_Tower_Capture )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Southpoint_Tower_Leave, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_Southpoint_Tower_Leave, Condition( function Trig_Southpoint_Tower_Leave_Conditions ) )
    call TriggerAddAction( gg_trg_Southpoint_Tower_Leave, function Trig_Southpoint_Tower_Leave_Actions )
endfunction

